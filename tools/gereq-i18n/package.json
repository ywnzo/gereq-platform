{
  "name": "i18n",
  "displayName": "GEREQ i18n",
  "description": "Hover, autocomplete a Go to Definition pro p\u0159ekladov\u00e9 kl\u00ed\u010de (|trans / ->trans / label: / FormField)",
  "version": "0.2.1",
  "publisher": "gereq",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.twig",
    "workspaceContains:**/translations/*.php"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gereq.i18n.reindex",
        "title": "GEREQ i18n: Reindex translations (.cache/i18n)"
      }
    ]
  }
}
