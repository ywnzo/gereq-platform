{
  "name": "gereq-i18n",
  "displayName": "GEREQ i18n",
  "description": "Hover, autocomplete and Go to Definition for GEREQ translation keys in Twig (|trans) and PHP (trans / label / FormField).",
  "version": "0.2.2",
  "publisher": "gereq",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@git.gereq.cz:gereq/tool-i18n.git"
  },
  "homepage": "https://git.gereq.cz/gereq/tool-i18n",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1c2830",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gereq",
    "i18n",
    "translations",
    "twig"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.twig",
    "workspaceContains:**/translations/*.php"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gereq.i18n.reindex",
        "title": "GEREQ i18n: Reindex translations (.cache/i18n)"
      }
    ]
  }
}
