{
  "name": "gereq-permissions",
  "displayName": "GEREQ Permissions",
  "description": "Hover, autocomplete and Go to Definition for GEREQ permission keys (user.can / ->permission) from module manifests.",
  "version": "0.1.2",
  "publisher": "gereq",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@git.gereq.cz:gereq/tool-permissions.git"
  },
  "homepage": "https://git.gereq.cz/gereq/tool-permissions",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#241828",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gereq",
    "permissions",
    "acl",
    "twig"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/module.php"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gereq.permissions.reindex",
        "title": "GEREQ Permissions: Reindex (.cache/permissions)"
      }
    ]
  }
}
