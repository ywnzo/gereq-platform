{
  "name": "gereq-work-monitor",
  "displayName": "GEREQ Pulse",
  "description": "Toggl-style work tracking from Cursor/VS Code — Timer, Day and Week views on a local dashboard (:8772).",
  "version": "0.3.2",
  "publisher": "gereq",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@git.gereq.cz:gereq/tool-pulse.git"
  },
  "homepage": "https://git.gereq.cz/gereq/tool-pulse",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#201828",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "gereq",
    "pulse",
    "time-tracking",
    "toggl"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gereq.pulse.open",
        "title": "GEREQ Pulse: Open dashboard (:8772)"
      },
      {
        "command": "gereq.pulse.reset",
        "title": "GEREQ Pulse: Reset today's session log"
      }
    ]
  }
}
