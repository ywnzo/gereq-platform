{
  "name": "work-monitor",
  "displayName": "GEREQ Pulse",
  "description": "GEREQ Pulse — Toggl-style time tracking z Cursoru (Timer / Day / Week). UI :8772",
  "version": "0.3.2",
  "publisher": "gereq",
  "engines": {
