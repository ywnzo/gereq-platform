{
  "name": "gereq-twig-goto",
  "displayName": "GEREQ Twig IDE",
  "description": "Hover, .completion and Go to Definition for Twig objects typed from GEREQ controllers — types live outside templates.",
  "version": "0.3.6",
  "publisher": "gereq",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@git.gereq.cz:gereq/tool-twig-goto.git"
  },
  "homepage": "https://git.gereq.cz/gereq/tool-twig-goto",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#281c18",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gereq",
    "twig",
    "goto",
    "autocomplete"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.twig"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gereq.twigGoto.reindex",
        "title": "GEREQ Twig: Reindex types (.cache/twig)"
      }
    ]
  }
}
