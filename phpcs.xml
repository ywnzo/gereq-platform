<?xml version="1.0"?>
<ruleset name="GEREQ">
    <description>PSR-12 with GEREQ conventions</description>

    <!--
      Project conventions that diverge from strict PSR-12:
      - single-line accessors: public function id(): string { return $this->id; }
      - multiline control heads keep the first token after (: foreach ([ / if ($a
      - line length soft; seeders and route tables regularly exceed 120
      - translation catalogs often use <?php\nreturn [ without a blank header gap
      - data/migration files may place a file docblock after declare
      - test files may host small stub classes next to the test case
      - brand module iDoklad* keeps a leading lowercase "i"
    -->
    <rule ref="PSR12">
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.ContentAfterBrace"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
        <exclude name="Generic.Formatting.DisallowMultipleStatements"/>
        <exclude name="PSR12.ControlStructures.ControlStructureSpacing"/>
        <exclude name="Generic.Files.LineLength"/>
        <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
        <exclude name="PSR12.Files.FileHeader.SpacingAfterBlock"/>
        <exclude name="PSR12.Files.FileHeader.IncorrectOrder"/>
        <exclude name="Squiz.Classes.ValidClassName"/>
    </rule>

    <file>src</file>
    <file>modules</file>
    <file>tests</file>
    <file>bin/gereq-test</file>
    <exclude-pattern>vendor</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
