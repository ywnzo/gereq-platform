#!/usr/bin/env bash
# Zabali RealEstates demo zip (bez vendor/node_modules/.git).
# Výstup: dist/gereq-realestates-demo.zip
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

OUT_DIR="${ROOT}/dist"
STAMP="$(date +%Y%m%d)"
NAME="gereq-realestates-demo"
ZIP="${OUT_DIR}/${NAME}-${STAMP}.zip"
STAGE="${OUT_DIR}/.stage-${NAME}"

mkdir -p "$OUT_DIR"
rm -rf "$STAGE"
mkdir -p "$STAGE/${NAME}"

echo "→ Kopíruji soubory do staging…"
rsync -a \
  --exclude='.git/' \
  --exclude='.idea/' \
  --exclude='.vscode/' \
  --exclude='.cursor/' \
  --exclude='.cache/' \
  --exclude='.phpunit.cache/' \
  --exclude='.phpstan-tmp/' \
  --exclude='vendor/' \
  --exclude='node_modules/' \
  --exclude='frontend/node_modules/' \
  --exclude='public/build/' \
  --exclude='public/hot' \
  --exclude='dist/' \
  --exclude='.env' \
  --exclude='.env.bak*' \
  --exclude='.env copy' \
  --exclude='.env.new' \
  --exclude='.env.tmpkey' \
  --exclude='storage/database.sqlite' \
  --exclude='storage/database.sqlite-journal' \
  --exclude='storage/logs/*' \
  --exclude='storage/cache/*' \
  --exclude='storage/sessions/*' \
  --exclude='storage/tmp/*' \
  --exclude='*.log' \
  --exclude='.DS_Store' \
  --exclude='docs/proposals/' \
  ./ "$STAGE/${NAME}/"

# Zachovat strukturu storage + seed média
mkdir -p \
  "$STAGE/${NAME}/storage/cache" \
  "$STAGE/${NAME}/storage/logs" \
  "$STAGE/${NAME}/storage/sessions" \
  "$STAGE/${NAME}/storage/tmp/queue" \
  "$STAGE/${NAME}/storage/uploads" \
  "$STAGE/${NAME}/storage/invoices" \
  "$STAGE/${NAME}/storage/database"
touch \
  "$STAGE/${NAME}/storage/cache/.gitkeep" \
  "$STAGE/${NAME}/storage/logs/.gitkeep" \
  "$STAGE/${NAME}/storage/sessions/.gitkeep" \
  "$STAGE/${NAME}/storage/tmp/.gitkeep"

# Snadný vstupní bod po rozbalení
cat > "$STAGE/${NAME}/INSTALACE.sh" <<'EOF'
#!/usr/bin/env bash
# RealEstates demo — rozbalte zip a spusťte:
#   ./INSTALACE.sh
#   ./INSTALACE.sh --serve
set -euo pipefail
cd "$(dirname "$0")"
chmod +x bin/install-demo bin/pack-demo 2>/dev/null || true
exec ./bin/install-demo "$@"
EOF
chmod +x "$STAGE/${NAME}/INSTALACE.sh" "$STAGE/${NAME}/bin/install-demo" "$STAGE/${NAME}/bin/pack-demo"

cat > "$STAGE/${NAME}/DEMO-README.txt" <<EOF
GEREQ RealEstates — demo balíček
================================

Požadavky na cílovém PC:
  - PHP 8.4+ s extensions: pdo_sqlite, mbstring, json, gd
    (ext-redis není nutný — instalátor ho případně obejde)
  - Composer
  - Node.js 20+ (npm) nebo bun

Instalace:
  1. Rozbalte tento zip
  2. ./INSTALACE.sh
     nebo: ./INSTALACE.sh --serve --port=8080

Přihlášení do adminu:
  URL:    http://127.0.0.1:8080/admin
  E-mail: demo@gereq.cz
  Heslo:  demo123

Obsahuje demo nabídky, prohlídky, portály a další ukázková data.
EOF

echo "→ Zipuji…"
rm -f "$ZIP"
if command -v zip >/dev/null 2>&1; then
  ( cd "$STAGE" && zip -rq "$ZIP" "$NAME" )
else
  python3 - <<PY
import zipfile, os
from pathlib import Path
root = Path(${STAGE@Q}) / ${NAME@Q}
out = Path(${ZIP@Q})
with zipfile.ZipFile(out, "w", compression=zipfile.ZIP_DEFLATED) as zf:
    for path in root.rglob("*"):
        if path.is_file():
            zf.write(path, path.relative_to(root.parent).as_posix())
print("python zip ok")
PY
fi

rm -rf "$STAGE"

SIZE="$(du -h "$ZIP" | awk '{print $1}')"
echo "✓ Hotovo: $ZIP ($SIZE)"
echo
echo "  Na jiném PC: rozbalit → ./INSTALACE.sh [--serve]"
