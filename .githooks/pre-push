#!/usr/bin/env bash
# Extra safety on push: refuse deleting protected branch refs, block force-push
# to protected branches, then run quality on PHP files in the push range.
# Analysis failures MUST block the push (GEREQ_HOOKS_SKIP_QUALITY is ignored here).
set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
source "$HOOKS_DIR/lib/common.sh"
# shellcheck source=lib/quality.sh
source "$HOOKS_DIR/lib/quality.sh"

if hook_skip_requested; then
  hook_info "pre-push: skipped (GEREQ_HOOKS_SKIP / SKIP_REPO_GUARD set)."
  exit 0
fi

remote="${1:-}"
url="${2:-}"
errors=0
fail() { hook_info "pre-push: ERROR: $*"; errors=$((errors + 1)); }

is_protected_branch() {
  case "$1" in
    main|master|dev|production|prod)
      return 0
      ;;
  esac
  return 1
}

zero="0000000000000000000000000000000000000000"
pushing_commits=0
changed_paths_file="$(mktemp)"
trap 'rm -f "$changed_paths_file"' EXIT

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue

  remote_branch="${remote_ref#refs/heads/}"

  if [[ "$local_sha" == "$zero" ]] && is_protected_branch "$remote_branch"; then
    fail "refusing to delete protected remote branch '$remote_branch' on ${remote:-remote}"
    continue
  fi

  if [[ "$remote_sha" != "$zero" && "$local_sha" != "$zero" ]] && is_protected_branch "$remote_branch"; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      fail "non-fast-forward update to protected branch '$remote_branch' (force-push?). Use an explicit recovery procedure."
      continue
    fi
  fi

  if [[ "$local_sha" != "$zero" ]]; then
    pushing_commits=1
    quality_append_push_paths "$changed_paths_file" "${remote:-origin}" "$local_sha" "$remote_sha"
  fi
done

if [[ "$errors" -gt 0 ]]; then
  hook_info "pre-push: blocked $errors issue(s). Bypass: GEREQ_HOOKS_SKIP=1 git push ..."
  [[ -n "$url" ]] && hook_info "pre-push: remote url: $url"
  exit 1
fi

# Default: quality on files in this push. Full CI suite: GEREQ_HOOKS_QUALITY=full
# SKIP_QUALITY / QUALITY=off are ignored on push — only GEREQ_HOOKS_SKIP=1 bypasses.
if [[ "$pushing_commits" -eq 1 ]]; then
  quality_mode="$(quality_mode_requested changed push)"

  # Empty path list (shallow clone / odd refs) must not silently skip analysis.
  if [[ ! -s "$changed_paths_file" ]]; then
    hook_info "pre-push: no paths resolved in push range — falling back to full analyse (phpstan + phpstan:tests)"
    quality_mode="analyse"
  fi

  if ! quality_run_pipeline "$quality_mode" "$changed_paths_file"; then
    hook_info "pre-push: quality FAILED (mode=$quality_mode) — push blocked."
    hook_info "pre-push: fix locally (composer phpstan / composer phpstan:tests / composer cs)."
    hook_info "pre-push: full suite like CI: GEREQ_HOOKS_QUALITY=full git push"
    hook_info "pre-push: emergency bypass only: GEREQ_HOOKS_SKIP=1 git push ..."
    exit 1
  fi
fi

exit 0
