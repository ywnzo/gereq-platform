<!DOCTYPE html>
<html lang="{{ app_locale() }}" data-theme="gereq">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pageTitle|default('errors.title'|trans) }} · GEREQ</title>
    {% include 'partials/brand-head.html.twig' %}
    <link rel="stylesheet" href="{{ asset('resources/css/admin.css') }}">
</head>
<body class="auth-body">
    <main class="auth-shell">
        <section class="auth-panel">
            {% include 'partials/brand-lockup.html.twig' with { href: homeUrl|default('/admin'), modifier: 'brand--auth' } %}
            {% block content %}{% endblock %}
        </section>
        <p class="auth-footnote">{{ 'brand.footnote_short'|trans }}</p>
    </main>
</body>
</html>
