<!DOCTYPE html>
<html lang="{{ app_locale() }}" data-theme="gereq" style="{{ brand_html_style() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pageTitle|default('errors.title'|trans) }} · {{ brand('name') }}</title>
    {% include 'partials/brand-head.html.twig' %}
    {{ render_css() }}
    {% include 'partials/brand-overrides.html.twig' %}
</head>
<body class="auth-body">
    <main class="auth-shell">
        <section class="auth-panel">
            {% include 'partials/brand-lockup.html.twig' with { href: homeUrl|default(admin_path()), modifier: 'brand--auth' } %}
            {% block content %}{% endblock %}
        </section>
        <p class="auth-footnote">{{ 'brand.footnote_short'|trans }}</p>
    </main>
</body>
</html>
