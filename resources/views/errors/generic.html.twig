{% extends 'errors/layout.html.twig' %}

{% block content %}
    <p class="error-code">{{ status }}</p>
    <h1>{{ heading }}</h1>
    <p class="muted">{{ message }}</p>
    <p class="error-actions">
        <a class="btn btn-primary btn--primary" href="{{ homeUrl }}">{{ 'errors.back'|trans }}</a>
    </p>
    {% if debug %}
        <pre class="error-trace">{{ exception.message }}
{{ exception.file }}:{{ exception.line }}

{{ exception.traceAsString }}</pre>
    {% endif %}
{% endblock %}
