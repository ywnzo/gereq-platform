<div
    class="dash-settings"
    x-data="gereqDashboardSettings"
    data-items="{{ dashboardCatalog|default([])|json_encode|e('html_attr') }}"
    data-label-metric="{{ 'settings.dashboard.type.metric'|trans|e('html_attr') }}"
    data-label-hero="{{ 'settings.dashboard.type.hero'|trans|e('html_attr') }}"
    data-label-panel="{{ 'settings.dashboard.type.panel'|trans|e('html_attr') }}"
    data-label-shortcut="{{ 'settings.dashboard.type.shortcut'|trans|e('html_attr') }}"
    data-width-full="{{ 'settings.dashboard.width.full'|trans|e('html_attr') }}"
    data-width-two-thirds="{{ 'settings.dashboard.width.two_thirds'|trans|e('html_attr') }}"
    data-width-half="{{ 'settings.dashboard.width.half'|trans|e('html_attr') }}"
    data-width-third="{{ 'settings.dashboard.width.third'|trans|e('html_attr') }}"
>
    <input type="hidden" name="{{ field }}" x-ref="payload" value="[]">

    <div class="dash-settings__toolbar">
        <p class="muted">{{ 'settings.dashboard.help'|trans }}</p>
        <div class="dash-settings__aside">
            <label class="dash-settings__search">
                <span class="sr-only">{{ 'settings.dashboard.search'|trans }}</span>
                {{ icon('search') }}
                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                    class="input"
                    type="search"
                    x-model="query"
                    placeholder="{{ 'settings.dashboard.search'|trans|e('html_attr') }}"
                    autocomplete="off"
                {% endblock %}{% endembed %}
            </label>
            <div class="dash-settings__actions">
                {% include 'ui/button.html.twig' with {
                    label: 'settings.dashboard.enable_all'|trans,
                    type: 'button',
                    variant: 'ghost',
                    class: 'btn-sm',
                    attrs: { '@click': 'enableAll' }
                } only %}
                {% include 'ui/button.html.twig' with {
                    label: 'settings.dashboard.disable_all'|trans,
                    type: 'button',
                    variant: 'ghost',
                    class: 'btn-sm',
                    attrs: { '@click': 'disableAll' }
                } only %}
            </div>
        </div>
    </div>

    <template x-for="section in sections" :key="section.type">
        <section class="dash-settings__section">
            <header class="dash-settings__section-head">
                <div>
                    <h3 class="dash-settings__section-title" x-text="section.label"></h3>
                    <p class="dash-settings__count">
                        <span x-text="enabledCount(section.type)"></span>
                        /
                        <span x-text="totalCount(section.type)"></span>
                        {{ 'settings.dashboard.enabled_of'|trans }}
                    </p>
                </div>
                <div class="dash-settings__section-actions">
                    {% include 'ui/button.html.twig' with {
                        label: 'settings.dashboard.enable_section'|trans,
                        type: 'button',
                        variant: 'ghost',
                        class: 'btn-sm',
                        attrs: { '@click': 'enableSection(section.type)' }
                    } only %}
                    {% include 'ui/button.html.twig' with {
                        label: 'settings.dashboard.disable_section'|trans,
                        type: 'button',
                        variant: 'ghost',
                        class: 'btn-sm',
                        attrs: { '@click': 'disableSection(section.type)' }
                    } only %}
                </div>
            </header>

            <div :class="canvasClass(section.type)">
                <template x-for="item in enabledItems(section.type)" :key="item.id">
                    <article
                        :class="cardClass(item)"
                        draggable="true"
                        @dragstart="onDragStart(item.id, $event)"
                        @dragover="onDragOver(item.id, $event)"
                        @drop="onDrop(item.id, $event)"
                        @dragend="onDragEnd"
                    >
                        <span class="dash-settings__grip" aria-hidden="true"></span>
                        <div class="dash-settings__card-body">
                            <strong class="dash-settings__title" x-text="item.title"></strong>
                            <div class="dash-settings__widths" x-show="showWidth(section.type)" x-cloak>
                                <template x-for="w in widths" :key="w">
                                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                                        type="button"
                                        :class="widthClass(item, w)"
                                        :aria-pressed="isWidth(item, w)"
                                        :title="widthLabels[w]"
                                        @click="setWidth(item.id, w)"
                                    {% endblock %}{% block content %}
                                        <span :class="widthBarClass(w)"></span>
                                        <span class="dash-settings__width-label" x-text="widthLabels[w]"></span>
                                    {% endblock %}{% endembed %}
                                </template>
                            </div>
                        </div>
                        <div class="dash-settings__card-tools">
                            <div class="dash-settings__move">
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="icon-btn" @click="move(item.id, -1)" :disabled="!canMoveUp(item.id)" aria-label="{{ 'settings.dashboard.move_up'|trans }}"{% endblock %}{% block content %}{{ icon('chevron-up') }}{% endblock %}{% endembed %}
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="icon-btn" @click="move(item.id, 1)" :disabled="!canMoveDown(item.id)" aria-label="{{ 'settings.dashboard.move_down'|trans }}"{% endblock %}{% block content %}{{ icon('chevron-down') }}{% endblock %}{% endembed %}
                            </div>
                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                                type="button"
                                class="icon-btn"
                                @click="setEnabled(item.id, false)"
                                aria-label="{{ 'settings.dashboard.hide'|trans }}"
                            {% endblock %}{% block content %}{{ icon('x') }}{% endblock %}{% endembed %}
                        </div>
                    </article>
                </template>
                <p class="dash-settings__empty" x-show="enabledCount(section.type) === 0" x-cloak>
                    {{ 'settings.dashboard.empty_section'|trans }}
                </p>
            </div>

            <div class="dash-settings__pool" x-show="poolCount(section.type) > 0" x-cloak>
                <p class="dash-settings__pool-label">{{ 'settings.dashboard.pool'|trans }}</p>
                <div class="dash-settings__chips">
                    <template x-for="item in poolItems(section.type)" :key="item.id">
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                            type="button"
                            class="dash-settings__chip"
                            @click="setEnabled(item.id, true)"
                        {% endblock %}{% block content %}
                            {{ icon('plus') }}
                            <span x-text="item.title"></span>
                        {% endblock %}{% endembed %}
                    </template>
                </div>
            </div>
        </section>
    </template>
</div>
