{#
  Single brand settings field.
  Expects: item, values, groupId, cssVariables, wideKeys, libraryImages
  Optional: forceFull
#}
{% set key = item.key %}
{% set definition = item.definition %}
{% set field = key|replace({'.': '__'}) %}
{% set helpKey = definition.label ~ '.help' %}
{% set isColor = 'color_' in key or key ends with '_primary' %}
{% set isAsset = key in ['brand.logo_url', 'brand.favicon_url'] %}
{% set isWide = key in wideKeys or forceFull|default(false) %}
{% set isWidget = isColor or isWide %}
{% if isAsset %}
    {% include 'ui/media_box.html.twig' with {
        name: field,
        file_name: key == 'brand.logo_url' ? 'brand_logo_file' : 'brand_favicon_file',
        library_name: key == 'brand.logo_url' ? 'brand_logo_media_asset_id' : 'brand_favicon_media_asset_id',
        clear_name: key == 'brand.logo_url' ? 'clear_brand_logo' : 'clear_brand_favicon',
        id: 'f-' ~ field,
        label: definition.label|trans,
        optional: true,
        value: values[key]|default(''),
        hint: helpKey|trans != helpKey ? helpKey|trans : '',
        has_media: true,
        full: false,
        library: libraryImages|default([])
    } %}
{% elseif isWidget %}
    <div class="settings-row{% if isWide %} field--full{% endif %}{% if isColor %} settings-row--color{% endif %}">
        <span class="settings-row__label">{{ definition.label|trans }}</span>
        {% if definition.type == 'boolean' %}
            <select class="input" name="{{ field }}">
                <option value="1" {{ values[key] ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                <option value="0" {{ not values[key] ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
            </select>
        {% elseif item.secret %}
            <input class="input" type="password" name="{{ field }}" value="{{ values[key] }}" autocomplete="new-password" placeholder="{{ values[key] ? ('settings.secret.placeholder'|trans) : '' }}">
        {% elseif isColor %}
            {% include 'admin/settings/_color_picker.html.twig' %}
        {% elseif key == 'brand.custom_css' %}
            {% include 'admin/settings/_css_editor.html.twig' %}
        {% else %}
            <input class="input" type="text" name="{{ field }}" value="{{ values[key] }}" @input="touch">
        {% endif %}
        {% if helpKey|trans != helpKey %}
            <small class="field__hint">{{ helpKey|trans }}</small>
        {% endif %}
    </div>
{% else %}
    <label class="field{% if isWide %} field--full{% endif %}">
        <span>{{ definition.label|trans }}</span>
        {% if definition.type == 'boolean' %}
            <select class="input" name="{{ field }}">
                <option value="1" {{ values[key] ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                <option value="0" {{ not values[key] ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
            </select>
        {% elseif item.secret %}
            <input class="input" type="password" name="{{ field }}" value="{{ values[key] }}" autocomplete="new-password" placeholder="{{ values[key] ? ('settings.secret.placeholder'|trans) : '' }}">
        {% else %}
            <input class="input" type="text" name="{{ field }}" value="{{ values[key] }}" @input="touch">
        {% endif %}
        {% if helpKey|trans != helpKey %}
            <small class="field__hint">{{ helpKey|trans }}</small>
        {% endif %}
    </label>
{% endif %}
