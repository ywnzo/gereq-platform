{% set assetUrl = values[key]|default('') %}
{% set fileInput = key == 'brand.logo_url' ? 'brand_logo_file' : 'brand_favicon_file' %}
<div class="brand-asset" x-data="gereqBrandAsset" data-preview="{{ assetUrl }}">
    <div class="brand-asset__preview">
        <img x-show="preview" :src="preview" alt="" class="brand-asset__img" width="48" height="48">
        <span class="brand-asset__empty" x-show="!preview" x-cloak>{{ icon('image') }}</span>
    </div>
    <div class="brand-asset__fields">
        <div class="g-file g-file--compact brand-asset__drop">
            <input
                type="file"
                name="{{ fileInput }}"
                accept="image/png,image/jpeg,image/webp,image/svg+xml,image/gif,image/x-icon,.ico"
                class="g-file__input"
                id="{{ fileInput }}"
                @change="onFile($event)"
            >
            <div class="g-file__shell" :class="fileName ? 'is-filled' : ''">
                <label class="g-file__box" for="{{ fileInput }}">
                    <span class="g-file__icon" aria-hidden="true">{{ icon('upload') }}</span>
                    <span class="g-file__copy">
                        <span class="g-file__title" x-text="fileName ? fileName : '{{ 'settings.brand.upload'|trans|e('js') }}'">{{ 'settings.brand.upload'|trans }}</span>
                    </span>
                    <span class="g-file__browse" x-show="!fileName">{{ 'ui.file.browse'|trans }}</span>
                </label>
            </div>
        </div>
        <input
            class="input"
            type="text"
            name="{{ field }}"
            value="{{ assetUrl }}"
            placeholder="/brand/asset/logo.png"
            {% if groupId == 'brand' %}@input="touch"{% endif %}
        >
        <small class="field__hint">{{ 'settings.brand.upload_or_url'|trans }} · {{ 'settings.brand.upload_hint'|trans }}</small>
    </div>
</div>
