{% set scope = key == 'cms.custom_css_public' ? 'public' : 'admin' %}
{% set vars = cssVariables[scope]|default([]) %}
{% set editorClass = editorClass|default('') %}
<div
    class="css-editor grq-stack grq-stack--md{{ editorClass ? ' ' ~ editorClass : '' }}"
    x-data="gereqCssEditor"
    data-vars="{{ vars|json_encode|e('html_attr') }}"
>
    <div class="css-editor__main">
        <div class="css-editor__host" x-ref="host"></div>
        <textarea
            class="css-editor__input"
            name="{{ field }}"
            x-ref="input"
            hidden
        >{{ values[key] }}</textarea>
    </div>

    <div class="css-editor__vars grq-box grq-box--soft grq-box--sm">
        <div class="grq-cluster grq-cluster--between">
            <div class="grq-stack grq-stack--xs">
                <strong class="grq-text-ui">{{ 'settings.css.vars_title'|trans }}</strong>
                <p class="muted grq-text-meta">{{ scope == 'admin' ? ('settings.css.vars_admin'|trans) : ('settings.css.vars_public'|trans) }}</p>
            </div>
            <input
                class="input css-editor__filter"
                type="search"
                placeholder="{{ 'settings.css.vars_filter'|trans }}"
                x-model="filter"
                @input="applyFilter"
            >
        </div>
        <div class="css-editor__chips grq-cluster" role="list">
            <template x-for="item in filteredVars" :key="item.name">
                <button
                    type="button"
                    class="css-editor__chip"
                    role="listitem"
                    :title="item.hint + ' · ' + item.value"
                    @click="insertVar(item.name)"
                >
                    <span class="css-editor__swatch" :style="swatchStyle(item.value)"></span>
                    <code x-text="item.name"></code>
                </button>
            </template>
        </div>
        <p class="muted grq-text-meta" x-show="filteredVars.length === 0" x-cloak>
            {{ 'settings.css.vars_empty'|trans }}
        </p>
    </div>
</div>
