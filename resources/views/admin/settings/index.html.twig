{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.settings'|trans },
    ] } %}
{% endblock %}

{% block content %}
    {% set firstGroup = groups|keys|first %}
    {% set wideKeys = [
        'admin.dashboard.layout',
        'brand.custom_css'
    ] %}

    <form
        id="settings-form"
        method="post"
        action="{{ url('admin.settings.update') }}"
        autocomplete="off"
        enctype="multipart/form-data"
        x-data="gereqTabs"
        data-initial="{{ activeTab|default(firstGroup) }}"
    >
        {{ csrf_field()|raw }}
        <input type="hidden" name="settings_tab" value="{{ activeTab|default(firstGroup) }}">

        <header class="page-header">
            <div>
                <h1>{{ 'settings.title'|trans }}</h1>
                <p class="muted">{{ 'settings.intro'|trans }}</p>
            </div>
            <div class="actions">
                <button class="btn btn--primary" type="submit">{{ 'settings.save'|trans }}</button>
            </div>
        </header>

        <div class="detail-hub">
            <div class="design-tabs detail-tabs" role="tablist" aria-label="{{ 'settings.title'|trans }}">
                {% for groupId, group in groups %}
                    <button type="button" class="design-tab" role="tab" data-tab="{{ groupId }}">
                        {{ group.label|trans }}<span class="module-tab-count">{{ group.items|length }}</span>
                    </button>
                {% endfor %}
            </div>

            {% for groupId, group in groups %}
                {% set groupHelp = 'settings.group.' ~ groupId ~ '.help' %}
                <section
                    class="design-panel"
                    data-panel="{{ groupId }}"
                    role="tabpanel"
                >
                    {% if groupId == 'brand' %}
                        {% include 'admin/settings/_brand_tab.html.twig' with {
                            group: group,
                            values: values,
                            cssVariables: cssVariables,
                            wideKeys: wideKeys,
                            libraryImages: libraryImages|default([]),
                        } %}
                    {% else %}
                        <div class="detail-stack">
                            <section class="panel">
                                <header class="panel__head">
                                    <div>
                                        <h2>{{ group.label|trans }}</h2>
                                        {% if groupHelp|trans != groupHelp %}
                                            <p class="muted">{{ groupHelp|trans }}</p>
                                        {% endif %}
                                    </div>
                                </header>
                                <div class="form-grid">
                                    {% if groupId == 'core' %}
                                        <label class="field">
                                            <span>{{ 'settings.admin.path'|trans }}</span>
                                            <input class="input" type="text" value="{{ adminPath }}" readonly disabled>
                                            <small class="field__hint">{{ 'settings.admin.path.help'|trans }}</small>
                                        </label>
                                    {% endif %}
                                    {% for item in group.items %}
                                        {% set key = item.key %}
                                        {% set definition = item.definition %}
                                        {% set field = key|replace({'.': '__'}) %}
                                        {% set helpKey = definition.label ~ '.help' %}
                                        {% set helpText = helpKey|trans != helpKey and key != 'admin.dashboard.layout' ? helpKey|trans : '' %}
                                        {% set isColor = 'color_' in key or key ends with '_primary' %}
                                        {% set isWide = key in wideKeys %}
                                        {% set isWidget = isColor or isWide %}
                                        {% set isChoice = definition.type == 'boolean' or (definition.options is defined and definition.options is not empty) %}
                                        {% if isChoice and not isWidget %}
                                            {% include 'admin/settings/_choice_select.html.twig' with {
                                                field: field,
                                                value: values[key],
                                                options: definition.type == 'boolean' ? null : definition.options,
                                                label: definition.label|trans,
                                                hint: helpText,
                                            } %}
                                        {% else %}
                                            {% if isWidget %}
                                                <div class="settings-row{% if isWide %} field--full{% endif %}">
                                                <span class="settings-row__label">{{ definition.label|trans }}</span>
                                            {% else %}
                                                <label class="field">
                                                <span>{{ definition.label|trans }}</span>
                                            {% endif %}
                                                {% if isChoice %}
                                                    {% include 'admin/settings/_choice_select.html.twig' with {
                                                        field: field,
                                                        value: values[key],
                                                        options: definition.type == 'boolean' ? null : definition.options,
                                                        bare: true,
                                                    } %}
                                                {% elseif item.secret %}
                                                    <input class="input" type="password" name="{{ field }}" value="{{ values[key] }}" autocomplete="new-password" placeholder="{{ values[key] ? ('settings.secret.placeholder'|trans) : '' }}">
                                                {% elseif isColor %}
                                                    {% include 'admin/settings/_color_picker.html.twig' %}
                                                {% elseif key == 'brand.custom_css' %}
                                                    {% include 'admin/settings/_css_editor.html.twig' %}
                                                {% elseif key == 'admin.dashboard.layout' %}
                                                    {% include 'admin/settings/_dashboard_widgets.html.twig' %}
                                                {% elseif definition.type == 'json' %}
                                                    <textarea class="input" name="{{ field }}" rows="6" spellcheck="false">{{ values[key]|json_encode }}</textarea>
                                                {% else %}
                                                    <input class="input" type="text" name="{{ field }}" value="{{ values[key] }}">
                                                {% endif %}
                                                {% if helpText %}
                                                    <small class="field__hint">{{ helpText }}</small>
                                                {% endif %}
                                            {% if isWidget %}</div>{% else %}</label>{% endif %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% if groupId == 'storefront' %}
                                <div class="form-grid" style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border, rgba(0,0,0,.08))">
                                    <div class="field field--full">
                                        <span class="settings-row__label">{{ 'settings.storefront.rebuild'|trans }}</span>
                                        <p class="muted" style="margin:.35rem 0 .75rem">{{ 'settings.storefront.rebuild.help'|trans }}</p>
                                        <button
                                            type="submit"
                                            class="btn btn--primary"
                                            formaction="{{ url('admin.settings.storefront.rebuild') }}"
                                            formmethod="post"
                                            data-confirm="{{ 'settings.storefront.rebuild.confirm'|trans|e('html_attr') }}"
                                            data-confirm-title="{{ 'settings.storefront.rebuild'|trans|e('html_attr') }}"
                                            data-confirm-label="{{ 'settings.storefront.rebuild'|trans|e('html_attr') }}"
                                            data-confirm-danger="0"
                                        >{{ 'settings.storefront.rebuild'|trans }}</button>
                                    </div>
                                </div>
                            {% endif %}
                            </section>

                            {% if groupId == 'core' %}
                                {{ apply_filters('admin.settings.panel.core', '')|raw }}
                            {% endif %}
                        </div>
                    {% endif %}
                </section>
            {% endfor %}
        </div>
    </form>
    {{ apply_filters('admin.settings.extra_forms', '')|raw }}
{% endblock %}
