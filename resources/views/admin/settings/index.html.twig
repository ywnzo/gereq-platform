{% extends 'admin/layout.html.twig' %}

{% block content %}
    {% set firstGroup = groups|keys|first %}
    {% set groupIcons = {
        core: 'settings',
        dashboard: 'home',
        brand: 'palette',
        cms: 'layout',
        shop: 'bag',
        orders: 'receipt',
        payments: 'credit-card',
        customer_uploads: 'image',
        other: 'modules'
    } %}

    <form id="settings-form" method="post" action="{{ url('admin.settings.update') }}" class="settings-shell" autocomplete="off" enctype="multipart/form-data"
          x-data="gereqTabs" data-initial="{{ activeTab|default(firstGroup) }}">
        {{ csrf_field()|raw }}
        <input type="hidden" name="settings_tab" value="{{ activeTab|default(firstGroup) }}">

        <header class="settings-hero">
            <div class="settings-hero__copy">
                <p class="eyebrow">{{ 'nav.settings'|trans }}</p>
                <h1>{{ 'settings.title'|trans }}</h1>
                <p class="settings-hero__lead muted">{{ 'settings.intro'|trans }}</p>
            </div>
            <div class="settings-hero__actions">
                <button class="btn btn--primary btn--lg" type="submit">{{ 'settings.save'|trans }}</button>
            </div>
        </header>

        <div class="settings-layout">
            <nav class="settings-nav" role="tablist" aria-label="{{ 'settings.title'|trans }}">
                {% for groupId, group in groups %}
                    <button type="button" class="settings-nav__item design-tab" role="tab" data-tab="{{ groupId }}">
                        <span class="settings-nav__icon">{{ icon(groupIcons[groupId]|default('settings')) }}</span>
                        <span class="settings-nav__text">
                            <span class="settings-nav__label">{{ group.label|trans }}</span>
                            {% set groupHelp = 'settings.group.' ~ groupId ~ '.help' %}
                            {% if groupHelp|trans != groupHelp %}
                                <span class="settings-nav__hint">{{ groupHelp|trans }}</span>
                            {% endif %}
                        </span>
                    </button>
                {% endfor %}
            </nav>

            <div class="settings-main">
                {% for groupId, group in groups %}
                    <section class="design-panel settings-panel" data-panel="{{ groupId }}" role="tabpanel"
                        {% if groupId == 'brand' %}x-data="settingsBrandPreview"{% endif %}>
                        <div class="settings-panel__head">
                            <div>
                                <h2>{{ group.label|trans }}</h2>
                                {% set groupHelp = 'settings.group.' ~ groupId ~ '.help' %}
                                {% if groupHelp|trans != groupHelp %}
                                    <p class="muted">{{ groupHelp|trans }}</p>
                                {% endif %}
                            </div>
                            <span class="settings-panel__count">{{ group.items|length }}</span>
                        </div>

                        <div class="settings-panel__body{% if groupId == 'brand' %} settings-panel__body--brand{% endif %}">
                            <div class="settings-cards">
                                {% for item in group.items %}
                                    {% set key = item.key %}
                                    {% set definition = item.definition %}
                                    {% set field = key|replace({'.': '__'}) %}
                                    {% set helpKey = definition.label ~ '.help' %}
                                    {% set isColor = 'color_' in key or key ends with '_primary' %}
                                    <div class="settings-card{% if isColor %} settings-card--color{% endif %}{% if key == 'admin.dashboard.layout' %} settings-card--wide{% endif %}">
                                        <div class="settings-card__meta">
                                            <span class="settings-card__label">{{ definition.label|trans }}</span>
                                            {% if helpKey|trans != helpKey and key != 'admin.dashboard.layout' %}
                                                <span class="settings-card__help">{{ helpKey|trans }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="settings-card__control">
                                            {% if definition.type == 'boolean' %}
                                                <select class="input" name="{{ field }}">
                                                    <option value="1" {{ values[key] ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                                                    <option value="0" {{ not values[key] ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
                                                </select>
                                            {% elseif definition.options is defined and definition.options is not empty %}
                                                <select class="input" name="{{ field }}">
                                                    {% for optionValue, optionLabel in definition.options %}
                                                        <option value="{{ optionValue }}" {{ values[key] == optionValue ? 'selected' : '' }}>{{ optionLabel|trans }}</option>
                                                    {% endfor %}
                                                </select>
                                            {% elseif item.secret %}
                                                <input class="input" type="password" name="{{ field }}" value="{{ values[key] }}" autocomplete="new-password" placeholder="{{ values[key] ? ('settings.secret.placeholder'|trans) : '' }}">
                                            {% elseif isColor %}
                                                {% include 'admin/settings/_color_picker.html.twig' %}
                                            {% elseif key in ['brand.logo_url', 'brand.favicon_url'] %}
                                                {% include 'admin/settings/_brand_asset.html.twig' %}
                                            {% elseif key in ['cms.custom_css_admin', 'cms.custom_css_public'] %}
                                                {% include 'admin/settings/_css_editor.html.twig' %}
                                            {% elseif key == 'admin.dashboard.layout' %}
                                                {% include 'admin/settings/_dashboard_widgets.html.twig' %}
                                            {% else %}
                                                <input class="input" type="text" name="{{ field }}" value="{{ values[key] }}"
                                                    {% if groupId == 'brand' %}@input="touch"{% endif %}>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            {% if groupId == 'brand' %}
                                <aside class="settings-preview" aria-live="polite">
                                    <div class="settings-preview__label">{{ 'settings.preview'|trans }}</div>
                                    <div class="settings-preview__admin" :style="adminStyle">
                                        <div class="settings-preview__lockup">
                                            <img class="settings-preview__mark" :src="logoUrl" width="36" height="36" alt="">
                                            <div>
                                                <div class="settings-preview__name" x-text="name"></div>
                                                <div class="settings-preview__sub" x-text="subtitle"></div>
                                            </div>
                                        </div>
                                        <button type="button" class="settings-preview__btn" :style="btnStyle">{{ 'settings.save'|trans }}</button>
                                    </div>
                                    <div class="settings-preview__site">
                                        <div class="settings-preview__site-bar" :style="siteBarStyle">
                                            <span class="settings-preview__badge" :style="badgeStyle" x-text="siteMark"></span>
                                            <span class="settings-preview__site-name" x-text="siteName"></span>
                                        </div>
                                        <p class="settings-preview__tagline" x-show="tagline" x-text="tagline"></p>
                                        <p class="settings-preview__tagline" x-show="!tagline">{{ 'settings.preview.tagline_fallback'|trans }}</p>
                                    </div>
                                    <div class="settings-preview__swatches">
                                        <span class="settings-preview__swatch" :style="'background:' + signal" title="{{ 'settings.brand.color_signal'|trans }}"></span>
                                        <span class="settings-preview__swatch" :style="'background:' + ink" title="{{ 'settings.brand.color_ink'|trans }}"></span>
                                        <span class="settings-preview__swatch" :style="'background:' + cream" title="{{ 'settings.brand.color_cream'|trans }}"></span>
                                        <span class="settings-preview__swatch" :style="'background:' + sitePrimary" title="{{ 'settings.brand.site_primary'|trans }}"></span>
                                    </div>
                                </aside>
                            {% endif %}
                        </div>
                    </section>
                {% endfor %}
            </div>
        </div>

        <div class="settings-footer">
            <p class="muted settings-footer__hint">{{ 'settings.footer_hint'|trans }}</p>
            <button class="btn btn--primary btn--lg" type="submit">{{ 'settings.save'|trans }}</button>
        </div>
    </form>
{% endblock %}
