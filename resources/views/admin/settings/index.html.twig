{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.settings'|trans },
    ] } %}
{% endblock %}

{% block content %}
    {% set firstGroup = groups|keys|first %}
    {% set wideKeys = [
        'brand.custom_css'
    ] %}

    <form
        id="settings-form"
        class="settings-page"
        method="post"
        action="{{ url('admin.settings.update') }}"
        autocomplete="off"
        enctype="multipart/form-data"
        x-data="gereqTabs"
        data-initial="{{ activeTab|default(firstGroup) }}"
    >
        {{ csrf_field()|raw }}
        <input type="hidden" name="settings_tab" value="{{ activeTab|default(firstGroup) }}">

        <header class="page-header">
            <div>
                <h1>{{ 'settings.title'|trans }}</h1>
                <p class="muted">{{ 'settings.intro'|trans }}</p>
            </div>
            <div class="actions">
                {% include 'ui/button.html.twig' with { label: 'settings.save'|trans, type: 'submit', variant: 'primary' } only %}
            </div>
        </header>

        <div class="detail-hub settings-page__layout">
            {% embed 'ui/tabs.html.twig' with { tabs_options: { tag: 'div' } } %}{% block component_attributes %} class="design-tabs detail-tabs" role="tablist" aria-label="{{ 'settings.title'|trans }}"{% endblock %}{% block content %}
                {% for groupId, group in groups %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab" role="tab" data-tab="{{ groupId }}"{% endblock %}{% block content %}
                        {{ group.label|trans }}
                    {% endblock %}{% endembed %}
                {% endfor %}
            {% endblock %}{% endembed %}

            {% for groupId, group in groups %}
                {% set groupHelp = 'settings.group.' ~ groupId ~ '.help' %}
                <section
                    class="design-panel"
                    data-panel="{{ groupId }}"
                    role="tabpanel"
                >
                    {% if groupId == 'core' %}
                        {% include 'admin/settings/_platform_tab.html.twig' with { group: group, values: values, adminPath: adminPath } only %}
                    {% elseif groupId == 'storefront' %}
                        {% if canManageSettings %}
                            {% include 'admin/settings/_storefront_tab.html.twig' with { group: group, values: values, originEnvironment: originEnvironment, uploadSettings: uploadSettings } only %}
                        {% endif %}
                    {% elseif groupId == 'brand' %}
                        {% include 'admin/settings/_brand_tab.html.twig' with {
                            group: group,
                            values: values,
                            cssVariables: cssVariables,
                            wideKeys: wideKeys,
                            libraryImages: libraryImages|default([]),
                            brandPalette: brandPalette,
                            brandAppearance: brandAppearance,
                            adminFont: adminFont,
                            adminFonts: adminFonts,
                        } %}
                    {% else %}
                        <div class="detail-stack">
                            {% if canManageSettings or groupId != 'storefront' %}
                            {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
                                {% block attributes %} class="panel settings-page__panel"{% endblock %}
                                {% block content %}
                                <header class="panel__head">
                                    <div>
                                        <h2>{{ group.label|trans }}</h2>
                                        {% if groupHelp|trans != groupHelp %}
                                            <p class="muted">{{ groupHelp|trans }}</p>
                                        {% endif %}
                                    </div>
                                </header>
                                <div class="form-grid">
                                    {% for item in group.items %}
                                        {% set key = item.key %}
                                        {% set definition = item.definition %}
                                        {% set field = key|replace({'.': '__'}) %}
                                        {% set helpKey = definition.label ~ '.help' %}
                                        {% set helpText = helpKey|trans != helpKey ? helpKey|trans : '' %}
                                        {% set isColor = 'color_' in key or key ends with '_primary' %}
                                        {% set isWide = key in wideKeys %}
                                        {% set isWidget = isColor or isWide %}
                                        {% set isChoice = definition.type == 'boolean' or (definition.options is defined and definition.options is not empty) %}
                                        {% if groupId == 'storefront' and key in ['storefront.origins_override', 'storefront.path', 'storefront.cache_enabled'] %}
                                            {% set section = key == 'storefront.origins_override' ? 'origins' : (key == 'storefront.path' ? 'build' : 'cache') %}
                                            <h3 class="settings-page__section-title field--full">{{ ('settings.storefront.section.' ~ section)|trans }}</h3>
                                        {% endif %}
                                        {% if key == 'storefront.origins_override' %}
                                            {% set originMode = old('origin_mode', values[key] ? 'custom' : 'environment', 'settings.origins') %}
                                            <div class="field field--full" x-data="gereqStorefrontOrigins" data-mode="{{ originMode }}" @change="updateMode">
                                                {% include 'admin/settings/_choice_select.html.twig' with {
                                                    field: 'origin_mode', value: originMode,
                                                    options: { environment: 'settings.storefront.origins.environment', custom: 'settings.storefront.origins.custom' },
                                                    label: 'settings.storefront.origins.mode'|trans,
                                                } %}
                                                {% include 'admin/settings/_environment_origins.html.twig' with { originEnvironment: originEnvironment } only %}
                                                <label class="field" x-show="isCustom" x-cloak>
                                                    <span>{{ 'settings.storefront.origins'|trans }}</span>
                                                    {% embed 'ui/textarea.html.twig' with { textarea_options: { control_only: true } } %}{% block input_attributes %} class="input settings-origins" name="origins" rows="2"{% endblock %}{% block content %}{{ old('origins', values[key] ?: originEnvironment, 'settings.origins') }}{% endblock %}{% endembed %}
                                                    {% if error('origins', 'settings.origins') %}<small class="g-error">{{ error('origins', 'settings.origins')|trans }}</small>{% endif %}
                                                    <small class="field__hint">{{ 'settings.storefront.origins.help'|trans }}</small>
                                                </label>
                                            </div>
                                        {% elseif isChoice and not isWidget %}
                                            {% include 'admin/settings/_choice_select.html.twig' with {
                                                field: field,
                                                value: values[key],
                                                options: definition.type == 'boolean' ? null : definition.options,
                                                label: definition.label|trans,
                                                hint: helpText,
                                            } %}
                                        {% else %}
                                            {% if isWidget %}
                                                <div class="settings-row{% if isWide %} field--full{% endif %}">
                                                <span class="settings-row__label">{{ definition.label|trans }}</span>
                                            {% else %}
                                                <label class="field">
                                                <span>{{ definition.label|trans }}</span>
                                            {% endif %}
                                                {% if isChoice %}
                                                    {% include 'admin/settings/_choice_select.html.twig' with {
                                                        field: field,
                                                        value: values[key],
                                                        options: definition.type == 'boolean' ? null : definition.options,
                                                        bare: true,
                                                    } %}
                                                {% elseif item.secret %}
                                                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="password" name="{{ field }}" value="{{ values[key] }}" autocomplete="new-password" placeholder="{{ values[key] ? ('settings.secret.placeholder'|trans) : '' }}"{% endblock %}{% endembed %}
                                                {% elseif isColor %}
                                                    {% include 'admin/settings/_color_picker.html.twig' %}
                                                {% elseif key == 'brand.custom_css' %}
                                                    {% include 'admin/settings/_css_editor.html.twig' %}
                                                {% elseif definition.type == 'json' %}
                                                    {% embed 'ui/textarea.html.twig' with { textarea_options: { control_only: true } } %}{% block input_attributes %} class="input" name="{{ field }}" rows="6" spellcheck="false"{% endblock %}{% block content %}{{ values[key]|json_encode }}{% endblock %}{% endembed %}
                                                {% else %}
                                                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="{{ field }}" value="{{ values[key] }}"{% endblock %}{% endembed %}
                                                {% endif %}
                                                {% if helpText %}
                                                    <small class="field__hint">{{ helpText }}</small>
                                                {% endif %}
                                            {% if isWidget %}</div>{% else %}</label>{% endif %}
                                        {% endif %}
                                        {% if groupId == 'storefront' and key == 'storefront.build_command' and canManageSettings %}
                                            <div class="field field--full settings-page__action">
                                                <p class="field__hint">{{ 'settings.storefront.rebuild.help'|trans }}</p>
                                                {% include 'ui/button.html.twig' with {
                                                    label: 'settings.storefront.rebuild'|trans,
                                                    type: 'submit', variant: 'ghost',
                                                    attrs: { 'formaction': (url('admin.settings.storefront.rebuild')), 'formmethod': 'post', 'data-confirm': ('settings.storefront.rebuild.confirm'|trans|e('html_attr')), 'data-confirm-title': ('settings.storefront.rebuild'|trans|e('html_attr')), 'data-confirm-label': ('settings.storefront.rebuild'|trans|e('html_attr')), 'data-confirm-danger': '0' }
                                                } only %}
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                {% endblock %}
                            {% endembed %}
                            {% endif %}

                        </div>
                    {% endif %}
                </section>
            {% endfor %}
        </div>
    </form>
    {% if canManageSettings %}{{ apply_filters('admin.settings.extra_forms', '')|raw }}{% endif %}
{% endblock %}
