{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>Nastavení</h1>
    </header>
    <form method="post" action="{{ url('admin.settings.update') }}" class="stack">
        {{ csrf_field()|raw }}
        {% for key, definition in definitions %}
            {% set field = key|replace({'.': '__'}) %}
            <label class="field">
                <span>{{ definition.label }}</span>
                {% if definition.type == 'boolean' %}
                    <select name="{{ field }}">
                        <option value="1" {{ values[key] ? 'selected' : '' }}>Ano</option>
                        <option value="0" {{ not values[key] ? 'selected' : '' }}>Ne</option>
                    </select>
                {% else %}
                    <input type="text" name="{{ field }}" value="{{ values[key] }}">
                {% endif %}
                <small class="muted">{{ key }}</small>
            </label>
        {% endfor %}
        <button class="btn btn--primary" type="submit">Uložit nastavení</button>
    </form>
{% endblock %}
