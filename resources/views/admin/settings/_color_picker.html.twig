{% set colorValue = values[key]|default('') %}
{% if colorValue is empty %}{% set colorValue = values['brand.color_signal']|default('#d7ff45') ?: '#d7ff45' %}{% endif %}
{% set colorHex = colorValue|replace({'#': ''}) %}
<div
    class="color-picker"
    x-data="gereqColorField"
    data-value="{{ colorValue }}"
    @click.outside="close"
>
    <input type="hidden" name="{{ field }}" value="{{ colorValue }}" data-color-value>
    <div class="color-picker__row">
        <label class="color-picker__chip">
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                type="color"
                class="color-picker__native"
                value="{{ colorValue }}"
                aria-label="{{ definition.label|trans }}"
            {% endblock %}{% endembed %}
            <span class="color-picker__chip-face" style="background: {{ colorValue }}"></span>
        </label>
        <div class="color-picker__hex-field">
            <span class="color-picker__hash">#</span>
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                class="color-picker__hex-input"
                type="text"
                maxlength="6"
                value="{{ colorHex }}"
                x-model="draft"
                spellcheck="false"
                autocomplete="off"
                aria-label="HEX"
            {% endblock %}{% endembed %}
        </div>
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="color-picker__more" @click="toggle" :aria-expanded="open ? 'true' : 'false'" title="{{ 'settings.color.presets'|trans }}"{% endblock %}{% block content %}
            {{ icon('palette') }}
        {% endblock %}{% endembed %}
    </div>
    <div
        class="color-picker__panel"
        x-show="open"
        x-cloak
        role="listbox"
        aria-label="{{ 'settings.color.presets'|trans }}"
    >
        <p class="color-picker__panel-label">{{ 'settings.color.presets'|trans }}</p>
        <div class="color-picker__presets">
            <template x-for="preset in presets" :key="preset">
                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                    type="button"
                    class="color-picker__preset"
                    role="option"
                    :class="isPreset(preset) ? 'is-active' : ''"
                    :style="presetStyle(preset)"
                    :aria-selected="isPreset(preset) ? 'true' : 'false'"
                    :title="preset"
                    @click="pick(preset)"
                {% endblock %}{% block content %}
                    <span class="color-picker__preset-check" :style="checkOn(preset)" aria-hidden="true">{{ icon('check') }}</span>
                {% endblock %}{% endembed %}
            </template>
        </div>
    </div>
</div>
