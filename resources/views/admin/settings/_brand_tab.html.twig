{#
  Brand settings tab — form-grid cols + grq-grid split + live preview.
  Expects: group, values, cssVariables, wideKeys, libraryImages
#}
{% set byKey = {} %}
{% for item in group.items %}
    {% set byKey = byKey|merge({ (item.key): item }) %}
{% endfor %}

{% set brandWide = [] %}
{% set fieldCtx = {
    values: values,
    groupId: 'brand',
    cssVariables: cssVariables,
    wideKeys: brandWide,
    libraryImages: libraryImages|default([])
} %}

<div class="brand-settings" x-data="settingsBrandPreview"
     data-palette-url="{{ url('admin.settings.palette.preview') }}"
     data-palette-error="{{ 'settings.palette.preview_error'|trans|e('html_attr') }}"
     data-storefront-theme-light="{{ 'settings.theme.light'|trans|e('html_attr') }}"
     data-storefront-theme-dark="{{ 'settings.theme.dark'|trans|e('html_attr') }}"
     data-storefront-theme-label="{{ 'settings.palette.storefront_mode'|trans|e('html_attr') }}"
     data-admin-fonts="{{ adminFonts|json_encode|e('html_attr') }}"
     data-default-subtitle="{{ 'brand.subtitle'|trans|e('html_attr') }}"
     data-app-name="{{ brand('app_name')|e('html_attr') }}">
    <div class="brand-settings__fields">
        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel brand-settings__section brand-settings__section--identity"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <div>
                    <h2>{{ 'settings.brand.section.identity'|trans }}</h2>
                    <p class="muted">{{ 'settings.brand.section.identity.help'|trans }}</p>
                </div>
            </header>
            <div class="form-grid">
                {% for key in ['brand.name', 'brand.subtitle'] %}
                    {% if byKey[key] is defined %}
                        {% include 'admin/settings/_brand_field.html.twig' with fieldCtx|merge({ item: byKey[key] }) %}
                    {% endif %}
                {% endfor %}
            </div>
            <div class="form-grid brand-settings__assets">
                {% for key in ['brand.logo_url', 'brand.favicon_url'] %}
                    {% if byKey[key] is defined %}
                        {% include 'admin/settings/_brand_field.html.twig' with fieldCtx|merge({ item: byKey[key] }) %}
                    {% endif %}
                {% endfor %}
            </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel brand-settings__section brand-settings__section--public"{% endblock %}
            {% block content %}
                <header class="panel__head"><div><h2>{{ 'settings.brand.section.public'|trans }}</h2><p class="muted">{{ 'settings.brand.section.public.help'|trans }}</p></div></header>
                <div class="form-grid">
                    {% for key in ['brand.site_mark', 'brand.tagline', 'brand.footnote'] %}
                        {% if byKey[key] is defined %}
                            {% include 'admin/settings/_brand_field.html.twig' with fieldCtx|merge({ item: byKey[key] }) %}
                        {% endif %}
                    {% endfor %}
                </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel brand-settings__section brand-settings__section--colors"{% endblock %}
            {% block content %}
            <header class="panel__head panel__head--actions">
                <div>
                    <h2>{{ 'settings.brand.section.colors'|trans }}</h2>
                    <p class="muted">{{ 'settings.brand.section.colors.help'|trans }}</p>
                </div>
            </header>
            <input type="hidden" name="palette_present" value="1">
            <input type="hidden" name="palette_dirty" value="0">
            <p class="field__hint brand-settings__palette-warning" x-show="paletteWarning" x-text="paletteWarning" role="status" x-cloak></p>
            <div class="brand-settings__palette">
              <div class="brand-settings__palette-fields">
                {% for section, fields in {
                    'colors': ['primary', 'secondary', 'accent'],
                    'light': ['light_background', 'light_surface', 'light_header'],
                    'dark': ['dark_background', 'dark_surface', 'dark_header'],
                } %}
                    <div class="brand-settings__palette-group">
                        <h3>{{ ('settings.palette.section.' ~ section)|trans }}</h3>
                        <div class="form-grid form-grid--cols-3">
                            {% for paletteKey in fields %}
                                <div class="settings-row settings-row--color">
                                    <span class="settings-row__label">{{ ('settings.palette.' ~ paletteKey)|trans }}</span>
                                    {% include 'admin/settings/_color_picker.html.twig' with {
                                        key: paletteKey, field: 'palette_' ~ paletteKey,
                                        values: { (paletteKey): brandPalette[paletteKey] },
                                        definition: { label: 'settings.palette.' ~ paletteKey },
                                    } only %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
              </div>
                <div class="brand-storefront-preview-wrap">
                    <div class="brand-storefront-preview__heading">
                        <div class="brand-storefront-preview__intro">
                            <h3>{{ 'settings.palette.preview.title'|trans }}</h3>
                            <p class="muted">{{ 'settings.palette.preview.help'|trans }}</p>
                        </div>
                        <div class="brand-storefront-preview__controls">
                            <div class="brand-settings__generator">
                                {% include 'admin/settings/_choice_select.html.twig' with {
                                    field: 'palette_generator_style', value: 'balanced', label: 'settings.palette.generator.style'|trans,
                                    options: { balanced: 'settings.palette.generator.balanced', pastel: 'settings.palette.generator.pastel', monochrome: 'settings.palette.generator.monochrome', nature: 'settings.palette.generator.nature' },
                                } only %}
                                {% include 'ui/button.html.twig' with { icon: 'auto_awesome', class: 'icon-btn', attrs: { '@click': 'generatePalette', 'aria-label': 'settings.palette.generator.generate'|trans, title: 'settings.palette.generator.generate'|trans } } only %}
                            </div>
                            <input type="hidden" name="palette_storefront_mode" value="{{ brandPalette.storefront_mode }}">
                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="icon-btn" @click="toggleStorefrontTheme" :aria-label="storefrontThemeLabel" :title="storefrontThemeLabel"{% endblock %}{% block content %}
                                <span class="material-symbols-outlined g-icon" aria-hidden="true" x-text="storefrontThemeIcon">{{ brandPalette.storefront_mode == 'dark' ? 'dark_mode' : 'light_mode' }}</span>
                            {% endblock %}{% endembed %}
                        </div>
                    </div>
                    <div class="brand-storefront-preview">
                        <div class="brand-storefront-preview__nav">
                            <strong>{{ brand('site_name') }}</strong>
                            <span>{{ 'settings.palette.preview.nav'|trans }}</span>
                        </div>
                        <div class="brand-storefront-preview__hero">
                            <span class="brand-storefront-preview__eyebrow">{{ 'settings.palette.preview.eyebrow'|trans }}</span>
                            <strong>{{ 'settings.palette.preview.headline'|trans }}</strong>
                            <span>{{ 'settings.palette.preview.description'|trans }}</span>
                            <div class="brand-storefront-preview__actions">
                                <span class="brand-storefront-preview__button brand-storefront-preview__button--primary">{{ 'settings.palette.preview.primary'|trans }}</span>
                                <span class="brand-storefront-preview__button brand-storefront-preview__button--secondary">{{ 'settings.palette.preview.secondary'|trans }}</span>
                            </div>
                        </div>
                        <div class="brand-storefront-preview__card">
                            <span class="brand-storefront-preview__badge">{{ 'settings.palette.preview.accent'|trans }}</span>
                            <strong>{{ 'settings.palette.preview.card'|trans }}</strong>
                            <span>{{ 'settings.palette.preview.card_description'|trans }}</span>
                            <span class="brand-storefront-preview__input-label">{{ 'settings.palette.preview.input'|trans }}</span>
                            <span class="brand-storefront-preview__input">email@example.com</span>
                        </div>
                        <div class="brand-storefront-preview__footer"><span>{{ 'settings.palette.preview.nav'|trans }}</span></div>
                    </div>
                </div>
            </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel brand-settings__section brand-settings__section--appearance"{% endblock %}
            {% block content %}
            <header class="panel__head"><div><h2>{{ 'settings.brand.appearance.title'|trans }}</h2><p class="muted">{{ 'settings.brand.appearance.help'|trans }}</p></div></header>
            <div class="brand-settings__appearance">
                <input type="hidden" name="appearance_present" value="1">
                {% include 'admin/settings/_choice_select.html.twig' with {
                    field: 'admin_font', value: adminFont,
                    options: { default: 'settings.brand.font.default', system: 'settings.brand.font.system', serif: 'settings.brand.font.serif', rounded: 'settings.brand.font.rounded' },
                    label: 'settings.brand.appearance.font'|trans, hint: 'settings.brand.appearance.font.help'|trans,
                    extra: 'brand-settings__font',
                } only %}
                {% include 'ui/switch.html.twig' with { name: 'admin_motion', label: 'settings.brand.appearance.motion'|trans, hint: 'settings.brand.appearance.motion.help'|trans, on: brandAppearance.motion } only %}
                <div class="brand-settings__opacity">
                    {% include 'ui/range.html.twig' with { name: 'admin_panel_opacity', id: 'admin-panel-opacity', label: 'settings.brand.appearance.opacity'|trans, hint: 'settings.brand.appearance.opacity.help'|trans, value: brandAppearance.panel_opacity, min: 0, max: 100, step: 5 } only %}
                    <output for="admin-panel-opacity" data-opacity-output>{{ brandAppearance.panel_opacity }}%</output>
                </div>
            </div>
            {% endblock %}
        {% endembed %}

    </div>

</div>
