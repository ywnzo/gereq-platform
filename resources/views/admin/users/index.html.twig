{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>Uživatelé</h1>
        {% if user.can('users.create') %}
            <a class="btn btn--primary" href="{{ url('admin.users.create') }}">{{ icon('plus') }} Nový uživatel</a>
        {% endif %}
    </header>

    <form class="toolbar" method="get">
        <input type="search" name="q" value="{{ search }}" placeholder="Hledat jméno nebo e-mail…" class="input">
    </form>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Jméno</th>
                    <th>E-mail</th>
                    <th>Role</th>
                    <th>Stav</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in users %}
                    <tr>
                        <td>
                            <div class="cell-user">
                                <span class="avatar avatar--sm">{{ item.initials() }}</span>
                                {{ item.name() }}
                            </div>
                        </td>
                        <td>{{ item.email() }}</td>
                        <td>
                            {% for role in item.roles() %}
                                <span class="badge">{{ role.label() }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : 'muted' }}">
                                {{ item.status() == 'active' ? 'Aktivní' : 'Neaktivní' }}
                            </span>
                        </td>
                        <td class="table__actions">
                            {% if user.can('users.edit') %}
                                <a href="{{ url('admin.users.edit', {id: item.id()}) }}">Upravit</a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">
                            <div class="empty">Nikdo tu zatím není.</div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
