{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.users'|trans },
    ] } %}
{% endblock %}

{% block content %}
<div class="list-shell list-shell--tabs" x-data="dataTable" data-table-id="admin-users" data-actions-default="1">
    <header class="page-header">
        <div>
            <h1>{{ 'admin.users.title'|trans }}</h1>
            <p class="muted">{{ 'admin.users.hub.hint'|trans }}</p>
        </div>
        {% if user.can('users.create') %}
            <div class="actions">
                <a class="btn btn--primary" href="{{ url('admin.users.create') }}">{{ icon('plus') }} {{ 'admin.users.new'|trans }}</a>
            </div>
        {% endif %}
    </header>

    {% include 'admin/users/_hub_tabs.html.twig' with { active: 'users' } %}

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input type="search" name="q" value="{{ search }}" placeholder="{{ 'admin.users.search'|trans }}" class="input">
        </form>
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'common.name'|trans }}</th>
                    <th>{{ 'common.email'|trans }}</th>
                    <th>{{ 'common.roles'|trans }}</th>
                    <th>{{ 'common.status'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in users %}
                    <tr>
                        <td>
                            <div class="cell-user">
                                {{ ui().avatar({
                                    email: item.email(),
                                    initials: item.initials(),
                                    src: item.avatarFileId() ? url('admin.users.avatar', {id: item.id()}) : null,
                                    size: 'sm',
                                })|raw }}
                                <span class="cell-user__text">
                                    <strong>{{ item.name() }}</strong>
                                    {% if item.phone() %}
                                        <small class="muted">{{ item.phone() }}</small>
                                    {% endif %}
                                </span>
                            </div>
                        </td>
                        <td>{{ item.email() }}</td>
                        <td>
                            {% for role in item.roles() %}
                                <span class="badge">{{ role.label() }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : 'muted' }}">
                                {{ item.status() == 'active' ? 'common.active'|trans : 'common.inactive'|trans }}
                            </span>
                        </td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('users.edit') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.users.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">
                            <div class="empty">{{ 'empty.users'|trans }}</div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
