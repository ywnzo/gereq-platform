{% extends 'admin/layout.html.twig' %}

{% set firstName = item ? (item.firstName() ?: item.name()|split(' ')|first) : '' %}
{% set lastName = item ? (item.lastName() ?: (item.name()|split(' ')|slice(1)|join(' '))) : '' %}
{% set shippingSame = item and item.billingStreet() and item.billingStreet() == item.shippingStreet() and item.billingCity() == item.shippingCity() and item.billingZip() == item.shippingZip() %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.users'|trans, url: url('admin.users.index') },
        { label: item ? item.name() : 'admin.users.new'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header user-edit-header{{ item and item.bannerFileId() ? ' user-edit-header--banner' : '' }}">
    {% if item and item.bannerFileId() %}
        <div class="user-edit-header__banner" style="background-image:url('{{ url('admin.users.banner', {id: item.id()}) }}')" aria-hidden="true"></div>
    {% endif %}
    <div class="user-edit-hero">
        {{ ui().avatar({
            email: item ? item.email() : null,
            initials: item ? item.initials() : '?',
            src: item and item.avatarFileId() ? url('admin.users.avatar', {id: item.id()}) : null,
            alt: item ? item.name() : '',
            size: 'xl',
        })|raw }}
        <div>
            <h1>{{ item ? item.name() : 'admin.users.new'|trans }}</h1>
            {% if item %}
                <p class="muted detail-layout__meta">
                    {{ item.email() }}
                    <span class="badge badge--{{ item.status() == 'active' ? 'ok' : 'muted' }}">
                        {{ item.status() == 'active' ? 'common.active'|trans : 'common.inactive'|trans }}
                    </span>
                    {% if item.age() is not null %}
                        <span>{{ 'admin.users.age_years'|trans({ '%age%': item.age() }) }}</span>
                    {% endif %}
                </p>
            {% else %}
                <p class="muted">{{ 'admin.users.hub.hint'|trans }}</p>
            {% endif %}
        </div>
    </div>
    <div class="actions">
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} class="btn btn--primary" type="submit" form="user-form"{% endblock %}{% block content %}{{ icon('check') }} {{ 'common.save'|trans }}{% endblock %}{% endembed %}
        {% include 'ui/button.html.twig' with {
            label: 'common.cancel'|trans,
            href: (url('admin.users.index')),
            button_options: { tag: 'a' },
            variant: 'ghost'
        } only %}
        {% if item and user.can('users.delete') %}
            {% include 'ui/button.html.twig' with {
                label: 'common.delete'|trans,
                type: 'submit',
                variant: 'danger',
                attrs: { 'form': 'delete-user' }
            } only %}
        {% endif %}
    </div>
</header>

{% embed 'ui/tabs.html.twig' with { tabs_options: { tag: 'div' } } %}{% block component_attributes %}
    class="detail-hub user-edit"
    x-data="gereqTabs"
    data-initial="{{ activeTab|default('profile') }}"
{% endblock %}{% block content %}
    {% embed 'ui/tabs.html.twig' with { tabs_options: { tag: 'div' } } %}{% block component_attributes %} class="design-tabs detail-tabs" role="tablist" aria-label="{{ 'admin.users.title'|trans }}"{% endblock %}{% block content %}
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab" role="tab" data-tab="profile"{% endblock %}{% block content %}{{ 'admin.users.tab.profile'|trans }}{% endblock %}{% endembed %}
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab" role="tab" data-tab="addresses"{% endblock %}{% block content %}{{ 'admin.users.tab.addresses'|trans }}{% endblock %}{% endembed %}
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab" role="tab" data-tab="roles"{% endblock %}{% block content %}{{ 'admin.users.tab.roles'|trans }}{% endblock %}{% endembed %}
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab" role="tab" data-tab="security"{% endblock %}{% block content %}{{ 'admin.users.tab.security'|trans }}{% endblock %}{% endembed %}
    {% endblock %}{% endembed %}

    <form
        method="post"
        id="user-form"
        class="user-edit__form"
        enctype="multipart/form-data"
        action="{{ item ? url('admin.users.update', {id: item.id()}) : url('admin.users.store') }}"
        data-form="admin.users.save"
        x-data="gereqForm"
        {% if form_errors('admin.users.save') %}data-server-state="1"{% endif %}
    >
        {{ csrf_field()|raw }}
        <input type="hidden" name="settings_tab" value="{{ activeTab|default('profile') }}">

    <section class="design-panel" data-panel="profile" role="tabpanel">
        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <div>
                    <h2>{{ 'admin.users.section.identity'|trans }}</h2>
                    <p class="muted">{{ 'admin.users.section.identity.hint'|trans }}</p>
                </div>
            </header>
            <div class="form-grid">
                <div class="field field--full user-edit__media">
                    <div class="user-edit__photo">
                        {{ ui().avatar({
                            email: item ? item.email() : null,
                            initials: item ? item.initials() : '?',
                            src: item and item.avatarFileId() ? url('admin.users.avatar', {id: item.id()}) : null,
                            size: 'xl',
                        })|raw }}
                        <div class="user-edit__photo-actions">
                            {% include 'ui/file.html.twig' with {
                                name: 'avatar',
                                id: 'f-avatar',
                                label: 'admin.users.field.photo'|trans,
                                optional: true,
                                hint: 'admin.users.field.photo.hint'|trans,
                                accept: 'image/*',
                                compact: true
                            } %}
                            {% if item and item.avatarFileId() %}
                                <label class="check">
                                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="remove_avatar" value="1"{% endblock %}{% endembed %}
                                    <span>{{ 'admin.users.field.photo_remove'|trans }}</span>
                                </label>
                            {% endif %}
                        </div>
                    </div>
                    <div class="user-edit__banner">
                        {% if item and item.bannerFileId() %}
                            <div class="user-edit__banner-preview" style="background-image:url('{{ url('admin.users.banner', {id: item.id()}) }}')" role="img" aria-label="{{ 'admin.users.field.banner'|trans }}"></div>
                        {% else %}
                            <div class="user-edit__banner-preview user-edit__banner-preview--empty" aria-hidden="true"></div>
                        {% endif %}
                        <div class="user-edit__photo-actions">
                            {% include 'ui/file.html.twig' with {
                                name: 'banner',
                                id: 'f-banner',
                                label: 'admin.users.field.banner'|trans,
                                optional: true,
                                hint: 'admin.users.field.banner.hint'|trans,
                                accept: 'image/*',
                                compact: true
                            } %}
                            {% if item and item.bannerFileId() %}
                                <label class="check">
                                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="remove_banner" value="1"{% endblock %}{% endembed %}
                                    <span>{{ 'admin.users.field.banner_remove'|trans }}</span>
                                </label>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <label class="field">
                    <span>{{ 'admin.users.field.first_name'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="first_name" value="{{ firstName }}" required maxlength="120"{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'admin.users.field.last_name'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="last_name" value="{{ lastName }}" required maxlength="120"{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'common.email'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="email" name="email" value="{{ item ? item.email() : '' }}" required{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'common.phone'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="tel" name="phone" value="{{ item ? item.phone() : '' }}" maxlength="40"{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'admin.users.field.birth_date'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="date" name="birth_date" value="{{ item and item.birthDate() ? item.birthDate().format('Y-m-d') : '' }}"{% endblock %}{% endembed %}
                </label>
                {% if item %}
                    <label class="field">
                        <span>{{ 'common.status'|trans }}</span>
                        {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} class="input" name="status"{% endblock %}{% block native_options %}
                            {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="active" {{ item.status() == 'active' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'common.active'|trans }}{% endblock %}{% endembed %}
                            {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="disabled" {{ item.status() == 'disabled' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'common.inactive'|trans }}{% endblock %}{% endembed %}
                        {% endblock %}{% endembed %}
                    </label>
                {% endif %}
                <label class="field field--full">
                    <span>{{ 'admin.users.field.description'|trans }}</span>
                    {% embed 'ui/textarea.html.twig' with { textarea_options: { control_only: true } } %}{% block input_attributes %} class="input" name="description" rows="4" maxlength="4000"{% endblock %}{% block content %}{{ item ? item.description() : '' }}{% endblock %}{% endembed %}
                </label>
            </div>
            {% endblock %}
        {% endembed %}
        {{ apply_filters('admin.users.form_fields', '', item|default(null))|raw }}
    </section>

    <section class="design-panel" data-panel="addresses" role="tabpanel">
        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <div>
                    <h2>{{ 'admin.users.section.billing'|trans }}</h2>
                    <p class="muted">{{ 'admin.users.section.billing.hint'|trans }}</p>
                </div>
            </header>
            <div class="form-grid" x-data="gereqAresAddress">
                <div class="g-field field--full ares-field">
                    <label class="g-label" for="f-billing-street"><span>{{ 'admin.users.field.street'|trans }}</span></label>
                    <div class="ares-field__control">
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                            class="g-control"
                            type="text"
                            id="f-billing-street"
                            name="billing_street"
                            data-ares-query
                            data-ares-fill="street"
                            autocomplete="off"
                            value="{{ item ? item.billingStreet() : '' }}"
                            @input="onInput"
                            @keydown="onKeydown"
                            x-ref="query"
                        {% endblock %}{% endembed %}
                        {% include 'ui/ares_address_suggest.html.twig' %}
                    </div>
                </div>
                <label class="field">
                    <span>{{ 'admin.users.field.city'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="billing_city" data-ares-fill="city" value="{{ item ? item.billingCity() : '' }}"{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'admin.users.field.zip'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="billing_zip" data-ares-fill="zip" value="{{ item ? item.billingZip() : '' }}"{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'admin.users.field.country'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="billing_country" data-ares-fill="country" maxlength="2" value="{{ item ? (item.billingCountry() ?: 'CZ') : 'CZ' }}"{% endblock %}{% endembed %}
                </label>
            </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel" x-data="gereqSameAs" data-on="{{ shippingSame ? '1' : '0' }}"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <div>
                    <h2>{{ 'admin.users.section.shipping'|trans }}</h2>
                    <p class="muted">{{ 'admin.users.section.shipping.hint'|trans }}</p>
                </div>
            </header>
            <div class="form-grid">
                <label class="field field--full check">
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="shipping_same" value="1" x-model="same"{% endblock %}{% endembed %}
                    <span>{{ 'admin.users.field.shipping_same'|trans }}</span>
                </label>
                <div class="field field--full" x-show="shippingVisible" x-cloak>
                    <div class="form-grid" x-data="gereqAresAddress">
                        <div class="g-field field--full ares-field">
                            <label class="g-label" for="f-shipping-street"><span>{{ 'admin.users.field.street'|trans }}</span></label>
                            <div class="ares-field__control">
                                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                                    class="g-control"
                                    type="text"
                                    id="f-shipping-street"
                                    name="shipping_street"
                                    data-ares-query
                                    data-ares-fill="street"
                                    autocomplete="off"
                                    value="{{ item ? item.shippingStreet() : '' }}"
                                    @input="onInput"
                                    @keydown="onKeydown"
                                    x-ref="query"
                                {% endblock %}{% endembed %}
                                {% include 'ui/ares_address_suggest.html.twig' %}
                            </div>
                        </div>
                        <label class="field">
                            <span>{{ 'admin.users.field.city'|trans }}</span>
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="shipping_city" data-ares-fill="city" value="{{ item ? item.shippingCity() : '' }}"{% endblock %}{% endembed %}
                        </label>
                        <label class="field">
                            <span>{{ 'admin.users.field.zip'|trans }}</span>
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="shipping_zip" data-ares-fill="zip" value="{{ item ? item.shippingZip() : '' }}"{% endblock %}{% endembed %}
                        </label>
                        <label class="field">
                            <span>{{ 'admin.users.field.country'|trans }}</span>
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="shipping_country" data-ares-fill="country" maxlength="2" value="{{ item ? (item.shippingCountry() ?: 'CZ') : 'CZ' }}"{% endblock %}{% endembed %}
                        </label>
                    </div>
                </div>
            </div>
            {% endblock %}
        {% endembed %}
    </section>

    <section class="design-panel" data-panel="roles" role="tabpanel">
        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <div>
                    <h2>{{ 'common.roles'|trans }}</h2>
                    <p class="muted">{{ 'admin.users.section.roles.hint'|trans }}</p>
                </div>
            </header>
            <div class="chip-list user-edit__roles">
                {% for role in roles %}
                    <label class="check">
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="roles[]" value="{{ role.id() }}"
                            {{ item and item.hasRole(role.name()) ? 'checked' : '' }}{% endblock %}{% endembed %}
                        <span>
                            <strong>{{ role.label() }}</strong>
                            {% if role.description() %}
                                <small class="muted">{{ role.description() }}</small>
                            {% endif %}
                        </span>
                    </label>
                {% endfor %}
            </div>
            {% endblock %}
        {% endembed %}
    </section>

    <section class="design-panel" data-panel="security" role="tabpanel">
        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <div>
                    <h2>{{ 'admin.users.section.security'|trans }}</h2>
                    <p class="muted">{{ 'admin.users.section.security.hint'|trans }}</p>
                </div>
            </header>
            <div class="form-grid">
                {% include 'ui/input.html.twig' with {
                    name: 'password',
                    type: 'password',
                    label: item ? 'admin.users.password_new'|trans : 'common.password'|trans,
                    required: item ? false : true,
                    optional: item ? true : false,
                    form: 'admin.users.save',
                    value: '',
                    autocomplete: 'new-password',
                    extra: 'field--full',
                    attrs: item ? '' : 'minlength="10"'
                } %}
            </div>
            {% endblock %}
        {% endembed %}

        {% if item %}
            {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
                {% block attributes %} class="panel security-card"{% endblock %}
                {% block content %}
                <header class="panel__head">
                    <div>
                        <h2>{{ 'admin.users.mfa.title'|trans }}</h2>
                        <p class="muted">{{ 'admin.users.mfa.hint'|trans }}</p>
                    </div>
                </header>
                <div class="security-status">
                    <div class="security-status__row">
                        <span>{{ 'security.totp.title'|trans }}</span>
                        <span class="badge {{ item.totpEnabled() ? 'badge--ok' : 'badge--muted' }}">
                            {{ item.totpEnabled() ? 'common.enabled'|trans : 'common.disabled'|trans }}
                        </span>
                    </div>
                    <div class="security-status__row">
                        <span>{{ 'security.passkey.title'|trans }}</span>
                        <span class="badge {{ passkeys|default([])|length ? 'badge--ok' : 'badge--muted' }}">
                            {{ passkeys|default([])|length ? passkeys|length : ('common.disabled'|trans) }}
                        </span>
                    </div>
                    {% if passkeys|default([])|length %}
                        <ul class="security-passkeys security-passkeys--static">
                            {% for pk in passkeys %}
                                <li class="security-passkeys__item">
                                    <div>
                                        <strong>{{ pk.name() }}</strong>
                                        <small class="muted">{{ pk.createdAt()|date('d.m.Y H:i') }}</small>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if user.can('users.edit') and (item.totpEnabled() or item.passkeyEnabled() or (passkeys|default([])|length) > 0) %}
                        <div class="form-actions">
                            {% include 'ui/button.html.twig' with {
                                label: 'admin.users.mfa.reset'|trans,
                                type: 'submit',
                                variant: 'danger',
                                attrs: { 'form': 'reset-mfa-' ~ (item.id()) }
                            } only %}
                        </div>
                    {% endif %}
                </div>
                {% endblock %}
            {% endembed %}
        {% endif %}
    </section>
    </form>
{% endblock %}{% endembed %}

{% if item and user.can('users.edit') and (item.totpEnabled() or item.passkeyEnabled() or (passkeys|default([])|length) > 0) %}
    <form
        id="reset-mfa-{{ item.id() }}"
        method="post"
        action="{{ url('admin.users.mfa.reset', {id: item.id()}) }}"
        hidden
        data-confirm="{{ 'admin.users.mfa.reset_confirm'|trans }}"
        data-confirm-title="{{ 'admin.users.mfa.title'|trans }}"
        data-confirm-danger="1"
    >
        {{ csrf_field()|raw }}
    </form>
{% endif %}

{% if item and user.can('users.delete') %}
    <form
        id="delete-user"
        method="post"
        action="{{ url('admin.users.destroy', {id: item.id()}) }}"
        data-confirm="{{ 'admin.users.confirm_delete'|trans }}"
        data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}"
        data-confirm-danger="1"
    >
        {{ csrf_field()|raw }}
    </form>
{% endif %}
{% endblock %}
