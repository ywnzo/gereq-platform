{% extends 'auth/layout.html.twig' %}

{% block content %}
    <div class="setup-wizard">
        <p class="eyebrow">{{ 'setup.eyebrow'|trans }}</p>
        <h1>{{ ('setup.step.' ~ step ~ '.title')|trans }}</h1>
        <p class="muted">{{ ('setup.step.' ~ step ~ '.lead')|trans }}</p>

        <ol class="setup-steps" aria-label="{{ 'setup.progress'|trans }}">
            {% for s in steps %}
                {% if s != 'done' or step == 'done' %}
                    <li class="setup-steps__item{{ step == s ? ' is-current' : '' }}{{ loop.index0 < stepIndex ? ' is-done' : '' }}">
                        <span class="setup-steps__n">{{ loop.index }}</span>
                        <span class="setup-steps__label">{{ ('setup.step.' ~ s ~ '.nav')|trans }}</span>
                    </li>
                {% endif %}
            {% endfor %}
        </ol>

        {% if step == 'welcome' %}
            <form method="post" action="{{ url('admin.setup.welcome') }}" class="stack setup-form">
                {{ csrf_field()|raw }}
                <label class="field">
                    <span>{{ 'setup.field.app_name'|trans }}</span>
                    <input class="input" type="text" name="app_name" value="{{ values.app_name }}" required>
                </label>
                <label class="field">
                    <span>{{ 'setup.field.locale'|trans }}</span>
                    <select class="input" name="locale">
                        {% for code, label in locales %}
                            <option value="{{ code }}" {{ values.locale == code ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="field">
                    <span>{{ 'setup.field.theme'|trans }}</span>
                    <select class="input" name="theme">
                        <option value="system" {{ values.theme == 'system' ? 'selected' : '' }}>{{ 'settings.theme.system'|trans }}</option>
                        <option value="light" {{ values.theme == 'light' ? 'selected' : '' }}>{{ 'settings.theme.light'|trans }}</option>
                        <option value="dark" {{ values.theme == 'dark' ? 'selected' : '' }}>{{ 'settings.theme.dark'|trans }}</option>
                    </select>
                </label>
                <button type="submit" class="btn btn--primary btn--block">{{ 'setup.next'|trans }}</button>
            </form>

        {% elseif step == 'account' %}
            <form method="post" action="{{ url('admin.setup.account') }}" class="stack setup-form" autocomplete="off">
                {{ csrf_field()|raw }}
                <label class="field">
                    <span>{{ 'setup.field.name'|trans }}</span>
                    <input class="input" type="text" name="name" value="{{ values.name }}" required>
                </label>
                <label class="field">
                    <span>{{ 'common.email'|trans }}</span>
                    <input class="input" type="email" name="email" value="{{ values.email }}" required>
                </label>
                <label class="field">
                    <span>{{ 'setup.field.password'|trans }}</span>
                    <input class="input" type="password" name="password" autocomplete="new-password" placeholder="{{ 'setup.field.password_hint'|trans }}">
                </label>
                <label class="field">
                    <span>{{ 'setup.field.password_confirm'|trans }}</span>
                    <input class="input" type="password" name="password_confirmation" autocomplete="new-password">
                </label>
                <div class="setup-nav">
                    <a class="btn btn--ghost" href="{{ url('admin.setup.step', {step: 'welcome'}) }}">{{ 'setup.back'|trans }}</a>
                    <button type="submit" class="btn btn--primary">{{ 'setup.next'|trans }}</button>
                </div>
            </form>

        {% elseif step == 'company' %}
            <form method="post" action="{{ url('admin.setup.company') }}" class="stack setup-form" x-data="gereqAresSubject">
                {{ csrf_field()|raw }}
                <label class="field">
                    <span>{{ 'orders.settings.seller_name'|trans }}</span>
                    <input class="input" type="text" name="seller_name" data-ares-fill="name" value="{{ values.seller_name }}">
                </label>
                <div class="setup-grid">
                    <div class="field ares-field">
                        <span>{{ 'orders.settings.seller_ico'|trans }}</span>
                        <div class="ares-field__row">
                            <input
                                class="input"
                                type="text"
                                name="seller_ico"
                                data-ares-ico
                                data-ares-fill="ico"
                                data-ares-query
                                autocomplete="off"
                                value="{{ values.seller_ico }}"
                                @input="onInput"
                                @keydown="onKeydown"
                                x-ref="query"
                            >
                            <button type="button" class="btn btn--ghost" @click="lookupIco">ARES</button>
                        </div>
                        {% include 'ui/ares_subject_suggest.html.twig' %}
                    </div>
                    <label class="field">
                        <span>{{ 'orders.settings.seller_dic'|trans }}</span>
                        <input class="input" type="text" name="seller_dic" data-ares-fill="dic" value="{{ values.seller_dic }}">
                    </label>
                </div>
                <label class="field">
                    <span>{{ 'orders.settings.seller_address'|trans }}</span>
                    <input class="input" type="text" name="seller_address" data-ares-fill="address" value="{{ values.seller_address }}">
                </label>
                <label class="field">
                    <span>{{ 'orders.settings.seller_email'|trans }}</span>
                    <input class="input" type="email" name="seller_email" value="{{ values.seller_email }}">
                </label>
                <div class="setup-grid">
                    <label class="field">
                        <span>{{ 'orders.settings.number_prefix'|trans }}</span>
                        <input class="input" type="text" name="order_prefix" value="{{ values.order_prefix }}">
                    </label>
                    <label class="field">
                        <span>{{ 'orders.settings.invoice_prefix'|trans }}</span>
                        <input class="input" type="text" name="invoice_prefix" value="{{ values.invoice_prefix }}">
                    </label>
                </div>
                <div class="setup-nav">
                    <a class="btn btn--ghost" href="{{ url('admin.setup.step', {step: 'account'}) }}">{{ 'setup.back'|trans }}</a>
                    <button type="submit" class="btn btn--primary">{{ 'setup.next'|trans }}</button>
                </div>
            </form>

        {% elseif step == 'shop' %}
            <form method="post" action="{{ url('admin.setup.shop') }}" class="stack setup-form">
                {{ csrf_field()|raw }}
                <label class="field">
                    <span>{{ 'shop.settings.store_name'|trans }}</span>
                    <input class="input" type="text" name="store_name" value="{{ values.store_name ?: values.app_name }}">
                </label>
                <label class="field">
                    <span>{{ 'shop.settings.default_currency'|trans }}</span>
                    <input class="input" type="text" name="currency" value="{{ values.currency }}" maxlength="3">
                </label>
                <label class="field">
                    <span>{{ 'shop.settings.checkout_enabled'|trans }}</span>
                    <select class="input" name="checkout_enabled">
                        <option value="1" {{ values.checkout_enabled ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                        <option value="0" {{ not values.checkout_enabled ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
                    </select>
                </label>
                <div class="setup-nav">
                    <a class="btn btn--ghost" href="{{ url('admin.setup.step', {step: 'company'}) }}">{{ 'setup.back'|trans }}</a>
                    <button type="submit" class="btn btn--primary">{{ 'setup.next'|trans }}</button>
                </div>
            </form>

        {% elseif step == 'done' %}
            <div class="setup-done stack">
                <p>{{ 'setup.step.done.body'|trans }}</p>
                <ul class="setup-checklist muted">
                    <li>{{ 'setup.step.done.check_app'|trans({'%name%': values.app_name}) }}</li>
                    <li>{{ 'setup.step.done.check_account'|trans({'%email%': values.email}) }}</li>
                    <li>{{ 'setup.step.done.check_shop'|trans({'%store%': values.store_name ?: values.app_name}) }}</li>
                </ul>
                <form method="post" action="{{ url('admin.setup.finish') }}">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn--primary btn--block">{{ 'setup.finish'|trans }}</button>
                </form>
                <a class="text-link" href="{{ url('admin.setup.step', {step: 'shop'}) }}">{{ 'setup.back'|trans }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
