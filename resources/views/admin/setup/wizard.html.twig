{% extends 'auth/layout.html.twig' %}

{% block content %}
    <div class="setup-wizard{% if step == 'modules' %} setup-wizard--modules{% endif %}{% if step in ['modules', 'dashboard'] %} setup-wizard--wide{% endif %}">
        <p class="eyebrow">{{ 'setup.eyebrow'|trans }}</p>
        <h1>{{ (hostedPackage and step == 'company' ? 'setup.hosted.company.title' : ('setup.step.' ~ step ~ '.title'))|trans }}</h1>
        <p class="muted">{{ (hostedPackage and step == 'company' ? 'setup.hosted.company.lead' : ('setup.step.' ~ step ~ '.lead'))|trans }}</p>

        <ol class="setup-steps" aria-label="{{ 'setup.progress'|trans }}">
            {% for s in steps %}
                {% if s != 'done' or step == 'done' %}
                    <li class="setup-steps__item{{ step == s ? ' is-current' : '' }}{{ loop.index0 < stepIndex ? ' is-done' : '' }}">
                        <span class="setup-steps__n">{{ loop.index }}</span>
                        <span class="setup-steps__label">{{ (hostedPackage and s == 'company' ? 'setup.hosted.company.title' : ('setup.step.' ~ s ~ '.nav'))|trans }}</span>
                    </li>
                {% endif %}
            {% endfor %}
        </ol>

        {% if step == 'welcome' %}
            <form method="post" action="{{ url('admin.setup.welcome') }}" class="stack setup-form">
                {{ csrf_field()|raw }}
                <label class="field">
                    <span>{{ 'setup.field.app_name'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="app_name" value="{{ values.app_name }}" required{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'setup.field.locale'|trans }}</span>
                    {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} class="input" name="locale"{% endblock %}{% block native_options %}
                        {% for code, label in locales %}
                            {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="{{ code }}" {{ values.locale == code ? 'selected' : '' }}{% endblock %}{% block content %}{{ label }}{% endblock %}{% endembed %}
                        {% endfor %}
                    {% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'setup.field.theme'|trans }}</span>
                    {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} class="input" name="theme"{% endblock %}{% block native_options %}
                        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="system" {{ values.theme == 'system' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'settings.theme.system'|trans }}{% endblock %}{% endembed %}
                        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="light" {{ values.theme == 'light' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'settings.theme.light'|trans }}{% endblock %}{% endembed %}
                        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="dark" {{ values.theme == 'dark' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'settings.theme.dark'|trans }}{% endblock %}{% endembed %}
                    {% endblock %}{% endembed %}
                </label>
                {% include 'ui/button.html.twig' with {
                    label: 'setup.next'|trans,
                    type: 'submit',
                    variant: 'primary',
                    block: true
                } only %}
            </form>

        {% elseif step == 'account' %}
            <form method="post" action="{{ url('admin.setup.account') }}" class="stack setup-form" autocomplete="off">
                {{ csrf_field()|raw }}
                <label class="field">
                    <span>{{ 'setup.field.name'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="name" value="{{ values.name }}" required{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'common.email'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="email" name="email" value="{{ values.email }}" required{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'setup.field.password'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="password" name="password" autocomplete="new-password" placeholder="{{ 'setup.field.password_hint'|trans }}"{% endblock %}{% endembed %}
                </label>
                <label class="field">
                    <span>{{ 'setup.field.password_confirm'|trans }}</span>
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="password" name="password_confirmation" autocomplete="new-password"{% endblock %}{% endembed %}
                </label>
                <div class="setup-nav">
                    {% include 'ui/button.html.twig' with {
                        label: 'setup.back'|trans,
                        href: (url('admin.setup.step', {step: 'welcome'})),
                        button_options: { tag: 'a' },
                        variant: 'ghost'
                    } only %}
                    {% include 'ui/button.html.twig' with { label: 'setup.next'|trans, type: 'submit', variant: 'primary' } only %}
                </div>
            </form>

        {% elseif step == 'company' %}
            {% if hostedPackage %}
            <form method="post" action="{{ url('admin.setup.company') }}" class="stack setup-form" x-data="gereqSetupCompany" @change="syncCompany">
                {{ csrf_field()|raw }}
                {% include 'ui/switch.html.twig' with {name: 'is_company', label: 'setup.field.is_company'|trans, on: values.is_company} only %}
                <div data-company-fields {% if not values.is_company %}hidden{% endif %}>
                    <div class="stack" x-data="gereqAresSubject">
                <label class="field">
                    <span>{{ 'setup.field.seller_name'|trans }}</span>
                    <input class="input" type="text" name="seller_name" data-ares-fill="name" value="{{ values.seller_name }}">
                </label>
                <div class="setup-grid">
                    <div class="field ares-field">
                        <span>{{ 'setup.field.seller_ico'|trans }}</span>
                        <div class="ares-field__row">
                            <input
                                class="input"
                                type="text"
                                name="seller_ico"
                                data-ares-ico
                                data-ares-fill="ico"
                                data-ares-query
                                autocomplete="off"
                                value="{{ values.seller_ico }}"
                                @input="onInput"
                                @keydown="onKeydown"
                                x-ref="query"
                            >
                            <button type="button" class="btn btn--ghost" @click="lookupIco">ARES</button>
                        </div>
                        {% include 'ui/ares_subject_suggest.html.twig' %}
                    </div>
                    <label class="field">
                        <span>{{ 'setup.field.seller_dic'|trans }}</span>
                        <input class="input" type="text" name="seller_dic" data-ares-fill="dic" value="{{ values.seller_dic }}">
                    </label>
                </div>
                <label class="field">
                    <span>{{ 'setup.field.seller_address'|trans }}</span>
                    <input class="input" type="text" name="seller_address" data-ares-fill="address" value="{{ values.seller_address }}">
                </label>
                <label class="field">
                    <span>{{ 'setup.field.seller_email'|trans }}</span>
                    <input class="input" type="email" name="seller_email" value="{{ values.seller_email }}">
                </label>
                {% if hasShop %}
                <div class="setup-grid">
                    <label class="field">
                        <span>{{ 'setup.field.order_prefix'|trans }}</span>
                        <input class="input" type="text" name="order_prefix" value="{{ values.order_prefix }}">
                    </label>
                    <label class="field">
                        <span>{{ 'setup.field.invoice_prefix'|trans }}</span>
                        <input class="input" type="text" name="invoice_prefix" value="{{ values.invoice_prefix }}">
                    </label>
                </div>
                {% endif %}
                    </div>
                </div>
                <div class="setup-nav">
                    <a class="btn btn--ghost" href="{{ url('admin.setup.step', {step: 'account'}) }}">{{ 'setup.back'|trans }}</a>
                    <button type="submit" class="btn btn--primary">{{ 'setup.next'|trans }}</button>
                </div>
            </form>

            {% else %}
            <form method="post" action="{{ url('admin.setup.company') }}" class="stack setup-form" x-data="setupOperator" data-type="{{ values.operator.type }}">
                {{ csrf_field()|raw }}
                <label class="field">
                    <span>{{ 'setup.operator.type'|trans }}</span>
                    {% embed 'ui/select.html.twig' with { native: true } %}{% block root_attributes %}:data-native-value="type" {% endblock %}{% block native_attributes %} class="input" name="operator_type" x-model="type"{% endblock %}{% block native_options %}
                        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="business" {{ values.operator.type == 'business' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'setup.operator.business'|trans }}{% endblock %}{% endembed %}
                        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="person" {{ values.operator.type == 'person' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'setup.operator.person'|trans }}{% endblock %}{% endembed %}
                    {% endblock %}{% endembed %}
                </label>
                <fieldset class="setup-fieldset stack" x-show="business" :disabled="!business" {{ values.operator.type != 'business' ? 'disabled' : '' }} x-data="gereqAresSubject">
                    <legend class="sr-only">{{ 'setup.operator.business'|trans }}</legend>
                    <label class="field">
                        <span>{{ 'setup.operator.company_name'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" name="company_name" data-ares-fill="name" value="{{ values.operator.company_name }}" maxlength="180" required{% endblock %}{% endembed %}
                    </label>
                    <div class="setup-grid">
                        <div class="field ares-field">
                            <label for="setup-ico">{{ 'setup.operator.ico'|trans }}</label>
                            <div class="ares-field__row">
                                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} id="setup-ico" class="input" name="ico" data-ares-ico data-ares-fill="ico" data-ares-query autocomplete="off" value="{{ values.operator.ico }}" @input="onInput" @keydown="onKeydown" x-ref="query" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" required{% endblock %}{% endembed %}
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" @click="lookupIco"{% endblock %}{% block content %}ARES{% endblock %}{% endembed %}
                            </div>
                            {% include 'ui/ares_subject_suggest.html.twig' %}
                        </div>
                        <label class="field">
                            <span>{{ 'setup.operator.dic'|trans }}</span>
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" name="dic" data-ares-fill="dic" value="{{ values.operator.dic }}" maxlength="32"{% endblock %}{% endembed %}
                        </label>
                    </div>
                    <label class="field">
                        <span>{{ 'setup.operator.address'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" name="address" data-ares-fill="address" value="{{ values.operator.address }}" maxlength="500" required{% endblock %}{% endembed %}
                    </label>
                    <label class="field">
                        <span>{{ 'common.email'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="email" name="email" value="{{ values.operator.email }}" maxlength="180" required{% endblock %}{% endembed %}
                    </label>
                </fieldset>
                <fieldset class="setup-fieldset stack" x-show="person" :disabled="!person" {{ values.operator.type != 'person' ? 'disabled' : '' }} x-cloak>
                    <legend class="sr-only">{{ 'setup.operator.person'|trans }}</legend>
                    <div class="setup-grid">
                        <label class="field">
                            <span>{{ 'setup.operator.first_name'|trans }}</span>
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" name="first_name" value="{{ values.operator.first_name }}" maxlength="100" required{% endblock %}{% endembed %}
                        </label>
                        <label class="field">
                            <span>{{ 'setup.operator.last_name'|trans }}</span>
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" name="last_name" value="{{ values.operator.last_name }}" maxlength="100" required{% endblock %}{% endembed %}
                        </label>
                    </div>
                    <label class="field">
                        <span>{{ 'setup.operator.address'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" name="address" value="{{ values.operator.address }}" maxlength="500" required{% endblock %}{% endembed %}
                    </label>
                    <label class="field">
                        <span>{{ 'setup.operator.birth_date'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="date" name="birth_date" value="{{ values.operator.birth_date }}" max="{{ 'now'|date('Y-m-d') }}" required{% endblock %}{% endembed %}
                    </label>
                </fieldset>
                <div class="setup-nav">
                    {% include 'ui/button.html.twig' with {
                        label: 'setup.back'|trans,
                        href: (url('admin.setup.step', {step: 'account'})),
                        button_options: { tag: 'a' },
                        variant: 'ghost'
                    } only %}
                    {% include 'ui/button.html.twig' with { label: 'setup.next'|trans, type: 'submit', variant: 'primary' } only %}
                </div>
            </form>

            {% endif %}
        {% elseif step == 'modules' %}
            <form method="post" action="{{ url('admin.setup.modules') }}" class="stack setup-form" x-data="setupModulePicker">
                {{ csrf_field()|raw }}
                <p class="muted">{{ 'setup.modules.hint'|trans }}</p>
                <div class="grq-setup-module-filters">
                    <label class="field">
                        <span>{{ 'setup.modules.search'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="search" x-model="query" placeholder="{{ 'setup.modules.search_hint'|trans }}" autocomplete="off"{% endblock %}{% endembed %}
                    </label>
                    <label class="field">
                        <span>{{ 'setup.modules.category'|trans }}</span>
                        {% embed 'ui/select.html.twig' with { native: true } %}{% block root_attributes %}:data-native-value="category" {% endblock %}{% block native_attributes %} class="input" x-model="category"{% endblock %}{% block native_options %}
                            {% include 'ui/option.html.twig' with { value: '', label: 'setup.modules.all_categories'|trans } only %}
                            {% for id, label in moduleCategories %}
                                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="{{ id }}"{% endblock %}{% block content %}{{ label|trans }}{% endblock %}{% endembed %}
                            {% endfor %}
                        {% endblock %}{% endembed %}
                    </label>
                </div>
                <p class="muted" role="status" aria-live="polite">{{ 'setup.modules.showing'|trans }} <strong x-text="visibleCount">{{ moduleChoices|length }}</strong> / {{ moduleChoices|length }}</p>
                <div class="grq-setup-module-scroll" tabindex="0" role="region" aria-label="{{ 'setup.step.modules.title'|trans }}">
                <div class="grq-setup-modules">
                    {% for choice in moduleChoices %}
                        {% set module = choice.manifest %}
                        <label class="grq-setup-module{% if module.parentId %} grq-setup-module--child{% endif %}"
                            data-module-choice
                            data-search="{{ (module.name ~ ' ' ~ module.id ~ ' ' ~ (module.description|trans))|e('html_attr') }}"
                            data-categories="{{ choice.categories|json_encode|e('html_attr') }}"
                            x-show="matches($el.dataset.search, $el.dataset.categories)"
                        >
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="modules[]" value="{{ module.id }}" {{ module.id in selectedModules ? 'checked' : '' }}{% endblock %}{% endembed %}
                            <span class="grq-setup-module__icon" aria-hidden="true">{{ icon(module.icon) }}</span>
                            <span class="grq-setup-module__body">
                                <strong>{{ module.name }}</strong>
                                <small class="muted grq-setup-module__categories" title="{% for category in choice.categories %}{{ moduleCategories[category]|trans }}{{ not loop.last ? ' · ' : '' }}{% endfor %}">{% for category in choice.categories %}{{ moduleCategories[category]|trans }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</small>
                                <span class="muted grq-setup-module__description" title="{{ module.description ? module.description|trans : module.id }}">{{ module.description ? module.description|trans : module.id }}</span>
                                {% if module.parentId %}<small>{{ 'setup.modules.parent'|trans({'%parent%': module.parentId}) }}</small>{% endif %}
                            </span>
                        </label>
                    {% else %}
                        <p class="muted">{{ 'setup.modules.empty'|trans }}</p>
                    {% endfor %}
                </div>
                <p class="muted" x-show="visibleCount === 0" x-cloak>{{ 'setup.modules.no_results'|trans }}</p>
                </div>
                <div class="setup-nav">
                    {% include 'ui/button.html.twig' with {
                        label: 'setup.back'|trans,
                        href: (url('admin.setup.step', {step: 'company'})),
                        button_options: { tag: 'a' },
                        variant: 'ghost'
                    } only %}
                    {% include 'ui/button.html.twig' with {
                        label: 'setup.modules.continue'|trans,
                        type: 'submit',
                        variant: 'primary'
                    } only %}
                </div>
            </form>

        {% elseif step == 'dashboard' %}
            <form method="post" action="{{ url('admin.setup.dashboard') }}" class="stack setup-form">
                {{ csrf_field()|raw }}
                {% include 'admin/settings/_dashboard_widgets.html.twig' with { field: 'dashboard_layout', dashboardCatalog: widgets } %}
                <div class="setup-nav">
                    {% include 'ui/button.html.twig' with {
                        label: 'setup.back'|trans,
                        href: (url('admin.setup.step', {step: 'modules'})),
                        button_options: { tag: 'a' },
                        variant: 'ghost'
                    } only %}
                    {% include 'ui/button.html.twig' with { label: 'setup.finish'|trans, type: 'submit', variant: 'primary' } only %}
                </div>
            </form>
        {% elseif step == 'shop' %}
            <form method="post" action="{{ url('admin.setup.shop') }}" class="stack setup-form">
                {{ csrf_field()|raw }}
                <label class="field">
                    <span>{{ 'setup.field.store_name'|trans }}</span>
                    <input class="input" type="text" name="store_name" value="{{ values.store_name ?: values.app_name }}">
                </label>
                <label class="field">
                    <span>{{ 'setup.field.currency'|trans }}</span>
                    <input class="input" type="text" name="currency" value="{{ values.currency }}" maxlength="3">
                </label>
                <label class="field">
                    <span>{{ 'setup.field.checkout_enabled'|trans }}</span>
                    <select class="input" name="checkout_enabled">
                        <option value="1" {{ values.checkout_enabled ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                        <option value="0" {{ not values.checkout_enabled ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
                    </select>
                </label>
                <div class="setup-nav">
                    <a class="btn btn--ghost" href="{{ url('admin.setup.step', {step: 'company'}) }}">{{ 'setup.back'|trans }}</a>
                    <button type="submit" class="btn btn--primary">{{ 'setup.next'|trans }}</button>
                </div>
            </form>

        {% elseif step == 'done' %}
            <div class="setup-done stack">
                <p>{{ 'setup.step.done.body'|trans }}</p>
                <ul class="setup-checklist muted">
                    <li>{{ 'setup.step.done.check_app'|trans({'%name%': values.app_name}) }}</li>
                    <li>{{ 'setup.step.done.check_account'|trans({'%email%': values.email}) }}</li>
                    {% if hasShop %}<li>{{ 'setup.step.done.check_shop'|trans({'%store%': values.store_name ?: values.app_name}) }}</li>{% endif %}
                </ul>
                <form method="post" action="{{ url('admin.setup.finish') }}">
                    {{ csrf_field()|raw }}
                    <button type="submit" class="btn btn--primary btn--block">{{ 'setup.finish'|trans }}</button>
                </form>
                <a class="text-link" href="{{ url('admin.setup.step', {step: hasShop ? 'shop' : 'company'}) }}">{{ 'setup.back'|trans }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
