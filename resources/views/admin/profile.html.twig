{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'profile.title'|trans }}</h1>
    </header>
    <form method="post" action="{{ url('admin.profile.update') }}" class="form-grid">
        {{ csrf_field()|raw }}
        <label class="field">
            <span>{{ 'profile.name'|trans }}</span>
            <input type="text" name="name" value="{{ user.name() }}" required>
        </label>
        <label class="field">
            <span>{{ 'profile.email'|trans }}</span>
            <input type="email" value="{{ user.email() }}" disabled>
        </label>
        <label class="field">
            <span>{{ 'profile.locale'|trans }}</span>
            <select name="locale">
                <option value="_default" {{ user.locale() is null ? 'selected' : '' }}>{{ 'profile.locale.default'|trans }}</option>
                {% for code, label in locales %}
                    <option value="{{ code }}" {{ user.locale() == code ? 'selected' : '' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="field field--full">
            <span>{{ 'profile.password.current'|trans }}</span>
            <input type="password" name="current_password" autocomplete="current-password" placeholder="{{ 'profile.password.current.hint'|trans }}">
        </label>
        <label class="field field--full">
            <span>{{ 'profile.password'|trans }}</span>
            <input type="password" name="password" minlength="10" autocomplete="new-password" placeholder="{{ 'profile.password.hint'|trans }}">
        </label>
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'profile.save'|trans }}</button>
        </div>
    </form>
{% endblock %}
