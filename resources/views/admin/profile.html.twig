{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <div>
            <h1>{{ 'profile.title'|trans }}</h1>
            <p class="muted">{{ 'profile.subtitle'|trans }}</p>
        </div>
    </header>

    {% embed 'ui/tabs.html.twig' with { tabs_options: { tag: 'div' } } %}{% block component_attributes %} class="profile-hub detail-hub" x-data="gereqTabs" data-initial="account"{% endblock %}{% block content %}
        {% embed 'ui/tabs.html.twig' with { tabs_options: { tag: 'nav' } } %}{% block component_attributes %} class="design-tabs" role="tablist"{% endblock %}{% block content %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab is-active" role="tab" data-tab="account" aria-selected="true"{% endblock %}{% block content %}{{ 'profile.tab.account'|trans }}{% endblock %}{% endembed %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab" role="tab" data-tab="security" aria-selected="false"{% endblock %}{% block content %}{{ 'profile.tab.security'|trans }}{% endblock %}{% endembed %}
        {% endblock %}{% endembed %}

        <section class="design-panel is-active" data-panel="account" role="tabpanel">
            {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'form' } } %}{% block attributes %} method="post" action="{{ url('admin.profile.update') }}" class="panel"{% endblock %}{% block content %}
                {{ csrf_field()|raw }}
                <header class="panel__head">
                    <div>
                        <h2>{{ 'profile.tab.account'|trans }}</h2>
                        <p class="muted">{{ 'profile.account.hint'|trans }}</p>
                    </div>
                </header>
                <div class="form-grid">
                    <label class="field">
                        <span>{{ 'profile.name'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" name="name" value="{{ user.name() }}" required{% endblock %}{% endembed %}
                    </label>
                    <label class="field">
                        <span>{{ 'profile.email'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="email" value="{{ user.email() }}" disabled{% endblock %}{% endembed %}
                    </label>
                    <label class="field">
                        <span>{{ 'profile.locale'|trans }}</span>
                        {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} class="input" name="locale"{% endblock %}{% block native_options %}
                            {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="_default" {{ user.locale() is null ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'profile.locale.default'|trans }}{% endblock %}{% endembed %}
                            {% for code, label in locales %}
                                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="{{ code }}" {{ user.locale() == code ? 'selected' : '' }}{% endblock %}{% block content %}{{ label }}{% endblock %}{% endembed %}
                            {% endfor %}
                        {% endblock %}{% endembed %}
                    </label>
                    {{ apply_filters('admin.profile.form_fields', '')|raw }}
                    <label class="field field--full">
                        <span>{{ 'profile.password.current'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="password" name="current_password" autocomplete="current-password" placeholder="{{ 'profile.password.current.hint'|trans }}"{% endblock %}{% endembed %}
                    </label>
                    <label class="field field--full">
                        <span>{{ 'profile.password'|trans }}</span>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="password" name="password" minlength="10" autocomplete="new-password" placeholder="{{ 'profile.password.hint'|trans }}"{% endblock %}{% endembed %}
                    </label>
                </div>
                <div class="form-actions">
                    {% include 'ui/button.html.twig' with {
                        label: 'profile.save'|trans,
                        variant: 'primary',
                        type: 'submit'
                    } only %}
                </div>
            {% endblock %}{% endembed %}
        </section>

        <section class="design-panel" data-panel="security" role="tabpanel">
            <div
                class="security-grid"
                x-data="gereqSecurityPanel"
                data-label-enabled="{{ 'common.enabled'|trans|e('html_attr') }}"
                data-label-disabled="{{ 'common.disabled'|trans|e('html_attr') }}"
                data-config="{{ {
                    totpEnabled: user.totpEnabled(),
                    passkeyEnabled: user.passkeyEnabled(),
                    passkeys: passkeys,
                    urls: securityUrls,
                    labels: {
                        waiting: 'auth.passkey.waiting'|trans,
                        addPasskey: 'security.passkey.add'|trans,
                        confirmDisable: 'security.totp.confirm_disable'|trans,
                        passwordPrompt: 'security.password_prompt'|trans,
                        codePrompt: 'security.code_prompt'|trans,
                        passkeyName: 'security.passkey.name_prompt'|trans,
                        copyOk: 'security.recovery.copied'|trans,
                        continueLabel: 'common.continue'|trans
                    }
                }|json_encode|e('html_attr') }}"
            >
                {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
                    {% block attributes %} class="panel security-card"{% endblock %}
                    {% block content %}
                    <header class="panel__head">
                        <div>
                            <h2>{{ 'security.totp.title'|trans }}</h2>
                            <p class="muted">{{ 'security.totp.hint'|trans }}</p>
                        </div>
                        <span :class="totpBadgeClass()" x-text="totpBadgeLabel()"></span>
                    </header>

                    <div x-show="showEnableTotp()" class="security-card__body">
                        {% include 'ui/button.html.twig' with {
                            label: 'security.totp.enable'|trans,
                            type: 'button',
                            variant: 'primary',
                            attrs: { '@click': 'startTotp()', ':disabled': 'busy' }
                        } only %}
                    </div>

                    <div x-show="setupOpen" x-cloak class="security-card__body stack">
                        <p class="muted">{{ 'security.totp.scan'|trans }}</p>
                        <img class="security-qr" :src="qr" alt="TOTP QR" width="200" height="200">
                        <code class="security-secret" x-text="secret"></code>
                        <label class="field">
                            <span>{{ 'auth.mfa.code'|trans }}</span>
                            {% embed 'ui/pin.html.twig' with { pin_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" x-model="setupCode" inputmode="numeric" autocomplete="one-time-code" placeholder="000000"{% endblock %}{% endembed %}
                        </label>
                        <div class="form-actions">
                            {% include 'ui/button.html.twig' with {
                                label: 'security.totp.confirm'|trans,
                                type: 'button',
                                variant: 'primary',
                                attrs: { '@click': 'confirmTotp()', ':disabled': 'busy' }
                            } only %}
                            {% include 'ui/button.html.twig' with {
                                label: 'common.cancel'|trans,
                                type: 'button',
                                variant: 'ghost',
                                attrs: { '@click': 'cancelSetup()', ':disabled': 'busy' }
                            } only %}
                        </div>
                    </div>

                    <div x-show="showManageTotp()" x-cloak class="security-card__body stack">
                        <div class="form-actions">
                            {% include 'ui/button.html.twig' with {
                                label: 'security.recovery.regenerate'|trans,
                                type: 'button',
                                variant: 'ghost',
                                attrs: { '@click': 'regenerateRecovery()', ':disabled': 'busy' }
                            } only %}
                            {% include 'ui/button.html.twig' with {
                                label: 'security.totp.disable'|trans,
                                type: 'button',
                                variant: 'danger',
                                attrs: { '@click': 'disableTotp()', ':disabled': 'busy' }
                            } only %}
                        </div>
                    </div>

                    <div x-show="hasRecovery()" x-cloak class="security-recovery">
                        <h3>{{ 'security.recovery.title'|trans }}</h3>
                        <p class="muted">{{ 'security.recovery.hint'|trans }}</p>
                        <ul class="security-recovery__list">
                            <template x-for="code in recoveryCodes" :key="code">
                                <li><code x-text="code"></code></li>
                            </template>
                        </ul>
                        {% include 'ui/button.html.twig' with {
                            label: 'security.recovery.copy'|trans,
                            type: 'button',
                            variant: 'ghost',
                            attrs: { '@click': 'copyRecovery()' }
                        } only %}
                    </div>
                    {% endblock %}
                {% endembed %}

                {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
                    {% block attributes %} class="panel security-card"{% endblock %}
                    {% block content %}
                    <header class="panel__head">
                        <div>
                            <h2>{{ 'security.passkey.title'|trans }}</h2>
                            <p class="muted">{{ 'security.passkey.hint'|trans }}</p>
                        </div>
                        <span :class="passkeyBadgeClass()" x-text="passkeyBadgeLabel()"></span>
                    </header>
                    <div class="security-card__body stack">
                        <ul class="security-passkeys" x-show="hasPasskeys()">
                            <template x-for="item in passkeys" :key="item.id">
                                <li class="security-passkeys__item">
                                    <div>
                                        <strong x-text="item.name"></strong>
                                        <small class="muted" x-text="item.created_at"></small>
                                    </div>
                                    {% include 'ui/button.html.twig' with {
                                        label: 'common.delete'|trans,
                                        type: 'button',
                                        variant: 'ghost',
                                        attrs: { '@click': 'removePasskey(item.id)', ':disabled': 'busy' }
                                    } only %}
                                </li>
                            </template>
                        </ul>
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--primary" @click="addPasskey()" :disabled="busy"{% endblock %}{% block content %}
                            <span class="material-symbols-outlined" aria-hidden="true">fingerprint</span>
                            <span x-text="passkeyAddLabel()"></span>
                        {% endblock %}{% endembed %}
                    </div>
                    {% endblock %}
                {% endembed %}

                <p class="muted security-grid__error" x-show="error" x-text="error" x-cloak></p>
            </div>
        </section>
    {% endblock %}{% endembed %}
{% endblock %}
