{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'admin.modules.title'|trans, url: url('admin.modules.index') },
        { label: manifest.name|trans },
    ] } %}
{% endblock %}

{% block content %}
{% set canBump = changeSet is defined and changeSet and changeSet.canBump %}
{% set hasFiles = changeSet is defined and changeSet and changeSet.hasFiles %}
{% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
    {% block attributes %} class="panel stack module-gate" style="max-width:40rem;margin:2rem auto;padding:1.5rem"{% endblock %}
    {% block content %}
    <header>
        <p class="eyebrow">{{ 'admin.modules.update_available'|trans }}</p>
        <h1>{{ 'admin.modules.gate.title'|trans }}</h1>
        <p class="muted">{{ 'admin.modules.gate.body'|trans({
            '%module%': manifest.name|trans,
            '%current%': manifest.version,
            '%installed%': installedVersion|default('—')
        }) }}</p>
    </header>
    <p>{{ 'admin.modules.update_hint'|trans({
        '%current%': manifest.version,
        '%installed%': installedVersion|default('—'),
        '%pending%': '—'
    }) }}</p>

    {% if hasFiles %}
        <div class="module-gate__changes">
            <div class="module-gate__summary">
                <span class="module-gate__stat module-gate__stat--add">+{{ changeSet.additions }}</span>
                <span class="module-gate__stat module-gate__stat--del">−{{ changeSet.deletions }}</span>
                <span class="muted">{{ 'admin.modules.gate.files_changed'|trans({'%count%': changeSet.files|length}) }}</span>
            </div>
            <ul class="module-gate__files">
                {% for file in changeSet.files %}
                    <li class="module-gate__file module-gate__file--{{ file.status }}">
                        <span class="module-gate__path" title="{{ file.path }}">{{ file.path }}</span>
                        <span class="module-gate__diff">
                            {% if file.additions > 0 %}<span class="module-gate__stat--add">+{{ file.additions }}</span>{% endif %}
                            {% if file.deletions > 0 %}<span class="module-gate__stat--del">−{{ file.deletions }}</span>{% endif %}
                            {% if file.additions == 0 and file.deletions == 0 %}<span class="muted">·</span>{% endif %}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% elseif canBump %}
        <p class="muted">{{ 'admin.modules.gate.drift_no_files'|trans }}</p>
    {% endif %}

    <div class="form-actions" style="display:flex;gap:0.5rem;flex-wrap:wrap">
        {% if user and user.can('modules.manage') %}
            {% if canBump %}
                <form method="post" action="{{ url('admin.modules.update', {id: manifest.id}) }}">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="bump" value="1">
                    {% if returnUrl|default('') %}
                        <input type="hidden" name="return" value="{{ returnUrl }}">
                    {% endif %}
                    {% include 'ui/button.html.twig' with {
                        label: 'admin.modules.gate.update_bump'|trans,
                        type: 'submit',
                        variant: 'primary'
                    } only %}
                </form>
            {% endif %}
            <form method="post" action="{{ url('admin.modules.update', {id: manifest.id}) }}">
                {{ csrf_field()|raw }}
                {% if returnUrl|default('') %}
                    <input type="hidden" name="return" value="{{ returnUrl }}">
                {% endif %}
                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} class="btn {{ canBump ? 'btn--ghost' : 'btn--primary' }}" type="submit"{% endblock %}{% block content %}{{ 'admin.modules.update'|trans }}{% endblock %}{% endembed %}
            </form>
        {% endif %}
        {% include 'ui/button.html.twig' with {
            label: 'admin.modules.gate.detail'|trans,
            href: (url('admin.modules.show', {id: manifest.id})),
            button_options: { tag: 'a' },
            variant: 'ghost'
        } only %}
        {% include 'ui/button.html.twig' with {
            label: 'common.back'|trans,
            href: (url('admin.dashboard')),
            button_options: { tag: 'a' },
            variant: 'ghost'
        } only %}
    </div>
    {% endblock %}
{% endembed %}
{% endblock %}
