{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'admin.modules.title'|trans },
    ] } %}
{% endblock %}

{% block content %}
{% set pageIds = items|map(r => r.manifest.id) %}
{% set updateIds = items|filter(r => r.update_available)|map(r => r.manifest.id) %}
<div class="list-shell list-shell--tabs" x-data="gereqTabs" data-initial="modules">
    <header class="page-header">
        <div>
            <h1>{{ 'admin.modules.title'|trans }}</h1>
            <p class="muted">{{ 'admin.modules.subtitle'|trans }}</p>
        </div>
    </header>

    <div class="module-stats">
        <div class="module-stat">
            <span class="module-stat__value">{{ stats.total }}</span>
            <span class="module-stat__label">{{ 'common.total'|trans }}</span>
        </div>
        <div class="module-stat">
            <span class="module-stat__value">{{ stats.enabled }}</span>
            <span class="module-stat__label">{{ 'common.active'|trans }}</span>
        </div>
        <div class="module-stat{% if stats.updates %} module-stat--warn{% endif %}">
            <span class="module-stat__value">{{ stats.updates }}</span>
            <span class="module-stat__label">{{ 'admin.modules.stat.updates'|trans }}</span>
        </div>
        <div class="module-stat{% if stats.issues %} module-stat--warn{% endif %}">
            <span class="module-stat__value">{{ stats.issues }}</span>
            <span class="module-stat__label">{{ 'common.warnings'|trans }}</span>
        </div>
    </div>

    <div class="design-tabs detail-tabs" role="tablist" aria-label="{{ 'admin.modules.title'|trans }}">
        <button type="button" class="design-tab" role="tab" data-tab="modules">{{ 'admin.modules.tab.modules'|trans }}</button>
        {% if groups is defined and groups is not empty %}
            <button type="button" class="design-tab" role="tab" data-tab="packages">
                {{ 'admin.modules.tab.packages'|trans }}
                <span class="module-tab-count">{{ groups|length }}</span>
            </button>
        {% endif %}
        <button type="button" class="design-tab" role="tab" data-tab="plugins">
            {{ 'admin.modules.tab.plugins'|trans }}
            {% if pluginStats.total is defined and pluginStats.total %}
                <span class="module-tab-count">{{ pluginStats.enabled }}/{{ pluginStats.total }}</span>
            {% elseif pluginGroups is defined and pluginGroups is not empty %}
                <span class="module-tab-count">{{ pluginGroups|length }}</span>
            {% endif %}
        </button>
    </div>

    <section class="design-panel" data-panel="modules" role="tabpanel">
        <div
            class="list-shell__panel"
            x-data="moduleTable"
            data-table-id="admin-modules"
            data-actions-default="1"
            data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
            data-update-ids="{{ updateIds|json_encode|e('html_attr') }}"
            data-confirm-disable="{{ 'admin.modules.bulk.confirm_disable'|trans|e('html_attr') }}"
            data-confirm-disable-title="{{ 'admin.modules.bulk.action.disable'|trans|e('html_attr') }}"
            data-confirm-disable-label="{{ 'admin.modules.uninstall'|trans|e('html_attr') }}"
            data-confirm-disable-media="{{ 'admin.modules.bulk.confirm_disable_media'|trans|e('html_attr') }}"
            data-confirm-disable-media-title="{{ 'admin.modules.confirm.disable_media_title'|trans|e('html_attr') }}"
            data-confirm-disable-media-label="{{ 'admin.modules.confirm.disable_media_yes'|trans|e('html_attr') }}"
            data-label-enabled="{{ 'common.enabled'|trans|e('html_attr') }}"
            data-label-disabled="{{ 'common.disabled'|trans|e('html_attr') }}"
            data-label-update="{{ 'admin.modules.update_available'|trans|e('html_attr') }}"
            data-toast-error="{{ 'admin.modules.action_failed'|trans|e('html_attr') }}"
        >
            <div class="toolbar--table">
                <div class="toolbar">
                    <input
                        class="input"
                        type="search"
                        name="q"
                        x-model="query"
                        placeholder="{{ 'admin.modules.search'|trans }}"
                        autocomplete="off"
                    >
                    <select class="input" x-model="status">
                        <option value="">{{ 'admin.modules.filter.all'|trans }}</option>
                        <option value="on">{{ 'common.enabled'|trans }}</option>
                        <option value="off">{{ 'common.disabled'|trans }}</option>
                        <option value="update">{{ 'admin.modules.update_available'|trans }}</option>
                        <option value="warn">{{ 'common.warnings'|trans }}</option>
                    </select>
                    {% if stats.updates > 0 %}
                        <form
                            method="post"
                            action="{{ url('admin.modules.bulk') }}"
                            title="{{ 'admin.modules.update_all'|trans }}"
                            data-confirm="{{ 'admin.modules.bulk.confirm_update_all'|trans({'%count%': stats.updates})|e('html_attr') }}"
                            data-confirm-title="{{ 'admin.modules.update_all'|trans|e('html_attr') }}"
                            data-confirm-label="{{ 'admin.modules.bulk.action.update'|trans|e('html_attr') }}"
                            data-confirm-danger="0"
                        >
                            {{ csrf_field()|raw }}
                            <input type="hidden" name="action" value="update_outdated">
                            <button
                                type="submit"
                                class="icon-btn"
                                :class="refreshBtnClass"
                                :aria-busy="busyAttr"
                                :disabled="busy"
                                aria-label="{{ 'admin.modules.update_all'|trans }}"
                            >{{ icon('refresh') }}</button>
                        </form>
                    {% else %}
                        <button
                            type="button"
                            class="icon-btn"
                            disabled
                            aria-label="{{ 'admin.modules.update_all_none'|trans }}"
                            title="{{ 'admin.modules.update_all_none'|trans }}"
                        >{{ icon('refresh') }}</button>
                    {% endif %}
                </div>
            </div>

            <form
                class="bulk-bar"
                method="post"
                action="{{ url('admin.modules.bulk') }}"
                x-show="selectedCount > 0"
                x-cloak
                @submit="confirmBulk"
            >
                {{ csrf_field()|raw }}
                <input type="hidden" name="purge_media" value="0" x-ref="purgeMedia">
                <template x-for="id in selected" :key="id">
                    <input type="hidden" name="ids[]" :value="id">
                </template>
                <div class="bulk-bar__meta">
                    <strong x-text="selectedCount"></strong>
                    <span>{{ 'admin.modules.bulk.selected'|trans }}</span>
                    <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'admin.modules.bulk.clear'|trans }}</button>
                </div>
                <div class="bulk-bar__actions" @change="syncBulkAction($event)">
                    {% include 'ui/select.html.twig' with {
                        name: 'action',
                        id: 'bulk-module-action',
                        label: '',
                        placeholder: 'admin.modules.bulk.choose'|trans,
                        value: '',
                        extra: 'bulk-bar__select-field',
                        options: [
                            { value: '', label: 'admin.modules.bulk.choose'|trans },
                            { value: 'update', label: 'admin.modules.bulk.action.update'|trans },
                            { value: 'enable', label: 'admin.modules.bulk.action.enable'|trans },
                            { value: 'pause', label: 'admin.modules.bulk.action.pause'|trans },
                            { value: 'disable', label: 'admin.modules.bulk.action.disable'|trans },
                        ]
                    } %}
                    <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'admin.modules.bulk.apply'|trans }}</button>
                </div>
            </form>

            <div class="table-wrap" data-table>
                <table class="table">
                    <thead>
                        <tr>
                            <th class="table__check">
                                <label class="table-check">
                                    <input
                                        type="checkbox"
                                        x-ref="selectAll"
                                        @change="toggleAll"
                                        :checked="allSelected"
                                    >
                                    <span class="sr-only">{{ 'admin.modules.bulk.select_all'|trans }}</span>
                                </label>
                            </th>
                            <th>{{ 'admin.modules.col.name'|trans }}</th>
                            <th>{{ 'admin.modules.col.description'|trans }}</th>
                            <th class="is-center">{{ 'admin.modules.col.submodules'|trans }}</th>
                            <th class="is-center">{{ 'admin.modules.col.status'|trans }}</th>
                            <th class="is-num">API</th>
                            <th class="is-num">{{ 'admin.modules.meta.routes'|trans }}</th>
                            <th class="is-num">{{ 'admin.modules.meta.migrations'|trans }}</th>
                            <th>{{ 'admin.modules.col.health'|trans }}</th>
                            <th class="table__actions-head"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in items %}
                            {% set manifest = row.manifest %}
                            {% set counts = row.counts %}
                            {% set childCount = row.child_count|default(0) %}
                            {% set searchBlob = (manifest.name ~ ' ' ~ manifest.id ~ ' ' ~ manifest.kind ~ ' ' ~ (row.parent_name|default('')) ~ ' ' ~ (manifest.description|trans))|lower %}
                            <tr
                                class="{{ manifest.parentId ? 'grq-module-child-row' : (childCount > 0 ? 'grq-module-parent-row' : '') }}"
                                data-id="{{ manifest.id }}"
                                {% if manifest.parentId %}data-parent-id="{{ manifest.parentId }}"{% endif %}
                                data-enabled="{{ row.enabled ? '1' : '0' }}"
                                data-kind="{{ manifest.kind }}"
                                data-warn="{{ (row.enabled and (row.health_issues or row.missing is not empty) or row.update_available) ? '1' : '0' }}"
                                data-update="{{ row.update_available ? '1' : '0' }}"
                                data-search="{{ searchBlob|e('html_attr') }}"
                                :class="isSelected($el.dataset.id) ? 'is-selected' : ''"
                            >
                                <td class="table__check">
                                    <label class="table-check">
                                        <input
                                            type="checkbox"
                                            value="{{ manifest.id }}"
                                            {% if childCount > 0 %}data-has-children="1"{% endif %}
                                            :checked="isSelected($el.value)"
                                        >
                                        <span class="sr-only">{{ manifest.name }}</span>
                                    </label>
                                </td>
                                <td>
                                    <div class="table__title table__title--with-icon{% if manifest.parentId %} grq-module-child{% endif %}">
                                        {% if childCount > 0 %}
                                            <button
                                                type="button"
                                                class="module-row__icon grq-module-children-toggle"
                                                data-module-children-toggle
                                                data-parent-id="{{ manifest.id }}"
                                                aria-expanded="false"
                                                aria-label="{{ 'admin.modules.submodules_toggle'|trans({'%count%': childCount}) }}"
                                                title="{{ 'admin.modules.submodules'|trans }}"
                                            >
                                                <span class="module-row__icon-face" aria-hidden="true">{{ icon(manifest.icon ?: 'modules') }}</span>
                                                <span class="grq-module-children-toggle__badge" aria-hidden="true">{{ icon('chevron-right') }}</span>
                                            </button>
                                        {% else %}
                                            <span class="module-row__icon" aria-hidden="true">{{ icon(manifest.icon ?: 'modules') }}</span>
                                        {% endif %}
                                        <div class="table__title-text">
                                            <a href="{{ url('admin.modules.show', {id: manifest.id}) }}">{{ manifest.name }}</a>
                                            <span class="table__meta">
                                                <code>{{ manifest.id }}</code> · v{{ manifest.version }}
                                                {% if manifest.parentId %}
                                                    · {{ 'admin.modules.submodule'|trans }}
                                                    <a href="{{ url('admin.modules.show', {id: manifest.parentId}) }}">{{ manifest.parentId }}</a>
                                                {% endif %}
                                                {% if manifest.kind == 'integration' %}
                                                    · <span class="badge badge--info">{{ 'admin.modules.kind.integration'|trans }}</span>
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="is-mute">{{ (manifest.description ?: 'common.no_description')|trans }}</td>
                                <td class="is-center is-mute">
                                    {% if childCount > 0 %}{{ childCount }}{% else %}<span class="muted">—</span>{% endif %}
                                </td>
                                <td class="is-center" data-module-status>
                                    {% if row.update_available %}
                                        <span class="badge badge--warn" data-module-status-badge="update">{{ 'admin.modules.update_available'|trans }}</span>
                                    {% elseif row.enabled %}
                                        <span class="badge badge--ok" data-module-status-badge="on">{{ 'common.enabled'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge--danger" data-module-status-badge="off">{{ 'common.disabled'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="is-num is-mute">{{ counts.api }}</td>
                                <td class="is-num is-mute">{{ counts.routes }}</td>
                                <td class="is-num is-mute">
                                    {{ counts.migrations }}
                                    {% if row.enabled and counts.migrations_pending %}
                                        <div class="muted">{{ 'admin.modules.meta.pending'|trans({'%count%': counts.migrations_pending}) }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if row.enabled and row.missing is not empty %}
                                        <span class="badge badge--danger">{{ 'admin.modules.missing'|trans({'%list%': row.missing|join(', ')}) }}</span>
                                    {% elseif row.enabled and row.health_issues %}
                                        <span class="badge badge--warn">{{ row.health_issues }} {{ 'admin.modules.meta.health'|trans }}</span>
                                    {% else %}
                                        <span class="muted">—</span>
                                    {% endif %}
                                </td>
                                {% set parentEnabled = row.parent_enabled is defined ? row.parent_enabled : true %}
                                {% embed 'ui/row_actions.html.twig' %}
                                    {% block items %}
                                        {# Always in DOM — AJAX toggles visibility without a full page reload. #}
                                        <form
                                            method="post"
                                            action="{{ url('admin.modules.pause', {id: manifest.id}) }}"
                                            data-module-action="pause"
                                            data-confirm="{{ 'admin.modules.confirm.pause'|trans|e('html_attr') }}"
                                            data-confirm-title="{{ 'admin.modules.confirm.pause_title'|trans|e('html_attr') }}"
                                            data-confirm-label="{{ 'common.pause'|trans|e('html_attr') }}"
                                            data-confirm-danger="0"
                                            {% if not row.enabled %}hidden{% endif %}
                                        >
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="return" value="index">
                                            <button
                                                type="submit"
                                                class="table__action-btn table__action-btn--warn"
                                                title="{{ 'admin.modules.pause_hint'|trans }}"
                                                aria-label="{{ 'common.pause'|trans }}"
                                            >{{ icon('pause') }}</button>
                                        </form>
                                        <span
                                            class="table__action-btn table__action-btn--spacer"
                                            data-module-action="enable-blocked"
                                            aria-hidden="true"
                                            {% if row.enabled or parentEnabled or not manifest.parentId %}hidden{% endif %}
                                        ></span>
                                        <form
                                            method="post"
                                            action="{{ url('admin.modules.enable', {id: manifest.id}) }}"
                                            data-module-action="enable"
                                            {% if row.enabled or (manifest.parentId and not parentEnabled) %}hidden{% endif %}
                                        >
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="return" value="index">
                                            <button
                                                type="submit"
                                                class="table__action-btn table__action-btn--success"
                                                title="{{ 'common.activate'|trans }}"
                                                aria-label="{{ 'common.activate'|trans }}"
                                            >{{ icon('play') }}</button>
                                        </form>
                                        <form
                                            method="post"
                                            action="{{ url('admin.modules.disable', {id: manifest.id}) }}"
                                            data-module-action="disable"
                                            data-confirm="{{ 'admin.modules.confirm.disable'|trans|e('html_attr') }}"
                                            data-confirm-title="{{ 'admin.modules.confirm.disable_title'|trans|e('html_attr') }}"
                                            data-confirm-label="{{ 'common.stop'|trans|e('html_attr') }}"
                                            data-confirm-danger="1"
                                            data-confirm-followup="{{ 'admin.modules.confirm.disable_media'|trans|e('html_attr') }}"
                                            data-confirm-followup-title="{{ 'admin.modules.confirm.disable_media_title'|trans|e('html_attr') }}"
                                            data-confirm-followup-label="{{ 'admin.modules.confirm.disable_media_yes'|trans|e('html_attr') }}"
                                            data-confirm-followup-cancel="{{ 'admin.modules.confirm.disable_media_no'|trans|e('html_attr') }}"
                                            data-confirm-followup-input="purge_media"
                                            {% if not row.installed %}hidden{% endif %}
                                        >
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="return" value="index">
                                            <input type="hidden" name="purge_media" value="0">
                                            <button
                                                type="submit"
                                                class="table__action-btn table__action-btn--danger"
                                                title="{{ 'admin.modules.uninstall_hint'|trans }}"
                                                aria-label="{{ 'common.stop'|trans }}"
                                            >{{ icon('stop') }}</button>
                                        </form>
                                        <span
                                            class="table__action-btn table__action-btn--spacer"
                                            data-module-action="disable-spacer"
                                            aria-hidden="true"
                                            {% if row.installed %}hidden{% endif %}
                                        ></span>
                                        {% if row.settings_route %}
                                            {% include 'ui/row_action.html.twig' with { href: url(row.settings_route), label: 'common.settings'|trans, icon: 'settings' } %}
                                        {% else %}
                                            {% include 'ui/row_action.html.twig' with { placeholder: true } %}
                                        {% endif %}
                                        {% if row.update_available %}
                                            <form method="post" action="{{ url('admin.modules.update', {id: manifest.id}) }}" data-module-action="update">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="return" value="index">
                                                <button
                                                    type="submit"
                                                    class="table__action-btn table__action-btn--primary"
                                                    title="{{ 'admin.modules.update'|trans }}"
                                                    aria-label="{{ 'admin.modules.update'|trans }}"
                                                >{{ icon('refresh') }}</button>
                                            </form>
                                        {% else %}
                                            {% include 'ui/row_action.html.twig' with { placeholder: true } %}
                                        {% endif %}
                                    {% endblock %}
                                {% endembed %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10">
                                    <div class="empty">
                                        <h2>{{ 'empty.modules'|trans }}</h2>
                                        <p>{{ 'empty.modules_hint'|trans }}</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        <tr x-show="empty" x-cloak>
                            <td colspan="10">
                                <div class="empty">
                                    <h2>{{ 'admin.modules.filter.empty'|trans }}</h2>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    {% if groups is defined and groups is not empty %}
    <section class="design-panel" data-panel="packages" role="tabpanel">
        <div class="list-shell__panel">
            {% include 'admin/modules/_group_table.html.twig' with { groups: groups, return_tab: 'packages' } %}
        </div>
    </section>
    {% endif %}

    <section class="design-panel" data-panel="plugins" role="tabpanel">
        <div class="list-shell__panel">
            {% if pluginStats is defined and pluginStats.total > 0 %}
                <div class="widget-row" style="margin-bottom:1rem">
                    <div class="stat-card">
                        <div class="stat-card__label">{{ 'admin.plugins.stats.groups'|trans }}</div>
                        <div class="stat-card__value">{{ pluginStats.groups }}</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card__label">{{ 'admin.plugins.stats.enabled'|trans }}</div>
                        <div class="stat-card__value">{{ pluginStats.enabled }}</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-card__label">{{ 'admin.plugins.stats.total'|trans }}</div>
                        <div class="stat-card__value">{{ pluginStats.total }}</div>
                    </div>
                </div>
            {% endif %}
            <p class="muted" style="margin:0 0 1rem">{{ 'admin.plugins.intro'|trans }}</p>
            {% include 'admin/modules/_group_table.html.twig' with {
                groups: pluginGroups|default([]),
                empty_title: 'admin.plugins.empty'|trans,
                empty_hint: 'admin.plugins.empty.hint'|trans,
                return_tab: 'plugins'
            } %}
        </div>
    </section>
</div>
{% endblock %}
