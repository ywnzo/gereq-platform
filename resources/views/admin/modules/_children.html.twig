<section class="panel grq-module-children" aria-labelledby="module-children-title">
    <header class="panel__head">
        <h2 id="module-children-title">{{ 'admin.modules.submodules'|trans }} <span class="badge badge--muted">{{ children|length }}</span></h2>
    </header>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'admin.modules.col.name'|trans }}</th>
                    <th>{{ 'admin.modules.col.description'|trans }}</th>
                    <th>{{ 'admin.modules.col.status'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for child in children %}
                    <tr data-submodule-id="{{ child.manifest.id }}">
                        <td>
                            <a href="{{ url('admin.modules.show', {id: child.manifest.id}) }}">{{ child.manifest.name }}</a>
                            <span class="table__meta"><code>{{ child.manifest.id }}</code> · v{{ child.manifest.version }}</span>
                        </td>
                        <td class="is-mute">{{ child.manifest.description|trans }}</td>
                        <td>
                            <span class="badge {{ child.enabled ? 'badge--ok' : 'badge--danger' }}">{{ (child.enabled ? 'common.enabled' : 'common.disabled')|trans }}</span>
                            {% if child.missing is not empty %}
                                <span class="table__meta">{{ 'admin.modules.missing'|trans({'%list%': child.missing|join(', ')}) }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="grq-cluster">
                                {% if child.enabled %}
                                    <form method="post" action="{{ url('admin.modules.pause', {id: child.manifest.id}) }}" data-confirm="{{ 'admin.modules.confirm.pause'|trans }}" data-confirm-danger="0">
                                        {{ csrf_field()|raw }}
                                        <input type="hidden" name="return" value="{{ url('admin.modules.show', {id: parent.id}) }}">
                                        <button type="submit" class="btn btn--ghost btn-sm">{{ 'common.pause'|trans }}</button>
                                    </form>
                                {% elseif parent_enabled is not defined or parent_enabled %}
                                    <form method="post" action="{{ url('admin.modules.enable', {id: child.manifest.id}) }}">
                                        {{ csrf_field()|raw }}
                                        <input type="hidden" name="return" value="{{ url('admin.modules.show', {id: parent.id}) }}">
                                        <button type="submit" class="btn btn--success btn-sm" {{ child.missing is not empty ? 'disabled' : '' }}>{{ 'common.activate'|trans }}</button>
                                    </form>
                                {% endif %}
                                {% if child.installed %}
                                    <form method="post" action="{{ url('admin.modules.disable', {id: child.manifest.id}) }}" data-confirm="{{ 'admin.modules.confirm.disable'|trans }}" data-confirm-danger="1">
                                        {{ csrf_field()|raw }}
                                        <input type="hidden" name="return" value="{{ url('admin.modules.show', {id: parent.id}) }}">
                                        <button type="submit" class="btn btn--danger btn-sm">{{ 'admin.modules.uninstall'|trans }}</button>
                                    </form>
                                {% endif %}
                                {% if child.update_available %}
                                    <form method="post" action="{{ url('admin.modules.update', {id: child.manifest.id}) }}">
                                        {{ csrf_field()|raw }}
                                        <input type="hidden" name="return" value="{{ url('admin.modules.show', {id: parent.id}) }}">
                                        <button type="submit" class="btn btn--primary btn-sm">{{ 'admin.modules.update'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
