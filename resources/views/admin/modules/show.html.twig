{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'admin.modules.title'|trans, url: url('admin.modules.index') },
        { label: manifest.name },
    ] } %}
{% endblock %}

{% block content %}
    {% set overview = report.overview %}
    {% set counts = report.counts %}

    <header class="page-header">
        <div>
            <p class="eyebrow"><a href="{{ url('admin.modules.index') }}">{{ 'admin.modules.title'|trans }}</a></p>
            <h1>{{ manifest.name }}</h1>
            <p class="muted detail-layout__meta">
                <code>{{ manifest.id }}</code>
                <span>v{{ manifest.version }}</span>
                {% if overview.update_available %}
                    <span class="badge badge--warn">{{ 'admin.modules.update_available'|trans }}</span>
                {% endif %}
                <span class="status-chip{% if not enabled %} status-chip--muted{% endif %}"><span class="status-chip__dot"></span>{{ enabled ? 'common.enabled'|trans : 'common.disabled'|trans }}</span>
            </p>
            <p class="module-lead">{{ (manifest.description ?: 'common.no_description')|trans }}</p>
        </div>
        <div class="module-header-actions">
            {% if overview.update_available %}
                <form method="post" action="{{ url('admin.modules.update', {id: manifest.id}) }}">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--primary" type="submit">{{ 'admin.modules.update'|trans }}</button>
                </form>
            {% endif %}
            <form method="post" action="{{ enabled ? url('admin.modules.disable', {id: manifest.id}) : url('admin.modules.enable', {id: manifest.id}) }}">
                {{ csrf_field()|raw }}
                <button class="btn {{ enabled ? 'btn--ghost' : (overview.update_available ? 'btn--ghost' : 'btn--primary') }}" type="submit">
                    {{ enabled ? 'common.deactivate'|trans : 'common.activate'|trans }}
                </button>
            </form>
        </div>
    </header>

    {% if overview.update_available %}
        <div class="alert alert--warn">
            {{ 'admin.modules.update_hint'|trans({
                '%installed%': overview.installed_version ?: '—',
                '%current%': manifest.version,
                '%pending%': counts.migrations_pending
            }) }}
        </div>
    {% endif %}

    {% if missing is not empty %}
        <div class="alert alert--danger">{{ 'admin.modules.missing_deps'|trans({'%list%': missing|join(', ')}) }}</div>
    {% endif %}

    <div class="detail-hub module-hub" x-data="gereqTabs" data-initial="overview">
        <div class="design-tabs detail-tabs module-tabs" role="tablist" aria-label="{{ 'admin.modules.sections'|trans }}">
            <button type="button" class="design-tab" role="tab" data-tab="overview">{{ 'admin.modules.tab.overview'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="migrations">
                {{ 'admin.modules.tab.migrations'|trans }}{% if counts.migrations %}<span class="module-tab-count">{{ counts.migrations }}</span>{% endif %}
            </button>
            <button type="button" class="design-tab" role="tab" data-tab="api">
                {{ 'admin.modules.tab.api'|trans }}{% if counts.api %}<span class="module-tab-count">{{ counts.api }}</span>{% endif %}
            </button>
            <button type="button" class="design-tab" role="tab" data-tab="routes">
                {{ 'admin.modules.tab.routes'|trans }}{% if counts.routes %}<span class="module-tab-count">{{ counts.routes }}</span>{% endif %}
            </button>
            <button type="button" class="design-tab" role="tab" data-tab="hooks">
                {{ 'admin.modules.tab.hooks'|trans }}{% if counts.hooks or counts.events %}<span class="module-tab-count">{{ counts.hooks + counts.events }}</span>{% endif %}
            </button>
            <button type="button" class="design-tab" role="tab" data-tab="settings">
                {{ 'admin.modules.tab.settings'|trans }}{% if counts.settings %}<span class="module-tab-count">{{ counts.settings }}</span>{% endif %}
            </button>
            <button type="button" class="design-tab" role="tab" data-tab="files">
                {{ 'admin.modules.tab.files'|trans }}{% if counts.files %}<span class="module-tab-count">{{ counts.files }}</span>{% endif %}
            </button>
            <button type="button" class="design-tab" role="tab" data-tab="health">
                {{ 'admin.modules.tab.health'|trans }}{% if counts.health_issues %}<span class="module-tab-count module-tab-count--warn">{{ counts.health_issues }}</span>{% endif %}
            </button>
        </div>

        <section class="design-panel" data-panel="overview" role="tabpanel">
            <div class="detail-stack">
                <div class="detail-layout">
                    <div class="detail-layout__main">
                        <section class="detail-hero panel">
                            <div class="detail-hero__body">
                                <div class="detail-hero__highlight">
                                    <span>{{ 'common.version'|trans }}</span>
                                    <strong>v{{ manifest.version }}{% if overview.installed_version and overview.installed_version != manifest.version %} <span class="muted" style="font-size:0.7em;font-weight:500">{{ 'admin.modules.installed_version'|trans({'%version%': overview.installed_version}) }}</span>{% endif %}</strong>
                                </div>
                                <dl class="detail-hero__facts">
                                    <div>
                                        <dt>{{ 'common.author'|trans }}</dt>
                                        <dd>{{ manifest.author }}</dd>
                                    </div>
                                    <div>
                                        <dt>{{ 'common.activated_at'|trans }}</dt>
                                        <dd>{{ overview.enabled_at ?: 'common.none'|trans }}</dd>
                                    </div>
                                    <div>
                                        <dt>{{ 'common.enabled'|trans|default('Stav') }}</dt>
                                        <dd>{{ enabled ? 'common.enabled'|trans : 'common.disabled'|trans }}</dd>
                                    </div>
                                    <div>
                                        <dt>{{ 'admin.modules.summary.health'|trans }}</dt>
                                        <dd>{{ counts.health_issues }}</dd>
                                    </div>
                                </dl>
                            </div>
                        </section>

                        <section class="panel">
                            <header class="panel__head">
                                <h2>{{ 'admin.modules.summary.title'|trans }}</h2>
                            </header>
                            <div class="module-summary-cards">
                                <div class="module-summary-card">
                                    <strong>{{ counts.api }}</strong>
                                    <span>{{ 'admin.modules.summary.api'|trans }}</span>
                                </div>
                                <div class="module-summary-card">
                                    <strong>{{ counts.routes }}</strong>
                                    <span>{{ 'admin.modules.summary.routes'|trans }}</span>
                                </div>
                                <div class="module-summary-card">
                                    <strong>{{ counts.migrations }}</strong>
                                    <span>{{ 'admin.modules.summary.migrations'|trans }}</span>
                                </div>
                                <div class="module-summary-card">
                                    <strong>{{ counts.events }}</strong>
                                    <span>{{ 'admin.modules.summary.events'|trans }}</span>
                                </div>
                                <div class="module-summary-card">
                                    <strong>{{ counts.hooks }}</strong>
                                    <span>{{ 'admin.modules.summary.hooks'|trans }}</span>
                                </div>
                                <div class="module-summary-card{% if counts.health_issues %} module-summary-card--warn{% endif %}">
                                    <strong>{{ counts.health_issues }}</strong>
                                    <span>{{ 'admin.modules.summary.health'|trans }}</span>
                                </div>
                            </div>
                        </section>

                        <section class="panel">
                            <header class="panel__head">
                                <h2>{{ 'common.dependencies'|trans }}</h2>
                            </header>
                            <div class="module-deps">
                                <div class="module-deps__group">
                                    <h3>{{ 'common.dependencies'|trans }}</h3>
                                    <div class="module-chip-row">
                                        {% if manifest.requires is empty %}
                                            <span class="muted">{{ 'common.none'|trans }}</span>
                                        {% else %}
                                            {% for dep, constraint in manifest.requires %}
                                                <span class="badge{% if dep in missing %} badge--danger{% else %} badge--info{% endif %}">{{ dep }} {{ constraint }}</span>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                                {% if manifest.optional is not empty %}
                                    <div class="module-deps__group">
                                        <h3>{{ 'common.optional_deps'|trans }}</h3>
                                        <div class="module-chip-row">
                                            {% for dep, constraint in manifest.optional %}
                                                <span class="badge badge--muted">{{ dep }} {{ constraint }}</span>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                                <div class="module-deps__group">
                                    <h3>{{ 'common.capabilities'|trans }}</h3>
                                    <div class="module-chip-row">
                                        {% if manifest.capabilities is empty %}
                                            <span class="muted">{{ 'common.none'|trans }}</span>
                                        {% else %}
                                            {% for cap in manifest.capabilities %}
                                                <span class="badge badge--ok">{{ cap }}{% if overview.capability_providers[cap] is defined and overview.capability_providers[cap] is not empty %} · {{ overview.capability_providers[cap]|join(', ') }}{% endif %}</span>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="module-deps__group">
                                    <h3>{{ 'common.permissions'|trans }}</h3>
                                    <div class="module-chip-row">
                                        {% if manifest.permissions is empty %}
                                            <span class="muted">{{ 'common.none'|trans }}</span>
                                        {% else %}
                                            {% for permission in manifest.permissions %}
                                                <code class="module-perm" title="{{ permission.label|trans }}">{{ permission.name }}</code>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>

                    <aside class="detail-layout__aside">
                        <section class="panel">
                            <header class="panel__head">
                                <h2>{{ 'admin.modules.tab.health'|trans }}</h2>
                            </header>
                            <dl class="meta-list meta-list--flush detail-layout__specs">
                                <div>
                                    <dt>{{ 'common.enabled'|trans|default('Stav') }}</dt>
                                    <dd>
                                        <span class="status-chip{% if not enabled %} status-chip--muted{% endif %}">
                                            <span class="status-chip__dot"></span>{{ enabled ? 'common.enabled'|trans : 'common.disabled'|trans }}
                                        </span>
                                    </dd>
                                </div>
                                <div>
                                    <dt>{{ 'admin.modules.summary.health'|trans }}</dt>
                                    <dd>{% if counts.health_issues %}<span class="badge badge--warn">{{ counts.health_issues }}</span>{% else %}<span class="badge badge--ok">0</span>{% endif %}</dd>
                                </div>
                                <div class="meta-list__full">
                                    <dt>{{ 'common.class'|trans }}</dt>
                                    <dd><code>{{ manifest.moduleClass }}</code></dd>
                                </div>
                                <div class="meta-list__full">
                                    <dt>{{ 'common.path'|trans }}</dt>
                                    <dd><code class="module-code-soft">{{ manifest.path }}</code></dd>
                                </div>
                                <div class="meta-list__full">
                                    <dt>{{ 'common.activated_at'|trans }}</dt>
                                    <dd>{{ overview.enabled_at ?: 'common.none'|trans }}</dd>
                                </div>
                            </dl>
                        </section>
                    </aside>
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="migrations" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ 'admin.modules.migrations.title'|trans }}</h2>
                        <p class="muted">{{ 'admin.modules.migrations.hint'|trans }}</p>
                    </div>
                    {% if overview.update_available and counts.migrations_pending %}
                        <form method="post" action="{{ url('admin.modules.update', {id: manifest.id}) }}">
                            {{ csrf_field()|raw }}
                            <button class="btn btn--primary" type="submit">{{ 'admin.modules.update'|trans }}</button>
                        </form>
                    {% endif %}
                </header>
                {% if report.migrations is empty %}
                    <div class="empty"><h2>{{ 'empty.migrations'|trans }}</h2><p>{{ 'empty.migrations_hint'|trans }}</p></div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr><th>{{ 'admin.modules.col.file'|trans }}</th><th>{{ 'admin.modules.col.version'|trans }}</th><th>{{ 'admin.modules.col.status'|trans }}</th><th>{{ 'admin.modules.col.ran_at'|trans }}</th></tr>
                            </thead>
                            <tbody>
                                {% for row in report.migrations %}
                                    <tr>
                                        <td><code>{{ row.file }}</code></td>
                                        <td class="muted"><code>{{ row.version }}</code></td>
                                        <td>
                                            {% if row.ran %}
                                                <span class="badge badge--ok">{{ 'common.applied'|trans }}</span>
                                            {% else %}
                                                <span class="badge badge--danger">{{ 'common.pending'|trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="muted">{{ row.ran_at ?: 'common.none'|trans }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </section>

        <section class="design-panel" data-panel="api" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ 'admin.modules.api.title'|trans }}</h2>
                        <p class="muted">{{ 'admin.modules.api.hint'|trans }}{% if not enabled %}{{ 'admin.modules.api.hint_disabled'|trans }}{% endif %}</p>
                    </div>
                </header>
                {% if report.api is empty %}
                    <div class="empty"><h2>{{ 'empty.api'|trans }}</h2><p>{% if enabled %}{{ 'empty.api_enabled'|trans }}{% else %}{{ 'empty.api_disabled'|trans }}{% endif %}</p></div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr><th>{{ 'admin.modules.col.method'|trans }}</th><th>{{ 'admin.modules.col.path'|trans }}</th><th>{{ 'admin.modules.col.scopes'|trans }}</th><th>{{ 'admin.modules.col.permission'|trans }}</th><th>{{ 'admin.modules.col.summary'|trans }}</th></tr>
                            </thead>
                            <tbody>
                                {% for route in report.api %}
                                    {% for method in route.methods %}
                                        <tr>
                                            <td><span class="badge badge--info">{{ method }}</span></td>
                                            <td><code>{{ route.path }}</code></td>
                                            <td class="muted">{{ route.scopes|join(', ') ?: 'common.none'|trans }}</td>
                                            <td class="muted">{{ route.permission ?: 'common.none'|trans }}</td>
                                            <td>{{ route.summary ?: 'common.none'|trans }}</td>
                                        </tr>
                                    {% endfor %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </section>

        <section class="design-panel" data-panel="routes" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ 'admin.modules.routes.title'|trans }}</h2>
                        <p class="muted">{{ 'admin.modules.routes.hint'|trans }}</p>
                    </div>
                </header>
                {% if report.routes is empty %}
                    <div class="empty"><h2>{{ 'empty.routes'|trans }}</h2><p>{% if enabled %}{{ 'empty.routes_enabled'|trans }}{% else %}{{ 'empty.routes_disabled'|trans }}{% endif %}</p></div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr><th>{{ 'admin.modules.col.method'|trans }}</th><th>{{ 'admin.modules.col.path'|trans }}</th><th>{{ 'admin.modules.col.name'|trans }}</th><th>{{ 'admin.modules.col.permission'|trans }}</th><th>{{ 'admin.modules.col.handler'|trans }}</th></tr>
                            </thead>
                            <tbody>
                                {% for route in report.routes %}
                                    <tr>
                                        <td><code>{{ route.methods|join(', ') }}</code></td>
                                        <td><code>{{ route.path }}</code></td>
                                        <td class="muted">{{ route.name ?: 'common.none'|trans }}</td>
                                        <td class="muted">{{ route.permission ?: 'common.none'|trans }}</td>
                                        <td><code class="module-code-soft">{{ route.handler }}</code></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </section>

        <section class="design-panel" data-panel="hooks" role="tabpanel">
            <div class="detail-stack">
                <section class="panel">
                    <header class="panel__head">
                        <div>
                            <h2>{{ 'admin.modules.events.title'|trans }}</h2>
                            <p class="muted">{{ 'admin.modules.events.hint'|trans }}</p>
                        </div>
                    </header>
                    {% if report.events is empty %}
                        <div class="empty"><h2>{{ 'empty.events'|trans }}</h2><p>{{ 'empty.events_hint'|trans }}</p></div>
                    {% else %}
                        <div class="table-wrap">
                            <table class="table">
                                <thead>
                                    <tr><th>{{ 'admin.modules.col.type'|trans }}</th><th>{{ 'common.version'|trans }}</th><th>{{ 'admin.modules.col.webhook'|trans }}</th><th>{{ 'admin.modules.col.description'|trans }}</th></tr>
                                </thead>
                                <tbody>
                                    {% for event in report.events %}
                                        <tr>
                                            <td><code>{{ event.type }}</code></td>
                                            <td>v{{ event.version }}</td>
                                            <td>{% if event.webhook %}<span class="badge badge--ok">{{ 'common.yes'|trans }}</span>{% else %}<span class="badge badge--muted">{{ 'common.no'|trans }}</span>{% endif %}</td>
                                            <td>{{ event.description ?: 'common.none'|trans }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </section>

                <section class="panel">
                    <header class="panel__head">
                        <div>
                            <h2>{{ 'admin.modules.hooks.title'|trans }}</h2>
                            <p class="muted">{{ 'admin.modules.hooks.hint'|trans }}</p>
                        </div>
                    </header>
                    {% if report.hooks is empty %}
                        <div class="empty"><h2>{{ 'empty.hooks'|trans }}</h2><p>{% if enabled %}{{ 'empty.hooks_enabled'|trans }}{% else %}{{ 'empty.hooks_disabled'|trans }}{% endif %}</p></div>
                    {% else %}
                        <div class="table-wrap">
                            <table class="table">
                                <thead>
                                    <tr><th>{{ 'admin.modules.col.hook'|trans }}</th><th>{{ 'admin.modules.col.type'|trans }}</th><th>{{ 'admin.modules.col.listeners'|trans }}</th></tr>
                                </thead>
                                <tbody>
                                    {% for hook in report.hooks %}
                                        <tr>
                                            <td><code>{{ hook.name }}</code></td>
                                            <td><span class="badge">{{ hook.type }}</span></td>
                                            <td>{{ hook.listeners }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </section>
            </div>
        </section>

        <section class="design-panel" data-panel="settings" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ 'admin.modules.settings.title'|trans }}</h2>
                        <p class="muted">{{ 'admin.modules.settings.hint'|trans({'%id%': manifest.id}) }}</p>
                    </div>
                    {% if manifest.id == 'reviews' %}
                        <a class="btn btn--primary" href="{{ url('admin.reviews.settings') }}">{{ icon('settings') }} {{ 'reviews.settings.edit'|trans }}</a>
                    {% endif %}
                </header>
                {% if report.settings is empty %}
                    <div class="empty"><h2>{{ 'empty.settings'|trans }}</h2><p>{{ 'empty.settings_hint'|trans }}</p></div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr><th>{{ 'admin.modules.col.key'|trans }}</th><th>{{ 'common.type'|trans }}</th><th>{{ 'admin.modules.col.label'|trans }}</th><th>{{ 'admin.modules.col.default'|trans }}</th></tr>
                            </thead>
                            <tbody>
                                {% for setting in report.settings %}
                                    <tr>
                                        <td><code>{{ setting.key }}</code></td>
                                        <td>{{ setting.type }}</td>
                                        <td>{{ setting.label|trans }}</td>
                                        <td class="muted">{{ setting.default is same as(null) ? 'common.none'|trans : setting.default }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </section>

        <section class="design-panel" data-panel="files" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ 'admin.modules.files.title'|trans }}</h2>
                        <p class="muted">{{ 'admin.modules.files.hint'|trans({'%path%': manifest.path}) }}</p>
                    </div>
                </header>
                {% if report.files is empty %}
                    <div class="empty"><h2>{{ 'empty.files'|trans }}</h2><p>{{ 'empty.files_hint'|trans }}</p></div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr><th>{{ 'common.path'|trans }}</th><th>{{ 'common.type'|trans }}</th><th>{{ 'admin.modules.col.size'|trans }}</th></tr>
                            </thead>
                            <tbody>
                                {% for file in report.files %}
                                    <tr>
                                        <td><code class="module-code-soft">{{ file.path }}</code></td>
                                        <td>{{ file.type }}</td>
                                        <td class="muted">{% if file.size is not null %}{{ file.size }} B{% else %}{{ 'common.none'|trans }}{% endif %}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </section>

        <section class="design-panel" data-panel="health" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ 'admin.modules.health.title'|trans }}</h2>
                        <p class="muted">{{ 'admin.modules.health.hint'|trans }}</p>
                    </div>
                </header>
                <div class="module-health-list">
                    {% for check in report.health %}
                        <article class="module-health module-health--{{ check.status }}">
                            <div class="module-health__status">{{ check.status }}</div>
                            <div>
                                <h3>{{ check.label|trans(check.detail_params|default({})) }}</h3>
                                <p>{{ check.detail|trans(check.detail_params|default({})) }}</p>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>
        </section>
    </div>
{% endblock %}
