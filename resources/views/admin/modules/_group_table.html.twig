{# Shared package / plugin group rows. Expects: groups (list), optional return_tab #}
{% set returnUrl = url('admin.modules.index') ~ '#' ~ (return_tab|default('packages')) %}
<div class="table-wrap" data-table>
    <table class="table table--packages">
        <thead>
            <tr>
                <th>{{ 'admin.modules.col.name'|trans }}</th>
                <th>{{ 'admin.modules.col.description'|trans }}</th>
                <th>{{ 'admin.modules.col.status'|trans }}</th>
                <th class="is-num">{{ 'admin.modules.col.modules'|trans }}</th>
                <th class="table__actions-head"></th>
            </tr>
        </thead>
        <tbody>
            {% for group in groups %}
                <tr>
                    <td>
                        <div class="table__title package-row__title">
                            <span class="package-row__chip">{{ group.name }}</span>
                            <div>
                                <strong>{{ group.label|trans }}</strong>
                                <span class="table__meta"><code>{{ group.id }}</code></span>
                            </div>
                        </div>
                    </td>
                    <td class="is-mute">
                        <div>{{ group.description ? group.description|trans : '—' }}</div>
                        <div class="package-row__mods" title="{{ 'admin.modules.group.mod_toggle_hint'|trans }}">
                            {% for m in group.modules %}
                                {% set row = m.row %}
                                {% if row %}
                                    <a
                                        class="package-row__mod{% if row.enabled %} is-on{% endif %}"
                                        href="{{ url('admin.modules.show', {id: m.id}) }}"
                                        data-module-toggle
                                        data-module-id="{{ m.id }}"
                                        data-module-name="{{ row.manifest.name|e('html_attr') }}"
                                        data-enabled="{{ row.enabled ? '1' : '0' }}"
                                        data-enable-url="{{ url('admin.modules.enable', {id: m.id}) }}"
                                        data-pause-url="{{ url('admin.modules.pause', {id: m.id}) }}"
                                        data-return-url="{{ returnUrl|e('html_attr') }}"
                                        data-confirm-enable-title="{{ 'admin.modules.group.confirm_enable_one_title'|trans|e('html_attr') }}"
                                        data-confirm-enable="{{ 'admin.modules.group.confirm_enable_one'|trans|e('html_attr') }}"
                                        data-confirm-enable-label="{{ 'common.activate'|trans|e('html_attr') }}"
                                        data-confirm-pause-title="{{ 'admin.modules.group.confirm_pause_one_title'|trans|e('html_attr') }}"
                                        data-confirm-pause="{{ 'admin.modules.group.confirm_pause_one'|trans|e('html_attr') }}"
                                        data-confirm-pause-label="{{ 'common.pause'|trans|e('html_attr') }}"
                                        title="{{ 'admin.modules.group.mod_toggle_hint'|trans }}"
                                    >
                                        <span class="package-row__mod-icon" aria-hidden="true">{{ icon(row.manifest.icon ?: 'modules') }}</span>
                                        {{ row.manifest.name }}
                                    </a>
                                {% else %}
                                    <span class="package-row__mod is-missing">{{ m.id }}</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </td>
                    <td>
                        {% if group.all_enabled %}
                            <span class="badge badge--ok">{{ 'admin.modules.group.ready'|trans }}</span>
                        {% elseif group.complete %}
                            <span class="badge badge--warn">{{ 'admin.modules.group.partial'|trans }}</span>
                        {% else %}
                            <span class="badge badge--muted">{{ 'admin.modules.group.incomplete'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="is-num">
                        <span class="package-row__progress">{{ group.enabled }}/{{ group.total }}</span>
                        {% if group.all_enabled %}
                            <div class="muted" style="font-size:11px">{{ 'admin.modules.group.all_on'|trans }}</div>
                        {% endif %}
                    </td>
                    {% embed 'ui/row_actions.html.twig' %}
                        {% block items %}
                            {% if not group.all_enabled and group.disabled_ids is not empty %}
                                <form
                                    method="post"
                                    action="{{ url('admin.modules.group.enable', {group: group.id}) }}"
                                    data-confirm="{{ 'admin.modules.group.confirm_enable'|trans({'%name%': group.name, '%count%': group.disabled_ids|length}) }}"
                                    data-confirm-title="{{ 'admin.modules.group.enable_all'|trans }}"
                                    data-confirm-danger="0"
                                >
                                    {{ csrf_field()|raw }}
                                    <input type="hidden" name="return" value="{{ returnUrl|e('html_attr') }}">
                                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="submit"{% endblock %}{% block content %}{{ 'admin.modules.group.enable_all'|trans }}{% endblock %}{% endembed %}
                                </form>
                            {% else %}
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" disabled{% endblock %}{% block content %}{{ 'admin.modules.group.all_on'|trans }}{% endblock %}{% endembed %}
                            {% endif %}
                        {% endblock %}
                    {% endembed %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">
                        <div class="empty">
                            <h2>{{ empty_title|default('admin.plugins.empty'|trans) }}</h2>
                            <p class="muted">{{ empty_hint|default('admin.plugins.empty.hint'|trans) }}</p>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
