{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="admin-resource-{{ definition.name }}" data-actions-default="1">
    <header class="page-header">
        <h1>{{ definition.label }}</h1>
        <a class="btn btn--primary" href="{{ url('admin.' ~ definition.name ~ '.create') }}">{{ 'admin.resource.add'|trans }}</a>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'admin.resource.search'|trans }}">
        </form>
        <div class="toolbar__toggles">
            {% include 'ui/table_actions_toggle.html.twig' %}
        </div>
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% for field in definition.indexFields() %}
                        {% if field.sortable %}
                            {% include 'ui/sort_th.html.twig' with { label: field.label, column: field.name } %}
                        {% else %}
                            <th>{{ field.label }}</th>
                        {% endif %}
                    {% endfor %}
                    <th class="table__actions-head" x-show="showActions" x-cloak></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        {% for field in definition.indexFields() %}
                            <td>{{ attribute(item, field.name) is defined ? attribute(item, field.name) : '' }}</td>
                        {% endfor %}
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                <a href="{{ url('admin.' ~ definition.name ~ '.show', {id: item.id()}) }}">{{ 'common.detail'|trans }}</a>
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr><td colspan="20"><div class="empty">{{ 'empty.none'|trans }}</div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
