{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ definition.label }}</h1>
        <a class="btn btn--primary" href="{{ url('admin.' ~ definition.name ~ '.create') }}">Přidat</a>
    </header>
    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="Hledat…">
    </form>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    {% for field in definition.indexFields() %}
                        <th>{{ field.label }}</th>
                    {% endfor %}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        {% for field in definition.indexFields() %}
                            <td>{{ attribute(item, field.name) is defined ? attribute(item, field.name) : '' }}</td>
                        {% endfor %}
                        <td class="table__actions">
                            <a href="{{ url('admin.' ~ definition.name ~ '.show', {id: item.id()}) }}">Detail</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="20"><div class="empty">Žádné záznamy.</div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
