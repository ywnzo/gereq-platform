{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'common.edit'|trans : 'admin.resource.new'|trans }}</h1>
    </header>
    <form method="post" class="form-grid" action="{{ item ? url('admin.' ~ definition.name ~ '.update', {id: item.id()}) : url('admin.' ~ definition.name ~ '.store') }}">
        {{ csrf_field()|raw }}
        {% for field in definition.formFields() %}
            <label class="field {{ field.type == 'textarea' ? 'field--full' : '' }}">
                <span>{{ field.label }}</span>
                {% if field.type == 'textarea' %}
                    {% embed 'ui/textarea.html.twig' with { textarea_options: { control_only: true } } %}{% block input_attributes %} name="{{ field.name }}" rows="4"{% endblock %}{% block content %}{{ item ? attribute(item, field.name) : '' }}{% endblock %}{% endembed %}
                {% else %}
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="{{ field.type == 'email' ? 'email' : 'text' }}" name="{{ field.name }}" value="{{ item ? attribute(item, field.name) : '' }}" {{ field.required ? 'required' : '' }}{% endblock %}{% endembed %}
                {% endif %}
            </label>
        {% endfor %}
        <div class="form-actions">
            {% include 'ui/button.html.twig' with { label: 'common.save'|trans, type: 'submit', variant: 'primary' } only %}
        </div>
    </form>
{% endblock %}
