{% extends 'admin/layout.html.twig' %}

{% block content %}
    {% set fields = definition.detailFields() %}
    {% set first = fields|first %}
    <header class="page-header">
        <h1>{{ definition.singular }}</h1>
        {% include 'ui/button.html.twig' with {
            label: 'common.edit'|trans,
            href: (url('admin.' ~ definition.name ~ '.edit', {id: item.id()})),
            button_options: { tag: 'a' },
            variant: 'primary'
        } only %}
    </header>
    <div class="detail-layout">
        <div class="detail-layout__main">
            {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
                {% block attributes %} class="detail-hero panel"{% endblock %}
                {% block content %}
                <div class="detail-hero__body{% if fields|length < 2 %} detail-hero__body--solo{% endif %}">
                    {% if first %}
                        <div class="detail-hero__highlight">
                            <span>{{ first.label }}</span>
                            <strong>{{ attribute(item, first.name) }}</strong>
                        </div>
                    {% endif %}
                    {% if fields|length > 1 %}
                        <dl class="detail-hero__facts">
                            {% for field in fields|slice(1, 4) %}
                                <div>
                                    <dt>{{ field.label }}</dt>
                                    <dd>{{ attribute(item, field.name) }}</dd>
                                </div>
                            {% endfor %}
                        </dl>
                    {% endif %}
                </div>
                {% endblock %}
            {% endembed %}
        </div>
        <aside class="detail-layout__aside">
            {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
                {% block attributes %} class="panel"{% endblock %}
                {% block content %}
                <header class="panel__head"><h2>{{ 'common.overview'|trans }}</h2></header>
                <dl class="meta-list meta-list--flush detail-layout__specs">
                    {% for field in fields %}
                        <div>
                            <dt>{{ field.label }}</dt>
                            <dd>{{ attribute(item, field.name) }}</dd>
                        </div>
                    {% endfor %}
                </dl>
                {% endblock %}
            {% endembed %}
        </aside>
    </div>
{% endblock %}
