{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="developer-page">
    <header class="page-header">
        <div>
            <h1>{{ 'admin.tokens.title'|trans }}</h1>
        </div>
        {% if user.can('developer.tokens.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.developer.tokens.create') }}">{{ icon('plus') }} {{ 'admin.tokens.new'|trans }}</a>
        {% endif %}
    </header>

    <div class="table-wrap">
        <table class="table table--developer table--tokens">
            <colgroup>
                <col class="col-name">
                <col class="col-prefix">
                <col class="col-scopes">
                <col class="col-used">
                <col class="col-status">
                <col class="col-actions">
            </colgroup>
            <thead>
                <tr>
                    <th>{{ 'admin.tokens.name'|trans }}</th>
                    <th>{{ 'admin.tokens.prefix'|trans }}</th>
                    <th>{{ 'admin.tokens.scopes'|trans }}</th>
                    <th>{{ 'admin.tokens.last_used'|trans }}</th>
                    <th>{{ 'common.status'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td><strong>{{ item.name() }}</strong></td>
                        <td><code>{{ item.tokenPrefix() }}…</code></td>
                        <td class="table__wrap-cell muted">{{ item.scopes()|join(', ') }}</td>
                        <td>{{ item.lastUsedAt() ? item.lastUsedAt().format('d. m. Y H:i') : 'common.none'|trans }}</td>
                        <td>
                            {% if item.revokedAt() %}
                                <span class="badge badge--muted">{{ 'admin.tokens.status.revoked'|trans }}</span>
                            {% elseif item.isActive() %}
                                <span class="badge badge--ok">{{ 'admin.tokens.status.active'|trans }}</span>
                            {% else %}
                                <span class="badge badge--warn">{{ 'admin.tokens.status.expired'|trans }}</span>
                            {% endif %}
                        </td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('developer.tokens.manage') and item.isActive() %}
                                    <form method="post" action="{{ url('admin.developer.tokens.revoke', {id: item.id()}) }}" data-confirm="{{ 'admin.tokens.confirm_revoke'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'admin.tokens.revoke'|trans }}</button>
                                    </form>
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr><td colspan="6"><div class="empty"><h2>{{ 'empty.tokens'|trans }}</h2></div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
