{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ plain ? 'admin.tokens.created_title'|trans : 'admin.tokens.new_title'|trans }}</h1>
    </header>

    {% if plain %}
        <div class="empty">
            <h2>{{ 'admin.tokens.save_once'|trans }}</h2>
            <p><code style="font-size:1rem;word-break:break-all">{{ plain }}</code></p>
            {% include 'ui/button.html.twig' with {
                label: 'admin.tokens.back'|trans,
                href: (url('admin.developer.tokens.index')),
                button_options: { tag: 'a' },
                variant: 'primary'
            } only %}
        </div>
    {% else %}
        <form method="post" action="{{ url('admin.developer.tokens.store') }}" class="form-grid">
            {{ csrf_field()|raw }}
            {% include 'ui/input.html.twig' with { name: 'name', label: 'admin.tokens.name'|trans, value: '' } %}
            {% include 'ui/input.html.twig' with { name: 'expires_at', type: 'date', label: 'admin.tokens.expires'|trans, optional: true, value: '' } %}
            <div class="field field--full">
                <label class="g-check">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="test" value="1"{% endblock %}{% endembed %} {{ 'admin.tokens.test'|trans }}</label>
                <label class="g-check">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="full_access" value="1"{% endblock %}{% endembed %} {{ 'admin.tokens.full_access'|trans }}</label>
            </div>
            <div class="field field--full">
                <span class="g-label">{{ 'admin.tokens.scopes'|trans }}</span>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px">
                    {% for scope in scopes %}
                        <label class="g-check">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="scopes[]" value="{{ scope }}"{% endblock %}{% endembed %} {{ scope }}</label>
                    {% else %}
                        <p class="muted">{{ 'admin.tokens.scopes_empty'|trans }}</p>
                    {% endfor %}
                </div>
            </div>
            <div class="form-actions">
                {% include 'ui/button.html.twig' with { label: 'common.create'|trans, type: 'submit', variant: 'primary' } only %}
                {% include 'ui/button.html.twig' with {
                    label: 'common.cancel'|trans,
                    href: (url('admin.developer.tokens.index')),
                    button_options: { tag: 'a' },
                    variant: 'ghost'
                } only %}
            </div>
        </form>
    {% endif %}
{% endblock %}
