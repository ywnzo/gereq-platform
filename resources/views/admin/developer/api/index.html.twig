{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="developer-page" x-data="apiTester"
     data-api-base="{{ apiBase|e('html_attr') }}"
     data-tester-token-url="{{ testerTokenUrl|e('html_attr') }}"
     data-tester-user-id="{{ testerUserId|e('html_attr') }}"
     data-public-api-key="{{ publicApiKey|e('html_attr') }}"
     data-label-copy="{{ 'admin.api.tester.copy'|trans|e('html_attr') }}"
     data-label-copied="{{ 'admin.api.tester.copied'|trans|e('html_attr') }}">
    <header class="page-header">
        <div>
            <h1>{{ 'admin.api.title'|trans }}</h1>
            <p class="muted">{{ 'admin.api.auth_hint'|trans }}</p>
        </div>
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--ghost" href="{% if route_exists('api.openapi') %}{{ url('api.openapi') }}{% else %}/realityV3/api/openapi.json{% endif %}" target="_blank" rel="noopener"{% endblock %}{% block content %}{{ 'admin.api.openapi'|trans }}{% endblock %}{% endembed %}
    </header>

    {% embed 'ui/tabs.html.twig' with { tabs_options: { tag: 'div' } } %}{% block component_attributes %} class="detail-hub" x-data="gereqTabs" data-initial="private" data-breadcrumbs="0"{% endblock %}{% block content %}
        {% embed 'ui/tabs.html.twig' with { tabs_options: { tag: 'div' } } %}{% block component_attributes %} class="design-tabs detail-tabs" role="tablist" aria-label="{{ 'admin.api.title'|trans }}"{% endblock %}{% block content %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab" role="tab" data-tab="private"{% endblock %}{% block content %}
                {{ 'admin.api.tab.private'|trans }}
                <span class="module-tab-count">{{ privateCount }}</span>
            {% endblock %}{% endembed %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="design-tab" role="tab" data-tab="public"{% endblock %}{% block content %}
                {{ 'admin.api.tab.public'|trans }}
                <span class="module-tab-count">{{ publicCount }}</span>
            {% endblock %}{% endembed %}
        {% endblock %}{% endembed %}

        <section class="design-panel" data-panel="private" role="tabpanel">
            <p class="muted developer-tab-hint">{{ 'admin.api.tab.private.hint'|trans }}</p>
            {% include 'admin/developer/api/_routes.html.twig' with { modules: privateModules, empty_hint: 'empty.api_routes_hint'|trans } %}
        </section>

        <section class="design-panel" data-panel="public" role="tabpanel">
            <p class="muted developer-tab-hint">{{ 'admin.api.tab.public.hint'|trans }}</p>
            {% if publicApiKeyMasked %}
                <p class="muted developer-tab-hint">{{ 'admin.api.public_key'|trans }}: <code>{{ publicApiKeyMasked }}</code></p>
            {% else %}
                <p class="muted developer-tab-hint">{{ 'admin.api.public_key.missing'|trans }}</p>
            {% endif %}
            {% include 'admin/developer/api/_routes.html.twig' with { modules: publicModules, empty_hint: 'empty.api_public_routes_hint'|trans } %}
        </section>
    {% endblock %}{% endembed %}

    {% include 'admin/developer/api/_tester_dialog.html.twig' %}
</div>
{% endblock %}
