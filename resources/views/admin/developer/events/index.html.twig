{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="admin-events" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'admin.events.title'|trans }}</h1>
    </header>

    {% for module, events in groups %}
        <section class="hook-section">
            <header class="page-header page-header--compact"><h2>{{ module }}</h2></header>
            <div class="table-wrap" data-table>
                <table class="table">
                    <thead>
                        <tr><th>{{ 'admin.events.col.event'|trans }}</th><th>{{ 'admin.events.col.version'|trans }}</th><th>{{ 'admin.events.col.webhook'|trans }}</th><th>{{ 'admin.events.col.description'|trans }}</th></tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                            <tr>
                                <td><code>{{ event.type }}</code></td>
                                <td>v{{ event.version }}</td>
                                <td>{{ event.webhookEnabled ? 'common.yes'|trans : 'common.no'|trans }}</td>
                                <td class="muted">{{ event.description }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% else %}
        <div class="empty"><h2>{{ 'empty.events'|trans }}</h2></div>
    {% endfor %}
</div>
{% endblock %}
