<aside class="sidebar" :class="sidebarClass">
    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="icon-btn sidebar__collapse" @click="toggleCollapsed" aria-label="{{ 'ui.collapse_menu'|trans }}"{% endblock %}{% block content %}
        <span class="sidebar__collapse-arrow" aria-hidden="true">{{ icon('chevron-left') }}</span>
    {% endblock %}{% endembed %}

    <div class="sidebar__brand">
        {% include 'partials/brand-lockup.html.twig' with { href: url('admin.dashboard') } %}
    </div>

    {% set pinnedGroups = ['Systém'] %}

    <nav class="sidebar__nav" aria-label="{{ 'ui.main_menu'|trans }}">
        {% for section in menu %}
            {% if section.group not in pinnedGroups %}
                {% if section.group %}
                    <div
                        class="nav-group"
                        data-group="{{ section.group|e('html_attr') }}"
                        x-data="navGroup"
                        :class="groupClass"
                    >
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                            type="button"
                            class="nav-group__head"
                            @click="toggle"
                            :aria-expanded="expandedAttr"
                        {% endblock %}{% block content %}
                            <span class="nav-group__label">{{ section.group|trans }}</span>
                            <span class="nav-group__chevron" :class="chevronClass" aria-hidden="true">{{ icon('chevron-down') }}</span>
                        {% endblock %}{% endembed %}
                        <div class="nav-group__body">
                            <div class="nav-group__items">
                                {% for node in section.nodes %}
                                    {% include 'admin/partials/sidebar_nav_node.html.twig' with { node: node } only %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="nav-ungrouped">
                        {% for node in section.nodes %}
                            {% include 'admin/partials/sidebar_nav_node.html.twig' with { node: node } only %}
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
        {% endfor %}
    </nav>

    <div class="sidebar__pin">
        {% for section in menu %}
            {% if section.group in pinnedGroups %}
                <div
                    class="nav-group nav-group--pinned"
                    data-group="{{ section.group|e('html_attr') }}"
                    x-data="navGroup"
                    :class="groupClass"
                >
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                        type="button"
                        class="nav-group__head"
                        @click="toggle"
                        :aria-expanded="expandedAttr"
                    {% endblock %}{% block content %}
                        <span class="nav-group__label">{{ section.group|trans }}</span>
                        <span class="nav-group__chevron" :class="chevronClass" aria-hidden="true">{{ icon('chevron-down') }}</span>
                    {% endblock %}{% endembed %}
                    <div class="nav-group__body">
                        <div class="nav-group__items">
                            {% for node in section.nodes %}
                                {% include 'admin/partials/sidebar_nav_node.html.twig' with { node: node } only %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>

    <div class="sidebar__footer" title="{{ app_env() }} · v{{ app_version() }} · {{ brand('name') }}">
        <div class="sidebar__chip">
            <span class="sidebar__chip-dot" aria-hidden="true"></span>
            <span class="sidebar__env">{{ app_env() }}</span>
        </div>
        <span class="sidebar__ver">v{{ app_version() }}</span>
    </div>
</aside>
