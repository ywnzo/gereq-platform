{% set count = pending_count|default(0) %}
<div
    class="publish-badge"
    x-data="publishBadge"
    data-pending-url="{{ pending_url|e('html_attr') }}"
    data-publish-url="{{ publish_url|e('html_attr') }}"
    data-discard-url="{{ discard_url|default('')|e('html_attr') }}"
    data-workspace-url="{{ workspace_url|default('')|e('html_attr') }}"
    data-count-url="{{ count_url|default('')|e('html_attr') }}"
    data-count="{{ count }}"
    data-label-pending="{{ 'publish.badge.pending'|trans|e('html_attr') }}"
    data-label-cta="{{ 'publish.badge.cta'|trans|e('html_attr') }}"
    data-label-idle="{{ 'publish.badge.idle'|trans|e('html_attr') }}"
    data-label-publishing="{{ 'publish.publishing'|trans|e('html_attr') }}"
    data-label-submit="{{ 'publish.modal.submit'|trans|e('html_attr') }}"
    @mouseenter="onEnter"
    @mouseleave="onLeave"
>
    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
        type="button"
        class="badge publish-badge__chip"
        :class="chipClass"
        @click.prevent="togglePanel"
        :aria-expanded="expandedAttr"
        aria-haspopup="dialog"
    {% endblock %}{% block content %}
        <span
            class="material-symbols-outlined publish-badge__icon"
            aria-hidden="true"
            x-show="isIdle"
            x-cloak
        >check_circle</span>
        <span class="publish-badge__label" x-text="chipLabel"></span>
        <span class="publish-badge__count" x-text="count" x-show="count > 0" x-cloak></span>
    {% endblock %}{% endembed %}

    <div
        class="publish-badge__popover"
        x-show="popoverOpen"
        x-cloak
        @click.stop
        role="dialog"
        aria-label="{{ 'publish.popover.title'|trans }}"
    >
        <p class="publish-badge__intro">{{ 'publish.modal.intro'|trans }}</p>

        <div class="publish-badge__popover-body">
            <p class="muted" x-show="loading" x-cloak>{{ 'publish.loading'|trans }}</p>

            <div x-show="!loading">
                <template x-for="cat in categories" :key="cat.category">
                    <section class="publish-badge__group">
                        <label class="publish-check publish-check--category">
                            <span class="publish-check__control">
                                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                                    type="checkbox"
                                    :checked="isCategoryChecked(cat)"
                                    @change="toggleCategory(cat)"
                                {% endblock %}{% endembed %}
                                <span class="publish-check__mark" aria-hidden="true"></span>
                            </span>
                            <span class="publish-check__text">
                                <strong x-text="cat.label"></strong>
                                <span class="muted" x-text="cat.countLabel"></span>
                            </span>
                        </label>
                        <ul class="publish-badge__items">
                            <template x-for="item in cat.items" :key="item.id">
                                <li>
                                    <label class="publish-check">
                                        <span class="publish-check__control">
                                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                                                type="checkbox"
                                                :checked="isItemChecked(item)"
                                                @change="toggleItem(item)"
                                            {% endblock %}{% endembed %}
                                            <span class="publish-check__mark" aria-hidden="true"></span>
                                        </span>
                                        <span class="publish-check__text">
                                            <span x-text="item.display"></span>
                                            <span class="muted" x-show="item.summary" x-text="item.summary"></span>
                                        </span>
                                    </label>
                                </li>
                            </template>
                        </ul>
                    </section>
                </template>

                <p class="muted" x-show="showEmpty" x-cloak>{{ 'publish.empty'|trans }}</p>
            </div>
        </div>

        <div class="publish-badge__popover-foot">
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--ghost" :href="workspaceUrl" x-show="workspaceUrl"{% endblock %}{% block content %}{{ 'publish.show_more'|trans }}{% endblock %}{% endembed %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                type="button"
                class="btn btn--primary publish-badge__submit"
                @click="publishSelected"
                :disabled="cannotPublish"
            {% endblock %}{% block content %}
                <span x-text="submitLabel"></span>
            {% endblock %}{% endembed %}
        </div>
    </div>
</div>
