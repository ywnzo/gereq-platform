{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.users'|trans, url: url('admin.users.index') },
        { label: 'nav.roles'|trans, url: url('admin.users.roles') },
        { label: 'admin.roles.new'|trans },
    ] } %}
{% endblock %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'admin.roles.new'|trans }}</h1>
        <div class="actions">
            {% include 'ui/button.html.twig' with {
                label: 'common.save'|trans,
                type: 'submit',
                variant: 'primary',
                attrs: { 'form': 'role-create-form' }
            } only %}
            {% include 'ui/button.html.twig' with {
                label: 'common.cancel'|trans,
                href: (url('admin.users.roles')),
                button_options: { tag: 'a' },
                variant: 'ghost'
            } only %}
        </div>
    </header>

    <form method="post" id="role-create-form" action="{{ url('admin.roles.store') }}" class="stack">
        {{ csrf_field()|raw }}
        <label class="field">
            <span>{{ 'admin.roles.key'|trans }}</span>
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="text" name="name" value="{{ old('name', '') }}" required pattern="[a-zA-Z0-9_-]{2,80}" maxlength="80" autocomplete="off"{% endblock %}{% endembed %}
            <small class="muted">{{ 'admin.roles.key.hint'|trans }}</small>
        </label>
        <label class="field">
            <span>{{ 'admin.roles.name'|trans }}</span>
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="text" name="label" value="{{ old('label', '') }}" required maxlength="180"{% endblock %}{% endembed %}
        </label>
        <label class="field">
            <span>{{ 'common.description'|trans }}</span>
            {% embed 'ui/textarea.html.twig' with { textarea_options: { control_only: true } } %}{% block input_attributes %} name="description" rows="3" maxlength="2000"{% endblock %}{% block content %}{{ old('description', '') }}{% endblock %}{% endembed %}
        </label>
    </form>
{% endblock %}
