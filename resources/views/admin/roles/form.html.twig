{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.users'|trans, url: url('admin.users.index') },
        { label: 'nav.roles'|trans, url: url('admin.users.roles') },
        { label: 'admin.roles.new'|trans },
    ] } %}
{% endblock %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'admin.roles.new'|trans }}</h1>
        <div class="actions">
            <button class="btn btn--primary" type="submit" form="role-create-form">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.users.roles') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </header>

    <form method="post" id="role-create-form" action="{{ url('admin.roles.store') }}" class="stack">
        {{ csrf_field()|raw }}
        <label class="field">
            <span>{{ 'admin.roles.key'|trans }}</span>
            <input type="text" name="name" value="{{ old('name', '') }}" required pattern="[a-zA-Z0-9_-]{2,80}" maxlength="80" autocomplete="off">
            <small class="muted">{{ 'admin.roles.key.hint'|trans }}</small>
        </label>
        <label class="field">
            <span>{{ 'admin.roles.name'|trans }}</span>
            <input type="text" name="label" value="{{ old('label', '') }}" required maxlength="180">
        </label>
        <label class="field">
            <span>{{ 'common.description'|trans }}</span>
            <textarea name="description" rows="3" maxlength="2000">{{ old('description', '') }}</textarea>
        </label>
    </form>
{% endblock %}
