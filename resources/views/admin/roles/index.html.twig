{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>Role</h1>
    </header>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Popis</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for role in roles %}
                    <tr>
                        <td>{{ role.label() }}</td>
                        <td class="muted">{{ role.description() }}</td>
                        <td class="table__actions">
                            {% if user.can('roles.manage') %}
                                <a href="{{ url('admin.roles.edit', {id: role.id()}) }}">Oprávnění</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
