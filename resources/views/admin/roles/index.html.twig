{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="admin-roles" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'admin.roles.title'|trans }}</h1>
    </header>

    <div class="toolbar--table">
        <div class="toolbar"></div>
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'common.role'|trans }}</th>
                    <th>{{ 'common.description'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for role in roles %}
                    <tr>
                        <td>{{ role.label() }}</td>
                        <td class="muted">{{ role.description() }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('roles.manage') %}
                                    <a href="{{ url('admin.roles.edit', {id: role.id()}) }}">{{ 'admin.roles.permissions'|trans }}</a>
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
