<!DOCTYPE html>
<html lang="{{ app_locale() }}" class="dark" data-theme="gereq-dark" data-csp-nonce="{{ csp_nonce() }}" data-url-prefix="{{ config('app.url_prefix') }}" data-admin-path="/{{ config('admin.path') }}" style="{{ brand_html_style() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ pageTitle|default('admin.title'|trans) }}{% endblock %} · {{ brand('name') }}</title>
    {% include 'partials/brand-head.html.twig' with { admin_favicon: true } %}
    {{ render_css() }}
    {% include 'partials/brand-overrides.html.twig' %}
</head>
<body class="admin-body" data-sidebar="expanded">
    <div id="g-page-progress" class="g-page-progress" role="progressbar" aria-hidden="true" aria-valuemin="0" aria-valuemax="100"></div>
    <div
        class="app-shell"
        x-data="gereqAdmin"
        x-cloak
        data-theme-label-dark="{{ 'settings.theme.dark'|trans|e('html_attr') }}"
        data-theme-label-light="{{ 'settings.theme.light'|trans|e('html_attr') }}"
        data-theme-label-system="{{ 'settings.theme.system'|trans|e('html_attr') }}"
    >
        <div class="app-ambient" aria-hidden="true" style="--ambient-px:0;--ambient-py:0">
            {# Irregular shards / ribbons — avoid large solid flats after blur. #}
            <div class="app-ambient__parallax app-ambient__parallax--a">
            <svg class="app-ambient__layer app-ambient__layer--a" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M-40 180 C120 40, 260 -20, 420 90 S680 40, 820 -30" stroke-width="16" opacity="0.7"/>
                    <path d="M-20 280 C160 120, 340 60, 500 200 S780 140, 980 40" stroke-width="22" opacity="0.8"/>
                    <path d="M40 420 C220 260, 400 300, 560 180 S860 220, 1100 80" stroke-width="14" opacity="0.65"/>
                    <path d="M120 860 C320 620, 480 700, 640 480 S920 520, 1180 260" stroke-width="20" opacity="0.75"/>
                    <path d="M200 820 C380 640, 560 560, 740 620 S980 400, 1220 480" stroke-width="12" opacity="0.6"/>
                    <path d="M-60 520 C180 680, 360 440, 540 600 S860 500, 1080 720" stroke-width="18" opacity="0.7"/>
                </g>
                <g fill="currentColor">
                    <polygon points="140,80 210,55 245,120 190,165 115,140" opacity="0.8"/>
                    <polygon points="320,40 370,90 340,150 275,130 280,70" opacity="0.65"/>
                    <polygon points="980,70 1045,95 1020,160 955,145 940,90" opacity="0.75"/>
                    <polygon points="500,280 565,255 600,320 555,370 475,340" opacity="0.7"/>
                    <polygon points="680,300 730,270 775,330 720,385 655,350" opacity="0.65"/>
                    <polygon points="420,450 470,420 510,480 455,520 395,490" opacity="0.6"/>
                    <polygon points="760,430 820,410 850,475 790,510 740,470" opacity="0.7"/>
                    <polygon points="200,520 255,490 290,555 230,590 175,560" opacity="0.55"/>
                </g>
            </svg>
            </div>
            <div class="app-ambient__parallax app-ambient__parallax--b">
            <svg class="app-ambient__layer app-ambient__layer--b" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1280 40 C980 120, 860 -40, 640 100 S320 20, -40 160" stroke-width="15" opacity="0.65"/>
                    <path d="M1240 220 C1000 80, 780 260, 560 120 S260 200, 20 80" stroke-width="19" opacity="0.75"/>
                    <path d="M1260 700 C980 520, 820 780, 580 560 S300 720, -20 540" stroke-width="17" opacity="0.7"/>
                    <path d="M1100 860 C860 640, 700 820, 480 640 S220 780, 40 620" stroke-width="13" opacity="0.6"/>
                    <path d="M60 40 C240 220, 420 -20, 620 180 S900 40, 1140 260" stroke-width="21" opacity="0.7"/>
                </g>
                <g fill="currentColor">
                    <polygon points="860,480 925,450 970,520 910,575 840,540" opacity="0.75"/>
                    <polygon points="120,500 175,465 215,535 155,580 95,545" opacity="0.65"/>
                    <polygon points="640,220 700,190 745,260 680,305 615,270" opacity="0.7"/>
                    <polygon points="380,260 430,230 475,300 410,340 350,305" opacity="0.6"/>
                    <polygon points="540,400 600,365 645,440 575,485 510,450" opacity="0.7"/>
                    <polygon points="280,340 330,305 365,380 300,415 245,375" opacity="0.55"/>
                    <polygon points="800,180 850,150 890,215 830,255 775,220" opacity="0.65"/>
                    <polygon points="1000,320 1055,290 1090,360 1030,400 975,360" opacity="0.6"/>
                    <path d="M560 300 C590 270, 630 290, 620 340 C610 385, 560 390, 540 350 C525 320, 540 310, 560 300 Z" opacity="0.5"/>
                </g>
            </svg>
            </div>
        </div>

        <div class="sidebar-backdrop" @click="closeSidebar" :class="backdropClass"></div>

        {% include 'admin/partials/sidebar.html.twig' %}

        <div class="app-main">
            <header class="topbar">
                <div class="topbar__left">
                    <button type="button" class="icon-btn topbar__menu" @click="toggleMenu" aria-label="{{ 'ui.menu'|trans }}">
                        {{ icon('panel') }}
                    </button>
                    <nav class="breadcrumbs" aria-label="{{ 'ui.breadcrumbs'|trans }}">
                        {% block breadcrumb %}
                            {% if breadcrumbs is defined and breadcrumbs %}
                                {% include 'ui/breadcrumbs.html.twig' with { items: breadcrumbs } %}
                            {% else %}
                                {% include 'ui/breadcrumbs.html.twig' with { items: admin_breadcrumbs(pageTitle|default(null)) } %}
                            {% endif %}
                        {% endblock %}
                    </nav>
                </div>
                <div class="topbar__center">
                    {{ apply_filters('admin.topbar.center', '')|raw }}
                </div>
                <div class="topbar__right">
                    {{ apply_filters('admin.topbar.context', '')|raw }}
                    <div class="topbar__tools">
                        <button type="button" class="search-trigger" @click="openPalette">
                            {{ icon('search') }}
                            <span class="search-trigger__label">{{ 'common.search'|trans }}</span>
                            <kbd>Ctrl K</kbd>
                        </button>
                        <div class="topbar__icons">
                            <button type="button" class="icon-btn" @click="cycleTheme" :aria-label="themeLabel" :title="themeLabel">
                                <span class="material-symbols-outlined g-icon" aria-hidden="true" x-text="themeIcon">dark_mode</span>
                            </button>
                            {{ apply_filters('admin.topbar.actions', '')|raw }}
                        </div>
                        <div class="user-menu" @click.outside="closeUserMenu">
                            <button type="button" class="avatar-btn" @click="toggleUserMenu" aria-label="{{ user ? user.name() : 'admin.profile'|trans }}" :aria-expanded="userMenuExpanded">
                                {{ ui().avatar({
                                    email: user ? user.email() : null,
                                    initials: user ? user.initials() : 'G',
                                    src: user and user.avatarFileId() ? url('admin.users.avatar', {id: user.id()}) : null,
                                    alt: '',
                                })|raw }}
                            </button>
                            <div class="flyout" :class="userMenuClass">
                                <div class="flyout__meta">
                                    <strong>{{ user ? user.name() : '' }}</strong>
                                    <span>{{ user ? user.email() : '' }}</span>
                                </div>
                                <a href="{{ url('admin.profile') }}">{{ 'admin.profile'|trans }}</a>
                                <a href="{{ url('admin.settings.index') }}">{{ 'nav.settings'|trans }}</a>
                                <form method="post" action="{{ url('admin.logout') }}" id="logout-form">
                                    {{ csrf_field()|raw }}
                                    <button type="submit">{{ 'admin.logout'|trans }}</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="page">
                {% block content %}{% endblock %}
            </main>
        </div>

        <div class="palette" :class="paletteClass" role="dialog" aria-modal="true" aria-label="{{ 'common.search'|trans }}">
            <div class="palette__backdrop" @click="closePalette"></div>
            <div class="palette__panel">
                <div class="palette__header">
                    <span class="material-symbols-outlined g-icon palette__search-icon" aria-hidden="true">search</span>
                    <input
                        type="search"
                        class="palette__input"
                        :placeholder="placeholder"
                        x-model="query"
                        @input="refreshCommands"
                        x-ref="paletteInput"
                        autocomplete="off"
                        aria-autocomplete="list"
                        aria-controls="palette-results"
                    >
                    <span class="palette__kbd">esc</span>
                </div>
                <div class="palette__meta" x-show="!query.trim() && sourceChips.length > 0" x-cloak>
                    <template x-for="source in sourceChips" :key="source.id">
                        <span class="palette__chip">
                            <span class="material-symbols-outlined" aria-hidden="true" x-text="iconGlyph(source.icon)"></span>
                            <span x-text="source.group"></span>
                        </span>
                    </template>
                </div>
                <p class="palette__status" x-show="searchLoading" x-cloak>
                    <span class="palette__spinner" aria-hidden="true"></span>
                    <span>{{ 'ui.palette.searching'|trans }}</span>
                </p>
                <div class="palette__body" id="palette-results">
                    <template x-for="section in sections" :key="section.key">
                        <section class="palette__section">
                            <h3 class="palette__section-title" x-text="section.title"></h3>
                            <ul class="palette__list">
                                <template x-for="command in section.items" :key="command.id">
                                    <li>
                                        <a
                                            :href="command.url"
                                            class="palette__item"
                                            :class="itemClass(command, command.index)"
                                            :data-index="command.index"
                                            :data-command="command.id"
                                            @mouseenter="setActive(command.index)"
                                            @click="onCommandClick($event, command)"
                                        >
                                            <span class="material-symbols-outlined g-icon palette__icon" aria-hidden="true" x-text="iconGlyph(command.icon)"></span>
                                            <span class="palette__main">
                                                <span class="palette__label" x-text="command.label"></span>
                                                <span class="palette__sub" x-show="command.subtitle" x-text="command.subtitle"></span>
                                            </span>
                                            <span class="palette__group" x-text="command.group"></span>
                                            <span class="palette__enter">↵</span>
                                        </a>
                                    </li>
                                </template>
                            </ul>
                        </section>
                    </template>
                    <p class="palette__empty" x-show="query.trim().length >= 2 && !searchLoading && visibleCommands.length === 0" x-cloak>
                        <span class="material-symbols-outlined palette__empty-icon" aria-hidden="true">search_off</span>
                        <span>{{ 'ui.palette.empty'|trans }}</span>
                    </p>
                </div>
                <div class="palette__footer">
                    <span><kbd>↑</kbd><kbd>↓</kbd> {{ 'ui.palette.hint_nav'|trans }}</span>
                    <span><kbd>↵</kbd> {{ 'ui.palette.hint_open'|trans }}</span>
                    <span><kbd>esc</kbd> {{ 'ui.palette.hint_close'|trans }}</span>
                </div>
            </div>
        </div>
        {% set flashes_success = flash('success') %}
        {% set flashes_error = flash('error') %}
        {% set flashes_warning = flash('warning') %}
        {% set flashes_info = flash('info') %}
        <div class="toasts" id="toasts" data-close="{{ 'common.close'|trans|e('html_attr') }}" aria-live="polite" aria-relevant="additions"></div>
    </div>

    {{ apply_filters('admin.layout.end', '')|raw }}

    {% include 'ui/drawer.html.twig' with {
        id: 'gereq-drawer',
        title: '',
        body: '',
        footer: null,
        host: true
    } only %}
    {% include 'ui/confirm_dialog.html.twig' %}
    {% include 'ui/image_viewer.html.twig' %}

    <script nonce="{{ csp_nonce() }}">
        window.__GEREQ_URL_PREFIX__ = {{ config('app.url_prefix')|json_encode|raw }};
        window.__GEREQ_FLASHES__ = [
            {%- for message in flashes_success|default([]) -%}
                {%- if message|trim != '' -%}{"tone":"success","message":{{ message|json_encode|raw }}},{%- endif -%}
            {%- endfor -%}
            {%- for message in flashes_error|default([]) -%}
                {%- if message|trim != '' -%}{"tone":"error","message":{{ message|json_encode|raw }}},{%- endif -%}
            {%- endfor -%}
            {%- for message in flashes_warning|default([]) -%}
                {%- if message|trim != '' -%}{"tone":"warning","message":{{ message|json_encode|raw }}},{%- endif -%}
            {%- endfor -%}
            {%- for message in flashes_info|default([]) -%}
                {%- if message|trim != '' -%}{"tone":"info","message":{{ message|json_encode|raw }}},{%- endif -%}
            {%- endfor -%}
        ];
        window.__GEREQ_COMMANDS__ = [
            {%- for command in commands|default([]) -%}
            {
                "id": {{ command.id|json_encode|raw }},
                "label": {{ command.label|trans|json_encode|raw }},
                "url": {{ command.url|json_encode|raw }},
                "icon": {{ command.icon|json_encode|raw }},
                "keywords": {{ command.keywords|json_encode|raw }},
                "group": {{ command.group|trans|json_encode|raw }}
            }{% if not loop.last %},{% endif %}
            {%- endfor -%}
        ];
        window.__GEREQ_CSRF__ = {{ csrf_token()|json_encode|raw }};
        window.__GEREQ_UI_PREFS__ = {{ (user ? user.uiPreferences() : {})|json_encode|raw }};
        window.__GEREQ_UI_PREFS_URL__ = {{ url('admin.ui.preferences.save')|json_encode|raw }};
        window.__GEREQ_FORM_CLEARED__ = {{ flash('form_cleared')|json_encode|raw }};
        window.__GEREQ_FORM_FP_CLEARED__ = {{ flash('form_fp_cleared')|json_encode|raw }};
        window.__GEREQ_SEARCH_URL__ = {{ url('admin.search')|json_encode|raw }};
        window.__GEREQ_PALETTE_I18N__ = {
            placeholderNav: {{ 'ui.palette.placeholder_nav'|trans|json_encode|raw }},
            placeholderData: {{ 'ui.palette.placeholder_data'|trans|json_encode|raw }},
            recent: {{ 'ui.palette.recent'|trans|json_encode|raw }},
            actions: {{ 'ui.palette.actions'|trans|json_encode|raw }},
            navigation: {{ 'ui.palette.navigation'|trans|json_encode|raw }},
            results: {{ 'ui.palette.results'|trans|json_encode|raw }},
            empty: {{ 'ui.palette.empty'|trans|json_encode|raw }},
            searching: {{ 'ui.palette.searching'|trans|json_encode|raw }},
            hint: {{ 'ui.palette.hint'|trans|json_encode|raw }}
        };
    </script>
    {{ render_js() }}
    {{ render_reload() }}
</body>
</html>
