<!DOCTYPE html>
<html lang="{{ app_locale() }}" class="dark" data-theme="gereq-dark" data-csp-nonce="{{ csp_nonce() }}" style="{{ brand_html_style() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ pageTitle|default('admin.title'|trans) }}{% endblock %} · {{ brand('name') }}</title>
    {% include 'partials/brand-head.html.twig' %}
    <link rel="stylesheet" href="{{ asset('resources/css/admin.css') }}">
    {% include 'partials/brand-overrides.html.twig' %}
</head>
<body class="admin-body" data-sidebar="expanded">
    <div class="app-shell" x-data="gereqAdmin" x-cloak>
        <div class="sidebar-backdrop" @click="closeSidebar" :class="backdropClass"></div>

        <aside class="sidebar" :class="sidebarClass">
            <div class="sidebar__brand">
                {% include 'partials/brand-lockup.html.twig' with { href: url('admin.dashboard') } %}
                <button type="button" class="icon-btn sidebar__collapse" @click="toggleCollapsed" aria-label="{{ 'ui.collapse_menu'|trans }}">
                    {{ icon('panel') }}
                </button>
            </div>

            <div class="sidebar__search">
                <button type="button" class="sidebar__search-btn" @click="openPalette">
                    {{ icon('search') }}
                    <span>{{ 'common.search'|trans }}</span>
                    <kbd>⌘K</kbd>
                </button>
            </div>

            <nav class="sidebar__nav" aria-label="{{ 'ui.main_menu'|trans }}">
                {% set lastGroup = '' %}
                {% for node in menu %}
                    {% set menuItem = node.item %}
                    {% set group = menuItem.group|default('Hlavní') %}
                    {% if group != lastGroup %}
                        {% if lastGroup != '' %}
                </div></div>
                        {% endif %}
                        <div class="nav-group">
                            <div class="nav-group__head">
                                <span class="nav-group__label">{{ group|trans }}</span>
                            </div>
                            <div class="nav-group__items">
                        {% set lastGroup = group %}
                    {% endif %}

                    {% set active = menuItem.route is not null and route_is(menuItem.route) %}
                    {% set childActive = false %}
                    {% for child in node.children %}
                        {% if child.route and route_is(child.route) %}
                            {% set childActive = true %}
                        {% endif %}
                    {% endfor %}

                    {% if node.children|length > 0 %}
                        <div class="nav-tree" data-default-open="{{ (active or childActive) ? '1' : '0' }}" x-data="navTree">
                            <div class="nav-tree__row">
                                <a href="{{ node.url }}" class="nav-item{% if active %} is-active{% elseif childActive %} is-branch{% endif %}" title="{{ menuItem.label|trans }}">
                                    <span class="nav-item__icon">{{ icon(menuItem.icon|default('dot')) }}</span>
                                    <span class="nav-item__label">{{ menuItem.label|trans }}</span>
                                    {% if menuItem.badge %}
                                        <span class="nav-item__badge">{{ menuItem.badge }}</span>
                                    {% endif %}
                                </a>
                                <button type="button" class="nav-tree__expand" @click="toggle" :aria-expanded="expandedAttr" aria-label="{{ menuItem.label|trans }}">
                                    <span :class="chevronClass">{{ icon('chevron-down') }}</span>
                                </button>
                            </div>
                            <div class="nav-tree__children" x-show="open">
                                {% for child in node.children %}
                                    {% if not child.hidden %}
                                        <a href="{{ child.route ? url(child.route) : (child.url|default('#')) }}" class="nav-item nav-item--child{% if child.route and route_is(child.route) %} is-active{% endif %}">
                                            <span class="nav-item__label">{{ child.label|trans }}</span>
                                        </a>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ node.url }}" class="nav-item{% if active %} is-active{% endif %}" title="{{ menuItem.label|trans }}">
                            <span class="nav-item__icon">{{ icon(menuItem.icon|default('dot')) }}</span>
                            <span class="nav-item__label">{{ menuItem.label|trans }}</span>
                            {% if menuItem.badge %}
                                <span class="nav-item__badge">{{ menuItem.badge }}</span>
                            {% endif %}
                        </a>
                    {% endif %}
                {% endfor %}
                {% if lastGroup != '' %}
                            </div>
                        </div>
                {% endif %}
            </nav>

            <div class="sidebar__footer">
                <span class="sidebar__env">Platform</span>
                <span class="sidebar__ver">GEREQ</span>
            </div>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <div class="topbar__left">
                    <button type="button" class="icon-btn topbar__menu" @click="toggleMenu" aria-label="{{ 'ui.menu'|trans }}">
                        {{ icon('panel') }}
                    </button>
                    <nav class="breadcrumbs" aria-label="{{ 'ui.breadcrumbs'|trans }}">
                        {% block breadcrumb %}
                            {% if breadcrumbs is defined and breadcrumbs %}
                                {% include 'ui/breadcrumbs.html.twig' with { items: breadcrumbs } %}
                            {% else %}
                                {% include 'ui/breadcrumbs.html.twig' with { items: [
                                    { label: 'nav.overview'|trans, url: url('admin.dashboard') },
                                    { label: pageTitle|default('admin.title'|trans) },
                                ] } %}
                            {% endif %}
                        {% endblock %}
                    </nav>
                </div>
                <div class="topbar__right">
                    <button type="button" class="search-trigger" @click="openPalette">
                        {{ icon('search') }}
                        <span>{{ 'common.search'|trans }}</span>
                        <kbd>Ctrl K</kbd>
                    </button>
                    <button type="button" class="icon-btn" @click="cycleTheme" aria-label="{{ 'ui.theme'|trans }}">
                        {{ icon('sun') }}
                    </button>
                    {{ apply_filters('admin.topbar.actions', '')|raw }}
                    <div class="user-menu" @click.outside="closeUserMenu">
                        <button type="button" class="avatar-btn" @click="toggleUserMenu">
                            <span class="avatar">{{ user ? user.initials() : 'G' }}</span>
                        </button>
                        <div class="flyout" :class="userMenuClass">
                            <div class="flyout__meta">
                                <strong>{{ user ? user.name() : '' }}</strong>
                                <span>{{ user ? user.email() : '' }}</span>
                            </div>
                            <a href="{{ url('admin.profile') }}">{{ 'admin.profile'|trans }}</a>
                            <a href="{{ url('admin.settings.index') }}">{{ 'nav.settings'|trans }}</a>
                            <form method="post" action="{{ url('admin.logout') }}" id="logout-form">
                                {{ csrf_field()|raw }}
                                <button type="submit">{{ 'admin.logout'|trans }}</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main class="page">
                {% set flashes_success = flash('success') %}
                {% set flashes_error = flash('error') %}
                {% if flashes_success %}
                    {% for message in flashes_success %}
                        <div class="alert alert-success alert--success" role="status">{{ message }}</div>
                    {% endfor %}
                {% endif %}
                {% if flashes_error %}
                    {% for message in flashes_error %}
                        <div class="alert alert-error alert--danger" role="alert">{{ message }}</div>
                    {% endfor %}
                {% endif %}
                {% block content %}{% endblock %}
            </main>
        </div>

        <div class="palette" :class="paletteClass">
            <div class="palette__backdrop" @click="closePalette"></div>
            <div class="palette__panel">
                <input type="search" class="palette__input" placeholder="{{ 'ui.palette.placeholder'|trans }}" x-model="query" @input="refreshCommands" x-ref="paletteInput">
                <ul class="palette__list">
                    <template x-for="command in visibleCommands" :key="command.id">
                        <li>
                            <a :href="command.url" class="palette__item" :data-command="command.id" @click="onCommandClick">
                                <span x-text="command.label"></span>
                                <span class="palette__group" x-text="command.group"></span>
                            </a>
                        </li>
                    </template>
                </ul>
            </div>
        </div>
        <div class="toasts" id="toasts"></div>
    </div>

    <script nonce="{{ csp_nonce() }}">
        window.__GEREQ_COMMANDS__ = [
            {%- for command in commands|default([]) -%}
            {
                "id": {{ command.id|json_encode|raw }},
                "label": {{ command.label|trans|json_encode|raw }},
                "url": {{ command.url|json_encode|raw }},
                "icon": {{ command.icon|json_encode|raw }},
                "keywords": {{ command.keywords|json_encode|raw }},
                "group": {{ command.group|trans|json_encode|raw }}
            }{% if not loop.last %},{% endif %}
            {%- endfor -%}
        ];
        window.__GEREQ_CSRF__ = {{ csrf_token()|json_encode|raw }};
        window.__GEREQ_FORM_CLEARED__ = {{ flash('form_cleared')|json_encode|raw }};
    </script>
    <script nonce="{{ csp_nonce() }}" src="{{ asset('resources/js/admin.ts') }}"></script>
</body>
</html>
