<section class="panel">
    <header class="panel__head">
        <h2>{{ 'admin.dashboard.activity'|trans }}</h2>
        {% if show_all|default(false) %}
            <a class="btn btn--ghost btn-sm" href="{{ url('admin.audit.index') }}">{{ 'common.all'|trans|default('Vše') }}</a>
        {% endif %}
    </header>
    {% if activity is empty %}
        <div class="empty">
            <p>{{ 'empty.activity'|trans }}</p>
        </div>
    {% else %}
        <ul class="activity">
            {% for log in activity %}
                <li>
                    <div class="activity__body">
                        <span class="activity__dot" aria-hidden="true"></span>
                        <div>
                            <strong>{{ log.userName()|default('common.system'|trans) }} · {{ log.action()|audit_action }}</strong>
                            {% if log.resource() %}
                                <span class="muted">{{ log.resource() }}</span>
                            {% endif %}
                        </div>
                    </div>
                    <time class="muted">{{ log.createdAt().format('d. m. Y H:i') }}</time>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
