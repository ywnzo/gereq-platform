{% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
    {% block attributes %} class="panel panel--chart"{% endblock %}
    {% block content %}
    <header class="panel__head">
        <div>
            <h2>{{ title }}</h2>
            {% if subtitle|default('') != '' %}
                <p class="muted panel__sub">{{ subtitle }}</p>
            {% endif %}
        </div>
        {% if href|default(null) %}
            {% include 'ui/button.html.twig' with {
                label: link_label|default('common.open'|trans),
                href: (href),
                button_options: { tag: 'a' },
                variant: 'ghost',
                class: 'btn-sm'
            } only %}
        {% endif %}
    </header>
    {% if empty|default(false) %}
        <div class="empty"><p>{{ empty_message|default('empty.generic'|trans) }}</p></div>
    {% else %}
        <div
            class="dash-chart"
            x-data="gereqChart"
            data-config="{{ config|json_encode|e('html_attr') }}"
        >
            <canvas x-ref="canvas" aria-label="{{ title }}"></canvas>
        </div>
        {% if stats|default([]) is not empty %}
            <div class="dash-chart__stats">
                {% for stat in stats %}
                    <div>
                        <span class="muted">{{ stat.label }}</span>
                        <strong>{{ stat.value }}</strong>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
    {% endblock %}
{% endembed %}
