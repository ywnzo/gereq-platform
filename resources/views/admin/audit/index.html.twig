{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'admin.audit.title'|trans }}</h1>
    </header>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'common.time'|trans }}</th>
                    <th>{{ 'common.user'|trans }}</th>
                    <th>{{ 'common.action'|trans }}</th>
                    <th>{{ 'common.source'|trans }}</th>
                    <th>{{ 'common.ip'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr>
                        <td>{{ log.createdAt().format('d. m. Y H:i:s') }}</td>
                        <td>{{ log.userName() ?: 'common.system'|trans }}</td>
                        <td>{{ log.action()|audit_action }}</td>
                        <td>
                            {{ log.resource() ?: 'common.none'|trans }}
                            {% if log.oldValues() or log.newValues() %}
                                <div class="diff muted">
                                    {% for field, value in log.newValues()|default({}) %}
                                        {% set old = log.oldValues()[field]|default(null) %}
                                        {% if old is not null and old != value %}
                                            <div>{{ field }}: {{ old }} → {{ value }}</div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </td>
                        <td class="muted">{{ log.ip() }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5"><div class="empty">{{ 'empty.audit'|trans }}</div></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
