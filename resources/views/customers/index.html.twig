{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set canBulk = user.can('customers.edit') or user.can('customers.delete') %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="customers"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'customers.bulk.confirm_delete'|trans|e('html_attr') }}"
>
    <header class="page-header">
        <div>
            <h1>{{ 'customers.title'|trans }}</h1>
            <p class="muted">{{ 'customers.list.hint'|trans }}</p>
        </div>
        <div class="actions">
            {% if user.can('customers.create') %}
                <a class="btn btn--primary" href="{{ url('admin.customers.create') }}">{{ icon('plus') }} {{ 'customers.add'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'customers.search'|trans }}">
            <select name="status" class="input" onchange="this.form.submit()">
                <option value="">{{ 'common.all_statuses'|trans }}</option>
                <option value="active" {{ status == 'active' ? 'selected' : '' }}>{{ 'customers.status.active'|trans }}</option>
                <option value="lead" {{ status == 'lead' ? 'selected' : '' }}>{{ 'customers.status.lead'|trans }}</option>
                <option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>{{ 'customers.status.inactive'|trans }}</option>
                <option value="archived" {{ status == 'archived' ? 'selected' : '' }}>{{ 'customers.status.archived'|trans }}</option>
            </select>
        </form>
    </div>

    {% if canBulk and items is not empty %}
        <form
            class="bulk-bar"
            method="post"
            action="{{ url('admin.customers.bulk') }}"
            x-show="selectedCount > 0"
            x-cloak
            @submit="confirmBulk"
        >
            {{ csrf_field()|raw }}
            <input type="hidden" name="confirmed" value="1">
            <template x-for="id in selected" :key="id">
                <input type="hidden" name="ids[]" :value="id">
            </template>
            <div class="bulk-bar__meta">
                <strong x-text="selectedCount"></strong>
                <span>{{ 'customers.bulk.selected'|trans }}</span>
                <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'customers.bulk.clear'|trans }}</button>
            </div>
            <div class="bulk-bar__actions">
                <select class="input" name="action" x-model="bulkAction" required>
                    <option value="">{{ 'customers.bulk.choose'|trans }}</option>
                    {% if user.can('customers.edit') %}
                        <option value="activate">{{ 'customers.bulk.action.activate'|trans }}</option>
                        <option value="lead">{{ 'customers.bulk.action.lead'|trans }}</option>
                        <option value="deactivate">{{ 'customers.bulk.action.deactivate'|trans }}</option>
                        <option value="archive">{{ 'customers.bulk.action.archive'|trans }}</option>
                    {% endif %}
                    {% if user.can('customers.delete') %}
                        <option value="delete">{{ 'customers.bulk.action.delete'|trans }}</option>
                    {% endif %}
                </select>
                <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'customers.bulk.apply'|trans }}</button>
            </div>
        </form>
    {% endif %}

    <div class="table-wrap" data-table>
        <table class="table table--customers">
            <thead>
                <tr>
                    {% if canBulk %}
                        <th class="table__check">
                            <label class="table-check">
                                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected">
                                <span class="sr-only">{{ 'customers.bulk.select_all'|trans }}</span>
                            </label>
                        </th>
                    {% endif %}
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.name'|trans, column: 'name', query: { status: status } } %}
                    <th>{{ 'customers.col.contact'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.status'|trans, column: 'status', query: { status: status } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.created'|trans, column: 'createdAt', query: { status: status } } %}
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
                        {% if canBulk %}
                            <td class="table__check">
                                <label class="table-check">
                                    <input
                                        type="checkbox"
                                        value="{{ item.id() }}"
                                        @change="toggleId('{{ item.id() }}')"
                                        :checked="isSelected('{{ item.id() }}')"
                                    >
                                    <span class="sr-only">{{ item.name() }}</span>
                                </label>
                            </td>
                        {% endif %}
                        <td>
                            <a class="cell-user cell-user--stack" href="{{ url('admin.customers.show', {id: item.id()}) }}">
                                {% if item.avatarFileId() %}
                                    <img class="avatar avatar--sm" src="{{ url('admin.customers.avatar', {id: item.id()}) }}" alt="">
                                {% else %}
                                    <span class="avatar avatar--sm">{{ item.initials() }}</span>
                                {% endif %}
                                <span class="cell-user__text">
                                    <strong>{{ item.name() }}</strong>
                                    <small class="muted">{{ item.company() ?: '—' }}</small>
                                </span>
                            </a>
                        </td>
                        <td>
                            <div class="table__title">
                                <a href="mailto:{{ item.email() }}">{{ item.email() }}</a>
                                <span class="muted">{{ item.phone() ?: '—' }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : (item.status() == 'lead' ? 'warn' : 'muted') }}">
                                {{ item.statusLabel()|trans }}
                            </span>
                        </td>
                        <td class="is-mute">{{ item.createdAt().format('d. m. Y') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with { href: url('admin.customers.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                                {% if user.can('customers.edit') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.customers.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                {% endif %}
                                {% if user.can('customers.delete') %}
                                    {% include 'ui/row_action_destroy.html.twig' with {
                                        action: url('admin.customers.destroy', {id: item.id()}),
                                        confirm: 'customers.confirm_delete'|trans
                                    } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ canBulk ? 6 : 5 }}">
                            <div class="empty">
                                <h2>{{ 'customers.empty'|trans }}</h2>
                                <p>{{ 'customers.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
