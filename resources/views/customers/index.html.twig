{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set canBulk = user.can('customers.edit') or user.can('customers.delete') %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="customers"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'customers.bulk.confirm_delete'|trans|e('html_attr') }}"
>
    <header class="page-header">
        <div>
            <h1>{{ 'customers.title'|trans }}</h1>
            <p class="muted">{{ 'customers.list.hint'|trans }}</p>
        </div>
        <div class="actions">
            {% if user.can('customers.create') %}
                {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--primary" href="{{ url('admin.customers.create') }}"{% endblock %}{% block content %}{{ icon('plus') }} {{ 'customers.add'|trans }}{% endblock %}{% endembed %}
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        {% embed 'ui/toolbar.html.twig' with { table: false, toolbar_options: { tag: 'form' } } %}{% block component_attributes %} class="toolbar" method="get"{% endblock %}{% block content %}
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'customers.search'|trans }}"{% endblock %}{% endembed %}
            {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} name="status" class="input" onchange="this.form.submit()"{% endblock %}{% block native_options %}
                {% include 'ui/option.html.twig' with { value: '', label: 'common.all_statuses'|trans } only %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="active" {{ status == 'active' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'customers.status.active'|trans }}{% endblock %}{% endembed %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="lead" {{ status == 'lead' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'customers.status.lead'|trans }}{% endblock %}{% endembed %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="inactive" {{ status == 'inactive' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'customers.status.inactive'|trans }}{% endblock %}{% endembed %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="archived" {{ status == 'archived' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'customers.status.archived'|trans }}{% endblock %}{% endembed %}
            {% endblock %}{% endembed %}
            {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} name="erasure" class="input" onchange="this.form.submit()"{% endblock %}{% block native_options %}
                {% include 'ui/option.html.twig' with { value: '', label: 'customers.erasure.filter.all'|trans } only %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="1" {{ erasure == '1' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'customers.erasure.filter'|trans }}{% endblock %}{% endembed %}
            {% endblock %}{% endembed %}
        {% endblock %}{% endembed %}
    </div>

    {% if canBulk and items is not empty %}
        {% embed 'ui/bulk_bar.html.twig' with { bulk_options: { preserve: true, tag: 'form' } } %}{% block component_attributes %}
            class="bulk-bar"
            method="post"
            action="{{ url('admin.customers.bulk') }}"
            x-show="selectedCount > 0"
            x-cloak
            @submit="confirmBulk"
        {% endblock %}{% block content %}
            {{ csrf_field()|raw }}
            <input type="hidden" name="confirmed" value="1">
            <template x-for="id in selected" :key="id">
                <input type="hidden" name="ids[]" :value="id">
            </template>
            <div class="bulk-bar__meta">
                <strong x-text="selectedCount"></strong>
                <span>{{ 'customers.bulk.selected'|trans }}</span>
                {% include 'ui/button.html.twig' with {
                    label: 'customers.bulk.clear'|trans,
                    type: 'button',
                    variant: 'link',
                    class: 'btn-sm',
                    attrs: { '@click': 'clearSelection' }
                } only %}
            </div>
            <div class="bulk-bar__actions">
                {% embed 'ui/select.html.twig' with { native: true } %}{% block root_attributes %}:data-native-value="bulkAction" {% endblock %}{% block native_attributes %} class="input" name="action" x-model="bulkAction" required{% endblock %}{% block native_options %}
                    {% include 'ui/option.html.twig' with { value: '', label: 'customers.bulk.choose'|trans } only %}
                    {% if user.can('customers.edit') %}
                        {% include 'ui/option.html.twig' with { value: 'activate', label: 'customers.bulk.action.activate'|trans } only %}
                        {% include 'ui/option.html.twig' with { value: 'lead', label: 'customers.bulk.action.lead'|trans } only %}
                        {% include 'ui/option.html.twig' with { value: 'deactivate', label: 'customers.bulk.action.deactivate'|trans } only %}
                        {% include 'ui/option.html.twig' with { value: 'archive', label: 'customers.bulk.action.archive'|trans } only %}
                    {% endif %}
                    {% if user.can('customers.delete') %}
                        {% include 'ui/option.html.twig' with { value: 'delete', label: 'customers.bulk.action.delete'|trans } only %}
                    {% endif %}
                {% endblock %}{% endembed %}
                {% include 'ui/button.html.twig' with {
                    label: 'customers.bulk.apply'|trans,
                    type: 'submit',
                    variant: 'primary',
                    attrs: { ':disabled': '!bulkAction' }
                } only %}
            </div>
        {% endblock %}{% endembed %}
    {% endif %}

    <div class="table-wrap" data-table>
        <table class="table table--customers">
            <thead>
                <tr>
                    {% if canBulk %}
                        <th class="table__check">
                            <label class="table-check">
                                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected"{% endblock %}{% endembed %}
                                <span class="sr-only">{{ 'customers.bulk.select_all'|trans }}</span>
                            </label>
                        </th>
                    {% endif %}
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.name'|trans, column: 'name', query: { status: status, erasure: erasure } } %}
                    <th>{{ 'customers.col.contact'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.status'|trans, column: 'status', query: { status: status, erasure: erasure } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.created'|trans, column: 'createdAt', query: { status: status, erasure: erasure } } %}
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
                        {% if canBulk %}
                            <td class="table__check">
                                <label class="table-check">
                                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                                        type="checkbox"
                                        value="{{ item.id() }}"
                                        @change="toggleId('{{ item.id() }}')"
                                        :checked="isSelected('{{ item.id() }}')"
                                    {% endblock %}{% endembed %}
                                    <span class="sr-only">{{ item.name() }}</span>
                                </label>
                            </td>
                        {% endif %}
                        <td>
                            <a class="cell-user cell-user--stack" href="{{ url('admin.customers.show', {id: item.id()}) }}">
                                {% if item.avatarFileId() %}
                                    <img class="avatar avatar--sm" src="{{ url('admin.customers.avatar', {id: item.id()}) }}" alt="">
                                {% else %}
                                    <span class="avatar avatar--sm">{{ item.initials() }}</span>
                                {% endif %}
                                <span class="cell-user__text">
                                    <strong>{{ item.name() }}</strong>
                                    <small class="muted">{{ item.company() ?: '—' }}</small>
                                </span>
                            </a>
                        </td>
                        <td>
                            <div class="table__title">
                                <a href="mailto:{{ item.email() }}">{{ item.email() }}</a>
                                <span class="muted">{{ item.phone() ?: '—' }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : (item.status() == 'lead' ? 'warn' : 'muted') }}">
                                {{ item.statusLabel()|trans }}
                            </span>
                            {% if item.erasureRequestedAt() %}
                                <span class="badge badge--warn">{{ 'customers.erasure.requested'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="is-mute">{{ item.createdAt().format('d. m. Y') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with { href: url('admin.customers.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                                {% if user.can('customers.edit') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.customers.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                {% endif %}
                                {% if user.can('customers.delete') %}
                                    {% include 'ui/row_action_destroy.html.twig' with {
                                        action: url('admin.customers.destroy', {id: item.id()}),
                                        confirm: 'customers.confirm_delete'|trans
                                    } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ canBulk ? 6 : 5 }}">
                            <div class="empty">
                                <h2>{{ (erasure == '1' ? 'customers.erasure.empty' : 'customers.empty')|trans }}</h2>
                                <p>{{ (erasure == '1' ? 'customers.erasure.empty.hint' : 'customers.empty.hint')|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
