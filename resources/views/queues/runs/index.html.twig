{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell">
    <header class="page-header">
        <div>
            <h1>{{ 'queues.runs.title'|trans }}</h1>
            <p class="muted">{{ 'queues.runs.subtitle'|trans }}</p>
        </div>
        <div class="actions queues-head">
            {% embed 'ui/status_chip.html.twig' %}{% block component_attributes %} class="status-chip queues-status queues-status--{{ health.tone() }}"{% endblock %}{% block chip_content %}
                <span class="status-chip__dot"></span>
                {{ ('queues.status.' ~ health.status)|trans }}
            {% endblock %}{% endembed %}
            <dl class="queues-figures" aria-label="{{ 'queues.schedule.figures'|trans }}">
                <div>
                    <dt>{{ 'queues.figure.depth'|trans }}</dt>
                    <dd>{% if pending is null %}<span class="queues-figures__unknown">—</span>{% else %}{{ pending }}{% endif %}</dd>
                </div>
                <div>
                    <dt>{{ 'queues.figure.delayed'|trans }}</dt>
                    <dd>{% if delayed is null %}<span class="queues-figures__unknown">—</span>{% else %}{{ delayed }}{% endif %}</dd>
                </div>
            </dl>
        </div>
    </header>

    <div class="toolbar--table">
        {% embed 'ui/toolbar.html.twig' with { table: false, toolbar_options: { tag: 'form' } } %}{% block component_attributes %} class="toolbar queues-filters" method="get"{% endblock %}{% block content %}
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                class="input"
                type="search"
                name="q"
                value="{{ search|default('') }}"
                placeholder="{{ 'queues.runs.search'|trans }}"
                aria-label="{{ 'queues.runs.search'|trans }}"
            /{% endblock %}{% endembed %}
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                class="input"
                type="text"
                name="job"
                value="{{ job|default('') }}"
                placeholder="{{ 'queues.runs.filter_job'|trans }}"
                aria-label="{{ 'queues.runs.filter_job'|trans }}"
            /{% endblock %}{% endembed %}
            {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} class="input" name="status" aria-label="{{ 'queues.runs.filter_status'|trans }}"{% endblock %}{% block native_options %}
                {% include 'ui/option.html.twig' with { value: '', label: 'queues.runs.filter_status'|trans } only %}
                {% for s in ['success', 'failed', 'skipped'] %}
                    {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="{{ s }}"{% if status == s %} selected{% endif %}{% endblock %}{% block content %}{{ ('queues.runs.status.' ~ s)|trans }}{% endblock %}{% endembed %}
                {% endfor %}
            {% endblock %}{% endembed %}
            {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} class="input" name="trigger" aria-label="{{ 'queues.runs.filter_trigger'|trans }}"{% endblock %}{% block native_options %}
                {% include 'ui/option.html.twig' with { value: '', label: 'queues.runs.filter_trigger'|trans } only %}
                {% for t in ['worker', 'sync', 'schedule', 'manual'] %}
                    {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="{{ t }}"{% if trigger == t %} selected{% endif %}{% endblock %}{% block content %}{{ ('queues.runs.trigger.' ~ t)|trans }}{% endblock %}{% endembed %}
                {% endfor %}
            {% endblock %}{% endembed %}
            {% include 'ui/button.html.twig' with { label: 'common.search'|trans, type: 'submit', variant: 'ghost' } only %}
            {% if search is not empty or job is not empty or status is not empty or trigger is not empty %}
                {% include 'ui/button.html.twig' with {
                    label: 'queues.list.reset'|trans,
                    href: (url('admin.queues.runs')),
                    button_options: { tag: 'a' },
                    variant: 'ghost'
                } only %}
            {% endif %}
        {% endblock %}{% endembed %}
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    {% include 'ui/sort_th.html.twig' with {
                        label: 'queues.runs.field.started'|trans,
                        column: 'startedAt',
                        sort: sort|default('startedAt'),
                        dir: dir|default('desc'),
                        search: search|default(''),
                    } %}
                    {% include 'ui/sort_th.html.twig' with {
                        label: 'queues.field.job'|trans,
                        column: 'job',
                        sort: sort|default('startedAt'),
                        dir: dir|default('desc'),
                        search: search|default(''),
                    } %}
                    <th>{{ 'queues.runs.field.status'|trans }}</th>
                    <th>{{ 'queues.runs.field.trigger'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with {
                        label: 'queues.runs.field.duration'|trans,
                        column: 'durationMs',
                        sort: sort|default('startedAt'),
                        dir: dir|default('desc'),
                        search: search|default(''),
                    } %}
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td class="muted">{{ item.startedAt().format('d. m. Y H:i:s') }}</td>
                        <td>
                            <code>{{ item.job() }}</code>
                            {% if item.exception() and item.status() == 'failed' %}
                                <div class="muted grq-text-meta queues-error">{{ item.exception()|split('\n')|first }}</div>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'success' ? 'success' : (item.status() == 'failed' ? 'danger' : 'warn') }}">
                                {{ ('queues.runs.status.' ~ item.status())|trans }}
                            </span>
                        </td>
                        <td class="muted">{{ ('queues.runs.trigger.' ~ item.trigger())|trans }}</td>
                        <td class="muted">{{ item.durationMs() }} ms</td>
                        <td class="table__actions">
                            <div class="table__action-btns">
                                {% include 'ui/row_action.html.twig' with {
                                    href: url('admin.queues.runs.show', { id: item.id() }),
                                    label: 'queues.action.detail'|trans,
                                    icon: 'eye',
                                } %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="muted">{{ 'queues.runs.empty'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
