{% extends 'admin/layout.html.twig' %}

{% block content %}
    {% set maxAttempts = maxAttempts|default(1) %}
    {% set exhausted = item.attempts() >= maxAttempts %}
    {% set headline = item.exception()|split("\n")|first %}

    <header class="page-header">
        <div>
            <h1><code>{{ item.job()|default('queues.failed.unreadable'|trans) }}</code></h1>
            <p class="muted detail-layout__meta">
                <span class="badge badge--{{ exhausted ? 'danger' : 'warn' }}">
                    {{ exhausted ? 'queues.detail.exhausted'|trans : 'queues.detail.retrying'|trans }}
                </span>
                {{ item.failedAt().format('d. m. Y H:i:s') }}
                · {{ item.queue() }}
                · {{ item.attempts() }}/{{ maxAttempts }} {{ 'queues.field.attempts'|trans|lower }}
            </p>
        </div>
        <div class="actions">
            <a href="{{ url('admin.queues.index') }}" class="btn btn--ghost">
                {{ 'queues.action.back'|trans }}
            </a>
            {% if user.can('queues.manage') %}
                <form method="post" action="{{ url('admin.queues.retry', {id: item.id()}) }}">
                    {{ csrf_field()|raw }}
                    <button
                        type="submit"
                        class="btn"
                        {% if not exhausted %}
                            disabled
                            title="{{ 'queues.detail.retry_locked'|trans({
                                '%attempts%': item.attempts(), '%max%': maxAttempts
                            })|e('html_attr') }}"
                        {% else %}
                            data-confirm="{{ 'queues.retry.confirm'|trans({'%job%': item.job()})|e('html_attr') }}"
                        {% endif %}
                    >{{ 'queues.action.retry'|trans }}</button>
                </form>
                <form method="post" action="{{ url('admin.queues.forget', {id: item.id()}) }}">
                    {{ csrf_field()|raw }}
                    <button
                        type="submit"
                        class="btn btn--ghost"
                        data-confirm="{{ 'queues.forget.confirm'|trans|e('html_attr') }}"
                        data-confirm-danger="1"
                    >{{ 'queues.action.forget'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="detail-layout">
        <div class="detail-layout__main">
            <section class="detail-hero panel">
                <div class="detail-hero__body">
                    <div class="detail-hero__highlight">
                        <span>{{ 'queues.detail.error'|trans }}</span>
                        <strong>{{ headline }}</strong>
                    </div>
                    <dl class="detail-hero__facts">
                        <div>
                            <dt>{{ 'queues.field.queue'|trans }}</dt>
                            <dd>{{ item.queue() }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'queues.field.attempts'|trans }}</dt>
                            <dd>{{ item.attempts() }} / {{ maxAttempts }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'queues.field.time'|trans }}</dt>
                            <dd>{{ item.failedAt().format('d. m. Y H:i:s') }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'queues.detail.payload_size'|trans }}</dt>
                            <dd>{{ item.payload()|length|number_format }} B</dd>
                        </div>
                    </dl>
                </div>
            </section>

            <section class="panel">
                <header class="panel__head"><h2>{{ 'queues.detail.error'|trans }}</h2></header>
                <pre class="queues-trace">{{ item.exception() }}</pre>
            </section>

            <section class="panel">
                <header class="panel__head"><h2>{{ 'queues.detail.payload'|trans }}</h2></header>
                <p class="queues-trace__hint muted">{{ 'queues.detail.payload_hint'|trans }}</p>
                <pre class="queues-trace">{{ item.payload() }}</pre>
            </section>
        </div>

        <aside class="detail-layout__aside">
            <section class="panel">
                <header class="panel__head"><h2>{{ 'queues.detail.overview'|trans }}</h2></header>
                <dl class="meta-list meta-list--flush detail-layout__specs">
                    <div class="meta-list__full">
                        <dt>{{ 'queues.field.id'|trans }}</dt>
                        <dd><code>{{ item.id() }}</code></dd>
                    </div>
                    {% if item.uuid() is not empty %}
                        <div class="meta-list__full">
                            <dt>{{ 'queues.field.uuid'|trans }}</dt>
                            <dd><code>{{ item.uuid() }}</code></dd>
                        </div>
                    {% endif %}
                    <div class="meta-list__full">
                        <dt>{{ 'queues.field.job'|trans }}</dt>
                        <dd><code>{{ item.job()|default('—') }}</code></dd>
                    </div>
                </dl>
            </section>
        </aside>
    </div>
{% endblock %}