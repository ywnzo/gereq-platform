{% set faviconHref = brand('favicon_url') %}
{% set faviconPath = faviconHref|split('?')|first|lower %}
{% set faviconType = faviconPath ends with '.svg' ? 'image/svg+xml'
    : (faviconPath ends with '.ico' ? 'image/x-icon'
    : (faviconPath ends with '.webp' ? 'image/webp'
    : (faviconPath ends with '.gif' ? 'image/gif' : 'image/png'))) %}
<link rel="icon" href="{{ faviconHref }}" type="{{ faviconType }}">

<link rel="preconnect" href="https://fonts.bunny.net">
<link href="https://fonts.bunny.net/css?family=ibm-plex-sans:400,450,500,600,700|dm-sans:400,500,600,700|space-grotesk:500,600,700|jetbrains-mono:400,500|material-symbols-outlined" rel="stylesheet"{% if csp_nonce() %} nonce="{{ csp_nonce() }}"{% endif %}>
<script nonce="{{ csp_nonce() }}">
    (function () {
        var stored = localStorage.getItem('gereq-theme') || 'dark';
        var dark = stored === 'dark' || (stored === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.dataset.theme = dark ? 'gereq-dark' : 'gereq';
    })();
</script>
