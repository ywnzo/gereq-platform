{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="notifications" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'notifications.title'|trans }}</h1>
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.notifications.preferences') }}">{{ 'notifications.preferences.title'|trans }}</a>
            <form method="post" action="{{ url('admin.notifications.read_all') }}">
                {{ csrf_field()|raw }}
                <button class="btn btn--primary" type="submit">{{ 'notifications.mark_all_read'|trans }}</button>
            </form>
        </div>
    </header>
    <p class="muted">{{ 'notifications.unread_count'|trans({'%count%': unread}) }}</p>

    <div class="toolbar--table">
        <div class="toolbar"></div>
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'notifications.col.title'|trans }}</th>
                    <th>{{ 'notifications.col.time'|trans }}</th>
                    <th>{{ 'common.status'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    {% set data = item.data() %}
                    {% set target = data.meta.url|default(null) %}
                    <tr>
                        <td>
                            {% if target %}
                                <a href="{{ target }}">
                                    <strong>{{ data.title|default(item.type()) }}</strong>
                                </a>
                            {% else %}
                                <strong>{{ data.title|default(item.type()) }}</strong>
                            {% endif %}
                            <div class="muted">{{ data.body|default('') }}</div>
                        </td>
                        <td>{{ item.createdAt()|date('d. m. Y H:i') }}</td>
                        <td>{{ item.readAt() ? 'notifications.status.read'|trans : 'notifications.status.unread'|trans }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if not item.readAt() %}
                                    <form method="post" action="{{ url('admin.notifications.read', {id: item.id()}) }}">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'notifications.mark_read'|trans }}</button>
                                    </form>
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr><td colspan="4">{{ 'notifications.empty'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
