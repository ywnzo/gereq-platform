{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.settings'|trans, url: url('admin.settings.index') },
        { label: 'settings.group.core'|trans, url: url('admin.settings.index', {tab: 'core'}) },
        { label: item ? 'currency.edit'|trans : 'currency.new'|trans },
    ] } %}
{% endblock %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'currency.edit'|trans : 'currency.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'currency.save' } %}

    <form method="post" class="detail-stack" action="{{ item ? url('admin.currencies.update', {code: item.code()}) : url('admin.currencies.store') }}" data-form="currency.save" x-data="gereqForm"{% if form_errors('currency.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <h2>{{ 'common.details'|trans }}</h2>
            </header>
            {{ forms().render(item ?? 'Gereq\\Currency\\Domain\\Currency', {
                form: 'currency.save',
                cols: 1,
                fieldOptions: item ? { code: { readonly: true } } : {},
                values: item ? {} : { decimal_places: 2, is_active: true, is_default: false }
            }) }}
            {% endblock %}
        {% endembed %}
        <div class="form-actions">
            {% include 'ui/button.html.twig' with { label: 'common.save'|trans, type: 'submit', variant: 'primary' } only %}
            {% include 'ui/button.html.twig' with {
                label: 'common.cancel'|trans,
                href: (url('admin.settings.index', {tab: 'core'})) ~ '#settings-currencies',
                button_options: { tag: 'a' },
                variant: 'ghost'
            } only %}
        </div>
    </form>
{% endblock %}
