{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.settings'|trans, url: url('admin.settings.index') },
        { label: 'settings.group.core'|trans, url: url('admin.settings.index', {tab: 'core'}) },
        { label: 'currency.title'|trans },
    ] } %}
{% endblock %}

{% block content %}
<div class="list-shell detail-stack">
    {% include 'currency/partials/manage.html.twig' with { items: items, rates: rates, tableHtml: tableHtml, embedded: false } %}
</div>
{% include 'currency/partials/manage_forms.html.twig' with { items: items } %}
{% endblock %}
