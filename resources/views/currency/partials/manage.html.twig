{#
  Currencies + CNB rates management block.
  Used in Settings → Platform and on /admin/currencies.
  Vars: items, rates, tableHtml, embedded? (bool)
#}
{% set embedded = embedded|default(false) %}
{% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
    {% block attributes %} class="panel" id="settings-currencies"{% if not embedded %} style="margin:0"{% endif %}{% endblock %}
    {% block content %}
    <header class="panel__head panel__head--actions">
        <div>
            <h2>{{ 'currency.title'|trans }}</h2>
            <p class="muted">{{ 'currency.subtitle'|trans }}</p>
        </div>
        {% if user.can('currency.manage') %}
            <div class="actions">
                {% include 'ui/button.html.twig' with {
                    label: 'currency.sync_cnb'|trans,
                    type: 'submit',
                    variant: 'ghost',
                    attrs: { 'form': 'currency-sync-form' }
                } only %}
                {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--primary" href="{{ url('admin.currencies.create') }}"{% endblock %}{% block content %}{{ icon('plus') }} {{ 'currency.add'|trans }}{% endblock %}{% endembed %}
            </div>
        {% endif %}
    </header>

    {{ tableHtml|raw }}
    {% endblock %}
{% endembed %}

{% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
    {% block attributes %} class="panel"{% endblock %}
    {% block content %}
    <header class="panel__head">
        <div>
            <h2>{{ 'currency.rates.title'|trans }}</h2>
        </div>
    </header>
    {% if rates is empty %}
        <div class="empty">
            <h2>{{ 'currency.rates.empty'|trans }}</h2>
            <p>{{ 'currency.rates.empty.hint'|trans }}</p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'currency.rates.pair'|trans }}</th>
                        <th>{{ 'currency.rates.rate'|trans }}</th>
                        <th>{{ 'currency.rates.provider'|trans }}</th>
                        <th>{{ 'currency.rates.valid_at'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rate in rates %}
                        <tr>
                            <td><strong>{{ rate.base }}/{{ rate.quote }}</strong></td>
                            <td><code>{{ rate.rate }}</code></td>
                            <td><span class="badge">{{ rate.provider }}</span></td>
                            <td class="muted">{{ rate.valid_at }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    {% endblock %}
{% endembed %}
