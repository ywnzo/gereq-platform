<label class="field">
    <span>{{ 'profile.currency'|trans }}</span>
    {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} name="preferred_currency"{% endblock %}{% block native_options %}
        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="_default" {{ selected is null ? 'selected' : '' }}{% endblock %}{% block content %}
            {{ 'profile.currency.default'|trans({'%code%': shop_default}) }}
        {% endblock %}{% endembed %}
        {% for code in currencies %}
            {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="{{ code }}" {{ selected == code ? 'selected' : '' }}{% endblock %}{% block content %}{{ code }}{% endblock %}{% endembed %}
        {% endfor %}
    {% endblock %}{% endembed %}
</label>

{% if can_manage_vat %}
    <label class="field">
        <span class="field__label">{{ 'profile.vat_payer'|trans }}</span>
        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="currency_vat_payer" value="1" {{ vat_payer ? 'checked' : '' }}{% endblock %}{% endembed %}
    </label>
    <p class="muted">{{ 'profile.vat_payer.hint'|trans }}</p>
    <label class="field">
        <span>{{ 'profile.vat_rate'|trans }}</span>
        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="number" name="currency_vat_rate" value="{{ vat_rate }}" min="0" max="100" step="0.01"{% endblock %}{% endembed %}
    </label>
{% endif %}
