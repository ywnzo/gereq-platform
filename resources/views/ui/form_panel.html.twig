{# Standard admin form panel — wrap forms().render / field blocks.
   Usage:
     {% embed 'ui/form_panel.html.twig' with { title: '…'|trans } %}
       {% block body %}
         {{ forms().render(...) }}
       {% endblock %}
     {% endembed %}
#}
{% extends 'ui/panel.html.twig' %}

{% block attributes %} class="panel"{% endblock %}
{% block content %}
    {% if title|default(null) %}
        <header class="panel__head">
            <h2>{{ title }}</h2>
        </header>
    {% endif %}
    {% block body %}{% endblock %}
{% endblock %}
