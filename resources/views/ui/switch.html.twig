{% set name = name|default('') %}
{% set id = id|default('f-' ~ name) %}
{% set label = label|default('') %}
{% set description = description|default('') %}
{% set hint = hint|default('') %}
{% set form = form|default(null) %}
{% set on = old(name, on|default(checked|default(false)), form) %}
{% set err = err|default(error(name, form)) %}
{% set extra = extra|default('') %}
{% set onBool = on is same as(true) or on is same as(1) or on is same as('1') or on is same as('on') %}

{# Same layout as input/select: label on top → control aligned with neighboring fields #}
<div class="g-field g-field--switch{% if err %} is-invalid{% endif %} {{ extra }}" data-field="{{ name }}">
    {% if label %}
        <span class="g-label" id="{{ id }}-label">
            <span>{{ label }}</span>
        </span>
    {% endif %}
    <div
        class="g-switch"
        x-data="gereqSwitch"
        data-on="{{ onBool ? '1' : '0' }}"
    >
        <input type="hidden" name="{{ name }}" value="{{ onBool ? '1' : '0' }}" x-ref="value">
        <button
            id="{{ id }}"
            type="button"
            class="table-switch{{ onBool ? ' is-on' : '' }}"
            :class="onClass"
            role="switch"
            :aria-checked="checkedAttr"
            {% if label %}aria-labelledby="{{ id }}-label"{% endif %}
            @click="toggle"
        >
            <span class="table-switch__knob" aria-hidden="true"></span>
        </button>
        {% if description %}<p class="g-switch__desc">{{ description }}</p>{% endif %}
    </div>
    {% if hint %}<p class="g-hint">{{ hint }}</p>{% endif %}
    {% if err %}<p class="g-error">{{ err }}</p>{% endif %}
</div>
