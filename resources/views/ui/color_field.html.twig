{% set name = name|default('') %}
{% set id = id|default('f-' ~ name) %}
{% set label = label|default('') %}
{% set hint = hint|default('') %}
{% set form = form|default(null) %}
{% set value = old(name, value|default(''), form) %}
{% if value is empty %}{% set value = name == 'tint' ? '#f7f9fa' : '#526877' %}{% endif %}
{% set err = error(name, form) %}
{% set extra = extra|default('') %}
{% set colorHex = value|replace({'#': ''}) %}
{% set described = [] %}
{% if hint %}{% set described = described|merge([id ~ '-hint']) %}{% endif %}
{% if err %}{% set described = described|merge([id ~ '-error']) %}{% endif %}

<div class="g-field{% if err %} is-invalid{% endif %} {{ extra }}" data-field="{{ name }}">
    {% if label %}
        <span class="g-label" id="{{ id }}-label">
            <span>{{ label }}</span>
        </span>
    {% endif %}
    <div class="color-picker" x-data="gereqColorField" data-value="{{ value }}">
        <input type="hidden" name="{{ name }}" id="{{ id }}" value="{{ value }}" data-color-value>
        <div class="color-picker__row">
            <label class="color-picker__chip">
                <input type="color" class="color-picker__native" value="{{ value }}" aria-label="{{ label }}">
                <span class="color-picker__chip-face" style="background: {{ value }}"></span>
            </label>
            <div class="color-picker__hex-field">
                <span class="color-picker__hash">#</span>
                <input
                    class="color-picker__hex-input"
                    type="text"
                    maxlength="6"
                    value="{{ colorHex }}"
                    spellcheck="false"
                    autocomplete="off"
                    aria-label="HEX"
                >
            </div>
            <button type="button" class="color-picker__more" @click="toggle" :aria-expanded="open ? 'true' : 'false'" title="{{ 'ui.color.presets'|trans }}">
                {{ icon('palette') }}
            </button>
        </div>
        <div class="color-picker__panel" x-show="open" x-cloak role="listbox" aria-label="{{ 'ui.color.presets'|trans }}">
            <p class="color-picker__panel-label">{{ 'ui.color.presets'|trans }}</p>
            <div class="color-picker__presets">
                <template x-for="preset in presets" :key="preset">
                    <button
                        type="button"
                        class="color-picker__preset"
                        role="option"
                        :class="isPreset(preset) ? 'is-active' : ''"
                        :style="presetStyle(preset)"
                        :title="preset"
                        @click="pick(preset)"
                    >
                        <span class="color-picker__preset-check" :style="checkOn(preset)" aria-hidden="true">{{ icon('check') }}</span>
                    </button>
                </template>
            </div>
        </div>
    </div>
    {% if hint %}<p class="g-hint" id="{{ id }}-hint">{{ hint }}</p>{% endif %}
    {% if err %}<p class="g-error" id="{{ id }}-error">{{ err }}</p>{% endif %}
</div>
