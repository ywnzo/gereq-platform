{% set name = name|default('') %}
{% set id = id|default('f-' ~ name) %}
{% set label = label|default('') %}
{% set hint = hint|default('') %}
{% set form = form|default(null) %}
{% set value = old(name, value|default(''), form) %}
{% set err = error(name, form) %}
{% set required = field_required(name, form, required is defined ? required : null, requiredFields|default(null), entity|default(null)) %}
{% set optional = optional|default(false) %}
{% set extra = extra|default('') %}
{% set placeholder = placeholder|default('ui.select.placeholder'|trans) %}
{% set options = options|default([]) %}
{% set searchable = searchable|default(false) %}
{% set autosubmit = autosubmit|default(false) %}
{% set empty_label = empty_label|default('ui.select.empty'|trans) %}
{% set described = [] %}
{% if hint and not err %}{% set described = described|merge([id ~ '-hint']) %}{% endif %}
{% if err %}{% set described = described|merge([id ~ '-error']) %}{% endif %}

<div class="g-field{% if err %} is-invalid{% endif %} {{ extra }}" data-field="{{ name }}">
    {% if label %}
        <span class="g-label" id="{{ id }}-label">
            <span>{{ label }}{% if optional %} <span class="g-optional">({{ 'common.optional'|trans }})</span>{% endif %}{% if required %} <span class="g-req" aria-hidden="true">*</span>{% endif %}</span>
        </span>
    {% endif %}
    <div
        class="g-select{% if searchable %} g-select--search{% endif %}"
        x-data="gereqSelect"
        data-placeholder="{{ placeholder }}"
        {% if searchable %}data-searchable="1"{% endif %}
        {% if autosubmit %}data-autosubmit="1"{% endif %}
    >
        <input type="hidden" name="{{ name }}" id="{{ id }}" value="{{ value }}" {% if required %}required{% endif %} x-ref="value">
        <button
            type="button"
            class="g-control g-select__trigger"
            :class="triggerClass"
            aria-haspopup="listbox"
            :aria-expanded="expandedAttr"
            {% if label %}aria-labelledby="{{ id }}-label"{% else %}aria-label="{{ placeholder }}"{% endif %}
            {% if err %}aria-invalid="true"{% endif %}
            {% if described %}aria-describedby="{{ described|join(' ') }}"{% endif %}
        >
            <span class="g-select__dot" :class="dotClass" aria-hidden="true"></span>
            <span class="g-select__label" x-text="label"></span>
            <span class="g-select__chevron" aria-hidden="true"></span>
        </button>
        <div class="g-select__list" :class="listClass" role="listbox" tabindex="-1">
            {% if searchable %}
                <div class="g-select__search">
                    <input
                        type="search"
                        class="g-select__search-input"
                        placeholder="{{ 'ui.select.search'|trans }}"
                        autocomplete="off"
                    >
                </div>
            {% endif %}
            <ul class="g-select__options">
                {% for option in options %}
                    {% set optValue = option.value is defined ? option.value : option %}
                    {% set optLabelRaw = option.label is defined ? option.label : option %}
                    {% set optLabel = optLabelRaw|trans %}
                    {% set optDesc = option.description|default('') %}
                    {% set optDescLabel = optDesc ? optDesc|trans : '' %}
                    {% set optTone = option.tone|default('') %}
                    {% set optSearch = option.search|default(optLabel ~ ' ' ~ optDescLabel) %}
                    <li
                        class="g-select__option{% if optValue == value %} is-selected{% endif %}"
                        role="option"
                        data-value="{{ optValue }}"
                        data-label="{{ optLabel }}"
                        data-search="{{ optSearch }}"
                        {% if optTone %}data-tone="{{ optTone }}"{% endif %}
                        {% if optValue == value %}data-selected="1"{% endif %}
                    >
                        {% if optTone %}
                            <span class="g-select__dot g-select__dot--{{ optTone }}" aria-hidden="true"></span>
                        {% endif %}
                        <span class="g-select__option-text">
                            <span>{{ optLabel }}</span>
                            {% if optDescLabel %}<span class="g-select__option-desc">{{ optDescLabel }}</span>{% endif %}
                        </span>
                    </li>
                {% endfor %}
                {% if searchable %}
                    <li class="g-select__option g-select__option--empty" data-empty="1" hidden>
                        <span class="g-select__option-text"><span class="muted">{{ empty_label }}</span></span>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
    {% if hint %}
        <p class="g-hint" id="{{ id }}-hint">{{ hint }}</p>
    {% endif %}
    {% if err %}
        <p class="g-error" id="{{ id }}-error">{{ err }}</p>
    {% endif %}
</div>
