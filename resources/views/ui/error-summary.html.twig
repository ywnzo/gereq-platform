{% set form_id = form|default(null) %}
{% set bag = errors(form_id) %}
{% if bag %}
    <div class="g-summary" role="alert" tabindex="-1" id="form-errors">
        <p class="g-summary__kicker">{{ bag|length }} {{ bag|length == 1 ? 'pole vyžaduje' : 'polí vyžaduje' }} úpravu</p>
        <p class="g-summary__title">Opravte vyznačená pole a odešlete formulář znovu.</p>
        <ul class="g-summary__list">
            {% for field, message in bag %}
                <li>
                    <a href="#f-{{ field }}">{{ message }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
