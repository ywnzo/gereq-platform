{% set form_id = form|default(null) %}
{% set bag = errors(form_id) %}
{% if bag %}
    <div class="g-summary" role="alert" tabindex="-1" id="form-errors">
        <p class="g-summary__kicker">{{ (bag|length == 1 ? 'ui.error_summary.one' : 'ui.error_summary.many')|trans({'%count%': bag|length}) }}</p>
        <p class="g-summary__title">{{ 'ui.error_summary.title'|trans }}</p>
        <ul class="g-summary__list">
            {% for field, message in bag %}
                <li>
                    <a href="#f-{{ field }}">{{ message }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
