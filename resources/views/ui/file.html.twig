{% set name = name|default('file') %}
{% set id = id|default('f-' ~ name) %}
{% set label = label|default('ui.file.label'|trans) %}
{% set hint = hint|default('ui.file.hint'|trans) %}
{% set title = title|default('ui.file.drop'|trans) %}
{% set extra = extra|default('') %}
{% set form = form|default(null) %}
{% set err = error(name, form) %}
{% set required = required|default(false) %}
{% set optional = optional|default(false) %}
{% set accept = accept|default('') %}
{% set multiple = multiple|default(false) %}
{% set capture = capture|default('') %}
{% set compact = compact|default(false) %}
{% set described = [] %}
{% if hint and not err %}{% set described = described|merge([id ~ '-hint']) %}{% endif %}
{% if err %}{% set described = described|merge([id ~ '-error']) %}{% endif %}

<div class="g-field{% if err %} is-invalid{% endif %} {{ extra }}" data-field="{{ name }}">
    {% if label %}
        <span class="g-label" id="{{ id }}-label">
            <span>{{ label }}{% if optional %} <span class="g-optional">({{ 'common.optional'|trans }})</span>{% endif %}{% if required %} <span class="g-req" aria-hidden="true">*</span>{% endif %}</span>
        </span>
    {% endif %}
    <div
        class="g-file{% if compact %} g-file--compact{% endif %}"
        x-data="gereqFile"
        data-drop-title="{{ title|e('html_attr') }}"
        data-drop-hint="{{ hint|e('html_attr') }}"
    >
        <input
            class="g-file__input"
            id="{{ id }}"
            type="file"
            name="{{ name }}{% if multiple %}[]{% endif %}"
            {% if accept %}accept="{{ accept }}"{% endif %}
            {% if multiple %}multiple{% endif %}
            {% if capture %}capture="{{ capture }}"{% endif %}
            {% if required %}required{% endif %}
            {% if label %}aria-labelledby="{{ id }}-label"{% endif %}
            {% if err %}aria-invalid="true"{% endif %}
            {% if described %}aria-describedby="{{ described|join(' ') }}"{% endif %}
        >
        <div class="g-file__shell" :class="boxClass">
            <label class="g-file__box" for="{{ id }}">
                <span class="g-file__icon" aria-hidden="true">{{ icon(compact ? 'upload' : 'cloud-upload') }}</span>
                <span class="g-file__copy">
                    <span class="g-file__title" x-text="titleText">{{ title }}</span>
                    <span class="g-file__meta" x-text="metaText">{{ hint }}</span>
                </span>
                <span class="g-file__browse">{{ 'ui.file.browse'|trans }}</span>
            </label>
            <button
                type="button"
                class="g-file__clear"
                data-file-clear
                x-show="hasFile"
                x-cloak
                aria-label="{{ 'ui.file.clear'|trans }}"
                title="{{ 'ui.file.clear'|trans }}"
            >{{ icon('close') }}</button>
        </div>
    </div>
    {% if err %}
        <p class="g-error" id="{{ id }}-error">{{ err }}</p>
    {% endif %}
</div>
