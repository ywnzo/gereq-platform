{#
  Compact user cell (avatar + name + meta).
  Used by ui()->table() column cell=user.
#}
{% set name = name|default('—') %}
{% set meta = meta|default('') %}
{% set initials = initials|default('?') %}
{% set email = email|default(null) %}
{% set avatar_src = avatar_src|default(null) %}
{% set href = href|default(null) %}
{% set avatar_html %}
    {{ ui().avatar({
        email: email,
        initials: initials,
        src: avatar_src,
        size: 'sm',
    })|raw }}
{% endset %}
{% if href %}
    <a class="cell-user cell-user--stack" href="{{ href }}">
        {{ avatar_html }}
        <span class="cell-user__text">
            <strong>{{ name }}</strong>
            {% if meta %}<small class="muted">{{ meta }}</small>{% endif %}
        </span>
    </a>
{% else %}
    <div class="cell-user">
        {{ avatar_html }}
        <span class="cell-user__text">
            <strong>{{ name }}</strong>
            {% if meta %}<small class="muted">{{ meta }}</small>{% endif %}
        </span>
    </div>
{% endif %}
