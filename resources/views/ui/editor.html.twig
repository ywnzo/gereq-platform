{% set name = name|default('') %}
{% set id = id|default('f-' ~ name) %}
{% set label = label|default('') %}
{% set hint = hint|default('') %}
{% set form = form|default(null) %}
{% set value = old(name, value|default(''), form) %}
{% set err = error(name, form) %}
{% set required = required|default(false) %}
{% set optional = optional|default(false) %}
{% set extra = extra|default('') %}
{% set placeholder = placeholder|default('ui.editor.placeholder'|trans) %}

<div class="g-field{% if err %} is-invalid{% endif %} {{ extra }}" data-field="{{ name }}">
    {% if label %}
        <label class="g-label" for="{{ id }}">
            <span>{{ label }}{% if optional %} <span class="g-optional">({{ 'common.optional'|trans }})</span>{% endif %}{% if required %} <span class="g-req" aria-hidden="true">*</span>{% endif %}</span>
        </label>
    {% endif %}
    <div
        class="g-editor"
        x-data="gereqEditor"
        data-placeholder="{{ placeholder }}"
        {% if label %}style="--gereq-editor-label: '{{ label|e('css') }}'"{% endif %}
    >
        <div class="g-editor__tabs" role="tablist">
            <button type="button" class="g-editor__tab" :class="tabEditorClass" @click="showEditor" role="tab">{{ 'ui.editor.tab.editor'|trans }}</button>
            <button type="button" class="g-editor__tab" :class="tabHtmlClass" @click="showHtml" role="tab">{{ 'ui.editor.tab.html'|trans }}</button>
        </div>

        <div class="g-editor__bar" role="toolbar" aria-label="{{ 'ui.editor.formatting'|trans }}" x-show="editorVisible" x-cloak>
            <select class="g-editor__select" :value="heading" @change="onHeadingChange" title="{{ 'ui.editor.style'|trans }}">
                <option value="paragraph">{{ 'ui.editor.paragraph'|trans }}</option>
                <option value="h1">H1</option>
                <option value="h2">H2</option>
                <option value="h3">H3</option>
            </select>
            <span class="g-editor__sep"></span>
            <button type="button" :class="boldClass" @click="bold" title="{{ 'ui.editor.bold'|trans }}">{{ icon('format-bold') }}</button>
            <button type="button" :class="italicClass" @click="italic" title="{{ 'ui.editor.italic'|trans }}">{{ icon('format-italic') }}</button>
            <button type="button" :class="underlineClass" @click="underline" title="{{ 'ui.editor.underline'|trans }}">{{ icon('format-underline') }}</button>
            <button type="button" :class="strikeClass" @click="strike" title="{{ 'ui.editor.strike'|trans }}">{{ icon('format-strike') }}</button>
            <button type="button" class="g-editor__btn" @click="toggleLink" title="{{ 'ui.editor.link'|trans }}">{{ icon('link') }}</button>
            <span class="g-editor__sep"></span>
            <button type="button" :class="alignLeftClass" @click="alignLeft" title="{{ 'ui.editor.align_left'|trans }}">{{ icon('format-align-left') }}</button>
            <button type="button" :class="alignCenterClass" @click="alignCenter" title="{{ 'ui.editor.align_center'|trans }}">{{ icon('format-align-center') }}</button>
            <button type="button" :class="alignRightClass" @click="alignRight" title="{{ 'ui.editor.align_right'|trans }}">{{ icon('format-align-right') }}</button>
            <button type="button" :class="alignJustifyClass" @click="alignJustify" title="{{ 'ui.editor.align_justify'|trans }}">{{ icon('format-align-justify') }}</button>
            <span class="g-editor__sep"></span>
            <button type="button" :class="bulletClass" @click="bullet" title="{{ 'ui.editor.bullet'|trans }}">{{ icon('format-list-bulleted') }}</button>
            <button type="button" :class="orderedClass" @click="ordered" title="{{ 'ui.editor.ordered'|trans }}">{{ icon('format-list-numbered') }}</button>
            <button type="button" class="g-editor__btn" @click="blockquote" title="{{ 'ui.editor.quote'|trans }}">{{ icon('format-quote') }}</button>
            <button type="button" class="g-editor__btn" @click="hr" title="{{ 'ui.editor.hr'|trans }}">{{ icon('horizontal-rule') }}</button>
            <button type="button" class="g-editor__btn" @click="clearFormat" title="{{ 'ui.editor.clear'|trans }}">{{ icon('format-clear') }}</button>
            <span class="g-editor__sep"></span>
            <button type="button" class="g-editor__btn" @click="undo" title="{{ 'ui.editor.undo'|trans }}">{{ icon('undo') }}</button>
            <button type="button" class="g-editor__btn" @click="redo" title="{{ 'ui.editor.redo'|trans }}">{{ icon('redo') }}</button>
        </div>

        <div class="g-editor__surface" x-ref="mount" x-show="editorVisible"></div>
        <textarea
            class="g-editor__html"
            x-show="htmlVisible"
            x-cloak
            :value="htmlSource"
            @input="onHtmlInput"
            spellcheck="false"
            aria-label="{{ 'ui.editor.tab.html'|trans }}"
        ></textarea>
        <textarea class="g-editor__input" id="{{ id }}" name="{{ name }}" x-ref="input" {% if required %}required{% endif %}>{{ value }}</textarea>
    </div>
    {% if hint %}
        <p class="g-hint" id="{{ id }}-hint">{{ hint }}</p>
    {% endif %}
    {% if err %}
        <p class="g-error" id="{{ id }}-error">{{ err }}</p>
    {% endif %}
</div>
