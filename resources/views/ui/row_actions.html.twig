{#
  Row actions flyout (⋯ menu).
  Parent list should use x-data="dataTable" so .table-wrap.is-actions-off can hide this column.
  Usage:
    {% embed 'ui/row_actions.html.twig' %}
      {% block items %}
        <a href="...">Detail</a>
      {% endblock %}
    {% endembed %}
#}
<td class="table__actions" x-data="rowMenu" @click.outside="close">
    <button type="button" class="icon-btn" x-ref="button" @click="toggle" aria-haspopup="menu" :aria-expanded="open" aria-label="{{ 'common.action'|trans }}">
        {{ icon('dots') }}
    </button>
    <div class="flyout flyout--right" x-ref="menu" :class="menuClass" :style="menuStyle" role="menu">
        {% block items %}{% endblock %}
    </div>
</td>
