{% if total > 0 %}
    <footer class="table-footer">
        <span class="muted">
            {{ ((page - 1) * perPage) + 1 }}–{{ min(page * perPage, total) }}
            {{ 'common.of'|trans }}
            {{ total }}
        </span>
        <nav class="pagination" aria-label="{{ 'common.pagination'|trans }}">
            {% set base = list_query is defined ? list_query.params() : { q: search|default(''), sort: sort|default(''), dir: dir|default(''), page: page } %}
            {% if page > 1 %}
                <a class="pagination__btn" href="?{{ base|merge({ page: page - 1 })|url_encode }}{% if hash|default('') %}#{{ hash }}{% endif %}">{{ 'common.previous'|trans }}</a>
            {% else %}
                <span class="pagination__btn is-disabled">{{ 'common.previous'|trans }}</span>
            {% endif %}
            <span class="pagination__status">{{ page }} / {{ pages }}</span>
            {% if page < pages %}
                <a class="pagination__btn" href="?{{ base|merge({ page: page + 1 })|url_encode }}{% if hash|default('') %}#{{ hash }}{% endif %}">{{ 'common.next'|trans }}</a>
            {% else %}
                <span class="pagination__btn is-disabled">{{ 'common.next'|trans }}</span>
            {% endif %}
        </nav>
    </footer>
{% endif %}
