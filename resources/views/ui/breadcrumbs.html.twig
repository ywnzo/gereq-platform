{#
  items: list of { label: string, url?: string|null }
  Last item is current (no link) unless only one item with url.
#}
{% set crumbs = items|default([]) %}
{% if crumbs is not empty %}
<ol class="breadcrumbs__list">
    {% for item in crumbs %}
        {% set isLast = loop.last %}
        <li class="breadcrumbs__item{{ isLast ? ' is-current' : '' }}">
            {% if not isLast and item.url|default(null) %}
                <a class="breadcrumbs__link" href="{{ item.url }}">{{ item.label }}</a>
            {% else %}
                <span class="breadcrumbs__current" {% if isLast %}aria-current="page"{% endif %}>{{ item.label }}</span>
            {% endif %}
            {% if not isLast %}
                <span class="breadcrumbs__sep" aria-hidden="true">/</span>
            {% endif %}
        </li>
    {% endfor %}
</ol>
{% endif %}
