{% extends 'admin/layout.html.twig' %}

{% block content %}
    {{ ui().pageHeader(pageTitle)|raw }}

    {% include 'ui/error-summary.html.twig' with { form: 'media.folder.save' } %}

    {% if mode == 'create' %}
        <form method="post" class="detail-stack" action="{{ url('admin.media.folders.store') }}" data-form="media.folder.save" x-data="gereqForm"{% if form_errors('media.folder.save') %} data-server-state="1"{% endif %}>
            {{ csrf_field()|raw }}
            {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
                {% block attributes %} class="panel"{% endblock %}
                {% block content %}
                <header class="panel__head">
                    <h2>{{ 'common.details'|trans }}</h2>
                </header>
                <div class="form-grid">
                    {{ ui().input({
                        name: 'name',
                        label: 'media.folder.field.name'|trans,
                        form: 'media.folder.save',
                        value: ''
                    })|raw }}
                    {{ ui().select({
                        name: 'parent_id',
                        label: 'media.folder.field.parent'|trans,
                        optional: true,
                        form: 'media.folder.save',
                        value: parentId,
                        options: folderOptions,
                        searchable: true
                    })|raw }}
                </div>
                {% endblock %}
            {% endembed %}
            <div class="form-actions">
                {% include 'ui/button.html.twig' with { label: 'media.folder.create'|trans, type: 'submit', variant: 'primary' } only %}
                {% include 'ui/button.html.twig' with {
                    label: 'common.cancel'|trans,
                    href: (url('admin.media.index', parentId ? {folder: parentId} : {})),
                    button_options: { tag: 'a' },
                    variant: 'ghost'
                } only %}
            </div>
        </form>
    {% else %}
        <form method="post" class="detail-stack" action="{{ url('admin.media.folders.update', {id: folder.id()}) }}" data-form="media.folder.save" x-data="gereqForm"{% if form_errors('media.folder.save') %} data-server-state="1"{% endif %}>
            {{ csrf_field()|raw }}
            {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
                {% block attributes %} class="panel"{% endblock %}
                {% block content %}
                <header class="panel__head">
                    <h2>{{ 'common.details'|trans }}</h2>
                </header>
                <div class="form-grid">
                    {{ ui().input({
                        name: 'name',
                        label: 'media.folder.field.name'|trans,
                        form: 'media.folder.save',
                        value: folder.name()
                    })|raw }}
                </div>
                {% endblock %}
            {% endembed %}
            <div class="form-actions">
                {% include 'ui/button.html.twig' with { label: 'common.save'|trans, type: 'submit', variant: 'primary' } only %}
                {% include 'ui/button.html.twig' with {
                    label: 'common.cancel'|trans,
                    href: (url('admin.media.index', folder.parentId() ? {folder: folder.parentId()} : {})),
                    button_options: { tag: 'a' },
                    variant: 'ghost'
                } only %}
            </div>
        </form>
    {% endif %}
{% endblock %}
