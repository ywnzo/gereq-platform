{% extends 'admin/layout.html.twig' %}

{% block content %}
    {{ ui().pageHeader('media.move'|trans, {meta: '<strong>' ~ item.title()|e ~ '</strong> <span class="badge">' ~ item.mime()|e ~ '</span>'})|raw }}

    {% include 'ui/error-summary.html.twig' with { form: 'media.move' } %}

    <form method="post" class="detail-stack" action="{{ url('admin.media.move.submit', {id: item.id()}) }}" data-form="media.move" x-data="gereqForm"{% if form_errors('media.move') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <h2>{{ 'common.details'|trans }}</h2>
            </header>
            <p class="muted" style="margin:0 0 1rem">{{ 'media.move.hint'|trans({'%title%': item.title()}) }}</p>
            <div class="form-grid">
                {{ ui().select({
                    name: 'folder_id',
                    label: 'media.field.folder'|trans,
                    optional: true,
                    form: 'media.move',
                    value: item.folderId()|default(''),
                    options: folderOptions,
                    searchable: true
                })|raw }}
            </div>
            {% endblock %}
        {% endembed %}
        <div class="form-actions">
            {% include 'ui/button.html.twig' with { label: 'media.move'|trans, type: 'submit', variant: 'primary' } only %}
            {% include 'ui/button.html.twig' with {
                label: 'common.cancel'|trans,
                href: (url('admin.media.show', {id: item.id()})),
                button_options: { tag: 'a' },
                variant: 'ghost'
            } only %}
        </div>
    </form>
{% endblock %}
