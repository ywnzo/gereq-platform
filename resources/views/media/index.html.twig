{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    <span class="breadcrumbs__current">{{ 'media.title'|trans }}</span>
{% endblock %}

{% block content %}
{% set drive_config = {
    can_manage: can_manage,
    folder_id: folder,
    view: 'grid',
    urls: drive_urls,
    i18n: drive_i18n,
    folder_options: folderOptions,
} %}
<div
    class="media-drive"
    x-data="mediaDrive"
    data-config="{{ drive_config|json_encode|e('html_attr') }}"
    data-entries="{{ entries|json_encode|e('html_attr') }}"
    @dragenter="onDragEnter($event)"
    @dragover="onDragOver($event)"
    @dragleave="onDragLeave($event)"
    @drop="onDrop($event)"
>
    <aside class="media-drive__sidebar" aria-label="{{ 'media.drive.sidebar'|trans }}">
        <div class="media-drive__brand">
            {{ ui().icon('folder')|raw }}
            <span>{{ 'media.drive.my_drive'|trans }}</span>
        </div>
        <nav class="media-drive__tree">
            <a
                class="media-drive__tree-link{{ folder == '' ? ' is-active' : '' }}"
                href="{{ url('admin.media.index') }}"
            >
                {{ ui().icon('folder-open')|raw }}
                <span class="media-drive__tree-label">{{ 'media.folder.root'|trans }}</span>
            </a>
            {% for node in folder_tree %}
                <a
                    class="media-drive__tree-link{{ node.id == folder ? ' is-active' : '' }}"
                    href="{{ node.url }}"
                    style="padding-left: {{ 0.55 + (node.depth * 0.75) }}rem"
                >
                    {{ ui().icon(node.id == folder ? 'folder-open' : 'folder')|raw }}
                    <span class="media-drive__tree-label">{{ node.name }}</span>
                </a>
            {% endfor %}
        </nav>
    </aside>

    <section class="media-drive__main">
        <div class="media-drive__toolbar">
            {% if can_manage %}
                <div class="media-drive__new" @click.stop>
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--primary" @click="toggleNew"{% endblock %}{% block content %}
                        {{ ui().icon('plus')|raw }}
                        {{ 'media.drive.new'|trans }}
                    {% endblock %}{% endembed %}
                    <div class="media-drive__new-menu" x-show="newOpen" x-cloak @click.stop>
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" @click="createFolder"{% endblock %}{% block content %}
                            {{ ui().icon('folder')|raw }}
                            {{ 'media.folder.create'|trans }}
                        {% endblock %}{% endembed %}
                        <label class="media-drive__menu-item" for="media-drive-file">
                            {{ ui().icon('upload')|raw }}
                            {{ 'media.upload'|trans }}
                        </label>
                    </div>
                </div>
                <label class="btn btn--ghost" for="media-drive-file">
                    {{ ui().icon('upload')|raw }}
                    {{ 'media.upload'|trans }}
                </label>
                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                    id="media-drive-file"
                    class="sr-only"
                    type="file"
                    multiple
                    data-media-file-input
                    @change="onFilesPicked($event)"
                {% endblock %}{% endembed %}
            {% endif %}

            <form class="media-drive__search" method="get" action="{{ url('admin.media.index') }}">
                {% if folder %}<input type="hidden" name="folder" value="{{ folder }}">{% endif %}
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ dir }}">
                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'media.search'|trans }}" aria-label="{{ 'media.search'|trans }}"{% endblock %}{% endembed %}
            </form>

            <div class="media-drive__tools">
                <form method="get" action="{{ url('admin.media.index') }}">
                    {% if folder %}<input type="hidden" name="folder" value="{{ folder }}">{% endif %}
                    {% if search %}<input type="hidden" name="q" value="{{ search }}">{% endif %}
                    <input type="hidden" name="sort" value="{{ sort }}">
                    <input type="hidden" name="dir" value="{{ dir }}">
                    {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} class="input" name="mime" onchange="this.form.submit()" aria-label="{{ 'media.filter.mime_all'|trans }}"{% endblock %}{% block native_options %}
                        {% include 'ui/option.html.twig' with { value: '', label: 'media.filter.mime_all'|trans } only %}
                        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="image/*" {{ mime == 'image/*' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'media.filter.images'|trans }}{% endblock %}{% endembed %}
                        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="video/*" {{ mime == 'video/*' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'media.filter.videos'|trans }}{% endblock %}{% endembed %}
                        {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="application/pdf" {{ mime == 'application/pdf' ? 'selected' : '' }}{% endblock %}{% block content %}PDF{% endblock %}{% endembed %}
                    {% endblock %}{% endembed %}
                </form>

                <div class="media-drive__view-toggle" role="group" aria-label="{{ 'media.drive.view'|trans }}">
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" :class="{ 'is-active': view === 'grid' }" @click="setView('grid')" title="{{ 'media.drive.view_grid'|trans }}"{% endblock %}{% block content %}
                        {{ ui().icon('grid')|raw }}
                    {% endblock %}{% endembed %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" :class="{ 'is-active': view === 'list' }" @click="setView('list')" title="{{ 'media.drive.view_list'|trans }}"{% endblock %}{% block content %}
                        {{ ui().icon('list')|raw }}
                    {% endblock %}{% endembed %}
                </div>
            </div>
        </div>

        <div class="media-drive__chrome" :class="{ 'is-selecting': hasSelection }">
            <nav class="media-drive__crumbs" aria-label="Breadcrumb" x-show="!hasSelection">
                {% for crumb in drive_crumbs %}
                    {% if not loop.first %}
                        <span class="media-drive__crumb-sep" aria-hidden="true">/</span>
                    {% endif %}
                    {% if crumb.url is defined and crumb.url %}
                        <a class="media-drive__crumb" href="{{ crumb.url }}">{{ crumb.label }}</a>
                    {% else %}
                        <span class="media-drive__crumb is-current">{{ crumb.label }}</span>
                    {% endif %}
                {% endfor %}
            </nav>

            {% if can_manage %}
                <form
                    class="media-drive__selection"
                    method="post"
                    action="{{ url('admin.media.bulk') }}"
                    x-show="hasSelection"
                    x-cloak
                    @submit="confirmBulk($event)"
                >
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="confirmed" value="0">
                    {% if folder %}<input type="hidden" name="folder" value="{{ folder }}">{% endif %}
                    <template x-for="id in selected" :key="id">
                        <input type="hidden" name="ids[]" :value="id">
                    </template>
                    <div class="media-drive__selection-meta">
                        <strong x-text="formatSelectedLabel()"></strong>
                        {% include 'ui/button.html.twig' with {
                            label: 'media.bulk.clear'|trans,
                            type: 'button',
                            variant: 'link',
                            class: 'btn-sm',
                            attrs: { '@click': 'clearSelection' }
                        } only %}
                        {% include 'ui/button.html.twig' with {
                            label: 'media.bulk.select_all'|trans,
                            type: 'button',
                            variant: 'link',
                            class: 'btn-sm',
                            attrs: { '@click': 'selectAll' }
                        } only %}
                    </div>
                    <div class="media-drive__selection-actions">
                        {% embed 'ui/select.html.twig' with { native: true } %}{% block root_attributes %}:data-native-value="bulkAction" {% endblock %}{% block native_attributes %} class="input" name="action" x-model="bulkAction" required{% endblock %}{% block native_options %}
                            {% include 'ui/option.html.twig' with { value: '', label: 'media.bulk.choose'|trans } only %}
                            {% include 'ui/option.html.twig' with { value: 'move', label: 'media.bulk.action.move'|trans } only %}
                            {% include 'ui/option.html.twig' with { value: 'delete', label: 'media.bulk.action.delete'|trans } only %}
                        {% endblock %}{% endembed %}
                        {% embed 'ui/select.html.twig' with { native: true } %}{% block root_attributes %}x-show="bulkAction === 'move'" x-cloak :data-native-value="bulkFolderId" {% endblock %}{% block native_attributes %} class="input" name="folder_id" x-show="bulkAction === 'move'" x-cloak x-model="bulkFolderId"{% endblock %}{% block native_options %}
                            {% for opt in folderOptions %}
                                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="{{ opt.value }}"{% endblock %}{% block content %}{{ opt.label }}{% endblock %}{% endembed %}
                            {% endfor %}
                        {% endblock %}{% endembed %}
                        {% include 'ui/button.html.twig' with {
                            label: 'media.bulk.apply'|trans,
                            type: 'submit',
                            variant: 'primary',
                            class: 'btn-sm',
                            attrs: { ':disabled': '!bulkAction' }
                        } only %}
                    </div>
                </form>
            {% endif %}
        </div>

        <div class="media-drive__viewport" :class="{ 'is-dragging': dragging }">
            <div class="media-drive__drop-hint">{{ 'media.drive.drop'|trans }}</div>

            <div class="media-drive__upload-bar" x-show="uploading" x-cloak>
                {{ ui().icon('upload')|raw }}
                <span>{{ 'media.drive.uploading'|trans }}</span>
                <strong x-text="uploadProgress"></strong>
            </div>

            {% if entries is empty %}
                <div class="media-drive__empty">
                    <span class="material-symbols-outlined g-icon" style="font-size:2.5rem" aria-hidden="true">folder_open</span>
                    <h2>{{ searching ? ('media.drive.no_results'|trans) : ('media.empty'|trans) }}</h2>
                    <p>{{ searching ? ('media.drive.no_results_hint'|trans) : ('media.empty.hint'|trans) }}</p>
                    {% if can_manage and not searching %}
                        <div class="grq-cluster" style="justify-content:center;margin-top:.5rem">
                            <label class="btn btn--primary" for="media-drive-file">{{ 'media.upload'|trans }}</label>
                            {% include 'ui/button.html.twig' with {
                                label: 'media.folder.create'|trans,
                                type: 'button',
                                variant: 'ghost',
                                attrs: { '@click': 'createFolder' }
                            } only %}
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <div class="media-drive__grid" x-show="view === 'grid'">
                    {% for entry in entries %}
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                            type="button"
                            class="media-drive__tile"
                            :class="{ 'is-selected': isSelected('{{ entry.id }}'), 'is-focused': isFocused('{{ entry.id }}') }"
                            @click="onTileClickById('{{ entry.id }}', $event)"
                            @dblclick="openById('{{ entry.id }}')"
                            @contextmenu="onContextMenuById('{{ entry.id }}', $event)"
                        {% endblock %}{% block content %}
                            {% if can_manage and entry.kind == 'asset' %}
                                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                                    class="media-drive__tile-check"
                                    type="checkbox"
                                    :checked="isSelected('{{ entry.id }}')"
                                    @click="toggleSelect('{{ entry.id }}', $event)"
                                    aria-label="{{ entry.name }}"
                                {% endblock %}{% endembed %}
                            {% endif %}
                            <div class="media-drive__thumb{{ entry.kind == 'folder' ? ' media-drive__thumb--folder' : '' }}{{ entry.is_video ? ' media-drive__thumb--video' : '' }}">
                                {% if entry.kind == 'folder' %}
                                    {{ ui().icon('folder')|raw }}
                                {% elseif entry.is_image and entry.thumb %}
                                    <img src="{{ entry.thumb }}" alt="{{ entry.alt|default(entry.name) }}" loading="lazy">
                                {% elseif entry.is_video and entry.file_url %}
                                    <video
                                        class="media-drive__thumb-video"
                                        src="{{ entry.file_url }}"
                                        muted
                                        playsinline
                                        preload="metadata"
                                    ></video>
                                    <span class="media-drive__thumb-play" aria-hidden="true">{{ ui().icon('play')|raw }}</span>
                                {% else %}
                                    {{ ui().icon(entry.icon|default('file'))|raw }}
                                {% endif %}
                            </div>
                            <div class="media-drive__name" title="{{ entry.name }}">{{ entry.name }}</div>
                            <div class="media-drive__meta">
                                {% if entry.kind == 'folder' %}
                                    {{ 'media.folder.badge'|trans }}
                                {% else %}
                                    {{ entry.size_label }}
                                {% endif %}
                            </div>
                        {% endblock %}{% endembed %}
                    {% endfor %}
                </div>

                <div class="media-drive__list" x-show="view === 'list'" x-cloak>
                    {% for entry in entries %}
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %}
                            type="button"
                            class="media-drive__tile"
                            :class="{ 'is-selected': isSelected('{{ entry.id }}'), 'is-focused': isFocused('{{ entry.id }}') }"
                            @click="onTileClickById('{{ entry.id }}', $event)"
                            @dblclick="openById('{{ entry.id }}')"
                            @contextmenu="onContextMenuById('{{ entry.id }}', $event)"
                        {% endblock %}{% block content %}
                            {% if can_manage and entry.kind == 'asset' %}
                                {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %}
                                    class="media-drive__tile-check"
                                    type="checkbox"
                                    :checked="isSelected('{{ entry.id }}')"
                                    @click="toggleSelect('{{ entry.id }}', $event)"
                                {% endblock %}{% endembed %}
                            {% endif %}
                            <div class="media-drive__thumb{{ entry.kind == 'folder' ? ' media-drive__thumb--folder' : '' }}{{ entry.is_video ? ' media-drive__thumb--video' : '' }}">
                                {% if entry.kind == 'folder' %}
                                    {{ ui().icon('folder')|raw }}
                                {% elseif entry.is_image and entry.thumb %}
                                    <img src="{{ entry.thumb }}" alt="" loading="lazy">
                                {% elseif entry.is_video and entry.file_url %}
                                    <video
                                        class="media-drive__thumb-video"
                                        src="{{ entry.file_url }}"
                                        muted
                                        playsinline
                                        preload="metadata"
                                    ></video>
                                    <span class="media-drive__thumb-play" aria-hidden="true">{{ ui().icon('play')|raw }}</span>
                                {% else %}
                                    {{ ui().icon(entry.icon|default('file'))|raw }}
                                {% endif %}
                            </div>
                            <div class="media-drive__body">
                                <div class="media-drive__name" title="{{ entry.name }}">{{ entry.name }}</div>
                                <div class="media-drive__meta">
                                    {% if entry.kind == 'folder' %}
                                        {{ 'media.folder.badge'|trans }}
                                    {% else %}
                                        {{ entry.mime }}
                                    {% endif %}
                                </div>
                                <div class="media-drive__meta">
                                    {% if entry.kind == 'asset' %}{{ entry.size_label }} · {% endif %}{{ entry.created }}
                                </div>
                            </div>
                        {% endblock %}{% endembed %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {% if total > perPage %}
            <div class="media-drive__pager">
                <span>{{ 'media.drive.showing'|trans({'%from%': ((page - 1) * perPage) + 1, '%to%': min(page * perPage, total), '%total%': total}) }}</span>
                <div class="grq-cluster">
                    {% if page > 1 %}
                        {% include 'ui/button.html.twig' with {
                            label: 'common.previous'|trans,
                            href: (url('admin.media.index', pager_query|merge({page: page - 1}))),
                            button_options: { tag: 'a' },
                            variant: 'ghost',
                            class: 'btn-sm'
                        } only %}
                    {% endif %}
                    {% if page * perPage < total %}
                        {% include 'ui/button.html.twig' with {
                            label: 'common.next'|trans,
                            href: (url('admin.media.index', pager_query|merge({page: page + 1}))),
                            button_options: { tag: 'a' },
                            variant: 'ghost',
                            class: 'btn-sm'
                        } only %}
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </section>

    <div
        class="media-drive__menu"
        x-show="menuOpen"
        x-cloak
        @click.stop
        :style="menuStyle"
    >
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" @click="menuAction('open')"{% endblock %}{% block content %}{{ ui().icon('eye')|raw }} {{ 'common.open'|trans }}{% endblock %}{% endembed %}
        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" x-show="menuEntry && menuEntry.file_url" @click="menuAction('download')"{% endblock %}{% block content %}{{ ui().icon('download')|raw }} {{ 'media.drive.download'|trans }}{% endblock %}{% endembed %}
        {% if can_manage %}
            <div class="media-drive__menu-sep"></div>
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" @click="menuAction('rename')"{% endblock %}{% block content %}{{ ui().icon('edit')|raw }} {{ 'media.drive.rename'|trans }}{% endblock %}{% endembed %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" @click="menuAction('move')"{% endblock %}{% block content %}{{ ui().icon('move')|raw }} {{ 'media.move'|trans }}{% endblock %}{% endembed %}
            <div class="media-drive__menu-sep"></div>
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="is-danger" @click="menuAction('delete')"{% endblock %}{% block content %}{{ ui().icon('trash')|raw }} {{ 'common.delete'|trans }}{% endblock %}{% endembed %}
        {% endif %}
    </div>

    <div
        class="g-modal__backdrop"
        :class="previewOpen ? 'is-open' : ''"
        x-show="previewOpen"
        x-cloak
        @click="closePreview"
    ></div>
    {% embed 'ui/modal.html.twig' %}{% block component_attributes %}
        class="g-modal"
        :class="previewOpen ? 'is-open' : ''"
        x-show="previewOpen"
        x-cloak
        role="dialog"
        aria-modal="true"
        aria-labelledby="media-drive-preview-title"
        @click.self="closePreview"
    {% endblock %}{% block content %}
        <div class="g-modal__panel media-drive__preview-panel" @click.stop x-show="previewEntry">
            <header class="media-drive__preview-head">
                <div class="media-drive__preview-titles">
                    <h3 class="g-modal__title" id="media-drive-preview-title" x-text="previewEntry ? previewEntry.name : ''"></h3>
                    <p class="media-drive__preview-sub" x-text="formatMime(previewEntry)"></p>
                </div>
                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost btn-sm" @click="closePreview" aria-label="{{ 'common.close'|trans }}"{% endblock %}{% block content %}
                    {{ ui().icon('close')|raw }}
                {% endblock %}{% endembed %}
            </header>

            <div class="media-drive__preview-stage">
                <template x-if="isPreviewImage()">
                    <img class="media-drive__preview-media" :src="previewEntry.file_url" :alt="previewEntry.alt || previewEntry.name">
                </template>
                <template x-if="isPreviewVideo()">
                    <video
                        class="media-drive__preview-media media-drive__preview-video"
                        :src="previewEntry.file_url"
                        controls
                        playsinline
                        preload="metadata"
                    ></video>
                </template>
                <template x-if="isPreviewPdf()">
                    <iframe class="media-drive__preview-frame" :src="previewEntry.file_url" title="PDF"></iframe>
                </template>
                <template x-if="isPreviewText()">
                    <div class="media-drive__preview-text-wrap">
                        <p class="media-drive__preview-status" x-show="previewTextLoading" x-text="i18n.preview_loading"></p>
                        <p class="media-drive__preview-status" x-show="previewTextError" x-text="previewTextError"></p>
                        <pre class="media-drive__preview-text" x-show="previewTextReady()" x-text="previewText"></pre>
                    </div>
                </template>
                <template x-if="previewEntry && !isPreviewImage() && !isPreviewVideo() && !isPreviewPdf() && !isPreviewText()">
                    <div class="media-drive__preview-file">
                        <span class="material-symbols-outlined g-icon">description</span>
                        <span x-text="previewEntry.name"></span>
                    </div>
                </template>
            </div>

            <dl class="media-drive__preview-meta">
                <div>
                    <dt>{{ 'media.field.mime'|trans }}</dt>
                    <dd x-text="previewEntry && previewEntry.mime ? previewEntry.mime : '—'"></dd>
                </div>
                <div>
                    <dt>{{ 'media.field.size'|trans }}</dt>
                    <dd x-text="previewEntry && previewEntry.size_label ? previewEntry.size_label : '—'"></dd>
                </div>
                <div x-show="previewEntry && previewEntry.dimensions">
                    <dt>{{ 'media.field.dimensions'|trans }}</dt>
                    <dd x-text="previewEntry && previewEntry.dimensions ? previewEntry.dimensions : '—'"></dd>
                </div>
                <div>
                    <dt>{{ 'media.field.created'|trans }}</dt>
                    <dd x-text="previewEntry && previewEntry.created ? previewEntry.created : '—'"></dd>
                </div>
                <div class="media-drive__preview-meta-full" x-show="previewEntry && previewEntry.path">
                    <dt>{{ 'media.field.path'|trans }}</dt>
                    <dd><code x-text="previewEntry && previewEntry.path ? previewEntry.path : ''"></code></dd>
                </div>
            </dl>

            <div class="g-modal__actions media-drive__preview-actions">
                <template x-if="previewEntry && previewEntry.file_url">
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--primary" :href="previewEntry.file_url" target="_blank" rel="noopener"{% endblock %}{% block content %}{{ 'media.drive.download'|trans }}{% endblock %}{% endembed %}
                </template>
                {% if can_manage %}
                    <template x-if="previewEntry && previewEntry.edit_url">
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--ghost" :href="previewEntry.edit_url"{% endblock %}{% block content %}{{ 'common.edit'|trans }}{% endblock %}{% endembed %}
                    </template>
                    {% include 'ui/button.html.twig' with {
                        label: 'media.drive.rename'|trans,
                        type: 'button',
                        variant: 'ghost',
                        attrs: { '@click': 'renamePreview' }
                    } only %}
                    <template x-if="previewEntry && previewEntry.move_url">
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--ghost" :href="previewEntry.move_url"{% endblock %}{% block content %}{{ 'media.move'|trans }}{% endblock %}{% endembed %}
                    </template>
                    {% include 'ui/button.html.twig' with {
                        label: 'common.delete'|trans,
                        type: 'button',
                        variant: 'danger',
                        attrs: { '@click': 'deletePreview' }
                    } only %}
                {% endif %}
                {% include 'ui/button.html.twig' with {
                    label: 'common.close'|trans,
                    type: 'button',
                    variant: 'ghost',
                    attrs: { '@click': 'closePreview' }
                } only %}
            </div>
        </div>
    {% endblock %}{% endembed %}
</div>
{% endblock %}
