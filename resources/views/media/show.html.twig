{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <div>
            <h1>{{ item.title() }}</h1>
            <p class="muted detail-layout__meta">
                <code>{{ item.path() }}</code>
                <span class="badge">{{ item.mime() }}</span>
            </p>
        </div>
        <div class="actions">
            {% if user.can('media.manage') %}
                <a class="btn btn--ghost" href="{{ url('admin.media.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <a class="btn btn--ghost" href="{{ url('admin.media.move', {id: item.id()}) }}">{{ 'media.move'|trans }}</a>
                <form method="post" action="{{ url('admin.media.destroy', {id: item.id()}) }}" data-confirm="{{ 'media.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="detail-layout">
        <div class="detail-layout__main">
            <section class="detail-hero panel">
                {% if item.isImage() %}
                    <a class="detail-hero__media" href="{{ url('admin.media.file', {id: item.id()}) }}" target="_blank" rel="noopener">
                        <img src="{{ url('admin.media.file', {id: item.id()}) }}" alt="{{ item.alt()|default(item.title()) }}">
                    </a>
                {% else %}
                    <div class="detail-hero__media detail-hero__media--empty" aria-hidden="true">
                        <span class="material-symbols-outlined g-icon">draft</span>
                    </div>
                {% endif %}
                <div class="detail-hero__body detail-hero__body--solo">
                    <dl class="detail-hero__facts">
                        <div>
                            <dt>{{ 'media.field.mime'|trans }}</dt>
                            <dd><span class="badge">{{ item.mime() }}</span></dd>
                        </div>
                        <div>
                            <dt>{{ 'media.field.dimensions'|trans }}</dt>
                            <dd>{% if item.width() and item.height() %}{{ item.width() }} × {{ item.height() }}{% else %}—{% endif %}</dd>
                        </div>
                        <div>
                            <dt>{{ 'media.field.size'|trans }}</dt>
                            <dd>{{ (item.size() / 1024)|number_format(1, ',', ' ') }} KB</dd>
                        </div>
                        <div>
                            <dt>{{ 'media.field.created'|trans }}</dt>
                            <dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd>
                        </div>
                    </dl>
                </div>
            </section>

            <section class="panel">
                <header class="panel__head"><h2>{{ 'media.links.title'|trans }}</h2></header>
                {% if links is empty %}
                    <div class="empty">
                        <p>{{ 'media.links.empty'|trans }}</p>
                    </div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'media.links.entity_type'|trans }}</th>
                                    <th>{{ 'media.links.entity_id'|trans }}</th>
                                    <th>{{ 'media.links.label'|trans }}</th>
                                    <th>{{ 'media.field.created'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for link in links %}
                                    <tr>
                                        <td><span class="badge">{{ link.entityType() }}</span></td>
                                        <td><code>{{ link.entityId() }}</code></td>
                                        <td>{{ link.label()|default('—') }}</td>
                                        <td>{{ link.createdAt().format('d. m. Y H:i') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </div>

        <aside class="detail-layout__aside">
            <section class="panel">
                <header class="panel__head"><h2>{{ 'common.overview'|trans }}</h2></header>
                <dl class="meta-list meta-list--flush detail-layout__specs">
                    <div>
                        <dt>{{ 'media.field.mime'|trans }}</dt>
                        <dd><span class="badge">{{ item.mime() }}</span></dd>
                    </div>
                    <div>
                        <dt>{{ 'media.field.size'|trans }}</dt>
                        <dd>{{ (item.size() / 1024)|number_format(1, ',', ' ') }} KB</dd>
                    </div>
                    <div>
                        <dt>{{ 'media.field.alt'|trans }}</dt>
                        <dd>{{ item.alt()|default('—') }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'media.field.dimensions'|trans }}</dt>
                        <dd>{% if item.width() and item.height() %}{{ item.width() }} × {{ item.height() }}{% else %}—{% endif %}</dd>
                    </div>
                    <div class="meta-list__full">
                        <dt>{{ 'media.field.path'|trans }}</dt>
                        <dd><code>{{ item.path() }}</code></dd>
                    </div>
                    <div class="meta-list__full">
                        <dt>{{ 'media.field.created'|trans }}</dt>
                        <dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd>
                    </div>
                    {% if folder %}
                        <div class="meta-list__full">
                            <dt>{{ 'media.field.folder'|trans }}</dt>
                            <dd><a href="{{ url('admin.media.index', {folder: folder.id()}) }}">{{ folder.name() }}</a></dd>
                        </div>
                    {% endif %}
                </dl>
            </section>
        </aside>
    </div>
{% endblock %}
