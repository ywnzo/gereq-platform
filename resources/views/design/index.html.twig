<!DOCTYPE html>
<html lang="{{ app_locale() }}" data-theme="gereq" style="{{ brand_html_style() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'design.title'|trans }}</title>
    {% include 'partials/brand-head.html.twig' %}
    {{ render_css() }}
    {% include 'partials/brand-overrides.html.twig' %}
</head>
<body class="design-body">
    <header class="design-bar">
        {% include 'partials/brand-lockup.html.twig' with { href: '/design.html', modifier: 'brand--bar', subtitle: 'design.subtitle'|trans } %}
        <nav class="design-bar__links" aria-label="{{ 'design.nav.system'|trans }}">
            <a href="{{ url('design.ui') }}">{{ 'design.ui.nav_ui'|trans }}</a>
            <a href="/ok.html">{{ 'design.nav.server_status'|trans }}</a>
            <a href="{{ url('admin.login') }}">{{ 'design.nav.admin'|trans }}</a>
        </nav>
    </header>

    <div class="design-wrap" x-data="gereqTabs"{% if form_errors('design.demo') %} data-initial="formular"{% endif %}>
        <header class="design-head">
            <p class="design-head__kicker">{{ 'design.head.kicker'|trans }}</p>
            <h1>{{ 'design.head.title'|trans }}</h1>
            <p class="design-head__lead">{{ 'design.head.lead'|trans }}</p>
        </header>

        {% set flashes_success = flash('success') %}
        {% if flashes_success %}
            {% for message in flashes_success %}
                <div class="design-notice design-notice--ok" role="status">{{ message }}</div>
            {% endfor %}
        {% endif %}

        <div class="design-tabs" role="tablist" aria-label="{{ 'design.tabs.aria'|trans }}">
            <button type="button" class="design-tab" role="tab" data-tab="znacka">{{ 'design.tabs.brand'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="zaklad">{{ 'design.tabs.foundation'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="tlacitka">{{ 'design.tabs.buttons'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="pole">{{ 'design.tabs.fields'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="vybery">{{ 'design.tabs.selects'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="editor">{{ 'design.tabs.editor'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="tabulky">{{ 'design.tabs.tables'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="feedback">{{ 'design.tabs.feedback'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="layout">{{ 'design.tabs.layout'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="overlay">{{ 'design.tabs.overlay'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="formular">{{ 'design.tabs.validation'|trans }}</button>
        </div>

        <section class="design-panel" data-panel="znacka" role="tabpanel">
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.palette.title'|trans }}</h2>
                    <p>{{ 'design.palette.lead'|trans }}</p>
                </div>
                <div class="design-box__body">
                    <div class="design-swatches">
                        <div><span class="design-swatch design-swatch--ink"></span> Ink</div>
                        <div><span class="design-swatch design-swatch--paper"></span> Paper</div>
                        <div><span class="design-swatch design-swatch--signal"></span> Signal</div>
                        <div><span class="design-swatch design-swatch--coral"></span> Coral</div>
                        <div><span class="design-swatch design-swatch--sky"></span> Sky</div>
                        <div><span class="design-swatch design-swatch--violet"></span> Violet</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="zaklad" role="tabpanel">
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.foundation.title'|trans }}</h2>
                    <p>{{ 'design.foundation.lead'|trans }}</p>
                </div>
                <div class="design-box__body grq-stack grq-stack--lg">
                    <div class="grq-stack grq-stack--sm">
                        <p class="grq-text-label">{{ 'design.foundation.type'|trans }}</p>
                        <p class="grq-text-display">Display · grq-text-display</p>
                        <p class="grq-text-title">Title · grq-text-title</p>
                        <p class="grq-text-body">Body · grq-text-body</p>
                        <p class="grq-text-ui">UI · grq-text-ui</p>
                        <p class="grq-text-meta">Meta · grq-text-meta</p>
                        <p class="grq-text-caption">Caption · grq-text-caption</p>
                        <p class="grq-text-label">Label · grq-text-label</p>
                    </div>
                    <div class="grq-stack grq-stack--sm">
                        <p class="grq-text-label">{{ 'design.foundation.layout'|trans }}</p>
                        <div class="grq-grid grq-grid--2">
                            <div class="grq-box">
                                <p class="grq-text-ui">grq-box</p>
                                <p class="grq-text-meta">Surface container</p>
                            </div>
                            <div class="grq-box grq-box--soft">
                                <p class="grq-text-ui">grq-box--soft</p>
                                <p class="grq-text-meta">Soft surface</p>
                            </div>
                        </div>
                        <div class="grq-cluster">
                            <span class="badge">cluster</span>
                            <button type="button" class="btn btn-sm">Action</button>
                            <span class="grq-text-meta muted">grq-cluster</span>
                        </div>
                        <div class="grq-stack grq-stack--xs grq-box grq-box--sm">
                            <span class="grq-text-ui">grq-stack</span>
                            <span class="grq-text-meta">Vertical rhythm</span>
                        </div>
                    </div>
                    <div class="grq-stack grq-stack--sm">
                        <p class="grq-text-label">{{ 'design.foundation.controls'|trans }}</p>
                        <div class="grq-grid grq-grid--2">
                            <label class="g-field">
                                <span class="g-label">g-control</span>
                                <input class="g-control" type="text" value="Shared input" readonly>
                            </label>
                            <label class="g-field">
                                <span class="g-label">.input (legacy)</span>
                                <input class="input" type="text" value="Same tokens" readonly>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="tlacitka" role="tabpanel">
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.actions.title'|trans }}</h2>
                    <p>{{ 'design.actions.lead'|trans|raw }}</p>
                </div>
                <div class="design-box__body">
                    <div class="design-cluster">
                        <p class="design-cluster__label">{{ 'design.actions.types'|trans }}</p>
                        <div class="design-row">
                            <button class="btn btn--primary" type="button">{{ 'design.btn.primary'|trans }}</button>
                            <button class="btn" type="button">{{ 'design.btn.default'|trans }}</button>
                            <button class="btn btn--dashed" type="button">{{ 'design.btn.dashed'|trans }}</button>
                            <button class="btn btn--text" type="button">{{ 'design.btn.text'|trans }}</button>
                            <button class="btn btn--link" type="button">{{ 'design.btn.link'|trans }}</button>
                        </div>
                    </div>
                    <div class="design-cluster">
                        <p class="design-cluster__label">{{ 'design.actions.danger'|trans }}</p>
                        <div class="design-row">
                            <button class="btn btn--danger" type="button">{{ 'design.btn.trash'|trans }}</button>
                            <button class="btn btn--danger-outline" type="button">{{ 'design.btn.danger_outline'|trans }}</button>
                            <button class="btn btn--primary" type="button" disabled>{{ 'design.btn.disabled'|trans }}</button>
                            <button class="btn btn--primary is-busy" type="button" aria-busy="true">{{ 'design.btn.loading'|trans }}</button>
                        </div>
                    </div>
                    <div class="design-cluster">
                        <p class="design-cluster__label">{{ 'design.actions.semantic'|trans }}</p>
                        <div class="design-row">
                            <button class="btn btn--soft" type="button">{{ 'design.btn.soft'|trans }}</button>
                            <button class="btn btn--success" type="button">{{ 'design.btn.done'|trans }}</button>
                            <button class="btn btn--warn" type="button">{{ 'design.btn.warning'|trans }}</button>
                            <button class="btn btn--ink" type="button">{{ 'design.btn.ink'|trans }}</button>
                            <button class="btn btn--outline" type="button">{{ 'design.btn.outline'|trans }}</button>
                        </div>
                    </div>
                    <div class="design-cluster">
                        <p class="design-cluster__label">{{ 'design.actions.sizes'|trans }}</p>
                        <div class="design-row">
                            <button class="btn btn--xs btn--primary" type="button">XS</button>
                            <button class="btn btn--sm btn--primary" type="button">{{ 'design.btn.small'|trans }}</button>
                            <button class="btn btn--primary" type="button">{{ 'design.btn.middle'|trans }}</button>
                            <button class="btn btn--lg btn--primary" type="button">{{ 'design.btn.large'|trans }}</button>
                            <button class="btn btn--primary g-tip" type="button" data-tip="{{ 'design.btn.tip_save_draft'|trans }}">{{ 'design.btn.with_tip'|trans }}</button>
                        </div>
                    </div>
                    <div class="design-cluster">
                        <p class="design-cluster__label">{{ 'design.actions.icons'|trans }}</p>
                        <div class="design-row">
                            <button class="btn btn--primary" type="button"><span class="g-icon" aria-hidden="true">add</span> {{ 'common.create'|trans }}</button>
                            <button class="btn" type="button"><span class="g-icon" aria-hidden="true">search</span> {{ 'common.search'|trans }}</button>
                            <button class="btn btn--text" type="button"><span class="g-icon" aria-hidden="true">more_horiz</span></button>
                            <button class="icon-btn" type="button" aria-label="{{ 'common.edit'|trans }}"><span class="g-icon" aria-hidden="true">edit</span></button>
                            <button class="icon-btn" type="button" aria-label="{{ 'common.delete'|trans }}"><span class="g-icon" aria-hidden="true">delete</span></button>
                        </div>
                    </div>
                    <div class="design-cluster">
                        <p class="design-cluster__label">{{ 'design.actions.legacy'|trans }}</p>
                        <div class="design-row">
                            <button class="btn btn-primary" type="button">btn-primary</button>
                            <button class="btn btn-ghost" type="button">btn-ghost</button>
                            <button class="btn btn-error" type="button">btn-error</button>
                            <button class="btn btn-success" type="button">btn-success</button>
                            <button class="btn btn-sm btn-primary" type="button">btn-sm</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="pole" role="tabpanel">
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.fields.title'|trans }}</h2>
                    <p>{{ 'design.fields.lead'|trans }}</p>
                </div>
                <div class="design-box__body design-settings">
                    {% include 'ui/input.html.twig' with { name: 'demo_name', label: 'design.field.name'|trans, placeholder: 'design.field.name.placeholder'|trans, hint: 'design.field.name.hint'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_email', type: 'email', label: 'common.email'|trans, placeholder: 'design.field.email.placeholder'|trans, hint: 'design.field.email.hint'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_tel', type: 'tel', label: 'design.field.phone'|trans, placeholder: 'design.field.phone.placeholder'|trans, prefix: '+420', inputmode: 'tel', hint: 'design.field.phone.hint'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_url', type: 'url', label: 'design.field.web'|trans, placeholder: 'design.field.web.placeholder'|trans, hint: 'design.field.web.hint'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_number', type: 'number', label: 'design.field.limit'|trans, value: '12', min: 0, max: 99, suffix: 'design.field.limit.suffix'|trans, hint: 'design.field.limit.hint'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_money', type: 'number', label: 'design.field.price'|trans, value: '2490', min: 0, step: 10, suffix: currency_symbol(), form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_password', type: 'password', label: 'common.password'|trans, autocomplete: 'new-password', hint: 'design.field.password.hint'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_search', type: 'search', label: 'design.field.search'|trans, placeholder: 'design.field.search.placeholder'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_date', type: 'date', label: 'design.field.date'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_time', type: 'time', label: 'design.field.time'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_dt', type: 'datetime-local', label: 'design.field.datetime'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_color', type: 'color', label: 'design.field.color'|trans, value: '#d7ff45', hint: 'design.field.color.hint'|trans, form: 'design.static' } %}
                    {% include 'ui/input.html.twig' with { name: 'demo_off', label: 'design.field.readonly'|trans, value: 'design.field.readonly.value'|trans, disabled: true, hint: 'design.field.readonly.hint'|trans, form: 'design.static' } %}
                    {% include 'ui/file.html.twig' with { label: 'design.field.attachment'|trans } %}
                    <div class="g-field">
                        <label class="g-label" for="demo-range">{{ 'design.field.priority'|trans }}</label>
                        <input class="g-range" id="demo-range" type="range" min="0" max="100" value="40">
                        <p class="g-hint">{{ 'design.field.priority.hint'|trans }}</p>
                    </div>
                    <div class="g-field">
                        <span class="g-label">{{ 'design.field.pin'|trans }}</span>
                        <div class="g-pin" aria-label="{{ 'design.field.pin'|trans }}">
                            <input class="g-control" maxlength="1" inputmode="numeric">
                            <input class="g-control" maxlength="1" inputmode="numeric">
                            <input class="g-control" maxlength="1" inputmode="numeric">
                            <input class="g-control" maxlength="1" inputmode="numeric">
                        </div>
                    </div>
                </div>
            </div>
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.textarea.title'|trans }}</h2>
                    <p>{{ 'design.textarea.lead'|trans|raw }}</p>
                </div>
                <div class="design-box__body design-settings">
                    {% include 'ui/textarea.html.twig' with {
                        name: 'demo_area',
                        label: 'design.textarea.description'|trans,
                        placeholder: 'design.textarea.description.placeholder'|trans,
                        hint: 'design.textarea.description.hint'|trans,
                        maxlength: 500,
                        form: 'design.static',
                        optional: true
                    } %}
                    {% include 'ui/textarea.html.twig' with {
                        name: 'demo_area_mini',
                        label: 'design.textarea.note'|trans,
                        size: 'mini',
                        placeholder: 'design.textarea.note.placeholder'|trans,
                        hint: 'design.textarea.note.hint'|trans,
                        form: 'design.static',
                        optional: true
                    } %}
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="vybery" role="tabpanel">
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.selects.title'|trans }}</h2>
                    <p>{{ 'design.selects.lead'|trans }}</p>
                </div>
                <div class="design-box__body design-settings">
                    {% include 'ui/select.html.twig' with {
                        name: 'demo_role',
                        label: 'design.field.role'|trans,
                        value: 'editor',
                        hint: 'design.field.role.hint'|trans,
                        form: 'design.static',
                        options: [
                            { value: 'admin', label: 'design.role.admin'|trans, description: 'design.role.admin.desc'|trans },
                            { value: 'editor', label: 'design.role.editor'|trans, description: 'design.role.editor.desc'|trans },
                            { value: 'viewer', label: 'design.role.viewer'|trans, description: 'design.role.viewer.desc'|trans }
                        ]
                    } %}
                    {% include 'ui/radio.html.twig' with {
                        name: 'demo_plan',
                        label: 'design.field.plan'|trans,
                        value: 'pro',
                        form: 'design.static',
                        options: [
                            { value: 'start', label: 'design.plan.start'|trans },
                            { value: 'pro', label: 'design.plan.pro'|trans },
                            { value: 'scale', label: 'design.plan.scale'|trans }
                        ]
                    } %}
                    {% include 'ui/checkbox.html.twig' with { name: 'demo_news', label: 'design.field.news'|trans, description: 'design.field.news.desc'|trans, form: 'design.static' } %}
                    {% include 'ui/switch.html.twig' with { name: 'demo_dark', label: 'design.field.dark'|trans, description: 'design.field.dark.desc'|trans, on: true } %}
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="editor" role="tabpanel">
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.editor.title'|trans }}</h2>
                    <p>{{ 'design.editor.lead'|trans }}</p>
                </div>
                <div class="design-box__body design-settings">
                    {% include 'ui/editor.html.twig' with {
                        name: 'demo_body',
                        label: 'design.editor.content'|trans,
                        placeholder: 'design.editor.placeholder'|trans,
                        value: 'design.editor.sample'|trans,
                        form: 'design.static'
                    } %}
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="tabulky" role="tabpanel">
            {% set design_products = [
                { sku: 'GRQ-1001', name: 'Signal Hoodie', meta: 'Merch · Soft shell', price: '1 290 Kč', stock: 42, status: 'ok', tone: 'success' },
                { sku: 'GRQ-1002', name: 'Ink Cap', meta: 'Merch · One size', price: '490 Kč', stock: 8, status: 'warn', tone: 'warn' },
                { sku: 'GRQ-2040', name: 'Crew Socks 3-pack', meta: 'Merch · Unisex', price: '320 Kč', stock: 0, status: 'danger', tone: 'danger' },
                { sku: 'GRQ-3100', name: 'Desk Mat XL', meta: 'Office · 90×40', price: '890 Kč', stock: 15, status: 'ok', tone: 'success' },
                { sku: 'GRQ-4002', name: 'Sticker Pack', meta: 'Merch · 12 pcs', price: '120 Kč', stock: 200, status: 'ok', tone: 'success' },
            ] %}
            {% set design_orders = [
                { id: 'ORD-24091', customer: 'Auto Servis Brno', total: '24 580 Kč', items: 6, date: '28. 9. 2026', status: 'paid', tone: 'success' },
                { id: 'ORD-24088', customer: 'Bike Lab Praha', total: '8 120 Kč', items: 2, date: '27. 9. 2026', status: 'open', tone: 'info' },
                { id: 'ORD-24071', customer: 'Fleet Carrier s.r.o.', total: '112 000 Kč', items: 14, date: '22. 9. 2026', status: 'shipped', tone: 'indigo' },
                { id: 'ORD-24055', customer: 'Anna Králová', total: '1 490 Kč', items: 1, date: '18. 9. 2026', status: 'canceled', tone: 'danger' },
            ] %}

            {# —— 1. ui()->table() demo: sortable columns + bulk —— #}
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.tables.title'|trans }}</h2>
                    <p>{{ 'design.tables.api_lead'|trans|raw }}</p>
                </div>
                <div class="design-box__body">
                    <div
                        class="list-shell list-shell--fit"
                        x-data="dataTable"
                        data-table-id="design-users"
                        data-page-ids='{{ design_users|map(u => u.id)|json_encode|e('html_attr') }}'
                        data-actions-default="1"
                    >
                        <header class="page-header">
                            <div>
                                <h1>{{ 'design.tables.demo_title'|trans }}</h1>
                                <p class="muted">{{ 'design.tables.demo_hint'|trans }}</p>
                            </div>
                            <div class="actions">
                                <button class="btn btn--primary" type="button">{{ icon('plus') }} {{ 'design.tables.new'|trans }}</button>
                            </div>
                        </header>

                        <div class="toolbar--table">
                            <div class="toolbar">
                                <input
                                    class="input"
                                    type="search"
                                    x-model="query"
                                    placeholder="{{ 'design.tables.search'|trans }}"
                                    autocomplete="off"
                                >
                            </div>
                        </div>

                        <div
                            class="bulk-bar"
                            x-show="selectedCount > 0"
                            x-cloak
                        >
                            <div class="bulk-bar__meta">
                                <strong x-text="selectedCount"></strong>
                                <span>{{ 'design.tables.bulk_selected'|trans }}</span>
                                <button type="button" class="btn btn--link btn--sm" @click="clearSelection">{{ 'design.tables.bulk_clear'|trans }}</button>
                            </div>
                            <div class="bulk-bar__actions">
                                <button type="button" class="btn btn--soft" @click="clearSelection">{{ 'design.tables.bulk_export'|trans }}</button>
                                <button type="button" class="btn btn--danger" @click="clearSelection">{{ 'design.tables.bulk_disable'|trans }}</button>
                            </div>
                        </div>

                        {{ design_users_table|raw }}
                    </div>
                </div>
            </div>

            {# —— 2. Catalog / products with thumbs + numeric cols —— #}
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.tables.catalog_title'|trans }}</h2>
                    <p>{{ 'design.tables.catalog_lead'|trans }}</p>
                </div>
                <div class="design-box__body">
                    <div class="list-shell list-shell--fit">
                        <div class="table-wrap">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>{{ 'design.tables.col_product'|trans }}</th>
                                        <th>{{ 'design.tables.col_sku'|trans }}</th>
                                        <th class="is-num">{{ 'design.tables.col_price'|trans }}</th>
                                        <th class="is-num">{{ 'design.tables.col_stock'|trans }}</th>
                                        <th>{{ 'common.status'|trans }}</th>
                                        <th class="table__actions-head"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for p in design_products %}
                                        <tr>
                                            <td>
                                                <div class="table__title table__title--with-icon">
                                                    {% include 'ui/table_thumb.html.twig' with { src: null, placeholder: true, width: 40, height: 40 } %}
                                                    <div class="table__title-text">
                                                        <a href="#">{{ p.name }}</a>
                                                        <span class="table__meta">{{ p.meta }}</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="is-mute"><code>{{ p.sku }}</code></td>
                                            <td class="is-num">{{ p.price }}</td>
                                            <td class="is-num">{{ p.stock }}</td>
                                            <td>
                                                <span class="status-chip status-chip--tone-{{ p.tone }}">
                                                    <span class="status-chip__dot"></span>
                                                    {% if p.status == 'ok' %}{{ 'design.tables.stock_ok'|trans }}
                                                    {% elseif p.status == 'warn' %}{{ 'design.tables.stock_low'|trans }}
                                                    {% else %}{{ 'design.tables.stock_out'|trans }}{% endif %}
                                                </span>
                                            </td>
                                            {% embed 'ui/row_actions.html.twig' %}
                                                {% block items %}
