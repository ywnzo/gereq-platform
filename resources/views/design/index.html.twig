                </div>
                <div class="design-box__body">
                    <div class="design-row">
                        <button class="btn btn--ghost" type="button" data-design-confirm>{{ 'design.feedback.confirm_btn'|trans }}</button>
                        <button class="btn btn--danger" type="button" data-design-confirm-danger>{{ 'design.feedback.confirm_danger_btn'|trans }}</button>
                        <button class="btn btn--ghost" type="button" data-design-prompt>{{ 'design.feedback.prompt_btn'|trans }}</button>
                        <button class="btn btn--ghost" type="button" data-design-toast="success">{{ 'design.feedback.toast_btn'|trans }}</button>
                        <button class="btn btn--ghost" type="button" data-design-toast="error">Error</button>
                        <button class="btn btn--ghost" type="button" data-design-toast="warning">Warning</button>
                        <button class="btn btn--ghost" type="button" data-design-toast="info">Info</button>
                    </div>
                    <script nonce="{{ csp_nonce() }}">
                        document.querySelector('[data-design-confirm]')?.addEventListener('click', async () => {
                            await window.gereq?.confirm?.({
                                title: {{ 'design.feedback.confirm_title'|trans|json_encode|raw }},
                                body: {{ 'design.feedback.confirm_body'|trans|json_encode|raw }},
                                confirmLabel: {{ 'common.continue'|trans|json_encode|raw }}
                            });
                        });
                        document.querySelector('[data-design-confirm-danger]')?.addEventListener('click', async () => {
                            await window.gereq?.confirm?.({
                                title: {{ 'design.feedback.confirm_danger_title'|trans|json_encode|raw }},
                                body: {{ 'design.feedback.confirm_danger_body'|trans|json_encode|raw }},
                                confirmLabel: {{ 'common.delete'|trans|json_encode|raw }},
                                danger: true
                            });
                        });
                        document.querySelector('[data-design-prompt]')?.addEventListener('click', async () => {
                            await window.gereq?.prompt?.({
                                title: {{ 'design.feedback.prompt_title'|trans|json_encode|raw }},
                                body: {{ 'design.feedback.prompt_body'|trans|json_encode|raw }},
                                inputLabel: {{ 'common.name'|trans|json_encode|raw }},
                                inputValue: 'Demo'
                            });
                        });
                        document.querySelectorAll('[data-design-toast]').forEach((btn) => {
                            btn.addEventListener('click', () => {
                                const tone = btn.getAttribute('data-design-toast') || 'success';
                                window.gereq?.toast?.({{ 'design.feedback.toast_msg'|trans|json_encode|raw }}, tone);
                            });
                        });
                    </script>
                </div>
            </div>
