                <div class="design-box__body">
                    <div class="grq-stack grq-stack--md">
                        {{ ui_render('page_header', {
                            title: 'design.layout.page_title'|trans,
                            meta: 'design.layout.page_meta'|trans,
                            actions: '<button type="button" class="btn btn--primary">' ~ ('common.save'|trans) ~ '</button>'
                        }) }}
                        <section class="panel">
                            <header class="panel__head panel__head--actions">
                                <div>
                                    <h2>{{ 'design.layout.panel_actions'|trans }}</h2>
                                    <p class="muted">{{ 'design.layout.panel_basic_hint'|trans }}</p>
                                </div>
                                <div class="panel__actions">
                                    <button type="button" class="btn btn--ghost btn--sm">{{ 'common.edit'|trans }}</button>
                                    <button type="button" class="btn btn--primary btn--sm">{{ 'common.save'|trans }}</button>
                                </div>
                            </header>
                            <div class="panel__body" style="padding: 14px">
                                <div class="meta-grid">
                                    <div class="meta-tile"><span>{{ 'common.status'|trans }}</span><strong>{{ 'common.active'|trans }}</strong></div>
                                    <div class="meta-tile"><span>{{ 'common.email'|trans }}</span><strong>demo@gereq.cz</strong></div>
                                    <div class="meta-tile"><span>{{ 'design.layout.meta_updated'|trans }}</span><strong>29. 9. 2026</strong></div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="overlay" role="tabpanel">
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.overlay.title'|trans }}</h2>
                    <p>{{ 'design.overlay.lead'|trans }}</p>
                </div>
                <div class="design-box__body">
                    <div class="design-row">
                        <div x-data="gereqModal">
                            <button class="btn btn--primary" type="button" @click="show">{{ 'design.modal.open'|trans }}</button>
                            <div class="g-modal__backdrop" :class="backdropClass" @click="close"></div>
                            <div class="g-modal" :class="panelClass" role="dialog" aria-modal="true" aria-labelledby="demo-modal-title">
                                <div class="g-modal__panel">
                                    <h3 class="g-modal__title" id="demo-modal-title">{{ 'design.modal.title'|trans }}</h3>
                                    <p class="g-modal__body">{{ 'design.modal.body'|trans }}</p>
                                    <div class="g-modal__actions">
                                        <button class="btn btn--ghost" type="button" @click="close" x-ref="close">{{ 'common.cancel'|trans }}</button>
                                        <button class="btn btn--danger" type="button" @click="close">{{ 'design.btn.trash'|trans }}</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{ ui_render('drawer_trigger', {
                            drawer_id: 'design-demo-drawer',
                            label: 'ui.drawer.open'|trans,
                            variant: 'ghost',
                            icon: 'panel'
                        }) }}
                        <button
                            class="btn btn--ghost"
                            type="button"
                            data-drawer-demo-load
                        >{{ 'ui.drawer.demo.load'|trans }}</button>
                        <div class="g-popover" x-data="gereqPopover">
                            <button class="btn btn--ghost" type="button" @click="toggle">{{ 'design.popover'|trans }}</button>
                            <div class="g-popover__panel" :class="panelClass" role="dialog">
                                <strong>{{ 'design.popover.title'|trans }}</strong>
                                <p class="muted" style="margin: 0.4rem 0 0;">{{ 'design.popover.body'|trans }}</p>
                            </div>
                        </div>
                        <button class="btn btn--ghost g-tip" type="button" data-tip="{{ 'design.tooltip.shortcut'|trans }}">{{ 'design.tooltip'|trans }}</button>
                        <div class="g-hovercard">
                            <button class="btn btn--ghost" type="button">{{ 'design.hovercard'|trans }}</button>
                            <div class="g-hovercard__panel">
                                <strong>{{ 'design.hovercard.name'|trans }}</strong>
                                <p class="muted" style="margin: 0.35rem 0 0;">{{ 'design.hovercard.meta'|trans }}</p>
                            </div>
                        </div>
                    </div>
                    {% embed 'ui/drawer.html.twig' with { id: 'design-demo-drawer', title: 'ui.drawer.demo.title'|trans } %}
                        {% block body %}
                            <p class="muted" style="margin:0">{{ 'ui.drawer.demo.body'|trans }}</p>
                            <p>{{ ui_render('badge', { label: 'TOP', tone: 'signal' }) }} {{ ui_render('badge', { label: 'Published', tone: 'ok' }) }}</p>
                        {% endblock %}
                        {% block footer %}
                            <button type="button" class="btn btn--ghost" data-drawer-close>{{ 'common.cancel'|trans }}</button>
                            <button type="button" class="btn btn--primary" data-drawer-close>{{ 'common.save'|trans }}</button>
                        {% endblock %}
                    {% endembed %}
                    <script nonce="{{ csp_nonce() }}">
                        document.querySelector('[data-drawer-demo-load]')?.addEventListener('click', () => {
                            window.gereq?.loadDrawer({
                                title: {{ 'ui.drawer.demo.title'|trans|json_encode|raw }},
                                html: '<p class="muted">' + {{ 'ui.drawer.demo.body'|trans|json_encode|raw }} + '</p>',
                                footer: '<button type="button" class="btn btn--primary" data-drawer-close>' + {{ 'common.cancel'|trans|json_encode|raw }} + '</button>'
                            });
                        });
                    </script>
                </div>
            </div>
        </section>

        <section class="design-panel" data-panel="formular" role="tabpanel">
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.errors.title'|trans }}</h2>
                    <p>{{ 'design.errors.lead'|trans }}</p>
                </div>
                <div class="design-box__body design-settings" x-data="{
                    clear(event) {
                        const field = event.target.closest('.is-invalid');
                        if (!field) return;
                        field.classList.remove('is-invalid');
                        field.querySelectorAll('[aria-invalid]').forEach((node) => node.removeAttribute('aria-invalid'));
                    }
                }" @input="clear" @change="clear">
                    <div class="g-field">
                        <label class="g-label" for="state-ok">{{ 'design.errors.ok'|trans }}</label>
                        <input class="g-control" id="state-ok" value="jiri.novak@gereq.cz">
                        <p class="g-hint">{{ 'design.errors.ok.hint'|trans }}</p>
                    </div>
                    <div class="g-field is-invalid">
                        <label class="g-label" for="state-bad">{{ 'common.email'|trans }}</label>
                        <input class="g-control" id="state-bad" value="neplatny" aria-invalid="true">
                        <p class="g-hint">{{ 'design.errors.email.hint'|trans }}</p>
                        <p class="g-error">{{ 'design.errors.email.error'|trans }}</p>
                    </div>
                    <div class="g-check is-invalid">
                        <label class="g-check__row" for="state-check">
                            <span class="g-check__box">
                                <input id="state-check" class="g-check__input" type="checkbox" aria-invalid="true">
                                <span class="g-check__mark" aria-hidden="true"></span>
                            </span>
                            <span class="g-check__copy">
                                <span class="g-check__label">{{ 'design.errors.consent'|trans }} <span class="g-req">*</span></span>
                            </span>
                        </label>
                        <p class="g-error">{{ 'design.errors.consent.error'|trans }}</p>
                    </div>
                </div>
            </div>
            <div class="design-box">
                <div class="design-box__head">
                    <h2>{{ 'design.live.title'|trans }}</h2>
                    <p>{{ 'design.live.lead'|trans }}</p>
                </div>
                <div class="design-box__body">
                    {% include 'ui/error-summary.html.twig' with { form: 'design.demo' } %}
                    <form method="post" action="{{ url('design.submit') }}" class="design-settings" data-form="design.demo" x-data="gereqForm"{% if form_errors('design.demo') %} data-server-state="1"{% endif %}>
                        {{ csrf_field()|raw }}
                        {% include 'ui/input.html.twig' with { name: 'name', label: 'design.field.name'|trans, hint: 'design.live.name.hint'|trans, form: 'design.demo' } %}
                        {% include 'ui/input.html.twig' with { name: 'email', type: 'email', label: 'common.email'|trans, hint: 'design.live.email.hint'|trans, form: 'design.demo' } %}
                        {% include 'ui/input.html.twig' with { name: 'phone', type: 'tel', label: 'design.field.phone'|trans, prefix: '+420', placeholder: 'design.field.phone.placeholder'|trans, inputmode: 'tel', hint: 'design.live.phone.hint'|trans, form: 'design.demo' } %}
                        {% include 'ui/input.html.twig' with { name: 'website', type: 'url', label: 'design.field.web'|trans, optional: true, placeholder: 'design.live.web.placeholder'|trans, hint: 'design.live.web.hint'|trans, form: 'design.demo' } %}
                        {% include 'ui/select.html.twig' with {
                            name: 'role',
                            label: 'design.field.role'|trans,
                            form: 'design.demo',
                            hint: 'design.live.role.hint'|trans,
                            options: [
                                { value: 'admin', label: 'design.role.admin'|trans },
                                { value: 'editor', label: 'design.role.editor'|trans },
                                { value: 'viewer', label: 'design.role.viewer'|trans }
                            ]
                        } %}
                        {% include 'ui/textarea.html.twig' with {
                            name: 'note',
                            label: 'design.textarea.description'|trans,
                            maxlength: 500,
                            placeholder: 'design.live.note.placeholder'|trans,
                            hint: 'design.live.note.hint'|trans,
                            form: 'design.demo'
                        } %}
                        {% include 'ui/textarea.html.twig' with {
                            name: 'comment',
                            label: 'design.live.comment'|trans,
                            size: 'mini',
                            optional: true,
                            maxlength: 120,
                            placeholder: 'design.live.comment.placeholder'|trans,
                            hint: 'design.live.comment.hint'|trans,
                            form: 'design.demo'
                        } %}
                        {% include 'ui/checkbox.html.twig' with { name: 'terms', label: 'design.live.terms'|trans, form: 'design.demo' } %}
                        <div class="design-submit">
                            <button class="btn btn--ghost" type="reset">{{ 'design.live.reset'|trans }}</button>
                            <button class="btn btn-primary" type="submit">{{ 'design.live.submit'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </div>

    {% include 'ui/confirm_dialog.html.twig' %}
    <div class="toasts" id="toasts" data-close="{{ 'common.close'|trans|e('html_attr') }}" aria-live="polite" aria-relevant="additions"></div>
    <script nonce="{{ csp_nonce() }}">
        window.__GEREQ_COMMANDS__ = [];
        window.__GEREQ_CSRF__ = {{ csrf_token()|json_encode|raw }};
        window.__GEREQ_FORM_CLEARED__ = {{ flash('form_cleared')|json_encode|raw }};
        window.__GEREQ_FORM_FP_CLEARED__ = {{ flash('form_fp_cleared')|json_encode|raw }};
    </script>
    {{ render_js() }}
    {{ render_reload() }}
</body>
</html>
