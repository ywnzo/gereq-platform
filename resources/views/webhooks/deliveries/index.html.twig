{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="webhook-deliveries" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'webhooks.delivery.title'|trans }}</h1>
        {% include 'ui/button.html.twig' with {
            label: 'webhooks.delivery.back'|trans,
            href: (url('admin.developer.webhooks.index')),
            button_options: { tag: 'a' },
            variant: 'ghost'
        } only %}
    </header>

    <div class="toolbar--table">
        {% embed 'ui/toolbar.html.twig' with { table: false, toolbar_options: { tag: 'form' } } %}{% block component_attributes %} class="toolbar" method="get"{% endblock %}{% block content %}
            {% if webhookId %}
                <input type="hidden" name="webhook" value="{{ webhookId }}">
            {% endif %}
            {% if filterWebhook %}
                <span class="badge">{{ 'webhooks.delivery.filter_webhook'|trans({'%name%': filterWebhook.name()}) }}</span>
                {% include 'ui/button.html.twig' with {
                    label: 'webhooks.delivery.cancel_filter'|trans,
                    href: (url('admin.developer.webhook-deliveries.index')),
                    button_options: { tag: 'a' },
                    variant: 'ghost'
                } only %}
            {% endif %}
            {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} name="status" class="input" onchange="this.form.submit()"{% endblock %}{% block native_options %}
                {% include 'ui/option.html.twig' with { value: '', label: 'common.all_statuses'|trans } only %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="pending" {{ status == 'pending' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'webhooks.delivery.status.pending'|trans }}{% endblock %}{% endembed %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="delivered" {{ status == 'delivered' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'webhooks.delivery.status.delivered'|trans }}{% endblock %}{% endembed %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="failed" {{ status == 'failed' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'webhooks.delivery.status.failed'|trans }}{% endblock %}{% endembed %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="retrying" {{ status == 'retrying' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'webhooks.delivery.status.retrying'|trans }}{% endblock %}{% endembed %}
            {% endblock %}{% endembed %}
        {% endblock %}{% endembed %}
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'webhooks.delivery.field.webhook'|trans }}</th>
                    <th>{{ 'webhooks.delivery.field.event'|trans }}</th>
                    <th>{{ 'webhooks.delivery.field.status'|trans }}</th>
                    <th>{{ 'webhooks.field.http'|trans }}</th>
                    <th>{{ 'webhooks.delivery.field.attempt'|trans }}</th>
                    <th>{{ 'webhooks.delivery.field.created'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {% set wh = webhooks[item.webhookId()]|default(null) %}
                            {% if wh %}
                                <a href="{{ url('admin.developer.webhooks.show', {id: wh.id()}) }}">{{ wh.name() }}</a>
                            {% else %}
                                <code>{{ item.webhookId()|slice(0, 8) }}…</code>
                            {% endif %}
                        </td>
                        <td><code>{{ item.eventType() }}</code></td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'delivered' ? 'ok' : (item.status() == 'failed' ? 'danger' : 'warn') }}">
                                {{ item.statusLabel()|trans }}
                            </span>
                        </td>
                        <td>{{ item.responseStatus() ?: '—' }}</td>
                        <td>{{ item.attempt() }}</td>
                        <td>{{ item.createdAt().format('d. m. Y H:i:s') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with { href: url('admin.developer.webhook-deliveries.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">
                            <div class="empty">
                                <h2>{{ 'webhooks.delivery.empty'|trans }}</h2>
                                <p>{{ 'webhooks.delivery.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total > 0 %}
        <footer class="table-footer">
            <span class="muted">{{ ((page - 1) * perPage) + 1 }}–{{ min(page * perPage, total) }} {{ 'common.of'|trans }} {{ total }}</span>
            <nav class="pagination" aria-label="{{ 'common.pagination'|trans }}">
                {% set base = { webhook: webhookId, status: status } %}
                {% if page > 1 %}
                    <a class="pagination__btn" href="?{{ base|merge({ page: page - 1 })|url_encode }}">{{ 'common.previous'|trans }}</a>
                {% else %}
                    <span class="pagination__btn is-disabled">{{ 'common.previous'|trans }}</span>
                {% endif %}
                <span class="pagination__status">{{ page }} / {{ pages }}</span>
                {% if page < pages %}
                    <a class="pagination__btn" href="?{{ base|merge({ page: page + 1 })|url_encode }}">{{ 'common.next'|trans }}</a>
                {% else %}
                    <span class="pagination__btn is-disabled">{{ 'common.next'|trans }}</span>
                {% endif %}
            </nav>
        </footer>
    {% endif %}
</div>
{% endblock %}
