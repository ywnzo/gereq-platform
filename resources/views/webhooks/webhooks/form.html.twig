{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'webhooks.edit'|trans : 'webhooks.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'webhooks.save' } %}

    <form method="post" class="detail-stack" action="{{ item ? url('admin.developer.webhooks.update', {id: item.id()}) : url('admin.developer.webhooks.store') }}" data-form="webhooks.save" x-data="gereqForm"{% if form_errors('webhooks.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <h2>{{ 'common.details'|trans }}</h2>
            </header>
            {{ forms().render(item ?? 'Gereq\\Webhooks\\Domain\\Webhook', {
                form: 'webhooks.save',
                cols: 1,
                values: item ? {} : { timeout_seconds: defaultTimeout }
            }) }}
            {% endblock %}
        {% endembed %}

        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'section' } } %}
            {% block attributes %} class="panel"{% endblock %}
            {% block content %}
            <header class="panel__head">
                <h2>{{ 'webhooks.events'|trans }}</h2>
            </header>
            <p class="muted">{{ 'webhooks.events.hint'|trans }}</p>
            {% set selected = item ? item.events() : ['*'] %}
            {% set availableTypes = availableEvents|map(e => e.type) %}
            <div class="chip-list" style="margin-top: 0.75rem;">
                <label class="check">
                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="events[]" value="*" {{ '*' in selected ? 'checked' : '' }}{% endblock %}{% endembed %}
                    <span>{{ 'webhooks.events.all'|trans }} <code>*</code></span>
                </label>
                {% for event in availableEvents %}
                    <label class="check">
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="events[]" value="{{ event.type }}" {{ event.type in selected ? 'checked' : '' }}{% endblock %}{% endembed %}
                        <span>{{ event.description }} <code>{{ event.type }}</code></span>
                    </label>
                {% endfor %}
                {% for pattern in selected %}
                    {% if pattern != '*' and pattern not in availableTypes %}
                        <label class="check">
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="checkbox" name="events[]" value="{{ pattern }}" checked{% endblock %}{% endembed %}
                            <span>{{ 'webhooks.events.custom'|trans }} <code>{{ pattern }}</code></span>
                        </label>
                    {% endif %}
                {% endfor %}
            </div>
            {% include 'ui/input.html.twig' with {
                name: 'events_custom',
                label: 'webhooks.events.custom_patterns'|trans,
                optional: true,
                form: 'webhooks.save',
                value: '',
                hint: 'webhooks.events.custom_hint'|trans,
                placeholder: 'customer.*, crm.*'
            } %}
            {% endblock %}
        {% endembed %}

        <div class="form-actions">
            {% include 'ui/button.html.twig' with { label: 'common.save'|trans, type: 'submit', variant: 'primary' } only %}
            {% include 'ui/button.html.twig' with {
                label: 'common.cancel'|trans,
                href: (item ? url('admin.developer.webhooks.show', {id: item.id()}) : url('admin.developer.webhooks.index')),
                button_options: { tag: 'a' },
                variant: 'ghost'
            } only %}
        </div>
    </form>
{% endblock %}
