{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="webhooks" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'webhooks.title'|trans }}</h1>
        {% if user.can('webhooks.manage') %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--primary" href="{{ url('admin.developer.webhooks.create') }}"{% endblock %}{% block content %}{{ icon('plus') }} {{ 'webhooks.new'|trans }}{% endblock %}{% endembed %}
        {% endif %}
    </header>

    <div class="toolbar--table">
        {% embed 'ui/toolbar.html.twig' with { table: false, toolbar_options: { tag: 'form' } } %}{% block component_attributes %} class="toolbar" method="get"{% endblock %}{% block content %}
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'webhooks.search'|trans }}"{% endblock %}{% endembed %}
            {% embed 'ui/select.html.twig' with { native: true } %}{% block native_attributes %} name="status" class="input" onchange="this.form.submit()"{% endblock %}{% block native_options %}
                {% include 'ui/option.html.twig' with { value: '', label: 'common.all_statuses'|trans } only %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="active" {{ status == 'active' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'webhooks.status.active'|trans }}{% endblock %}{% endembed %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="paused" {{ status == 'paused' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'webhooks.status.paused'|trans }}{% endblock %}{% endembed %}
                {% embed 'ui/option.html.twig' %}{% block option_attributes %} value="failing" {{ status == 'failing' ? 'selected' : '' }}{% endblock %}{% block content %}{{ 'webhooks.status.failing'|trans }}{% endblock %}{% endembed %}
            {% endblock %}{% endembed %}
        {% endblock %}{% endembed %}
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'webhooks.field.name'|trans }}</th>
                    <th>{{ 'webhooks.field.url'|trans }}</th>
                    <th>{{ 'webhooks.field.events'|trans }}</th>
                    <th>{{ 'webhooks.field.status'|trans }}</th>
                    <th>{{ 'webhooks.field.last_delivery'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            <a href="{{ url('admin.developer.webhooks.show', {id: item.id()}) }}">{{ item.name() }}</a>
                        </td>
                        <td><code class="muted">{{ item.url()|length > 48 ? item.url()|slice(0, 48) ~ '…' : item.url() }}</code></td>
                        <td>
                            {% for event in item.events()|slice(0, 3) %}
                                <span class="badge badge--muted">{{ event }}</span>
                            {% endfor %}
                            {% if item.events()|length > 3 %}
                                <span class="muted">+{{ item.events()|length - 3 }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : (item.status() == 'failing' ? 'warn' : 'muted') }}">
                                {{ item.statusLabel()|trans }}
                            </span>
                        </td>
                        <td>{{ item.lastDeliveryAt() ? item.lastDeliveryAt().format('d. m. Y H:i') : '—' }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with { href: url('admin.developer.webhooks.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                                {% if user.can('webhooks.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.developer.webhooks.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.developer.webhooks.destroy', {id: item.id()}), confirm: 'webhooks.confirm_delete'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'webhooks.empty'|trans }}</h2>
                                <p>{{ 'webhooks.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total > 0 %}
        <footer class="table-footer">
            <span class="muted">{{ ((page - 1) * perPage) + 1 }}–{{ min(page * perPage, total) }} {{ 'common.of'|trans }} {{ total }}</span>
            <nav class="pagination" aria-label="{{ 'common.pagination'|trans }}">
                {% set base = { q: search, status: status } %}
                {% if page > 1 %}
                    <a class="pagination__btn" href="?{{ base|merge({ page: page - 1 })|url_encode }}">{{ 'common.previous'|trans }}</a>
                {% else %}
                    <span class="pagination__btn is-disabled">{{ 'common.previous'|trans }}</span>
                {% endif %}
                <span class="pagination__status">{{ page }} / {{ pages }}</span>
                {% if page < pages %}
                    <a class="pagination__btn" href="?{{ base|merge({ page: page + 1 })|url_encode }}">{{ 'common.next'|trans }}</a>
                {% else %}
                    <span class="pagination__btn is-disabled">{{ 'common.next'|trans }}</span>
                {% endif %}
            </nav>
        </footer>
    {% endif %}
</div>
{% endblock %}
