<!DOCTYPE html>
<html lang="{{ app_locale() }}" data-theme="gereq" data-url-prefix="{{ config('app.url_prefix') }}" style="{{ brand_html_style() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pageTitle|default('auth.login.title'|trans) }} · {{ brand('name') }}</title>
    {% include 'partials/brand-head.html.twig' %}
    {% if vite_hot() %}
        {{ vite_tags() }}
    {% else %}
        <link rel="stylesheet" href="{{ asset('resources/css/kernel.css') }}">
    {% endif %}
    {% include 'partials/brand-overrides.html.twig' %}
</head>
<body class="auth-body">
    <main class="auth-shell">
        <section class="auth-panel">
            {% include 'partials/brand-lockup.html.twig' with { href: url('admin.login'), modifier: 'brand--auth', subtitle: 'brand.subtitle' } %}
            {% set flashes_success = flash('success') %}
            {% set flashes_error = flash('error') %}
            {% if flashes_success %}
                {% for message in flashes_success %}
                    <div class="alert alert-success alert--success">{{ message }}</div>
                {% endfor %}
            {% endif %}
            {% if flashes_error %}
                {% for message in flashes_error %}
                    <div class="alert alert-error alert--danger">{{ message }}</div>
                {% endfor %}
            {% endif %}
            {% block content %}{% endblock %}
        </section>
        <p class="auth-footnote">{% set brandFoot = brand('footnote') %}{{ brandFoot != '' ? brandFoot : ('brand.footnote'|trans({'%version%': app_version()})) }}</p>
    </main>
    <script nonce="{{ csp_nonce() }}">
        window.__GEREQ_COMMANDS__ = [];
        window.__GEREQ_CSRF__ = {{ csrf_token()|json_encode|raw }};
        window.__GEREQ_FORM_CLEARED__ = {{ flash('form_cleared')|json_encode|raw }};
        window.__GEREQ_FORM_FP_CLEARED__ = {{ flash('form_fp_cleared')|json_encode|raw }};
    </script>
    {% if not vite_hot() %}
        <script type="module" nonce="{{ csp_nonce() }}" src="{{ asset('resources/js/admin.ts') }}"></script>
    {% endif %}
</body>
</html>
