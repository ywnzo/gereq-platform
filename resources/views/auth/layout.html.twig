<!DOCTYPE html>
<html lang="{{ app_locale() }}" data-theme="gereq" data-url-prefix="{{ config('app.url_prefix') }}" data-admin-path="/{{ config('admin.path') }}" style="{{ brand_html_style() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pageTitle|default('auth.login.title'|trans) }} · {{ brand('name') }}</title>
    {% include 'partials/brand-head.html.twig' with { admin_favicon: true } %}
    {{ render_css() }}
    {% include 'partials/brand-overrides.html.twig' %}
</head>
<body class="auth-body">
    <main class="auth-shell">
        <section class="auth-panel">
            {% include 'partials/brand-lockup.html.twig' with { href: url('admin.login'), modifier: 'brand--auth', subtitle: 'brand.subtitle' } %}
            {% set flashes_success = flash('success') %}
            {% set flashes_error = flash('error') %}
            {% if flashes_success %}
                {% for message in flashes_success %}
                    {% embed 'ui/alert.html.twig' with { alert_options: { tag: 'div' } } %}{% block component_attributes %} class="alert alert-success alert--success"{% endblock %}{% block content %}{{ message }}{% endblock %}{% endembed %}
                {% endfor %}
            {% endif %}
            {% if flashes_error %}
                {% for message in flashes_error %}
                    {% embed 'ui/alert.html.twig' with { alert_options: { tag: 'div' } } %}{% block component_attributes %} class="alert alert-error alert--danger"{% endblock %}{% block content %}{{ message }}{% endblock %}{% endembed %}
                {% endfor %}
            {% endif %}
            {% block content %}{% endblock %}
        </section>
        <p class="auth-footnote">{% set brandFoot = brand('footnote') %}{{ brandFoot != '' ? brandFoot : ('brand.footnote'|trans({'%version%': app_version()})) }}</p>
    </main>
    <script nonce="{{ csp_nonce() }}">
        window.__GEREQ_COMMANDS__ = [];
        window.__GEREQ_CSRF__ = {{ csrf_token()|json_encode|raw }};
        window.__GEREQ_FORM_CLEARED__ = {{ flash('form_cleared')|json_encode|raw }};
        window.__GEREQ_FORM_FP_CLEARED__ = {{ flash('form_fp_cleared')|json_encode|raw }};
    </script>
    {{ render_js() }}
    {{ render_reload() }}
</body>
</html>
