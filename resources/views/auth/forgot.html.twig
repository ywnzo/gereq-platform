{% extends 'auth/layout.html.twig' %}

{% block content %}
    <h1>{{ 'auth.forgot.title'|trans }}</h1>
    <p class="muted">{{ 'auth.forgot.subtitle'|trans }}</p>
    <form method="post" action="{{ url('admin.password.email') }}" class="stack">
        {{ csrf_field()|raw }}
        <label class="field">
            <span>{{ 'common.email'|trans }}</span>
            <input type="email" name="email" required>
        </label>
        <button type="submit" class="btn btn--primary btn--block">{{ 'auth.forgot.submit'|trans }}</button>
        <a class="text-link" href="{{ url('admin.login') }}">{{ 'auth.forgot.back'|trans }}</a>
    </form>
{% endblock %}
