{% extends 'auth/layout.html.twig' %}

{% block content %}
    <h1>{{ 'auth.forgot.title'|trans }}</h1>
    <p class="muted">{{ 'auth.forgot.subtitle'|trans }}</p>
    <form method="post" action="{{ url('admin.password.email') }}" class="stack">
        {{ csrf_field()|raw }}
        <label class="field">
            <span>{{ 'common.email'|trans }}</span>
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="email" name="email" required{% endblock %}{% endembed %}
        </label>
        {% include 'ui/button.html.twig' with {
            label: 'auth.forgot.submit'|trans,
            type: 'submit',
            variant: 'primary',
            block: true
        } only %}
        <a class="text-link" href="{{ url('admin.login') }}">{{ 'auth.forgot.back'|trans }}</a>
    </form>
{% endblock %}
