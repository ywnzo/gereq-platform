{% extends 'auth/layout.html.twig' %}

{% block content %}
    <h1>{{ 'auth.login.welcome'|trans }}</h1>
    <p class="muted">{{ 'auth.login.subtitle'|trans }}</p>
    {% include 'ui/error-summary.html.twig' with { form: 'auth.login' } %}
    <form method="post" action="{{ url('admin.login.submit') }}" class="stack" data-form="auth.login" x-data="gereqForm"{% if form_errors('auth.login') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {% include 'ui/input.html.twig' with {
            name: 'email',
            type: 'email',
            label: 'common.email'|trans,
            required: true,
            autocomplete: 'username',
            form: 'auth.login'
        } %}
        {% include 'ui/input.html.twig' with {
            name: 'password',
            type: 'password',
            label: 'common.password'|trans,
            required: true,
            autocomplete: 'current-password',
            form: 'auth.login'
        } %}
        {% include 'ui/checkbox.html.twig' with {
            name: 'remember',
            label: 'auth.login.remember'|trans,
            form: 'auth.login'
        } %}
        <button type="submit" class="btn btn--primary btn--block">{{ 'auth.login.submit'|trans }}</button>
        <a class="text-link" href="{{ url('admin.password.forgot') }}">{{ 'auth.login.forgot'|trans }}</a>
    </form>
{% endblock %}
