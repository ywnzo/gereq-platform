{% extends 'auth/layout.html.twig' %}

{% block content %}
    <h1>Vítejte zpět</h1>
    <p class="muted">Přihlaste se do interní platformy GEREQ.</p>
    {% include 'ui/error-summary.html.twig' with { form: 'auth.login' } %}
    <form method="post" action="{{ url('admin.login.submit') }}" class="stack" data-form="auth.login" x-data="gereqForm"{% if form_errors('auth.login') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {% include 'ui/input.html.twig' with {
            name: 'email',
            type: 'email',
            label: 'E-mail',
            required: true,
            autocomplete: 'username',
            form: 'auth.login'
        } %}
        {% include 'ui/input.html.twig' with {
            name: 'password',
            type: 'password',
            label: 'Heslo',
            required: true,
            autocomplete: 'current-password',
            form: 'auth.login'
        } %}
        {% include 'ui/checkbox.html.twig' with {
            name: 'remember',
            label: 'Zapamatovat přihlášení',
            form: 'auth.login'
        } %}
        <button type="submit" class="btn btn--primary btn--block">Přihlásit se</button>
        <a class="text-link" href="{{ url('admin.password.forgot') }}">Zapomenuté heslo</a>
    </form>
{% endblock %}
