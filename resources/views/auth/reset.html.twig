{% extends 'auth/layout.html.twig' %}

{% block content %}
    <h1>{{ 'auth.reset.title'|trans }}</h1>
    <form method="post" action="{{ url('admin.password.update', {token: token}) }}" class="stack">
        {{ csrf_field()|raw }}
        <label class="field">
            <span>{{ 'auth.reset.password'|trans }}</span>
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="password" name="password" minlength="10" required{% endblock %}{% endembed %}
        </label>
        <label class="field">
            <span>{{ 'auth.reset.confirm'|trans }}</span>
            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="password" name="password_confirmation" minlength="10" required{% endblock %}{% endembed %}
        </label>
        {% include 'ui/button.html.twig' with { label: 'auth.reset.submit'|trans, type: 'submit', variant: 'primary', block: true } only %}
    </form>
{% endblock %}
