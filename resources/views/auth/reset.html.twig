{% extends 'auth/layout.html.twig' %}

{% block content %}
    <h1>{{ 'auth.reset.title'|trans }}</h1>
    <form method="post" action="{{ url('admin.password.update', {token: token}) }}" class="stack">
        {{ csrf_field()|raw }}
        <label class="field">
            <span>{{ 'auth.reset.password'|trans }}</span>
            <input type="password" name="password" minlength="10" required>
        </label>
        <label class="field">
            <span>{{ 'auth.reset.confirm'|trans }}</span>
            <input type="password" name="password_confirmation" minlength="10" required>
        </label>
        <button type="submit" class="btn btn--primary btn--block">{{ 'auth.reset.submit'|trans }}</button>
    </form>
{% endblock %}
