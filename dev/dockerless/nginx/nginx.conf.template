# GEREQ dockerless — user-space nginx (prefix = @GEREQ_HOME@)
# Run: nginx -p "@GEREQ_HOME@/" -c conf/nginx.conf

worker_processes auto;
error_log @GEREQ_HOME@/logs/nginx-error.log warn;
pid       @GEREQ_HOME@/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    types_hash_max_size 4096;
    sendfile      on;
    keepalive_timeout 65;
    client_max_body_size 64M;

    access_log @GEREQ_HOME@/logs/nginx-access.log;
    client_body_temp_path @GEREQ_HOME@/tmp/client_body;
    proxy_temp_path       @GEREQ_HOME@/tmp/proxy;
    fastcgi_temp_path     @GEREQ_HOME@/tmp/fastcgi;
    uwsgi_temp_path       @GEREQ_HOME@/tmp/uwsgi;
    scgi_temp_path        @GEREQ_HOME@/tmp/scgi;

    upstream php_fpm {
        server unix:@GEREQ_HOME@/run/php-fpm.sock;
        keepalive 8;
    }

    include @GEREQ_HOME@/conf/site.conf;
}
