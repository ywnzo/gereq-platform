# GEREQ dockerless site — HTTP only, binds high port (no root needed).
server {
    listen @GEREQ_PORT@;
    listen [::]:@GEREQ_PORT@;
    server_name _;
    root @ROOT@/public;
    index index.php;

    charset utf-8;
    client_max_body_size 64M;

    # Vite HMR (bun run dev on :5173) — same-origin proxy for dockerless.
    location ~ ^/(@vite|@fs|@id|node_modules|resources|modules)/ {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
    }

    location = /build/manifest.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
        access_log off;
    }
    location = /build/.vite/manifest.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
        access_log off;
    }
    location = /build/.dev {
        add_header Cache-Control "no-store";
        try_files $uri =404;
        access_log off;
    }
    location /build/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    location ~ \.php$ {
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass php_fpm;
        fastcgi_keep_conn on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 120s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
