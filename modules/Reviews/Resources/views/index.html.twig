{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header"><h1>{{ 'reviews.title'|trans }}</h1></header>
<form class="toolbar" method="get">
<input type="hidden" name="sort" value="{{ sort }}">
<input type="hidden" name="dir" value="{{ dir }}">
<input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'reviews.search'|trans }}">
<select name="status" class="input" onchange="this.form.submit()"><option value="">{{ 'reviews.all_statuses'|trans }}</option>
{% for s in statuses %}<option value="{{ s }}" {{ status==s?'selected':'' }}>{{ ('reviews.status.'~s)|trans }}</option>{% endfor %}
</select></form>
<div class="table-wrap" data-table><table class="table"><thead><tr>
<th>{{ 'reviews.field.author'|trans }}</th>
<th>{{ 'reviews.field.product'|trans }}</th>
{% include 'ui/sort_th.html.twig' with { label: 'reviews.field.rating'|trans, column: 'rating', query: { status: status } } %}
{% include 'ui/sort_th.html.twig' with { label: 'reviews.field.status'|trans, column: 'status', query: { status: status } } %}
{% include 'ui/sort_th.html.twig' with { label: 'reviews.field.created'|trans, column: 'createdAt', query: { status: status } } %}
<th></th>
</tr></thead>
<tbody>{% for item in items %}
<tr><td><a href="{{ url('admin.reviews.show',{id:item.id()}) }}">{{ item.authorName() }}</a>
{% if item.title() %}<div class="muted">{{ item.title() }}</div>{% endif %}</td>
<td><code>{{ item.productId() }}</code></td>
<td>{{ item.rating() }}/5</td>
<td><span class="badge">{{ item.statusLabel()|trans }}</span></td>
<td class="is-mute">{{ item.createdAt().format('d. m. Y H:i') }}</td>
<td class="table__actions">
<a href="{{ url('admin.reviews.show',{id:item.id()}) }}">{{ 'common.detail'|trans }}</a>
{% if user.can('reviews.manage') and item.status()=='pending' %}
<form method="post" action="{{ url('admin.reviews.approve',{id:item.id()}) }}" style="display:inline">{{ csrf_field()|raw }}
<button type="submit">{{ 'reviews.action.approve'|trans }}</button></form>
<form method="post" action="{{ url('admin.reviews.reject',{id:item.id()}) }}" style="display:inline">{{ csrf_field()|raw }}
<button type="submit">{{ 'reviews.action.reject'|trans }}</button></form>
{% endif %}
</td></tr>
{% else %}<tr><td colspan="6"><div class="empty"><h2>{{ 'reviews.empty'|trans }}</h2></div></td></tr>{% endfor %}
</tbody></table></div>
{% include 'ui/table_footer.html.twig' %}
{% endblock %}
