{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.reviews'|trans, url: url('admin.reviews.index') },
        { label: 'reviews.settings.title'|trans },
    ] } %}
{% endblock %}

{% macro control(field) %}
    {% if field.definition.type == 'boolean' %}
        <select class="input" name="{{ field.field }}">
            <option value="1" {{ field.value ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
            <option value="0" {{ not field.value ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
        </select>
    {% elseif field.secret %}
        <input class="input" type="password" name="{{ field.field }}" value="" autocomplete="new-password" placeholder="{{ field.value ? ('settings.secret.placeholder'|trans) : '' }}">
    {% else %}
        <input class="input" type="text" name="{{ field.field }}" value="{{ field.value }}">
    {% endif %}
{% endmacro %}

{% block content %}
    {% import _self as ui %}

    <header class="page-header">
        <div>
            <h1>{{ 'reviews.settings.title'|trans }}</h1>
            <p class="muted">{{ 'reviews.settings.intro'|trans }}</p>
        </div>
        <div class="actions">
            <button class="btn btn--primary" type="submit" form="reviews-settings-form">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.reviews.index') }}">{{ 'common.back'|trans }}</a>
        </div>
    </header>

    <form id="reviews-settings-form" method="post" action="{{ url('admin.reviews.settings.update') }}" class="detail-stack" autocomplete="off">
        {{ csrf_field()|raw }}

        {% for section in ['google', 'facebook', 'general'] %}
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ ('reviews.settings.section.' ~ section)|trans }}</h2>
                        <p class="muted">{{ ('reviews.settings.section.' ~ section ~ '_hint')|trans }}</p>
                    </div>
                </header>
                <div class="form-grid">
                    {% for key in sections[section] %}
                        {% if fields[key] is defined %}
                            <label class="field">
                                <span>{{ fields[key].definition.label|trans }}</span>
                                {{ ui.control(fields[key]) }}
                            </label>
                        {% endif %}
                    {% endfor %}
                </div>
            </section>
        {% endfor %}

        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.reviews.index') }}">{{ 'common.back'|trans }}</a>
        </div>
    </form>
{% endblock %}
