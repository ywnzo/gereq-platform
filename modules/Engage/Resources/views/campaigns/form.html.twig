{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.engage'|trans, url: url('admin.engage.hub') },
        { label: 'nav.engage.campaigns'|trans, url: url('admin.engage.campaigns.index') },
        { label: item ? 'engage.campaigns.edit'|trans : 'engage.campaigns.new'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ item ? 'engage.campaigns.edit'|trans : 'engage.campaigns.new'|trans }}</h1>
        <p class="muted">{{ 'engage.campaigns.form_intro'|trans }}</p>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'engage.campaign.save' } %}

{% set campaignSource = item ?? 'Modules\\Engage\\Domain\\Campaign' %}

<form method="post" class="detail-stack" enctype="multipart/form-data" action="{{ item ? url('admin.engage.campaigns.update', {id: item.id()}) : url('admin.engage.campaigns.store') }}" data-form="engage.campaign.save" x-data="gereqForm"{% if form_errors('engage.campaign.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'engage.section.campaign'|trans }}</h2>
        </header>
        {{ forms().render(campaignSource, { form: 'engage.campaign.save', cols: 1, wrap: false }) }}
        <label class="field">
            <span>{{ 'engage.field.cms_page_id'|trans }}</span>
            <select class="input" name="cms_page_id">
                <option value="">{{ 'engage.field.cms_page_id.empty'|trans }}</option>
                {% for page in cmsPages %}
                    <option value="{{ page.id }}" {{ item and item.cmsPageId() == page.id ? 'selected' : '' }}>{{ page.label }}</option>
                {% endfor %}
            </select>
            <span class="field__hint">{{ 'engage.field.cms_page_id.hint'|trans }}</span>
        </label>
        {% include 'ui/media_box.html.twig' with {
            name: 'og_image_url',
            file_name: 'og_image_file',
            library_name: 'og_media_asset_id',
            clear_name: 'clear_og_image',
            label: 'engage.field.og_image_url'|trans,
            optional: true,
            form: 'engage.campaign.save',
            value: item and item.ogImageUrl() ? item.ogImageUrl() : '',
            hint: 'engage.field.og_image_url.hint'|trans,
            has_media: hasMedia|default(false),
            library: libraryImages|default([])
        } %}
    </section>

    {% if serialized %}
    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'engage.section.tracking'|trans }}</h2>
            <p class="muted">{{ 'engage.section.tracking_hint'|trans }}</p>
        </header>
        <dl class="meta-list meta-list--flush">
            <div class="meta-list__full"><dt>{{ 'engage.field.tracking_url'|trans }}</dt><dd><code>{{ serialized.tracking.url }}</code></dd></div>
            <div class="meta-list__full"><dt>UTM</dt><dd><code>utm_source={{ serialized.utm.source|default('—') }} · utm_medium={{ serialized.utm.medium|default('—') }} · utm_campaign={{ serialized.utm.campaign }}</code></dd></div>
        </dl>
        {% if route_exists('admin.webplus.metas.index') and user.can('webplus.view') %}
            <p class="muted">{{ 'engage.hint.webplus'|trans }}
                <a href="{{ url('admin.webplus.metas.index') }}">Web+</a>
            </p>
        {% endif %}
    </section>
    {% endif %}

    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.engage.campaigns.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
