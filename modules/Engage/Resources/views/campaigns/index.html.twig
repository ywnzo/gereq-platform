{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.engage'|trans, url: url('admin.engage.hub') },
        { label: 'nav.engage.campaigns'|trans },
    ] } %}
{% endblock %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="engage-campaigns" data-actions-default="1">
<header class="page-header">
    <div>
        <h1>{{ 'engage.campaigns.title'|trans }}</h1>
        <p class="muted">{{ 'engage.campaigns.intro'|trans }}</p>
    </div>
    <div class="actions">
        {% if user.can('engage.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.engage.campaigns.create') }}">{{ icon('plus') }} {{ 'engage.campaigns.new'|trans }}</a>
        {% endif %}
    </div>
</header>

{% include '@engage/partials/_hub_tabs.html.twig' with { active: 'campaigns' } %}

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'engage.campaigns.search'|trans }}">
        <select name="active" class="input" onchange="this.form.submit()">
            <option value="">{{ 'common.all'|trans }}</option>
            <option value="1" {{ active == '1' ? 'selected' : '' }}>{{ 'engage.active'|trans }}</option>
            <option value="0" {{ active == '0' ? 'selected' : '' }}>{{ 'engage.inactive'|trans }}</option>
        </select>
    </form>
</div>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
{% include 'ui/sort_th.html.twig' with { label: 'engage.field.name'|trans, column: 'name', query: { active: active } } %}
{% include 'ui/sort_th.html.twig' with { label: 'engage.field.slug'|trans, column: 'slug', query: { active: active } } %}
<th>{{ 'engage.field.active'|trans }}</th>
{% include 'ui/sort_th.html.twig' with { label: 'engage.field.updated'|trans, column: 'updatedAt', query: { active: active } } %}
<th class="table__actions-head"></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><a href="{{ url('admin.engage.campaigns.edit', {id: item.id()}) }}"><strong>{{ item.name() }}</strong></a></td>
    <td><code>?mkind={{ item.slug() }}</code></td>
    <td>{{ item.isActive() ? 'engage.active'|trans : 'engage.inactive'|trans }}</td>
    <td class="is-mute">{{ item.updatedAt().format('d. m. Y') }}</td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% include 'ui/row_action.html.twig' with { href: url('admin.engage.campaigns.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
            {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.engage.campaigns.destroy', {id: item.id()}), confirm: 'engage.confirm_delete_campaign'|trans } %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr><td colspan="5"><div class="empty"><h2>{{ 'engage.campaigns.empty'|trans }}</h2></div></td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
