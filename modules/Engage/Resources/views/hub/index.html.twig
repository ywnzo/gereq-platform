{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.engage'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'engage.hub.title'|trans }}</h1>
        <p class="muted">{{ 'engage.hub.intro'|trans }}</p>
    </div>
    <div class="actions">
        {% if user.can('engage.manage') %}
            <a class="btn btn--ghost" href="{{ url('admin.engage.spots.create') }}">{{ icon('plus') }} {{ 'engage.spots.new'|trans }}</a>
            <a class="btn btn--primary" href="{{ url('admin.engage.campaigns.create') }}">{{ icon('plus') }} {{ 'engage.campaigns.new'|trans }}</a>
        {% endif %}
    </div>
</header>

{% include '@engage/partials/_hub_tabs.html.twig' with { active: 'hub' } %}

<section class="panel">
    <header class="panel__head">
        <h2>{{ 'engage.hub.stats'|trans }}</h2>
    </header>
    <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr))">
        <div>
            <div class="muted">{{ 'engage.hub.stat.campaigns'|trans }}</div>
            <strong style="font-size:1.4rem">{{ stats.active_campaigns }} / {{ stats.campaigns }}</strong>
        </div>
        <div>
            <div class="muted">{{ 'engage.hub.stat.spots'|trans }}</div>
            <strong style="font-size:1.4rem">{{ stats.active_spots }} / {{ stats.spots }}</strong>
        </div>
    </div>
</section>

<section class="panel">
    <header class="panel__head">
        <h2>{{ 'engage.hub.bridges'|trans }}</h2>
        <p class="muted">{{ 'engage.hub.bridges_hint'|trans }}</p>
    </header>
    <div class="form-grid">
        {% for bridge in bridges %}
            <div class="field field--full" style="border:1px solid var(--gereq-line,#e5e7eb);padding:0.85rem 1rem">
                <div style="display:flex;justify-content:space-between;gap:0.75rem;align-items:center">
                    <strong>{{ bridge.label|trans }}</strong>
                    {% if bridge.available %}
                        <span class="badge">{{ 'engage.hub.connected'|trans }}</span>
                    {% else %}
                        <span class="badge badge--muted">{{ 'engage.hub.missing'|trans }}</span>
                    {% endif %}
                </div>
                <p class="muted" style="margin:0.35rem 0 0">{{ bridge.hint|trans }}</p>
                {% if bridge.available and bridge.route and route_exists(bridge.route) %}
                    <p style="margin:0.55rem 0 0">
                        <a class="btn btn--ghost" href="{{ url(bridge.route) }}">{{ 'engage.hub.open'|trans }}</a>
                    </p>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</section>

<section class="panel">
    <header class="panel__head">
        <h2>{{ 'engage.hub.api'|trans }}</h2>
        <p class="muted">{{ 'engage.hub.api_hint'|trans }}</p>
    </header>
    <dl class="meta-list meta-list--flush">
        <div class="meta-list__full"><dt>campaign</dt><dd><code>/api/public/engage/campaign?mkind={slug}</code></dd></div>
        <div class="meta-list__full"><dt>spots</dt><dd><code>/api/public/engage/spots?placement=homepage_hero</code></dd></div>
        <div class="meta-list__full"><dt>spot</dt><dd><code>/api/public/engage/spot?placement=homepage_hero</code></dd></div>
    </dl>
</section>
{% endblock %}
