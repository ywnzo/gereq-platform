{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.engage'|trans, url: url('admin.engage.hub') },
        { label: 'nav.engage.spots'|trans, url: url('admin.engage.spots.index') },
        { label: item ? 'engage.spots.edit'|trans : 'engage.spots.new'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ item ? 'engage.spots.edit'|trans : 'engage.spots.new'|trans }}</h1>
        <p class="muted">{{ 'engage.spots.form_intro'|trans }}</p>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'engage.spot.save' } %}

{% set spotSource = item ?? 'Modules\\Engage\\Domain\\Spot' %}

<form method="post" class="detail-stack" enctype="multipart/form-data" action="{{ item ? url('admin.engage.spots.update', {id: item.id()}) : url('admin.engage.spots.store') }}" data-form="engage.spot.save" x-data="gereqForm"{% if form_errors('engage.spot.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'engage.section.spot'|trans }}</h2>
            <p class="muted">{{ 'engage.section.spot_hint'|trans }}</p>
        </header>
        {{ forms().render(spotSource, { form: 'engage.spot.save', cols: 1, wrap: false }) }}

        <label class="field">
            <span>{{ 'engage.field.cms_page_id'|trans }}</span>
            <select class="input" name="cms_page_id">
                <option value="">{{ 'engage.field.cms_page_id.empty'|trans }}</option>
                {% for page in cmsPages %}
                    <option value="{{ page.id }}" {{ item and item.cmsPageId() == page.id ? 'selected' : '' }}>{{ page.label }}</option>
                {% endfor %}
            </select>
            <span class="field__hint">{{ 'engage.field.cms_page_id.spot_hint'|trans }}</span>
        </label>

        <label class="field">
            <span>{{ 'engage.field.campaign_id'|trans }}</span>
            <select class="input" name="campaign_id">
                <option value="">{{ 'engage.field.campaign_id.empty'|trans }}</option>
                {% for campaign in campaigns %}
                    <option value="{{ campaign.id }}" {{ item and item.campaignId() == campaign.id ? 'selected' : '' }}>{{ campaign.label }}</option>
                {% endfor %}
            </select>
        </label>

        <label class="field">
            <span>{{ 'engage.field.ref_id'|trans }}</span>
            <input class="input" type="text" name="ref_id" value="{{ item and item.refId() ? item.refId() : '' }}" placeholder="UUID">
            <span class="field__hint">{{ 'engage.field.ref_id.hint'|trans }}</span>
        </label>

        {% include 'ui/media_box.html.twig' with {
            name: 'image_url',
            file_name: 'image_file',
            library_name: 'image_media_asset_id',
            clear_name: 'clear_image',
            label: 'engage.field.image_url'|trans,
            optional: true,
            form: 'engage.spot.save',
            value: item and item.imageUrl() ? item.imageUrl() : '',
            has_media: hasMedia|default(false),
            library: libraryImages|default([])
        } %}

        {% if placements is not empty %}
            <p class="muted">{{ 'engage.placements.hint'|trans }}:
                {% for key in placements %}<code>{{ key }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
            </p>
        {% endif %}
    </section>

    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.engage.spots.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
