{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'crm.activities.edit'|trans : 'crm.activities.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'crm.activity.save' } %}

    {% set activitySource = item ?? 'Modules\\CRM\\Domain\\Activity' %}
    {% set dealSelectOptions = [{ value: '', label: 'crm.activities.no_deal'|trans }]|merge(dealOptions|default([])) %}
    {% set activityValues = {
        customer_id: item ? item.customerId() : customerId,
        deal_id: item ? (item.dealId() ?: '') : dealId,
        type: item ? item.type() : 'task',
        due_at: item and item.dueAt() ? item.dueAt().format('Y-m-d\\TH:i') : '',
    } %}

    <form method="post" class="detail-stack" action="{{ item ? url('admin.crm.activities.update', {id: item.id()}) : url('admin.crm.activities.store') }}" data-form="crm.activity.save" x-data="gereqForm"{% if form_errors('crm.activity.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        <section class="panel">
            <header class="panel__head">
                <h2>{{ 'common.details'|trans }}</h2>
            </header>
            {{ forms().render(activitySource, {
                form: 'crm.activity.save',
                cols: 2,
                values: activityValues,
                choices: {
                    customer_id: customerOptions,
                    deal_id: dealSelectOptions
                }
            }) }}
        </section>
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.crm.activities.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </form>
{% endblock %}
