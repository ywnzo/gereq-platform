{% if activities is empty %}
    <div class="empty">
        <p>{{ 'crm.activities.partial.empty'|trans }}</p>
        {% if user is defined and user.can('crm.activities.manage') %}
            <a class="btn btn--ghost" href="{{ url('admin.crm.activities.create') }}?customer={{ customer.id() }}">{{ 'crm.activities.partial.add'|trans }}</a>
        {% endif %}
    </div>
{% else %}
    <ul class="crm-timeline">
        {% for activity in activities %}
            <li class="crm-timeline__item{% if activity.isCompleted() %} is-done{% endif %}">
                <span class="badge">{{ activity.typeLabel()|trans }}</span>
                <div>
                    <strong>{{ activity.subject() }}</strong>
                    {% if activity.dueAt() %}
                        <span class="muted"> · {{ activity.dueAt().format('d. m. Y H:i') }}</span>
                    {% endif %}
                    {% if activity.body() %}
                        <p class="muted">{{ activity.body()|striptags|slice(0, 140) }}</p>
                    {% endif %}
                </div>
                {% if user is defined and user.can('crm.activities.manage') %}
                    <a href="{{ url('admin.crm.activities.edit', {id: activity.id()}) }}">{{ 'common.edit'|trans }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
    <p class="muted"><a href="{{ url('admin.crm.activities.index') }}?customer={{ customer.id() }}">{{ 'crm.activities.partial.all'|trans }}</a></p>
{% endif %}
