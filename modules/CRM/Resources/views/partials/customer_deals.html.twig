{% if deals is empty %}
    <div class="empty">
        <p>{{ 'crm.deals.partial.empty'|trans }}</p>
        {% if user is defined and user.can('crm.deals.manage') %}
            <a class="btn btn--ghost" href="{{ url('admin.crm.deals.create') }}?customer={{ customer.id() }}">{{ 'crm.deals.partial.add'|trans }}</a>
        {% endif %}
    </div>
{% else %}
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'crm.field.title'|trans }}</th>
                    <th>{{ 'crm.field.stage'|trans }}</th>
                    <th>{{ 'crm.field.amount'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for deal in deals %}
                    <tr>
                        <td><a href="{{ url('admin.crm.deals.show', {id: deal.id()}) }}">{{ deal.title() }}</a></td>
                        <td><span class="badge">{{ deal.stageLabel()|trans }}</span></td>
                        <td>{{ deal.amountFormatted() }}</td>
                        <td class="table__actions">
                            <a href="{{ url('admin.crm.deals.show', {id: deal.id()}) }}">{{ 'common.detail'|trans }}</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="muted"><a href="{{ url('admin.crm.deals.index') }}?customer={{ customer.id() }}">{{ 'crm.deals.partial.all'|trans }}</a></p>
{% endif %}
