{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="crm-workflows" data-actions-default="1">
    <header class="page-header">
        <div>
            <h1>{{ 'crm.workflows.title'|trans }}</h1>
            <p class="muted">{{ 'crm.workflows.hint'|trans }}</p>
        </div>
        <div class="actions">
            {% if user.can('crm.workflows.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.crm.workflows.create') }}">{{ icon('plus') }} {{ 'crm.workflows.new'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="table-wrap" data-table>
        <table class="table table--crm-workflows">
            <thead>
                <tr>
                    <th>{{ 'crm.field.title'|trans }}</th>
                    <th>{{ 'crm.workflows.trigger'|trans }}</th>
                    <th>{{ 'crm.workflows.status'|trans }}</th>
                    <th>{{ 'crm.workflows.nodes'|trans }}</th>
                    <th>{{ 'crm.workflows.updated'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for w in items %}
                    {% set trigger = w.triggerEvent() %}
                    <tr>
                        <td>
                            <a class="cell-user cell-user--stack" href="{{ url('admin.crm.workflows.edit', {id: w.id()}) }}">
                                <span class="avatar avatar--sm">{{ w.name()|slice(0, 1)|upper }}</span>
                                <span class="cell-user__text">
                                    <strong>{{ w.name() }}</strong>
                                    {% if w.description() %}
                                        <small class="muted">{{ w.description()|slice(0, 80) }}{% if w.description()|length > 80 %}…{% endif %}</small>
                                    {% endif %}
                                </span>
                            </a>
                        </td>
                        <td>
                            {% if trigger %}
                                <span class="badge badge--info">{{ ('crm.event.' ~ trigger)|trans }}</span>
                            {% else %}
                                <span class="muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if w.isActive() %}
                                <span class="badge badge--ok">{{ 'crm.workflows.active'|trans }}</span>
                            {% else %}
                                <span class="badge badge--muted">{{ 'crm.workflows.inactive'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="is-mute">{{ w.nodeCount() }}</td>
                        <td class="is-mute">{{ w.updatedAt().format('d. m. Y H:i') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with {
                                    href: url('admin.crm.workflows.edit', {id: w.id()}),
                                    label: 'crm.workflows.edit'|trans,
                                    icon: 'edit'
                                } %}
                                {% if user.can('crm.workflows.manage') %}
                                    {% include 'ui/row_action_destroy.html.twig' with {
                                        action: url('admin.crm.workflows.destroy', {id: w.id()}),
                                        confirm: 'crm.workflows.confirm_delete'|trans
                                    } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'crm.workflows.empty'|trans }}</h2>
                                <p>{{ 'crm.workflows.empty.hint'|trans }}</p>
                                {% if user.can('crm.workflows.manage') %}
                                    <a class="btn btn--primary" href="{{ url('admin.crm.workflows.create') }}">{{ icon('plus') }} {{ 'crm.workflows.new'|trans }}</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
