{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set workflowI18n = {
    'trigger.event': 'crm.workflows.node.trigger'|trans,
    'action.send_email': 'crm.workflows.node.send_email'|trans,
    'action.create_activity': 'crm.workflows.node.create_activity'|trans,
    'action.set_stage': 'crm.workflows.node.set_stage'|trans,
    'logic.if': 'crm.workflows.node.if'|trans,
    'logic.delay': 'crm.workflows.node.delay'|trans,
    'vars.pick_field': 'crm.workflows.vars.pick_field'|trans,
} %}
<div class="crm-workflow"
     x-data="crmWorkflowCanvas"
     data-graph='{{ graphJson|e('html_attr') }}'
     data-variables='{{ variablesJson|e('html_attr') }}'
     data-i18n='{{ workflowI18n|json_encode|e('html_attr') }}'
     data-save-url="{{ saveUrl|e('html_attr') }}"
     data-csrf="{{ csrf_token()|e('html_attr') }}">
    <header class="customer-edit__header crm-workflow__chrome">
        <div class="customer-edit__identity">
            <a class="text-link customer-profile__back" href="{{ url('admin.crm.workflows.index') }}">
                ← {{ 'crm.workflows.title'|trans }}
            </a>
            <div class="cell-user cell-user--lg">
                <span class="avatar avatar--xl">{{ workflow.name()|slice(0, 1)|upper }}</span>
                <div>
                    <p class="customer-edit__eyebrow">{{ 'crm.workflows.edit'|trans }}</p>
                    <h1>{{ workflow.name() }}</h1>
                    <p class="customer-profile__sub">{{ 'crm.workflows.editor.hint'|trans }}</p>
                </div>
            </div>
        </div>
        <div class="customer-edit__header-actions crm-workflow__chrome-actions">
            <button type="button" class="btn btn--ghost btn-sm" data-wf-add="logic.if">{{ 'crm.workflows.add.if'|trans }}</button>
            <button type="button" class="btn btn--ghost btn-sm" data-wf-add="logic.delay">{{ 'crm.workflows.add.delay'|trans }}</button>
            <button type="button" class="btn btn--ghost btn-sm" data-wf-add="action.create_activity">{{ 'crm.workflows.add.activity'|trans }}</button>
            <button type="button" class="btn btn--ghost btn-sm" data-wf-add="action.set_stage">{{ 'crm.workflows.add.stage'|trans }}</button>
            <button type="button" class="btn btn--ghost btn-sm" data-wf-add="action.send_email">{{ 'crm.workflows.add.email'|trans }}</button>
            <button type="button" class="btn btn--primary" data-wf-save>{{ 'crm.workflows.save_graph'|trans }}</button>
        </div>
    </header>

    <section class="customer-section crm-workflow__meta-card">
        <header class="customer-section__head">
            <div>
                <h2>{{ 'crm.workflows.section.profile'|trans }}</h2>
                <p class="muted customer-edit__section-hint">{{ 'crm.workflows.form.meta.hint'|trans }}</p>
            </div>
        </header>
        <form method="post" action="{{ metaUrl }}" class="crm-workflow__meta">
            {{ csrf_field()|raw }}
            <div class="customer-edit__grid crm-workflow__meta-grid">
                {% include 'ui/input.html.twig' with {
                    name: 'name',
                    label: 'crm.field.title'|trans,
                    required: true,
                    value: workflow.name()
                } %}
                {% include 'ui/switch.html.twig' with {
                    name: 'is_active',
                    label: 'crm.workflows.active'|trans,
                    on: workflow.isActive()
                } %}
            </div>
            {% include 'ui/textarea.html.twig' with {
                name: 'description',
                label: 'crm.workflows.description'|trans,
                optional: true,
                value: workflow.description() ?: '',
                size: 'mini',
                rows: 2,
                extra: 'field--full'
            } %}
            <div class="crm-workflow__meta-actions">
                <button class="btn btn--ghost" type="submit">{{ 'crm.workflows.save_meta'|trans }}</button>
            </div>
        </form>
    </section>

    <div class="crm-workflow__workspace">
        <div class="crm-workflow__canvas-wrap" x-ref="wrap">
            <svg class="crm-workflow__edges" x-ref="edgesSvg" preserveAspectRatio="xMinYMin meet"></svg>
            <div class="crm-workflow__nodes" x-ref="nodesRoot">
                <template x-for="node in nodes" :key="node.id">
                    <div class="crm-workflow__node"
                         :class="nodeClass(node)"
                         :data-node-id="node.id">
                        <header class="crm-workflow__node-handle" x-text="nodeLabel(node)"></header>
                        <div class="crm-workflow__ports">
                            <button type="button" class="crm-workflow__port is-in" title="in" data-port="in" :data-node-id="node.id"></button>
                            <template x-if="node.type === 'logic.if'">
                                <span class="crm-workflow__port-group">
                                    <button type="button" class="crm-workflow__port is-out" title="true" data-port="true" :data-node-id="node.id">T</button>
                                    <button type="button" class="crm-workflow__port is-out" title="false" data-port="false" :data-node-id="node.id">F</button>
                                </span>
                            </template>
                            <template x-if="node.type !== 'logic.if'">
                                <button type="button" class="crm-workflow__port is-out" title="out" data-port="out" :data-node-id="node.id"></button>
                            </template>
                        </div>
                        <div class="crm-workflow__node-body">
                            <template x-if="node.type === 'trigger.event'">
                                <div class="crm-workflow__fields">
                                    <select class="input input--sm" x-model="node.data.event" @change="dirty = true">
                                        <option value="deal.created">{{ 'crm.event.deal.created'|trans }}</option>
                                        <option value="deal.updated">{{ 'crm.event.deal.updated'|trans }}</option>
                                        <option value="deal.stage_changed">{{ 'crm.event.deal.stage_changed'|trans }}</option>
                                        <option value="deal.deleted">{{ 'crm.event.deal.deleted'|trans }}</option>
                                        <option value="activity.created">{{ 'crm.event.activity.created'|trans }}</option>
                                        <option value="activity.completed">{{ 'crm.event.activity.completed'|trans }}</option>
                                        <option value="emailing.message.received">{{ 'crm.event.emailing.message.received'|trans }}</option>
                                    </select>
                                    <template x-if="triggerHasConditions(node)">
                                        <div class="crm-workflow__trigger-cond muted">
                                            <span x-text="triggerConditionsLabel(node)"></span>
                                            <button type="button" class="btn btn--ghost btn-sm" data-action="clear-conditions" :data-node-id="node.id">{{ 'crm.workflows.clear_conditions'|trans }}</button>
                                        </div>
                                    </template>
                                </div>
                            </template>
                            <template x-if="node.type === 'action.send_email'">
                                <div class="crm-workflow__fields crm-workflow__fields--email">
                                    <div class="crm-wf-tpl"
                                         x-data="crmWfTplField"
                                         :data-node-id="node.id"
                                         data-field="to"
                                         data-placeholder="{{ 'crm.workflows.placeholder.to'|trans }}"></div>
                                    <div class="crm-wf-tpl"
                                         x-data="crmWfTplField"
                                         :data-node-id="node.id"
                                         data-field="subject"
                                         data-placeholder="{{ 'crm.workflows.placeholder.subject'|trans }}"></div>
                                    <div class="crm-workflow__email-body"
                                         x-data="crmWfGereqEmail"
                                         :data-node-id="node.id">
                                        {% include 'ui/_editor_core.html.twig' with {
                                            placeholder: 'crm.workflows.placeholder.body'|trans,
                                            extra_class: 'g-editor--workflow',
                                            highlight_vars: true,
                                            wf_body: true,
                                            value: '',
                                        } only %}
                                    </div>
                                </div>
                            </template>
                            <template x-if="node.type === 'action.create_activity'">
                                <div class="crm-workflow__fields">
                                    <div class="crm-wf-tpl"
                                         x-data="crmWfTplField"
                                         :data-node-id="node.id"
                                         data-field="subject"
                                         data-placeholder="{{ 'crm.workflows.placeholder.subject'|trans }}"></div>
                                    <select class="input input--sm" x-model="node.data.activity_type" @change="dirty = true">
                                        <option value="task">{{ 'crm.activity.type.task'|trans }}</option>
                                        <option value="call">{{ 'crm.activity.type.call'|trans }}</option>
                                        <option value="email">{{ 'crm.activity.type.email'|trans }}</option>
                                        <option value="meeting">{{ 'crm.activity.type.meeting'|trans }}</option>
                                        <option value="note">{{ 'crm.activity.type.note'|trans }}</option>
                                    </select>
                                </div>
                            </template>
                            <template x-if="node.type === 'action.set_stage'">
                                <select class="input input--sm" x-model="node.data.stage" @change="dirty = true">
                                    <option value="lead">{{ 'crm.stage.lead'|trans }}</option>
                                    <option value="qualified">{{ 'crm.stage.qualified'|trans }}</option>
                                    <option value="proposal">{{ 'crm.stage.proposal'|trans }}</option>
                                    <option value="won">{{ 'crm.stage.won'|trans }}</option>
                                    <option value="lost">{{ 'crm.stage.lost'|trans }}</option>
                                </select>
                            </template>
                            <template x-if="node.type === 'logic.if'">
                                <div class="crm-workflow__fields">
                                    <input class="input input--sm" placeholder="{{ 'crm.workflows.placeholder.field'|trans }}"
                                           data-field="field" data-kind="text"
                                           x-model="node.data.field" @change="dirty = true"
                                           @focus="focusTpl($event)">
                                    <input class="input input--sm" placeholder="{{ 'crm.workflows.placeholder.value'|trans }}"
                                           data-field="value" data-kind="text"
                                           x-model="node.data.value" @change="dirty = true"
                                           @focus="focusTpl($event)">
                                </div>
                            </template>
                            <template x-if="node.type === 'logic.delay'">
                                <input class="input input--sm" type="number" min="1" placeholder="{{ 'crm.workflows.placeholder.seconds'|trans }}" x-model.number="node.data.seconds" @change="dirty = true">
                            </template>
                        </div>
                        <button type="button" class="crm-workflow__remove" data-action="remove" :data-node-id="node.id" x-show="node.type !== 'trigger.event'">×</button>
                    </div>
                </template>
            </div>
        </div>

        <aside class="crm-workflow__vars">
            <div class="crm-workflow__vars-head">
                <strong>{{ 'crm.workflows.vars.title'|trans }}</strong>
                <p class="muted">{{ 'crm.workflows.vars.hint'|trans }}</p>
                <input class="input input--sm"
                       type="search"
                       x-model="varFilter"
                       placeholder="{{ 'crm.workflows.vars.search'|trans }}">
            </div>
            <div class="crm-workflow__vars-list">
                <template x-for="group in variableGroups()" :key="group.group">
                    <section class="crm-workflow__vars-group">
                        <h3 x-text="group.group"></h3>
                        <ul>
                            <template x-for="item in group.items" :key="item.path">
                                <li>
                                    <button type="button"
                                            class="crm-workflow__var"
                                            @click="insertVariable(item.path)"
                                            :title="item.description || item.label">
                                        <code class="crm-wf-var" x-text="item.token"></code>
                                        <span class="crm-workflow__var-label" x-text="item.label"></span>
                                        <span class="crm-workflow__var-desc muted" x-text="item.description" x-show="item.description"></span>
                                    </button>
                                </li>
                            </template>
                        </ul>
                    </section>
                </template>
                <p class="muted" x-show="filteredVariables().length === 0">{{ 'crm.workflows.vars.empty'|trans }}</p>
            </div>
        </aside>
    </div>

    <section class="customer-section crm-workflow__runs">
        <header class="customer-section__head">
            <div>
                <h2>{{ 'crm.workflows.executions'|trans }}</h2>
                <p class="muted customer-edit__section-hint">{{ 'crm.workflows.executions.hint'|trans }}</p>
            </div>
        </header>
        {% if runs is empty %}
            <p class="muted">{{ 'crm.workflows.executions_empty'|trans }}</p>
        {% else %}
            <div class="table-wrap" data-table>
                <table class="table table--crm-workflows">
                    <thead>
                        <tr>
                            <th>{{ 'crm.workflows.run.event'|trans }}</th>
                            <th>{{ 'crm.workflows.run.status'|trans }}</th>
                            <th>{{ 'crm.workflows.run.time'|trans }}</th>
                            <th>{{ 'crm.workflows.run.log'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in runs %}
                            <tr>
                                <td><span class="badge badge--info">{{ r.triggerEvent() }}</span></td>
                                <td>
                                    {% set st = r.status() %}
                                    <span class="badge badge--{{ st == 'completed' or st == 'ok' ? 'ok' : (st == 'failed' or st == 'error' ? 'danger' : 'muted') }}">{{ st }}</span>
                                </td>
                                <td class="is-mute">{{ r.createdAt()|date('d. m. Y H:i:s') }}</td>
                                <td><code class="crm-workflow__log">{{ r.log()|json_encode }}</code></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <section class="customer-section crm-workflow__danger">
        <header class="customer-section__head">
            <div>
                <h2>{{ 'crm.workflows.danger'|trans }}</h2>
                <p class="muted customer-edit__section-hint">{{ 'crm.workflows.danger.hint'|trans }}</p>
            </div>
        </header>
        <form
            method="post"
            action="{{ url('admin.crm.workflows.destroy', {id: workflow.id()}) }}"
            data-confirm="{{ 'crm.workflows.confirm_delete'|trans|e('html_attr') }}"
            data-confirm-title="{{ 'crm.workflows.delete'|trans|e('html_attr') }}"
            data-confirm-danger="1"
        >
            {{ csrf_field()|raw }}
            <button class="btn btn--danger" type="submit">{{ icon('trash') }} {{ 'crm.workflows.delete'|trans }}</button>
        </form>
    </section>
</div>
{% endblock %}
