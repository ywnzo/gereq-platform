{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <div>
            <p class="muted" style="margin:0 0 .35rem">
                <a class="text-link" href="{{ url('admin.crm.deals.index') }}">← {{ 'crm.deals.title'|trans }}</a>
            </p>
            <h1>{{ item.title() }}</h1>
            <p class="muted detail-layout__meta">
                {% if customer %}
                    <a href="{{ url('admin.customers.show', {id: customer.id()}) }}">{{ customer.name() }}</a>
                {% else %}
                    {{ 'crm.deals.customer_unavailable'|trans }}
                {% endif %}
                <span class="badge">{{ item.stageLabel()|trans }}</span>
                <span>{{ item.amountFormatted() }}</span>
            </p>
        </div>
        <div class="actions">
            {% if user.can('crm.deals.manage') %}
                <a class="btn btn--ghost" href="{{ url('admin.crm.deals.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.crm.deals.destroy', {id: item.id()}) }}" data-confirm="{{ 'crm.deals.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="detail-layout">
        <div class="detail-layout__main">
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ 'crm.deal.tasks'|trans }}</h2>
                        <p class="muted">{{ 'crm.deal.tasks.hint'|trans }}</p>
                    </div>
                    {% if user.can('crm.activities.manage') %}
                        <a class="btn btn--ghost btn-sm" href="{{ url('admin.crm.activities.create') }}?customer={{ item.customerId() }}&deal={{ item.id() }}">{{ 'crm.activities.partial.add'|trans }}</a>
                    {% endif %}
                </header>

                {% if user.can('crm.activities.manage') %}
                    <form method="post" action="{{ url('admin.crm.activities.store') }}" class="crm-hub__quick">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="customer_id" value="{{ item.customerId() }}">
                        <input type="hidden" name="deal_id" value="{{ item.id() }}">
                        <input type="hidden" name="_return" value="deal">
                        <select class="input" name="type" required aria-label="{{ 'crm.field.type'|trans }}">
                            {% for t in activityTypes %}
                                <option value="{{ t }}" {{ t == 'task' ? 'selected' : '' }}>{{ ('crm.activity.type.' ~ t)|trans }}</option>
                            {% endfor %}
                        </select>
                        <input class="input" type="text" name="subject" required minlength="2" maxlength="190" placeholder="{{ 'crm.deal.tasks.placeholder'|trans }}" autocomplete="off">
                        <button class="btn btn--primary" type="submit">{{ icon('plus') }} {{ 'crm.deal.tasks.add'|trans }}</button>
                    </form>
                {% endif %}

                {% if activities is empty %}
                    <div class="empty">
                        <h2>{{ 'crm.deal.tasks.empty'|trans }}</h2>
                        <p>{{ 'crm.deal.tasks.empty.hint'|trans }}</p>
                    </div>
                {% else %}
                    <div class="crm-hub__tasks">
                        {% for activity in activities %}
                            <div class="crm-task{% if activity.isCompleted() %} is-done{% endif %}">
                                <div class="crm-task__check">
                                    {% if user.can('crm.activities.manage') %}
                                        <form method="post" action="{{ url('admin.crm.activities.complete', {id: activity.id()}) }}">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="_return" value="deal">
                                            <input type="hidden" name="deal_id" value="{{ item.id() }}">
                                            <button
                                                class="btn btn--ghost btn-sm"
                                                type="submit"
                                                title="{{ activity.isCompleted() ? 'crm.activities.reopen'|trans : 'crm.activities.complete'|trans }}"
                                            >{{ activity.isCompleted() ? '☑' : '☐' }}</button>
                                        </form>
                                    {% else %}
                                        <span aria-hidden="true">{{ activity.isCompleted() ? '☑' : '☐' }}</span>
                                    {% endif %}
                                </div>
                                <div>
                                    <p class="crm-task__subject">{{ activity.subject() }}</p>
                                    <p class="crm-task__meta">
                                        <span class="badge">{{ activity.typeLabel()|trans }}</span>
                                        {% if activity.dueAt() %}
                                            · {{ activity.dueAt().format('d. m. Y H:i') }}
                                        {% endif %}
                                        {% if activity.body() %}
                                            · {{ activity.body()|striptags|slice(0, 120) }}
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="crm-task__actions">
                                    {% if user.can('crm.activities.manage') %}
                                        <a class="btn btn--ghost btn-sm" href="{{ url('admin.crm.activities.edit', {id: activity.id()}) }}">{{ 'common.edit'|trans }}</a>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            {% if item.note() %}
                <section class="panel">
                    <header class="panel__head">
                        <h2>{{ 'crm.field.note'|trans }}</h2>
                    </header>
                    <div class="detail-prose">{{ item.note() }}</div>
                </section>
            {% endif %}
        </div>

        <aside class="detail-layout__aside">
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'crm.field.stage'|trans }}</h2>
                </header>
                {% if user.can('crm.deals.manage') %}
                    <form method="post" action="{{ url('admin.crm.deals.stage', {id: item.id()}) }}" class="meta-list__action" style="padding-bottom:0.35rem">
                        {{ csrf_field()|raw }}
                        <select id="stage" name="stage" class="input" aria-label="{{ 'crm.deals.change_stage'|trans }}" onchange="this.form.submit()">
                            {% for s in stages %}
                                <option value="{{ s }}" {{ item.stage() == s ? 'selected' : '' }}>{{ ('crm.stage.' ~ s)|trans }}</option>
                            {% endfor %}
                        </select>
                    </form>
                {% else %}
                    <p class="detail-side-card__empty"><span class="badge">{{ item.stageLabel()|trans }}</span></p>
                {% endif %}
                <dl class="detail-hero__facts" style="margin-top:1rem">
                    <div>
                        <dt>{{ 'crm.field.amount'|trans }}</dt>
                        <dd><strong>{{ item.amountFormatted() }}</strong></dd>
                    </div>
                    <div>
                        <dt>{{ 'crm.field.expected_close'|trans }}</dt>
                        <dd>{{ item.expectedCloseAt() ? item.expectedCloseAt().format('d. m. Y') : '—' }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'crm.field.created'|trans }}</dt>
                        <dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd>
                    </div>
                </dl>
            </section>

            {% if customer %}
                <section class="panel detail-side-card">
                    <header class="panel__head">
                        <h2>{{ 'nav.customers'|trans }}</h2>
                        <a class="btn btn--ghost btn-sm" href="{{ url('admin.customers.show', {id: customer.id()}) }}">{{ 'common.detail'|trans }}</a>
                    </header>
                    <div class="detail-side-card__body">
                        <strong class="detail-side-card__title">
                            <a href="{{ url('admin.customers.show', {id: customer.id()}) }}">{{ customer.name() }}</a>
                        </strong>
                        <ul class="detail-side-card__list">
                            <li><a href="mailto:{{ customer.email() }}">{{ customer.email() }}</a></li>
                            {% if customer.phone() %}
                                <li><a href="tel:{{ customer.phone() }}">{{ customer.phone() }}</a></li>
                            {% endif %}
                        </ul>
                    </div>
                </section>
            {% endif %}
        </aside>
    </div>
{% endblock %}
