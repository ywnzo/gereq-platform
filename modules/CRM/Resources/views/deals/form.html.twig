{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'crm.deals.edit'|trans : 'crm.deals.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'crm.deal.save' } %}

    {% set dealSource = item ?? 'Modules\\CRM\\Domain\\Deal' %}
    {% set dealValues = {
        currency: item ? item.currency() : currency_code(),
        customer_id: item ? item.customerId() : customerId,
        expected_close_at: item and item.expectedCloseAt() ? item.expectedCloseAt().format('Y-m-d') : '',
    } %}

    <form method="post" action="{{ item ? url('admin.crm.deals.update', {id: item.id()}) : url('admin.crm.deals.store') }}" data-form="crm.deal.save" x-data="gereqForm"{% if form_errors('crm.deal.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {{ forms().render(dealSource, {
            form: 'crm.deal.save',
            cols: 2,
            values: dealValues,
            choices: { customer_id: customerOptions }
        }) }}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.crm.deals.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </form>
{% endblock %}
