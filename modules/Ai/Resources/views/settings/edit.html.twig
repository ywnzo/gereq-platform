{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="customer-edit">
    <header class="customer-edit__header">
        <div class="customer-edit__identity">
            <a class="text-link customer-profile__back" href="{{ url('admin.ai.agents.index') }}">
                ← {{ 'nav.ai'|trans }}
            </a>
            <div class="cell-user cell-user--lg">
                <span class="avatar avatar--xl">AI</span>
                <div>
                    <p class="customer-edit__eyebrow">{{ 'nav.ai.settings'|trans }}</p>
                    <h1>{{ 'ai.settings.title'|trans }}</h1>
                    <p class="customer-profile__sub">{{ 'ai.settings.lead'|trans }}</p>
                </div>
            </div>
        </div>
        <div class="customer-edit__header-actions">
            <button class="btn btn--primary" type="submit" form="ai-settings-form">{{ 'common.save'|trans }}</button>
        </div>
    </header>

    <div class="customer-edit__layout">
        <div class="customer-edit__main">
            <section class="customer-section">
                <header class="customer-section__head">
                    <div>
                        <h2>{{ 'ai.settings.section.keys'|trans }}</h2>
                        <p class="muted customer-edit__section-hint">{{ 'ai.settings.section.keys.hint'|trans }}</p>
                    </div>
                </header>
                <form id="ai-settings-form" method="post" action="{{ url('admin.ai.settings.update') }}">
                    {{ csrf_field()|raw }}
                    <div class="customer-edit__grid">
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__openai_api_key',
                            type: 'password',
                            label: 'ai.settings.openai_api_key'|trans,
                            optional: true,
                            placeholder: keys.openai ? '••••••••' : 'sk-…',
                            autocomplete: 'off'
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__anthropic_api_key',
                            type: 'password',
                            label: 'ai.settings.anthropic_api_key'|trans,
                            optional: true,
                            placeholder: keys.anthropic ? '••••••••' : 'sk-ant-…',
                            autocomplete: 'off'
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__gemini_api_key',
                            type: 'password',
                            label: 'ai.settings.gemini_api_key'|trans,
                            optional: true,
                            placeholder: keys.gemini ? '••••••••' : '',
                            autocomplete: 'off'
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__groq_api_key',
                            type: 'password',
                            label: 'ai.settings.groq_api_key'|trans,
                            optional: true,
                            placeholder: keys.groq ? '••••••••' : '',
                            autocomplete: 'off'
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__openrouter_api_key',
                            type: 'password',
                            label: 'ai.settings.openrouter_api_key'|trans,
                            optional: true,
                            placeholder: keys.openrouter ? '••••••••' : 'sk-or-…',
                            autocomplete: 'off'
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__cerebras_api_key',
                            type: 'password',
                            label: 'ai.settings.cerebras_api_key'|trans,
                            optional: true,
                            placeholder: keys.cerebras ? '••••••••' : '',
                            autocomplete: 'off'
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__zai_api_key',
                            type: 'password',
                            label: 'ai.settings.zai_api_key'|trans,
                            optional: true,
                            placeholder: keys.zai ? '••••••••' : '',
                            autocomplete: 'off'
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__deepseek_api_key',
                            type: 'password',
                            label: 'ai.settings.deepseek_api_key'|trans,
                            optional: true,
                            placeholder: keys.deepseek ? '••••••••' : '',
                            autocomplete: 'off'
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ai__ollama_base_url',
                            label: 'ai.settings.ollama_base_url'|trans,
                            value: ollama_base_url,
                            hint: 'ai.settings.ollama_base_url.hint'|trans
                        } %}
                    </div>
                    <div class="form-actions" style="margin-top:1rem">
                        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
                    </div>
                </form>
            </section>

            <section class="customer-section">
                <header class="customer-section__head">
                    <div>
                        <h2>{{ 'ai.settings.providers'|trans }}</h2>
                        <p class="muted customer-edit__section-hint">{{ 'ai.settings.providers.hint'|trans }}</p>
                    </div>
                    <form method="post" action="{{ url('admin.ai.settings.seed') }}">
                        {{ csrf_field()|raw }}
                        <button class="btn btn--ghost btn-sm" type="submit">{{ 'ai.action.seed_catalog'|trans }}</button>
                    </form>
                </header>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>{{ 'ai.field.provider'|trans }}</th>
                                <th>{{ 'ai.field.status'|trans }}</th>
                                <th class="table__actions-head"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for p in providers %}
                                <tr>
                                    <td><strong>{{ p.driver() }}</strong></td>
                                    <td>
                                        {% if p.isConfigured() %}
                                            <span class="badge badge--ok">{{ 'ai.provider.configured'|trans }}</span>
                                        {% else %}
                                            <span class="badge badge--muted">{{ 'ai.provider.missing'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <form method="post" action="{{ url('admin.ai.settings.ping') }}">
                                            {{ csrf_field()|raw }}
                                            <input type="hidden" name="driver" value="{{ p.driver() }}">
                                            <button class="btn btn--ghost btn-sm" type="submit">{{ 'ai.action.ping'|trans }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <aside class="customer-edit__aside">
            <section class="customer-section">
                <header class="customer-section__head">
                    <h2>{{ 'ai.settings.help'|trans }}</h2>
                </header>
                <p class="muted customer-edit__section-hint">{{ 'ai.settings.help.body'|trans }}</p>
                <div class="customer-edit__aside-actions">
                    <a class="btn btn--ghost" href="{{ url('admin.ai.agents.index') }}">{{ 'nav.ai.agents'|trans }}</a>
                    <a class="btn btn--ghost" href="{{ url('admin.ai.knowledge.index') }}">{{ 'nav.ai.knowledge'|trans }}</a>
                </div>
            </section>
        </aside>
    </div>
</div>
{% endblock %}
