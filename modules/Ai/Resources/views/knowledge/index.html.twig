{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="customer-edit">
    <header class="customer-edit__header">
        <div class="customer-edit__identity">
            <a class="text-link customer-profile__back" href="{{ url('admin.ai.agents.index') }}">
                ← {{ 'nav.ai'|trans }}
            </a>
            <div class="cell-user cell-user--lg">
                <span class="avatar avatar--xl">KB</span>
                <div>
                    <p class="customer-edit__eyebrow">{{ 'nav.ai.knowledge'|trans }}</p>
                    <h1>{{ 'ai.knowledge.title'|trans }}</h1>
                    <p class="customer-profile__sub">{{ 'ai.knowledge.lead'|trans }}</p>
                </div>
            </div>
        </div>
    </header>

    <section class="customer-section" style="margin-bottom:1.5rem">
        <header class="customer-section__head">
            <div>
                <h2>{{ 'ai.knowledge.create'|trans }}</h2>
                <p class="muted customer-edit__section-hint">{{ 'ai.knowledge.create.hint'|trans }}</p>
            </div>
        </header>
        <form method="post" action="{{ url('admin.ai.knowledge.store') }}" data-form="ai.knowledge.save">
            {{ csrf_field()|raw }}
            <div class="customer-edit__grid">
                {% include 'ui/input.html.twig' with { name: 'name', label: 'ai.field.name'|trans, required: true, form: 'ai.knowledge.save' } %}
                {% include 'ui/input.html.twig' with { name: 'slug', label: 'ai.field.slug'|trans, required: true, form: 'ai.knowledge.save' } %}
                <div class="g-field">
                    <label class="g-label" for="f-visibility">{{ 'ai.field.visibility'|trans }}</label>
                    <div class="g-control-wrap">
                        <select class="g-control" id="f-visibility" name="visibility" required>
                            {% for v in visibilities %}
                                <option value="{{ v }}">{{ v }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                {% include 'ui/textarea.html.twig' with {
                    name: 'description',
                    label: 'ai.field.description'|trans,
                    optional: true,
                    size: 'mini',
                    rows: 2,
                    extra: 'field--full',
                    form: 'ai.knowledge.save'
                } %}
            </div>
            <div class="form-actions" style="margin-top:1rem">
                <button class="btn btn--primary" type="submit">{{ 'ai.knowledge.create'|trans }}</button>
            </div>
        </form>
    </section>

    {% for kb in items %}
        <section class="customer-section" style="margin-bottom:1.5rem">
            <header class="customer-section__head">
                <div>
                    <h2>{{ kb.name() }}</h2>
                    <p class="muted customer-edit__section-hint">
                        <code>{{ kb.slug() }}</code>
                        ·
                        <span class="badge badge--{{ kb.visibility() == 'public' ? 'ok' : 'muted' }}">{{ kb.visibility() }}</span>
                        {% if kb.description() %} · {{ kb.description() }}{% endif %}
                    </p>
                </div>
                <form method="post" action="{{ url('admin.ai.knowledge.reindex', {id: kb.id()}) }}">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--ghost btn-sm" type="submit">{{ 'ai.action.reindex'|trans }}</button>
                </form>
            </header>

            <form method="post" action="{{ url('admin.ai.knowledge.source', {id: kb.id()}) }}" style="margin-bottom:1rem">
                {{ csrf_field()|raw }}
                <input type="hidden" name="source_type" value="manual_text">
                <div class="customer-edit__grid">
                    {% include 'ui/input.html.twig' with { name: 'title', label: 'ai.field.title'|trans, required: true } %}
                    {% include 'ui/textarea.html.twig' with {
                        name: 'text',
                        label: 'ai.field.text'|trans,
                        required: true,
                        size: 'mini',
                        rows: 4,
                        extra: 'field--full'
                    } %}
                </div>
                <div class="form-actions" style="margin-top:.75rem">
                    <button class="btn btn--primary btn-sm" type="submit">{{ 'ai.action.add_source'|trans }}</button>
                </div>
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'ai.field.title'|trans }}</th>
                            <th>{{ 'ai.field.source_type'|trans }}</th>
                            <th>{{ 'ai.field.status'|trans }}</th>
                            <th class="table__actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for s in sources[kb.id()]|default([]) %}
                            <tr>
                                <td>
                                    <a href="{{ url('admin.ai.knowledge.source.edit', {id: s.id()}) }}">
                                        <strong>{{ s.title() }}</strong>
                                    </a>
                                </td>
                                <td class="is-mute">{{ s.sourceType() }}</td>
                                <td>
                                    <span class="badge badge--{{ s.status() == 'ready' ? 'ok' : (s.status() == 'failed' ? 'danger' : 'warn') }}">
                                        {{ s.status() }}
                                    </span>
                                </td>
                                <td class="table__actions">
                                    <div class="table__action-group">
                                        {% include 'ui/row_action.html.twig' with {
                                            href: url('admin.ai.knowledge.source.edit', {id: s.id()}),
                                            label: 'common.edit'|trans,
                                            icon: 'edit'
                                        } %}
                                        {% include 'ui/row_action_destroy.html.twig' with {
                                            action: url('admin.ai.knowledge.source.destroy', {id: s.id()}),
                                            confirm: 'ai.knowledge.source.confirm_delete'|trans
                                        } %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4">
                                    <div class="empty">
                                        <h2>{{ 'ai.knowledge.no_sources'|trans }}</h2>
                                        <p>{{ 'ai.knowledge.no_sources.hint'|trans }}</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% else %}
        <div class="empty">
            <h2>{{ 'ai.knowledge.empty'|trans }}</h2>
            <p>{{ 'ai.knowledge.empty.hint'|trans }}</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
