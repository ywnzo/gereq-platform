{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.ai.agents'|trans, url: url('admin.ai.agents.index') },
        { label: agent.name() },
    ] } %}
{% endblock %}

{% block content %}
<div class="ai-chat" x-data="aiChat">
    <script type="application/json" id="ai-chat-boot">{{ boot|json_encode|raw }}</script>

    <header class="ai-chat__top">
        <div class="ai-chat__identity">
            <span class="avatar avatar--lg ai-chat__avatar">{{ agent.name()|slice(0, 1)|upper }}</span>
            <div>
                <h1 class="ai-chat__title">{{ agent.name() }}</h1>
                <p class="ai-chat__meta">
                    <code>{{ agent.slug() }}</code>
                    {% if chat_model %}
                        <span class="ai-chat__dot">·</span>
                        <span>{{ chat_model.modelId() }}</span>
                    {% endif %}
                </p>
                <div class="ai-chat__chips">
                    {% if agent.published() %}
                        <span class="badge badge--ok">{{ 'ai.status.published'|trans }}</span>
                    {% else %}
                        <span class="badge badge--muted">{{ 'ai.status.draft'|trans }}</span>
                    {% endif %}
                    {% for s in agent.surfaces() %}
                        <span class="badge badge--muted">{{ s }}</span>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="ai-chat__actions">
            {% if user.can('ai.manage') %}
                <a class="btn btn--ghost" href="{{ url('admin.ai.agents.edit', {id: agent.id()}) }}">{{ 'common.edit'|trans }}</a>
            {% endif %}
            <a class="btn btn--ghost" href="{{ url('admin.ai.chat', {id: agent.id()}) }}">{{ 'ai.chat.new'|trans }}</a>
            <a class="btn btn--ghost" href="{{ url('admin.ai.agents.index') }}">{{ 'common.back'|trans }}</a>
        </div>
    </header>

    <div class="ai-chat__shell">
        <div class="ai-chat__thread" x-ref="thread">
            <template x-if="timeline.length === 0 && !sending">
                <div class="ai-chat__empty">
                    <div class="ai-chat__empty-mark" aria-hidden="true">{{ icon('zap') }}</div>
                    <h2>{{ 'ai.chat.empty'|trans }}</h2>
                    <p>{{ 'ai.chat.empty.hint'|trans }}</p>
                    <div class="ai-chat__suggestions">
                        <template x-for="s in suggestions" :key="s">
                            <button type="button" class="ai-chat__chip" :data-text="s" @click="useSuggestion">
                                <span x-text="s"></span>
                            </button>
                        </template>
                    </div>
                </div>
            </template>

            <template x-for="(item, idx) in timeline" :key="idx">
                <div>
                    <template x-if="item.type === 'user'">
                        <div class="ai-chat__row ai-chat__row--user">
                            <div class="ai-chat__bubble ai-chat__bubble--user">
                                <div class="ai-chat__bubble-text" x-text="item.text"></div>
                                <time class="ai-chat__time" x-text="item.time || ''"></time>
                            </div>
                        </div>
                    </template>

                    <template x-if="item.type === 'reasoning'">
                        <div class="ai-chat__row ai-chat__row--assistant">
                            <details class="ai-chat__reason" :open="item.open">
                                <summary class="ai-chat__reason-sum">
                                    <span class="ai-chat__reason-label">{{ 'ai.chat.reasoning'|trans }}</span>
                                    <span class="ai-chat__reason-count" x-text="item.steps.length"></span>
                                </summary>
                                <ol class="ai-chat__steps">
                                    <template x-for="(step, sidx) in item.steps" :key="sidx">
                                        <li class="ai-chat__step" :class="'ai-chat__step--' + step.kind">
                                            <div class="ai-chat__step-head">
                                                <span class="badge" :class="step.ok === false ? 'badge--danger' : (step.kind === 'thought' ? 'badge--muted' : 'badge--ok')" x-text="step.kind === 'thought' ? labels.thought : labels.toolLabel"></span>
                                                <code x-text="step.name"></code>
                                                <span class="muted" x-show="step.duration_ms" x-text="(step.duration_ms || 0) + ' ms'"></span>
                                            </div>
                                            <pre class="ai-chat__code" x-show="step.args" x-text="step.args ? JSON.stringify(step.args, null, 2) : ''"></pre>
                                            <pre class="ai-chat__code" x-show="step.content" x-text="step.content || ''"></pre>
                                        </li>
                                    </template>
                                </ol>
                            </details>
                        </div>
                    </template>

                    <template x-if="item.type === 'assistant'">
                        <div class="ai-chat__row ai-chat__row--assistant">
                            <div class="ai-chat__bubble ai-chat__bubble--assistant" :class="item.streaming && 'is-streaming'">
                                <div class="ai-chat__bubble-text ai-chat__md" x-md="item.text"></div>
                                <div class="ai-chat__bubble-meta">
                                    <time class="ai-chat__time" x-text="item.time || ''"></time>
                                    <span class="ai-chat__cursor" x-show="item.streaming" x-cloak></span>
                                    <div class="ai-chat__feedback" x-show="!item.streaming && item.messageId" x-cloak>
                                        <button
                                            type="button"
                                            class="ai-chat__fb"
                                            :class="item.feedback === 'positive' && 'is-active'"
                                            :data-idx="idx"
                                            data-rating="positive"
                                            :title="labels.thumbUp"
                                            :aria-label="labels.thumbUp"
                                            @click="sendFeedback"
                                        >↑</button>
                                        <button
                                            type="button"
                                            class="ai-chat__fb"
                                            :class="item.feedback === 'negative' && 'is-active is-down'"
                                            :data-idx="idx"
                                            data-rating="negative"
                                            :title="labels.thumbDown"
                                            :aria-label="labels.thumbDown"
                                            @click="sendFeedback"
                                        >↓</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </template>

            <div class="ai-chat__typing" x-show="sending && status" x-cloak>
                <span></span><span></span><span></span>
                <em x-text="status"></em>
            </div>
        </div>

        <form class="ai-chat__composer" method="post" action="{{ url('admin.ai.chat.send', {id: agent.id()}) }}" @submit="submit">
            {{ csrf_field()|raw }}
            <input type="hidden" name="conversation_id" :value="conversationId || ''">
            <label class="sr-only" for="ai-chat-message">{{ 'ai.chat.message'|trans }}</label>
            <textarea
                id="ai-chat-message"
                class="ai-chat__input"
                name="message"
                rows="2"
                required
                x-ref="input"
                x-model="draft"
                @keydown.meta.enter.prevent="$el.form.requestSubmit()"
                @keydown.ctrl.enter.prevent="$el.form.requestSubmit()"
                placeholder="{{ 'ai.chat.placeholder'|trans }}"
                :disabled="sending"
            ></textarea>
            <div class="ai-chat__composer-bar">
                <p class="ai-chat__hint">{{ 'ai.chat.compose.hint'|trans }} · {{ 'ai.chat.shortcut'|trans }}</p>
                <button class="btn btn--primary" type="submit" :disabled="sending || !draft.trim()">
                    <span x-show="!sending">{{ 'ai.action.send'|trans }}</span>
                    <span x-show="sending" x-cloak>{{ 'ai.chat.sending'|trans }}</span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
