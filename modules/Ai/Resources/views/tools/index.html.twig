{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="customer-edit">
    <header class="customer-edit__header">
        <div class="customer-edit__identity">
            <a class="text-link customer-profile__back" href="{{ url('admin.ai.agents.index') }}">
                ← {{ 'nav.ai'|trans }}
            </a>
            <div class="cell-user cell-user--lg">
                <span class="avatar avatar--xl">T</span>
                <div>
                    <p class="customer-edit__eyebrow">{{ 'nav.ai.tools'|trans }}</p>
                    <h1>{{ 'ai.tools.title'|trans }}</h1>
                    <p class="customer-profile__sub">{{ 'ai.tools.lead'|trans }}</p>
                </div>
            </div>
        </div>
        <div class="customer-edit__header-actions">
            <a class="btn btn--primary" href="{{ url('admin.ai.tools.create') }}">{{ 'ai.tools.new'|trans }}</a>
        </div>
    </header>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'ai.field.name'|trans }}</th>
                    <th>{{ 'ai.field.label'|trans }}</th>
                    <th>{{ 'ai.field.handler'|trans }}</th>
                    <th>{{ 'ai.field.status'|trans }}</th>
                    <th class="table__actions"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td><a href="{{ url('admin.ai.tools.edit', {id: item.id()}) }}"><code>{{ item.name() }}</code></a></td>
                        <td><strong>{{ item.label() }}</strong></td>
                        <td class="is-mute">{{ item.handlerType() }}</td>
                        <td>
                            <span class="badge badge--{{ item.enabled() ? 'ok' : 'muted' }}">
                                {{ item.enabled() ? 'ai.status.enabled'|trans : 'ai.status.disabled'|trans }}
                            </span>
                        </td>
                        <td class="table__actions">
                            <div class="table__action-group">
                                {% include 'ui/row_action.html.twig' with { href: url('admin.ai.tools.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                {% include 'ui/row_action_destroy.html.twig' with {
                                    action: url('admin.ai.tools.destroy', {id: item.id()}),
                                    confirm: 'ai.tools.confirm_delete'|trans
                                } %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">
                            <div class="empty">
                                <h2>{{ 'ai.tools.custom.empty'|trans }}</h2>
                                <p>{{ 'ai.tools.custom.empty.hint'|trans }}</p>
                                <a class="btn btn--primary" href="{{ url('admin.ai.tools.create') }}">{{ 'ai.tools.new'|trans }}</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
