{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set statusFilter = status|default('') %}
{% set ownershipFilter = ownership|default('') %}
{% set advancedFilters = (statusFilter is not empty) or (ownershipFilter is not empty) %}
{% set filterQuery = { status: statusFilter, ownership: ownershipFilter } %}
{% set pageIds = items|map(i => i.id()) %}
{% set canManage = user.can('fleet.manage') %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="fleet"
    data-actions-default="{{ canManage ? 3 : 1 }}"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'fleet.bulk.confirm_delete'|trans|e('html_attr') }}"
>
<header class="page-header">
    <div>
        <h1>{{ 'fleet.title'|trans }}</h1>
        <p class="muted">{{ 'fleet.index.intro'|trans }}</p>
    </div>
    {% if canManage %}
        <a class="btn btn--primary" href="{{ url('admin.fleet.create') }}">{{ icon('plus') }} {{ 'fleet.new'|trans }}</a>
    {% endif %}
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get" id="fleet-filter-form">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <input type="hidden" name="status" value="{{ statusFilter }}">
        <input type="hidden" name="ownership" value="{{ ownershipFilter }}">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'fleet.search'|trans }}">
    </form>
    <div class="toolbar__toggles">
        {{ ui_render('drawer_trigger', {
            drawer_id: 'fleet-filters',
            label: 'ui.drawer.filters'|trans,
            variant: advancedFilters ? 'primary' : 'ghost',
            icon: 'filters',
        }) }}
    </div>
</div>

{% if canManage and items is not empty %}
    <form
        class="bulk-bar"
        method="post"
        action="{{ url('admin.fleet.bulk') }}"
        x-show="selectedCount > 0"
        x-cloak
        @submit="confirmBulk"
    >
        {{ csrf_field()|raw }}
        <input type="hidden" name="confirmed" value="1">
        <template x-for="id in selected" :key="id">
            <input type="hidden" name="ids[]" :value="id">
        </template>
        <div class="bulk-bar__meta">
            <strong x-text="selectedCount"></strong>
            <span>{{ 'fleet.bulk.selected'|trans }}</span>
            <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'fleet.bulk.clear'|trans }}</button>
        </div>
        <div class="bulk-bar__actions">
            <select class="input" name="action" x-model="bulkAction" required>
                <option value="">{{ 'fleet.bulk.choose'|trans }}</option>
                <option value="delete">{{ 'fleet.bulk.action.delete'|trans }}</option>
            </select>
            <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'fleet.bulk.apply'|trans }}</button>
        </div>
    </form>
{% endif %}

<div class="table-wrap" data-table>
<table class="table table--fleet">
<thead>
<tr>
{% if canManage %}
<th class="table__check">
    <label class="table-check">
        <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected">
        <span class="sr-only">{{ 'fleet.bulk.select_all'|trans }}</span>
    </label>
</th>
{% endif %}
{% set showBranchColumn = showBranchColumn|default(false) %}
{% set emptyCols = (canManage ? 7 : 6) + (showBranchColumn ? 1 : 0) %}
{% include 'ui/sort_th.html.twig' with { label: 'fleet.field.vehicle'|trans, column: 'plate', query: filterQuery } %}
{% include 'ui/sort_th.html.twig' with { label: 'fleet.field.status'|trans, column: 'status', query: filterQuery } %}
<th>{{ 'fleet.field.ownership'|trans }}</th>
{% if showBranchColumn %}
<th>{{ 'fleet.field.branch'|trans }}</th>
{% endif %}
<th>{{ 'fleet.field.stk'|trans }}</th>
<th>{{ 'fleet.col.specs'|trans }}</th>
<th class="table__actions-head"></th>
</tr>
</thead>
<tbody>
{% for item in items %}
{% set stk = item.stkAt() %}
{% set stkSoon = stk and stk < date('+45 days') %}
{% set stkPast = stk and stk < date() %}
{% set thumb = thumbs[item.id()]|default(null) %}
{% set b = showBranchColumn and item.branchId() ? branches[item.branchId()]|default(null) : null %}
<tr class="fleet-row" :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
    {% if canManage %}
    <td class="table__check">
        <label class="table-check">
            <input
                type="checkbox"
                value="{{ item.id() }}"
                @change="toggleId('{{ item.id() }}')"
                :checked="isSelected('{{ item.id() }}')"
            >
            <span class="sr-only">{{ item.plate() }}</span>
        </label>
    </td>
    {% endif %}
    <td>
        <a class="fleet-row__primary" href="{{ url('admin.fleet.show',{id:item.id()}) }}">
            <span class="fleet-row__thumb{{ thumb ? '' : ' is-empty' }}" aria-hidden="true">
                {% if thumb %}
                    <img src="{{ thumb }}" alt="" width="72" height="54" loading="lazy" decoding="async">
                {% else %}
                    <span class="material-symbols-outlined g-icon">directions_car</span>
                {% endif %}
            </span>
            <span class="fleet-row__meta">
                <span class="fleet-row__plate">{{ item.plate() }}</span>
                <span class="fleet-row__name">
                    {% if item.brand() or item.model() %}
                        {{ item.brand() }} {{ item.displayModel() }}{% if item.modelYear() %} · {{ item.modelYear() }}{% endif %}
                    {% else %}
                        <span class="muted">{{ 'fleet.row.no_model'|trans }}</span>
                    {% endif %}
                </span>
                {% if item.vin() %}<span class="fleet-row__vin">{{ item.vin() }}</span>{% endif %}
            </span>
        </a>
    </td>
    <td>
        <span class="status-chip status-chip--{{ item.status() }}">
            <span class="status-chip__dot" aria-hidden="true"></span>
            {{ item.statusLabel()|trans }}
        </span>
    </td>
    <td>
        <span class="badge {% if item.ownership() == 'external' %}badge--info{% else %}badge--muted{% endif %}">
            {{ item.ownershipLabel()|trans }}
        </span>
    </td>
    {% if showBranchColumn %}
    <td>
        {% if b %}
            <span class="badge badge--muted">{{ b.name() }}</span>
        {% else %}
            <span class="muted">—</span>
        {% endif %}
    </td>
    {% endif %}
    <td>
        {% if stk %}
            <span class="fleet-deadline{% if stkPast %} is-past{% elseif stkSoon %} is-soon{% endif %}">
                {{ stk.format('d. m. Y') }}
            </span>
        {% else %}
            <span class="muted">—</span>
        {% endif %}
    </td>
    <td class="fleet-row__specs">
        {% if item.fuel() %}<span>{{ ('fleet.fuel.'~item.fuel())|trans }}</span>{% endif %}
        {% if item.gearbox() %}<span>{{ ('fleet.gearbox.'~item.gearbox())|trans }}</span>{% endif %}
        {% if item.mileage() is not null %}<span>{{ item.mileage()|number_format(0, ',', ' ') }} km</span>{% endif %}
        {% if not item.fuel() and not item.gearbox() and item.mileage() is null %}<span class="muted">—</span>{% endif %}
    </td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% include 'ui/row_action.html.twig' with { href: url('admin.fleet.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
            {% if canManage %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.fleet.edit',{id:item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                {% include 'ui/row_action_destroy.html.twig' with {
                    action: url('admin.fleet.destroy', {id: item.id()}),
                    confirm: 'fleet.confirm_delete'|trans
                } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr><td colspan="{{ emptyCols }}"><div class="empty"><h2>{{ 'fleet.empty'|trans }}</h2></div></td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% include 'ui/table_footer.html.twig' %}
</div>

{% embed 'ui/drawer.html.twig' with { id: 'fleet-filters', title: 'ui.drawer.filters'|trans } %}
    {% block body %}
        <form method="get" class="g-drawer__form stack" id="fleet-drawer-filters">
            <input type="hidden" name="q" value="{{ search }}">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'fleet.field.status'|trans }}</span>
                <select class="input" name="status">
                    <option value="">{{ 'fleet.all_statuses'|trans }}</option>
                    {% for s in statuses %}
                        <option value="{{ s }}" {{ statusFilter == s ? 'selected' : '' }}>{{ ('fleet.status.' ~ s)|trans }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'fleet.field.ownership'|trans }}</span>
                <select class="input" name="ownership">
                    <option value="">{{ 'fleet.all_ownerships'|trans }}</option>
                    {% for o in ownerships %}
                        <option value="{{ o }}" {{ ownershipFilter == o ? 'selected' : '' }}>{{ ('fleet.ownership.' ~ o)|trans }}</option>
                    {% endfor %}
                </select>
            </label>
        </form>
    {% endblock %}
    {% block footer %}
        <a class="btn btn--ghost" href="?q={{ search|url_encode }}&sort={{ sort|url_encode }}&dir={{ dir|url_encode }}">{{ 'ui.drawer.reset'|trans }}</a>
        <button class="btn btn--primary" type="submit" form="fleet-drawer-filters">{{ 'ui.drawer.apply'|trans }}</button>
    {% endblock %}
{% endembed %}
{% endblock %}
