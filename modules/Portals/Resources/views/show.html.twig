{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <h1>{{ item.name() }}</h1>
        <p class="muted detail-layout__meta">
            <code>{{ item.code() }}</code>
            {% if catalogProvider %}
                <a href="{{ url('admin.portals.providers.show',{id:catalogProvider.id()}) }}">{{ catalogProvider.name() }}</a>
            {% endif %}
            {% if item.active() %}<span class="badge badge--ok">{{ 'portals.field.active'|trans }}</span>{% else %}<span class="badge badge--muted">{{ 'common.no'|trans }}</span>{% endif %}
        </p>
    </div>
    {% if user.can('portals.manage') %}
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.portals.edit',{id:item.id()}) }}">{{ 'common.edit'|trans }}</a>
            <form method="post" action="{{ url('admin.portals.toggle',{id:item.id()}) }}">{{ csrf_field()|raw }}
                <button class="btn btn--ghost" type="submit">{{ item.active() ? 'portals.deactivate'|trans : 'portals.activate'|trans }}</button>
            </form>
            <form method="post" action="{{ url('admin.portals.destroy',{id:item.id()}) }}" data-confirm="{{ 'portals.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                {{ csrf_field()|raw }}
                <button class="btn btn--ghost" type="submit">{{ 'common.delete'|trans }}</button>
            </form>
        </div>
    {% endif %}
</header>

<div class="detail-layout">
    <div class="detail-layout__main">
        <section class="panel">
            <header class="panel__head"><h2>{{ 'portals.flow.title'|trans }}</h2></header>
            <p class="muted">{{ 'portals.flow.body'|trans }}</p>
        </section>

        <section class="panel">
            <header class="panel__head"><h2>{{ 'portals.publications.title'|trans }}</h2></header>
            <div class="table-wrap">
                <table class="table">
                    <thead><tr>
                        <th>{{ 'portals.field.listing'|trans }}</th>
                        <th>{{ 'portals.field.external_id'|trans }}</th>
                        <th>{{ 'portals.field.status'|trans }}</th>
                        <th></th>
                    </tr></thead>
                    <tbody>
                    {% for pub in publications %}
                        <tr>
                            <td>
                                {% if listingTitles[pub.listingId()] is defined %}
                                    <a href="{{ url('admin.listings.show',{id:pub.listingId()}) }}">{{ listingTitles[pub.listingId()] }}</a>
                                {% else %}
                                    <code>{{ pub.listingId() }}</code>
                                {% endif %}
                            </td>
                            <td>{{ pub.externalId()|default('—') }}</td>
                            <td><span class="badge">{{ pub.statusLabel()|trans }}</span></td>
                            <td><a href="{{ url('admin.portals.publications.show',{id:pub.id()}) }}">{{ 'common.detail'|trans }}</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="muted">{{ 'portals.publications.empty'|trans }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <aside class="detail-layout__aside">
        {% if user.can('portals.manage') %}
        <section class="panel">
            <header class="panel__head"><h2>{{ 'portals.queue'|trans }}</h2></header>
            <p class="muted">{{ 'portals.queue.hint'|trans }}</p>
            <form method="post" class="form-grid" action="{{ url('admin.portals.queue',{id:item.id()}) }}">
                {{ csrf_field()|raw }}
                {% if listingOptions|length > 1 %}
                    {% include 'ui/select.html.twig' with { name:'listing_id', label:'portals.field.listing'|trans, required:true, value:'', options: listingOptions, extra: 'field--full' } %}
                {% else %}
                    {% include 'ui/input.html.twig' with { name:'listing_id', label:'portals.field.listing'|trans, required:true, value:'' } %}
                    <p class="muted">{{ 'portals.queue.no_listings'|trans }}</p>
                {% endif %}
                <div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'portals.queue'|trans }}</button></div>
            </form>
        </section>
        {% endif %}
        <section class="panel">
            <header class="panel__head"><h2>{{ 'portals.form.section.credentials'|trans }}</h2></header>
            {% if catalogProvider %}
                <dl class="meta-list meta-list--flush">
                    {% for f in catalogProvider.fields() %}
                        <div>
                            <dt>{{ f.label }}</dt>
                            <dd>
                                {% set val = item.config()[f.key]|default('') %}
                                {% if f.type == 'password' and val %}••••••••{% elseif val %}{{ val }}{% else %}—{% endif %}
                            </dd>
                        </div>
                    {% else %}
                        <div><dt>—</dt><dd class="muted">{{ 'portals.form.no_fields'|trans }}</dd></div>
                    {% endfor %}
                </dl>
            {% else %}
                <p class="muted">—</p>
            {% endif %}
        </section>
    </aside>
</div>
{% endblock %}
