{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="portal-publications" data-actions-default="1">
<header class="page-header"><h1>{{ 'portals.publications.title'|trans }}</h1>
<a class="btn btn--ghost" href="{{ url('admin.portals.index') }}">{{ 'portals.title'|trans }}</a>
</header>
<div class="toolbar--table">
<form class="toolbar" method="get">
<input type="hidden" name="sort" value="{{ sort }}">
<input type="hidden" name="dir" value="{{ dir }}">
<input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'portals.search'|trans }}">
<select name="status" class="input" onchange="this.form.submit()"><option value="">{{ 'portals.publications.all_statuses'|trans }}</option>
{% for s in statuses %}<option value="{{ s }}" {{ status==s?'selected':'' }}>{{ ('portals.pub.status.'~s)|trans }}</option>{% endfor %}
</select></form>
</div>
<div class="table-wrap" data-table><table class="table"><thead><tr>
<th>{{ 'portals.field.listing'|trans }}</th>
<th>{{ 'portals.field.name'|trans }}</th>
{% include 'ui/sort_th.html.twig' with { label: 'portals.field.status'|trans, column: 'status', query: { status: status } } %}
<th>{{ 'portals.field.external_id'|trans }}</th>
<th class="table__actions-head"></th>
</tr></thead>
<tbody>{% for item in items %}
<tr>
<td>
    {% if listingTitles[item.listingId()] is defined %}
        <a href="{{ url('admin.listings.show',{id:item.listingId()}) }}">{{ listingTitles[item.listingId()] }}</a>
    {% else %}
        <code>{{ item.listingId() }}</code>
    {% endif %}
</td>
<td>
    {% if accountNames[item.portalAccountId()] is defined %}
        <a href="{{ url('admin.portals.show',{id:item.portalAccountId()}) }}">{{ accountNames[item.portalAccountId()] }}</a>
    {% else %}
        <code>{{ item.portalAccountId() }}</code>
    {% endif %}
</td>
<td><span class="badge">{{ item.statusLabel()|trans }}</span></td>
<td>{{ item.externalId()|default('—') }}</td>
{% embed 'ui/row_actions.html.twig' %}
    {% block items %}
        {% include 'ui/row_action.html.twig' with { href: url('admin.portals.publications.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
    {% endblock %}
{% endembed %}
</tr>
{% else %}<tr><td colspan="5"><div class="empty"><h2>{{ 'portals.publications.empty'|trans }}</h2></div></td></tr>{% endfor %}
</tbody></table></div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
