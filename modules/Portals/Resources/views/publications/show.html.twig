{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'portals.publications.detail'|trans }}</h1>
        <p class="muted detail-layout__meta">
            <span>{{ 'portals.field.listing'|trans }}:
                {% if listing %}
                    <a href="{{ url('admin.listings.show',{id:listing.id()}) }}">{{ listing.title() }}</a>
                {% else %}
                    <code>{{ item.listingId() }}</code>
                {% endif %}
            </span>
            <span class="badge">{{ item.statusLabel()|trans }}</span>
        </p>
    </div>
    {% if user.can('portals.manage') %}
        <div class="actions">
            <form method="post" action="{{ url('admin.portals.publications.destroy',{id:item.id()}) }}" data-confirm="{{ 'portals.confirm_pub_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                {{ csrf_field()|raw }}
                <button class="btn btn--ghost" type="submit">{{ 'common.delete'|trans }}</button>
            </form>
        </div>
    {% endif %}
</header>

<div class="detail-layout">
    <div class="detail-layout__main">
        <section class="panel">
            <header class="panel__head"><h2>{{ 'portals.payload'|trans }}</h2></header>
            {% if item.payloadSnapshot() %}
                <pre class="code-block">{{ item.payloadSnapshot()|json_encode }}</pre>
            {% else %}
                <p class="muted">—</p>
            {% endif %}
            {% if item.lastError() %}
                <p class="muted">{{ item.lastError() }}</p>
            {% endif %}
        </section>
    </div>
    <aside class="detail-layout__aside">
        <section class="panel">
            <dl class="meta-list meta-list--flush">
                <div>
                    <dt>{{ 'portals.field.provider'|trans }}</dt>
                    <dd>
                        {% if catalogProvider %}
                            <a href="{{ url('admin.portals.providers.show',{id:catalogProvider.id()}) }}">{{ catalogProvider.name() }}</a>
                        {% elseif account %}
                            {{ account.name() }}
                        {% else %}
                            —
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt>{{ 'portals.field.external_id'|trans }}</dt>
                    <dd>{{ item.externalId()|default('—') }}</dd>
                </div>
                <div>
                    <dt>{{ 'portals.field.created'|trans }}</dt>
                    <dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd>
                </div>
            </dl>
            {% if user.can('portals.manage') and item.status() != 'published' %}
                <form method="post" class="form-grid" action="{{ url('admin.portals.publications.publish',{id:item.id()}) }}" style="margin-top:1rem">
                    {{ csrf_field()|raw }}
                    {% include 'ui/input.html.twig' with { name:'external_id', label:'portals.field.external_id'|trans, optional:true, value:item.externalId()|default('') } %}
                    <div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'portals.mark_published'|trans }}</button></div>
                </form>
            {% endif %}
            {% if account %}
                <p style="margin-top:1rem"><a href="{{ url('admin.portals.show',{id:account.id()}) }}">{{ account.name() }}</a></p>
            {% endif %}
        </section>
    </aside>
</div>
{% endblock %}
