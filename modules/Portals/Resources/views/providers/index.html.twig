{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="portal-providers" data-actions-default="1">
<header class="page-header">
    <div>
        <h1>{{ 'portals.providers.title'|trans }}</h1>
        <p class="muted">{{ 'portals.providers.intro'|trans }}</p>
    </div>
    {% if user.can('portals.manage') %}
        <a class="btn btn--primary" href="{{ url('admin.portals.providers.create') }}">{{ icon('plus') }} {{ 'portals.providers.new'|trans }}</a>
    {% endif %}
</header>

<section class="panel" style="margin-bottom:1rem">
    <p class="muted" style="margin:0">{{ 'portals.providers.howto'|trans }}</p>
</section>

<div class="toolbar--table">
<form class="toolbar" method="get">
<input type="hidden" name="sort" value="{{ sort }}">
<input type="hidden" name="dir" value="{{ dir }}">
<input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'portals.search'|trans }}">
</form>
</div>
<div class="table-wrap" data-table><table class="table"><thead><tr>
{% include 'ui/sort_th.html.twig' with { label: 'portals.providers.field.name'|trans, column: 'name' } %}
{% include 'ui/sort_th.html.twig' with { label: 'portals.providers.field.code'|trans, column: 'code' } %}
<th>{{ 'portals.providers.field.driver'|trans }}</th>
<th>{{ 'portals.providers.field.fields'|trans }}</th>
<th>{{ 'portals.field.active'|trans }}</th>
<th class="table__actions-head"></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><a href="{{ url('admin.portals.providers.show',{id:item.id()}) }}">{{ item.name() }}</a></td>
    <td><code>{{ item.code() }}</code></td>
    <td>{{ item.driverLabel()|trans }}</td>
    <td>{{ item.fields()|length }}</td>
    <td>{% if item.active() %}<span class="badge badge--ok">{{ 'common.yes'|trans }}</span>{% else %}<span class="badge badge--muted">{{ 'common.no'|trans }}</span>{% endif %}</td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% if user.can('portals.manage') %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.portals.providers.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.portals.providers.edit',{id:item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
            {% else %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.portals.providers.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr><td colspan="6"><div class="empty"><h2>{{ 'portals.providers.empty'|trans }}</h2></div></td></tr>
{% endfor %}
</tbody></table></div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
