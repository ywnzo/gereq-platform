{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.portals'|trans, url: url('admin.portals.index') },
        { label: 'nav.portals.providers'|trans, url: url('admin.portals.providers.index') },
        { label: item ? item.name() : ('portals.providers.new'|trans), url: item ? url('admin.portals.providers.show',{id:item.id()}) : null },
        { label: item ? ('common.edit'|trans) : ('portals.providers.new'|trans) },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ item ? ('portals.providers.edit'|trans({'%name%': item.name()})) : ('portals.providers.new'|trans) }}</h1>
        <p class="muted">{{ 'portals.providers.form.intro'|trans }}</p>
    </div>
    <div class="actions">
        <button class="btn btn--primary" type="submit" form="portal-provider-form">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ item ? url('admin.portals.providers.show',{id:item.id()}) : url('admin.portals.providers.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'portals.provider.save' } %}

<form
    id="portal-provider-form"
    method="post"
    class="detail-layout"
    action="{{ item ? url('admin.portals.providers.update',{id:item.id()}) : url('admin.portals.providers.store') }}"
    data-form="portals.provider.save"
    x-data="gereqForm"
    {% if form_errors('portals.provider.save') %}data-server-state="1"{% endif %}
>
    {{ csrf_field()|raw }}

    <div class="detail-layout__main">
        <section class="panel">
            <header class="panel__head"><h2>{{ 'portals.providers.section.basic'|trans }}</h2></header>
            <div class="form-grid form-grid--compact">
                {% if item %}
                    <div class="g-field">
                        <span class="g-label">{{ 'portals.providers.field.code'|trans }}</span>
                        <div class="portal-form__code"><code>{{ item.code() }}</code></div>
                        <input type="hidden" name="code" value="{{ item.code() }}">
                    </div>
                {% else %}
                    {% include 'ui/input.html.twig' with { name:'code', label:'portals.providers.field.code'|trans, required:true, form:'portals.provider.save', value:'', hint:'portals.providers.field.code.hint'|trans } %}
                {% endif %}
                {% include 'ui/input.html.twig' with { name:'name', label:'portals.providers.field.name'|trans, required:true, form:'portals.provider.save', value: item ? item.name() : '' } %}
                {% set driverOpts = [] %}
                {% for d in drivers %}
                    {% set driverOpts = driverOpts|merge([{ value: d, label: ('portals.driver.' ~ d)|trans }]) %}
                {% endfor %}
                {% include 'ui/select.html.twig' with { name:'driver', label:'portals.providers.field.driver'|trans, required:true, form:'portals.provider.save', value: item ? item.driver() : 'custom', options: driverOpts } %}
                {% include 'ui/input.html.twig' with { name:'api_base_url', type:'url', label:'portals.providers.field.api_base_url'|trans, optional:true, form:'portals.provider.save', value: item and item.apiBaseUrl() ? item.apiBaseUrl() : '', hint:'portals.providers.field.api_base_url.hint'|trans } %}
                {% include 'ui/input.html.twig' with { name:'openapi_url', type:'url', label:'portals.providers.field.openapi_url'|trans, optional:true, form:'portals.provider.save', value: item and item.openapiUrl() ? item.openapiUrl() : '', hint:'portals.providers.field.openapi_url.hint'|trans, placeholder:'https://…/openapi.json' } %}
                {% include 'ui/input.html.twig' with { name:'sort_order', type:'number', label:'portals.providers.field.sort_order'|trans, optional:true, form:'portals.provider.save', value: item ? item.sortOrder() : '100' } %}
                {% include 'ui/textarea.html.twig' with { name:'description', label:'portals.providers.field.description'|trans, optional:true, form:'portals.provider.save', value: item and item.description() ? item.description() : '', size:'mini', rows:3 } %}
            </div>
        </section>

        <section class="panel">
            <header class="panel__head">
                <div>
                    <h2>{{ 'portals.providers.section.fields'|trans }}</h2>
                    <p class="muted">{{ 'portals.providers.section.fields_hint'|trans }}</p>
                </div>
            </header>
            <div class="portal-fields-editor">
                {% for row in fieldRows %}
                    <div class="portal-fields-editor__row form-grid form-grid--compact">
                        {% include 'ui/input.html.twig' with { name:'field_key['~loop.index0~']', label:'portals.providers.field.field_key'|trans, optional:true, value: row.key, hint: loop.first ? 'portals.providers.field.field_key.hint'|trans : '' } %}
                        {% include 'ui/input.html.twig' with { name:'field_label['~loop.index0~']', label:'portals.providers.field.field_label'|trans, optional:true, value: row.label } %}
                        {% set typeOpts = [] %}
                        {% for t in fieldTypes %}
                            {% set typeOpts = typeOpts|merge([{ value: t, label: ('portals.field_type.' ~ t)|trans }]) %}
                        {% endfor %}
                        {% include 'ui/select.html.twig' with { name:'field_type['~loop.index0~']', label:'portals.providers.field.field_type'|trans, value: row.type, options: typeOpts } %}
                        <label class="field field--checkbox">
                            <input type="checkbox" name="field_required[{{ loop.index0 }}]" value="1" {{ row.required ? 'checked' : '' }}>
                            <span>{{ 'portals.providers.field.field_required'|trans }}</span>
                        </label>
                        {% include 'ui/input.html.twig' with { name:'field_hint['~loop.index0~']', label:'portals.providers.field.field_hint'|trans, optional:true, value: row.hint } %}
                        {% include 'ui/input.html.twig' with { name:'field_placeholder['~loop.index0~']', label:'portals.providers.field.field_placeholder'|trans, optional:true, value: row.placeholder } %}
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>

    <aside class="detail-layout__aside">
        <section class="panel">
            <header class="panel__head"><h2>{{ 'portals.form.section.status'|trans }}</h2></header>
            {% include 'ui/switch.html.twig' with {
                name: 'active',
                label: 'portals.field.active'|trans,
                description: 'portals.providers.field.active.hint'|trans,
                on: item is null or item.active(),
                form: 'portals.provider.save'
            } %}
        </section>
        {% if item and user.can('portals.manage') %}
            <section class="panel">
                <p class="muted">{{ 'portals.providers.danger_zone'|trans }}</p>
            </section>
        {% endif %}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ item ? url('admin.portals.providers.show',{id:item.id()}) : url('admin.portals.providers.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </aside>
</form>
{% if item and user.can('portals.manage') %}
    <div class="portal-provider-danger" style="margin-top:1rem;display:flex;gap:0.5rem;flex-wrap:wrap">
        <form method="post" action="{{ url('admin.portals.providers.toggle',{id:item.id()}) }}">{{ csrf_field()|raw }}
            <button class="btn btn--ghost" type="submit">{{ item.active() ? 'portals.deactivate'|trans : 'portals.activate'|trans }}</button>
        </form>
        <form method="post" action="{{ url('admin.portals.providers.destroy',{id:item.id()}) }}" data-confirm="{{ 'portals.providers.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
            {{ csrf_field()|raw }}
            <button class="btn btn--ghost" type="submit">{{ 'common.delete'|trans }}</button>
        </form>
    </div>
{% endif %}
{% endblock %}
