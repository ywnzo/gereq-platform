{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set canManage = user.can('portals.manage') %}
{% set colCount = canManage ? 6 : 5 %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="portals"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'portals.bulk.confirm_delete'|trans|e('html_attr') }}"
>
<header class="page-header"><h1>{{ 'portals.title'|trans }}</h1>
{% if canManage %}<a class="btn btn--primary" href="{{ url('admin.portals.create') }}">{{ icon('plus') }} {{ 'portals.new'|trans }}</a>{% endif %}
</header>

<div class="widget-row portals-stats">
    <a class="stat-card" href="{{ url('admin.portals.publications.index', {status: 'published'}) }}">
        <div class="stat-card__label">{{ 'portals.stats.published'|trans }}</div>
        <div class="stat-card__value">{{ stats.published }}</div>
        <div class="stat-card__hint">{{ 'portals.stats.published.hint'|trans }}</div>
    </a>
    <a class="stat-card" href="{{ url('admin.portals.publications.index', {status: 'queued'}) }}">
        <div class="stat-card__label">{{ 'portals.stats.prepared'|trans }}</div>
        <div class="stat-card__value">{{ stats.prepared }}</div>
        <div class="stat-card__hint">{{ 'portals.stats.prepared.hint'|trans }}</div>
    </a>
    <a class="stat-card" href="{{ url('admin.portals.publications.index') }}">
        <div class="stat-card__label">{{ 'portals.stats.total'|trans }}</div>
        <div class="stat-card__value">{{ stats.total }}</div>
        <div class="stat-card__hint">{{ 'portals.stats.total.hint'|trans }}</div>
    </a>
</div>

<div class="toolbar--table">
<form class="toolbar" method="get">
<input type="hidden" name="sort" value="{{ sort }}">
<input type="hidden" name="dir" value="{{ dir }}">
<input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'portals.search'|trans }}">
<select name="provider_id" class="input" onchange="this.form.submit()">
    <option value="">{{ 'portals.all_providers'|trans }}</option>
    {% for p in catalog %}
        <option value="{{ p.id() }}" {{ provider_id == p.id() ? 'selected' : '' }}>{{ p.name() }}</option>
    {% endfor %}
</select>
</form>
</div>

{% if canManage and items is not empty %}
<form
    class="bulk-bar"
    method="post"
    action="{{ url('admin.portals.bulk') }}"
    x-show="selectedCount > 0"
    x-cloak
    @submit="confirmBulk"
>
    {{ csrf_field()|raw }}
    <input type="hidden" name="confirmed" value="1">
    <template x-for="id in selected" :key="id">
        <input type="hidden" name="ids[]" :value="id">
    </template>
    <div class="bulk-bar__meta">
        <strong x-text="selectedCount"></strong>
        <span>{{ 'portals.bulk.selected'|trans }}</span>
        <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'portals.bulk.clear'|trans }}</button>
    </div>
    <div class="bulk-bar__actions">
        <select class="input" name="action" x-model="bulkAction" required>
            <option value="">{{ 'portals.bulk.choose'|trans }}</option>
            <option value="activate">{{ 'portals.bulk.action.activate'|trans }}</option>
            <option value="deactivate">{{ 'portals.bulk.action.deactivate'|trans }}</option>
            <option value="delete">{{ 'portals.bulk.action.delete'|trans }}</option>
        </select>
        <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'portals.bulk.apply'|trans }}</button>
    </div>
</form>
{% endif %}

<div class="table-wrap" data-table><table class="table"><thead><tr>
{% if canManage %}
<th class="table__check">
    <label class="table-check">
        <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected" {{ items is empty ? 'disabled' : '' }}>
        <span class="sr-only">{{ 'portals.bulk.select_all'|trans }}</span>
    </label>
</th>
{% endif %}
{% include 'ui/sort_th.html.twig' with { label: 'portals.field.name'|trans, column: 'name', query: { provider_id: provider_id } } %}
<th>{{ 'portals.field.code'|trans }}</th>
<th>{{ 'portals.field.provider'|trans }}</th>
<th>{{ 'portals.field.active'|trans }}</th>
<th class="table__actions-head"></th>
</tr></thead>
<tbody>{% for item in items %}
<tr :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
{% if canManage %}
<td class="table__check">
    <label class="table-check">
        <input
            type="checkbox"
            value="{{ item.id() }}"
            @change="toggleId('{{ item.id() }}')"
            :checked="isSelected('{{ item.id() }}')"
        >
        <span class="sr-only">{{ item.name() }}</span>
    </label>
</td>
{% endif %}
<td><a href="{{ url('admin.portals.show',{id:item.id()}) }}">{{ item.name() }}</a></td>
<td><code>{{ item.code() }}</code></td>
<td>{{ providerNames[item.providerId()]|default('—') }}</td>
<td>{% if item.active() %}<span class="badge badge--ok">{{ 'common.yes'|trans }}</span>{% else %}<span class="badge badge--muted">{{ 'common.no'|trans }}</span>{% endif %}</td>
{% embed 'ui/row_actions.html.twig' %}
    {% block items %}
        {% include 'ui/row_action.html.twig' with { href: url('admin.portals.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
        {% if canManage %}
            {% include 'ui/row_action.html.twig' with { href: url('admin.portals.edit',{id:item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
            {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.portals.destroy',{id:item.id()}), confirm: 'portals.confirm_delete'|trans } %}
        {% endif %}
    {% endblock %}
{% endembed %}
</tr>
{% else %}<tr><td colspan="{{ colCount }}"><div class="empty"><h2>{{ 'portals.empty'|trans }}</h2><p class="muted">{{ 'portals.empty.hint'|trans }}</p></div></td></tr>{% endfor %}
</tbody></table></div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
