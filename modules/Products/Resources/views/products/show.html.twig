{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <div>
            <p class="eyebrow"><a href="{{ url('admin.products.index') }}">{{ 'nav.products'|trans }}</a></p>
            <h1>{{ item.name() }}</h1>
            <p class="muted detail-layout__meta">
                <code>{{ item.sku() }}</code>
                <span class="status-chip"><span class="status-chip__dot"></span>{{ item.statusLabel()|trans }}</span>
            </p>
        </div>
        <div class="actions">
            <button type="button" class="btn btn--ghost" onclick="navigator.clipboard.writeText({{ item.sku()|json_encode|e('html_attr') }})">SKU</button>
            {% if user.can('products.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.products.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.products.destroy', {id: item.id()}) }}" data-confirm="{{ 'products.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="detail-hub" x-data="gereqTabs" data-initial="overview">
        <div class="design-tabs detail-tabs" role="tablist">
            <button type="button" class="design-tab" role="tab" data-tab="overview">{{ 'common.overview'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="images">{{ 'products.images.title'|trans }}{% if images %}<span class="module-tab-count">{{ images|length }}</span>{% endif %}</button>
            <button type="button" class="design-tab" role="tab" data-tab="prices">{{ 'products.prices.title'|trans }}{% if prices %}<span class="module-tab-count">{{ prices|length }}</span>{% endif %}</button>
            <button type="button" class="design-tab" role="tab" data-tab="variants">Varianty{% if optionGroups or variants %}<span class="module-tab-count">{{ optionGroups|length }}/{{ variants|length }}</span>{% endif %}</button>
        </div>

        <section class="design-panel" data-panel="overview" role="tabpanel">
            <div class="detail-layout">
                <div class="detail-layout__main">
                    <section class="detail-hero panel">
                        <div class="detail-hero__body">
                            <div class="detail-hero__highlight">
                                <span>{{ 'products.field.status'|trans }}</span>
                                <strong>{{ item.statusLabel()|trans }}</strong>
                            </div>
                            <dl class="detail-hero__facts">
                                <div>
                                    <dt>{{ 'products.field.sku'|trans|default('SKU') }}</dt>
                                    <dd><code>{{ item.sku() }}</code></dd>
                                </div>
                                <div>
                                    <dt>{{ 'products.field.unit'|trans }}</dt>
                                    <dd>{{ item.unit() }}</dd>
                                </div>
                                <div>
                                    <dt>{{ 'products.field.created'|trans }}</dt>
                                    <dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd>
                                </div>
                                <div>
                                    <dt>{{ 'products.field.updated'|trans }}</dt>
                                    <dd>{{ item.updatedAt().format('d. m. Y H:i') }}</dd>
                                </div>
                            </dl>
                        </div>
                    </section>

                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'products.field.description'|trans }}</h2>
                        </header>
                        <div class="detail-prose">{{ item.description() ?: '—' }}</div>
                    </section>

                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'products.field.categories'|trans }}</h2>
                        </header>
                        <div class="module-chip-row detail-layout__chips">
                            {% if item.categories() is empty %}
                                <span class="muted">—</span>
                            {% else %}
                                {% for cat in item.categories() %}
                                    <span class="badge">{{ cat.name() }}</span>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </section>
                </div>

                <aside class="detail-layout__aside">
                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'products.field.status'|trans }}</h2>
                        </header>
                        {% if user.can('products.manage') %}
                            <form method="post" action="{{ url('admin.products.status', {id: item.id()}) }}" class="meta-list__action">
                                {{ csrf_field()|raw }}
                                <span class="badge">{{ item.statusLabel()|trans }}</span>
                                <select id="status" name="status" class="input" aria-label="{{ 'products.change_status'|trans }}" onchange="this.form.submit()">
                                    {% for s in statuses %}
                                        <option value="{{ s }}" {{ item.status() == s ? 'selected' : '' }}>{{ ('products.status.' ~ s)|trans }}</option>
                                    {% endfor %}
                                </select>
                            </form>
                        {% else %}
                            <span class="badge">{{ item.statusLabel()|trans }}</span>
                        {% endif %}
                    </section>

                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'common.overview'|trans }}</h2>
                        </header>
                        <dl class="meta-list meta-list--flush detail-layout__specs">
                            <div>
                                <dt>{{ 'products.field.sku'|trans|default('SKU') }}</dt>
                                <dd><code>{{ item.sku() }}</code></dd>
                            </div>
                            <div>
                                <dt>{{ 'products.field.unit'|trans }}</dt>
                                <dd>{{ item.unit() }}</dd>
                            </div>
                            <div>
                                <dt>{{ 'products.field.created'|trans }}</dt>
                                <dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd>
                            </div>
                            <div>
                                <dt>{{ 'products.field.updated'|trans }}</dt>
                                <dd>{{ item.updatedAt().format('d. m. Y H:i') }}</dd>
                            </div>
                        </dl>
                    </section>
                </aside>
            </div>
        </section>

        <section class="design-panel" data-panel="images" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'products.images.title'|trans }}</h2>
                </header>

                {% if not hasMedia %}
                    <div class="empty">
                        <p>{{ 'products.images.error.media_required'|trans }}</p>
                    </div>
                {% else %}
                    {% if images is empty %}
                        <div class="empty">
                            <p>{{ 'products.images.empty'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="product-gallery">
                            {% for image in images %}
                                {% set asset = imageAssets[image.id()]|default(null) %}
                                <figure class="product-gallery__item{{ image.isPrimary() ? ' is-primary' : '' }}">
                                    {% if asset %}
                                        <a href="{{ url('admin.media.file', {id: asset.id()}) }}" target="_blank" rel="noopener">
                                            <img src="{{ url('admin.media.file', {id: asset.id()}) }}" alt="{{ image.alt()|default(asset.alt()|default(asset.title())) }}">
                                        </a>
                                        <figcaption>
                                            <span>{{ asset.title() }}</span>
                                            {% if image.isPrimary() %}
                                                <span class="badge">{{ 'products.images.primary'|trans }}</span>
                                            {% endif %}
                                        </figcaption>
                                    {% else %}
                                        <div class="product-gallery__missing muted">{{ 'products.images.missing_asset'|trans }}</div>
                                    {% endif %}
                                    {% if user.can('products.manage') %}
                                        <div class="product-gallery__actions">
                                            {% if not image.isPrimary() %}
                                                <form method="post" action="{{ url('admin.products.images.primary', {id: item.id(), imageId: image.id()}) }}">
                                                    {{ csrf_field()|raw }}
                                                    <button class="btn btn--ghost btn-sm" type="submit">{{ 'products.images.set_primary'|trans }}</button>
                                                </form>
                                            {% endif %}
                                            <form method="post" action="{{ url('admin.products.images.destroy', {id: item.id(), imageId: image.id()}) }}" data-confirm="{{ 'products.images.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                                {{ csrf_field()|raw }}
                                                <button class="btn btn--ghost btn-sm" type="submit">{{ 'common.delete'|trans }}</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </figure>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if user.can('products.manage') %}
                        {% include 'ui/error-summary.html.twig' with { form: 'products.image.upload' } %}
                        <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.products.images.store', {id: item.id()}) }}" enctype="multipart/form-data" data-form="products.image.upload" x-data="gereqForm"{% if form_errors('products.image.upload') %} data-server-state="1"{% endif %}>
                            {{ csrf_field()|raw }}
                            {% include 'ui/file.html.twig' with { name: 'file', label: 'products.images.field.file'|trans, hint: 'products.images.field.file.hint'|trans, extra: 'field--full' } %}
                            {% include 'ui/input.html.twig' with { name: 'title', label: 'products.images.field.title'|trans, optional: true, form: 'products.image.upload', value: '' } %}
                            {% include 'ui/input.html.twig' with { name: 'alt', label: 'products.images.field.alt'|trans, optional: true, form: 'products.image.upload', value: '' } %}
                            <div class="form-actions">
                                <button class="btn btn--primary" type="submit">{{ 'products.images.upload'|trans }}</button>
                            </div>
                        </form>

                        {% if libraryImages is not empty %}
                            {% include 'ui/error-summary.html.twig' with { form: 'products.image.attach' } %}
                            <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.products.images.attach', {id: item.id()}) }}" data-form="products.image.attach" x-data="gereqForm"{% if form_errors('products.image.attach') %} data-server-state="1"{% endif %}>
                                {{ csrf_field()|raw }}
                                {% include 'ui/select.html.twig' with { name: 'media_asset_id', label: 'products.images.attach_existing'|trans, required: true, form: 'products.image.attach', value: '', options: libraryImages } %}
                                <div class="form-actions">
                                    <button class="btn btn--ghost" type="submit">{{ 'products.images.attach'|trans }}</button>
                                </div>
                            </form>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </section>
        </section>

        <section class="design-panel" data-panel="prices" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'products.prices.title'|trans }}</h2>
                </header>

                {% if prices is empty %}
                    <div class="empty">
                        <p>{{ 'products.prices.empty'|trans }}</p>
                    </div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'products.prices.currency'|trans }}</th>
                                    <th>{{ 'products.prices.amount'|trans }}</th>
                                    <th>{{ 'products.prices.valid_from'|trans }}</th>
                                    <th>{{ 'products.prices.valid_to'|trans }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for price in prices %}
                                    <tr>
                                        <td><strong>{{ price.currencyCode() }}</strong></td>
                                        <td>{{ price.amountFormatted() }}</td>
                                        <td>{{ price.validFrom() ? price.validFrom().format('d. m. Y') : '—' }}</td>
                                        <td>{{ price.validTo() ? price.validTo().format('d. m. Y') : '—' }}</td>
                                        <td class="table__actions">
                                            {% if user.can('products.manage') %}
                                                <form method="post" action="{{ url('admin.products.prices.destroy', {id: item.id(), priceId: price.id()}) }}" data-confirm="{{ 'products.prices.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                                    {{ csrf_field()|raw }}
                                                    <button type="submit">{{ 'common.delete'|trans }}</button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if user.can('products.manage') %}
                    {% include 'ui/error-summary.html.twig' with { form: 'products.price.save' } %}
                    <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.products.prices.store', {id: item.id()}) }}" data-form="products.price.save" x-data="gereqForm"{% if form_errors('products.price.save') %} data-server-state="1"{% endif %}>
                        {{ csrf_field()|raw }}
                        {% include 'ui/select.html.twig' with { name: 'currency_code', label: 'products.prices.currency'|trans, required: true, form: 'products.price.save', value: 'CZK', options: currencyOptions } %}
                        {% include 'ui/input.html.twig' with { name: 'amount', label: 'products.prices.amount'|trans, required: true, form: 'products.price.save', value: '' } %}
                        {% include 'ui/input.html.twig' with { name: 'valid_from', type: 'date', label: 'products.prices.valid_from'|trans, optional: true, form: 'products.price.save', value: '' } %}
                        {% include 'ui/input.html.twig' with { name: 'valid_to', type: 'date', label: 'products.prices.valid_to'|trans, optional: true, form: 'products.price.save', value: '' } %}
                        <div class="form-actions">
                            <button class="btn btn--primary" type="submit">{{ 'products.prices.add'|trans }}</button>
                        </div>
                    </form>
                {% endif %}
            </section>
        </section>

        <section class="design-panel" data-panel="variants" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>Kolonky variant</h2>
                        <p class="muted">Kolonky můžete nastavit u kategorie a tady je zdědit, nebo mít vlastní jen u produktu (případně obojí).</p>
                    </div>
                </header>

                {% if user.can('products.manage') %}
                    <form method="post" class="variant-inherit" action="{{ url('admin.products.inherit_category_options', {id: item.id()}) }}">
                        {{ csrf_field()|raw }}
                        <label class="check">
                            <input type="hidden" name="inherit_category_options" value="0">
                            <input type="checkbox" name="inherit_category_options" value="1" {{ item.inheritsCategoryOptions() ? 'checked' : '' }} onchange="this.form.submit()">
                            <span>
                                Dědit kolonky z kategorie
                                {% if primaryCategory %}
                                    <strong>{{ primaryCategory.name() }}</strong>
                                {% else %}
                                    <span class="muted">(produkt nemá kategorii)</span>
                                {% endif %}
                            </span>
                        </label>
                    </form>
                {% elseif item.inheritsCategoryOptions() %}
                    <p class="muted">Produkt dědí kolonky z kategorie{% if primaryCategory %} <strong>{{ primaryCategory.name() }}</strong>{% endif %}.</p>
                {% endif %}

                {% if item.inheritsCategoryOptions() %}
                    <div class="variant-inherited">
                        <h3 class="variant-inherited__title">Z kategorie {% if primaryCategory %}· {{ primaryCategory.name() }}{% endif %}</h3>
                        {% if categoryOptionGroups is empty %}
                            <p class="muted">Kategorie zatím nemá žádné kolonky. Nastavte je v editaci kategorie.</p>
                        {% else %}
                            <div class="variant-groups">
                                {% for row in categoryOptionGroups %}
                                    {% set group = row.group %}
                                    <article class="variant-group variant-group--inherited">
                                        <header class="variant-group__head">
                                            <strong>{{ group.name() }}</strong>
                                            <span class="badge">{{ group.code() }}</span>
                                            <span class="badge badge--muted">děděno</span>
                                        </header>
                                        <p class="muted">{{ row.options_text|replace({'\n': ', '}) }}</p>
                                    </article>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                <h3 class="variant-inherited__title">Vlastní kolonky produktu</h3>

                {% if optionGroups is empty %}
                    <div class="empty"><p>Žádné vlastní kolonky. {% if item.inheritsCategoryOptions() and categoryOptionGroups is not empty %}Stačí ty z kategorie, nebo přidejte další.{% else %}Přidejte třeba „Barva“ nebo „Velikost“.{% endif %}</p></div>
                {% else %}
                    <div class="variant-groups">
                        {% for row in optionGroups %}
                            {% set group = row.group %}
                            <article class="variant-group">
                                <header class="variant-group__head">
                                    <strong>{{ loop.index }}. kolonka</strong>
                                    <span class="badge">{{ group.code() }}</span>
                                    {% if user.can('products.manage') %}
                                        <form method="post" action="{{ url('admin.products.option_groups.destroy', {id: item.id(), groupId: group.id()}) }}" data-confirm="Smazat kolonku a její možnosti?" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                            {{ csrf_field()|raw }}
                                            <button type="submit" class="btn btn--ghost btn-sm">Odebrat</button>
                                        </form>
                                    {% endif %}
                                </header>
                                {% if user.can('products.manage') %}
                                    <form method="post" class="variant-group-form" action="{{ url('admin.products.option_groups.update', {id: item.id(), groupId: group.id()}) }}" data-form="products.option_group.save">
                                        {{ csrf_field()|raw }}
                                        <div class="variant-group-form__top">
                                            {% include 'ui/input.html.twig' with { name: 'name', label: 'Label kolonky', required: true, form: 'products.option_group.save', value: group.name() } %}
                                            <label class="check">
                                                <input type="hidden" name="required" value="0">
                                                <input type="checkbox" name="required" value="1" {{ group.isRequired() ? 'checked' : '' }}>
                                                <span>Povinný výběr na storefrontu</span>
                                            </label>
                                        </div>
                                        <label class="field">
                                            <span class="g-label">Možnosti <span class="g-optional">(1 na řádek)</span></span>
                                            <textarea class="input variant-options-textarea" name="options_text" rows="8" placeholder="Černá&#10;Dub&#10;Bílá">{{ row.options_text }}</textarea>
                                        </label>
                                        <div class="form-actions">
                                            <button class="btn btn--primary" type="submit">Uložit kolonku</button>
                                        </div>
                                    </form>
                                {% else %}
                                    <p><strong>{{ group.name() }}</strong></p>
                                    <p class="muted">{{ row.options_text|replace({'\n': ', '}) }}</p>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if user.can('products.manage') %}
                    <div class="variant-group variant-group--new">
                        <header class="variant-group__head"><strong>Nová kolonka produktu</strong></header>
                        <form method="post" class="variant-group-form" action="{{ url('admin.products.option_groups.store', {id: item.id()}) }}" data-form="products.option_group.save">
                            {{ csrf_field()|raw }}
                            <div class="variant-group-form__top">
                                {% include 'ui/input.html.twig' with { name: 'name', label: 'Label kolonky', required: true, form: 'products.option_group.save', value: '', placeholder: 'Např. Barva látky' } %}
                                <label class="check">
                                    <input type="hidden" name="required" value="0">
                                    <input type="checkbox" name="required" value="1" checked>
                                    <span>Povinný výběr na storefrontu</span>
                                </label>
                            </div>
                            <label class="field">
                                <span class="g-label">Možnosti <span class="g-optional">(1 na řádek)</span></span>
                                <textarea class="input variant-options-textarea" name="options_text" rows="8" placeholder="Bílá&#10;Černá&#10;Modrá"></textarea>
                            </label>
                            <div class="form-actions">
                                <button class="btn btn--primary" type="submit">Přidat kolonku</button>
                            </div>
                        </form>
                    </div>
                {% endif %}
            </section>

            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>Prodejní kombinace (SKU)</h2>
                        <p class="muted">Každá kombinace kolonek (včetně děděných) má vlastní SKU, cenu a EAN. Generování doplní chybějící a odstraní kombinace, které už neodpovídají kolonkám.</p>
                    </div>
                    {% set canGenerate = optionGroups is not empty or (item.inheritsCategoryOptions() and categoryOptionGroups is not empty) %}
                    {% if user.can('products.manage') and canGenerate %}
                        <form method="post" action="{{ url('admin.products.variants.generate', {id: item.id()}) }}">
                            {{ csrf_field()|raw }}
                            <button class="btn btn--primary" type="submit">Vygenerovat chybějící kombinace</button>
                        </form>
                    {% endif %}
                </header>

                {% if variants is empty %}
                    <div class="empty"><p>Zatím žádné kombinace. Nejdřív vyplňte kolonky a pak je vygenerujte.</p></div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table table--variants">
                            <thead>
                                <tr>
                                    <th>Kombinace</th>
                                    <th>SKU</th>
                                    <th class="table--variants__num">Cena</th>
                                    <th>EAN</th>
                                    <th class="table--variants__num">Sklad</th>
                                    <th>Stav</th>
                                    {% if user.can('products.manage') %}<th></th>{% endif %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for v in variants %}
                                    {% set formId = 'variant-form-' ~ v.id() %}
                                    <tr>
                                        <td class="table--variants__combo">
                                            {% if user.can('products.manage') %}
                                                <form id="{{ formId }}" class="table--variants__shell" method="post" action="{{ url('admin.products.variants.update', {id: item.id(), variantId: v.id()}) }}">
                                                    {{ csrf_field()|raw }}
                                                    <input type="hidden" name="price_currency" value="{{ v.priceCurrency() ?: 'CZK' }}">
                                                    <input type="hidden" name="name" value="{{ v.name() }}">
                                                </form>
                                            {% endif %}
                                            {% if v.attributes() is empty %}
                                                <strong>{{ v.name() ?: '—' }}</strong>
                                            {% else %}
                                                <div class="table--variants__badges">
                                                    {% for code, val in v.attributes() %}
                                                        <span class="badge">{{ code }}: {{ val }}</span>
                                                    {% endfor %}
                                                </div>
                                                {% if v.name() %}
                                                    <div class="muted table--variants__name">{{ v.name() }}</div>
                                                {% endif %}
                                            {% endif %}
                                        </td>
                                        {% if user.can('products.manage') %}
                                            <td><input class="input" form="{{ formId }}" type="text" name="sku" value="{{ v.sku() }}" required aria-label="SKU"></td>
                                            <td class="table--variants__num"><input class="input" form="{{ formId }}" type="text" name="price_amount" value="{{ v.priceAmount() }}" placeholder="—" aria-label="Cena"></td>
                                            <td><input class="input" form="{{ formId }}" type="text" name="ean" value="{{ v.ean() }}" placeholder="—" aria-label="EAN"></td>
                                            <td class="table--variants__num"><input class="input" form="{{ formId }}" type="text" name="stock_qty" value="{{ v.stockQty() is not null ? v.stockQty() : '' }}" placeholder="—" aria-label="Sklad"></td>
                                            <td><span class="badge {{ v.isActive() ? 'badge--ok' : 'badge--muted' }}">{{ v.isActive() ? 'aktivní' : 'neaktivní' }}</span></td>
                                            <td class="table--variants__actions">
                                                <button class="btn btn--primary btn-sm" form="{{ formId }}" type="submit">Uložit</button>
                                                <form method="post" action="{{ url('admin.products.variants.destroy', {id: item.id(), variantId: v.id()}) }}" data-confirm="Smazat variantu?" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                                    {{ csrf_field()|raw }}
                                                    <button type="submit" class="btn btn--ghost btn-sm">Smazat</button>
                                                </form>
                                            </td>
                                        {% else %}
                                            <td><code>{{ v.sku() }}</code></td>
                                            <td class="table--variants__num">{% if v.priceAmount() %}{{ v.priceAmount() }} {{ v.priceCurrency() }}{% else %}—{% endif %}</td>
                                            <td>{{ v.ean() ?: '—' }}</td>
                                            <td class="table--variants__num">{{ v.stockQty() is not null ? v.stockQty() : '—' }}</td>
                                            <td>{{ v.isActive() ? 'aktivní' : 'neaktivní' }}</td>
                                        {% endif %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </section>
    </div>
{% endblock %}
