{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set categoryFilter = category_id|default('') %}
{% set unitFilter = unit|default('') %}
{% set advancedFilters = (categoryFilter is not empty) or (unitFilter is not empty) %}
{% set filterQuery = { status: status, category_id: categoryFilter, unit: unitFilter } %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="products"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'products.bulk.confirm_delete'|trans|e('html_attr') }}"
>
    <header class="page-header">
        <div>
            <h1>{{ 'products.title'|trans }}</h1>
            <p class="muted">{{ 'products.list.hint'|trans }}</p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.products.categories.index') }}">{{ 'products.categories.title'|trans }}</a>
            {% if user.can('products.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.products.create') }}">{{ icon('plus') }} {{ 'products.add'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get" id="products-filter-form">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <input type="hidden" name="category_id" value="{{ categoryFilter }}">
            <input type="hidden" name="unit" value="{{ unitFilter }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'products.search'|trans }}">
            <select name="status" class="input" onchange="this.form.submit()">
                <option value="">{{ 'common.all_statuses'|trans }}</option>
                {% for s in statuses %}
                    <option value="{{ s }}" {{ status == s ? 'selected' : '' }}>{{ ('products.status.' ~ s)|trans }}</option>
                {% endfor %}
            </select>
        </form>
        <div class="toolbar__toggles">
            {{ ui_render('drawer_trigger', {
                drawer_id: 'products-filters',
                label: 'ui.drawer.filters'|trans,
                variant: advancedFilters ? 'primary' : 'ghost',
                icon: 'filters'
            }) }}
        </div>
    </div>

    {% if user.can('products.manage') and items is not empty %}
        <form
            class="bulk-bar"
            method="post"
            action="{{ url('admin.products.bulk') }}"
            x-show="selectedCount > 0"
            x-cloak
            @submit="confirmBulk"
        >
            {{ csrf_field()|raw }}
            <input type="hidden" name="confirmed" value="1">
            <template x-for="id in selected" :key="id">
                <input type="hidden" name="ids[]" :value="id">
            </template>
            <div class="bulk-bar__meta">
                <strong x-text="selectedCount"></strong>
                <span>{{ 'products.bulk.selected'|trans }}</span>
                <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'products.bulk.clear'|trans }}</button>
            </div>
            <div class="bulk-bar__actions">
                <select class="input" name="action" x-model="bulkAction" required>
                    <option value="">{{ 'products.bulk.choose'|trans }}</option>
                    <option value="activate">{{ 'products.bulk.action.activate'|trans }}</option>
                    <option value="draft">{{ 'products.bulk.action.draft'|trans }}</option>
                    <option value="archive">{{ 'products.bulk.action.archive'|trans }}</option>
                    <option value="delete">{{ 'products.bulk.action.delete'|trans }}</option>
                </select>
                <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'products.bulk.apply'|trans }}</button>
            </div>
        </form>
    {% endif %}

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% if user.can('products.manage') %}
                        <th class="table__check">
                            <label class="table-check">
                                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected">
                                <span class="sr-only">{{ 'products.bulk.select_all'|trans }}</span>
                            </label>
                        </th>
                    {% endif %}
                    <th class="table__thumb-cell"><span class="sr-only">{{ 'ui.table.col.thumb'|trans }}</span></th>
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.name'|trans, column: 'name', query: filterQuery } %}
                    <th>{{ 'products.field.categories'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.unit'|trans, column: 'unit', query: filterQuery } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.status'|trans, column: 'status', query: filterQuery } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.updated'|trans, column: 'updatedAt', query: filterQuery } %}
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    {% set thumb = thumbs[item.id()]|default(null) %}
                    <tr :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
                        {% if user.can('products.manage') %}
                            <td class="table__check">
                                <label class="table-check">
                                    <input
                                        type="checkbox"
                                        value="{{ item.id() }}"
                                        @change="toggleId('{{ item.id() }}')"
                                        :checked="isSelected('{{ item.id() }}')"
                                    >
                                    <span class="sr-only">{{ item.name() }}</span>
                                </label>
                            </td>
                        {% endif %}
                        <td class="table__thumb-cell">
                            {% include 'ui/table_thumb.html.twig' with {
                                src: thumb,
                                href: url('admin.products.show', {id: item.id()}),
                                alt: item.name()
                            } %}
                        </td>
                        <td>
                            <div class="table__title">
                                <a href="{{ url('admin.products.show', {id: item.id()}) }}"><strong>{{ item.name() }}</strong></a>
                                <span class="table__meta"><code>{{ item.sku() }}</code></span>
                            </div>
                        </td>
                        <td>
                            {% if item.categories() is empty %}
                                <span class="muted">—</span>
                            {% else %}
                                {% for cat in item.categories()|slice(0, 2) %}
                                    <span class="badge badge--muted">{{ cat.name() }}</span>
                                {% endfor %}
                                {% if item.categories()|length > 2 %}
                                    <span class="muted">+{{ item.categories()|length - 2 }}</span>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td>{{ item.unit() }}</td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : (item.status() == 'draft' ? 'warn' : 'muted') }}">
                                {{ item.statusLabel()|trans }}
                            </span>
                        </td>
                        <td class="is-mute">{{ item.updatedAt().format('d. m. Y') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with { href: url('admin.products.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                                {% if user.can('products.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.products.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.products.destroy', {id: item.id()}), confirm: 'products.confirm_delete'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ user.can('products.manage') ? 8 : 7 }}">
                            <div class="empty">
                                <h2>{{ 'products.empty'|trans }}</h2>
                                <p>{{ 'products.empty.hint'|trans }}</p>
                                {% if user.can('products.manage') %}
                                    <a class="btn btn--primary" href="{{ url('admin.products.create') }}">{{ icon('plus') }} {{ 'products.add'|trans }}</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>

{% embed 'ui/drawer.html.twig' with { id: 'products-filters', title: 'ui.drawer.filters'|trans } %}
    {% block body %}
        <form method="get" class="g-drawer__form stack" id="products-drawer-filters">
            <input type="hidden" name="q" value="{{ search }}">
            <input type="hidden" name="status" value="{{ status }}">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'products.field.categories'|trans }}</span>
                <select class="input" name="category_id">
                    <option value="">{{ 'products.filter.category_any'|trans }}</option>
                    {% for opt in categoryOptions|default([]) %}
                        <option value="{{ opt.value }}" {{ categoryFilter == opt.value ? 'selected' : '' }}>{{ opt.label }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'products.field.unit'|trans }}</span>
                <select class="input" name="unit">
                    <option value="">{{ 'products.filter.unit_any'|trans }}</option>
                    {% for u in units|default([]) %}
                        <option value="{{ u }}" {{ unitFilter == u ? 'selected' : '' }}>{{ u }}</option>
                    {% endfor %}
                </select>
            </label>
        </form>
    {% endblock %}
    {% block footer %}
        <a class="btn btn--ghost" href="?q={{ search|url_encode }}&status={{ status|url_encode }}&sort={{ sort|url_encode }}&dir={{ dir|url_encode }}">{{ 'ui.drawer.reset'|trans }}</a>
        <button class="btn btn--primary" type="submit" form="products-drawer-filters">{{ 'ui.drawer.apply'|trans }}</button>
    {% endblock %}
{% endembed %}
{% endblock %}
