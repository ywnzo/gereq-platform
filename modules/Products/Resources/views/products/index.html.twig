{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="products" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'products.title'|trans }}</h1>
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.products.categories.index') }}">{{ 'products.categories.title'|trans }}</a>
            {% if user.can('products.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.products.create') }}">{{ icon('plus') }} {{ 'products.add'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'products.search'|trans }}">
            <select name="status" class="input" onchange="this.form.submit()">
                <option value="">{{ 'common.all_statuses'|trans }}</option>
                {% for s in statuses %}
                    <option value="{{ s }}" {{ status == s ? 'selected' : '' }}>{{ ('products.status.' ~ s)|trans }}</option>
                {% endfor %}
            </select>
        </form>
        <div class="toolbar__toggles">
            {% include 'ui/table_actions_toggle.html.twig' %}
        </div>
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.sku'|trans, column: 'sku', query: { status: status } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.name'|trans, column: 'name', query: { status: status } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.unit'|trans, column: 'unit', query: { status: status } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.status'|trans, column: 'status', query: { status: status } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'products.field.updated'|trans, column: 'updatedAt', query: { status: status } } %}
                    <th class="table__actions-head" x-show="showActions" x-cloak></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td><code>{{ item.sku() }}</code></td>
                        <td><a href="{{ url('admin.products.show', {id: item.id()}) }}">{{ item.name() }}</a></td>
                        <td>{{ item.unit() }}</td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : (item.status() == 'draft' ? 'warn' : 'muted') }}">
                                {{ item.statusLabel()|trans }}
                            </span>
                        </td>
                        <td class="is-mute">{{ item.updatedAt().format('d. m. Y') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                <a href="{{ url('admin.products.show', {id: item.id()}) }}">{{ 'common.detail'|trans }}</a>
                                {% if user.can('products.manage') %}
                                    <a href="{{ url('admin.products.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                                    <form method="post" action="{{ url('admin.products.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'products.confirm_delete'|trans|e('js') }}');">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'products.empty'|trans }}</h2>
                                <p>{{ 'products.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
