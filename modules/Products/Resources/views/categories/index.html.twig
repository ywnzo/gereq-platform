{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="products-categories" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'products.categories.title'|trans }}</h1>
        {% if user.can('products.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.products.categories.create') }}">{{ icon('plus') }} {{ 'products.categories.add'|trans }}</a>
        {% endif %}
    </header>

    <div class="toolbar--table">
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'products.categories.field.name'|trans }}</th>
                    <th>{{ 'products.categories.field.slug'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.name() }}</td>
                        <td><code>{{ item.slug() }}</code></td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('products.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.products.categories.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.products.categories.destroy', {id: item.id()}), confirm: 'products.categories.confirm_delete'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">
                            <div class="empty">
                                <h2>{{ 'products.categories.empty'|trans }}</h2>
                                <p>{{ 'products.categories.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
