{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set hasProductsFilter = has_products|default('') %}
{% set advancedFilters = hasProductsFilter is not empty %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="products-categories"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'products.categories.bulk.confirm_delete'|trans|e('html_attr') }}"
>
    <header class="page-header">
        <div>
            <h1>{{ 'products.categories.title'|trans }}</h1>
            <p class="muted">{{ 'products.categories.list.hint'|trans }}</p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.products.index') }}">{{ 'products.title'|trans }}</a>
            {% if user.can('products.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.products.categories.create') }}">{{ icon('plus') }} {{ 'products.categories.add'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get" id="categories-filter-form">
            <input type="hidden" name="has_products" value="{{ hasProductsFilter }}">
            <input class="input" type="search" name="q" value="{{ search|default('') }}" placeholder="{{ 'products.categories.search'|trans }}">
        </form>
        <div class="toolbar__toggles">
            {{ ui_render('drawer_trigger', {
                drawer_id: 'categories-filters',
                label: 'ui.drawer.filters'|trans,
                variant: advancedFilters ? 'primary' : 'ghost',
                icon: 'filters'
            }) }}
        </div>
    </div>

    {% if user.can('products.manage') and items is not empty %}
        <form
            class="bulk-bar"
            method="post"
            action="{{ url('admin.products.categories.bulk') }}"
            x-show="selectedCount > 0"
            x-cloak
            @submit="confirmBulk"
        >
            {{ csrf_field()|raw }}
            <input type="hidden" name="confirmed" value="1">
            <template x-for="id in selected" :key="id">
                <input type="hidden" name="ids[]" :value="id">
            </template>
            <div class="bulk-bar__meta">
                <strong x-text="selectedCount"></strong>
                <span>{{ 'products.bulk.selected'|trans }}</span>
                <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'products.bulk.clear'|trans }}</button>
            </div>
            <div class="bulk-bar__actions">
                <select class="input" name="action" x-model="bulkAction" required>
                    <option value="">{{ 'products.bulk.choose'|trans }}</option>
                    <option value="delete">{{ 'products.categories.bulk.action.delete'|trans }}</option>
                </select>
                <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'products.bulk.apply'|trans }}</button>
            </div>
        </form>
    {% endif %}

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% if user.can('products.manage') %}
                        <th class="table__check">
                            <label class="table-check">
                                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected">
                                <span class="sr-only">{{ 'products.bulk.select_all'|trans }}</span>
                            </label>
                        </th>
                    {% endif %}
                    <th>{{ 'products.categories.field.name'|trans }}</th>
                    <th class="is-num">{{ 'products.categories.field.products'|trans }}</th>
                    <th class="is-num">{{ 'products.categories.field.options'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    {% set productCount = productCounts[item.id()]|default(0) %}
                    {% set optionCount = optionCounts[item.id()]|default(0) %}
                    <tr :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
                        {% if user.can('products.manage') %}
                            <td class="table__check">
                                <label class="table-check">
                                    <input
                                        type="checkbox"
                                        value="{{ item.id() }}"
                                        @change="toggleId('{{ item.id() }}')"
                                        :checked="isSelected('{{ item.id() }}')"
                                    >
                                    <span class="sr-only">{{ item.name() }}</span>
                                </label>
                            </td>
                        {% endif %}
                        <td>
                            <div class="table__title">
                                <a href="{{ url('admin.products.categories.edit', {id: item.id()}) }}"><strong>{{ item.name() }}</strong></a>
                                <span class="table__meta"><code>{{ item.slug() }}</code></span>
                            </div>
                        </td>
                        <td class="is-num">{{ productCount }}</td>
                        <td class="is-num">{{ optionCount }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('products.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.products.categories.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.products.categories.destroy', {id: item.id()}), confirm: 'products.categories.confirm_delete'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ user.can('products.manage') ? 5 : 4 }}">
                            <div class="empty">
                                <h2>{{ 'products.categories.empty'|trans }}</h2>
                                <p>{{ 'products.categories.empty.hint'|trans }}</p>
                                {% if user.can('products.manage') %}
                                    <a class="btn btn--primary" href="{{ url('admin.products.categories.create') }}">{{ icon('plus') }} {{ 'products.categories.add'|trans }}</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% embed 'ui/drawer.html.twig' with { id: 'categories-filters', title: 'ui.drawer.filters'|trans } %}
    {% block body %}
        <form method="get" class="g-drawer__form stack" id="categories-drawer-filters">
            <input type="hidden" name="q" value="{{ search|default('') }}">
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'products.categories.filter.products'|trans }}</span>
                <select class="input" name="has_products">
                    <option value="">{{ 'products.categories.filter.products_any'|trans }}</option>
                    <option value="1" {{ hasProductsFilter == '1' ? 'selected' : '' }}>{{ 'products.categories.filter.products_yes'|trans }}</option>
                    <option value="0" {{ hasProductsFilter == '0' ? 'selected' : '' }}>{{ 'products.categories.filter.products_no'|trans }}</option>
                </select>
            </label>
        </form>
    {% endblock %}
    {% block footer %}
        <a class="btn btn--ghost" href="?q={{ search|default('')|url_encode }}">{{ 'ui.drawer.reset'|trans }}</a>
        <button class="btn btn--primary" type="submit" form="categories-drawer-filters">{{ 'ui.drawer.apply'|trans }}</button>
    {% endblock %}
{% endembed %}
{% endblock %}
