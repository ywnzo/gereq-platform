{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'products.categories.title'|trans }}</h1>
        {% if user.can('products.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.products.categories.create') }}">{{ icon('plus') }} {{ 'products.categories.add'|trans }}</a>
        {% endif %}
    </header>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'products.categories.field.name'|trans }}</th>
                    <th>{{ 'products.categories.field.slug'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.name() }}</td>
                        <td><code>{{ item.slug() }}</code></td>
                        <td class="table__actions" x-data="rowMenu" @click.outside="close">
                            <button type="button" class="icon-btn" x-ref="button" @click="toggle" aria-haspopup="menu" :aria-expanded="open">{{ icon('dots') }}</button>
                            <div class="flyout flyout--right" x-ref="menu" :class="menuClass" :style="menuStyle" role="menu">
                                {% if user.can('products.manage') %}
                                    <a href="{{ url('admin.products.categories.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                                    <form method="post" action="{{ url('admin.products.categories.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'products.categories.confirm_delete'|trans|e('js') }}');">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">
                            <div class="empty">
                                <h2>{{ 'products.categories.empty'|trans }}</h2>
                                <p>{{ 'products.categories.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
