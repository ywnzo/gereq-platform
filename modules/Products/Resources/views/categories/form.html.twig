{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <div>
            <p class="eyebrow"><a href="{{ url('admin.products.categories.index') }}">{{ 'products.categories.title'|trans }}</a></p>
            <h1>{{ item ? item.name() : ('products.categories.new'|trans) }}</h1>
        </div>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'products.category.save' } %}

    {% if not item %}
        <form method="post" class="form-grid" action="{{ url('admin.products.categories.store') }}" data-form="products.category.save" x-data="gereqForm"{% if form_errors('products.category.save') %} data-server-state="1"{% endif %}>
            {{ csrf_field()|raw }}
            {% include 'ui/input.html.twig' with {
                name: 'name',
                label: 'products.categories.field.name'|trans,
                required: true,
                form: 'products.category.save',
                value: ''
            } %}
            {% include 'ui/input.html.twig' with {
                name: 'slug',
                label: 'products.categories.field.slug'|trans,
                optional: true,
                form: 'products.category.save',
                value: '',
                hint: 'products.categories.field.slug.hint'|trans
            } %}
            <div class="form-actions">
                <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
                <a class="btn btn--ghost" href="{{ url('admin.products.categories.index') }}">{{ 'common.cancel'|trans }}</a>
            </div>
        </form>
    {% else %}
        <div class="detail-hub" x-data="gereqTabs" data-initial="general">
            <div class="design-tabs detail-tabs" role="tablist">
                <button type="button" class="design-tab" role="tab" data-tab="general">{{ 'common.overview'|trans }}</button>
                <button type="button" class="design-tab" role="tab" data-tab="variants">Varianty{% if optionGroups|default([]) %}<span class="module-tab-count">{{ optionGroups|length }}</span>{% endif %}</button>
                {% if hasProductDiscounts is defined and hasProductDiscounts %}
                    <button type="button" class="design-tab" role="tab" data-tab="discounts">{{ 'product_discounts.tab'|trans }}{% if categoryDiscounts|default([]) %}<span class="module-tab-count">{{ categoryDiscounts|length }}</span>{% endif %}</button>
                {% endif %}
            </div>

            <section class="design-panel" data-panel="general" role="tabpanel">
                <form method="post" class="form-grid" action="{{ url('admin.products.categories.update', {id: item.id()}) }}" data-form="products.category.save" x-data="gereqForm"{% if form_errors('products.category.save') %} data-server-state="1"{% endif %}>
                    {{ csrf_field()|raw }}
                    {% include 'ui/input.html.twig' with {
                        name: 'name',
                        label: 'products.categories.field.name'|trans,
                        required: true,
                        form: 'products.category.save',
                        value: item.name()
                    } %}
                    {% include 'ui/input.html.twig' with {
                        name: 'slug',
                        label: 'products.categories.field.slug'|trans,
                        optional: true,
                        form: 'products.category.save',
                        value: item.slug(),
                        hint: 'products.categories.field.slug.hint'|trans
                    } %}
                    <div class="form-actions">
                        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
                        <a class="btn btn--ghost" href="{{ url('admin.products.categories.index') }}">{{ 'common.cancel'|trans }}</a>
                    </div>
                </form>
            </section>

            <section class="design-panel" data-panel="variants" role="tabpanel">
                <section class="panel">
                    <header class="panel__head">
                        <div>
                            <h2>Kolonky variant kategorie</h2>
                            <p class="muted">Produkty v této kategorii můžou kolonky zdědit (zapne se u produktu). Produkt může mít i vlastní kolonky navíc.</p>
                        </div>
                    </header>

                    {% set optionGroups = optionGroups|default([]) %}
                    {% if optionGroups is empty %}
                        <div class="empty"><p>Zatím žádné kolonky. Přidejte např. „Velikost“ nebo „Barva“.</p></div>
                    {% else %}
                        <div class="variant-groups">
                            {% for row in optionGroups %}
                                {% set group = row.group %}
                                <article class="variant-group">
                                    <header class="variant-group__head">
                                        <strong>{{ loop.index }}. kolonka</strong>
                                        <span class="badge">{{ group.code() }}</span>
                                        {% if user.can('products.manage') %}
                                            <form method="post" action="{{ url('admin.products.categories.option_groups.destroy', {id: item.id(), groupId: group.id()}) }}" data-confirm="Smazat kolonku?" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                                {{ csrf_field()|raw }}
                                                <button type="submit" class="btn btn--ghost btn-sm">Odebrat</button>
                                            </form>
                                        {% endif %}
                                    </header>
                                    {% if user.can('products.manage') %}
                                        <form method="post" class="variant-group-form" action="{{ url('admin.products.categories.option_groups.update', {id: item.id(), groupId: group.id()}) }}">
                                            {{ csrf_field()|raw }}
                                            <div class="variant-group-form__top">
                                                {% include 'ui/input.html.twig' with { name: 'name', label: 'Label kolonky', required: true, form: 'products.option_group.save', value: group.name() } %}
                                                <label class="check">
                                                    <input type="hidden" name="required" value="0">
                                                    <input type="checkbox" name="required" value="1" {{ group.isRequired() ? 'checked' : '' }}>
                                                    <span>Povinný výběr</span>
                                                </label>
                                            </div>
                                            <label class="field">
                                                <span class="g-label">Možnosti <span class="g-optional">(1 na řádek)</span></span>
                                                <textarea class="input variant-options-textarea" name="options_text" rows="8" placeholder="Dub&#10;Dub|+500&#10;XL|-10%">{{ row.options_text }}</textarea>
                                                <span class="g-hint">Úprava ceny: <code>Název|+500</code> (Kč) nebo <code>Název|-10%</code>. Bez přípony = beze změny ceny.</span>
                                            </label>
                                            <div class="form-actions">
                                                <button class="btn btn--primary" type="submit">Uložit kolonku</button>
                                            </div>
                                        </form>
                                    {% endif %}
                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if user.can('products.manage') %}
                        <div class="variant-group variant-group--new">
                            <header class="variant-group__head"><strong>Nová kolonka</strong></header>
                            <form method="post" class="variant-group-form" action="{{ url('admin.products.categories.option_groups.store', {id: item.id()}) }}">
                                {{ csrf_field()|raw }}
                                <div class="variant-group-form__top">
                                    {% include 'ui/input.html.twig' with { name: 'name', label: 'Label kolonky', required: true, form: 'products.option_group.save', value: '', placeholder: 'Např. Velikost' } %}
                                    <label class="check">
                                        <input type="hidden" name="required" value="0">
                                        <input type="checkbox" name="required" value="1" checked>
                                        <span>Povinný výběr</span>
                                    </label>
                                </div>
                                <label class="field">
                                    <span class="g-label">Možnosti <span class="g-optional">(1 na řádek)</span></span>
                                    <textarea class="input variant-options-textarea" name="options_text" rows="8" placeholder="S&#10;M|+100&#10;L|+200"></textarea>
                                    <span class="g-hint">Úprava ceny: <code>Název|+500</code> nebo <code>Název|-10%</code>.</span>
                                </label>
                                <div class="form-actions">
                                    <button class="btn btn--primary" type="submit">Přidat kolonku</button>
                                </div>
                            </form>
                        </div>
                    {% endif %}
                </section>
            </section>

            {% if hasProductDiscounts is defined and hasProductDiscounts %}
                <section class="design-panel" data-panel="discounts" role="tabpanel">
                    {% include '@productdiscounts/_panel.html.twig' with {
                        discounts: categoryDiscounts|default([]),
                        discountConditions: discountConditions|default(['none']),
                        formAction: url('admin.products.categories.discounts.store', {categoryId: item.id()}),
                        panelTitle: 'product_discounts.category.title'|trans,
                        panelHint: 'product_discounts.category.hint'|trans
                    } %}
                </section>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
