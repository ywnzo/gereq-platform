{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <h1>{{ item ? 'newsletter.campaigns.edit'|trans : 'newsletter.campaigns.new'|trans }}</h1>
    {% if item %}
    <div class="actions">
        {% if user.can('newsletter.manage') and item.status() == 'draft' %}
            <form method="post" action="{{ url('admin.newsletter.campaigns.send', {id: item.id()}) }}">
                {{ csrf_field()|raw }}
                <button class="btn btn--primary" type="submit">{{ 'newsletter.campaigns.mark_sent'|trans }}</button>
            </form>
        {% endif %}
    </div>
    {% endif %}
</header>

{% include 'ui/error-summary.html.twig' with { form: 'newsletter.campaign.save' } %}

<form method="post" class="detail-stack" action="{{ item ? url('admin.newsletter.campaigns.update', {id: item.id()}) : url('admin.newsletter.campaigns.store') }}" data-form="newsletter.campaign.save" x-data="gereqForm"{% if form_errors('newsletter.campaign.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}
    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'common.details'|trans }}</h2>
        </header>
        {{ forms().render(item ?? 'Modules\\Newsletter\\Domain\\Campaign', {
            form: 'newsletter.campaign.save',
            cols: 1
        }) }}
        {% if item %}
        <div class="meta-list">
            <div><span>{{ 'newsletter.field.status'|trans }}</span><strong>{{ item.statusLabel()|trans }}</strong></div>
            <div><span>{{ 'newsletter.field.sent_at'|trans }}</span><strong>{{ item.sentAt() ? item.sentAt().format('d. m. Y H:i') : '—' }}</strong></div>
        </div>
        {% endif %}
    </section>
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.newsletter.campaigns.index') }}">{{ 'common.cancel'|trans }}</a>
        {% if item and user.can('newsletter.manage') %}
        <form method="post" action="{{ url('admin.newsletter.campaigns.destroy', {id: item.id()}) }}" data-confirm="{{ 'newsletter.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1" style="display:inline">
            {{ csrf_field()|raw }}
            <button class="btn btn--ghost" type="submit">{{ 'common.delete'|trans }}</button>
        </form>
        {% endif %}
    </div>
</form>
{% endblock %}
