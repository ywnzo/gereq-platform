{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <h1>{{ 'newsletter.campaigns.title'|trans }}</h1>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.newsletter.subscribers.index') }}">{{ 'newsletter.subscribers.title'|trans }}</a>
        {% if user.can('newsletter.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.newsletter.campaigns.create') }}">{{ icon('plus') }} {{ 'newsletter.campaigns.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<form class="toolbar" method="get">
    <input type="hidden" name="sort" value="{{ sort }}">
    <input type="hidden" name="dir" value="{{ dir }}">
    <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'newsletter.campaigns.search'|trans }}">
    <select name="status" class="input" onchange="this.form.submit()">
        <option value="">{{ 'newsletter.all_statuses'|trans }}</option>
        {% for s in statuses %}
            <option value="{{ s }}" {{ status == s ? 'selected' : '' }}>{{ ('newsletter.campaign.status.' ~ s)|trans }}</option>
        {% endfor %}
    </select>
</form>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
{% include 'ui/sort_th.html.twig' with { label: 'newsletter.field.subject'|trans, column: 'subject', query: { status: status } } %}
{% include 'ui/sort_th.html.twig' with { label: 'newsletter.field.status'|trans, column: 'status', query: { status: status } } %}
{% include 'ui/sort_th.html.twig' with { label: 'newsletter.field.sent_at'|trans, column: 'sentAt', query: { status: status } } %}
{% include 'ui/sort_th.html.twig' with { label: 'newsletter.field.created'|trans, column: 'createdAt', query: { status: status } } %}
<th></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><a href="{{ url('admin.newsletter.campaigns.edit', {id: item.id()}) }}"><strong>{{ item.subject() }}</strong></a></td>
    <td><span class="badge">{{ item.statusLabel()|trans }}</span></td>
    <td class="is-mute">{{ item.sentAt() ? item.sentAt().format('d. m. Y H:i') : '—' }}</td>
    <td class="is-mute">{{ item.createdAt().format('d. m. Y') }}</td>
    <td class="table__actions">
        <a href="{{ url('admin.newsletter.campaigns.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
    </td>
</tr>
{% else %}
<tr><td colspan="5"><div class="empty"><h2>{{ 'newsletter.campaigns.empty'|trans }}</h2></div></td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% include 'ui/table_footer.html.twig' %}
{% endblock %}
