{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="bundles" data-actions-default="1">
<header class="page-header">
    <h1>{{ 'bundles.title'|trans }}</h1>
    <div class="actions">
        {% if user.can('bundles.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.bundles.create') }}">{{ icon('plus') }} {{ 'bundles.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'bundles.search'|trans }}">
    </form>
    <div class="toolbar__toggles">
        {% include 'ui/table_actions_toggle.html.twig' %}
    </div>
</div>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
<th>{{ 'bundles.field.code'|trans }}</th>
<th>{{ 'bundles.field.name'|trans }}</th>
<th>{{ 'bundles.field.discount_type'|trans }}</th>
<th>{{ 'bundles.field.discount_value'|trans }}</th>
<th>{{ 'bundles.field.active'|trans }}</th>
<th class="table__actions-head" x-show="showActions" x-cloak></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><strong>{{ item.code() }}</strong></td>
    <td>{{ item.name() }}</td>
    <td>{{ ('bundles.discount.' ~ item.discountType())|trans }}</td>
    <td>
        {% if item.discountType() == 'percent' %}
            {{ item.discountValue() }} %
        {% elseif item.discountType() == 'fixed' %}
            {{ item.discountValue() }}{{ item.currency() ? ' ' ~ item.currency() : '' }}
        {% else %}
            —
        {% endif %}
    </td>
    <td>
        <span class="badge badge--{{ item.isActive() ? 'ok' : 'muted' }}">
            {{ item.isActive() ? 'bundles.active'|trans : 'bundles.inactive'|trans }}
        </span>
    </td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% if user.can('bundles.manage') %}
                <a href="{{ url('admin.bundles.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.bundles.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'bundles.confirm_delete'|trans|e('js') }}');">
                    {{ csrf_field()|raw }}
                    <button type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr>
<td colspan="6">
<div class="empty">
<h2>{{ 'bundles.empty'|trans }}</h2>
<p>{{ 'bundles.empty.hint'|trans }}</p>
</div>
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
