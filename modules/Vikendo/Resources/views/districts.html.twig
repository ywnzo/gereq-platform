{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.vikendo'|trans, url: url('admin.vikendo.import') },
        { label: 'vikendo.nav.districts'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'vikendo.nav.districts'|trans }}</h1>
        <p class="muted">{{ 'vikendo.admin.districts_hint'|trans }}</p>
    </div>
    <div class="actions">
        <button class="btn btn--primary" type="submit" form="vikendo-districts-form">{{ 'common.save'|trans }}</button>
    </div>
</header>

{% include '@vikendo/partials/_hub_tabs.html.twig' with { active: vikendoTab } %}

{% if catalogError %}
    <p class="badge badge--danger">{{ catalogError }}</p>
{% endif %}

<form id="vikendo-districts-form" method="post" class="detail-stack" action="{{ url('admin.vikendo.districts.save') }}">
    {{ csrf_field()|raw }}

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'vikendo.admin.districts'|trans }}</h2>
            <p class="muted">{{ 'vikendo.admin.districts_count'|trans({ '%count%': selectedCount }) }}</p>
        </header>

        <div class="field-grid field-grid--2" style="margin-bottom:1rem">
            <label class="field">
                <span class="field__label">{{ 'vikendo.admin.filter_region'|trans }}</span>
                <select class="input" id="vikendo-region-filter">
                    <option value="">{{ 'vikendo.admin.filter_region_all'|trans }}</option>
                    {% for region in regions %}
                        <option value="{{ region.eid }}"{% if region.eid == regionPlzenskyEid %} selected{% endif %}>{{ region.name }} ({{ region.eid }})</option>
                    {% endfor %}
                </select>
            </label>
            <div class="field" style="display:flex;align-items:flex-end;gap:.75rem;flex-wrap:wrap">
                <button type="button" class="btn btn--ghost" id="vikendo-select-plzensky">{{ 'vikendo.admin.select_plzensky'|trans }}</button>
                <button type="button" class="btn btn--ghost" id="vikendo-select-visible">{{ 'vikendo.admin.select_visible'|trans }}</button>
                <button type="button" class="btn btn--ghost" id="vikendo-clear-all">{{ 'vikendo.admin.clear_all'|trans }}</button>
            </div>
        </div>

        <div class="table-wrap">
            <table class="table" id="vikendo-districts-table">
                <thead>
                    <tr>
                        <th style="width:3rem"></th>
                        <th>{{ 'vikendo.catalog.col.eid'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.name'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.region'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in districtRows %}
                        <tr data-region="{{ row.region_eid }}" data-plzensky="{{ row.plzensky ? '1' : '0' }}">
                            <td>
                                <label class="table-check">
                                    <input type="checkbox" name="districts[]" value="{{ row.eid }}" data-name="{{ row.name }}" data-region-eid="{{ row.region_eid }}" {{ row.selected ? 'checked' : '' }}>
                                </label>
                            </td>
                            <td><code>{{ row.eid }}</code></td>
                            <td><strong>{{ row.name }}</strong></td>
                            <td class="is-mute">{{ row.region_name }}{% if row.region_eid %} (EID {{ row.region_eid }}){% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'vikendo.admin.manual_district'|trans }}</h2>
            <p class="muted">{{ 'vikendo.admin.manual_district_hint'|trans }}</p>
        </header>
        <div class="field-grid field-grid--3">
            <label class="field">
                <span class="field__label">{{ 'vikendo.catalog.col.eid'|trans }}</span>
                <input class="input" type="text" name="manual_eid" value="" placeholder="3405" autocomplete="off">
            </label>
            <label class="field">
                <span class="field__label">{{ 'vikendo.catalog.col.name'|trans }}</span>
                <input class="input" type="text" name="manual_name" value="" placeholder="Plzeň-město" autocomplete="off">
            </label>
            <label class="field">
                <span class="field__label">{{ 'vikendo.settings.default_region_eid'|trans }}</span>
                <input class="input" type="text" name="manual_region_eid" value="" placeholder="43" autocomplete="off">
            </label>
        </div>
        <div class="actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        </div>
    </section>
</form>

<script>
(function () {
    const filter = document.getElementById('vikendo-region-filter');
    const table = document.getElementById('vikendo-districts-table');
    if (!filter || !table) return;
    const rows = Array.from(table.querySelectorAll('tbody tr'));

    function applyFilter() {
        const eid = filter.value;
        rows.forEach(function (tr) {
            const match = !eid || tr.getAttribute('data-region') === eid;
            tr.hidden = !match;
        });
    }
    filter.addEventListener('change', applyFilter);
    applyFilter();

    document.getElementById('vikendo-select-plzensky')?.addEventListener('click', function () {
        rows.forEach(function (tr) {
            const cb = tr.querySelector('input[type=checkbox]');
            if (!cb) return;
            if (tr.getAttribute('data-plzensky') === '1') {
                cb.checked = true;
                tr.hidden = false;
            }
        });
        filter.value = {{ regionPlzenskyEid|json_encode|raw }};
        applyFilter();
    });
    document.getElementById('vikendo-select-visible')?.addEventListener('click', function () {
        rows.forEach(function (tr) {
            if (tr.hidden) return;
            const cb = tr.querySelector('input[type=checkbox]');
            if (cb) cb.checked = true;
        });
    });
    document.getElementById('vikendo-clear-all')?.addEventListener('click', function () {
        rows.forEach(function (tr) {
            const cb = tr.querySelector('input[type=checkbox]');
            if (cb) cb.checked = false;
        });
    });
})();
</script>
{% endblock %}
