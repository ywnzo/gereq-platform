{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.vikendo'|trans, url: url('admin.vikendo.import') },
        { label: 'vikendo.nav.api'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'vikendo.nav.api'|trans }}</h1>
        <p class="muted">{{ 'vikendo.admin.api_hint'|trans }}</p>
    </div>
    <div class="actions">
        <button class="btn btn--primary" type="submit" form="vikendo-api-form">{{ 'common.save'|trans }}</button>
    </div>
</header>

{% include '@vikendo/partials/_hub_tabs.html.twig' with { active: vikendoTab } %}

<form id="vikendo-api-form" method="post" class="detail-stack" action="{{ url('admin.vikendo.api.save') }}">
    {{ csrf_field()|raw }}
    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'vikendo.admin.api'|trans }}</h2>
        </header>
        <div class="field-grid field-grid--2">
            <label class="field field--full">
                <span class="field__label">{{ 'vikendo.settings.base_url'|trans }}</span>
                <input class="input" type="url" name="base_url" value="{{ baseUrl }}" autocomplete="off">
                <span class="field__hint">{{ 'vikendo.settings.base_url.help'|trans }}</span>
            </label>
            <label class="field">
                <span class="field__label">{{ 'vikendo.settings.timeout'|trans }}</span>
                <input class="input" type="number" min="3" max="120" name="timeout" value="{{ timeout }}">
            </label>
            <label class="field">
                <span class="field__label">{{ 'vikendo.settings.default_region_eid'|trans }}</span>
                <input class="input" type="text" name="default_region_eid" value="{{ defaultRegionEid }}" autocomplete="off">
            </label>
            <label class="field">
                <span class="field__label">{{ 'vikendo.settings.auth_token'|trans }}</span>
                <input class="input" type="password" name="auth_token" value="" autocomplete="new-password" placeholder="{{ hasToken ? ('settings.secret.placeholder'|trans) : '' }}">
                <span class="field__hint">{{ 'vikendo.settings.auth_token.help'|trans }}</span>
            </label>
        </div>
        <div class="actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        </div>
    </section>
</form>
{% endblock %}
