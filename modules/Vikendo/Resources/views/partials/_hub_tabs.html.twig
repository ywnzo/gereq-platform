{#
  Vikendo hub tabs.
  {% include '@vikendo/partials/_hub_tabs.html.twig' with { active: vikendoTab|default('import') } %}
#}
{% set active = active|default('import') %}
<nav class="design-tabs detail-tabs" role="tablist" aria-label="{{ 'nav.vikendo'|trans }}">
    <a class="design-tab{{ active == 'import' ? ' is-active' : '' }}" role="tab" href="{{ url('admin.vikendo.import') }}" aria-selected="{{ active == 'import' ? 'true' : 'false' }}" style="text-decoration:none">{{ 'vikendo.nav.import'|trans }}</a>
    <a class="design-tab{{ active == 'districts' ? ' is-active' : '' }}" role="tab" href="{{ url('admin.vikendo.districts') }}" aria-selected="{{ active == 'districts' ? 'true' : 'false' }}" style="text-decoration:none">{{ 'vikendo.nav.districts'|trans }}</a>
    <a class="design-tab{{ active == 'catalog' ? ' is-active' : '' }}" role="tab" href="{{ url('admin.vikendo.catalog') }}" aria-selected="{{ active == 'catalog' ? 'true' : 'false' }}" style="text-decoration:none">{{ 'vikendo.nav.catalog'|trans }}</a>
    <a class="design-tab{{ active == 'api' ? ' is-active' : '' }}" role="tab" href="{{ url('admin.vikendo.api') }}" aria-selected="{{ active == 'api' ? 'true' : 'false' }}" style="text-decoration:none">{{ 'vikendo.nav.api'|trans }}</a>
    <a class="design-tab{{ active == 'log' ? ' is-active' : '' }}" role="tab" href="{{ url('admin.vikendo.log') }}" aria-selected="{{ active == 'log' ? 'true' : 'false' }}" style="text-decoration:none">{{ 'vikendo.nav.log'|trans }}</a>
</nav>
