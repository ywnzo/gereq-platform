{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.vikendo'|trans, url: url('admin.vikendo.import') },
        { label: 'vikendo.nav.catalog'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'vikendo.nav.catalog'|trans }}</h1>
        <p class="muted">{{ 'vikendo.catalog.intro'|trans }}</p>
    </div>
</header>

{% include '@vikendo/partials/_hub_tabs.html.twig' with { active: vikendoTab } %}

{% if catalogError %}
    <p class="badge badge--danger">{{ catalogError }}</p>
{% endif %}

<section class="panel">
    <header class="panel__head">
        <h2>{{ 'vikendo.catalog.categories'|trans }}</h2>
        <p class="muted">{{ 'vikendo.catalog.categories_hint'|trans }}</p>
    </header>
    {% if catalogError %}
        <p class="muted">{{ 'vikendo.catalog.empty'|trans }}</p>
    {% elseif categories is empty %}
        <p class="muted">{{ 'vikendo.catalog.empty'|trans }}</p>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'vikendo.catalog.col.id'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.parent_id'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.depth'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.name'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.internal'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.published'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cat in categories %}
                        <tr>
                            <td><code>{{ cat.id }}</code></td>
                            <td class="is-mute">{% if cat.parent_id %}<code>{{ cat.parent_id }}</code>{% else %}—{% endif %}</td>
                            <td class="is-mute">{{ cat.depth }}</td>
                            <td style="padding-left: {{ (cat.depth * 1.1) + 0.75 }}rem"><strong>{{ cat.name }}</strong></td>
                            <td class="is-mute"><code>{{ cat.internal_name }}</code></td>
                            <td>
                                {% if cat.published %}
                                    <span class="badge badge--ok">{{ 'common.yes'|trans }}</span>
                                {% else %}
                                    <span class="badge badge--muted">{{ 'common.no'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="muted">{{ 'vikendo.catalog.categories_count'|trans({ '%count%': categories|length }) }}</p>
    {% endif %}
</section>

<section class="panel">
    <header class="panel__head">
        <h2>{{ 'vikendo.catalog.regions'|trans }}</h2>
        <p class="muted">{{ 'vikendo.catalog.regions_hint'|trans }}</p>
    </header>
    {% if regions is empty %}
        <p class="muted">{{ 'vikendo.catalog.empty'|trans }}</p>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'vikendo.catalog.col.id'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.eid'|trans }}</th>
                        <th>{{ 'vikendo.catalog.col.name'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for region in regions %}
                        <tr{% if usedRegionEids[region.eid] is defined %} class="is-active"{% endif %}>
                            <td><code>{{ region.id }}</code></td>
                            <td><code>{{ region.eid }}</code></td>
                            <td><strong>{{ region.name }}</strong></td>
                            <td>
                                {% if usedRegionEids[region.eid] is defined %}
                                    <span class="badge badge--ok">{{ 'vikendo.catalog.used'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}
