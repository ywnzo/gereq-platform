{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.vikendo'|trans, url: url('admin.vikendo.import') },
        { label: 'vikendo.nav.import'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'vikendo.admin.title'|trans }}</h1>
        <p class="muted">{{ 'vikendo.admin.intro'|trans }}</p>
    </div>
    <div class="actions">
        {% if canImport %}
            <form method="post" action="{{ url('admin.vikendo.import.run') }}" data-confirm="{{ 'vikendo.admin.import_confirm'|trans }}">
                {{ csrf_field()|raw }}
                <button class="btn btn--primary" type="submit" {% if not importEnabled %}disabled{% endif %}>
                    {{ 'vikendo.admin.import_now'|trans }}
                </button>
            </form>
        {% endif %}
        <a class="btn btn--ghost" href="{{ url('admin.vikendo.log') }}">{{ 'vikendo.nav.log'|trans }}</a>
    </div>
</header>

{% include '@vikendo/partials/_hub_tabs.html.twig' with { active: vikendoTab } %}

{% if importRunning %}
    <p class="badge badge--ok">{{ 'vikendo.log.running'|trans }} — <a href="{{ url('admin.vikendo.log') }}">{{ 'vikendo.nav.log'|trans }}</a></p>
{% endif %}

<form id="vikendo-import-form" method="post" class="detail-stack" action="{{ url('admin.vikendo.import.save') }}">
    {{ csrf_field()|raw }}

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'vikendo.admin.import'|trans }}</h2>
            <p class="muted">{{ 'vikendo.admin.import_hint'|trans }}</p>
        </header>
        <label class="field field--inline">
            <input type="hidden" name="import_enabled" value="0">
            <input type="checkbox" name="import_enabled" value="1" {{ importEnabled ? 'checked' : '' }}>
            <span>{{ 'vikendo.admin.import_enabled'|trans }}</span>
        </label>
        <div class="field-grid field-grid--2">
            <label class="field">
                <span class="field__label">{{ 'vikendo.admin.per_page'|trans }}</span>
                <input class="input" type="number" min="1" max="100" name="per_page" value="{{ perPage }}">
            </label>
            <label class="field">
                <span class="field__label">{{ 'vikendo.admin.max_pages'|trans }}</span>
                <input class="input" type="number" min="1" max="100" name="max_pages" value="{{ maxPages }}">
            </label>
            <label class="field">
                <span class="field__label">{{ 'vikendo.admin.start_from'|trans }}</span>
                <input class="input" type="text" name="start_from" value="{{ startFrom }}" placeholder="YYYY-MM-DD" autocomplete="off">
                <span class="field__hint">{{ 'vikendo.admin.start_from_hint'|trans }}</span>
            </label>
        </div>
        <p class="muted">{{ 'vikendo.admin.import_bg_hint'|trans }}</p>
        <div class="actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        </div>
    </section>
</form>

<section class="panel">
    <header class="panel__head">
        <h2>{{ 'vikendo.admin.districts_selected'|trans }}</h2>
        <p class="muted">{{ 'vikendo.admin.districts_selected_hint'|trans }}</p>
    </header>
    {% if selectedDistricts is empty %}
        <p class="muted">{{ 'vikendo.admin.districts_none'|trans }}</p>
    {% else %}
        <ul class="chip-list">
            {% for d in selectedDistricts %}
                <li><span class="badge">{{ d.name }} <code>{{ d.eid }}</code></span></li>
            {% endfor %}
        </ul>
    {% endif %}
    <p><a href="{{ url('admin.vikendo.districts') }}">{{ 'vikendo.admin.districts_edit'|trans }}</a></p>
</section>
{% endblock %}
