{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.vikendo'|trans, url: url('admin.vikendo.import') },
        { label: 'vikendo.nav.log'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'vikendo.nav.log'|trans }}</h1>
        <p class="muted">{{ 'vikendo.log.intro'|trans }}</p>
    </div>
    <div class="actions">
        {% if canImport %}
            <form method="post" action="{{ url('admin.vikendo.import.run') }}" data-confirm="{{ 'vikendo.admin.import_confirm'|trans }}">
                {{ csrf_field()|raw }}
                <button class="btn btn--primary" type="submit" {% if not importEnabled %}disabled{% endif %}>
                    {{ 'vikendo.admin.import_now'|trans }}
                </button>
            </form>
        {% endif %}
        <form method="post" action="{{ url('admin.vikendo.log.clear') }}" data-confirm="{{ 'vikendo.log.clear_confirm'|trans }}">
            {{ csrf_field()|raw }}
            <button class="btn btn--ghost" type="submit">{{ 'vikendo.log.clear'|trans }}</button>
        </form>
    </div>
</header>

{% include '@vikendo/partials/_hub_tabs.html.twig' with { active: vikendoTab } %}

<section class="panel">
    <header class="panel__head" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap">
        <div>
            <h2>{{ 'vikendo.log.stream'|trans }}</h2>
            <p class="muted">{{ 'vikendo.log.stream_hint'|trans }}</p>
        </div>
        <div style="display:flex;align-items:center;gap:.75rem">
            <span id="vikendo-log-status" class="badge {{ importRunning ? 'badge--ok' : 'badge--muted' }}">
                {{ importRunning ? ('vikendo.log.running'|trans) : ('vikendo.log.idle'|trans) }}
            </span>
            <label class="field field--inline" style="margin:0">
                <input type="checkbox" id="vikendo-log-autoscroll" checked>
                <span>{{ 'vikendo.log.autoscroll'|trans }}</span>
            </label>
        </div>
    </header>
    <pre id="vikendo-log-view" class="code-block" style="max-height:32rem;overflow:auto;white-space:pre-wrap;word-break:break-word;font-size:.85rem;line-height:1.45;margin:0;padding:1rem;background:var(--surface-2, #1118270d);border-radius:.5rem">{{ 'vikendo.log.loading'|trans }}</pre>
</section>

<script>
(function () {
    const view = document.getElementById('vikendo-log-view');
    const status = document.getElementById('vikendo-log-status');
    const autoscroll = document.getElementById('vikendo-log-autoscroll');
    if (!view) return;

    const pollUrl = {{ logPollUrl|json_encode|raw }};
    let offset = -1;
    let timer = null;
    let busy = false;

    function setStatus(running) {
        if (!status) return;
        status.textContent = running
            ? {{ 'vikendo.log.running'|trans|json_encode|raw }}
            : {{ 'vikendo.log.idle'|trans|json_encode|raw }};
        status.classList.toggle('badge--ok', !!running);
        status.classList.toggle('badge--muted', !running);
    }

    async function poll() {
        if (busy) return;
        busy = true;
        try {
            const url = pollUrl + (pollUrl.includes('?') ? '&' : '?') + 'offset=' + encodeURIComponent(String(offset));
            const res = await fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            if (typeof data.offset === 'number') offset = data.offset;
            if (Array.isArray(data.lines) && data.lines.length) {
                if (view.dataset.empty === '1' || view.textContent === {{ 'vikendo.log.loading'|trans|json_encode|raw }} || view.textContent === {{ 'vikendo.log.empty'|trans|json_encode|raw }}) {
                    view.textContent = '';
                    view.dataset.empty = '0';
                }
                if (data.truncated) {
                    view.textContent = {{ 'vikendo.log.truncated'|trans|json_encode|raw }} + '\n';
                }
                view.textContent += (view.textContent && !view.textContent.endsWith('\n') ? '\n' : '') + data.lines.join('\n') + '\n';
                if (autoscroll && autoscroll.checked) {
                    view.scrollTop = view.scrollHeight;
                }
            } else if (offset <= 0 && (!data.size || data.size === 0)) {
                view.textContent = {{ 'vikendo.log.empty'|trans|json_encode|raw }};
                view.dataset.empty = '1';
            }
            setStatus(!!data.running);
        } catch (e) {
            // tiché — další poll
        } finally {
            busy = false;
        }
    }

    poll();
    timer = setInterval(poll, 2000);
    window.addEventListener('beforeunload', function () {
        if (timer) clearInterval(timer);
    });
})();
</script>
{% endblock %}
