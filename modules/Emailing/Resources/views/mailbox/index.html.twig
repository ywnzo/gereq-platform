{% extends 'admin/layout.html.twig' %}

{% block content %}
{% import '@emailing/mailbox/_avatar.html.twig' as mailAvatar %}
{% set folderIcons = {
    inbox: 'inbox',
    sent: 'send',
    drafts: 'draft',
    trash: 'trash',
    junk: 'spam',
    other: 'folder'
} %}
<div class="ol-mail"
     x-data="emailingMailbox"
     @keydown.escape.window="onEscape()"
     data-can-compose="{{ user.can('emailing.send') ? '1' : '0' }}"
     data-default-account-id="{{ account ? account.id() : '' }}"
     data-folder-id="{{ folder ? folder.id() : '' }}"
     data-poll-url="{{ account ? (url('admin.emailing.poll') ~ '?account=' ~ account.id()|url_encode) : '' }}"
     data-action-url="{{ actionUrl|default('') }}"
     data-folders='{{ folderPayload|default([])|json_encode|e('html_attr') }}'
     data-labels='{{ labels|default([])|json_encode|e('html_attr') }}'
     data-ctx-folder-meta="{{ 'emailing.ctx.folder.meta'|trans|e('html_attr') }}"
     data-ctx-fav="{{ 'emailing.ctx.folder.favorite'|trans|e('html_attr') }}"
     data-ctx-unfav="{{ 'emailing.ctx.folder.unfavorite'|trans|e('html_attr') }}"
     data-ctx-mark-read="{{ 'emailing.ctx.message.mark_read'|trans|e('html_attr') }}"
     data-ctx-mark-unread="{{ 'emailing.ctx.message.mark_unread'|trans|e('html_attr') }}"
     data-ctx-pin="{{ 'emailing.ctx.message.pin'|trans|e('html_attr') }}"
     data-ctx-unpin="{{ 'emailing.ctx.message.unpin'|trans|e('html_attr') }}"
     data-ctx-flag="{{ 'emailing.ctx.message.flag'|trans|e('html_attr') }}"
     data-ctx-unflag="{{ 'emailing.ctx.message.unflag'|trans|e('html_attr') }}"
     data-bulk-selected="{{ 'emailing.bulk.selected'|trans|e('html_attr') }}"
     data-bulk-ids='{{ bulkIds|default([])|json_encode|e('html_attr') }}'
     data-signatures='{{ signatures|default({})|json_encode|e('html_attr') }}'
     data-filter-from="{{ fromFilter|default('')|e('html_attr') }}"
     data-filter-unread="{{ unreadOnly|default(false) ? '1' : '0' }}"
     data-filter-attachment="{{ hasAttachmentOnly|default(false) ? '1' : '0' }}"
     data-compose-fallback="{{ 'emailing.compose.title'|trans|e('html_attr') }}">
    {% if accounts is empty %}
        <div class="ol-mail__empty-state">
            <span class="ol-mail__empty-ico">{{ icon('mail') }}</span>
            <h1>{{ 'emailing.mailbox.title'|trans }}</h1>
            <p class="muted">{{ 'emailing.mailbox.no_account'|trans }}</p>
            {% if user.can('emailing.accounts.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.emailing.accounts.index') }}">{{ 'nav.emailing.accounts'|trans }}</a>
            {% endif %}
        </div>
    {% else %}
        <div class="ol-mail__chrome">
            <div class="ol-mail__top">
                <form method="get" class="ol-mail__account-form" action="{{ url('admin.emailing.mailbox') }}">
                    <label class="sr-only" for="ol-mail-account">{{ 'emailing.mailbox.title'|trans }}</label>
                    <select
                        id="ol-mail-account"
                        class="input ol-mail__account"
                        name="account"
                        @change="switchAccount($event)"
                    >
                        {% for a in accounts %}
                            <option value="{{ a.id() }}" {{ account and account.id() == a.id() ? 'selected' : '' }}>{{ a.name() }} · {{ a.email() }}</option>
                        {% endfor %}
                    </select>
                </form>
                <form method="get" class="ol-mail__search" action="{{ url('admin.emailing.mailbox') }}">
                    <input type="hidden" name="account" value="{{ account.id() }}">
                    {% if folder %}<input type="hidden" name="folder" value="{{ folder.id() }}">{% endif %}
                    {% for t in activeTags|default([]) %}
                        <input type="hidden" name="tag[]" value="{{ t.keyword }}">
                    {% endfor %}
                    {% if fromFilter|default('') != '' %}
                        <input type="hidden" name="from" value="{{ fromFilter }}">
                    {% endif %}
                    {% if unreadOnly|default(false) %}
                        <input type="hidden" name="unread" value="1">
                    {% endif %}
                    {% if hasAttachmentOnly|default(false) %}
                        <input type="hidden" name="has_attachment" value="1">
                    {% endif %}
                    <span class="ol-mail__search-ico" aria-hidden="true">{{ icon('search') }}</span>
                    <div class="ol-mail__search-chips">
                        {% for t in activeTags|default([]) %}
                            <a class="ol-mail__search-tag"
                               href="?{{ tagRemoveQuery[t.keyword]|default('') }}"
                               {% if t.color %}style="--label-color: {{ t.color }}"{% endif %}
                               title="{{ 'emailing.mailbox.tag_remove'|trans }}">
                                <span>{{ t.name }}</span>
                                <span aria-hidden="true">×</span>
                            </a>
                        {% endfor %}
                        {% if fromFilter|default('') != '' %}
                            <a class="ol-mail__search-tag ol-mail__search-tag--filter"
                               href="?{{ filterRemoveQuery.from|default('') }}"
                               title="{{ 'emailing.mailbox.filter_remove'|trans }}">
                                <span>{{ 'emailing.mailbox.col_from'|trans }}: {{ fromFilter }}</span>
                                <span aria-hidden="true">×</span>
                            </a>
                        {% endif %}
                        {% if unreadOnly|default(false) %}
                            <a class="ol-mail__search-tag ol-mail__search-tag--filter"
                               href="?{{ filterRemoveQuery.unread|default('') }}"
                               title="{{ 'emailing.mailbox.filter_remove'|trans }}">
                                <span>{{ 'emailing.mailbox.filter_unread'|trans }}</span>
                                <span aria-hidden="true">×</span>
                            </a>
                        {% endif %}
                        {% if hasAttachmentOnly|default(false) %}
                            <a class="ol-mail__search-tag ol-mail__search-tag--filter"
                               href="?{{ filterRemoveQuery.has_attachment|default('') }}"
                               title="{{ 'emailing.mailbox.filter_remove'|trans }}">
                                <span>{{ 'emailing.mailbox.filter_attachments'|trans }}</span>
                                <span aria-hidden="true">×</span>
                            </a>
                        {% endif %}
                    </div>
                    <input class="ol-mail__search-input" type="search" name="q" value="{{ q }}" placeholder="{{ 'emailing.mailbox.search'|trans }}" autocomplete="off">
                    {% if labels|default([]) is not empty %}
                        <div class="ol-mail__search-tools">
                            <label class="sr-only" for="ol-mail-tag-add">{{ 'emailing.mailbox.tag_filter'|trans }}</label>
                            <select
                                id="ol-mail-tag-add"
                                class="ol-mail__search-tag-add"
                                @change="addSearchTag($event)"
                            >
                                <option value="">{{ 'emailing.mailbox.tag_add'|trans }}</option>
                                {% for lab in labels %}
                                    {% if lab.keyword not in (activeTagKeywords|default([])) %}
                                        <option value="{{ lab.keyword }}">{{ lab.name }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                </form>
                <div class="ol-mail__actions">
                    <button
                        type="button"
                        class="btn btn--ghost btn-sm"
                        :class="filterBtnClass()"
                        @click="openFilterDialog()"
                        title="{{ 'emailing.mailbox.filter_add'|trans }}"
                        aria-haspopup="dialog"
                        :aria-expanded="filterDialogOpen ? 'true' : 'false'"
                    >{{ icon('filter') }} {{ 'emailing.mailbox.filter_add'|trans }}</button>
                    <div class="ol-mail__layout" @click.outside="closeLayoutMenu()">
                        <button
                            type="button"
                            class="btn btn--ghost btn-sm"
                            @click="toggleLayoutMenu()"
                            title="{{ 'emailing.mailbox.layout'|trans }}"
                            aria-haspopup="menu"
                            :aria-expanded="layoutMenuExpanded()"
                        >{{ icon('layout') }}</button>
                        <div class="ol-mail__layout-menu" x-show="layoutMenuOpen" x-cloak role="menu">
                            <button type="button" class="ol-mail__layout-opt" :class="layoutBtnClass('right')" @click="setLayout('right')" role="menuitem">
                                {{ icon('layout-right') }}
                                <span>{{ 'emailing.mailbox.layout_right'|trans }}</span>
                            </button>
                            <button type="button" class="ol-mail__layout-opt" :class="layoutBtnClass('bottom')" @click="setLayout('bottom')" role="menuitem">
                                {{ icon('layout-bottom') }}
                                <span>{{ 'emailing.mailbox.layout_bottom'|trans }}</span>
                            </button>
                            <button type="button" class="ol-mail__layout-opt" :class="layoutBtnClass('off')" @click="setLayout('off')" role="menuitem">
                                {{ icon('layout-off') }}
                                <span>{{ 'emailing.mailbox.layout_off'|trans }}</span>
                            </button>
                        </div>
                    </div>
                    <form method="post" action="{{ url('admin.emailing.sync') }}">
                        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                        <input type="hidden" name="account_id" value="{{ account.id() }}">
                        <button class="btn btn--ghost btn-sm" type="submit" title="{{ 'emailing.mailbox.sync'|trans }}" aria-label="{{ 'emailing.mailbox.sync'|trans }}">{{ icon('refresh') }}</button>
                    </form>
                    {% if user.can('emailing.send') %}
                        <button class="btn btn--primary btn-sm" type="button" @click="openCompose()">{{ icon('plus') }} {{ 'emailing.compose.title'|trans }}</button>
                    {% endif %}
                    {% if user.can('emailing.accounts.manage') %}
                        <a class="btn btn--ghost btn-sm" href="{{ url('admin.emailing.accounts.index') }}">{{ icon('settings') }}</a>
                    {% endif %}
                </div>
            </div>

            <div class="ol-mail__grid" :class="gridClass()" :style="gridStyle()">
                <aside class="ol-mail__nav">
                    <nav class="ol-mail__folders" aria-label="Folders">
                        {% for f in folders %}
                            <a class="ol-mail__folder {{ folder and folder.id() == f.id() ? 'is-active' : '' }} {{ f.unreadCount() > 0 ? 'has-unread' : '' }}"
                               href="?{{ listQs }}&folder={{ f.id() }}"
                               data-folder-id="{{ f.id() }}"
                               data-unread="{{ f.unreadCount() }}"
                               data-total="{{ f.totalCount() }}"
                               data-system="{{ f.isSystemRole() ? '1' : '0' }}"
                               data-favorite="{{ f.isFavorite() ? '1' : '0' }}"
                               data-name="{{ f.name()|e('html_attr') }}"
                               @contextmenu.prevent="openFolderCtx($event)"
                               {% if f.color() %}style="--folder-color: {{ f.color() }}"{% endif %}>
                                <span class="ol-mail__folder-ico"{% if f.color() %} style="color:{{ f.color() }}"{% endif %}>{{ icon(folderIcons[f.role()]|default('folder')) }}</span>
                                <span class="ol-mail__folder-name">{{ f.name() }}{% if f.isFavorite() %} ★{% endif %}</span>
                                {% if f.unreadCount() > 0 %}
                                    <span class="ol-mail__badge" data-folder-badge="unread">{{ f.unreadCount() }}</span>
                                {% elseif f.totalCount() > 0 %}
                                    <span class="ol-mail__count" data-folder-badge="total">{{ f.totalCount() }}</span>
                                {% endif %}
                            </a>
                        {% else %}
                            {% if mailboxSyncError|default(null) %}
                                <p class="muted ol-mail__hint ol-mail__hint--error">{{ 'emailing.mailbox.sync_failed'|trans({'%error%': mailboxSyncError}) }}</p>
                            {% else %}
                                <p class="muted ol-mail__hint">{{ 'emailing.mailbox.sync_needed'|trans }}</p>
                            {% endif %}
                        {% endfor %}
                    </nav>
                </aside>

                <section class="ol-mail__list" aria-label="Messages">
                    <header class="ol-mail__list-cols" aria-hidden="true">
                        <label class="ol-mail__check ol-mail__check--head" title="{{ 'emailing.bulk.select_all'|trans }}">
                            <input type="checkbox"
                                   x-ref="bulkSelectAll"
                                   @change="bulkToggleAll"
                                   :checked="bulkAllSelected()">
                        </label>
                        <span class="ol-mail__col-from">{{ 'emailing.mailbox.col_from'|trans }}</span>
                        <span class="ol-mail__col-subject">{{ 'emailing.mailbox.col_subject'|trans }}</span>
                        <span class="ol-mail__col-folder">{{ folder ? folder.name() : '—' }}</span>
                    </header>
                    <div class="ol-mail__bulk" x-show="bulkCount() > 0" x-cloak>
                        <span class="ol-mail__bulk-count" x-text="bulkCountLabel()"></span>
                        <button type="button" class="btn btn--ghost btn-sm" @click="bulkRun('seen')">{{ icon('mail') }} {{ 'emailing.ctx.message.mark_read'|trans }}</button>
                        <button type="button" class="btn btn--ghost btn-sm" @click="bulkRun('unseen')">{{ 'emailing.ctx.message.mark_unread'|trans }}</button>
                        <button type="button" class="btn btn--ghost btn-sm" @click="bulkRun('archive')">{{ icon('archive') }} {{ 'emailing.ctx.message.archive'|trans }}</button>
                        <div class="ol-mail__bulk-move">
                            <button type="button" class="btn btn--ghost btn-sm" @click="toggleBulkMove()">{{ icon('folder') }} {{ 'emailing.ctx.message.move'|trans }}</button>
                            <div class="ol-mail__bulk-menu" x-show="bulkMoveOpen" x-cloak @click.outside="closeBulkMove()">
                                <template x-for="f in ctxFolders" :key="'b'+f.id">
                                    <button type="button" class="ol-mail__bulk-menu-item" @click="bulkRun('move', f.id)" x-text="f.name"></button>
                                </template>
                            </div>
                        </div>
                        <button type="button" class="btn btn--ghost btn-sm" @click="bulkRun('delete')">{{ icon('trash') }} {{ 'emailing.ctx.message.delete'|trans }}</button>
                        <button type="button" class="btn btn--ghost btn-sm" @click="bulkClear()">{{ 'emailing.bulk.clear'|trans }}</button>
                    </div>
                    {% if rowGroups is defined and rowGroups|length > 0 %}
                        {% for group in rowGroups %}
                            <section class="ol-mail__date-group" data-group="{{ group.key }}">
                                <button
                                    type="button"
                                    class="ol-mail__date-head"
                                    @click="toggleDateGroup('{{ group.key|e('js') }}')"
                                    :aria-expanded="dateGroupAriaExpanded('{{ group.key|e('js') }}')"
                                >
                                    <span
                                        class="ol-mail__date-chevron"
                                        :class="{ 'is-collapsed': isDateGroupCollapsed('{{ group.key|e('js') }}') }"
                                    >{{ icon('chevron-down') }}</span>
                                    <strong>{{ group.label }}</strong>
                                </button>
                                <div class="ol-mail__date-body" x-show="isDateGroupExpanded('{{ group.key|e('js') }}')">
                                    {% for row in group.rows %}
                                        <div class="ol-mail__thread {{ message and (message.id() == row.id or (selected and selected.thread_id == row.thread_id)) ? 'is-active' : '' }} {{ row.thread_unread > 0 ? 'has-unread' : '' }}">
                                            <div class="ol-mail__row-wrap">
                                                <label class="ol-mail__check" @click.stop>
                                                    <input type="checkbox"
                                                           value="{{ row.id }}"
                                                           :checked="isBulkSelected($el.value)"
                                                           @change="toggleBulkFromEvent($event)">
                                                </label>
                                                {% if row.thread_count > 1 %}
                                                    <button
                                                        type="button"
                                                        class="ol-mail__thread-toggle"
                                                        @click="toggleThread('{{ row.thread_id|e('js') }}')"
                                                        :aria-expanded="threadAriaExpanded('{{ row.thread_id|e('js') }}')"
                                                        title="{{ 'emailing.mailbox.thread_expand'|trans }}"
                                                    >
                                                        <span x-show="isThreadCollapsed('{{ row.thread_id|e('js') }}')">{{ icon('chevron-right') }}</span>
                                                        <span x-show="isThreadExpanded('{{ row.thread_id|e('js') }}')" x-cloak>{{ icon('chevron-down') }}</span>
                                                    </button>
                                                {% else %}
                                                    <span class="ol-mail__thread-spacer"></span>
                                                {% endif %}
                                                <div class="ol-mail__row {{ message and message.id() == row.id ? 'is-active' : '' }} {{ row.unread or row.thread_unread > 0 ? 'is-unread' : '' }}"
                                                     data-msg="{{ {
                                                        id: row.id,
                                                        from_address: row.from_address,
                                                        subject: row.subject,
                                                        thread_subject: row.thread_subject,
                                                        message_id: row.message_id,
                                                        references: row.references,
                                                        unread: row.unread,
                                                        flagged: row.flagged,
                                                        pinned: row.pinned|default(false),
                                                        keywords: row.keywords|default([])
                                                     }|json_encode|e('html_attr') }}"
                                                     @contextmenu.prevent="openMessageCtx($event)">
                                                    <a class="ol-mail__row-hit" href="?{{ listQs }}&folder={{ folder.id() }}&message={{ row.id }}">
                                                        {{ mailAvatar.avatar(row) }}
                                                        <span class="ol-mail__row-main">
                                                            <span class="ol-mail__row-top">
                                                                <span class="ol-mail__headline">
                                                                    <span class="ol-mail__from">{{ row.from }}</span>
                                                                    {% if row.is_reply %}<span class="ol-mail__ico" title="{{ 'emailing.mailbox.reply'|trans }}">{{ icon('reply') }}</span>{% endif %}
                                                                    {% if row.has_attachments %}<span class="ol-mail__ico ol-mail__att">{{ icon('attach') }}</span>{% endif %}
                                                                    {% if row.pinned|default(false) %}<span class="ol-mail__ico ol-mail__pin" title="{{ 'emailing.ctx.message.pin'|trans }}">{{ icon('pin') }}</span>{% endif %}
                                                                    {% if row.flagged %}<span class="ol-mail__ico ol-mail__flag">{{ icon('star') }}</span>{% endif %}
                                                                    {% if row.keywords|default([])|length > 0 %}
                                                                        <span class="ol-mail__labels">
                                                                            {% for kw in row.keywords %}
                                                                                {% if kw != '$Pinned' %}
                                                                                    {% set lab = labels|default([])|filter(l => l.keyword == kw)|first %}
                                                                                    <span class="ol-mail__label" {% if lab and lab.color %}style="--label-color:{{ lab.color }}"{% endif %} title="{{ lab ? lab.name : kw }}">{{ lab ? lab.name : kw }}</span>
                                                                                {% endif %}
                                                                            {% endfor %}
                                                                        </span>
                                                                    {% endif %}
                                                                    {% if row.thread_count > 1 %}
                                                                        <span class="ol-mail__thread-count" title="{{ 'emailing.mailbox.thread_count'|trans({'%count%': row.thread_count}) }}">{{ row.thread_count }}</span>
                                                                    {% endif %}
                                                                    <span class="ol-mail__subject">{{ row.subject }}</span>
                                                                </span>
                                                                <time class="ol-mail__date" datetime="{{ row.date_full }}">{{ row.date }}</time>
                                                            </span>
                                                            {% if row.snippet %}
                                                                <span class="ol-mail__snippet">{{ row.snippet }}</span>
                                                            {% endif %}
                                                        </span>
                                                    </a>
                                                    {% if row.attachment_previews is defined and row.attachment_previews|length > 0 %}
                                                        <span class="ol-mail__chips">
                                                            {% for att in row.attachment_previews %}
                                                                <a class="ol-mail__chip ol-mail__chip--{{ att.kind|default('other') }}" href="{{ url('admin.emailing.attachments.download', {id: att.id}) }}" title="{{ att.filename|e('html_attr') }}">
                                                                    {% if att.is_image %}
                                                                        <img class="ol-mail__chip-thumb" src="{{ url('admin.emailing.attachments.download', {id: att.id}) }}" alt="" loading="lazy">
                                                                    {% else %}
                                                                        <span class="ol-mail__chip-ico ol-mail__chip-ico--{{ att.kind|default('other') }}" aria-hidden="true">{{ att.badge|default('FILE') }}</span>
                                                                    {% endif %}
                                                                    <span class="ol-mail__chip-name">{{ att.filename }}</span>
                                                                </a>
                                                            {% endfor %}
                                                        </span>
                                                    {% elseif row.has_attachments %}
                                                        <span class="ol-mail__chips">
                                                            <span class="ol-mail__chip ol-mail__chip--hint">{{ icon('attach') }} {{ 'emailing.mailbox.has_attachments'|trans }}</span>
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            {% if row.thread_count > 1 %}
                                                <div class="ol-mail__thread-children" x-show="isThreadExpanded('{{ row.thread_id|e('js') }}')" x-cloak>
                                                    {% for item in row.thread_items %}
                                                        <a class="ol-mail__row ol-mail__row--child {{ message and message.id() == item.id ? 'is-active' : '' }} {{ item.unread ? 'is-unread' : '' }}"
                                                           href="?{{ listQs }}&folder={{ folder.id() }}&message={{ item.id }}">
                                                            {{ mailAvatar.avatar(item, 'sm') }}
                                                            <span class="ol-mail__row-main">
                                                                <span class="ol-mail__row-top">
                                                                    <span class="ol-mail__headline">
                                                                        <span class="ol-mail__from">{{ item.from }}</span>
                                                                        <span class="ol-mail__subject">{{ item.subject }}</span>
                                                                    </span>
                                                                    <time class="ol-mail__date" datetime="{{ item.date_full }}">{{ item.date }}</time>
                                                                </span>
                                                                {% if item.snippet %}
                                                                    <span class="ol-mail__snippet">{{ item.snippet }}</span>
                                                                {% endif %}
                                                            </span>
                                                        </a>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </section>
                        {% endfor %}
                    {% else %}
                        <div class="ol-mail__list-empty">
                            <span>{{ icon('inbox') }}</span>
                            <p>{{ 'emailing.mailbox.empty'|trans }}</p>
                        </div>
                    {% endif %}
                </section>

                <div
                    class="ol-mail__splitter"
                    x-show="showSplitter()"
                    x-cloak
                    @pointerdown="startResize($event)"
                    role="separator"
                    :aria-orientation="splitterOrientation()"
                    title="{{ 'emailing.mailbox.resize'|trans }}"
                ></div>

                <article class="ol-mail__reader" aria-label="Reading pane" x-show="showReader()" x-cloak>
                    {% if selected and message %}
                        <header class="ol-mail__reader-head">
                            <h1 class="ol-mail__reader-subject">{{ selected.subject }}</h1>
                            <div class="ol-mail__reader-toolbar">
                                {% if user.can('emailing.send') %}
                                    <button
                                        class="btn btn--ghost btn-sm"
                                        type="button"
                                        @click="openComposeReply($event)"
                                        data-to="{{ selected.from_address|e('html_attr') }}"
                                        data-subject="{{ ('Re: ' ~ (selected.thread_subject|default(selected.subject)))|e('html_attr') }}"
                                        data-message-id="{{ selected.message_id|e('html_attr') }}"
                                        data-references="{{ selected.references|e('html_attr') }}"
                                    >{{ icon('reply') }} {{ 'emailing.mailbox.reply'|trans }}</button>
                                    <button
                                        class="btn btn--ghost btn-sm"
                                        type="button"
                                        @click="openComposeForward($event)"
                                        data-subject="{{ ('Fwd: ' ~ selected.subject)|e('html_attr') }}"
                                    >{{ icon('forward') }} {{ 'emailing.mailbox.forward'|trans }}</button>
                                {% endif %}
                            </div>
                            <div class="ol-mail__reader-meta">
                                {{ mailAvatar.avatar(selected, 'lg') }}
                                <div>
                                    <div class="ol-mail__reader-from">
                                        <strong>{{ selected.from }}</strong>
                                        {% if selected.from_address %}<span class="muted">&lt;{{ selected.from_address }}&gt;</span>{% endif %}
                                    </div>
                                    <div class="muted ol-mail__reader-when">{{ selected.date_full }}</div>
                                </div>
                            </div>
                            {% if attachments %}
                                <ul class="ol-mail__atts">
                                    {% for att in attachments %}
                                        <li>
                                            {% if att.is_image|default(false) %}
                                                <img class="ol-mail__atts-thumb" src="{{ att.url }}" alt="" loading="lazy">
                                            {% else %}
                                                <span class="ol-mail__chip-ico ol-mail__chip-ico--{{ att.kind|default('other') }}" aria-hidden="true">{{ att.badge|default('FILE') }}</span>
                                            {% endif %}
                                            <a href="{{ att.url }}">{{ att.filename }}</a>
                                            <em>{{ (att.size / 1024)|number_format(0, ',', ' ') }} KB</em>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </header>
                        {% if threadRows|length > 1 %}
                            <div class="ol-mail__conversation" aria-label="{{ 'emailing.mailbox.conversation'|trans }}">
                                <div class="ol-mail__conversation-label">{{ 'emailing.mailbox.conversation'|trans }}&nbsp;·&nbsp;{{ threadRows|length }}</div>
                                <ul class="ol-mail__conversation-list">
                                    {% for item in threadRows %}
                                        <li>
                                            <a class="ol-mail__conversation-item {{ message and message.id() == item.id ? 'is-active' : '' }}"
                                               href="?{{ listQs }}&folder={{ folder.id() }}&message={{ item.id }}">
                                                {{ mailAvatar.avatar(item, 'sm') }}
                                                <span class="ol-mail__conversation-main">
                                                    <strong>{{ item.from }}</strong>
                                                    <span>{{ item.subject }}</span>
                                                </span>
                                                <time>{{ item.date_full }}</time>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                        <div class="ol-mail__reader-body">
                            {% if mailBody and mailBody.textHtml() %}
                                <iframe class="ol-mail__html" sandbox="" src="{{ url('admin.emailing.messages.html', {id: message.id()}) }}" title="message"></iframe>
                            {% elseif mailBody and mailBody.textPlain() %}
                                <pre class="ol-mail__plain">{{ mailBody.textPlain() }}</pre>
                            {% else %}
                                <p class="muted">{{ 'emailing.mailbox.body_unavailable'|trans }}</p>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="ol-mail__reader-empty">
                            <span class="ol-mail__empty-ico">{{ icon('mail') }}</span>
                            <p>{{ 'emailing.mailbox.select'|trans }}</p>
                        </div>
                    {% endif %}
                </article>
            </div>
        </div>

        <div class="g-modal__backdrop" :class="filterDialogOpen ? 'is-open' : ''" @click="closeFilterDialog()"></div>
        <div
            class="g-modal"
            :class="filterDialogOpen ? 'is-open' : ''"
            role="dialog"
            aria-modal="true"
            aria-labelledby="ol-mail-filter-title"
            :aria-hidden="filterDialogOpen ? 'false' : 'true'"
        >
            <div class="g-modal__panel ol-mail__filter-dialog" @click.stop>
                <h3 class="g-modal__title" id="ol-mail-filter-title">{{ 'emailing.mailbox.filter_title'|trans }}</h3>
                <div class="ol-mail__filter-fields">
                    <label class="ol-mail__filter-opt">
                        <input type="checkbox" x-model="filterUnreadDraft">
                        <span>{{ 'emailing.mailbox.filter_unread'|trans }}</span>
                    </label>
                    <label class="ol-mail__filter-opt">
                        <input type="checkbox" x-model="filterHasAttachmentDraft">
                        <span>{{ 'emailing.mailbox.filter_attachments'|trans }}</span>
                    </label>
                    <label class="field">
                        <span>{{ 'emailing.mailbox.filter_from_label'|trans }}</span>
                        <input
                            class="input"
                            type="text"
                            x-model="filterFromDraft"
                            x-ref="filterFromInput"
                            placeholder="{{ 'emailing.mailbox.filter_from'|trans }}"
                            autocomplete="off"
                            @keydown.enter.prevent="applyFilters()"
                        >
                    </label>
                </div>
                <div class="g-modal__actions">
                    <button type="button" class="btn btn--ghost" @click="clearFilters()">{{ 'emailing.mailbox.filter_clear'|trans }}</button>
                    <button type="button" class="btn btn--ghost" @click="closeFilterDialog()">{{ 'common.cancel'|trans }}</button>
                    <button type="button" class="btn btn--primary" @click="applyFilters()">{{ 'emailing.mailbox.filter_apply'|trans }}</button>
                </div>
            </div>
        </div>

        {% include '@emailing/mailbox/_compose_dialog.html.twig' %}
        {% include '@emailing/mailbox/_context_menu.html.twig' %}
    {% endif %}
</div>
{% endblock %}
