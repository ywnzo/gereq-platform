{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="ol-mail ol-mail--compose">
    <div class="ol-mail__chrome">
        <div class="ol-mail__top">
            <div class="ol-mail__brand">
                <span class="ol-mail__brand-ico">{{ icon('edit') }}</span>
                <div>
                    <strong>{{ 'emailing.compose.title'|trans }}</strong>
                    <div class="muted" style="font-size:.78rem">{{ 'emailing.mailbox.title'|trans }}</div>
                </div>
            </div>
            <div></div>
            <div class="ol-mail__actions">
                <a class="btn btn--ghost btn-sm" href="{{ url('admin.emailing.mailbox') }}">{{ icon('chevron-left') }} {{ 'emailing.mailbox.title'|trans }}</a>
            </div>
        </div>

        {% if accounts is empty %}
            <div class="ol-mail__empty-state">
                <p class="muted">{{ 'emailing.mailbox.no_account'|trans }}</p>
            </div>
        {% else %}
            <form method="post" action="{{ url('admin.emailing.send') }}" class="ol-compose">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <label class="ol-compose__row">
                    <span>{{ 'emailing.field.from'|default('Od')|trans }}</span>
                    <select class="input" name="account_id" required>
                        {% for a in accounts %}
                            <option value="{{ a.id() }}">{{ a.name() }} &lt;{{ a.email() }}&gt;</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="ol-compose__row">
                    <span>Komu</span>
                    <input class="input" name="to" required value="{{ to }}">
                </label>
                <label class="ol-compose__row">
                    <span>Kopie</span>
                    <input class="input" name="cc" value="">
                </label>
                <label class="ol-compose__row">
                    <span>Předmět</span>
                    <input class="input" name="subject" required value="{{ subject }}">
                </label>
                <label class="ol-compose__body">
                    <textarea class="input ol-compose__textarea" name="body_text" rows="16" placeholder="…">{{ body_text|default('') }}</textarea>
                </label>
                <div class="ol-compose__footer">
                    <button class="btn btn--primary" type="submit">{{ icon('send') }} {{ 'emailing.compose.send'|trans }}</button>
                </div>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
