{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set conditions = rule ? rule.conditions() : [{field: 'from', op: 'contains', value: ''}] %}
{% set actions = rule ? rule.actions() : [{type: 'mark_read'}] %}
{% if conditions is empty %}{% set conditions = [{field: 'from', op: 'contains', value: ''}] %}{% endif %}
{% if actions is empty %}{% set actions = [{type: 'mark_read'}] %}{% endif %}
{% set emptyLabel = rule ? 'emailing.rules.edit'|trans : 'emailing.rules.new'|trans %}
{% set accountOptions = [{ value: '', label: 'emailing.rules.all_accounts'|trans }] %}
{% for a in accounts %}
    {% set accountOptions = accountOptions|merge([{ value: a.id(), label: a.name() ~ ' · ' ~ a.email() }]) %}
{% endfor %}

<div class="customer-edit emailing-edit">
    <header class="customer-edit__header">
        <div class="customer-edit__identity">
            <a class="text-link customer-profile__back" href="{{ url('admin.emailing.rules.index') }}">
                ← {{ 'nav.emailing.rules'|trans }}
            </a>
            <div class="cell-user cell-user--lg">
                <span class="avatar avatar--xl">{{ rule ? rule.name()|slice(0, 1)|upper : 'R' }}</span>
                <div>
                    <p class="customer-edit__eyebrow">{{ emptyLabel }}</p>
                    <h1>{{ rule ? rule.name() : 'emailing.rules.new'|trans }}</h1>
                    <p class="customer-profile__sub">{{ 'emailing.rules.subtitle'|trans }}</p>
                </div>
            </div>
        </div>
        <div class="customer-edit__header-actions">
            <button class="btn btn--primary" type="submit" form="emailing-rule-form">{{ 'common.save'|trans }}</button>
        </div>
    </header>

    <form
        id="emailing-rule-form"
        method="post"
        class="customer-edit__form"
        action="{{ rule ? url('admin.emailing.rules.update', {id: rule.id()}) : url('admin.emailing.rules.store') }}"
    >
        {{ csrf_field()|raw }}

        <div class="customer-edit__layout">
            <div class="customer-edit__main">
                <section class="customer-section">
                    <header class="customer-section__head">
                        <div>
                            <h2>{{ 'emailing.section.profile'|trans }}</h2>
                            <p class="muted customer-edit__section-hint">{{ 'emailing.rules.form.profile.hint'|trans }}</p>
                        </div>
                    </header>
                    <div class="customer-edit__grid">
                        {% include 'ui/input.html.twig' with {
                            name: 'name',
                            label: 'emailing.field.name'|trans,
                            required: true,
                            value: rule ? rule.name() : ''
                        } %}
                        {% include 'ui/select.html.twig' with {
                            name: 'account_id',
                            label: 'emailing.mailbox.title'|trans,
                            optional: true,
                            value: rule ? rule.accountId() : '',
                            options: accountOptions
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'priority',
                            label: 'emailing.rules.col.priority'|trans,
                            type: 'number',
                            value: rule ? rule.priority() : 100
                        } %}
                    </div>
                </section>

                <section class="customer-section">
                    <header class="customer-section__head">
                        <div>
                            <h2>{{ 'emailing.rules.col.conditions'|trans }}</h2>
                            <p class="muted customer-edit__section-hint">{{ 'emailing.rules.form.conditions.hint'|trans }}</p>
                        </div>
                    </header>
                    <div class="emailing-rule-rows">
                        {% for i, c in conditions %}
                            <div class="emailing-rule-row">
                                <select class="input" name="conditions[{{ i }}][field]">
                                    {% for key, label in conditionFields %}
                                        <option value="{{ key }}" {{ (c.field|default('')) == key ? 'selected' : '' }}>{{ label|trans }}</option>
                                    {% endfor %}
                                </select>
                                <select class="input" name="conditions[{{ i }}][op]">
                                    {% for key, label in conditionOps %}
                                        <option value="{{ key }}" {{ (c.op|default('eq')) == key ? 'selected' : '' }}>{{ label|trans }}</option>
                                    {% endfor %}
                                </select>
                                <input class="input" name="conditions[{{ i }}][value]" value="{{ c.value|default('') }}" placeholder="{{ 'emailing.rules.value'|trans }}">
                            </div>
                        {% endfor %}
                        {% set nextC = conditions|length %}
                        <div class="emailing-rule-row emailing-rule-row--add">
                            <select class="input" name="conditions[{{ nextC }}][field]">
                                <option value="">{{ 'emailing.rules.add_condition'|trans }}</option>
                                {% for key, label in conditionFields %}
                                    <option value="{{ key }}">{{ label|trans }}</option>
                                {% endfor %}
                            </select>
                            <select class="input" name="conditions[{{ nextC }}][op]">
                                {% for key, label in conditionOps %}
                                    <option value="{{ key }}">{{ label|trans }}</option>
                                {% endfor %}
                            </select>
                            <input class="input" name="conditions[{{ nextC }}][value]" value="" placeholder="{{ 'emailing.rules.value'|trans }}">
                        </div>
                    </div>
                </section>

                <section class="customer-section">
                    <header class="customer-section__head">
                        <div>
                            <h2>{{ 'emailing.rules.col.actions'|trans }}</h2>
                            <p class="muted customer-edit__section-hint">{{ 'emailing.rules.form.actions.hint'|trans }}</p>
                        </div>
                    </header>
                    <div class="emailing-rule-rows">
                        {% for i, a in actions %}
                            <div class="emailing-rule-row">
                                <select class="input" name="actions[{{ i }}][type]">
                                    {% for key, label in actionTypes %}
                                        <option value="{{ key }}" {{ (a.type|default('')) == key ? 'selected' : '' }}>{{ label|trans }}</option>
                                    {% endfor %}
                                </select>
                                <input class="input" name="actions[{{ i }}][keyword]" value="{{ a.keyword|default('') }}" placeholder="{{ 'emailing.rules.action.apply_label'|trans }}">
                                <select class="input" name="actions[{{ i }}][folder_role]">
                                    <option value="">{{ 'emailing.rules.action.move'|trans }} (role)</option>
                                    {% for role in ['inbox', 'sent', 'drafts', 'trash', 'junk', 'other'] %}
                                        <option value="{{ role }}" {{ (a.folder_role|default('')) == role ? 'selected' : '' }}>{{ role }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endfor %}
                        {% set nextA = actions|length %}
                        <div class="emailing-rule-row emailing-rule-row--add">
                            <select class="input" name="actions[{{ nextA }}][type]">
                                <option value="">{{ 'emailing.rules.add_action'|trans }}</option>
                                {% for key, label in actionTypes %}
                                    <option value="{{ key }}">{{ label|trans }}</option>
                                {% endfor %}
                            </select>
                            <input class="input" name="actions[{{ nextA }}][keyword]" value="" placeholder="{{ 'emailing.rules.action.apply_label'|trans }}">
                            <select class="input" name="actions[{{ nextA }}][folder_role]">
                                <option value="">{{ 'emailing.rules.action.move'|trans }} (role)</option>
                                {% for role in ['inbox', 'sent', 'drafts', 'trash', 'junk', 'other'] %}
                                    <option value="{{ role }}">{{ role }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="customer-edit__aside">
                <section class="customer-section">
                    <header class="customer-section__head">
                        <div>
                            <h2>{{ 'emailing.section.options'|trans }}</h2>
                            <p class="muted customer-edit__section-hint">{{ 'emailing.rules.form.options.hint'|trans }}</p>
                        </div>
                    </header>
                    {% include 'ui/switch.html.twig' with {
                        name: 'is_active',
                        label: 'emailing.field.active'|trans,
                        on: rule is null or rule.isActive()
                    } %}
                    {% include 'ui/switch.html.twig' with {
                        name: 'stop_processing',
                        label: 'emailing.rules.stop_processing'|trans,
                        on: rule and rule.stopProcessing()
                    } %}
                </section>

                {% if rule %}
                    <section class="customer-section customer-edit__meta">
                        <header class="customer-section__head">
                            <h2>{{ 'emailing.section.meta'|trans }}</h2>
                        </header>
                        <dl class="customer-edit__meta-list">
                            <div>
                                <dt>{{ 'emailing.field.created'|trans }}</dt>
                                <dd>{{ rule.createdAt().format('d. m. Y H:i') }}</dd>
                            </div>
                            <div>
                                <dt>{{ 'emailing.field.updated'|trans }}</dt>
                                <dd>{{ rule.updatedAt().format('d. m. Y H:i') }}</dd>
                            </div>
                        </dl>
                    </section>
                {% endif %}

                <div class="customer-edit__aside-actions">
                    <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
                    <a class="btn btn--ghost" href="{{ url('admin.emailing.rules.index') }}">{{ 'common.cancel'|trans }}</a>
                </div>
            </aside>
        </div>
    </form>
</div>
{% endblock %}
