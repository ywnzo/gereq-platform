{% extends 'admin/layout.html.twig' %}

{% block content %}
<header class="page-header">
    <h1>{{ item ? 'loyalty.tiers.edit'|trans : 'loyalty.tiers.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'loyalty.tier.save' } %}

<form method="post" class="detail-stack" action="{{ item ? url('admin.loyalty.tiers.update', {id: item.id()}) : url('admin.loyalty.tiers.store') }}" data-form="loyalty.tier.save" x-data="gereqForm"{% if form_errors('loyalty.tier.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}
    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'common.details'|trans }}</h2>
        </header>
        {{ forms().render(item ?? 'Modules\\Loyalty\\Domain\\LoyaltyTier', {
            form: 'loyalty.tier.save',
            cols: 1
        }) }}
    </section>
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.loyalty.tiers.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
