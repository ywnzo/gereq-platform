{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <h1>{{ 'loyalty.tiers.title'|trans }}</h1>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.loyalty.accounts.index') }}">{{ 'nav.loyalty.accounts'|trans }}</a>
        {% if user.can('loyalty.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.loyalty.tiers.create') }}">{{ icon('plus') }} {{ 'loyalty.tiers.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<form class="toolbar" method="get">
    <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'loyalty.tiers.search'|trans }}">
</form>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
<th>{{ 'loyalty.field.code'|trans }}</th>
<th>{{ 'loyalty.field.name'|trans }}</th>
<th>{{ 'loyalty.field.min_spend'|trans }}</th>
<th>{{ 'loyalty.field.discount_percent'|trans }}</th>
<th>{{ 'loyalty.field.sort_order'|trans }}</th>
<th>{{ 'loyalty.field.active'|trans }}</th>
<th></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><strong>{{ item.code() }}</strong></td>
    <td>{{ item.name() }}</td>
    <td>{{ item.minSpend() }}</td>
    <td>{{ item.discountPercent() }} %</td>
    <td>{{ item.sortOrder() }}</td>
    <td>
        <span class="badge badge--{{ item.isActive() ? 'ok' : 'muted' }}">
            {{ item.isActive() ? 'loyalty.active'|trans : 'loyalty.inactive'|trans }}
        </span>
    </td>
    <td class="table__actions" x-data="rowMenu" @click.outside="close">
        <button type="button" class="icon-btn" x-ref="button" @click="toggle" aria-haspopup="menu" :aria-expanded="open">{{ icon('dots') }}</button>
        <div class="flyout flyout--right" x-ref="menu" :class="menuClass" :style="menuStyle" role="menu">
            {% if user.can('loyalty.manage') %}
                <a href="{{ url('admin.loyalty.tiers.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.loyalty.tiers.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'loyalty.confirm_delete_tier'|trans|e('js') }}');">
                    {{ csrf_field()|raw }}
                    <button type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </td>
</tr>
{% else %}
<tr>
<td colspan="7">
<div class="empty">
<h2>{{ 'loyalty.tiers.empty'|trans }}</h2>
<p>{{ 'loyalty.tiers.empty.hint'|trans }}</p>
</div>
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
