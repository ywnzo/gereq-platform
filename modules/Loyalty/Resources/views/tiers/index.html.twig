{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="loyalty-tiers" data-actions-default="1">
<header class="page-header">
    <h1>{{ 'loyalty.tiers.title'|trans }}</h1>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.loyalty.accounts.index') }}">{{ 'nav.loyalty.accounts'|trans }}</a>
        {% if user.can('loyalty.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.loyalty.tiers.create') }}">{{ icon('plus') }} {{ 'loyalty.tiers.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'loyalty.tiers.search'|trans }}">
    </form>
</div>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
<th>{{ 'loyalty.field.code'|trans }}</th>
<th>{{ 'loyalty.field.name'|trans }}</th>
<th>{{ 'loyalty.field.min_spend'|trans }}</th>
<th>{{ 'loyalty.field.discount_percent'|trans }}</th>
<th>{{ 'loyalty.field.sort_order'|trans }}</th>
<th>{{ 'loyalty.field.active'|trans }}</th>
<th class="table__actions-head"></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><strong>{{ item.code() }}</strong></td>
    <td>{{ item.name() }}</td>
    <td>{{ item.minSpend() }}</td>
    <td>{{ item.discountPercent() }} %</td>
    <td>{{ item.sortOrder() }}</td>
    <td>
        <span class="badge badge--{{ item.isActive() ? 'ok' : 'muted' }}">
            {{ item.isActive() ? 'loyalty.active'|trans : 'loyalty.inactive'|trans }}
        </span>
    </td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% if user.can('loyalty.manage') %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.loyalty.tiers.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.loyalty.tiers.destroy', {id: item.id()}), confirm: 'loyalty.confirm_delete_tier'|trans } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr>
<td colspan="7">
<div class="empty">
<h2>{{ 'loyalty.tiers.empty'|trans }}</h2>
<p>{{ 'loyalty.tiers.empty.hint'|trans }}</p>
</div>
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
