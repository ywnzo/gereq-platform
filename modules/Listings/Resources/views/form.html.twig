{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.listings'|trans, url: url('admin.listings.index') },
        { label: 'nav.listings.properties'|trans, url: url('admin.listings.index') },
        { label: pageTitle },
    ] } %}
{% endblock %}

{% block content %}
    <header class="page-header">
        <div>
            <h1>{{ pageTitle }}</h1>
            {% if listing %}
                <p class="muted">
                    <code>{{ listing.slug() }}</code>
                    · <span class="status-chip"><span class="status-chip__dot"></span>{{ listing.statusLabel()|trans }}</span>
                </p>
            {% endif %}
        </div>
        <div class="actions">
            {% if listing %}
                <a class="btn btn--ghost" href="{{ url('admin.listings.show', {id: listing.id()}) }}">{{ 'common.detail'|trans }}</a>
            {% endif %}
            <button class="btn btn--primary" type="submit" form="listing-form">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.listings.index') }}">{{ 'common.back'|trans }}</a>
        </div>
    </header>

    <div class="detail-hub" x-data="gereqTabs" data-initial="basic">
        <div class="design-tabs detail-tabs" role="tablist">
            <button type="button" class="design-tab" role="tab" data-tab="basic">{{ 'listings.tab.basic'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="location">{{ 'listings.tab.location'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="amenities">{{ 'listings.tab.amenities'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="broker">{{ 'listings.tab.broker'|trans }}</button>
            {% if listing %}
                <button type="button" class="design-tab" role="tab" data-tab="nearby">{{ 'listings.tab.nearby'|trans }}{% if nearLinks %}<span class="module-tab-count">{{ nearLinks|length }}</span>{% endif %}</button>
                <button type="button" class="design-tab" role="tab" data-tab="images">{{ 'listings.tab.images'|trans }}{% if images %}<span class="module-tab-count">{{ images|length }}</span>{% endif %}</button>
            {% endif %}
        </div>

        <form id="listing-form" method="post" action="{{ listing ? url('admin.listings.update', {id: listing.id()}) : url('admin.listings.store') }}">
            {{ csrf_field()|raw }}

            <section class="design-panel" data-panel="basic" role="tabpanel">
                <section class="panel">
                    <header class="panel__head">
                        <h2>{{ 'listings.section.basic'|trans }}</h2>
                    </header>
                    <div class="form-grid">
                        <label class="field field--full"><span>{{ 'listings.field.title'|trans }}</span>
                            <input class="input" name="title" required value="{{ listing ? listing.title() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.slug'|trans }}</span>
                            <input class="input" name="slug" value="{{ listing ? listing.slug() : '' }}" placeholder="auto">
                        </label>
                        <label class="field"><span>{{ 'listings.field.status'|trans }}</span>
                            <select class="input" name="status">
                                {% for s in statuses %}
                                    <option value="{{ s }}" {{ listing and listing.status()==s?'selected':(s=='draft' and not listing?'selected':'') }}>{{ ('listings.status.'~s)|trans }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="field"><span>{{ 'listings.field.market_status'|trans }}</span>
                            <select class="input" name="market_status">
                                {% for s in marketStatuses %}
                                    <option value="{{ s }}" {{ listing and listing.marketStatus()==s?'selected':(s=='available' and not listing?'selected':'') }}>{{ ('listings.market.'~s)|trans }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="field"><span>{{ 'listings.field.offer'|trans }}</span>
                            <select class="input" name="offer_type">
                                {% for o in offers %}
                                    <option value="{{ o }}" {{ listing and listing.offerType()==o?'selected':'' }}>{{ ('listings.offer.'~o)|trans }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="field"><span>{{ 'listings.field.type'|trans }}</span>
                            <select class="input" name="property_type">
                                {% for t in types %}
                                    <option value="{{ t }}" {{ listing and listing.propertyType()==t?'selected':'' }}>{{ ('listings.type.'~t)|trans }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="field" style="flex-direction:row;align-items:center;gap:8px">
                            <input type="checkbox" name="featured" value="1" {{ listing and listing.featured() ? 'checked' : '' }}>
                            <span>{{ 'listings.field.featured'|trans }}</span>
                        </label>
                        <label class="field"><span>{{ 'listings.field.price'|trans }}</span>
                            <input class="input" type="number" step="0.01" name="price" value="{{ listing ? listing.price() : '0' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.currency'|trans }}</span>
                            <input class="input" name="currency" maxlength="3" value="{{ listing ? listing.currency() : 'CZK' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.area'|trans }}</span>
                            <input class="input" type="number" step="0.1" name="area_m2" value="{{ listing and listing.areaM2() is not null ? listing.areaM2() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.rooms'|trans }}</span>
                            <input class="input" type="number" name="rooms" value="{{ listing and listing.rooms() is not null ? listing.rooms() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.floor'|trans }}</span>
                            <input class="input" type="number" name="floor" value="{{ listing and listing.floor() is not null ? listing.floor() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.floors'|trans }}</span>
                            <input class="input" type="number" name="floors" value="{{ listing and listing.floors() is not null ? listing.floors() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.energy'|trans }}</span>
                            <select class="input" name="energy_rating">
                                <option value="">—</option>
                                {% for e in energy %}
                                    <option value="{{ e }}" {{ listing and listing.energyRating()==e?'selected':'' }}>{{ e }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        {% include 'ui/editor.html.twig' with {
                            name: 'description',
                            label: 'listings.field.description'|trans,
                            value: listing ? listing.description() : '',
                            extra: 'field--full'
                        } %}
                    </div>
                </section>
            </section>

            <section class="design-panel" data-panel="location" role="tabpanel">
                <section class="panel">
                    <header class="panel__head">
                        <h2>{{ 'listings.section.location'|trans }}</h2>
                    </header>
                    <div class="form-grid" x-data="gereqAresAddress">
                        <div class="field field--full ares-field">
                            <span>{{ 'listings.field.address'|trans }} · ARES / RÚIAN</span>
                            <div class="ares-field__control">
                                <input
                                    class="input"
                                    name="address"
                                    data-ares-query
                                    data-ares-fill="address"
                                    autocomplete="off"
                                    placeholder="Ulice, obec…"
                                    value="{{ listing ? listing.address() : '' }}"
                                    @input="onInput"
                                    @keydown="onKeydown"
                                    x-ref="query"
                                >
                                {% include 'ui/ares_address_suggest.html.twig' %}
                            </div>
                            <p class="ares-hint">Začněte psát adresu — po výběru se doplní ulice, město a PSČ.</p>
                        </div>
                        <label class="field"><span>{{ 'listings.field.city'|trans }}</span>
                            <input class="input" name="city" data-ares-fill="city" value="{{ listing ? listing.city() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.city_part'|trans }}</span>
                            <input class="input" name="city_part" data-ares-fill="city_part" value="{{ listing ? listing.cityPart() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.street'|trans }}</span>
                            <input class="input" name="street" data-ares-fill="street" value="{{ listing ? listing.street() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.zip'|trans }}</span>
                            <input class="input" name="zip" data-ares-fill="zip" value="{{ listing ? listing.zip() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.latitude'|trans }}</span>
                            <input class="input" type="number" step="any" name="latitude" value="{{ listing and listing.latitude() is not null ? listing.latitude() : '' }}">
                        </label>
                        <label class="field"><span>{{ 'listings.field.longitude'|trans }}</span>
                            <input class="input" type="number" step="any" name="longitude" value="{{ listing and listing.longitude() is not null ? listing.longitude() : '' }}">
                        </label>
                    </div>
                </section>
            </section>

            <section class="design-panel" data-panel="amenities" role="tabpanel">
                <section class="panel">
                    <header class="panel__head">
                        <h2>{{ 'listings.section.amenities'|trans }}</h2>
                    </header>
                    <div class="form-grid">
                        <label class="field" style="flex-direction:row;align-items:center;gap:8px">
                            <input type="checkbox" name="balcony" value="1" {{ listing and listing.balcony() ? 'checked' : '' }}>
                            <span>{{ 'listings.amenity.balcony'|trans }}</span>
                        </label>
                        <label class="field" style="flex-direction:row;align-items:center;gap:8px">
                            <input type="checkbox" name="terrace" value="1" {{ listing and listing.terrace() ? 'checked' : '' }}>
                            <span>{{ 'listings.amenity.terrace'|trans }}</span>
                        </label>
                        <label class="field" style="flex-direction:row;align-items:center;gap:8px">
                            <input type="checkbox" name="cellar" value="1" {{ listing and listing.cellar() ? 'checked' : '' }}>
                            <span>{{ 'listings.amenity.cellar'|trans }}</span>
                        </label>
                        <label class="field" style="flex-direction:row;align-items:center;gap:8px">
                            <input type="checkbox" name="garage" value="1" {{ listing and listing.garage() ? 'checked' : '' }}>
                            <span>{{ 'listings.amenity.garage'|trans }}</span>
                        </label>
                        <label class="field" style="flex-direction:row;align-items:center;gap:8px">
                            <input type="checkbox" name="elevator" value="1" {{ listing and listing.elevator() ? 'checked' : '' }}>
                            <span>{{ 'listings.amenity.elevator'|trans }}</span>
                        </label>
                        <label class="field"><span>{{ 'listings.field.parking'|trans }}</span>
                            <input class="input" type="number" name="parking_lots" value="{{ listing and listing.parkingLots() is not null ? listing.parkingLots() : '' }}">
                        </label>
                    </div>
                </section>
            </section>

            <section class="design-panel" data-panel="broker" role="tabpanel">
                <section class="panel">
                    <header class="panel__head">
                        <h2>{{ 'listings.section.broker'|trans }}</h2>
                        {% if user.can('listings.manage') %}
                            <a class="btn btn--ghost btn--sm" href="{{ url('admin.listings.brokers.index') }}">{{ 'listings.field.broker.manage'|trans }}</a>
                        {% endif %}
                    </header>
                    <div class="form-grid">
                        <label class="field field--full"><span>{{ 'listings.field.broker'|trans }}</span>
                            <select class="input" name="broker_id">
                                <option value="">{{ 'listings.field.broker.none'|trans }}</option>
                                {% for option in brokerOptions %}
                                    <option value="{{ option.value }}" {{ listing and listing.brokerId() == option.value ? 'selected' : '' }}>{{ option.label }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                </section>
            </section>
        </form>

        {% if listing %}
            <section class="design-panel" data-panel="nearby" role="tabpanel">
                <section class="panel">
                    <header class="panel__head">
                        <h2>{{ 'listings.section.nearby'|trans }}</h2>
                        {% if user.can('listings.manage') %}
                            <a class="btn btn--ghost btn--sm" href="{{ url('admin.listings.near.index') }}">{{ 'listings.near.manage'|trans }}</a>
                        {% endif %}
                    </header>

                    {% if nearLinks is empty %}
                        <div class="empty">
                            <p>{{ 'listings.near_links.empty'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="table-wrap" data-table>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>{{ 'listings.near.field.name'|trans }}</th>
                                        <th>{{ 'listings.near.field.category'|trans }}</th>
                                        <th>{{ 'listings.near_links.field.distance'|trans }}</th>
                                        <th>{{ 'listings.near_links.field.walk'|trans }}</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for link in nearLinks %}
                                        {% set place = nearPlaces[link.id()]|default(null) %}
                                        <tr>
                                            <td>
                                                {% if place %}
                                                    <strong>{{ place.name() }}</strong>
                                                    {% if place.address() %}<div class="muted">{{ place.address() }}</div>{% endif %}
                                                {% else %}
                                                    <span class="muted">{{ 'listings.near.error.not_found'|trans }}</span>
                                                {% endif %}
                                            </td>
                                            <td>{% if place %}<span class="badge badge--info">{{ ('listings.near.category.' ~ place.category())|trans }}</span>{% else %}—{% endif %}</td>
                                            <td class="is-mute">{{ link.distanceM() is not null ? link.distanceM() ~ ' m' : '—' }}</td>
                                            <td class="is-mute">{{ link.walkMinutes() is not null ? link.walkMinutes() ~ ' min' : '—' }}</td>
                                            <td class="table__actions">
                                                {% if user.can('listings.manage') %}
                                                    <form method="post" class="form-inline" action="{{ url('admin.listings.near_links.update', {id: listing.id(), linkId: link.id()}) }}" style="display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
                                                        {{ csrf_field()|raw }}
                                                        <input class="input" style="width:5.5rem" type="number" min="0" name="distance_m" value="{{ link.distanceM() ?? '' }}" placeholder="m">
                                                        <input class="input" style="width:5.5rem" type="number" min="0" name="walk_minutes" value="{{ link.walkMinutes() ?? '' }}" placeholder="min">
                                                        <button class="btn btn--ghost btn-sm" type="submit">{{ 'common.save'|trans }}</button>
                                                    </form>
                                                    <form method="post" action="{{ url('admin.listings.near_links.destroy', {id: listing.id(), linkId: link.id()}) }}" data-confirm="{{ 'listings.near_links.confirm_remove'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1" style="display:inline">
                                                        {{ csrf_field()|raw }}
                                                        <button class="btn btn--ghost btn-sm" type="submit">{{ 'common.delete'|trans }}</button>
                                                    </form>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    {% if user.can('listings.manage') %}
                        <div class="listing-images-stack" style="margin-top:1rem">
                            <section class="design-box">
                                <header class="design-box__head">
                                    <h2>{{ 'listings.near_links.attach'|trans }}</h2>
                                    <p>{{ 'listings.near_links.attach_hint'|trans }}</p>
                                </header>
                                <div class="design-box__body">
                                    {% if nearOptions is empty %}
                                        <div class="empty">
                                            <p>{{ 'listings.near_links.no_options'|trans }}</p>
                                            <a class="btn btn--primary" href="{{ url('admin.listings.near.create') }}">{{ icon('plus') }} {{ 'listings.near.action.new'|trans }}</a>
                                        </div>
                                    {% else %}
                                        {% include 'ui/error-summary.html.twig' with { form: 'listings.near_link.save' } %}
                                        <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.listings.near_links.store', {id: listing.id()}) }}" data-form="listings.near_link.save" x-data="gereqForm"{% if form_errors('listings.near_link.save') %} data-server-state="1"{% endif %}>
                                            {{ csrf_field()|raw }}
                                            {% include 'ui/select.html.twig' with {
                                                name: 'near_location_id',
                                                label: 'listings.near_links.field.place'|trans,
                                                required: true,
                                                form: 'listings.near_link.save',
                                                value: '',
                                                options: nearOptions,
                                                extra: 'field--full'
                                            } %}
                                            {% include 'ui/input.html.twig' with {
                                                name: 'distance_m',
                                                label: 'listings.near_links.field.distance'|trans,
                                                optional: true,
                                                form: 'listings.near_link.save',
                                                value: ''
                                            } %}
                                            {% include 'ui/input.html.twig' with {
                                                name: 'walk_minutes',
                                                label: 'listings.near_links.field.walk'|trans,
                                                optional: true,
                                                form: 'listings.near_link.save',
                                                value: ''
                                            } %}
                                            <div class="form-actions">
                                                <button class="btn btn--primary" type="submit">{{ 'listings.near_links.attach'|trans }}</button>
                                            </div>
                                        </form>
                                    {% endif %}
                                </div>
                            </section>
                        </div>
                    {% endif %}
                </section>
            </section>

            <section class="design-panel" data-panel="images" role="tabpanel">
                <section class="panel">
                    <header class="panel__head">
                        <h2>{{ 'listings.images.title'|trans }}</h2>
                    </header>

                    {% if not hasMedia %}
                        <div class="empty">
                            <p>{{ 'listings.images.media_hint'|trans }}</p>
                        </div>
                    {% endif %}

                    {% if images is empty %}
                        <div class="empty">
                            <p>{{ 'listings.images.empty'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="product-gallery">
                            {% for image in images %}
                                {% set asset = imageAssets[image.id()]|default(null) %}
                                {% set preview = imageUrls[image.id()]|default(null) %}
                                <figure class="product-gallery__item{{ image.isPrimary() ? ' is-primary' : '' }}">
                                    <div class="product-gallery__media">
                                        {% if preview %}
                                            <a href="{{ preview }}" target="_blank" rel="noopener">
                                                <img src="{{ preview }}" alt="{{ image.alt()|default(asset ? asset.title() : listing.title()) }}">
                                            </a>
                                        {% else %}
                                            <div class="product-gallery__missing muted">{{ 'listings.images.missing_asset'|trans }}</div>
                                        {% endif %}
                                        <div class="product-gallery__badges">
                                            {% if image.isExternal() %}
                                                <span class="badge badge--muted">{{ 'listings.images.external'|trans }}</span>
                                            {% elseif asset %}
                                                <span class="badge badge--muted">{{ 'listings.images.from_media'|trans }}</span>
                                            {% else %}
                                                <span class="badge badge--warn">{{ 'listings.images.missing_asset'|trans }}</span>
                                            {% endif %}
                                            {% if image.isPrimary() %}
                                                <span class="badge badge--ok">{{ 'listings.images.primary'|trans }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    {% if user.can('listings.manage') %}
                                        <div class="product-gallery__actions product-gallery__actions--toolbar">
                                            <form method="post" action="{{ url('admin.listings.images.move', {id: listing.id(), imageId: image.id()}) }}">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="direction" value="up">
                                                <button class="btn btn--ghost" type="submit" title="{{ 'listings.images.move_up'|trans }}" aria-label="{{ 'listings.images.move_up'|trans }}" {{ loop.first ? 'disabled' : '' }}>{{ icon('chevron-up') }}</button>
                                            </form>
                                            <form method="post" action="{{ url('admin.listings.images.move', {id: listing.id(), imageId: image.id()}) }}">
                                                {{ csrf_field()|raw }}
                                                <input type="hidden" name="direction" value="down">
                                                <button class="btn btn--ghost" type="submit" title="{{ 'listings.images.move_down'|trans }}" aria-label="{{ 'listings.images.move_down'|trans }}" {{ loop.last ? 'disabled' : '' }}>{{ icon('chevron-down') }}</button>
                                            </form>
                                            {% if image.isPrimary() %}
                                                <button class="btn btn--ghost" type="button" disabled title="{{ 'listings.images.primary'|trans }}" aria-label="{{ 'listings.images.primary'|trans }}">{{ icon('star') }}</button>
                                            {% else %}
                                                <form method="post" action="{{ url('admin.listings.images.primary', {id: listing.id(), imageId: image.id()}) }}">
                                                    {{ csrf_field()|raw }}
                                                    <button class="btn btn--ghost" type="submit" title="{{ 'listings.images.set_primary'|trans }}" aria-label="{{ 'listings.images.set_primary'|trans }}">{{ icon('star') }}</button>
                                                </form>
                                            {% endif %}
                                            <form method="post" action="{{ url('admin.listings.images.destroy', {id: listing.id(), imageId: image.id()}) }}" data-confirm="{{ 'listings.images.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                                {{ csrf_field()|raw }}
                                                <button class="btn btn--ghost btn--danger-quiet" type="submit" title="{{ 'common.delete'|trans }}" aria-label="{{ 'common.delete'|trans }}">{{ icon('trash') }}</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </figure>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if user.can('listings.manage') %}
                        <div class="listing-images-stack">
                            {% if hasMedia %}
                                <section class="design-box">
                                    <header class="design-box__head">
                                        <h2>{{ 'listings.images.upload'|trans }}</h2>
                                        <p>{{ 'listings.images.upload_hint'|trans }}</p>
                                    </header>
                                    <div class="design-box__body">
                                        {% include 'ui/error-summary.html.twig' with { form: 'listings.image.upload' } %}
                                        <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.listings.images.store', {id: listing.id()}) }}" enctype="multipart/form-data" data-form="listings.image.upload" x-data="gereqForm"{% if form_errors('listings.image.upload') %} data-server-state="1"{% endif %}>
                                            {{ csrf_field()|raw }}
                                            {% include 'ui/file.html.twig' with { name: 'file', label: 'listings.images.field.file'|trans, hint: 'listings.images.field.file.hint'|trans, extra: 'field--full' } %}
                                            {% include 'ui/input.html.twig' with { name: 'title', label: 'listings.images.field.title'|trans, optional: true, form: 'listings.image.upload', value: '' } %}
                                            {% include 'ui/input.html.twig' with { name: 'alt', label: 'listings.images.field.alt'|trans, optional: true, form: 'listings.image.upload', value: '' } %}
                                            <div class="form-actions">
                                                <button class="btn btn--primary" type="submit">{{ 'listings.images.upload'|trans }}</button>
                                            </div>
                                        </form>
                                    </div>
                                </section>

                                {% if libraryImages is not empty %}
                                    <section class="design-box">
                                        <header class="design-box__head">
                                            <h2>{{ 'listings.images.attach_existing'|trans }}</h2>
                                            <p>{{ 'listings.images.library_hint'|trans }}</p>
                                        </header>
                                        <div class="design-box__body">
                                            {% include 'ui/error-summary.html.twig' with { form: 'listings.image.attach' } %}
                                            <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.listings.images.attach', {id: listing.id()}) }}" data-form="listings.image.attach" x-data="gereqForm"{% if form_errors('listings.image.attach') %} data-server-state="1"{% endif %}>
                                                {{ csrf_field()|raw }}
                                                {% include 'ui/select.html.twig' with { name: 'media_asset_id', label: 'listings.images.attach_existing'|trans, required: true, form: 'listings.image.attach', value: '', options: libraryImages, extra: 'field--full' } %}
                                                <div class="form-actions">
                                                    <button class="btn btn--ghost" type="submit">{{ 'listings.images.attach'|trans }}</button>
                                                </div>
                                            </form>
                                        </div>
                                    </section>
                                {% endif %}
                            {% endif %}

                            <section class="design-box">
                                <header class="design-box__head">
                                    <h2>{{ 'listings.images.add_url'|trans }}</h2>
                                    <p>{{ 'listings.images.url_hint'|trans }}</p>
                                </header>
                                <div class="design-box__body">
                                    {% include 'ui/error-summary.html.twig' with { form: 'listings.image.url' } %}
                                    <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.listings.images.url', {id: listing.id()}) }}" data-form="listings.image.url" x-data="gereqForm"{% if form_errors('listings.image.url') %} data-server-state="1"{% endif %}>
                                        {{ csrf_field()|raw }}
                                        {% include 'ui/input.html.twig' with { name: 'external_url', type: 'url', label: 'listings.images.field.url'|trans, required: true, form: 'listings.image.url', value: '', extra: 'field--full' } %}
                                        {% include 'ui/input.html.twig' with { name: 'alt', label: 'listings.images.field.alt'|trans, optional: true, form: 'listings.image.url', value: '' } %}
                                        <div class="form-actions">
                                            <button class="btn btn--ghost" type="submit">{{ 'listings.images.add_url'|trans }}</button>
                                        </div>
                                    </form>
                                </div>
                            </section>
                        </div>
                    {% endif %}
                </section>
            </section>
        {% endif %}
    </div>

    {% if listing and user.can('listings.manage') %}
        <form method="post" class="listing-danger-zone" action="{{ url('admin.listings.destroy', {id: listing.id()}) }}" data-confirm="{{ 'listings.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
            {{ csrf_field()|raw }}
            <button type="submit" class="btn btn--danger">{{ 'common.delete'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
