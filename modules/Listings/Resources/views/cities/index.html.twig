{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.listings'|trans, url: url('admin.listings.index') },
        { label: 'nav.listings.cities'|trans },
    ] } %}
{% endblock %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="listings-cities" data-actions-default="1">
<header class="page-header">
    <h1>{{ 'listings.cities.title'|trans }}</h1>
    <div class="actions">
        {% if user.can('listings.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.listings.cities.create') }}">{{ icon('plus') }} {{ 'listings.cities.action.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'listings.cities.search'|trans }}">
        <select class="input" name="active" onchange="this.form.submit()">
            <option value="">{{ 'listings.cities.all'|trans }}</option>
            <option value="1" {{ active == '1' ? 'selected' : '' }}>{{ 'listings.cities.active_only'|trans }}</option>
            <option value="0" {{ active == '0' ? 'selected' : '' }}>{{ 'listings.cities.inactive_only'|trans }}</option>
        </select>
    </form>
    <div class="toolbar__toggles">
        <button
            type="button"
            class="toolbar__toggle"
            :class="showActions ? 'is-on' : ''"
            @click="toggleActions"
            :aria-pressed="showActions ? 'true' : 'false'"
            title="{{ 'ui.table.actions_toggle'|trans }}"
        >
            {{ icon('dots') }}
            <span>{{ 'ui.table.actions'|trans }}</span>
        </button>
    </div>
</div>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
<th>{{ 'listings.cities.field.name'|trans }}</th>
<th>{{ 'listings.cities.field.image_url'|trans }}</th>
<th>{{ 'listings.cities.field.sort_order'|trans }}</th>
<th>{{ 'listings.cities.field.active'|trans }}</th>
<th class="table__actions-head" x-show="showActions" x-cloak></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td>
        <div class="table__title">
            <a href="{{ url('admin.listings.cities.show', {id: item.id()}) }}">{{ item.name() }}</a>
        </div>
    </td>
    <td class="is-mute">
        {% if item.imageUrl() %}
            <img src="{{ item.imageUrl() }}" alt="" style="width:48px;height:32px;object-fit:cover;border-radius:6px;vertical-align:middle">
        {% else %}
            —
        {% endif %}
    </td>
    <td class="is-mute">{{ item.sortOrder() }}</td>
    <td>
        <span class="badge badge--{{ item.active() ? 'ok' : 'muted' }}">
            {{ item.active() ? 'listings.cities.status.active'|trans : 'listings.cities.status.inactive'|trans }}
        </span>
    </td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            <a href="{{ url('admin.listings.cities.show', {id: item.id()}) }}">{{ 'common.view'|trans }}</a>
            {% if user.can('listings.manage') %}
                <a href="{{ url('admin.listings.cities.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.listings.cities.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'listings.cities.confirm_delete'|trans|e('js') }}');">
                    {{ csrf_field()|raw }}
                    <button type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr>
<td colspan="5">
<div class="empty">
<h2>{{ 'listings.cities.empty'|trans }}</h2>
<p>{{ 'listings.cities.empty.hint'|trans }}</p>
</div>
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
