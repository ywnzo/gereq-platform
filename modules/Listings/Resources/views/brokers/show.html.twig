{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.listings'|trans, url: url('admin.listings.index') },
        { label: 'nav.listings.brokers'|trans, url: url('admin.listings.brokers.index') },
        { label: item.fullName() },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ item.fullName() }}</h1>
        <p class="muted detail-layout__meta">
            {% if item.position() %}<span>{{ item.position() }}</span>{% endif %}
            <span class="badge badge--{{ item.active() ? 'ok' : 'muted' }}">
                {{ item.active() ? 'listings.brokers.status.active'|trans : 'listings.brokers.status.inactive'|trans }}
            </span>
        </p>
    </div>
    <div class="actions">
        {% if user.can('listings.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.listings.brokers.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
        {% endif %}
        <a class="btn btn--ghost" href="{{ url('admin.listings.brokers.index') }}">{{ 'common.back'|trans }}</a>
    </div>
</header>

<div class="detail-layout">
    <div class="detail-layout__main">
        <section class="detail-hero panel">
            {% if item.photoUrl() %}
                <a class="detail-hero__media detail-hero__media--square" href="{{ item.photoUrl() }}" target="_blank" rel="noopener">
                    <img src="{{ item.photoUrl() }}" alt="{{ item.fullName() }}" loading="eager" decoding="async" fetchpriority="high">
                </a>
            {% endif %}
            <div class="detail-hero__body">
                <div class="detail-hero__highlight">
                    <span>{{ item.position() ? 'listings.brokers.field.position'|trans : 'listings.brokers.field.active'|trans }}</span>
                    <strong>{{ item.position() ?: (item.active() ? 'listings.brokers.status.active'|trans : 'listings.brokers.status.inactive'|trans) }}</strong>
                </div>
                <dl class="detail-hero__facts">
                    <div>
                        <dt>{{ 'listings.brokers.field.email'|trans }}</dt>
                        <dd><a href="mailto:{{ item.email() }}">{{ item.email() }}</a></dd>
                    </div>
                    <div>
                        <dt>{{ 'listings.brokers.field.phone'|trans }}</dt>
                        <dd>{% if item.phone() %}<a href="tel:{{ item.phone() }}">{{ item.phone() }}</a>{% else %}—{% endif %}</dd>
                    </div>
                    <div>
                        <dt>{{ 'listings.brokers.field.active'|trans }}</dt>
                        <dd>
                            <span class="badge badge--{{ item.active() ? 'ok' : 'muted' }}">
                                {{ item.active() ? 'listings.brokers.status.active'|trans : 'listings.brokers.status.inactive'|trans }}
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt>{{ 'listings.brokers.field.created'|trans }}</dt>
                        <dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd>
                    </div>
                </dl>
            </div>
        </section>

        {% if item.skills() or item.description() %}
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'listings.brokers.field.description'|trans }}</h2>
                </header>
                {% if item.skills() %}
                    <p><strong>{{ 'listings.brokers.field.skills'|trans }}:</strong> {{ item.skills() }}</p>
                {% endif %}
                <div class="detail-prose">{{ item.description() ?: '—' }}</div>
            </section>
        {% endif %}
    </div>

    <aside class="detail-layout__aside">
        <section class="panel">
            <header class="panel__head">
                <h2>{{ 'common.overview'|trans }}</h2>
            </header>
            <dl class="meta-list meta-list--flush detail-layout__specs">
                <div>
                    <dt>{{ 'listings.brokers.field.active'|trans }}</dt>
                    <dd>
                        <span class="badge badge--{{ item.active() ? 'ok' : 'muted' }}">
                            {{ item.active() ? 'listings.brokers.status.active'|trans : 'listings.brokers.status.inactive'|trans }}
                        </span>
                    </dd>
                </div>
                <div>
                    <dt>{{ 'listings.brokers.field.created'|trans }}</dt>
                    <dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd>
                </div>
                <div class="meta-list__full">
                    <dt>{{ 'listings.brokers.field.email'|trans }}</dt>
                    <dd><a href="mailto:{{ item.email() }}">{{ item.email() }}</a></dd>
                </div>
                <div class="meta-list__full">
                    <dt>{{ 'listings.brokers.field.phone'|trans }}</dt>
                    <dd>{% if item.phone() %}<a href="tel:{{ item.phone() }}">{{ item.phone() }}</a>{% else %}—{% endif %}</dd>
                </div>
                {% if item.position() %}
                    <div class="meta-list__full">
                        <dt>{{ 'listings.brokers.field.position'|trans }}</dt>
                        <dd>{{ item.position() }}</dd>
                    </div>
                {% endif %}
            </dl>
        </section>

        <section class="panel detail-side-card">
            <header class="panel__head">
                <h2>{{ 'listings.brokers.field.email'|trans }}</h2>
            </header>
            <div class="detail-side-card__body">
                <strong class="detail-side-card__title">{{ item.fullName() }}</strong>
                {% if item.position() %}
                    <p class="muted detail-side-card__sub">{{ item.position() }}</p>
                {% endif %}
                <ul class="detail-side-card__list">
                    <li><a href="mailto:{{ item.email() }}">{{ item.email() }}</a></li>
                    {% if item.phone() %}
                        <li><a href="tel:{{ item.phone() }}">{{ item.phone() }}</a></li>
                    {% endif %}
                </ul>
            </div>
        </section>
    </aside>
</div>
{% endblock %}
