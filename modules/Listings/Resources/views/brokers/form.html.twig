{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.listings'|trans, url: url('admin.listings.index') },
        { label: 'nav.listings.brokers'|trans, url: url('admin.listings.brokers.index') },
        { label: item ? item.fullName() : 'listings.brokers.new'|trans },
    ] } %}
{% endblock %}

{% block content %}
{% set brokerSource = item ?? 'Modules\\Listings\\Domain\\Broker' %}

<header class="page-header">
    <h1>{{ item ? 'listings.brokers.edit'|trans : 'listings.brokers.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'listings.brokers.save' } %}

<form method="post" action="{{ item ? url('admin.listings.brokers.update', {id: item.id()}) : url('admin.listings.brokers.store') }}" data-form="listings.brokers.save" x-data="gereqForm"{% if form_errors('listings.brokers.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}
    {{ forms().render(brokerSource, {
        form: 'listings.brokers.save',
        cols: 2
    }) }}
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ item ? url('admin.listings.brokers.show', {id: item.id()}) : url('admin.listings.brokers.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
