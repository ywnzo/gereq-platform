{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.listings'|trans, url: url('admin.listings.index') },
        { label: 'nav.listings.properties'|trans, url: url('admin.listings.index') },
        { label: listing.title() },
    ] } %}
{% endblock %}

{% block content %}
    {% set statusTone = listing.status() == 'published' ? 'ok' : (listing.status() == 'draft' ? 'warn' : 'muted') %}
    {% set marketTone = listing.marketStatus() == 'available' ? 'ok' : (listing.marketStatus() in ['sold', 'rented'] ? 'danger' : (listing.marketStatus() == 'reserved' ? 'warn' : 'muted')) %}
    {% set coverUrl = listing.coverImageUrl() %}
    {% if not coverUrl and images is not empty %}
        {% for image in images %}
            {% if image.isPrimary() and attribute(imageUrls, image.id()) %}
                {% set coverUrl = attribute(imageUrls, image.id()) %}
            {% endif %}
        {% endfor %}
        {% if not coverUrl %}
            {% set firstImage = images|first %}
            {% set coverUrl = imageUrls[firstImage.id()]|default(null) %}
        {% endif %}
    {% endif %}

    <header class="page-header">
        <div>
            <h1>{{ listing.title() }}</h1>
            <p class="muted listing-detail__meta">
                <code>{{ listing.slug() }}</code>
                <span class="badge badge--{{ statusTone }}">{{ listing.statusLabel()|trans }}</span>
                <span class="badge badge--{{ marketTone }}">{{ ('listings.market.' ~ listing.marketStatus())|trans }}</span>
                <span class="badge badge--info">{{ ('listings.offer.' ~ listing.offerType())|trans }}</span>
                {% if listing.featured() %}<span class="badge badge--signal">TOP</span>{% endif %}
            </p>
            {% if listing.city() or listing.street() or listing.address() %}
                <p class="module-lead">
                    {% if listing.address() %}
                        {{ listing.address() }}
                    {% else %}
                        {{ listing.city() }}{% if listing.cityPart() %}, {{ listing.cityPart() }}{% endif %}{% if listing.street() %} · {{ listing.street() }}{% endif %}
                    {% endif %}
                </p>
            {% endif %}
        </div>
        <div class="actions">
            {% if user.can('listings.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.listings.edit', {id: listing.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.listings.destroy', {id: listing.id()}) }}" data-confirm="{{ 'listings.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="detail-hub" x-data="gereqTabs" data-initial="overview">
        <div class="design-tabs detail-tabs" role="tablist">
            <button type="button" class="design-tab" role="tab" data-tab="overview">{{ 'common.overview'|trans }}</button>
            <button type="button" class="design-tab" role="tab" data-tab="nearby">{{ 'listings.tab.nearby'|trans }}{% if nearLinks %}<span class="module-tab-count">{{ nearLinks|length }}</span>{% endif %}</button>
            <button type="button" class="design-tab" role="tab" data-tab="images">{{ 'listings.tab.images'|trans }}{% if images %}<span class="module-tab-count">{{ images|length }}</span>{% endif %}</button>
        </div>

        <section class="design-panel" data-panel="overview" role="tabpanel">
            <div class="listing-detail">
                <div class="listing-detail__main">
                    <section class="listing-hero panel">
                        {% if coverUrl %}
                            <a class="listing-hero__media" href="{{ coverUrl }}" target="_blank" rel="noopener">
                                <img src="{{ coverUrl }}" alt="{{ listing.title() }}" loading="eager" decoding="async" fetchpriority="high">
                            </a>
                        {% else %}
                            <div class="listing-hero__media listing-hero__media--empty muted">{{ 'listings.images.empty'|trans }}</div>
                        {% endif %}
                        <div class="listing-hero__body">
                            <div class="listing-hero__price">
                                <span>{{ 'listings.field.price'|trans }}</span>
                                <strong>{{ listing.price()|number_format(0, ',', ' ') }}&nbsp;{{ listing.currency() }}</strong>
                            </div>
                            <dl class="listing-hero__facts">
                                <div>
                                    <dt>{{ 'listings.field.type'|trans }}</dt>
                                    <dd>{{ ('listings.type.' ~ listing.propertyType())|trans }}</dd>
                                </div>
                                <div>
                                    <dt>{{ 'listings.field.area'|trans }}</dt>
                                    <dd>{{ listing.areaM2() is not null ? listing.areaM2() ~ ' m²' : '—' }}</dd>
                                </div>
                                <div>
                                    <dt>{{ 'listings.field.rooms'|trans }}</dt>
                                    <dd>{{ listing.rooms() is not null ? listing.rooms() : '—' }}</dd>
                                </div>
                                <div>
                                    <dt>{{ 'listings.field.energy'|trans }}</dt>
                                    <dd>{{ listing.energyRating() ?: '—' }}</dd>
                                </div>
                            </dl>
                        </div>
                    </section>

                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'listings.field.description'|trans }}</h2>
                        </header>
                        <div class="listing-desc">{{ listing.description() ?: '—' }}</div>
                    </section>

                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'listings.section.location'|trans }}</h2>
                        </header>
                        <dl class="meta-list meta-list--flush">
                            <div>
                                <dt>{{ 'listings.field.city'|trans }}</dt>
                                <dd>{{ listing.city() ?: '—' }}{% if listing.cityPart() %}<span class="muted"> · {{ listing.cityPart() }}</span>{% endif %}</dd>
                            </div>
                            <div>
                                <dt>{{ 'listings.field.street'|trans }}</dt>
                                <dd>{{ listing.street() ?: '—' }}{% if listing.zip() %}<span class="muted"> · {{ listing.zip() }}</span>{% endif %}</dd>
                            </div>
                            <div class="meta-list__full">
                                <dt>{{ 'listings.field.address'|trans }}</dt>
                                <dd>{{ listing.address() ?: '—' }}</dd>
                            </div>
                            {% if listing.latitude() is not null and listing.longitude() is not null %}
                                <div class="meta-list__full">
                                    <dt>{{ 'listings.field.map'|trans }}</dt>
                                    <dd>
                                        <a href="https://www.openstreetmap.org/?mlat={{ listing.latitude() }}&mlon={{ listing.longitude() }}#map=16/{{ listing.latitude() }}/{{ listing.longitude() }}" target="_blank" rel="noopener">
                                            {{ listing.latitude() }}, {{ listing.longitude() }}
                                        </a>
                                    </dd>
                                </div>
                            {% endif %}
                        </dl>
                    </section>

                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'listings.section.amenities'|trans }}</h2>
                        </header>
                        <div class="module-chip-row listing-detail__chips">
                            {% set amenities = listing.amenityLabels() %}
                            {% if amenities is empty %}
                                <span class="muted">—</span>
                            {% else %}
                                {% for key in amenities %}
                                    {% if key == 'parking' %}
                                        <span class="badge badge--info">{{ 'listings.field.parking'|trans }}{% if listing.parkingLots() %} ({{ listing.parkingLots() }}){% endif %}</span>
                                    {% else %}
                                        <span class="badge badge--info">{{ ('listings.amenity.' ~ key)|trans }}</span>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        </div>
                    </section>
                </div>

                <aside class="listing-detail__aside">
                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'listings.section.basic'|trans }}</h2>
                        </header>
                        <dl class="meta-list meta-list--flush listing-detail__specs">
                            <div>
                                <dt>{{ 'listings.field.status'|trans }}</dt>
                                <dd><span class="badge badge--{{ statusTone }}">{{ listing.statusLabel()|trans }}</span></dd>
                            </div>
                            <div>
                                <dt>{{ 'listings.field.market_status'|trans }}</dt>
                                <dd><span class="badge badge--{{ marketTone }}">{{ ('listings.market.' ~ listing.marketStatus())|trans }}</span></dd>
                            </div>
                            <div>
                                <dt>{{ 'listings.field.offer'|trans }}</dt>
                                <dd><span class="badge badge--info">{{ ('listings.offer.' ~ listing.offerType())|trans }}</span></dd>
                            </div>
                            <div>
                                <dt>{{ 'listings.field.featured'|trans }}</dt>
                                <dd>{% if listing.featured() %}<span class="badge badge--signal">TOP</span>{% else %}{{ 'common.no'|trans }}{% endif %}</dd>
                            </div>
                            <div>
                                <dt>{{ 'listings.field.floor'|trans }}</dt>
                                <dd>{{ listing.floor() is not null ? listing.floor() : '—' }}</dd>
                            </div>
                            <div>
                                <dt>{{ 'listings.field.floors'|trans }}</dt>
                                <dd>{{ listing.floors() is not null ? listing.floors() : '—' }}</dd>
                            </div>
                            <div class="meta-list__full">
                                <dt>{{ 'listings.field.created'|trans }}</dt>
                                <dd>{{ listing.createdAt().format('d. m. Y H:i') }}</dd>
                            </div>
                        </dl>
                    </section>

                    <section class="panel listing-broker">
                        <header class="panel__head">
                            <h2>{{ 'listings.section.broker'|trans }}</h2>
                            {% if listing.brokerId() and user.can('listings.view') %}
                                <a class="btn btn--ghost btn-sm" href="{{ url('admin.listings.brokers.show', {id: listing.brokerId()}) }}">{{ 'common.detail'|trans }}</a>
                            {% endif %}
                        </header>
                        {% if listing.brokerId() or listing.brokerName() %}
                            <div class="listing-broker__body">
                                <strong class="listing-broker__name">
                                    {% if listing.brokerId() %}
                                        <a href="{{ url('admin.listings.brokers.show', {id: listing.brokerId()}) }}">{{ listing.brokerName() ?: '—' }}</a>
                                    {% else %}
                                        {{ listing.brokerName() ?: '—' }}
                                    {% endif %}
                                </strong>
                                {% if listing.brokerPosition() %}
                                    <p class="muted listing-broker__role">{{ listing.brokerPosition() }}</p>
                                {% endif %}
                                <ul class="listing-broker__contacts">
                                    {% if listing.brokerEmail() %}
                                        <li><a href="mailto:{{ listing.brokerEmail() }}">{{ listing.brokerEmail() }}</a></li>
                                    {% endif %}
                                    {% if listing.brokerPhone() %}
                                        <li><a href="tel:{{ listing.brokerPhone() }}">{{ listing.brokerPhone() }}</a></li>
                                    {% endif %}
                                    {% if not listing.brokerEmail() and not listing.brokerPhone() %}
                                        <li class="muted">—</li>
                                    {% endif %}
                                </ul>
                            </div>
                        {% else %}
                            <p class="muted listing-broker__empty">—</p>
                        {% endif %}
                    </section>
                </aside>
            </div>
        </section>

        <section class="design-panel" data-panel="nearby" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'listings.section.nearby'|trans }}</h2>
                    {% if user.can('listings.manage') %}
                        <a class="btn btn--ghost btn-sm" href="{{ url('admin.listings.edit', {id: listing.id()}) }}#nearby">{{ 'common.edit'|trans }}</a>
                    {% endif %}
                </header>

                {% if nearLinks is empty %}
                    <div class="empty">
                        <p>{{ 'listings.near_links.empty'|trans }}</p>
                        {% if user.can('listings.manage') %}
                            <a class="btn btn--primary" href="{{ url('admin.listings.edit', {id: listing.id()}) }}#nearby">{{ 'listings.near_links.attach'|trans }}</a>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'listings.near.field.name'|trans }}</th>
                                    <th>{{ 'listings.near.field.category'|trans }}</th>
                                    <th>{{ 'listings.near_links.field.distance'|trans }}</th>
                                    <th>{{ 'listings.near_links.field.walk'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for link in nearLinks %}
                                    {% set place = nearPlaces[link.id()]|default(null) %}
                                    <tr>
                                        <td>
                                            {% if place %}
                                                <a href="{{ url('admin.listings.near.show', {id: place.id()}) }}"><strong>{{ place.name() }}</strong></a>
                                                {% if place.address() %}<div class="muted">{{ place.address() }}</div>{% endif %}
                                            {% else %}
                                                <span class="muted">{{ 'listings.near.error.not_found'|trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{% if place %}<span class="badge badge--info">{{ ('listings.near.category.' ~ place.category())|trans }}</span>{% else %}—{% endif %}</td>
                                        <td class="is-mute">{{ link.distanceM() is not null ? link.distanceM() ~ ' m' : '—' }}</td>
                                        <td class="is-mute">{{ link.walkMinutes() is not null ? link.walkMinutes() ~ ' min' : '—' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </section>

        <section class="design-panel" data-panel="images" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'listings.images.title'|trans }}</h2>
                    {% if user.can('listings.manage') %}
                        <a class="btn btn--ghost btn-sm" href="{{ url('admin.listings.edit', {id: listing.id()}) }}#images">{{ 'listings.images.manage'|trans }}</a>
                    {% endif %}
                </header>

                {% if images is empty %}
                    <div class="empty">
                        <p>{{ 'listings.images.empty'|trans }}</p>
                        {% if user.can('listings.manage') %}
                            <a class="btn btn--primary" href="{{ url('admin.listings.edit', {id: listing.id()}) }}#images">{{ 'listings.images.manage'|trans }}</a>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="product-gallery">
                        {% for image in images %}
                            {% set asset = imageAssets[image.id()]|default(null) %}
                            {% set preview = imageUrls[image.id()]|default(null) %}
                            <figure class="product-gallery__item{{ image.isPrimary() ? ' is-primary' : '' }}">
                                <div class="product-gallery__media">
                                    {% if preview %}
                                        <a href="{{ preview }}" target="_blank" rel="noopener">
                                            <img src="{{ preview }}" alt="{{ image.alt()|default(listing.title()) }}" loading="lazy" decoding="async">
                                        </a>
                                    {% else %}
                                        <div class="product-gallery__missing muted">{{ 'listings.images.missing_asset'|trans }}</div>
                                    {% endif %}
                                    <div class="product-gallery__badges">
                                        {% if image.isExternal() %}
                                            <span class="badge badge--muted">{{ 'listings.images.external'|trans }}</span>
                                        {% elseif asset %}
                                            <span class="badge badge--muted">{{ 'listings.images.from_media'|trans }}</span>
                                        {% endif %}
                                        {% if image.isPrimary() %}
                                            <span class="badge badge--ok">{{ 'listings.images.primary'|trans }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </figure>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </section>
    </div>
{% endblock %}
