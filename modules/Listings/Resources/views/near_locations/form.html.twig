{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.listings'|trans, url: url('admin.listings.index') },
        { label: 'nav.listings.near'|trans, url: url('admin.listings.near.index') },
        { label: item ? item.name() : 'listings.near.new'|trans },
    ] } %}
{% endblock %}

{% block content %}
{% set nearSource = item ?? 'Modules\\Listings\\Domain\\NearLocation' %}

<header class="page-header">
    <h1>{{ item ? 'listings.near.edit'|trans : 'listings.near.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'listings.near.save' } %}

<form method="post" class="detail-stack" action="{{ item ? url('admin.listings.near.update', {id: item.id()}) : url('admin.listings.near.store') }}" data-form="listings.near.save" x-data="gereqForm"{% if form_errors('listings.near.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'listings.near.field.name'|trans }}</h2>
        </header>
        {{ forms().render(nearSource, {
            form: 'listings.near.save',
            group: 'basic',
            cols: 2
        }) }}
    </section>

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'listings.near.field.address'|trans }}</h2>
        </header>
        <div class="form-grid form-grid--cols-2" x-data="gereqAresAddress">
            <div class="g-field field--full ares-field">
                <span class="g-label">{{ 'listings.near.field.address'|trans }} · ARES</span>
                <div class="ares-field__control">
                    <input
                        class="g-control"
                        name="address"
                        data-ares-query
                        data-ares-fill="address"
                        autocomplete="off"
                        value="{{ item and item.address() ? item.address() : '' }}"
                        @input="onInput"
                        @keydown="onKeydown"
                        x-ref="query"
                    >
                    {% include 'ui/ares_address_suggest.html.twig' %}
                </div>
                <input type="hidden" name="city" data-ares-fill="city" value="{{ item and item.city() ? item.city() : '' }}">
            </div>

            {{ forms().render(nearSource, {
                form: 'listings.near.save',
                group: 'location',
                cols: 2,
                wrap: false
            }) }}
        </div>
    </section>

    <section class="panel">
        {{ forms().render(nearSource, {
            form: 'listings.near.save',
            group: 'details',
            cols: 2
        }) }}
    </section>

    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ item ? url('admin.listings.near.show', {id: item.id()}) : url('admin.listings.near.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
