{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="documents" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'documents.title'|trans }}</h1>
        {% if user.can('documents.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.documents.upload') }}">{{ icon('plus') }} {{ 'documents.upload'|trans }}</a>
        {% endif %}
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'documents.search'|trans }}">
        </form>
        <div class="toolbar__toggles">
            {% include 'ui/table_actions_toggle.html.twig' %}
        </div>
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% include 'ui/sort_th.html.twig' with { label: 'documents.field.title'|trans, column: 'title' } %}
                    <th>{{ 'documents.field.original_name'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'documents.field.mime'|trans, column: 'mime' } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'documents.field.size'|trans, column: 'size', class: 'is-num' } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'documents.field.created'|trans, column: 'createdAt' } %}
                    <th class="table__actions-head" x-show="showActions" x-cloak></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td><a href="{{ url('admin.documents.show', {id: item.id()}) }}">{{ item.title() }}</a></td>
                        <td class="is-mute">{{ item.originalName() }}</td>
                        <td><span class="badge">{{ item.mime() }}</span></td>
                        <td class="is-num is-mute">{{ (item.size() / 1024)|number_format(1, ',', ' ') }} KB</td>
                        <td class="is-mute">{{ item.createdAt().format('d. m. Y H:i') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                <a href="{{ url('admin.documents.show', {id: item.id()}) }}">{{ 'common.detail'|trans }}</a>
                                {% if user.can('documents.manage') %}
                                    <form method="post" action="{{ url('admin.documents.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'documents.confirm_delete'|trans|e('js') }}');">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'documents.empty'|trans }}</h2>
                                <p>{{ 'documents.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
