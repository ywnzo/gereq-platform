{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set canBulk = user.can('documents.manage') %}
{% set mimeFilter = mime|default('') %}
{% set vehicleFilter = vehicle|default('') %}
{% set orderFilter = order|default('') %}
{% set advancedFilters = (mimeFilter is not empty) or (vehicleFilter is not empty) or (orderFilter is not empty) %}
{% set filterQuery = { mime: mimeFilter, vehicle: vehicleFilter, order: orderFilter } %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="documents"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'documents.bulk.confirm_delete'|trans|e('html_attr') }}"
>
    <header class="page-header">
        <h1>{{ 'documents.title'|trans }}</h1>
        {% if canBulk %}
            <a class="btn btn--primary" href="{{ url('admin.documents.upload') }}">{{ icon('plus') }} {{ 'documents.upload'|trans }}</a>
        {% endif %}
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get" id="documents-filter-form">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <input type="hidden" name="mime" value="{{ mimeFilter }}">
            <input type="hidden" name="vehicle" value="{{ vehicleFilter }}">
            <input type="hidden" name="order" value="{{ orderFilter }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'documents.search'|trans }}">
        </form>
        <div class="toolbar__toggles">
            {{ ui_render('drawer_trigger', {
                drawer_id: 'documents-filters',
                label: 'ui.drawer.filters'|trans,
                variant: advancedFilters ? 'primary' : 'ghost',
                icon: 'filters'
            }) }}
        </div>
    </div>

    {% if canBulk and items is not empty %}
        <form
            class="bulk-bar"
            method="post"
            action="{{ url('admin.documents.bulk') }}"
            x-show="selectedCount > 0"
            x-cloak
            @submit="confirmBulk"
        >
            {{ csrf_field()|raw }}
            <input type="hidden" name="confirmed" value="1">
            <template x-for="id in selected" :key="id">
                <input type="hidden" name="ids[]" :value="id">
            </template>
            <div class="bulk-bar__meta">
                <strong x-text="selectedCount"></strong>
                <span>{{ 'documents.bulk.selected'|trans }}</span>
                <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'documents.bulk.clear'|trans }}</button>
            </div>
            <div class="bulk-bar__actions">
                <select class="input" name="action" x-model="bulkAction" required>
                    <option value="">{{ 'documents.bulk.choose'|trans }}</option>
                    <option value="delete">{{ 'documents.bulk.action.delete'|trans }}</option>
                </select>
                <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'documents.bulk.apply'|trans }}</button>
            </div>
        </form>
    {% endif %}

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% if canBulk %}
                        <th class="table__check">
                            <label class="table-check">
                                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected" {{ items is empty ? 'disabled' : '' }}>
                                <span class="sr-only">{{ 'documents.bulk.select_all'|trans }}</span>
                            </label>
                        </th>
                    {% endif %}
                    {% include 'ui/sort_th.html.twig' with { label: 'documents.field.title'|trans, column: 'title', query: filterQuery } %}
                    <th>{{ 'documents.field.original_name'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'documents.field.mime'|trans, column: 'mime', query: filterQuery } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'documents.field.size'|trans, column: 'size', query: filterQuery, class: 'is-num' } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'documents.field.created'|trans, column: 'createdAt', query: filterQuery } %}
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
                        {% if canBulk %}
                            <td class="table__check">
                                <label class="table-check">
                                    <input
                                        type="checkbox"
                                        value="{{ item.id() }}"
                                        @change="toggleId('{{ item.id() }}')"
                                        :checked="isSelected('{{ item.id() }}')"
                                    >
                                    <span class="sr-only">{{ item.title() }}</span>
                                </label>
                            </td>
                        {% endif %}
                        <td><a href="{{ url('admin.documents.show', {id: item.id()}) }}">{{ item.title() }}</a></td>
                        <td class="is-mute">{{ item.originalName() }}</td>
                        <td><span class="badge">{{ item.mime() }}</span></td>
                        <td class="is-num is-mute">{{ (item.size() / 1024)|number_format(1, ',', ' ') }} KB</td>
                        <td class="is-mute">{{ item.createdAt().format('d. m. Y H:i') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with { href: url('admin.documents.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                                {% if canBulk %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.documents.destroy', {id: item.id()}), confirm: 'documents.confirm_delete'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ canBulk ? 7 : 6 }}">
                            <div class="empty">
                                <h2>{{ 'documents.empty'|trans }}</h2>
                                <p>{{ 'documents.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>

{% embed 'ui/drawer.html.twig' with { id: 'documents-filters', title: 'ui.drawer.filters'|trans } %}
    {% block body %}
        <form method="get" class="g-drawer__form stack" id="documents-drawer-filters">
            <input type="hidden" name="q" value="{{ search }}">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'documents.field.mime'|trans }}</span>
                <select class="input" name="mime">
                    <option value="">{{ 'documents.filter.mime_all'|trans }}</option>
                    <option value="application/pdf" {{ mimeFilter == 'application/pdf' ? 'selected' : '' }}>PDF</option>
                    <option value="image/*" {{ mimeFilter == 'image/*' ? 'selected' : '' }}>{{ 'documents.filter.images'|trans }}</option>
                    <option value="video/*" {{ mimeFilter == 'video/*' ? 'selected' : '' }}>{{ 'documents.filter.videos'|trans }}</option>
                </select>
            </label>
            {% if serviceFilters %}
                {% include 'ui/select.html.twig' with {
                    name: 'vehicle',
                    id: 'documents-filter-vehicle',
                    label: 'documents.filter.plate'|trans,
                    value: vehicleFilter,
                    placeholder: 'documents.filter.plate_any'|trans,
                    options: plateOptions,
                    searchable: true,
                    empty_label: 'documents.filter.plate_empty'|trans,
                    extra: 'g-drawer__field'
                } %}
                {% include 'ui/select.html.twig' with {
                    name: 'order',
                    id: 'documents-filter-order',
                    label: 'documents.filter.order'|trans,
                    value: orderFilter,
                    placeholder: 'documents.filter.order_any'|trans,
                    options: orderOptions,
                    searchable: true,
                    empty_label: 'documents.filter.order_empty'|trans,
                    extra: 'g-drawer__field'
                } %}
            {% endif %}
        </form>
    {% endblock %}
    {% block footer %}
        <a class="btn btn--ghost" href="?q={{ search|url_encode }}&sort={{ sort|url_encode }}&dir={{ dir|url_encode }}">{{ 'ui.drawer.reset'|trans }}</a>
        <button class="btn btn--primary" type="submit" form="documents-drawer-filters">{{ 'ui.drawer.apply'|trans }}</button>
    {% endblock %}
{% endembed %}
{% endblock %}
