{#
  Compact document rows: thumb/file icon + title + preview eye.
  Expects: documents (Document[])
#}
<ul class="doc-list">
    {% for d in documents %}
        <li class="doc-list__item">
            <a
                class="doc-list__thumb{{ d.isImage() ? '' : ' doc-list__thumb--file' }}"
                href="{{ url('admin.documents.file', {id: d.id()}) }}"
                target="_blank"
                rel="noopener"
                title="{{ 'documents.preview'|trans }}"
                aria-label="{{ 'documents.preview'|trans }}: {{ d.title() }}"
            >
                {% if d.isImage() %}
                    <img src="{{ url('admin.documents.file', {id: d.id()}) }}" alt="" loading="lazy" width="48" height="40">
                {% else %}
                    {{ icon(d.fileIcon()) }}
                    {% if d.isPdf() %}
                        <span class="doc-list__ext">PDF</span>
                    {% endif %}
                {% endif %}
            </a>
            <a class="doc-list__title" href="{{ url('admin.documents.show', {id: d.id()}) }}">{{ d.title() }}</a>
            <div class="doc-list__actions">
                <a
                    class="table__action-btn table__action-btn--primary"
                    href="{{ url('admin.documents.file', {id: d.id()}) }}"
                    target="_blank"
                    rel="noopener"
                    title="{{ 'documents.preview'|trans }}"
                    aria-label="{{ 'documents.preview'|trans }}"
                >
                    {{ icon('eye') }}
                    <span class="table__action-btn__label">{{ 'documents.preview'|trans }}</span>
                </a>
            </div>
        </li>
    {% endfor %}
</ul>
