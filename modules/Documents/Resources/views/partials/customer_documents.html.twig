{% if documents is empty %}
    <div class="empty">
        <p>{{ 'documents.partial.empty'|trans }}</p>
        {% if user is defined and user.can('documents.manage') %}
            <a class="btn btn--ghost" href="{{ url('admin.documents.upload') }}?entity_type=customer&entity_id={{ customer.id() }}">{{ 'documents.partial.add'|trans }}</a>
        {% endif %}
    </div>
{% else %}
    {% include '@documents/partials/document_list.html.twig' with { documents: documents } %}
    <p class="muted" style="padding:0 14px 12px;margin:0">
        {% if user is defined and user.can('documents.manage') %}
            <a href="{{ url('admin.documents.upload') }}?entity_type=customer&entity_id={{ customer.id() }}">{{ 'documents.partial.add'|trans }}</a>
            ·
        {% endif %}
        <a href="{{ url('admin.documents.index') }}">{{ 'documents.partial.all'|trans }}</a>
    </p>
{% endif %}
