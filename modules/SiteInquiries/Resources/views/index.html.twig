{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set pageIds = items|map(i => i.id) %}
{% set canManage = user.can('site_inquiries.manage') %}
{% set filterQuery = { view: view } %}
{% if status %}{% set filterQuery = filterQuery|merge({ status: status }) %}{% endif %}
{% if from %}{% set filterQuery = filterQuery|merge({ from: from }) %}{% endif %}
{% if to %}{% set filterQuery = filterQuery|merge({ to: to }) %}{% endif %}
{% set colCount = canManage ? 7 : 5 %}

<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="site-inquiries"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'site_inquiries.bulk.confirm_delete'|trans|e('html_attr') }}"
>
    <header class="page-header">
        <div>
            <h1>{{ 'site_inquiries.index.title'|trans }}</h1>
            <p class="muted">{{ 'site_inquiries.index.hint'|trans }}</p>
        </div>
        <div class="actions">
            {% if canManage %}
                <a class="btn btn--ghost" href="{{ url('admin.site_inquiries.settings') }}">{{ 'nav.site_inquiries.settings'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            <input type="hidden" name="view" value="{{ view }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'site_inquiries.search'|trans }}">
            <select name="status" class="input" onchange="this.form.requestSubmit()">
                <option value="">{{ 'site_inquiries.filter.status_all'|trans }}</option>
                <option value="open" {{ status == 'open' ? 'selected' : '' }}>{{ 'site_inquiries.status.open'|trans }}</option>
                <option value="resolved" {{ status == 'resolved' ? 'selected' : '' }}>{{ 'site_inquiries.status.resolved'|trans }}</option>
            </select>
            <label class="toolbar__date">
                <span class="sr-only">{{ 'site_inquiries.filter.from'|trans }}</span>
                <input class="input" type="date" name="from" value="{{ from }}" title="{{ 'site_inquiries.filter.from'|trans }}" onchange="this.form.requestSubmit()">
            </label>
            <label class="toolbar__date">
                <span class="sr-only">{{ 'site_inquiries.filter.to'|trans }}</span>
                <input class="input" type="date" name="to" value="{{ to }}" title="{{ 'site_inquiries.filter.to'|trans }}" onchange="this.form.requestSubmit()">
            </label>
            {% if hasFilters %}
                <a class="btn btn--ghost btn-sm" href="?view={{ view|e('url') }}">{{ 'site_inquiries.filter.reset'|trans }}</a>
            {% endif %}
        </form>
        <div class="toolbar__toggles" role="group" aria-label="{{ 'site_inquiries.view.label'|trans }}">
            <a
                class="toolbar__toggle{{ view == 'list' ? ' is-on' : '' }}"
                href="?{{ list_query.params({ view: 'list', page: 1 })|url_encode }}"
            >{{ icon('list') }} {{ 'site_inquiries.view.list'|trans }}</a>
            <a
                class="toolbar__toggle{{ view == 'day' ? ' is-on' : '' }}"
                href="?{{ list_query.params({ view: 'day', page: 1 })|url_encode }}"
            >{{ icon('calendar') }} {{ 'site_inquiries.view.day'|trans }}</a>
        </div>
    </div>

    {% if canManage and items is not empty %}
        <form
            class="bulk-bar"
            method="post"
            action="{{ url('admin.site_inquiries.bulk') }}"
            x-show="selectedCount > 0"
            x-cloak
            @submit="confirmBulk"
        >
            {{ csrf_field()|raw }}
            <input type="hidden" name="confirmed" value="1">
            <template x-for="id in selected" :key="id">
                <input type="hidden" name="ids[]" :value="id">
            </template>
            <div class="bulk-bar__meta">
                <strong x-text="selectedCount"></strong>
                <span>{{ 'site_inquiries.bulk.selected'|trans }}</span>
                <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'site_inquiries.bulk.clear'|trans }}</button>
            </div>
            <div class="bulk-bar__actions">
                <select class="input" name="action" x-model="bulkAction" required>
                    <option value="">{{ 'site_inquiries.bulk.choose'|trans }}</option>
                    <option value="resolve">{{ 'site_inquiries.bulk.action.resolve'|trans }}</option>
                    <option value="reopen">{{ 'site_inquiries.bulk.action.reopen'|trans }}</option>
                    <option value="delete">{{ 'site_inquiries.bulk.action.delete'|trans }}</option>
                </select>
                <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'site_inquiries.bulk.apply'|trans }}</button>
            </div>
        </form>
    {% endif %}

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% if canManage %}
                        <th class="table__check">
                            <label class="table-check">
                                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected">
                                <span class="sr-only">{{ 'site_inquiries.bulk.select_all'|trans }}</span>
                            </label>
                        </th>
                    {% endif %}
                    {% include 'ui/sort_th.html.twig' with { label: 'site_inquiries.col.created'|trans, column: 'createdAt', query: filterQuery } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'site_inquiries.col.name'|trans, column: 'name', query: filterQuery } %}
                    <th>{{ 'site_inquiries.col.contact'|trans }}</th>
                    <th>{{ 'site_inquiries.col.route'|trans }}</th>
                    <th>{{ 'site_inquiries.col.details'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'site_inquiries.col.status'|trans, column: 'status', query: filterQuery } %}
                    {% if canManage %}
                        <th class="table__actions-head"></th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% if items is empty %}
                    <tr>
                        <td colspan="{{ colCount }}">
                            <div class="empty">
                                <h2>{{ 'site_inquiries.index.empty'|trans }}</h2>
                                <p>{{ hasFilters ? 'site_inquiries.index.empty_filtered'|trans : 'site_inquiries.index.empty_hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% elseif view == 'day' %}
                    {% for group in groups %}
                        <tr
                            class="table-group"
                            data-day="{{ group.key }}"
                            :class="isDayClosed('{{ group.key }}') ? 'is-closed' : ''"
                            @click="toggleDay('{{ group.key }}')"
                        >
                            <td colspan="{{ colCount }}">
                                <span class="table-group__label">
                                    <span class="table-group__chevron">{{ icon('expand_more') }}</span>
                                    {{ group.label }}
                                    <span class="table-group__count">({{ group.count }})</span>
                                </span>
                            </td>
                        </tr>
                        {% for item in group.items %}
                            {% include '@siteinquiries/_row.html.twig' with { item: item, canManage: canManage, dayKey: group.key } %}
                        {% endfor %}
                    {% endfor %}
                {% else %}
                    {% for item in items %}
                        {% include '@siteinquiries/_row.html.twig' with { item: item, canManage: canManage } %}
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
