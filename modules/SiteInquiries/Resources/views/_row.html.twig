<tr
    :class="isSelected('{{ item.id }}') ? 'is-selected' : ''"
    {% if dayKey is defined %}
        data-day-row="{{ dayKey }}"
        x-show="!isDayClosed('{{ dayKey }}')"
    {% endif %}
>
    {% if canManage %}
        <td class="table__check">
            <label class="table-check">
                <input
                    type="checkbox"
                    value="{{ item.id }}"
                    @change="toggleId('{{ item.id }}')"
                    :checked="isSelected('{{ item.id }}')"
                >
                <span class="sr-only">{{ item.name }}</span>
            </label>
        </td>
    {% endif %}
    <td class="is-mute">{{ item.created_at|date('d. m. Y H:i') }}</td>
    <td><strong>{{ item.name }}</strong></td>
    <td>
        <div><a href="tel:{{ item.phone }}">{{ item.phone }}</a></div>
        <div class="is-mute"><a href="mailto:{{ item.email }}">{{ item.email }}</a></div>
    </td>
    <td>
        {% if item.route_from or item.route_to %}
            {{ item.route_from ?: '?' }} → {{ item.route_to ?: '?' }}
        {% else %}
            —
        {% endif %}
        {% if item.preferred_date %}
            <div class="is-mute">{{ item.preferred_date }}</div>
        {% endif %}
    </td>
    <td>{{ item.details|length > 160 ? item.details|slice(0, 160) ~ '…' : item.details }}</td>
    <td>
        {% if canManage %}
            {% include 'ui/table_toggle.html.twig' with {
                action: url('admin.site_inquiries.resolve', { id: item.id }),
                on: item.resolved,
                title_on: 'site_inquiries.toggle.resolved'|trans,
                title_off: 'site_inquiries.toggle.open'|trans,
                toast_on: 'site_inquiries.flash.resolved'|trans,
                toast_off: 'site_inquiries.flash.reopened'|trans
            } %}
        {% else %}
            <span class="badge badge--{{ item.resolved ? 'ok' : 'warn' }}">
                {{ ('site_inquiries.status.' ~ item.status)|trans }}
            </span>
        {% endif %}
    </td>
    {% if canManage %}
        {% embed 'ui/row_actions.html.twig' %}
            {% block items %}
                {% include 'ui/row_action_destroy.html.twig' with {
                    action: url('admin.site_inquiries.destroy', { id: item.id }),
                    confirm: 'site_inquiries.confirm_delete'|trans
                } %}
            {% endblock %}
        {% endembed %}
    {% endif %}
</tr>
