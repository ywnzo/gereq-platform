{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'translate.settings.title'|trans }}</h1>
        <p class="muted">{{ 'translate.settings.intro'|trans }}</p>
    </div>
</header>

<div class="detail-stack">
<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'translate.settings.section.api'|trans }}</h2>
            <p class="muted">{{ 'translate.settings.section.api_hint'|trans|raw }}</p>
        </div>
    </header>
    <form method="post" class="form-grid" action="{{ url('admin.translate.settings.update') }}">
        {{ csrf_field()|raw }}
        <label class="field">
            <span>{{ 'translate.settings.api_key'|trans }}</span>
            <input class="input" type="password" name="translate__ms_api_key" value="" autocomplete="new-password" placeholder="{{ apiKeySet ? ('settings.secret.placeholder'|trans) : '…' }}">
        </label>
        <label class="field">
            <span>{{ 'translate.settings.region'|trans }}</span>
            <input class="input" type="text" name="translate__ms_region" value="{{ region }}" placeholder="westeurope">
            <span class="muted">{{ 'translate.settings.region_hint'|trans }}</span>
        </label>
        <label class="field field--full">
            <span>{{ 'translate.settings.endpoint'|trans }}</span>
            <input class="input" type="url" name="translate__ms_endpoint" value="{{ endpoint }}" placeholder="https://api.cognitive.microsofttranslator.com">
            <span class="muted">{{ 'translate.settings.endpoint_hint'|trans }}</span>
        </label>
        <label class="field">
            <span>{{ 'translate.settings.source_locale'|trans }}</span>
            <input class="input" type="text" name="translate__source_locale" value="{{ sourceLocale }}">
        </label>
        <label class="field">
            <span>{{ 'translate.settings.target_locale'|trans }}</span>
            <input class="input" type="text" name="translate__target_locale" value="{{ targetLocale }}">
        </label>
        <p class="muted field--full">
            {% if configured %}{{ 'translate.settings.configured'|trans }}{% else %}{{ 'translate.settings.missing'|trans }}{% endif %}
            · {{ 'translate.settings.cache_count'|trans({'%count%': cacheCount}) }}
        </p>
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        </div>
    </form>
    <div class="form-actions" style="padding:0 12px 12px;border-top:1px solid var(--border);margin-top:8px;padding-top:12px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">
        <form method="post" action="{{ url('admin.translate.ping') }}">
            {{ csrf_field()|raw }}
            <button class="btn btn--ghost" type="submit">{{ 'translate.action.ping'|trans }}</button>
        </form>
        <span class="muted">{{ 'translate.action.ping_hint'|trans }}</span>
    </div>
    {% if pingResult is defined and pingResult %}
        <p class="field--full" style="padding:0 12px 12px;margin:0">
            {% if pingResult.ok %}
                <strong style="color:var(--success)">{{ pingResult.message }}</strong>
            {% else %}
                <strong style="color:var(--danger, #b42318)">{{ pingResult.message }}</strong>
            {% endif %}
            {% if pingResult.details is defined and pingResult.details %}
                <br><span class="muted" style="font-size:12px">{{ pingResult.details|json_encode }}</span>
            {% endif %}
        </p>
    {% endif %}
</section>

<section class="panel">
    <header class="panel__head"><h2>{{ 'translate.settings.section.test'|trans }}</h2></header>
    <form method="post" class="form-grid" action="{{ url('admin.translate.test') }}">
        {{ csrf_field()|raw }}
        <label class="field field--full">
            <span>{{ 'translate.settings.sample'|trans }}</span>
            <textarea class="input" name="sample" rows="3" placeholder="{{ 'translate.settings.sample_placeholder'|trans }}">{{ testInput }}</textarea>
        </label>
        {% if testResult %}
            <p class="field--full"><strong>{{ 'translate.settings.result'|trans }}:</strong> {{ testResult }}</p>
        {% endif %}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'translate.action.test'|trans }}</button>
        </div>
    </form>
    <form method="post" action="{{ url('admin.translate.cache.clear') }}" class="form-actions" style="padding:0 12px 12px" data-confirm="{{ 'translate.confirm.clear_cache'|trans }}">
        {{ csrf_field()|raw }}
        <button class="btn btn--ghost" type="submit">{{ 'translate.action.clear_cache'|trans }}</button>
    </form>
</section>

{% if debugLog is defined and debugLog is not empty %}
<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'translate.settings.section.debug'|trans }}</h2>
            <p class="muted">storage/logs/translate.log</p>
        </div>
    </header>
    <pre style="margin:0;padding:12px;max-height:20rem;overflow:auto;font-size:12px;line-height:1.4;background:var(--surface-2);border-top:1px solid var(--border)">{{ debugLog|join("\n") }}</pre>
</section>
{% endif %}
</div>
{% endblock %}
