{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'currency.edit'|trans : 'currency.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'currency.save' } %}

    <form method="post" action="{{ item ? url('admin.currencies.update', {code: item.code()}) : url('admin.currencies.store') }}" data-form="currency.save" x-data="gereqForm"{% if form_errors('currency.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {{ forms().render(item ?? 'Modules\\Currency\\Domain\\Currency', {
            form: 'currency.save',
            cols: 1,
            fieldOptions: item ? { code: { readonly: true } } : {},
            values: item ? {} : { decimal_places: 2, is_active: true, is_default: false }
        }) }}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.currencies.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </form>
{% endblock %}
