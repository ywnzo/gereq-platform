<label class="field">
    <span>{{ 'profile.currency'|trans }}</span>
    <select name="preferred_currency">
        <option value="_default" {{ selected is null ? 'selected' : '' }}>
            {{ 'profile.currency.default'|trans({'%code%': shop_default}) }}
        </option>
        {% for code in currencies %}
            <option value="{{ code }}" {{ selected == code ? 'selected' : '' }}>{{ code }}</option>
        {% endfor %}
    </select>
</label>

{% if can_manage_vat %}
    <label class="field">
        <span class="field__label">{{ 'profile.vat_payer'|trans }}</span>
        <input type="checkbox" name="currency_vat_payer" value="1" {{ vat_payer ? 'checked' : '' }}>
    </label>
    <p class="muted">{{ 'profile.vat_payer.hint'|trans }}</p>
    <label class="field">
        <span>{{ 'profile.vat_rate'|trans }}</span>
        <input type="number" name="currency_vat_rate" value="{{ vat_rate }}" min="0" max="100" step="0.01">
    </label>
{% endif %}
