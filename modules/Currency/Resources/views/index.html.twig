{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="currencies" data-actions-default="1">
    <header class="page-header">
        <div>
            <h1>{{ 'currency.title'|trans }}</h1>
            <p class="muted">{{ 'currency.subtitle'|trans }}</p>
        </div>
        <div class="module-header-actions">
            {% if user.can('currency.manage') %}
                <form method="post" action="{{ url('admin.currencies.rates.sync') }}">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--ghost" type="submit">{{ 'currency.sync_cnb'|trans }}</button>
                </form>
                <a class="btn btn--primary" href="{{ url('admin.currencies.create') }}">{{ icon('plus') }} {{ 'currency.add'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'currency.search'|trans }}">
        </form>
        <div class="toolbar__toggles">
            {% include 'ui/table_actions_toggle.html.twig' %}
        </div>
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'currency.field.code'|trans }}</th>
                    <th>{{ 'currency.field.name'|trans }}</th>
                    <th>{{ 'currency.field.symbol'|trans }}</th>
                    <th>{{ 'currency.field.decimal_places'|trans }}</th>
                    <th>{{ 'currency.field.status'|trans }}</th>
                    <th>{{ 'currency.field.default'|trans }}</th>
                    <th class="table__actions-head" x-show="showActions" x-cloak></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td><strong>{{ item.code() }}</strong></td>
                        <td>{{ item.name() }}</td>
                        <td>{{ item.symbol() }}</td>
                        <td>{{ item.decimalPlaces() }}</td>
                        <td>
                            <span class="badge badge--{{ item.isActive() ? 'ok' : 'muted' }}">
                                {{ item.isActive() ? 'currency.active'|trans : 'currency.inactive'|trans }}
                            </span>
                        </td>
                        <td>
                            {% if item.isDefault() %}
                                <span class="badge badge--warn">{{ 'currency.default_badge'|trans }}</span>
                            {% elseif user.can('currency.manage') %}
                                <form method="post" action="{{ url('admin.currencies.default', {code: item.code()}) }}">
                                    {{ csrf_field()|raw }}
                                    <button class="btn btn--ghost" type="submit">{{ 'currency.set_default'|trans }}</button>
                                </form>
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('currency.manage') %}
                                    <a href="{{ url('admin.currencies.edit', {code: item.code()}) }}">{{ 'common.edit'|trans }}</a>
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">
                            <div class="empty">
                                <h2>{{ 'currency.empty'|trans }}</h2>
                                <p>{{ 'currency.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<section class="hook-section">
    <header class="page-header page-header--compact">
        <h2>{{ 'currency.rates.title'|trans }}</h2>
    </header>
    {% if rates is empty %}
        <div class="empty">
            <h2>{{ 'currency.rates.empty'|trans }}</h2>
            <p>{{ 'currency.rates.empty.hint'|trans }}</p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'currency.rates.pair'|trans }}</th>
                        <th>{{ 'currency.rates.rate'|trans }}</th>
                        <th>{{ 'currency.rates.provider'|trans }}</th>
                        <th>{{ 'currency.rates.valid_at'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rate in rates %}
                        <tr>
                            <td><strong>{{ rate.base }}/{{ rate.quote }}</strong></td>
                            <td><code>{{ rate.rate }}</code></td>
                            <td><span class="badge">{{ rate.provider }}</span></td>
                            <td class="muted">{{ rate.valid_at }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}
