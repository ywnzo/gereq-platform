{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'media.upload'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'media.upload' } %}

    <form method="post" class="form-grid" action="{{ url('admin.media.store') }}" enctype="multipart/form-data" data-form="media.upload" x-data="gereqForm"{% if form_errors('media.upload') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {% include 'ui/input.html.twig' with {
            name: 'title',
            label: 'media.field.title'|trans,
            optional: true,
            form: 'media.upload',
            value: '',
            hint: 'media.field.title.hint'|trans
        } %}
        {% include 'ui/input.html.twig' with {
            name: 'alt',
            label: 'media.field.alt'|trans,
            optional: true,
            form: 'media.upload',
            value: ''
        } %}
        {% include 'ui/select.html.twig' with {
            name: 'folder_id',
            label: 'media.field.folder'|trans,
            optional: true,
            form: 'media.upload',
            value: folder|default(''),
            options: folderOptions,
            searchable: true
        } %}
        {% include 'ui/file.html.twig' with {
            name: 'file',
            label: 'media.field.file'|trans,
            hint: 'media.field.file.hint'|trans,
            extra: 'field--full'
        } %}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'media.upload'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.media.index', folder ? {folder: folder} : {}) }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </form>
{% endblock %}
