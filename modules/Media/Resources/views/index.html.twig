{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'media.title'|trans }}</h1>
        {% if user.can('media.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.media.upload') }}">{{ icon('plus') }} {{ 'media.upload'|trans }}</a>
        {% endif %}
    </header>

    <form class="toolbar" method="get">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'media.search'|trans }}">
        <select class="input" name="mime" onchange="this.form.submit()">
            <option value="">{{ 'media.filter.mime_all'|trans }}</option>
            <option value="image/*" {{ mime == 'image/*' ? 'selected' : '' }}>{{ 'media.filter.images'|trans }}</option>
            <option value="video/*" {{ mime == 'video/*' ? 'selected' : '' }}>{{ 'media.filter.videos'|trans }}</option>
            <option value="application/pdf" {{ mime == 'application/pdf' ? 'selected' : '' }}>PDF</option>
        </select>
    </form>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'media.field.preview'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'media.field.title'|trans, column: 'title', query: { mime: mime } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'media.field.mime'|trans, column: 'mime', query: { mime: mime } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'media.field.size'|trans, column: 'size', query: { mime: mime }, class: 'is-num' } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'media.field.created'|trans, column: 'createdAt', query: { mime: mime } } %}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {% if item.isImage() %}
                                <img src="{{ url('admin.media.file', {id: item.id()}) }}" alt="{{ item.alt()|default(item.title()) }}" width="48" height="48" style="object-fit:cover;border-radius:4px;">
                            {% else %}
                                <span class="badge">{{ item.mime() }}</span>
                            {% endif %}
                        </td>
                        <td><a href="{{ url('admin.media.show', {id: item.id()}) }}">{{ item.title() }}</a></td>
                        <td><span class="badge">{{ item.mime() }}</span></td>
                        <td class="is-num is-mute">{{ (item.size() / 1024)|number_format(1, ',', ' ') }} KB</td>
                        <td class="is-mute">{{ item.createdAt().format('d. m. Y H:i') }}</td>
                        <td class="table__actions" x-data="rowMenu" @click.outside="close">
                            <button type="button" class="icon-btn" x-ref="button" @click="toggle" aria-haspopup="menu" :aria-expanded="open">{{ icon('dots') }}</button>
                            <div class="flyout flyout--right" x-ref="menu" :class="menuClass" :style="menuStyle" role="menu">
                                <a href="{{ url('admin.media.show', {id: item.id()}) }}">{{ 'common.detail'|trans }}</a>
                                {% if user.can('media.manage') %}
                                    <a href="{{ url('admin.media.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                                    <form method="post" action="{{ url('admin.media.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'media.confirm_delete'|trans|e('js') }}');">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'media.empty'|trans }}</h2>
                                <p>{{ 'media.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
{% endblock %}
