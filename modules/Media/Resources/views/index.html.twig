{% extends 'admin/layout.html.twig' %}

{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set filterQuery = { mime: mime, folder: folder } %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="media"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'media.bulk.confirm_delete'|trans|e('html_attr') }}"
>
    <header class="page-header">
        <div>
            <h1>{{ currentFolder ? currentFolder.name() : ('media.title'|trans) }}</h1>
        </div>
        <div class="actions">
            {% if user.can('media.manage') %}
                <a class="btn btn--ghost" href="{{ url('admin.media.folders.create', folder ? {folder: folder} : {}) }}">{{ icon('folder') }} {{ 'media.folder.create'|trans }}</a>
                <a class="btn btn--primary" href="{{ url('admin.media.upload', folder ? {folder: folder} : {}) }}">{{ icon('plus') }} {{ 'media.upload'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
            {% if folder %}<input type="hidden" name="folder" value="{{ folder }}">{% endif %}
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'media.search'|trans }}">
            <select class="input" name="mime" onchange="this.form.submit()">
                <option value="">{{ 'media.filter.mime_all'|trans }}</option>
                <option value="image/*" {{ mime == 'image/*' ? 'selected' : '' }}>{{ 'media.filter.images'|trans }}</option>
                <option value="video/*" {{ mime == 'video/*' ? 'selected' : '' }}>{{ 'media.filter.videos'|trans }}</option>
                <option value="application/pdf" {{ mime == 'application/pdf' ? 'selected' : '' }}>PDF</option>
            </select>
        </form>
    </div>

    {% if user.can('media.manage') and items is not empty %}
        <form
            class="bulk-bar"
            method="post"
            action="{{ url('admin.media.bulk') }}"
            x-show="selectedCount > 0"
            x-cloak
            @submit="confirmBulk"
        >
            {{ csrf_field()|raw }}
            <input type="hidden" name="confirmed" value="1">
            {% if folder %}<input type="hidden" name="folder" value="{{ folder }}">{% endif %}
            <template x-for="id in selected" :key="id">
                <input type="hidden" name="ids[]" :value="id">
            </template>
            <div class="bulk-bar__meta">
                <strong x-text="selectedCount"></strong>
                <span>{{ 'media.bulk.selected'|trans }}</span>
                <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'media.bulk.clear'|trans }}</button>
            </div>
            <div class="bulk-bar__actions">
                <select class="input" name="action" x-model="bulkAction" required>
                    <option value="">{{ 'media.bulk.choose'|trans }}</option>
                    <option value="move">{{ 'media.bulk.action.move'|trans }}</option>
                    <option value="delete">{{ 'media.bulk.action.delete'|trans }}</option>
                </select>
                <select class="input" name="folder_id" x-show="bulkAction === 'move'" x-cloak>
                    {% for opt in folderOptions %}
                        <option value="{{ opt.value }}" {{ opt.value == folder ? 'selected' : '' }}>{{ opt.label }}</option>
                    {% endfor %}
                </select>
                <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'media.bulk.apply'|trans }}</button>
            </div>
        </form>
    {% endif %}

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% if user.can('media.manage') %}
                        <th class="table__check">
                            <label class="table-check">
                                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected" {{ items is empty ? 'disabled' : '' }}>
                                <span class="sr-only">{{ 'media.bulk.select_all'|trans }}</span>
                            </label>
                        </th>
                    {% endif %}
                    <th>{{ 'media.field.preview'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'media.field.title'|trans, column: 'title', query: filterQuery } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'media.field.mime'|trans, column: 'mime', query: filterQuery } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'media.field.size'|trans, column: 'size', query: filterQuery, class: 'is-num' } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'media.field.created'|trans, column: 'createdAt', query: filterQuery } %}
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for folderRow in folders %}
                    <tr>
                        {% if user.can('media.manage') %}
                            <td class="table__check"></td>
                        {% endif %}
                        <td>
                            <span class="table-thumb" style="align-items:center;justify-content:center;" aria-hidden="true">{{ icon('folder') }}</span>
                        </td>
                        <td>
                            <a href="{{ url('admin.media.index', {folder: folderRow.id()}) }}"><strong>{{ folderRow.name() }}</strong></a>
                        </td>
                        <td><span class="badge">{{ 'media.folder.badge'|trans }}</span></td>
                        <td class="is-num is-mute">—</td>
                        <td class="is-mute">{{ folderRow.createdAt().format('d. m. Y H:i') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('media.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.media.folders.edit', {id: folderRow.id()}), label: 'media.folder.rename'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.media.folders.move', {id: folderRow.id()}), label: 'media.folder.move'|trans, icon: 'move' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.media.folders.destroy', {id: folderRow.id()}), confirm: 'media.folder.confirm_delete'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% endfor %}

                {% for item in items %}
                    <tr :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
                        {% if user.can('media.manage') %}
                            <td class="table__check">
                                <label class="table-check">
                                    <input
                                        type="checkbox"
                                        value="{{ item.id() }}"
                                        @change="toggleId('{{ item.id() }}')"
                                        :checked="isSelected('{{ item.id() }}')"
                                    >
                                    <span class="sr-only">{{ item.title() }}</span>
                                </label>
                            </td>
                        {% endif %}
                        <td>
                            {% if item.isImage() %}
                                <img src="{{ url('admin.media.file', {id: item.id()}) }}" alt="{{ item.alt()|default(item.title()) }}" width="48" height="48" style="object-fit:cover;border-radius:var(--radius);">
                            {% else %}
                                <span class="badge">{{ item.mime() }}</span>
                            {% endif %}
                        </td>
                        <td><a href="{{ url('admin.media.show', {id: item.id()}) }}">{{ item.title() }}</a></td>
                        <td><span class="badge">{{ item.mime() }}</span></td>
                        <td class="is-num is-mute">{{ (item.size() / 1024)|number_format(1, ',', ' ') }} KB</td>
                        <td class="is-mute">{{ item.createdAt().format('d. m. Y H:i') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with { href: url('admin.media.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                                {% if user.can('media.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.media.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.media.move', {id: item.id()}), label: 'media.move'|trans, icon: 'move' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.media.destroy', {id: item.id()}), confirm: 'media.confirm_delete'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    {% if folders is empty %}
                        <tr>
                            <td colspan="{{ user.can('media.manage') ? 7 : 6 }}">
                                <div class="empty">
                                    <h2>{{ 'media.empty'|trans }}</h2>
                                    <p>{{ 'media.empty.hint'|trans }}</p>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
