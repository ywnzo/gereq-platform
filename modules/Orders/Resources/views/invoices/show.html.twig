{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <p class="eyebrow"><a href="{{ url('admin.invoices.index') }}">{{ 'nav.invoices'|trans }}</a></p>
        <h1>{{ item.number() }}</h1>
        <p class="muted">
            {% if order %}<a href="{{ url('admin.orders.show', {id: order.id()}) }}">{{ order.number() }}</a> · {% endif %}
            <span class="status-chip"><span class="status-chip__dot"></span>{{ item.statusLabel()|trans }}</span>
        </p>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.invoices.pdf', {id: item.id()}) }}" target="_blank">{{ icon('receipt') }} PDF</a>
        {% if user.can('invoices.manage') and item.status() == 'draft' %}
            <form method="post" action="{{ url('admin.invoices.issue', {id: item.id()}) }}" class="actions">
                {{ csrf_field()|raw }}
                <input type="date" name="due_at" class="input" value="{{ 'now'|date_modify('+14 days')|date('Y-m-d') }}">
                <button class="btn btn--primary" type="submit">{{ 'orders.action.issue'|trans }}</button>
            </form>
        {% endif %}
        {% if item.paymentReference() %}
            <button type="button" class="btn btn--ghost" onclick="navigator.clipboard.writeText({{ item.paymentReference()|json_encode|e('html_attr') }})">VS {{ item.paymentReference() }}</button>
        {% endif %}
    </div>
</header>

<div class="detail-hub" x-data="gereqTabs" data-initial="overview">
    <div class="design-tabs detail-tabs" role="tablist">
        <button type="button" class="design-tab" role="tab" data-tab="overview">{{ 'common.overview'|trans }}</button>
        <button type="button" class="design-tab" role="tab" data-tab="parties">{{ 'orders.tab.parties'|trans|default('Strany') }}</button>
        <button type="button" class="design-tab" role="tab" data-tab="payments">{{ 'orders.payments.title'|trans }}{% if payments %}<span class="module-tab-count">{{ payments|length }}</span>{% endif %}</button>
    </div>

    <section class="design-panel" data-panel="overview" role="tabpanel">
        <section class="panel">
            <header class="panel__head"><h2>{{ 'common.overview'|trans }}</h2></header>
            <div class="meta-grid">
                <div class="meta-tile"><span>{{ 'orders.field.status'|trans }}</span><strong>{{ item.statusLabel()|trans }}</strong></div>
                <div class="meta-tile"><span>{{ 'orders.field.total'|trans }}</span><strong>{{ item.total() }} {{ item.currency() }}</strong></div>
                <div class="meta-tile"><span>{{ 'orders.field.issued_at'|trans }}</span><strong>{{ item.issuedAt() ? item.issuedAt().format('d. m. Y') : '—' }}</strong></div>
                <div class="meta-tile"><span>{{ 'orders.field.due_at'|trans }}</span><strong>{{ item.dueAt() ? item.dueAt().format('d. m. Y') : '—' }}</strong></div>
                <div class="meta-tile"><span>{{ 'orders.field.vs'|trans|default('VS') }}</span><strong>{{ item.paymentReference() ?: '—' }}</strong></div>
            </div>
            {% if item.spaydPayload() %}
                <p class="muted" style="margin:12px 14px 0;word-break:break-all">SPAYD: <code>{{ item.spaydPayload() }}</code></p>
            {% endif %}
        </section>
    </section>

    <section class="design-panel" data-panel="parties" role="tabpanel">
        <div class="detail-stack">
            <section class="panel">
                <header class="panel__head"><h2>{{ 'orders.field.seller'|trans|default('Dodavatel') }}</h2></header>
                <div class="meta-grid">
                    {% set seller = item.seller() %}
                    <div class="meta-tile"><span>{{ 'common.name'|trans|default('Název') }}</span><strong>{{ seller.name|default('—') }}</strong></div>
                    <div class="meta-tile"><span>IČO</span><strong>{{ seller.ico|default('—') }}</strong></div>
                    <div class="meta-tile"><span>DIČ</span><strong>{{ seller.dic|default('—') }}</strong></div>
                    <div class="meta-tile"><span>{{ 'common.address'|trans|default('Adresa') }}</span><strong>{{ seller.address|default('—') }}</strong></div>
                </div>
            </section>
            <section class="panel">
                <header class="panel__head"><h2>{{ 'orders.field.buyer'|trans|default('Odběratel') }}</h2></header>
                <div class="meta-grid">
                    {% set buyer = item.buyer() %}
                    <div class="meta-tile"><span>{{ 'common.name'|trans|default('Název') }}</span><strong>{{ buyer.name|default('—') }}</strong></div>
                    <div class="meta-tile"><span>{{ 'customers.field.email'|trans }}</span><strong>{{ buyer.email|default('—') }}</strong></div>
                    <div class="meta-tile"><span>IČO</span><strong>{{ buyer.ico|default('—') }}</strong></div>
                    <div class="meta-tile"><span>{{ 'common.address'|trans|default('Adresa') }}</span><strong>{{ buyer.address|default('—') }}</strong></div>
                </div>
            </section>
        </div>
    </section>

    <section class="design-panel" data-panel="payments" role="tabpanel">
        <div class="detail-stack">
            {% if user.can('invoices.manage') and item.status() in ['issued','paid'] %}
            <section class="panel">
                <header class="panel__head"><h2>{{ 'orders.payment.new'|trans }}</h2></header>
                <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.invoices.pay', {id: item.id()}) }}" data-form="orders.payment.save">
                {{ csrf_field()|raw }}
                {% include 'ui/input.html.twig' with { name: 'amount', label: 'orders.field.amount'|trans, required: true, form: 'orders.payment.save', value: item.total() } %}
                {% include 'ui/input.html.twig' with { name: 'method', label: 'orders.field.method'|trans, required: true, form: 'orders.payment.save', value: 'bank' } %}
                <div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'orders.payment.record'|trans }}</button></div>
                </form>
            </section>
            {% endif %}
            <section class="panel">
                <header class="panel__head"><h2>{{ 'orders.payments.title'|trans }}</h2></header>
                {% if payments is empty %}
                    <div class="empty"><p>{{ 'orders.payments.empty'|trans|default('Žádné úhrady.') }}</p></div>
                {% else %}
                    <ul class="activity">
                        {% for p in payments %}
                            <li>
                                <div class="activity__body">
                                    <span class="activity__dot"></span>
                                    <div><strong>{{ p.amount() }}</strong><span class="muted">{{ p.method() }}</span></div>
                                </div>
                                <time class="muted">{{ p.paidAt().format('d. m. Y') }}</time>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        </div>
    </section>
</div>
{% endblock %}
