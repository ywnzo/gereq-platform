{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header"><h1>{{ item ? 'orders.edit'|trans : 'orders.new'|trans }}</h1></header>
{% include 'ui/error-summary.html.twig' with { form: 'orders.save' } %}
<form method="post" class="form-grid" action="{{ item ? url('admin.orders.update', {id: item.id()}) : url('admin.orders.store') }}" data-form="orders.save" x-data="gereqForm"{% if form_errors('orders.save') %} data-server-state="1"{% endif %}>
{{ csrf_field()|raw }}
{% include 'ui/select.html.twig' with { name: 'customer_id', label: 'orders.field.customer'|trans, required: true, form: 'orders.save', value: item ? item.customerId() : customerId, options: customerOptions } %}
{% include 'ui/input.html.twig' with { name: 'currency', label: 'orders.field.currency'|trans, optional: true, form: 'orders.save', value: item ? item.currency() : currency_code() } %}
{% include 'ui/textarea.html.twig' with { name: 'note', label: 'orders.field.note'|trans, optional: true, extra: 'field--full', form: 'orders.save', value: item ? item.note() : '' } %}
<div class="form-actions">
<button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
<a class="btn btn--ghost" href="{{ url('admin.orders.index') }}">{{ 'common.cancel'|trans }}</a>
</div>
</form>
{% endblock %}
