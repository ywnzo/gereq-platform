{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set orderSource = item ?? 'Modules\\Orders\\Domain\\Order' %}

<header class="page-header"><h1>{{ item ? 'orders.edit'|trans : 'orders.new'|trans }}</h1></header>
{% include 'ui/error-summary.html.twig' with { form: 'orders.save' } %}
<form method="post" class="detail-stack" action="{{ item ? url('admin.orders.update', {id: item.id()}) : url('admin.orders.store') }}" data-form="orders.save" x-data="gereqForm"{% if form_errors('orders.save') %} data-server-state="1"{% endif %}>
{{ csrf_field()|raw }}
<section class="panel">
    <header class="panel__head">
        <h2>{{ 'common.details'|trans }}</h2>
    </header>
    {{ forms().render(orderSource, {
        form: 'orders.save',
        cols: 2,
        values: item ? {} : { customer_id: customerId, currency: currency_code() },
        choices: { customer_id: customerOptions }
    }) }}
</section>
<div class="form-actions">
<button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
<a class="btn btn--ghost" href="{{ url('admin.orders.index') }}">{{ 'common.cancel'|trans }}</a>
</div>
</form>
{% endblock %}
