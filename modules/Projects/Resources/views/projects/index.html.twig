{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="projects" data-actions-default="1">
<header class="page-header"><h1>{{ 'projects.title'|trans }}</h1>
{% if user.can('projects.manage') %}<a class="btn btn--primary" href="{{ url('admin.projects.create') }}">{{ icon('plus') }} {{ 'projects.new'|trans }}</a>{% endif %}
</header>
<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'projects.search'|trans }}">
        <select name="status" class="input" onchange="this.form.submit()"><option value="">{{ 'projects.all_statuses'|trans }}</option>
        {% for s in statuses %}<option value="{{ s }}" {{ status==s?'selected':'' }}>{{ ('projects.status.'~s)|trans }}</option>{% endfor %}
        </select>
    </form>
</div>
<div class="table-wrap" data-table><table class="table"><thead><tr>
{% include 'ui/sort_th.html.twig' with { label: 'projects.field.name'|trans, column: 'name', query: { status: status } } %}
<th>{{ 'projects.field.customer'|trans }}</th>
{% include 'ui/sort_th.html.twig' with { label: 'projects.field.status'|trans, column: 'status', query: { status: status } } %}
{% include 'ui/sort_th.html.twig' with { label: 'projects.field.due'|trans, column: 'dueAt', query: { status: status } } %}
<th class="table__actions-head"></th>
</tr></thead>
<tbody>{% for item in items %}
<tr><td><a href="{{ url('admin.projects.show',{id:item.id()}) }}">{{ item.name() }}</a></td>
<td>{% set c=customers[item.customerId()]|default(null) %}{{ c?c.name():'—' }}</td>
<td><span class="badge">{{ item.statusLabel()|trans }}</span></td>
<td class="is-mute">{{ item.dueAt()?item.dueAt().format('d. m. Y'):'—' }}</td>
{% embed 'ui/row_actions.html.twig' %}
    {% block items %}
        {% include 'ui/row_action.html.twig' with { href: url('admin.projects.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
    {% endblock %}
{% endembed %}
</tr>
{% else %}<tr><td colspan="5"><div class="empty"><h2>{{ 'projects.empty'|trans }}</h2></div></td></tr>{% endfor %}
</tbody></table></div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
