{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set projectSource = item ?? 'Modules\\Projects\\Domain\\Project' %}
{% set formValues = item ? {
    start_at: item.startAt() ? item.startAt().format('Y-m-d') : '',
    due_at: item.dueAt() ? item.dueAt().format('Y-m-d') : ''
} : { customer_id: customerId } %}

<header class="page-header"><h1>{{ item ? 'projects.edit'|trans : 'projects.new'|trans }}</h1></header>
{% include 'ui/error-summary.html.twig' with { form: 'projects.save' } %}
<form method="post" class="detail-stack" action="{{ item ? url('admin.projects.update',{id:item.id()}) : url('admin.projects.store') }}" data-form="projects.save" x-data="gereqForm">
{{ csrf_field()|raw }}
<section class="panel">
    <header class="panel__head">
        <h2>{{ 'common.details'|trans }}</h2>
    </header>
    {{ forms().render(projectSource, {
        form: 'projects.save',
        cols: 2,
        values: formValues,
        choices: {
            customer_id: customerOptions,
            owner_user_id: userOptions
        }
    }) }}
</section>
<div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
<a class="btn btn--ghost" href="{{ url('admin.projects.index') }}">{{ 'common.cancel'|trans }}</a></div>
</form>
{% endblock %}
