{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header"><h1>{{ item ? 'projects.edit'|trans : 'projects.new'|trans }}</h1></header>
{% include 'ui/error-summary.html.twig' with { form: 'projects.save' } %}
<form method="post" class="form-grid" action="{{ item ? url('admin.projects.update',{id:item.id()}) : url('admin.projects.store') }}" data-form="projects.save" x-data="gereqForm">
{{ csrf_field()|raw }}
{% include 'ui/select.html.twig' with { name:'customer_id', label:'projects.field.customer'|trans, required:true, form:'projects.save', value: item?item.customerId():customerId, options:customerOptions } %}
{% include 'ui/input.html.twig' with { name:'name', label:'projects.field.name'|trans, required:true, form:'projects.save', value: item?item.name():'' } %}
{% include 'ui/select.html.twig' with { name:'status', label:'projects.field.status'|trans, form:'projects.save', value: item?item.status():'planning', options:[
{value:'planning',label:'projects.status.planning'|trans},{value:'active',label:'projects.status.active'|trans},{value:'done',label:'projects.status.done'|trans},{value:'cancelled',label:'projects.status.cancelled'|trans}
] } %}
{% include 'ui/input.html.twig' with { name:'start_at', type:'date', label:'projects.field.start'|trans, optional:true, form:'projects.save', value: item and item.startAt()?item.startAt().format('Y-m-d'):'' } %}
{% include 'ui/input.html.twig' with { name:'due_at', type:'date', label:'projects.field.due'|trans, optional:true, form:'projects.save', value: item and item.dueAt()?item.dueAt().format('Y-m-d'):'' } %}
{% include 'ui/select.html.twig' with { name:'owner_user_id', label:'projects.field.owner'|trans, optional:true, form:'projects.save', value: item?item.ownerUserId():'', options:userOptions } %}
{% include 'ui/input.html.twig' with { name:'deal_id', label:'projects.field.deal'|trans, optional:true, form:'projects.save', value: item?item.dealId():'' } %}
<div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
<a class="btn btn--ghost" href="{{ url('admin.projects.index') }}">{{ 'common.cancel'|trans }}</a></div>
</form>
{% endblock %}