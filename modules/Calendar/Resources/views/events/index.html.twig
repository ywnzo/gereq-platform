{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.calendar'|trans },
    ] } %}
{% endblock %}

{% block content %}
<div
    class="cal-shell list-shell"
    x-data="gereqCalendar"
    data-feed-url="{{ feedUrl }}"
    data-move-url="{{ moveUrl }}"
    data-create-url="{{ createUrl }}"
    data-can-manage="{{ canManage ? '1' : '0' }}"
    data-view="{{ view }}"
    data-anchor="{{ anchor|date('Y-m-d') }}"
>
    <header class="page-header cal-header">
        <div>
            <h1>{{ 'calendar.title'|trans }}</h1>
            <p class="muted" x-text="title"></p>
        </div>
        <div class="actions cal-toolbar">
            <div class="cal-nav" role="group" aria-label="{{ 'calendar.nav'|trans }}">
                <button type="button" class="btn btn--ghost" @click="prev" title="{{ 'common.previous'|trans }}">{{ icon('chevron-left') }}</button>
                <button type="button" class="btn btn--ghost" @click="today">{{ 'calendar.today'|trans }}</button>
                <button type="button" class="btn btn--ghost" @click="next" title="{{ 'common.next'|trans }}">{{ icon('chevron-right') }}</button>
            </div>
            <div class="cal-views" role="group" aria-label="{{ 'calendar.views'|trans }}">
                <button type="button" class="btn" :class="viewClass('month')" @click="setView('month')">{{ 'calendar.view.month'|trans }}</button>
                <button type="button" class="btn" :class="viewClass('week')" @click="setView('week')">{{ 'calendar.view.week'|trans }}</button>
                <button type="button" class="btn" :class="viewClass('day')" @click="setView('day')">{{ 'calendar.view.day'|trans }}</button>
                <button type="button" class="btn" :class="viewClass('agenda')" @click="setView('agenda')">{{ 'calendar.view.agenda'|trans }}</button>
            </div>
            <a class="btn btn--ghost" href="{{ url('admin.calendar.ics') }}">{{ icon('download') }} {{ 'calendar.export_ics'|trans }}</a>
            {% if canManage %}
                <a class="btn btn--ghost" href="{{ url('admin.calendar.connections') }}">{{ icon('link') }} {{ 'calendar.connections.short'|trans }}</a>
                <a class="btn btn--primary" href="{{ url('admin.calendar.create') }}">{{ icon('plus') }} {{ 'calendar.new'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="cal-board" :class="boardClass()">
        <div class="cal-loading" x-show="loading" x-cloak>{{ 'calendar.loading'|trans }}</div>

        {# MONTH #}
        <div class="cal-month" x-show="isView('month')" x-cloak>
            <div class="cal-month__head">
                <template x-for="d in dow" :key="d"><div class="cal-month__dow" x-text="d"></div></template>
            </div>
            <div class="cal-month__grid">
                <template x-for="cell in monthCells" :key="cell.date">
                    <div
                        class="cal-month__cell"
                        :class="cellOutClass(cell) + ' ' + cellTodayClass(cell) + ' ' + dayDropClass(cell.date)"
                        @dblclick="createAt(cell.date)"
                        @dragover="onDragOverDay($event, cell.date)"
                        @dragleave="onDragLeave"
                        @drop="onDropDay($event, cell.date)"
                    >
                        <button type="button" class="cal-month__day" @click="openDay(cell.date)" x-text="cell.label"></button>
                        <div class="cal-month__events">
                            <template x-for="ev in cell.preview" :key="ev.id">
                                <button
                                    type="button"
                                    class="cal-event cal-event--chip"
                                    :class="eventStyle(ev) + ' ' + eventDragClass(ev)"
                                    :draggable="canDrag()"
                                    @dragstart="onDragStart($event, ev)"
                                    @dragend="onDragEnd"
                                    @click.stop="openEvent(ev)"
                                    x-text="ev.title"
                                ></button>
                            </template>
                            <button
                                type="button"
                                class="cal-more"
                                x-show="cell.more"
                                @click="openDay(cell.date)"
                                x-text="moreLabel(cell.more)"
                            ></button>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        {# WEEK #}
        <div class="cal-week" x-show="isView('week')" x-cloak>
            <div class="cal-week__head">
                <div class="cal-week__gutter"></div>
                <template x-for="day in weekDays" :key="day.date">
                    <div class="cal-week__dayhead" :class="cellTodayClass(day)">
                        <span x-text="dowLabel(day.date)"></span>
                        <strong x-text="day.label"></strong>
                    </div>
                </template>
            </div>
            <div class="cal-week__body">
                <template x-for="hour in hours" :key="hour">
                    <div class="cal-week__row">
                        <div class="cal-week__gutter" x-text="hourLabel(hour)"></div>
                        <template x-for="day in weekDays" :key="day.date + '-' + hour">
                            <div
                                class="cal-week__slot"
                                :class="slotDropClass(day.date, hour)"
                                @dblclick="createAt(day.date, hour)"
                                @dragover="onDragOverSlot($event, day.date, hour)"
                                @dragleave="onDragLeave"
                                @drop="onDropSlot($event, day.date, hour)"
                            >
                                <template x-for="ev in hourEvents(day, hour)" :key="ev.id">
                                    <button
                                        type="button"
                                        class="cal-event"
                                        :class="eventStyle(ev) + ' ' + eventDragClass(ev)"
                                        :draggable="canDrag()"
                                        @dragstart="onDragStart($event, ev)"
                                        @dragend="onDragEnd"
                                        @click="openEvent(ev)"
                                    >
                                        <span x-text="timeLabel(ev.starts_at)"></span>
                                        <strong x-text="ev.title"></strong>
                                    </button>
                                </template>
                            </div>
                        </template>
                    </div>
                </template>
            </div>
        </div>

        {# DAY #}
        <div class="cal-day" x-show="isView('day')" x-cloak>
            <template x-for="hour in hours" :key="'d'+hour">
                <div class="cal-day__row">
                    <div class="cal-week__gutter" x-text="hourLabel(hour)"></div>
                    <div
                        class="cal-day__slot"
                        :class="slotDropClass(dateKey(anchor), hour)"
                        @dblclick="createAt(dateKey(anchor), hour)"
                        @dragover="onDragOverSlot($event, dateKey(anchor), hour)"
                        @dragleave="onDragLeave"
                        @drop="onDropSlot($event, dateKey(anchor), hour)"
                    >
                        <template x-for="ev in dayHourEvents(hour)" :key="ev.id">
                            <button
                                type="button"
                                class="cal-event cal-event--block"
                                :class="eventStyle(ev) + ' ' + eventDragClass(ev)"
                                :draggable="canDrag()"
                                @dragstart="onDragStart($event, ev)"
                                @dragend="onDragEnd"
                                @click="openEvent(ev)"
                            >
                                <span x-text="eventTimeText(ev)"></span>
                                <strong x-text="ev.title"></strong>
                                <em x-show="hasLocation(ev)" x-text="locationText(ev)"></em>
                            </button>
                        </template>
                    </div>
                </div>
            </template>
        </div>

        {# AGENDA #}
        <div class="cal-agenda" x-show="isView('agenda')" x-cloak>
            <template x-if="agendaEvents.length === 0">
                <div class="empty">
                    <h2>{{ 'calendar.empty'|trans }}</h2>
                    <p>{{ 'calendar.empty.hint'|trans }}</p>
                </div>
            </template>
            <template x-for="ev in agendaEvents" :key="ev.id">
                <button type="button" class="cal-agenda__row" @click="openEvent(ev)">
                    <span class="cal-agenda__dot" :class="eventStyle(ev)"></span>
                    <span class="cal-agenda__when" x-text="agendaWhen(ev)"></span>
                    <strong x-text="ev.title"></strong>
                    <span class="muted" x-text="locationText(ev)"></span>
                    <span class="badge" x-show="ev.is_external">{{ 'calendar.external'|trans }}</span>
                </button>
            </template>
        </div>
    </div>

    {# Event drawer (no popover) #}
    <div
        class="g-drawer g-drawer--wide cal-drawer"
        :class="selected ? 'is-open' : ''"
        :data-open="selected ? 'true' : 'false'"
        @keydown.escape.window="closeEvent"
        role="dialog"
        aria-modal="true"
        :aria-hidden="selected ? 'false' : 'true'"
    >
        <div class="g-drawer__overlay" @click="closeEvent"></div>
        <div class="g-drawer__panel" @click.stop>
            <header class="g-drawer__head">
                <h2 class="g-drawer__title" x-text="selectedTitle()"></h2>
                <button type="button" class="icon-btn g-drawer__close" @click="closeEvent" aria-label="{{ 'ui.drawer.close'|trans }}">{{ icon('close') }}</button>
            </header>
            <div class="g-drawer__body">
                <p class="cal-drawer__when muted" x-text="selectedWhen()"></p>
                <dl class="cal-drawer__meta">
                    <div>
                        <dt>{{ 'calendar.field.type'|trans }}</dt>
                        <dd x-text="selectedType()"></dd>
                    </div>
                    <div>
                        <dt>{{ 'calendar.field.status'|trans }}</dt>
                        <dd x-text="selectedStatus()"></dd>
                    </div>
                    <div x-show="hasSelectedLocation()">
                        <dt>{{ 'calendar.field.location'|trans }}</dt>
                        <dd x-text="selectedLocation()"></dd>
                    </div>
                    <div x-show="hasSelectedTimezone()">
                        <dt>{{ 'calendar.field.timezone'|trans }}</dt>
                        <dd x-text="selectedTimezone()"></dd>
                    </div>
                    <div>
                        <dt>{{ 'calendar.field.color'|trans }}</dt>
                        <dd class="cal-drawer__color">
                            <span class="cal-drawer__swatch" :class="selected ? eventStyle(selected) : ''"></span>
                            <span x-text="selectedColor()"></span>
                        </dd>
                    </div>
                    <div x-show="isSelectedExternal()">
                        <dt>{{ 'calendar.external'|trans }}</dt>
                        <dd x-text="selectedExternal()"></dd>
                    </div>
                </dl>
                <section class="cal-drawer__section" x-show="hasSelectedDescription()">
                    <h3>{{ 'calendar.field.description'|trans }}</h3>
                    <p x-text="selectedDescription()"></p>
                </section>
                <section class="cal-drawer__section" x-show="hasSelectedRrule()">
                    <h3>{{ 'calendar.field.rrule'|trans }}</h3>
                    <code x-text="selectedRrule()"></code>
                </section>
            </div>
            <footer class="g-drawer__foot">
                {% if canManage %}
                    <button type="button" class="btn btn--primary" @click="goEdit">{{ 'common.edit'|trans }}</button>
                    <template x-if="canManage && selected">
                        <button type="button" class="btn btn--ghost" @click="shiftEvent(selected, 1)">{{ 'calendar.shift_day'|trans }}</button>
                    </template>
                {% endif %}
                <button type="button" class="btn btn--ghost" @click="goEvent">{{ 'common.detail'|trans }}</button>
                <button type="button" class="btn btn--ghost" @click="closeEvent">{{ 'common.cancel'|trans }}</button>
            </footer>
        </div>
    </div>
</div>
{% endblock %}
