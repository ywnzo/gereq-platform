{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header"><h1>{{ 'calendar.title'|trans }}</h1>
<div class="actions">
<a class="btn {{ view=='month'?'btn--primary':'btn--ghost' }}" href="?view=month&date={{ anchor|date('Y-m-d') }}">{{ 'calendar.view.month'|trans }}</a>
<a class="btn {{ view=='week'?'btn--primary':'btn--ghost' }}" href="?view=week&date={{ anchor|date('Y-m-d') }}">{{ 'calendar.view.week'|trans }}</a>
{% if user.can('calendar.manage') %}<a class="btn btn--primary" href="{{ url('admin.calendar.create') }}">{{ icon('plus') }} {{ 'calendar.new'|trans }}</a>{% endif %}
</div></header>
<p class="muted">{{ from|date('d. m. Y') }} – {{ to|date_modify('-1 day')|date('d. m. Y') }}</p>
<div class="table-wrap"><table class="table"><thead><tr><th>{{ 'calendar.field.title'|trans }}</th><th>{{ 'calendar.field.type'|trans }}</th><th>{{ 'calendar.field.starts'|trans }}</th><th>{{ 'calendar.field.ends'|trans }}</th><th></th></tr></thead>
<tbody>{% for e in events %}
<tr><td><a href="{{ url('admin.calendar.show',{id:e.id()}) }}">{{ e.title() }}</a></td>
<td>{{ e.typeLabel()|trans }}</td>
<td>{{ e.startsAt().format('d. m. Y H:i') }}</td>
<td>{{ e.endsAt().format('d. m. Y H:i') }}</td>
<td><a href="{{ url('admin.calendar.show',{id:e.id()}) }}">{{ 'common.detail'|trans }}</a></td></tr>
{% else %}<tr><td colspan="5"><div class="empty"><h2>{{ 'calendar.empty'|trans }}</h2><p>{{ 'calendar.empty.hint'|trans }}</p></div></td></tr>{% endfor %}
</tbody></table></div>
{% endblock %}