{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.idoklad'|trans },
    ] } %}
{% endblock %}

{% macro control(field) %}
    {% if field.definition.type == 'boolean' %}
        <select class="input" name="{{ field.field }}">
            <option value="1" {{ field.value ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
            <option value="0" {{ not field.value ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
        </select>
    {% elseif field.secret %}
        <input class="input" type="password" name="{{ field.field }}" value="" autocomplete="new-password" placeholder="{{ field.value ? ('settings.secret.placeholder'|trans) : '' }}">
    {% else %}
        <input class="input" type="text" name="{{ field.field }}" value="{{ field.value }}">
    {% endif %}
{% endmacro %}

{% block content %}
    {% import _self as ui %}

    <header class="page-header">
        <div>
            <h1>{{ 'idoklad.settings.title'|trans }}</h1>
            <p class="muted">{{ 'idoklad.settings.intro'|trans }}</p>
        </div>
        <div class="actions">
            <button class="btn btn--primary" type="submit" form="idoklad-settings-form">{{ 'common.save'|trans }}</button>
        </div>
    </header>

    {% if enabled %}
        <p class="muted">{{ 'idoklad.status.enabled'|trans }}</p>
    {% elseif configured %}
        <p class="muted">{{ 'idoklad.status.configured'|trans }}</p>
    {% else %}
        <p class="muted">{{ 'idoklad.status.missing'|trans }}</p>
    {% endif %}

    <div class="detail-stack">
        <form id="idoklad-settings-form" method="post" action="{{ url('admin.idoklad.settings.update') }}" autocomplete="off">
            {{ csrf_field()|raw }}

            <section class="panel">
                <header class="panel__head">
                    <div>
                        <h2>{{ 'idoklad.settings.section.api'|trans }}</h2>
                        <p class="muted">{{ 'idoklad.settings.section.api_hint'|trans }}</p>
                    </div>
                </header>
                <div class="form-grid">
                    {% for key in sections.api %}
                        {% if fields[key] is defined %}
                            <label class="field">
                                <span>{{ fields[key].definition.label|trans }}</span>
                                {{ ui.control(fields[key]) }}
                            </label>
                        {% endif %}
                    {% endfor %}
                </div>
            </section>
        </form>

        <section class="panel">
            <header class="panel__head">
                <div>
                    <h2>{{ 'idoklad.settings.section.lists'|trans }}</h2>
                    <p class="muted">{{ 'idoklad.settings.section.lists_hint'|trans }}</p>
                </div>
                {% if user.can('idoklad.sync') %}
                    <form method="post" action="{{ url('admin.idoklad.sync') }}">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="list" value="all">
                        <button class="btn btn--primary btn-sm" type="submit" {{ configured ? '' : 'disabled' }}>
                            {{ icon('refresh') }} {{ 'idoklad.action.sync'|trans }}
                        </button>
                    </form>
                {% endif %}
            </header>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'idoklad.lists.col.name'|trans }}</th>
                            <th>{{ 'idoklad.lists.col.items'|trans }}</th>
                            <th>{{ 'idoklad.lists.col.status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for name, count in lists %}
                            <tr>
                                <td>
                                    <strong>{{ ('idoklad.list.' ~ name)|trans }}</strong>
                                    <div class="muted">{{ name }}</div>
                                </td>
                                <td>{{ count }}</td>
                                <td>
                                    {% if count > 0 %}
                                        <span class="badge badge--ok">{{ 'idoklad.lists.status.ready'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge--muted">{{ 'idoklad.lists.status.empty'|trans }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
{% endblock %}
