{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.carservice'|trans, url: url('admin.carservice.index') },
        { label: 'nav.idoklad.documents'|trans },
    ] } %}
{% endblock %}

{% block content %}
<div class="list-shell list-shell--tabs">
    <header class="page-header">
        <div>
            <h1>{{ 'idoklad.documents.title'|trans }}</h1>
            <p class="muted">{{ 'idoklad.documents.intro'|trans }}</p>
        </div>
        <div class="actions">
            {% if user.can('idoklad.view') %}
                <a class="btn btn--ghost" href="{{ url('admin.idoklad.settings') }}">{{ icon('settings') }} {{ 'idoklad.settings.title'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <nav class="design-tabs detail-tabs" role="tablist" aria-label="{{ 'idoklad.documents.types'|trans }}">
        {% for row in types %}
            <a
                class="design-tab {{ type == row.key ? 'is-active' : '' }}"
                role="tab"
                href="{{ url('admin.idoklad.documents') }}?type={{ row.key|url_encode }}{{ search ? '&q=' ~ search|url_encode : '' }}"
                aria-selected="{{ type == row.key ? 'true' : 'false' }}"
                style="text-decoration:none"
            >{{ row.label|trans }}</a>
        {% endfor %}
    </nav>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input type="hidden" name="type" value="{{ type }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'idoklad.documents.search'|trans }}">
            <button class="btn btn--ghost" type="submit">{{ 'common.search'|trans }}</button>
        </form>
    </div>

    {% if error %}
        <section class="panel">
            <p class="muted">{{ error }}</p>
            {% if not enabled and user.can('idoklad.manage') %}
                <p><a class="btn btn--primary" href="{{ url('admin.idoklad.settings') }}">{{ 'idoklad.documents.configure'|trans }}</a></p>
            {% endif %}
        </section>
    {% else %}
        <div class="table-wrap" data-table>
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'idoklad.documents.col.number'|trans }}</th>
                        <th>{{ 'idoklad.documents.col.date'|trans }}</th>
                        <th>{{ 'idoklad.documents.col.partner'|trans }}</th>
                        <th>{{ 'idoklad.documents.col.description'|trans }}</th>
                        <th class="is-num">{{ 'idoklad.documents.col.total'|trans }}</th>
                        <th class="table__actions-head"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td>
                                <a href="{{ url('admin.idoklad.documents.show', { type: type, id: item.id }) }}">{{ item.number }}</a>
                                {% if item.paid %}<span class="badge">{{ 'idoklad.documents.paid'|trans }}</span>{% endif %}
                            </td>
                            <td>{{ item.date ?: '—' }}</td>
                            <td>{{ item.partner ?: '—' }}</td>
                            <td>{{ item.description ?: '—' }}</td>
                            <td class="is-num">{{ item.total }} {{ item.currency }}</td>
                            {% embed 'ui/row_actions.html.twig' %}
                                {% block items %}
                                    {% include 'ui/row_action.html.twig' with {
                                        href: url('admin.idoklad.documents.show', { type: type, id: item.id }),
                                        label: 'common.detail'|trans,
                                        icon: 'eye'
                                    } %}
                                    {% if typeMeta.pdf|default(false) %}
                                        {% include 'ui/row_action.html.twig' with {
                                            href: url('admin.idoklad.documents.pdf', { type: type, id: item.id }),
                                            label: 'PDF',
                                            icon: 'receipt',
                                            target: '_blank'
                                        } %}
                                    {% endif %}
                                {% endblock %}
                            {% endembed %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">
                                <div class="empty">
                                    <h2>{{ 'idoklad.documents.empty'|trans }}</h2>
                                    <p class="muted">{{ 'idoklad.documents.empty_hint'|trans }}</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% include 'ui/table_footer.html.twig' %}
    {% endif %}
</div>
{% endblock %}
