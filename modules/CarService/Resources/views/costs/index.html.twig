{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header"><h1>{{ 'carservice.costs.title'|trans }}</h1></header>
<form method="get" class="toolbar">
    <label class="field"><span>{{ 'carservice.field.month'|trans }}</span>
        <input class="input" type="month" name="month" value="{{ month }}" onchange="this.form.submit()">
    </label>
</form>
<section class="panel">
    <p><strong>{{ 'carservice.costs.total'|trans }}:</strong> {{ total }}</p>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>{{ 'carservice.field.category'|trans }}</th><th>{{ 'carservice.field.amount'|trans }}</th><th>{{ 'carservice.field.note'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.category() }}</td>
                <td>{{ item.amount() }}</td>
                <td>{{ item.note() ?: '—' }}</td>
                <td>{% if user.can('carservice.manage') %}
                    <form method="post" action="{{ url('admin.carservice.costs.destroy',{id:item.id()}) }}" data-confirm="{{ 'carservice.costs.confirm_delete'|trans }}">
                        {{ csrf_field()|raw }}
                        <button type="submit">{{ 'common.delete'|trans }}</button>
                    </form>
                {% endif %}</td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="muted">{{ 'carservice.costs.empty'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
</section>
{% if user.can('carservice.manage') %}
<section class="panel">
    <header class="panel__head"><h2>{{ 'carservice.costs.add'|trans }}</h2></header>
    <form method="post" class="form-grid" action="{{ url('admin.carservice.costs.store') }}" data-form="carservice.cost">
        {{ csrf_field()|raw }}
        {% include 'ui/input.html.twig' with { name:'year_month', label:'carservice.field.month'|trans, required:true, form:'carservice.cost', value:month } %}
        {% include 'ui/input.html.twig' with { name:'category', label:'carservice.field.category'|trans, form:'carservice.cost', value:'general' } %}
        {% include 'ui/input.html.twig' with { name:'amount', label:'carservice.field.amount'|trans, required:true, form:'carservice.cost', value:'' } %}
        {% include 'ui/input.html.twig' with { name:'note', label:'carservice.field.note'|trans, optional:true, form:'carservice.cost', value:'' } %}
        <div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button></div>
    </form>
</section>
{% endif %}
{% endblock %}
