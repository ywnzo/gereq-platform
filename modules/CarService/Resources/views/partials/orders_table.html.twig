{#
  Shared service-order table for vehicle/customer detail sections.
  Expects: orders, user
  Optional: show_vehicle, show_customer, vehicles, customers, create_url
#}
{% set show_vehicle = show_vehicle|default(false) %}
{% set show_customer = show_customer|default(false) %}
{% set vehicles = vehicles|default({}) %}
{% set customers = customers|default({}) %}
{% set create_url = create_url|default(null) %}
{% set col_count = 6 + (show_vehicle ? 1 : 0) + (show_customer ? 1 : 0) %}

{% if orders is empty %}
    <div class="empty cs-orders-empty">
        <span class="material-symbols-outlined g-icon" aria-hidden="true">build</span>
        <p>{{ 'carservice.partial.empty'|trans }}</p>
        {% if create_url and user is defined and user.can('carservice.manage') %}
            <a class="btn btn--ghost" href="{{ create_url }}">{{ 'carservice.partial.add'|trans }}</a>
        {% endif %}
    </div>
{% else %}
    <div class="table-wrap">
        <table class="table table--carservice table--cs-orders">
            <thead>
                <tr>
                    <th>{{ 'carservice.partial.order'|trans }}</th>
                    {% if show_vehicle %}<th>{{ 'carservice.field.vehicle'|trans }}</th>{% endif %}
                    {% if show_customer %}<th>{{ 'carservice.field.customer'|trans }}</th>{% endif %}
                    <th>{{ 'carservice.field.status'|trans }}</th>
                    <th>{{ 'carservice.field.team'|trans }}</th>
                    <th>{{ 'carservice.field.order_date'|trans }}</th>
                    <th>{{ 'carservice.field.handover'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for o in orders %}
                    {% set v = show_vehicle ? vehicles[o.vehicleId()]|default(null) : null %}
                    {% set c = show_customer and o.customerId() ? customers[o.customerId()]|default(null) : null %}
                    {% set orderDate = o.intakeAt() ?: o.createdAt() %}
                    <tr class="cs-row">
                        <td>
                            <a class="cs-row__primary" href="{{ url('admin.carservice.show', {id: o.id()}) }}">
                                <span class="cs-row__plate">#{{ o.id()|slice(0, 8) }}</span>
                                <span class="cs-row__meta">{{ o.typeLabel()|trans }}</span>
                            </a>
                        </td>
                        {% if show_vehicle %}
                            <td>
                                {% if v %}
                                    <a class="cs-row__customer" href="{{ url('admin.fleet.show', {id: v.id()}) }}">
                                        <strong class="cs-row__plate">{{ v.plate() }}</strong>
                                        {% if v.brand() or v.displayModel() %}
                                            <span class="muted"> {{ v.brand() }} {{ v.displayModel() }}</span>
                                        {% endif %}
                                    </a>
                                {% else %}
                                    <span class="muted">—</span>
                                {% endif %}
                            </td>
                        {% endif %}
                        {% if show_customer %}
                            <td>
                                {% if c %}
                                    <a class="cs-row__customer" href="{{ url('admin.customers.show', {id: c.id()}) }}">{{ c.name() }}</a>
                                {% else %}
                                    <span class="muted">—</span>
                                {% endif %}
                            </td>
                        {% endif %}
                        <td>
                            <span class="status-chip status-chip--cs-{{ o.status() }}">
                                <span class="status-chip__dot" aria-hidden="true"></span>
                                {{ o.statusLabel()|trans }}
                            </span>
                        </td>
                        <td>
                            <span class="badge badge--cs-{{ o.team() }}">{{ o.teamLabel()|trans }}</span>
                        </td>
                        <td>
                            <time class="cs-row__when" datetime="{{ orderDate.format('c') }}">{{ orderDate.format('d. m. Y') }}</time>
                        </td>
                        <td>
                            {% if o.handoverAt() %}
                                <time class="cs-row__when" datetime="{{ o.handoverAt().format('c') }}">{{ o.handoverAt().format('d. m. Y') }}</time>
                            {% else %}
                                <span class="muted">—</span>
                            {% endif %}
                        </td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with {
                                    href: url('admin.carservice.show', {id: o.id()}),
                                    label: 'common.detail'|trans,
                                    icon: 'eye'
                                } %}
                                {% if user is defined and user.can('carservice.manage') %}
                                    {% include 'ui/row_action.html.twig' with {
                                        href: url('admin.carservice.edit', {id: o.id()}),
                                        label: 'common.edit'|trans,
                                        icon: 'edit'
                                    } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if create_url and user is defined and user.can('carservice.manage') %}
        <p class="cs-orders-foot muted">
            <a href="{{ create_url }}">{{ icon('plus') }} {{ 'carservice.partial.add'|trans }}</a>
        </p>
    {% endif %}
{% endif %}
