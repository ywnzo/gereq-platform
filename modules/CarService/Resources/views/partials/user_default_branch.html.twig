{# Výchozí pobočka uživatele. Očekává: branchOptions, selectedDefaultBranchId #}
{% if branchOptions is defined and branchOptions is not empty %}
    {% include 'ui/select.html.twig' with {
        name: 'carservice_default_branch_id',
        id: fieldId|default('carservice-default-branch-id'),
        label: 'carservice.user.default_branch'|trans,
        hint: 'carservice.user.default_branch.hint'|trans,
        optional: true,
        form: null,
        value: selectedDefaultBranchId|default(''),
        options: branchOptions,
        searchable: true,
        extra: 'field--full'
    } %}
{% endif %}
