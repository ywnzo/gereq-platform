{# Globální výběr pobočky v topbaru. Očekává: branchOptions, selectedBranchId, selectUrl, redirectUrl #}
<form
    method="post"
    action="{{ selectUrl }}"
    class="topbar-branch"
>
    {{ csrf_field()|raw }}
    <input type="hidden" name="_redirect" value="{{ redirectUrl|default('') }}">
    {% include 'ui/select.html.twig' with {
        name: 'branch_id',
        id: 'topbar-branch-id',
        label: '',
        placeholder: 'carservice.branch_switch.placeholder'|trans,
        form: null,
        value: selectedBranchId|default(''),
        options: branchOptions,
        searchable: true,
        autosubmit: true,
        extra: 'topbar-branch__field'
    } %}
</form>
