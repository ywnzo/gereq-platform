{# Interaktivní checklist protokolu příjmu — očekává: item (ServiceOrder), intakeCatalog, intakeProtocol #}
{% set p = intakeProtocol|default({}) %}
{% set eqOn = p.equipment|default([]) %}
{% set svOn = p.services|default([]) %}
{% set insp = p.inspection|default({}) %}
{% set bodyMarks = p.body|default({}) %}
{% set zonesOn = p.zones|default([]) %}
{% set axFront = p.axles.front|default({}) %}
{% set axRear = p.axles.rear|default({}) %}

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'carservice.intake_protocol.title'|trans }}</h2>
            <p class="muted">{{ 'carservice.intake_protocol.hint'|trans }}</p>
        </div>
    </header>
    <div class="panel__body">
        <form
            method="post"
            action="{{ url('admin.carservice.intake_protocol', {id: item.id()}) }}"
            class="intake-protocol"
            autocomplete="off"
        >
            {{ csrf_field()|raw }}

            <h3 class="intake-protocol__h">{{ 'carservice.intake_protocol.equipment'|trans }}</h3>
            <div class="intake-protocol__checks">
                {% for label in intakeCatalog.equipment %}
                    <label class="intake-protocol__check">
                        <input type="checkbox" name="equipment[]" value="{{ label }}" {{ label in eqOn ? 'checked' : '' }}>
                        <span>{{ label }}</span>
                    </label>
                {% endfor %}
            </div>

            <h3 class="intake-protocol__h">{{ 'carservice.intake_protocol.services'|trans }}</h3>
            <div class="intake-protocol__checks intake-protocol__checks--services">
                {% for label in intakeCatalog.services %}
                    <label class="intake-protocol__check">
                        <input type="checkbox" name="services[]" value="{{ label }}" {{ label in svOn ? 'checked' : '' }}>
                        <span>{{ label }}</span>
                    </label>
                {% endfor %}
            </div>

            <div class="intake-protocol__cols">
                <div>
                    <h3 class="intake-protocol__h">{{ 'carservice.intake_protocol.inspection'|trans }}
                        <span class="muted intake-protocol__hint">{{ 'carservice.intake_protocol.marks_hint'|trans }}</span>
                    </h3>
                    <div class="intake-protocol__marks">
                        {% for label in intakeCatalog.inspection %}
                            <label class="intake-protocol__mark-row">
                                <span>{{ label }}</span>
                                <select name="inspection[{{ label }}]">
                                    <option value="">—</option>
                                    <option value="ok" {{ insp[label]|default('') == 'ok' ? 'selected' : '' }}>○</option>
                                    <option value="todo" {{ insp[label]|default('') == 'todo' ? 'selected' : '' }}>□</option>
                                </select>
                            </label>
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <h3 class="intake-protocol__h">{{ 'carservice.intake_protocol.body'|trans }}</h3>
                    <div class="intake-protocol__marks">
                        {% for label in intakeCatalog.body %}
                            <label class="intake-protocol__mark-row">
                                <span>{{ label }}</span>
                                <select name="body[{{ label }}]">
                                    <option value="">—</option>
                                    <option value="ok" {{ bodyMarks[label]|default('') == 'ok' ? 'selected' : '' }}>○</option>
                                    <option value="todo" {{ bodyMarks[label]|default('') == 'todo' ? 'selected' : '' }}>□</option>
                                </select>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <h3 class="intake-protocol__h">{{ 'carservice.intake_protocol.zones'|trans }}</h3>
            <div class="intake-protocol__zones">
                {% for n, label in intakeCatalog.zones %}
                    <label class="intake-protocol__check">
                        <input type="checkbox" name="zones[]" value="{{ n }}" {{ n in zonesOn ? 'checked' : '' }}>
                        <span>{{ n }} · {{ label }}</span>
                    </label>
                {% endfor %}
            </div>

            <div class="intake-protocol__cols">
                <div>
                    <h3 class="intake-protocol__h">{{ 'carservice.intake_protocol.axle_front'|trans }}</h3>
                    <div class="intake-protocol__marks intake-protocol__marks--axle">
                        {% for key, label in intakeCatalog.axles %}
                            <label class="intake-protocol__mark-row">
                                <span>{{ label }}</span>
                                <select name="axles_front[{{ key }}]">
                                    <option value="">—</option>
                                    <option value="ok" {{ axFront[key]|default('') == 'ok' ? 'selected' : '' }}>○</option>
                                    <option value="todo" {{ axFront[key]|default('') == 'todo' ? 'selected' : '' }}>□</option>
                                </select>
                            </label>
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <h3 class="intake-protocol__h">{{ 'carservice.intake_protocol.axle_rear'|trans }}</h3>
                    <div class="intake-protocol__marks intake-protocol__marks--axle">
                        {% for key, label in intakeCatalog.axles %}
                            <label class="intake-protocol__mark-row">
                                <span>{{ label }}</span>
                                <select name="axles_rear[{{ key }}]">
                                    <option value="">—</option>
                                    <option value="ok" {{ axRear[key]|default('') == 'ok' ? 'selected' : '' }}>○</option>
                                    <option value="todo" {{ axRear[key]|default('') == 'todo' ? 'selected' : '' }}>□</option>
                                </select>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="form-actions" style="margin-top:16px">
                <button class="btn btn--primary" type="submit">{{ 'carservice.intake_protocol.save'|trans }}</button>
            </div>
        </form>
    </div>
</section>
