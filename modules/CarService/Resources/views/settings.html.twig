{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'carservice.settings.title'|trans }}</h1>
        <p class="muted">{{ 'carservice.settings.intro'|trans }}</p>
    </div>
    <div class="actions">
        <button class="btn btn--primary" type="submit" form="carservice-settings-form">{{ 'common.save'|trans }}</button>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'carservice.settings' } %}

<form
    id="carservice-settings-form"
    method="post"
    class="detail-stack"
    action="{{ url('admin.carservice.settings.update') }}"
    data-form="carservice.settings"
    x-data="gereqForm"
    autocomplete="off"
>
    {{ csrf_field()|raw }}

    <section class="panel">
        <header class="panel__head">
            <div>
                <h2>{{ 'carservice.settings.section.general'|trans }}</h2>
                <p class="muted">{{ 'carservice.settings.section.general_hint'|trans }}</p>
            </div>
        </header>
        <div class="form-grid">
            {% include 'ui/input.html.twig' with { name:'job_soft_limit_hours', type:'number', label:'carservice.settings.job_soft_limit'|trans, required:true, form:'carservice.settings', value:jobSoftLimitHours } %}
            {% include 'ui/select.html.twig' with { name:'default_team', label:'carservice.settings.default_team'|trans, form:'carservice.settings', value:defaultTeam, options:[
                {value:'body_shop',label:'carservice.team.body_shop'|trans},
                {value:'paint_shop',label:'carservice.team.paint_shop'|trans}
            ] } %}
            {% include 'ui/input.html.twig' with { name:'media_phases', label:'carservice.settings.media_phases'|trans, required:true, form:'carservice.settings', value:mediaPhases } %}
            {% include 'ui/input.html.twig' with {
                name: 'margin_percent',
                type: 'number',
                label: 'carservice.settings.margin_percent'|trans,
                hint: 'carservice.settings.margin_percent.hint'|trans,
                required: true,
                form: 'carservice.settings',
                value: marginPercent,
                min: 0,
                max: 1000,
                step: '0.01',
                suffix: '%'
            } %}
            <label class="field field--checkbox field--full">
                <input type="checkbox" name="auto_idoklad" value="1" {{ autoIdoklad ? 'checked' : '' }}>
                <span>{{ 'carservice.settings.auto_idoklad'|trans }}</span>
            </label>
        </div>
    </section>

    <section class="panel">
        <header class="panel__head">
            <div>
                <h2>{{ 'carservice.settings.section.labor_rates'|trans }}</h2>
                <p class="muted">{{ 'carservice.settings.section.labor_rates_hint'|trans }}</p>
            </div>
        </header>
        <div class="form-grid">
            {% include 'ui/input.html.twig' with {
                name: 'labor_rate_default',
                type: 'number',
                label: 'carservice.settings.labor_rate_default'|trans,
                hint: 'carservice.settings.labor_rate_default.hint'|trans,
                required: true,
                form: 'carservice.settings',
                value: laborRates.labor_rate_default,
                min: 0,
                step: '0.01',
                suffix: laborRateSuffix
            } %}
            {% include 'ui/input.html.twig' with {
                name: 'labor_rate_body_shop',
                type: 'number',
                label: 'carservice.settings.labor_rate_body_shop'|trans,
                hint: 'carservice.settings.labor_rate_team.hint'|trans,
                optional: true,
                form: 'carservice.settings',
                value: laborRates.labor_rate_body_shop,
                min: 0,
                step: '0.01',
                suffix: laborRateSuffix
            } %}
            {% include 'ui/input.html.twig' with {
                name: 'labor_rate_paint_shop',
                type: 'number',
                label: 'carservice.settings.labor_rate_paint_shop'|trans,
                hint: 'carservice.settings.labor_rate_team.hint'|trans,
                optional: true,
                form: 'carservice.settings',
                value: laborRates.labor_rate_paint_shop,
                min: 0,
                step: '0.01',
                suffix: laborRateSuffix
            } %}
        </div>
    </section>

    {% if marketEngines is not empty %}
    <section class="panel">
        <header class="panel__head">
            <div>
                <h2>{{ 'carservice.settings.section.market'|trans }}</h2>
                <p class="muted">{{ 'carservice.settings.section.market_hint'|trans }}</p>
            </div>
        </header>
        <div class="cs-market-sources">
            {% for engine in marketEngines %}
                <label class="field field--checkbox{% if not engine.available %} is-muted{% endif %}">
                    <input
                        type="checkbox"
                        name="market_sources[]"
                        value="{{ engine.id }}"
                        {{ engine.id in marketSources ? 'checked' : '' }}
                        {% if not engine.available %}disabled{% endif %}
                    >
                    <span>
                        {{ engine.name }}
                        {% if not engine.available %}
                            <span class="muted">({{ 'searchengines.unavailable'|trans }})</span>
                        {% endif %}
                    </span>
                </label>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <section class="panel">
        <header class="panel__head">
            <div>
                <h2>{{ 'carservice.settings.section.pdf'|trans }}</h2>
                <p class="muted">{{ 'carservice.settings.section.pdf_hint'|trans }}</p>
            </div>
        </header>

        <div class="detail-hub" x-data="gereqTabs" data-initial="pdf-common">
            <div class="design-tabs detail-tabs" role="tablist" aria-label="{{ 'carservice.settings.section.pdf'|trans }}">
                <button type="button" class="design-tab" role="tab" data-tab="pdf-common">
                    {{ 'carservice.settings.pdf.tab.common'|trans }}
                </button>
                {% for meta in pdfTypes %}
                    <button type="button" class="design-tab" role="tab" data-tab="pdf-{{ meta.type }}">
                        {{ meta.label|trans }}
                    </button>
                {% endfor %}
            </div>

            <section class="design-panel" data-panel="pdf-common" role="tabpanel">
                <div class="form-grid">
                    <p class="muted field--full">{{ 'carservice.settings.pdf.placeholders'|trans }}</p>
                    {% set gh = 'carservice.pdf.header' %}
                    {% set gf = 'carservice.pdf.footer' %}
                    {% include 'ui/textarea.html.twig' with {
                        name: 'carservice_pdf_header',
                        id: 'f-carservice_pdf_header',
                        label: 'carservice.settings.pdf.header'|trans,
                        hint: 'carservice.settings.pdf.common_header_hint'|trans,
                        form: 'carservice.settings',
                        value: pdfTemplates[gh]|default(''),
                        size: 'mini',
                        rows: 6,
                        extra: 'field--full'
                    } %}
                    {% include 'ui/textarea.html.twig' with {
                        name: 'carservice_pdf_footer',
                        id: 'f-carservice_pdf_footer',
                        label: 'carservice.settings.pdf.footer'|trans,
                        hint: 'carservice.settings.pdf.common_footer_hint'|trans,
                        form: 'carservice.settings',
                        value: pdfTemplates[gf]|default(''),
                        size: 'mini',
                        rows: 4,
                        extra: 'field--full'
                    } %}
                    <div class="form-actions field--full">
                        <button
                            class="btn btn--ghost"
                            type="submit"
                            formaction="{{ url('admin.carservice.settings.pdf_preview') }}"
                            formtarget="_blank"
                            name="pdf_preview_type"
                            value="worksheet"
                        >{{ 'carservice.settings.pdf.preview'|trans }}</button>
                    </div>
                </div>
            </section>

            {% for meta in pdfTypes %}
                {% set hk = 'carservice.pdf.' ~ meta.type ~ '.header' %}
                {% set fk = 'carservice.pdf.' ~ meta.type ~ '.footer' %}
                <section class="design-panel" data-panel="pdf-{{ meta.type }}" role="tabpanel">
                    <div class="form-grid">
                        <p class="muted field--full">{{ meta.hint|trans }}</p>
                        {% include 'ui/textarea.html.twig' with {
                            name: 'carservice_pdf_' ~ meta.type ~ '_header',
                            id: 'f-carservice_pdf_' ~ meta.type ~ '_header',
                            label: 'carservice.settings.pdf.header'|trans,
                            hint: 'carservice.settings.pdf.type_override_hint'|trans,
                            form: 'carservice.settings',
                            value: pdfTemplates[hk]|default(''),
                            size: 'mini',
                            rows: 6,
                            extra: 'field--full'
                        } %}
                        {% include 'ui/textarea.html.twig' with {
                            name: 'carservice_pdf_' ~ meta.type ~ '_footer',
                            id: 'f-carservice_pdf_' ~ meta.type ~ '_footer',
                            label: 'carservice.settings.pdf.footer'|trans,
                            hint: 'carservice.settings.pdf.type_override_hint'|trans,
                            form: 'carservice.settings',
                            value: pdfTemplates[fk]|default(''),
                            size: 'mini',
                            rows: 4,
                            extra: 'field--full'
                        } %}
                        <div class="form-actions field--full">
                            <button
                                class="btn btn--ghost"
                                type="submit"
                                formaction="{{ url('admin.carservice.settings.pdf_preview') }}"
                                formtarget="_blank"
                                name="pdf_preview_type"
                                value="{{ meta.type }}"
                            >{{ 'carservice.settings.pdf.preview'|trans }}</button>
                        </div>
                    </div>
                </section>
            {% endfor %}
        </div>
    </section>

    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <button
            class="btn btn--ghost"
            type="submit"
            formaction="{{ url('admin.carservice.settings.pdf_preview') }}"
            formtarget="_blank"
            name="pdf_preview_type"
            value="worksheet"
        >{{ 'carservice.settings.pdf.preview'|trans }}</button>
    </div>
</form>
{% endblock %}
