<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <title>Zakázkový list</title>
    <style>
        body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color: #111; }
        h1 { font-size: 18px; margin: 0 0 8px; }
        .meta { color: #555; margin-bottom: 16px; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #ccc; padding: 6px 8px; text-align: left; }
        th { background: #f3f3f3; }
    </style>
</head>
<body>
    <h1>{{ appName }} — Zakázkový list</h1>
    <p class="meta">
        Zakázka: {{ order.id()|slice(0, 8) }} ·
        Stav: {{ order.status() }} ·
        Tým: {{ order.team() }} ·
        Dokončeno: {{ order.finishedAt() ? order.finishedAt().format('d.m.Y H:i') : '—' }}
    </p>
    <p>
        <strong>Vozidlo:</strong>
        {% if vehicle %}{{ vehicle.plate() }} {{ vehicle.brand() }} {{ vehicle.model() }}{% else %}{{ order.vehicleId() }}{% endif %}<br>
        <strong>Zákazník:</strong> {% if customer %}{{ customer.name() }}{% else %}—{% endif %}<br>
        <strong>Odpracováno:</strong> {{ (jobSeconds / 3600)|number_format(2) }} h
    </p>
    {% if order.note() %}<p><strong>Poznámka:</strong> {{ order.note() }}</p>{% endif %}
    <table>
        <thead>
            <tr><th>Práce</th><th>Od</th><th>Do</th><th>Hodiny</th></tr>
        </thead>
        <tbody>
        {% for j in jobs %}
            <tr>
                <td>{{ j.type() }}{% if j.note() %} — {{ j.note() }}{% endif %}</td>
                <td>{{ j.startedAt().format('d.m.Y H:i') }}</td>
                <td>{{ j.endedAt() ? j.endedAt().format('d.m.Y H:i') : '—' }}</td>
                <td>{{ j.durationSeconds() is not null ? ((j.durationSeconds() / 3600)|number_format(2)) : '—' }}</td>
            </tr>
        {% else %}
            <tr><td colspan="4">Bez zaznamenané práce</td></tr>
        {% endfor %}
        </tbody>
    </table>
</body>
</html>
