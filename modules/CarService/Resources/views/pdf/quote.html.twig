<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <title>Nabídka oprav {{ docNumber }}</title>
    <style>{% include '@carservice/pdf/_styles.html.twig' %}</style>
</head>
<body>
{% if isPreview|default(false) %}<div class="preview-banner">Náhled · neukládá se do Dokumentů</div>{% endif %}

{% include '@carservice/pdf/_header.html.twig' %}

<table class="w-100" style="margin-bottom:10px">
    <tr>
        <td style="width:50%;padding-right:10px;vertical-align:top">
            <div class="lbl">Zákazník</div>
            {% if customer %}
                <div class="company-name" style="margin-top:4px">{{ customer.name() }}</div>
                {% if customer.company() %}<div class="small">{{ customer.company() }}</div>{% endif %}
                <div class="small">
                    {% if customer.phone() %}{{ customer.phone() }}{% endif %}
                    {% if customer.phone() and customer.email() %} · {% endif %}
                    {% if customer.email() %}{{ customer.email() }}{% endif %}
                </div>
            {% else %}
                <div class="muted">—</div>
            {% endif %}
        </td>
        <td style="width:50%;padding-left:10px;vertical-align:top;border-left:2px solid #1a1a1a">
            <div class="lbl">Vozidlo</div>
            <div class="company-name" style="margin-top:4px">
                {% if vehicle %}{{ vehicle.plate() }} · {{ vehicle.brand() }} {{ vehicle.displayModel() }}{% else %}—{% endif %}
            </div>
            <div class="small">
                {% if vehicle and vehicle.vin() %}VIN {{ vehicle.vin() }}<br>{% endif %}
                {% if order.intakeMileage() is not null %}Stav {{ order.intakeMileage()|number_format(0, ',', ' ') }} km<br>{% endif %}
                Platnost nabídky: <strong>{{ quoteValidUntil|default('14 dní') }}</strong>
            </div>
        </td>
    </tr>
</table>

{% if order.serviceInfo() %}
<div class="bar">Navrhovaný rozsah</div>
<div class="small" style="padding:4px 0 8px">{{ order.serviceInfo()|nl2br }}</div>
{% endif %}

<table class="items">
    <thead>
        <tr>
            <th style="width:36%;text-align:left">Položka</th>
            <th style="width:20%;text-align:left">Pozn.</th>
            <th class="num" style="width:16%">Bez DPH</th>
            <th class="ctr" style="width:10%">DPH</th>
            <th class="num" style="width:18%">S DPH</th>
        </tr>
    </thead>
    <tbody>
    {% for line in quoteLines|default([]) %}
        <tr>
            <td>{{ line.label }}</td>
            <td>{{ line.note|default('—') }}</td>
            <td class="num">{% if line.net is not null %}{{ line.net|number_format(2, ',', ' ') }}{% else %}—{% endif %}</td>
            <td class="ctr">{% if line.vat_rate is not null %}{{ line.vat_rate }} %{% else %}—{% endif %}</td>
            <td class="num">{% if line.gross is not null %}{{ line.gross|number_format(2, ',', ' ') }}{% elseif line.amount is not null %}{{ line.amount|number_format(2, ',', ' ') }}{% else %}—{% endif %}</td>
        </tr>
    {% else %}
        <tr><td colspan="5" class="muted">Zatím bez naceněných položek</td></tr>
    {% endfor %}
    </tbody>
</table>

<table class="totals-box mt-2" style="width:48%;margin-left:auto;border:2px solid #000">
    <tr>
        <td>Bez DPH</td>
        <td style="text-align:right">
            {% if quoteTotals.net is not null %}{{ quoteTotals.net|number_format(2, ',', ' ') }}{% else %}—{% endif %}
        </td>
    </tr>
    <tr>
        <td>DPH</td>
        <td style="text-align:right">
            {% if quoteTotals.vat is not null %}{{ quoteTotals.vat|number_format(2, ',', ' ') }}{% else %}—{% endif %}
        </td>
    </tr>
    <tr class="grand">
        <td>NABÍDKA CELKEM</td>
        <td style="text-align:right">
            {% if quoteTotals.gross is not null %}{{ quoteTotals.gross|money }}
            {% elseif quoteTotal is not null %}{{ quoteTotal|money }}
            {% else %}—{% endif %}
        </td>
    </tr>
</table>

{% if order.note() %}
<div class="mt-2 small"><strong>Poznámka:</strong> {{ order.note()|nl2br }}</div>
{% endif %}
<div class="mt-1 small muted">Orientační nabídka do doby finální diagnostiky. Platnost {{ quoteValidUntil|default('14 dní') }}.</div>

{% include '@carservice/pdf/_footer.html.twig' %}
</body>
</html>
