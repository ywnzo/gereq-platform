{# Klasický servisní tisk — Dompdf, A4, černo-bílé linky. #}
@page { margin: 10mm 10mm 12mm 10mm; }
* { box-sizing: border-box; }
body {
    font-family: DejaVu Sans, Arial, sans-serif;
    font-size: 9pt;
    color: #000;
    line-height: 1.25;
    margin: 0;
    padding: 0;
}
table { border-collapse: collapse; }
.w-100 { width: 100%; }
.page-frame {
    border: 1.5pt solid #000;
    padding: 0;
}
.doc-title {
    font-size: 13pt;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0;
}
.doc-no {
    font-size: 12pt;
    font-weight: bold;
    text-align: right;
}
.hdr-table td {
    vertical-align: top;
    padding: 6px 8px;
}
.hdr-table .brand-cell {
    width: 48%;
    border-right: 1px solid #000;
}
.hdr-table .cust-cell { width: 52%; }
.lbl {
    font-size: 7.5pt;
    font-weight: bold;
    text-transform: uppercase;
}
.muted { color: #333; font-size: 8pt; }
.company-name { font-size: 11pt; font-weight: bold; margin: 0 0 3px; }
.small { font-size: 8pt; line-height: 1.35; }
.bar {
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    padding: 4px 8px;
    font-weight: bold;
    font-size: 9pt;
    background: #f0f0f0;
}
.kv {
    width: 100%;
}
.kv td {
    border-bottom: 1px solid #ccc;
    padding: 3px 4px;
    vertical-align: top;
}
.kv .k {
    width: 38%;
    font-size: 8pt;
    color: #222;
}
.kv .v {
    width: 62%;
    font-weight: bold;
    font-size: 9pt;
}
.items {
    width: 100%;
}
.items th {
    border: 1px solid #000;
    background: #e8e8e8;
    font-size: 7.5pt;
    font-weight: bold;
    text-align: center;
    padding: 4px 3px;
}
.items td {
    border: 1px solid #000;
    padding: 4px 3px;
    font-size: 8.5pt;
    vertical-align: top;
}
.items td.num, .items th.num { text-align: right; }
.items td.ctr, .items th.ctr { text-align: center; }
.items tfoot td {
    font-weight: bold;
    background: #f5f5f5;
}
.totals-box {
    border: 1px solid #000;
    width: 100%;
}
.totals-box td {
    padding: 3px 6px;
    font-size: 8.5pt;
    border-bottom: 1px solid #ddd;
}
.totals-box tr:last-child td { border-bottom: none; }
.totals-box .grand td {
    font-size: 12pt;
    font-weight: bold;
    border-top: 2px solid #000;
    padding-top: 6px;
}
.sig-boxes {
    width: 100%;
}
.sig-boxes > tbody > tr > td {
    border: 1px solid #000;
    width: 33.33%;
    height: 85px;
    vertical-align: top;
    padding: 6px 8px;
}
.sig-boxes .label { font-size: 8pt; font-weight: bold; margin-bottom: 8px; }
.sig-boxes .hint { font-size: 7.5pt; color: #555; margin-top: 28px; text-align: center; }
.sig-boxes .name { font-size: 9pt; margin-top: 20px; }
.chk {
    display: inline-block;
    width: 9px;
    height: 9px;
    border: 1px solid #000;
    margin-right: 4px;
    vertical-align: -1px;
}
.chk.on {
    background: #000;
}
.chk-round {
    display: inline-block;
    width: 9px;
    height: 9px;
    border: 1px solid #000;
    border-radius: 50%;
    margin-right: 3px;
    vertical-align: -1px;
}
.chk-round.on {
    background: #000;
}
.check-table td {
    padding: 2px 4px 2px 0;
    font-size: 8pt;
    vertical-align: top;
    width: 50%;
}
.zone-grid td {
    border: 1px solid #999;
    width: 16.66%;
    text-align: center;
    padding: 6px 2px;
    font-size: 8pt;
}
.zone-grid td.on {
    background: #1a1a1a;
    color: #fff;
    border-color: #000;
    font-weight: bold;
}
.note-line {
    border-bottom: 1px dotted #666;
    min-height: 16px;
    margin: 4px 0;
}
.section-num {
    font-weight: bold;
    margin: 10px 0 4px;
    font-size: 9pt;
}
.box {
    border: 1px solid #000;
    padding: 8px 10px;
}
.words { font-size: 8pt; font-style: italic; margin-top: 4px; }
.brand-bar {
    background: #1a1a1a;
    color: #fff;
    width: 100%;
}
.brand-bar td {
    color: #fff;
    padding: 10px 12px;
    vertical-align: middle;
    border-right: 1px solid #555;
}
.brand-bar td:last-child { border-right: none; }
.brand-bar .logo {
    font-size: 14pt;
    font-weight: bold;
    letter-spacing: 0.08em;
}
.brand-bar .title {
    font-size: 11pt;
    font-weight: bold;
    text-align: center;
    text-transform: uppercase;
}
.brand-bar .meta {
    font-size: 9pt;
    text-align: right;
}
.quote-hero {
    border-bottom: 3px solid #1a1a1a;
    padding: 0 0 10px;
    margin-bottom: 12px;
}
.quote-hero .brand { font-size: 16pt; font-weight: bold; }
.quote-hero .sub { font-size: 8pt; color: #444; margin-top: 2px; }
.quote-hero .doc {
    text-align: right;
    font-size: 14pt;
    font-weight: bold;
    text-transform: uppercase;
}
.pdf-hero {
    border-bottom: 3px solid #1a1a1a;
    padding: 0 0 10px;
    margin-bottom: 12px;
}
.pdf-hero__brand {
    font-size: 16pt;
    font-weight: bold;
    margin: 0;
    line-height: 1.15;
}
.pdf-hero__sub {
    font-size: 8pt;
    color: #444;
    margin-top: 4px;
    line-height: 1.4;
}
.pdf-hero__sub--right { text-align: right; }
.pdf-hero__doc {
    font-size: 14pt;
    font-weight: bold;
    text-transform: uppercase;
    line-height: 1.2;
}
.pdf-footer {
    margin-top: 18px;
    clear: both;
    page-break-inside: avoid;
}
.pdf-footer--stamp {
    border-top: 1px solid #000;
    padding-top: 12px;
}
.pdf-footer__lbl {
    font-size: 7.5pt;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 6px;
}
.pdf-footer__stamp {
    width: 110px;
    height: 70px;
    border: 1.5px solid #555;
    padding: 8px 6px;
    font-size: 7.5pt;
    color: #444;
    text-align: center;
    line-height: 1.3;
}
.pdf-footer__name {
    font-size: 9pt;
    margin-top: 4px;
    margin-bottom: 4px;
}
.pdf-footer__line {
    border-bottom: 1px solid #000;
    margin-top: 40px;
    width: 85%;
}
.pdf-footer__hint {
    font-size: 7.5pt;
    color: #555;
    margin-top: 3px;
}
.pdf-footer__page {
    font-size: 8pt;
    color: #666;
}
.preview-banner {
    border: 1px dashed #999;
    color: #666;
    font-size: 7.5pt;
    text-align: center;
    padding: 3px;
    margin-bottom: 6px;
    text-transform: uppercase;
}
.pad { padding: 8px; }
.mt-1 { margin-top: 6px; }
.mt-2 { margin-top: 10px; }
.mb-1 { margin-bottom: 6px; }
hr.hard {
    border: none;
    border-top: 2px solid #000;
    margin: 0;
}
hr.soft {
    border: none;
    border-top: 1px solid #000;
    margin: 0;
}
