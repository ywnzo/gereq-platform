{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set branchSource = item ?? 'Modules\\CarService\\Domain\\ServiceBranch' %}

<header class="page-header">
    <div>
        <p class="eyebrow"><a href="{{ url('admin.carservice.branches') }}">{{ 'carservice.branches.title'|trans }}</a></p>
        <h1>{{ item ? 'carservice.branches.edit'|trans : 'carservice.branches.new'|trans }}</h1>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.carservice.branches') }}">{{ 'common.cancel'|trans }}</a>
        <button class="btn btn--primary" type="submit" form="carservice-branch-form">{{ 'common.save'|trans }}</button>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'carservice.branch' } %}

<form method="post" id="carservice-branch-form" class="detail-stack" enctype="multipart/form-data" action="{{ item ? url('admin.carservice.branches.update',{id:item.id()}) : url('admin.carservice.branches.store') }}" data-form="carservice.branch" x-data="gereqForm">
{{ csrf_field()|raw }}

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'carservice.branches.section.basic'|trans }}</h2>
        </div>
    </header>
    {{ forms().render(branchSource, {
        form: 'carservice.branch',
        group: 'basic',
        cols: 2
    }) }}
</section>

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'carservice.branches.section.address'|trans }}</h2>
            <p class="muted">{{ 'carservice.branches.address_hint'|trans }}</p>
        </div>
    </header>
    <div class="form-grid" x-data="gereqAresAddress">
        <div class="g-field field--full ares-field" data-field="street">
            <label class="g-label" for="f-street">
                <span>{{ 'carservice.branches.field.street'|trans }} <span class="g-optional">({{ 'common.optional'|trans }})</span></span>
            </label>
            <div class="ares-field__control">
                <input
                    class="g-control"
                    type="text"
                    id="f-street"
                    name="street"
                    data-ares-query
                    data-ares-fill="street"
                    autocomplete="off"
                    placeholder="{{ 'carservice.branches.address_placeholder'|trans }}"
                    value="{{ item ? item.street() : '' }}"
                    @input="onInput"
                    @keydown="onKeydown"
                    x-ref="query"
                >
                {% include 'ui/ares_address_suggest.html.twig' %}
            </div>
        </div>
        {{ forms().render(branchSource, {
            form: 'carservice.branch',
            group: 'address',
            cols: 2,
            wrap: false
        }) }}
    </div>
</section>

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'carservice.branches.section.logo'|trans }}</h2>
            <p class="muted">{{ 'carservice.branches.logo_hint'|trans }}</p>
        </div>
    </header>
    <div class="form-grid">
        {% if item and item.logoFileId() %}
            <div class="field field--full">
                <img class="avatar avatar--lg" src="{{ url('admin.carservice.branches.logo',{id:item.id()}) }}" alt="{{ item.name() }}">
            </div>
        {% endif %}
        {% include 'ui/file.html.twig' with {
            name: 'logo',
            id: 'f-logo',
            label: 'carservice.branches.field.logo'|trans,
            optional: true,
            hint: 'carservice.branches.field.logo.hint'|trans,
            accept: 'image/*',
            compact: true,
            extra: 'field--full'
        } %}
        {{ forms().render(branchSource, {
            form: 'carservice.branch',
            group: 'logo',
            cols: 1,
            wrap: false
        }) }}
    </div>
</section>
</form>
{% endblock %}
