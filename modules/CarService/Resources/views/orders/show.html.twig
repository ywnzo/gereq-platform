{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set canFinish = user.can('carservice.manage') and item.isOpen() %}
<div{% if canFinish %} x-data="gereqModal"{% endif %}>
<header class="page-header">
    <div>
        <h1>{{ vehicle ? vehicle.label() : ('carservice.order'|trans({'%id%': item.id()|slice(0,8)})) }}</h1>
        <p class="muted detail-layout__meta">
            <span class="badge">{{ item.statusLabel()|trans }}</span>
            <span>{{ item.teamLabel()|trans }}</span>
            {% if branch %}<span>{{ branch.name() }}</span>{% endif %}
            {% if customer %}<a href="{{ url('admin.customers.show',{id:customer.id()}) }}">{{ customer.name() }}</a>{% endif %}
        </p>
    </div>
    <div class="actions">
        {% if canFinish %}
            <button class="btn btn--primary" type="button" @click="show">{{ 'carservice.finish'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.carservice.edit',{id:item.id()}) }}">{{ 'common.edit'|trans }}</a>
        {% endif %}
        {% if user.can('carservice.tracker') and item.isOpen() %}
            <a class="btn btn--ghost" href="{{ url('admin.carservice.tracker.show',{id:item.id()}) }}">{{ 'carservice.tracker.open'|trans }}</a>
        {% endif %}
    </div>
</header>

{% if canFinish %}
<div class="g-modal__backdrop" :class="backdropClass" @click="close"></div>
<div class="g-modal" :class="panelClass" role="dialog" aria-modal="true" aria-labelledby="finish-dialog-title">
    <div class="g-modal__panel g-modal__panel--finish" @click.stop>
        <form method="post" action="{{ url('admin.carservice.finish',{id:item.id()}) }}" class="cs-finish">
            {{ csrf_field()|raw }}
            <header class="cs-finish__head">
                <h2 class="g-modal__title" id="finish-dialog-title">{{ 'carservice.finish.dialog_title'|trans }}</h2>
                <p class="muted">{{ 'carservice.finish.hint'|trans }}</p>
            </header>

            {% include 'ui/textarea.html.twig' with {
                name: 'service_info',
                label: 'carservice.field.service_info'|trans,
                optional: true,
                value: item.serviceInfo() ?: '',
                size: 'mini',
                rows: 3,
                extra: 'cs-finish__notes'
            } %}

            <div class="cs-finish__grid">
                {% include 'ui/select.html.twig' with { name:'payment_type', label:'carservice.field.payment_type'|trans, optional:true, value: item.paymentType() ?: '', options:[
                    {value:'',label:'—'},{value:'online',label:'carservice.payment.online'|trans},{value:'cash',label:'carservice.payment.cash'|trans}
                ] } %}
                {% include 'ui/input.html.twig' with { name:'signature', label:'carservice.finish.signature'|trans, optional:true, value:'' } %}
                {% include 'ui/input.html.twig' with { name:'internal_cost', type:'number', label:'carservice.field.internal_cost'|trans, optional:true, value: item.internalCost() ?: '', step:'0.01' } %}
                {% include 'ui/input.html.twig' with { name:'external_cost', type:'number', label:'carservice.field.external_cost'|trans, optional:true, value: item.externalCost() ?: '', step:'0.01' } %}
                {% include 'ui/input.html.twig' with { name:'intake_mileage', type:'number', label:'carservice.field.intake_mileage'|trans, optional:true, value: item.intakeMileage() ?: '' } %}
                {% include 'ui/select.html.twig' with { name:'intake_fuel_level', label:'carservice.field.intake_fuel'|trans, optional:true, value: item.intakeFuelLevel() ?: '', options:[
                    {value:'',label:'—'},{value:'full',label:'fleet.fuel_level.full'|trans},{value:'three_quarters',label:'fleet.fuel_level.three_quarters'|trans},{value:'half',label:'fleet.fuel_level.half'|trans},{value:'quarter',label:'fleet.fuel_level.quarter'|trans},{value:'empty',label:'fleet.fuel_level.empty'|trans}
                ] } %}
            </div>

            <div class="g-modal__actions cs-finish__actions">
                <button class="btn btn--ghost" type="button" @click="close" x-ref="close">{{ 'common.cancel'|trans }}</button>
                <button class="btn btn--primary" type="submit">{{ 'carservice.finish.confirm'|trans }}</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

<div class="detail-layout">
    <div class="detail-layout__main">
        <section class="detail-hero panel">
            <div class="detail-hero__body">
                <div class="detail-hero__highlight">
                    <span>{{ 'carservice.field.status'|trans }}</span>
                    <strong>{{ item.statusLabel()|trans }}</strong>
                </div>
                <dl class="detail-hero__facts">
                    <div>
                        <dt>{{ 'carservice.field.vehicle'|trans }}</dt>
                        <dd>{% if vehicle %}<a href="{{ url('admin.fleet.show',{id:vehicle.id()}) }}">{{ vehicle.label() }}</a>{% else %}—{% endif %}</dd>
                    </div>
                    <div>
                        <dt>{{ 'carservice.field.job_time'|trans }}</dt>
                        <dd>{{ (jobSeconds / 3600)|number_format(1) }} h</dd>
                    </div>
                    <div>
                        <dt>{{ 'carservice.field.tracker'|trans }}</dt>
                        <dd><code>{{ item.trackerToken() }}</code></dd>
                    </div>
                </dl>
            </div>
        </section>

        {% if user.can('carservice.manage') and item.isOpen() %}
        <section class="panel">
            <header class="panel__head"><h2>{{ 'carservice.actions'|trans }}</h2></header>
            <div class="form-grid form-grid--compact">
                <form method="post" action="{{ url('admin.carservice.status',{id:item.id()}) }}">
                    {{ csrf_field()|raw }}
                    <label class="field"><span>{{ 'carservice.field.status'|trans }}</span>
                        <select name="status" class="input" data-autosubmit>
                            {% for s in statuses %}<option value="{{ s }}" {{ item.status()==s?'selected':'' }}>{{ ('carservice.status.'~s)|trans }}</option>{% endfor %}
                        </select>
                    </label>
                </form>
                <form method="post" action="{{ url('admin.carservice.team',{id:item.id()}) }}">
                    {{ csrf_field()|raw }}
                    <label class="field"><span>{{ 'carservice.field.team'|trans }}</span>
                        <select name="team" class="input" data-autosubmit>
                            {% for t in teams %}<option value="{{ t }}" {{ item.team()==t?'selected':'' }}>{{ ('carservice.team.'~t)|trans }}</option>{% endfor %}
                        </select>
                    </label>
                </form>
            </div>
        </section>
        {% endif %}

        <section class="panel">
            <header class="panel__head"><h2>{{ 'carservice.jobs.title'|trans }}</h2></header>
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>{{ 'carservice.field.job_type'|trans }}</th><th>{{ 'carservice.field.started'|trans }}</th><th>{{ 'carservice.field.ended'|trans }}</th><th>{{ 'carservice.field.duration'|trans }}</th><th></th></tr></thead>
                    <tbody>
                    {% for j in jobs %}
                        <tr>
                            <td>{{ j.type() }}{% if j.note() %}<div class="muted">{{ j.note() }}</div>{% endif %}</td>
                            <td>{{ j.startedAt().format('d. m. Y H:i') }}</td>
                            <td>{{ j.endedAt() ? j.endedAt().format('d. m. Y H:i') : ('carservice.jobs.running'|trans) }}</td>
                            <td>{{ j.durationSeconds() is not null ? ((j.durationSeconds() / 3600)|number_format(2) ~ ' h') : '—' }}</td>
                            <td>
                                {% if user.can('carservice.manage') and j.isRunning() %}
                                    <form method="post" action="{{ url('admin.carservice.jobs.complete',{id:item.id(),jobId:j.id()}) }}">
                                        {{ csrf_field()|raw }}
                                        <button type="submit" class="btn btn--ghost">{{ 'carservice.jobs.stop'|trans }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="muted">{{ 'carservice.jobs.empty'|trans }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if user.can('carservice.manage') and item.isOpen() %}
                <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.carservice.jobs.store',{id:item.id()}) }}" data-form="carservice.job">
                    {{ csrf_field()|raw }}
                    {% include 'ui/input.html.twig' with { name:'type', label:'carservice.field.job_type'|trans, form:'carservice.job', value:'work' } %}
                    {% include 'ui/select.html.twig' with { name:'employee_user_id', label:'carservice.field.employee'|trans, optional:true, form:'carservice.job', value:user.id(), options:userOptions } %}
                    {% include 'ui/input.html.twig' with { name:'note', label:'carservice.field.note'|trans, optional:true, form:'carservice.job', value:'' } %}
                    <div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'carservice.jobs.start'|trans }}</button></div>
                </form>
            {% endif %}
        </section>

        {% if mediaAvailable %}
        <section class="panel">
            <header class="panel__head"><h2>{{ 'carservice.media.title'|trans }}</h2></header>
            <div class="panel__body">
                {% for phase in mediaPhases %}
                    <div class="cs-media-phase">
                        <h3>{{ ('carservice.media.phase.'~phase)|trans }}</h3>
                        <div class="table-wrap"><table class="table"><tbody>
                        {% for row in mediaByPhase[phase]|default([]) %}
                            <tr>
                                <td><a href="{{ url('admin.media.show',{id:row.asset.id()}) }}">{{ row.asset.title() }}</a></td>
                                <td class="is-mute">{{ row.asset.mime() }}</td>
                            </tr>
                        {% else %}
                            <tr><td class="muted" colspan="2">{{ 'carservice.media.empty_phase'|trans }}</td></tr>
                        {% endfor %}
                        </tbody></table></div>
                    </div>
                {% endfor %}
                {% if user.can('carservice.manage') %}
                    <form method="post" enctype="multipart/form-data" class="form-grid form-grid--compact" action="{{ url('admin.carservice.media',{id:item.id()}) }}">
                        {{ csrf_field()|raw }}
                        {% set phaseOptions = [] %}
                        {% for phase in mediaPhases %}
                            {% set phaseOptions = phaseOptions|merge([{ value: phase, label: ('carservice.media.phase.'~phase)|trans }]) %}
                        {% endfor %}
                        {% include 'ui/select.html.twig' with {
                            name: 'phase',
                            label: 'carservice.media.phase_label'|trans,
                            value: mediaPhases[0]|default('before'),
                            options: phaseOptions
                        } %}
                        {% include 'ui/file.html.twig' with {
                            name: 'file',
                            label: 'carservice.media.file'|trans,
                            hint: 'carservice.media.file.hint'|trans,
                            accept: 'image/*,application/pdf',
                            required: true,
                            compact: true,
                            extra: 'field--full'
                        } %}
                        <div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'carservice.media.upload'|trans }}</button></div>
                    </form>
                {% endif %}
            </div>
        </section>
        {% endif %}

        {% if sections is defined and sections is not empty %}
            {% set orderedSections = sections|sort((a, b) => (a.order|default(100)) <=> (b.order|default(100))) %}
            {% for section in orderedSections %}
                {{ section.html|raw }}
            {% endfor %}
        {% endif %}

        {% if user.can('carservice.manage') and showIntakeProtocolForm %}
            {% include '@carservice/partials/intake_protocol_form.html.twig' %}
        {% endif %}

        {% if documentsAvailable|default(false) and user.can('carservice.manage') %}
        <section class="panel">
            <header class="panel__head"><h2>{{ 'carservice.documents.generate'|trans }}</h2></header>
            <div class="panel__body">
                <p class="muted" style="margin-bottom:12px">{{ 'carservice.documents.generate.hint'|trans }}</p>
                <div class="actions" style="flex-wrap:wrap;gap:8px">
                    {% for pdf in pdfTypes|default([]) %}
                        <form method="post" action="{{ url('admin.carservice.documents.generate',{id:item.id()}) }}" style="display:inline">
                            {{ csrf_field()|raw }}
                            <input type="hidden" name="type" value="{{ pdf.type }}">
                            <button class="btn btn--ghost" type="submit">{{ pdf.label|trans }}</button>
                        </form>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        {% if documents is defined and documents is not empty %}
        <section class="panel">
            <header class="panel__head"><h2>{{ 'carservice.documents.title'|trans }}</h2></header>
            {% include '@documents/partials/document_list.html.twig' with { documents: documents } %}
        </section>
        {% endif %}
    </div>

    <aside class="detail-layout__aside">
        <section class="panel">
            <header class="panel__head"><h2>{{ 'carservice.field.tracker'|trans }}</h2></header>
            <div style="text-align:center;margin-bottom:12px">
                <img src="{{ qrDataUri }}" alt="QR" width="180" height="180">
            </div>
            <p><code>{{ item.trackerToken() }}</code></p>
            <p class="muted"><a href="{{ trackerDeepLink }}">{{ 'carservice.tracker.open'|trans }}</a></p>
            <p class="muted" style="word-break:break-all;font-size:.75rem">{{ trackerUrl }}</p>
        </section>
        <section class="panel">
            <header class="panel__head"><h2>{{ 'common.overview'|trans }}</h2></header>
            <dl class="meta-list meta-list--flush detail-layout__specs">
                <div><dt>{{ 'carservice.field.type'|trans }}</dt><dd>{{ item.typeLabel()|trans }}</dd></div>
                <div><dt>{{ 'carservice.field.team'|trans }}</dt><dd>{{ item.teamLabel()|trans }}</dd></div>
                <div><dt>{{ 'carservice.field.payment_type'|trans }}</dt><dd>{% if item.paymentType() %}{{ ('carservice.payment.'~item.paymentType())|trans }}{% else %}—{% endif %}</dd></div>
                <div><dt>{{ 'carservice.field.internal_cost'|trans }}</dt><dd>{{ item.internalCost() ?: '—' }}</dd></div>
                <div><dt>{{ 'carservice.field.external_cost'|trans }}</dt><dd>{{ item.externalCost() ?: '—' }}</dd></div>
                <div><dt>{{ 'carservice.field.intake_mileage'|trans }}</dt><dd>{{ item.intakeMileage() is not null ? item.intakeMileage() : '—' }}</dd></div>
                <div><dt>{{ 'carservice.field.intake_fuel'|trans }}</dt><dd>{% if item.intakeFuelLevel() %}{{ ('fleet.fuel_level.'~item.intakeFuelLevel())|trans }}{% else %}—{% endif %}</dd></div>
                <div><dt>{{ 'carservice.field.intake'|trans }}</dt><dd>{{ item.intakeAt()?item.intakeAt().format('d. m. Y'):'—' }}</dd></div>
                <div><dt>{{ 'carservice.field.handover'|trans }}</dt><dd>{{ item.handoverAt()?item.handoverAt().format('d. m. Y'):'—' }}</dd></div>
                <div class="meta-list__full"><dt>{{ 'carservice.field.customer'|trans }}</dt>
                    <dd>{% if customer %}<a href="{{ url('admin.customers.show',{id:customer.id()}) }}">{{ customer.name() }}</a>{% else %}—{% endif %}</dd></div>
                {% if item.serviceInfo() %}<div class="meta-list__full"><dt>{{ 'carservice.field.service_info'|trans }}</dt><dd>{{ item.serviceInfo() }}</dd></div>{% endif %}
                {% if item.note() %}<div class="meta-list__full"><dt>{{ 'carservice.field.note'|trans }}</dt><dd>{{ item.note() }}</dd></div>{% endif %}
                {% if links is not empty %}
                    <div class="meta-list__full"><dt>{{ 'carservice.field.links'|trans }}</dt>
                        <dd>{% for l in links %}{{ l.linkType() }}: {{ l.linkId() }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd></div>
                {% endif %}
            </dl>
        </section>
        {% if switches is not empty %}
        <section class="panel">
            <header class="panel__head"><h2>{{ 'carservice.team_history'|trans }}</h2></header>
            <ul class="meta-list meta-list--flush">
                {% for s in switches %}
                    <li>{% if s.fromTeam() %}{{ ('carservice.team.'~s.fromTeam())|trans }} → {% endif %}{{ ('carservice.team.'~s.toTeam())|trans }}
                        <span class="muted">{{ s.createdAt().format('d. m. H:i') }}</span>
                        {% if s.note() %}<div class="muted">{{ s.note() }}</div>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}
    </aside>
</div>
</div>

<script nonce="{{ csp_nonce() }}">
(() => {
    document.querySelectorAll('select[data-autosubmit]').forEach((el) => {
        el.addEventListener('change', () => el.form?.submit());
    });
})();
</script>
{% endblock %}
