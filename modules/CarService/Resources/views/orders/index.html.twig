{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set canManage = user.can('carservice.manage') %}
{% set showBranchColumn = showBranchColumn|default(false) %}
{% set emptyCols = (canManage ? 7 : 6) + (showBranchColumn ? 1 : 0) %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="carservice"
    data-actions-default="{{ canManage ? 3 : 1 }}"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'carservice.bulk.confirm_delete'|trans|e('html_attr') }}"
>
<header class="page-header">
    <div>
        <h1>{{ 'carservice.title'|trans }}</h1>
        <p class="muted">{{ 'carservice.index.intro'|trans }}</p>
    </div>
    {% if canManage %}
        <a class="btn btn--primary" href="{{ url('admin.carservice.create') }}">{{ icon('plus') }} {{ 'carservice.new'|trans }}</a>
    {% endif %}
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <select name="status" class="input" onchange="this.form.submit()">
            <option value="">{{ 'carservice.all_statuses'|trans }}</option>
            {% for s in statuses %}<option value="{{ s }}" {{ status==s?'selected':'' }}>{{ ('carservice.status.'~s)|trans }}</option>{% endfor %}
        </select>
        <select name="team" class="input" onchange="this.form.submit()">
            <option value="">{{ 'carservice.all_teams'|trans }}</option>
            {% for t in teams %}<option value="{{ t }}" {{ team==t?'selected':'' }}>{{ ('carservice.team.'~t)|trans }}</option>{% endfor %}
        </select>
    </form>
</div>

{% if canManage and items is not empty %}
    <form
        class="bulk-bar"
        method="post"
        action="{{ url('admin.carservice.bulk') }}"
        x-show="selectedCount > 0"
        x-cloak
        @submit="confirmBulk"
    >
        {{ csrf_field()|raw }}
        <input type="hidden" name="confirmed" value="1">
        <template x-for="id in selected" :key="id">
            <input type="hidden" name="ids[]" :value="id">
        </template>
        <div class="bulk-bar__meta">
            <strong x-text="selectedCount"></strong>
            <span>{{ 'carservice.bulk.selected'|trans }}</span>
            <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'carservice.bulk.clear'|trans }}</button>
        </div>
        <div class="bulk-bar__actions">
            <select class="input" name="action" x-model="bulkAction" required>
                <option value="">{{ 'carservice.bulk.choose'|trans }}</option>
                <option value="delete">{{ 'carservice.bulk.action.delete'|trans }}</option>
            </select>
            <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'carservice.bulk.apply'|trans }}</button>
        </div>
    </form>
{% endif %}

<div class="table-wrap" data-table>
<table class="table table--carservice">
<thead>
<tr>
    {% if canManage %}
        <th class="table__check">
            <label class="table-check">
                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected">
                <span class="sr-only">{{ 'carservice.bulk.select_all'|trans }}</span>
            </label>
        </th>
    {% endif %}
    <th>{{ 'carservice.field.vehicle'|trans }}</th>
    <th>{{ 'carservice.field.customer'|trans }}</th>
    {% if showBranchColumn %}
    <th>{{ 'carservice.field.branch'|trans }}</th>
    {% endif %}
    {% include 'ui/sort_th.html.twig' with { label: 'carservice.field.status'|trans, column: 'status', query: { status: status, team: team } } %}
    {% include 'ui/sort_th.html.twig' with { label: 'carservice.field.team'|trans, column: 'team', query: { status: status, team: team } } %}
    {% include 'ui/sort_th.html.twig' with { label: 'carservice.field.updated'|trans, column: 'updatedAt', query: { status: status, team: team } } %}
    <th class="table__actions-head"></th>
</tr>
</thead>
<tbody>
{% for item in items %}
{% set v = vehicles[item.vehicleId()]|default(null) %}
{% set c = item.customerId() ? customers[item.customerId()]|default(null) : null %}
{% set b = item.branchId() ? branches[item.branchId()]|default(null) : null %}
<tr class="cs-row" :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
    {% if canManage %}
        <td class="table__check">
            <label class="table-check">
                <input
                    type="checkbox"
                    value="{{ item.id() }}"
                    @change="toggleId('{{ item.id() }}')"
                    :checked="isSelected('{{ item.id() }}')"
                >
                <span class="sr-only">#{{ item.id()|slice(0, 8) }}</span>
            </label>
        </td>
    {% endif %}
    <td>
        <a class="cs-row__primary" href="{{ url('admin.carservice.show',{id:item.id()}) }}">
            {% if v %}
                <span class="cs-row__plate">{{ v.plate() }}</span>
                <span class="cs-row__name">
                    {% if v.brand() or v.displayModel() %}
                        {{ v.brand() }} {{ v.displayModel() }}{% if v.modelYear() %} · {{ v.modelYear() }}{% endif %}
                    {% else %}
                        <span class="muted">{{ v.label() }}</span>
                    {% endif %}
                </span>
            {% else %}
                <span class="cs-row__plate">{{ item.vehicleId()|slice(0, 8) }}…</span>
            {% endif %}
            <span class="cs-row__meta">
                #{{ item.id()|slice(0, 8) }}
                · {{ item.typeLabel()|trans }}
            </span>
        </a>
    </td>
    <td>
        {% if c %}
            <a class="cs-row__customer" href="{{ url('admin.customers.show',{id:c.id()}) }}">{{ c.name() }}</a>
        {% else %}
            <span class="muted">—</span>
        {% endif %}
    </td>
    {% if showBranchColumn %}
    <td>
        {% if b %}
            <span class="badge badge--muted">{{ b.name() }}</span>
        {% else %}
            <span class="muted">—</span>
        {% endif %}
    </td>
    {% endif %}
    <td>
        <span class="status-chip status-chip--cs-{{ item.status() }}">
            <span class="status-chip__dot" aria-hidden="true"></span>
            {{ item.statusLabel()|trans }}
        </span>
    </td>
    <td>
        <span class="badge badge--cs-{{ item.team() }}">{{ item.teamLabel()|trans }}</span>
    </td>
    <td>
        <time class="cs-row__when" datetime="{{ item.updatedAt().format('c') }}">{{ item.updatedAt().format('d. m. Y H:i') }}</time>
    </td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% include 'ui/row_action.html.twig' with { href: url('admin.carservice.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
            {% if canManage %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.carservice.edit',{id:item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                {% include 'ui/row_action_destroy.html.twig' with {
                    action: url('admin.carservice.destroy', {id: item.id()}),
                    confirm: 'carservice.confirm_delete'|trans
                } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr><td colspan="{{ emptyCols }}"><div class="empty"><h2>{{ 'carservice.empty'|trans }}</h2></div></td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
