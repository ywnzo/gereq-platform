{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <p class="eyebrow"><a href="{{ url('admin.carservice.index') }}">{{ 'nav.carservice'|trans }}</a></p>
        <h1>{{ item ? 'carservice.edit'|trans : 'carservice.new'|trans }}</h1>
        <p class="muted">{{ 'carservice.form.intro'|trans }}</p>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.carservice.index') }}">{{ 'common.cancel'|trans }}</a>
        <button class="btn btn--primary" type="submit" form="carservice-order-form">{{ 'common.save'|trans }}</button>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'carservice.save' } %}

<form method="post" id="carservice-order-form" class="detail-stack" action="{{ item ? url('admin.carservice.update',{id:item.id()}) : url('admin.carservice.store') }}" data-form="carservice.save" x-data="gereqForm">
{{ csrf_field()|raw }}

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'carservice.form.section.order'|trans }}</h2>
            <p class="muted">{{ 'carservice.form.section.order_hint'|trans }}</p>
        </div>
    </header>
    <div class="form-grid">
        {% include 'ui/select.html.twig' with { name:'vehicle_id', label:'carservice.field.vehicle'|trans, required:true, form:'carservice.save', value: item?item.vehicleId():vehicleId, options:vehicleOptions, extra:'field--full' } %}
        {% include 'ui/select.html.twig' with { name:'customer_id', label:'carservice.field.customer'|trans, optional:true, form:'carservice.save', value: item?item.customerId():customerId, options:customerOptions } %}
        {% include 'ui/select.html.twig' with { name:'type', label:'carservice.field.type'|trans, form:'carservice.save', value: item?item.type():'external_customer', options:[
            {value:'internal_fleet',label:'carservice.type.internal_fleet'|trans},
            {value:'external_customer',label:'carservice.type.external_customer'|trans},
            {value:'linked',label:'carservice.type.linked'|trans}
        ] } %}
        {% include 'ui/select.html.twig' with { name:'status', label:'carservice.field.status'|trans, form:'carservice.save', value: item?item.status():'intake', options:[
            {value:'intake',label:'carservice.status.intake'|trans},
            {value:'in_progress',label:'carservice.status.in_progress'|trans},
            {value:'waiting',label:'carservice.status.waiting'|trans},
            {value:'ready',label:'carservice.status.ready'|trans},
            {value:'done',label:'carservice.status.done'|trans},
            {value:'cancelled',label:'carservice.status.cancelled'|trans}
        ] } %}
        {% include 'ui/select.html.twig' with { name:'team', label:'carservice.field.team'|trans, form:'carservice.save', value: item?item.team():'body_shop', options:[
            {value:'body_shop',label:'carservice.team.body_shop'|trans},
            {value:'paint_shop',label:'carservice.team.paint_shop'|trans}
        ] } %}
        {% include 'ui/select.html.twig' with { name:'branch_id', label:'carservice.field.branch'|trans, optional:true, form:'carservice.save', value: item ? item.branchId() : defaultBranchId|default(''), options:branchOptions, searchable: true } %}
    </div>
</section>

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'carservice.form.section.intake'|trans }}</h2>
            <p class="muted">{{ 'carservice.form.section.intake_hint'|trans }}</p>
        </div>
    </header>
    <div class="form-grid">
        {% include 'ui/input.html.twig' with { name:'intake_mileage', type:'number', label:'carservice.field.intake_mileage'|trans, optional:true, form:'carservice.save', value: item and item.intakeMileage()?item.intakeMileage():'' } %}
        {% include 'ui/select.html.twig' with { name:'intake_fuel_level', label:'carservice.field.intake_fuel'|trans, optional:true, form:'carservice.save', value: item?item.intakeFuelLevel():'', options:[
            {value:'',label:'—'},
            {value:'full',label:'fleet.fuel_level.full'|trans},
            {value:'three_quarters',label:'fleet.fuel_level.three_quarters'|trans},
            {value:'half',label:'fleet.fuel_level.half'|trans},
            {value:'quarter',label:'fleet.fuel_level.quarter'|trans},
            {value:'empty',label:'fleet.fuel_level.empty'|trans}
        ] } %}
        {% include 'ui/input.html.twig' with { name:'intake_at', type:'date', label:'carservice.field.intake'|trans, optional:true, form:'carservice.save', value: item and item.intakeAt()?item.intakeAt().format('Y-m-d'):'' } %}
        {% include 'ui/input.html.twig' with { name:'handover_at', type:'date', label:'carservice.field.handover'|trans, optional:true, form:'carservice.save', value: item and item.handoverAt()?item.handoverAt().format('Y-m-d'):'' } %}
    </div>
</section>

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'carservice.form.section.costs'|trans }}</h2>
        </div>
    </header>
    <div class="form-grid">
        {% include 'ui/select.html.twig' with { name:'payment_type', label:'carservice.field.payment_type'|trans, optional:true, form:'carservice.save', value: item?item.paymentType():'', options:[
            {value:'',label:'—'},
            {value:'online',label:'carservice.payment.online'|trans},
            {value:'cash',label:'carservice.payment.cash'|trans}
        ] } %}
        {% include 'ui/input.html.twig' with { name:'internal_cost', type:'number', label:'carservice.field.internal_cost'|trans, optional:true, form:'carservice.save', value: item and item.internalCost()?item.internalCost():'', step:'0.01' } %}
        {% include 'ui/input.html.twig' with { name:'external_cost', type:'number', label:'carservice.field.external_cost'|trans, optional:true, form:'carservice.save', value: item and item.externalCost()?item.externalCost():'', step:'0.01' } %}
    </div>
</section>

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'carservice.form.section.work'|trans }}</h2>
            <p class="muted">{{ 'carservice.form.section.work_hint'|trans }}</p>
        </div>
    </header>
    <div class="form-grid">
        {% include 'ui/textarea.html.twig' with { name:'service_info', label:'carservice.field.service_info'|trans, optional:true, form:'carservice.save', value: item?item.serviceInfo():'', size:'mini', rows:5, extra:'field--full' } %}
        {% include 'ui/textarea.html.twig' with { name:'note', label:'carservice.field.note'|trans, optional:true, form:'carservice.save', value: item?item.note():'', size:'mini', rows:3, extra:'field--full' } %}
    </div>
</section>
</form>
{% endblock %}
