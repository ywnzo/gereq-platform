{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="cs-tracker">
<header class="page-header">
    <div>
        <h1>{{ 'carservice.tracker.title'|trans }}</h1>
        <p class="muted">{{ 'carservice.tracker.hint'|trans }}</p>
    </div>
</header>

<div class="cs-tracker__shell">
    <section class="cs-tracker__scan" aria-labelledby="cs-tracker-scan-title">
        <div class="cs-tracker__scan-copy">
            <h2 id="cs-tracker-scan-title">{{ 'carservice.tracker.scan_title'|trans }}</h2>
            <p class="muted">{{ 'carservice.tracker.scan_intro'|trans }}</p>
        </div>
        <form method="post" action="{{ url('admin.carservice.tracker.resolve') }}" class="cs-tracker__scan-form">
            {{ csrf_field()|raw }}
            <label class="cs-tracker__field">
                <span class="cs-tracker__label">{{ 'carservice.tracker.query'|trans }}</span>
                <input class="input cs-tracker__input" type="text" name="q" required autofocus autocomplete="off" placeholder="{{ 'carservice.tracker.query_placeholder'|trans }}">
            </label>
            <button class="btn btn--primary cs-tracker__submit" type="submit">{{ icon('search') }} {{ 'carservice.tracker.resolve'|trans }}</button>
        </form>
    </section>

    <section class="cs-tracker__orders" aria-labelledby="cs-tracker-orders-title">
        <header class="cs-tracker__section-head">
            <div>
                <h2 id="cs-tracker-orders-title">{{ 'carservice.tracker.open_list'|trans }}</h2>
                <p class="muted">{{ 'carservice.tracker.open_intro'|trans({'%count%': orderCards|length}) }}</p>
            </div>
        </header>

        {% if orderCards is not empty %}
            <div class="cs-tracker__grid">
                {% for card in orderCards %}
                    {% set o = card.order %}
                    <a class="cs-tracker-card" href="{{ card.href }}">
                        <div class="cs-tracker-card__media">
                            {% if card.photo_url %}
                                <img src="{{ card.photo_url }}" alt="{{ card.plate }}" loading="lazy">
                            {% else %}
                                <span class="cs-tracker-card__placeholder" aria-hidden="true">{{ icon('car') }}</span>
                            {% endif %}
                        </div>
                        <div class="cs-tracker-card__body">
                            <div class="cs-tracker-card__top">
                                <span class="cs-tracker-card__plate">{{ card.plate }}</span>
                                <span class="status-chip status-chip--cs-{{ o.status() }}">
                                    <span class="status-chip__dot" aria-hidden="true"></span>
                                    {{ o.statusLabel()|trans }}
                                </span>
                            </div>
                            {% if card.label %}
                                <p class="cs-tracker-card__name">{{ card.label }}</p>
                            {% endif %}
                            {% if card.subject %}
                                <p class="cs-tracker-card__subject">{{ card.subject|slice(0, 90) }}{% if card.subject|length > 90 %}…{% endif %}</p>
                            {% endif %}
                            <div class="cs-tracker-card__meta">
                                <span class="badge badge--cs-{{ o.team() }}">{{ o.teamLabel()|trans }}</span>
                                <span class="cs-tracker-card__cta">{{ 'carservice.tracker.open'|trans }} →</span>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="cs-tracker__empty">
                <span class="cs-tracker__empty-icon" aria-hidden="true">{{ icon('clipboard') }}</span>
                <p>{{ 'carservice.tracker.open_empty'|trans }}</p>
            </div>
        {% endif %}
    </section>
</div>
</div>
{% endblock %}
