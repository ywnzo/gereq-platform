{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: sandbox|default(false) ? [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.cms'|trans, url: url('admin.cms.pages.index') },
        { label: 'nav.cms.pages'|trans, url: url('admin.cms.pages.index') },
    ] : [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.cms'|trans, url: url('admin.cms.pages.index') },
        { label: 'nav.cms.pages'|trans, url: url('admin.cms.pages.index') },
        { label: item.title(), url: url('admin.cms.pages.show', {id: item.id()}) },
    ] } %}
{% endblock %}

{% block content %}
{% set bootJson = boot|merge({ csrf: csrf_token(), staged: staged }) %}
<div class="cms-builder{% if sandbox|default(false) %} cms-builder--sandbox{% endif %}"
     x-data="cmsBuilder"
     data-boot="{{ bootJson|json_encode|e('html_attr') }}">

    <header class="page-header cms-builder__header">
        <div>
            <p class="eyebrow">
                {% if sandbox|default(false) %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} href="{{ url('admin.cms.pages.index') }}" class="btn btn--ghost btn-sm cms-builder__exit" title="{{ 'cms.builder.exit'|trans }}"{% endblock %}{% block content %}
                        <span class="material-symbols-outlined g-icon">arrow_back</span>
                    {% endblock %}{% endembed %}
                {% else %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} href="{{ url('admin.cms.pages.show', {id: item.id()}) }}" class="btn btn--ghost btn-sm cms-builder__exit" title="{{ 'cms.builder.exit'|trans }}"{% endblock %}{% block content %}
                        <span class="material-symbols-outlined g-icon">arrow_back</span>
                    {% endblock %}{% endembed %}
                {% endif %}

                <span class="muted detail-layout__meta">
                    {% if sandbox|default(false) %}
                        <span class="badge badge--muted">{{ 'cms.builder.sandbox.badge'|trans }}</span>
                        <span>{{ 'cms.builder.sandbox.hint'|trans }}</span>
                    {% else %}
                        <strong>{{ item.title() }}</strong>
                        <code>/{{ item.slug() }}</code>
                        <span class="badge badge--muted">{{ item.templateLabel()|trans }}</span>
                    {% endif %}
                </span>
            </p>
        </div>
        <div class="actions">
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" x-show="savedTemplateSession" x-cloak @click="closeSavedDynamicTemplate()" :disabled="partialSaving"{% endblock %}{% block content %}{{ 'cms.dynamic.cancel_edit'|trans }}{% endblock %}{% endembed %}
            <span class="badge badge--muted" x-show="savedTemplateSession" x-cloak x-text="savedTemplateSession && savedTemplateSession.partial.name"></span>
            <div class="cms-builder-tabs" role="tablist" aria-label="{{ 'cms.builder.tabs'|trans }}">
                <span class="cms-builder__icon-state" x-show="status" :title="status" x-cloak>
                    <span class="material-symbols-outlined g-icon">schedule</span>
                </span>
                <span class="cms-builder__icon-state cms-builder__icon-state--warn" x-show="staged" x-cloak title="{{ 'cms.preview.staged'|trans }}">
                    <span class="material-symbols-outlined g-icon">pending</span>
                </span>
                <span class="cms-builder__icon-state cms-builder__icon-state--warn" x-show="dirty" x-cloak title="{{ 'cms.builder.unsaved'|trans }}">
                    <span class="material-symbols-outlined g-icon">edit_note</span>
                </span>
            </div>


            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost btn-sm" x-show="!savedTemplateSession && !boot.sandbox && boot.previewUrl"
                    @click="openPreview()" :disabled="saving || partialSaving"
                    title="{{ 'cms.pages.preview'|trans }}"{% endblock %}{% block content %}
                <span class="material-symbols-outlined g-icon" aria-hidden="true">visibility</span>
                <span class="sr-only">{{ 'cms.pages.preview'|trans }}</span>
            {% endblock %}{% endembed %}

            {% if not sandbox|default(false) %}
                <div x-data="cmsHomePage" data-is-home="{{ isHome ? '1' : '0' }}" data-confirm="{{ 'cms.pages.home.confirm'|trans({'%title%': item.title()})|e('html_attr') }}" data-label="{{ 'cms.pages.home.set'|trans|e('html_attr') }}" data-error="{{ 'cms.pages.home.error'|trans|e('html_attr') }}">
                    <form x-ref="form" method="post" action="{{ url('admin.cms.pages.home', {id: item.id()}) }}" @submit.prevent="setHome">
                        {{ csrf_field()|raw }}
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="submit" class="btn btn--ghost btn-sm" :disabled="isHome || busy"{% endblock %}{% block content %}
                            <span class="material-symbols-outlined g-icon" aria-hidden="true">home</span>
                            <span class="sr-only" x-show="!isHome">{{ 'cms.pages.home.set'|trans }}</span>
                            <span class="sr-only" x-show="isHome" x-cloak>{{ 'cms.pages.home.current'|trans }}</span>
                        {% endblock %}{% endembed %}
                    </form>
                </div>
            {% endif %}

            <div x-data="gereqCmsCssSettings">
                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost btn-sm" @click="openSettings" title="{{ 'cms.builder.site_styles'|trans }}"{% endblock %}{% block content %}
                    <span class="material-symbols-outlined g-icon" aria-hidden="true">palette</span>
                    <span class="sr-only">{{ 'cms.builder.site_styles'|trans }}</span>
                {% endblock %}{% endembed %}
                <div class="g-modal__backdrop" :class="open ? 'is-open' : ''" @click="closeSettings" x-cloak></div>
                {% embed 'ui/modal.html.twig' %}{% block component_attributes %} class="g-modal" :class="open ? 'is-open' : ''" role="dialog" aria-modal="true" :aria-hidden="open ? 'false' : 'true'" aria-labelledby="cms-site-styles-title" @keydown.escape.window="onEscape" x-cloak{% endblock %}{% block content %}
                    <div class="g-modal__panel g-modal__panel--editor cms-site-styles__panel" @click.stop>
                        <h3 class="g-modal__title" id="cms-site-styles-title">{{ 'cms.builder.site_styles'|trans }}</h3>
                        <p class="g-modal__body muted">{{ 'cms.builder.site_styles.help'|trans }}</p>
                        <form x-ref="form" data-error="{{ 'cms.builder.site_styles.error'|trans|e('html_attr') }}" class="cms-site-styles__form" action="{{ url('admin.cms.pages.settings.css') }}" method="post" @submit.prevent="saveSettings">
                            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                            {% include 'admin/settings/_css_editor.html.twig' with { key: 'cms.custom_css_public', field: 'cms__custom_css_public', values: { 'cms.custom_css_public': customCssPublic }, cssVariables: cssVariables, editorClass: 'css-editor--dialog' } only %}
                            <div class="g-modal__actions">
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" @click="closeSettings" :disabled="saving"{% endblock %}{% block content %}{{ 'common.cancel'|trans }}{% endblock %}{% endembed %}
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="submit" class="btn btn--primary" :disabled="saving"{% endblock %}{% block content %}{{ 'common.save'|trans }}{% endblock %}{% endembed %}
                            </div>
                        </form>
                    </div>
                {% endblock %}{% endembed %}
            </div>

            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost btn-sm" x-show="boot.storefrontUrl && boot.themeSaveUrl" :disabled="themeSaving" @click="togglePreviewTheme()" :title="previewTheme === 'dark' ? '{{ 'cms.builder.preview_theme.light'|trans|e('js') }}' : '{{ 'cms.builder.preview_theme.dark'|trans|e('js') }}'" :aria-label="previewTheme === 'dark' ? '{{ 'cms.builder.preview_theme.light'|trans|e('js') }}' : '{{ 'cms.builder.preview_theme.dark'|trans|e('js') }}'"{% endblock %}{% block content %}
                <span class="material-symbols-outlined g-icon" aria-hidden="true" x-text="previewTheme === 'dark' ? 'dark_mode' : 'light_mode'"></span>
            {% endblock %}{% endembed %}
            <div class="cms-builder__devices" role="group" aria-label="{{ 'cms.preview.devices'|trans }}">
                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost btn-sm" @click="deviceMenu = !deviceMenu" title="Zařízení"{% endblock %}{% block content %}
                    <span class="material-symbols-outlined g-icon" aria-hidden="true" x-show="device === 'desktop'">desktop_windows</span>
                    <span class="material-symbols-outlined g-icon" aria-hidden="true" x-show="device === 'tablet'">tablet_mac</span>
                    <span class="material-symbols-outlined g-icon" aria-hidden="true" x-show="device === 'mobile'">smartphone</span>
                {% endblock %}{% endembed %}
                <div class="cms-builder__device-menu" x-show="deviceMenu" x-cloak @click.outside="deviceMenu = false">
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" :class="device === 'desktop' && 'is-active'" @click="setDevice('desktop')" title="Desktop"{% endblock %}{% block content %}
                        <span class="material-symbols-outlined g-icon" aria-hidden="true">desktop_windows</span>
                    {% endblock %}{% endembed %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" :class="device === 'tablet' && 'is-active'" @click="setDevice('tablet')" title="Tablet"{% endblock %}{% block content %}
                        <span class="material-symbols-outlined g-icon" aria-hidden="true">tablet_mac</span>
                    {% endblock %}{% endembed %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" :class="device === 'mobile' && 'is-active'" @click="setDevice('mobile')" title="Mobile"{% endblock %}{% block content %}
                        <span class="material-symbols-outlined g-icon" aria-hidden="true">smartphone</span>
                    {% endblock %}{% endembed %}
                </div>
            </div>
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--primary" @click="save()" :disabled="saving || partialSaving"
                :title="(saving || partialSaving) ? (boot.labels.saving || '…') : '{{ (boot.sandbox ? 'cms.builder.sandbox.save' : 'cms.builder.save')|trans|e('js') }}'"{% endblock %}{% block content %}
                <span class="material-symbols-outlined g-icon" x-show="saving || partialSaving">progress_activity</span>
                <span class="material-symbols-outlined g-icon" x-show="!(saving || partialSaving)">save</span>
            {% endblock %}{% endembed %}
        </div>
    </header>

    <div class="cms-builder__workspace" :class="workspaceClass()">
        {# Boot overlay: skeleton + “Načítám…” dialog while iframe / Alpine settle. #}
        <div class="cms-builder__boot" x-show="previewLoading" x-cloak aria-busy="true" aria-live="polite">
            <div class="cms-builder__boot-dialog" role="dialog" aria-modal="true" aria-labelledby="cms-builder-boot-title">
                <span class="cms-builder__boot-spinner material-symbols-outlined g-icon" aria-hidden="true">progress_activity</span>
                <h3 class="cms-builder__boot-title" id="cms-builder-boot-title" x-text="boot.labels.loadingTitle || 'Načítám builder'">Načítám builder</h3>
                <p class="cms-builder__boot-body" x-text="boot.labels.loadingBody || 'Připravuji náhled a nástroje…'">Připravuji náhled a nástroje…</p>
            </div>
        </div>

        <aside class="cms-builder__library" x-show="modalTab || createOpen" x-cloak aria-label="{{ 'cms.builder.library'|trans }}">
            <header class="cms-builder__settings-chrome">
                <div class="cms-builder__settings-title">
                    <span class="material-symbols-outlined g-icon" aria-hidden="true">folder_open</span>
                    <span>{{ 'cms.builder.library'|trans }}</span>
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__layer-tool cms-builder__create-close" @click="closeLibrary()" title="{{ 'common.close'|trans }}"{% endblock %}{% block content %}
                        <span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>
                    {% endblock %}{% endembed %}
                </div>
            </header>
                <div class="cms-builder__design-tabs cms-builder__library-tabs" role="group">
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__design-tab" :class="createOpen && createTab === 'elements' && 'is-active'" @click="openLibraryTab('elements')"{% endblock %}{% block content %}{{ 'cms.builder.tab.add'|trans }}{% endblock %}{% endembed %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__design-tab" :class="createOpen && createTab === 'templates' && 'is-active'" @click="openLibraryTab('templates')"{% endblock %}{% block content %}{{ 'cms.builder.tab.templates'|trans }}{% endblock %}{% endembed %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__design-tab" x-show="!formInsertionContext" :class="!createOpen && modalTab === 'dynamic' && 'is-active'" @click="openLibraryTab('dynamic')"{% endblock %}{% block content %}{{ 'cms.dynamic.templates'|trans }}{% endblock %}{% endembed %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__design-tab" :class="!createOpen && modalTab === 'vars' && 'is-active'" @click="openLibraryTab('vars')"{% endblock %}{% block content %}
                        {{ 'cms.builder.tab.vars'|trans }}
                    {% endblock %}{% endembed %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__design-tab" :class="!createOpen && modalTab === 'media' && 'is-active'" @click="openLibraryTab('media')"{% endblock %}{% block content %}
                        {{ 'cms.builder.tab.media'|trans }}
                    {% endblock %}{% endembed %}
                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__design-tab" :class="!createOpen && modalTab === 'docs' && 'is-active'" @click="openLibraryTab('docs')"{% endblock %}{% block content %}
                        {{ 'cms.builder.tab.docs'|trans }}
                    {% endblock %}{% endembed %}
                </div>

        <div class="cms-builder__create"
            x-show="createOpen" x-cloak
>
            <div class="cms-builder__create-body">
                <div class="cms-builder__rail-body" x-show="createTab === 'elements'" x-cloak>
                    <div class="cms-builder__insertion-context">
                        <label class="field">{{ 'cms.builder.insert.placement'|trans }}
                            {% embed 'ui/select.html.twig' with { native: true } %}{% block root_attributes %}:data-native-value="effectiveInsertPlacement"{% endblock %}{% block native_attributes %} class="input" :value="effectiveInsertPlacement" @change="setInsertPlacement($event)"{% endblock %}{% block native_options %}
                                <template x-for="placement in insertionPlacements" :key="placement"><option :value="placement" :selected="placement === effectiveInsertPlacement" x-text="boot.labels['insert.' + placement] || placement"></option></template>
                            {% endblock %}{% endembed %}
                        </label>
                    </div>
                    <p class="muted">{{ 'cms.builder.add.hint'|trans }}</p>
                    <div class="cms-builder__add-grid">
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__add-card" x-show="canInsertDynamic" @click="openLibraryTab('dynamic')"{% endblock %}{% block content %}{{ 'cms.block.type.dynamic'|trans }}{% endblock %}{% endembed %}
                        <template x-for="bt in availableBlockTypes" :key="bt.value">
                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button"
                                    class="cms-builder__add-card"
                                    @click="addBlockAfterSelection(bt.value)"{% endblock %}{% block content %}
                                <span x-text="bt.label"></span>
                            {% endblock %}{% endembed %}
                        </template>
                    </div>
                </div>

                <div class="cms-builder__rail-body cms-builder__templates" x-show="createTab === 'templates'" x-cloak>
                    <p class="cms-builder__panel-lead" x-show="!boot.sandbox">{{ 'cms.builder.templates.hint'|trans }}</p>
                    <p class="cms-builder__panel-lead" x-show="boot.sandbox" x-cloak>{{ 'cms.builder.sandbox.hint'|trans }}</p>

                    <section class="cms-builder__tpl-section">
                        <header class="cms-builder__tpl-head">
                            <h3>{{ 'cms.builder.page_templates.title'|trans }}</h3>
                            <p>{{ 'cms.builder.layout_pages.hint'|trans }}</p>
                        </header>
                        <ul class="cms-builder__tpl-list">
                            <template x-for="tpl in layoutPageTemplates" :key="tpl.id">
                                <li>
                                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button"
                                            class="cms-builder__tpl-row"
                                            @click="insertLayoutPageTemplate(tpl.id)"
                                            @mouseenter="previewLayoutPage($event, tpl)"
                                            @mouseleave="scheduleHideTplPreview()"{% endblock %}{% block content %}
                                        <span class="cms-builder__tpl-row-icon material-symbols-outlined g-icon" aria-hidden="true">web</span>
                                        <span class="cms-builder__tpl-row-body">
                                            <span class="cms-builder__tpl-row-title" x-text="tpl.label"></span>
                                            <span class="cms-builder__tpl-row-desc" x-text="tpl.desc"></span>
                                        </span>
                                        <span class="cms-builder__tpl-row-meta" x-text="tpl.tag"></span>
                                    {% endblock %}{% endembed %}
                                </li>
                            </template>
                            <li x-show="boot.template === 'landing'" x-cloak>
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button"
                                        class="cms-builder__tpl-row"
                                        @click="insertOnePageTemplate()"
                                        @mouseenter="previewOnePage($event)"
                                        @mouseleave="scheduleHideTplPreview()"{% endblock %}{% block content %}
                                    <span class="cms-builder__tpl-row-icon material-symbols-outlined g-icon" aria-hidden="true">view_quilt</span>
                                    <span class="cms-builder__tpl-row-body">
                                        <span class="cms-builder__tpl-row-title">{{ 'cms.builder.onepage.insert'|trans }}</span>
                                        <span class="cms-builder__tpl-row-desc">landing · one-page</span>
                                    </span>
                                {% endblock %}{% endembed %}
                            </li>
                        </ul>
                    </section>

                    <section class="cms-builder__tpl-section">
                        <header class="cms-builder__tpl-head">
                            <h3>{{ 'cms.builder.sections.title'|trans }}</h3>
                            <p>{{ 'cms.builder.sections.hint'|trans }}</p>
                        </header>
                        <ul class="cms-builder__tpl-list">
                            <template x-for="sec in sectionPresets" :key="sec.kind">
                                <li>
                                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button"
                                            class="cms-builder__tpl-row"
                                            @click="insertSection(sec.kind)"
                                            @mouseenter="previewSection($event, sec)"
                                            @mouseleave="scheduleHideTplPreview()"{% endblock %}{% block content %}
                                        <span class="cms-builder__tpl-row-icon material-symbols-outlined g-icon" aria-hidden="true">dashboard</span>
                                        <span class="cms-builder__tpl-row-body">
                                            <span class="cms-builder__tpl-row-title" x-text="sec.label"></span>
                                            <span class="cms-builder__tpl-row-desc" x-text="sec.desc"></span>
                                        </span>
                                    {% endblock %}{% endembed %}
                                </li>
                            </template>
                        </ul>
                    </section>

                    <section class="cms-builder__tpl-section">
                        <header class="cms-builder__tpl-head">
                            <h3>{{ 'cms.builder.partials.title'|trans }}</h3>
                            <p>{{ 'cms.builder.partials.hint'|trans }}</p>
                        </header>
                        <div class="cms-builder__tpl-save">
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="text" x-model="partialName" maxlength="120" placeholder="{{ 'cms.builder.partials.name'|trans }}" @keydown.enter.prevent="savePartial()"{% endblock %}{% endembed %}
                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--primary btn-sm" :disabled="partialSaving" @click="savePartial()"{% endblock %}{% block content %}
                                <span x-text="partialSaving ? (boot.labels.saving || '…') : '{{ 'cms.builder.partials.save'|trans|e('js') }}'"></span>
                            {% endblock %}{% endembed %}
                        </div>
                        <ul class="cms-builder__tpl-list">
                            <template x-for="p in regularPartials()" :key="p.id">
                                <li>
                                    <div class="cms-builder__tpl-row cms-builder__tpl-row--partial">
                                        <span class="cms-builder__tpl-row-icon material-symbols-outlined g-icon" aria-hidden="true">bookmark</span>
                                        <span class="cms-builder__tpl-row-body">
                                            <span class="cms-builder__tpl-row-title" x-text="p.name"></span>
                                            <span class="cms-builder__tpl-row-desc">
                                                <span x-text="p.block_count"></span> {{ 'cms.builder.partials.blocks'|trans }}
                                                <span x-text="p.description" x-show="p.description"></span>
                                            </span>
                                        </span>
                                        <span class="cms-builder__tpl-row-actions">
                                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__layer-tool" @click="insertPartial(p)" title="{{ 'cms.builder.partials.insert'|trans }}"{% endblock %}{% block content %}
                                                <span class="material-symbols-outlined g-icon" aria-hidden="true">add</span>
                                            {% endblock %}{% endembed %}
                                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__layer-tool cms-builder__layer-tool--danger" @click="deletePartial(p)" title="{{ 'cms.builder.partials.delete'|trans }}"{% endblock %}{% block content %}
                                                <span class="material-symbols-outlined g-icon" aria-hidden="true">delete</span>
                                            {% endblock %}{% endembed %}
                                        </span>
                                    </div>
                                </li>
                            </template>
                        </ul>
                        <p class="muted" x-show="regularPartials().length === 0">{{ 'cms.builder.partials.empty'|trans }}</p>
                    </section>
                </div>
            </div>
        </div>

                <div class="cms-builder__library-body" x-show="!createOpen">
                    <div class="cms-builder__fields" x-show="modalTab === 'dynamic'" x-cloak>
                        <template x-if="!dynamicLibraryOwner">
                            <label class="field">{{ 'cms.dynamic.source'|trans }}
                                <select class="input" x-model="dynamicLibrarySourceId">
                                    <option value="">{{ 'cms.dynamic.choose'|trans }}</option>
                                    <template x-for="source in boot.dynamicSources || []" :key="source.id">
                                        <option :value="source.id" x-text="source.label"></option>
                                    </template>
                                </select>
                            </label>
                        </template>
                        <p class="muted" x-show="dynamicLibrarySources.length === 0">{{ 'cms.dynamic.select_source_hint'|trans }}</p>
                        <template x-for="source in dynamicLibrarySources" :key="source.id">
                            <section class="cms-builder__dynamic-source">
                                <h3 x-text="source.label"></h3>
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" x-show="source.fields.includes('rating')" @click="newDynamicTemplate('stars', source.id)"{% endblock %}{% block content %}{{ 'cms.dynamic.stars'|trans }}{% endblock %}{% endembed %}
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" x-show="source.id === 'reviews'" @click="newDynamicTemplate('card', source.id)"{% endblock %}{% block content %}{{ 'cms.dynamic.card'|trans }}{% endblock %}{% endembed %}
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" @click="newDynamicTemplate('custom', source.id)"{% endblock %}{% block content %}{{ 'cms.dynamic.custom'|trans }}{% endblock %}{% endembed %}
                                <template x-for="partial in sourceTemplates(source.id)" :key="partial.id">
                                    <div class="cms-builder__fields"><strong x-text="partial.name"></strong>{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" @click="insertPartial(partial)"{% endblock %}{% block content %}{{ 'cms.builder.partials.insert'|trans }}{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" @click="editSavedDynamicTemplate(partial)"{% endblock %}{% block content %}{{ 'cms.dynamic.edit_saved'|trans }}{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost" @click="deletePartial(partial)"{% endblock %}{% block content %}{{ 'cms.builder.partials.delete'|trans }}{% endblock %}{% endembed %}</div>
                                </template>
                            </section>
                        </template>
                        <template x-if="dynamicLibraryOwner && dynamicLibrarySources.length > 0">
                            <div class="cms-builder__fields">
                                <p class="muted" x-text="sourceLabel(dynamicLibraryOwner.payload.source || '')"></p>
                                <label>{{ 'cms.builder.partials.name'|trans }}<input class="input" x-model="partialName" maxlength="120"></label>
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--primary" @click="saveDynamicTemplate()" :disabled="partialSaving"{% endblock %}{% block content %}{{ 'cms.dynamic.save_template'|trans }}{% endblock %}{% endembed %}
                            </div>
                        </template>
                    </div>
                    <div x-show="modalTab === 'vars'" x-cloak>
                        <div class="cms-builder__vars-toolbar">
                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input cms-builder__vars-search" type="search" x-model="varFilter" placeholder="{{ 'cms.builder.vars.search'|trans }}"{% endblock %}{% endembed %}
                        </div>
                        <div class="cms-builder__vars-list">
                            <template x-for="group in variableGroups()" :key="group.group">
                                <details class="cms-builder__vars-group">
                                    <summary class="cms-builder__vars-group-head">
                                        <span class="cms-builder__vars-group-title" x-text="group.group"></span>
                                        <span class="cms-builder__vars-group-n" x-text="'(' + group.items.length + ')'"></span>
                                        <span class="material-symbols-outlined g-icon cms-builder__vars-chevron" aria-hidden="true">keyboard_arrow_down</span>
                                    </summary>
                                    <ul>
                                        <template x-for="item in group.items" :key="item.path">
                                            <li>
                                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__var" :class="'is-' + item.kind" @click="insertVariable(item.path)" :aria-label="item.label + ' ' + item.token"{% endblock %}{% block content %}
                                                    <span class="cms-builder__var-swatch" x-show="item.kind === 'color'" :style="'background:' + (boot.varValues[item.path] || item.example)"></span>
                                                    <span class="cms-builder__var-icon" x-show="item.kind !== 'color'" x-text="varKindIcon(item.kind)"></span>
                                                    <span class="cms-builder__var-body">
                                                        <span class="cms-builder__var-label" x-text="item.label"></span>
                                                        <span class="cms-builder__var-tooltip" role="tooltip" x-text="item.token"></span>
                                                    </span>
                                                {% endblock %}{% endembed %}
                                            </li>
                                        </template>
                                    </ul>
                                </details>
                            </template>
                            <details class="cms-builder__vars-group" x-show="connectionGroups().length > 0" :open="varFilter.length > 0">
                                <summary class="cms-builder__vars-group-head">
                                    <span class="cms-builder__vars-group-title">{{ 'cms.builder.vars.connections'|trans }}</span>
                                    <span class="cms-builder__vars-group-n" x-text="'(' + connectionGroups().length + ')'"></span>
                                    <span class="material-symbols-outlined g-icon cms-builder__vars-chevron" aria-hidden="true">keyboard_arrow_down</span>
                                </summary>
                                <div class="cms-builder__connections">
                                    <template x-for="source in connectionGroups()" :key="source.id">
                                        <details class="cms-builder__vars-group" :open="varFilter.length > 0">
                                            <summary class="cms-builder__vars-group-head">
                                                <span class="cms-builder__connection-title" x-text="source.label"></span>
                                                <span class="cms-builder__vars-group-n" x-text="'(' + source.fields.length + ')'"></span>
                                                <span class="material-symbols-outlined g-icon cms-builder__vars-chevron" aria-hidden="true">keyboard_arrow_down</span>
                                            </summary>
                                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost btn--sm" @click="addConnection(source.id)"{% endblock %}{% block content %}{{ 'cms.builder.vars.add_connection'|trans }}{% endblock %}{% endembed %}
                                            <ul>
                                                <template x-for="field in source.fields" :key="field">
                                                    <li>{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__var" @click="insertConnectionVariable(source.id, field)"{% endblock %}{% block content %}
                                                        <span class="cms-builder__var-icon">↗</span>
                                                        <span class="cms-builder__var-body"><span class="cms-builder__var-label" x-text="field"></span><span class="cms-builder__var-tooltip" role="tooltip" x-text="connectionToken(field)"></span></span>
                                                    {% endblock %}{% endembed %}</li>
                                                </template>
                                            </ul>
                                        </details>
                                    </template>
                                </div>
                            </details>
                            <p class="muted cms-builder__vars-empty" x-show="filteredVariables.length === 0 && connectionGroups().length === 0">{{ 'cms.builder.vars.empty'|trans }}</p>
                        </div>
                    </div>

                    <div x-show="modalTab === 'media'" x-cloak>
                        <div class="cms-builder-upload"
                             x-show="boot.mediaUploadUrl"
                             :class="mediaUploadClass()"
                             @dragenter.prevent="onMediaDragOver($event)"
                             @dragover.prevent="onMediaDragOver($event)"
                             @dragleave.prevent="onMediaDragLeave($event)"
                             @drop.prevent="onMediaDrop($event)">
                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button"
                                    class="btn btn--primary btn-sm"
                                    @click="pickMediaFiles()"
                                    :disabled="mediaUploading"{% endblock %}{% block content %}
                                <span class="material-symbols-outlined g-icon" aria-hidden="true">upload</span>
                                <span x-show="!mediaUploading">{{ 'cms.builder.media.upload'|trans }}</span>
                                <span x-show="mediaUploading" x-cloak>{{ 'cms.builder.media.uploading'|trans }}</span>
                            {% endblock %}{% endembed %}
                            <p class="muted cms-builder-upload__hint">{{ 'cms.builder.media.upload_hint'|trans }}</p>
                            <p class="cms-builder-upload__error" x-show="mediaUploadError" x-text="mediaUploadError" x-cloak></p>
                        </div>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="search" placeholder="{{ 'cms.builder.media.search'|trans }}" x-model="mediaQuery"{% endblock %}{% endembed %}
                        <template x-if="filteredMedia.length === 0">
                            <p class="muted">{{ 'cms.builder.media.empty'|trans }}</p>
                        </template>
                        <div class="cms-builder__media-grid">
                            <template x-for="m in filteredMedia" :key="m.id">
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__media-card"
                                    :class="mediaMode === 'gallery' && selected && selected.type === 'gallery' && isInGallery(m.id) && 'is-selected'"
                                    @click="selected && selected.type === 'gallery' ? toggleGalleryMedia(m) : applyMedia(m)"
                                    :title="m.title"{% endblock %}{% block content %}
                                    <span class="cms-builder__media-thumb">
                                        <img :src="m.url" :alt="m.alt || m.title" loading="lazy">
                                        <span class="cms-builder-picker__check"
                                            x-show="mediaMode === 'gallery' && selected && selected.type === 'gallery' && isInGallery(m.id)" x-cloak>✓</span>
                                    </span>
                                    <span x-text="m.title"></span>
                                {% endblock %}{% endembed %}
                            </template>
                        </div>
                    </div>

                    <div x-show="modalTab === 'docs'" x-cloak>
                        {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="input" type="search" placeholder="{{ 'cms.builder.docs.search'|trans }}" x-model="docsQuery"{% endblock %}{% endembed %}
                        <template x-if="filteredDocs.length === 0">
                            <p class="muted">{{ 'cms.builder.docs.empty'|trans }}</p>
                        </template>
                        <ul class="cms-builder__docs">
                            <template x-for="d in filteredDocs" :key="d.id">
                                <li>
                                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__doc" @click="applyDocument(d)"{% endblock %}{% block content %}
                                        <strong x-text="d.title"></strong>
                                        <span class="muted" x-text="d.mime"></span>
                                    {% endblock %}{% endembed %}
                                </li>
                            </template>
                        </ul>
                    </div>
                </div>
        </aside>

        <div class="cms-builder__tpl-preview"
             x-show="tplHover"
             x-cloak
             :style="tplPreviewStyle()"
             @mouseenter="keepTplPreview()"
             @mouseleave="scheduleHideTplPreview()">
            <div class="cms-builder__tpl-preview-chrome">
                <strong class="cms-builder__tpl-preview-title" x-text="tplHoverTitle()"></strong>
                <span class="cms-builder__tpl-preview-desc" x-text="tplHoverDesc()" x-show="tplHoverDesc()"></span>
            </div>
            <div class="cms-builder__tpl-preview-canvas" aria-hidden="true">
                <div class="cms-tpl-wire">
                    <template x-for="row in tplHoverWire()" :key="row.k">
                        <div :class="wireClass(row.t)">
                            <div class="cms-tpl-wire__kids" x-show="wireHasKids(row)">
                                <template x-for="kid in wireKids(row)" :key="kid.k">
                                    <div :class="wireClass(kid.t)">
                                        <div class="cms-tpl-wire__kids" x-show="wireHasKids(kid)">
                                            <template x-for="g in wireKids(kid)" :key="g.k">
                                                <div :class="wireClass(g.t)"></div>
                                            </template>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        {% embed 'ui/panel.html.twig' with { panel_options: { tag: 'main' } } %}{% block attributes %} class="panel cms-builder__stage"{% endblock %}{% block content %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="btn btn--ghost btn-sm cms-builder__library-toggle"
                    x-show="!modalTab && !createOpen" x-cloak
                    @click="toggleLibrary" :aria-expanded="modalTab !== null || createOpen"
                    title="{{ 'cms.builder.library'|trans }}" aria-label="{{ 'cms.builder.library'|trans }}"{% endblock %}{% block content %}
                <span class="material-symbols-outlined g-icon" aria-hidden="true">folder_open</span>
            {% endblock %}{% endembed %}
            <div class="cms-builder__frame" :class="'is-' + device + (previewLoading ? ' is-booting' : '')">
                <div class="cms-builder__skeleton" x-show="previewLoading" x-cloak aria-hidden="true">
                    <div class="cms-builder__skeleton-bar"></div>
                    <div class="cms-builder__skeleton-hero"></div>
                    <div class="cms-builder__skeleton-lines">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="cms-builder__skeleton-cards">
                        <span></span><span></span><span></span>
                    </div>
                </div>
                {# iframe: no Alpine bindings (CSP build forbids evaluating expressions on iframes). #}
                {% if boot.storefrontUrl %}
                    <iframe id="cmsPreview"
                        class="cms-builder__preview"
                        src="{{ boot.storefrontUrl }}?edit=1"
                        title="CMS Preview"></iframe>
                {% endif %}
                <article class="cms-builder-page" x-show="!previewLoading && !boot.storefrontUrl" x-cloak :class="'cms-builder-page--' + boot.template">
                    <header class="cms-builder-page__head">
                        <p class="cms-builder-page__eyebrow" x-text="'/' + boot.slug"></p>
                    </header>
                    <div class="cms-builder-page__body">
                        <template x-if="blocks.length === 0">
                            <div class="empty">
                                <h2>{{ 'cms.blocks.empty'|trans }}</h2>
                                <p>{{ 'cms.builder.canvas.empty_hint'|trans }}</p>
                                <div class="cms-builder__empty-actions">
                                    {% include 'ui/button.html.twig' with {
                                        label: 'cms.builder.onepage.insert'|trans,
                                        type: 'button',
                                        variant: 'primary',
                                        class: 'btn-sm',
                                        attrs: { 'x-show': 'boot.template === \'landing\'', '@click': 'insertOnePageTemplate()' }
                                    } only %}
                                    {% include 'ui/button.html.twig' with {
                                        label: 'cms.builder.tab.add'|trans,
                                        type: 'button',
                                        variant: 'ghost',
                                        class: 'btn-sm',
                                        attrs: { '@click': 'openLibraryTab(\'elements\')' }
                                    } only %}
                                </div>
                            </div>
                        </template>
                        <template x-for="block in blocks" :key="block.id">
                            <section class="cms-builder-block"
                                     :class="'cms-builder-block--' + block.type + ' ' + blockSpacingClass(block) + ' ' + blockAlignClass(block) + ' ' + blockStyleClass(block) + (selectedId === block.id ? ' is-selected' : '')"
                                     :style="blockInlineStyle(block)"
                                     @click="select(block.id)">
                                <template x-if="block.type === 'heading'">
                                    <div class="cms-builder-block__heading">
                                        <h1 class="cms-builder-heading cms-builder-heading--1"
                                            x-show="isH1(block) && !isInline(block, 'text')"
                                            x-text="headingText(block)"
                                            @click.stop="onCanvasTextClick(block, 'text', $event)"
                                            @dblclick.stop="startInline(block, 'text')"></h1>
                                        <h2 class="cms-builder-heading cms-builder-heading--2"
                                            x-show="isH2(block) && !isInline(block, 'text')"
                                            x-text="headingText(block)"
                                            @click.stop="onCanvasTextClick(block, 'text', $event)"
                                            @dblclick.stop="startInline(block, 'text')"></h2>
                                        <h3 class="cms-builder-heading cms-builder-heading--3"
                                            x-show="isH3(block) && !isInline(block, 'text')"
                                            x-text="headingText(block)"
                                            @click.stop="onCanvasTextClick(block, 'text', $event)"
                                            @dblclick.stop="startInline(block, 'text')"></h3>
                                        <div class="cms-builder-heading is-editing"
                                             :class="headingEditClass(block)"
                                             x-show="isInline(block, 'text')"
                                             contenteditable="true"
                                             :data-inline="inlineAttr(block, 'text')"
                                             @mousedown.stop
                                             @click.stop
                                             @input="onInlinePlainInput(block, 'text', $event)"
                                             @blur="endInline(block, 'text', $event)"
                                             @keydown.enter.prevent="blurTarget($event)"></div>
                                    </div>
                                </template>
                                <template x-if="block.type === 'text'">
                                    <div class="cms-builder-block__text">
                                        <div class="cms-builder-block__rich"
                                             x-show="!isInline(block, 'body')"
                                             x-text="canvasPlain(block.payload.body)"
                                             @click.stop="onCanvasTextClick(block, 'body', $event)"
                                             @dblclick.stop="startInline(block, 'body')"></div>
                                        <template x-for="b in inlineRichBlocks(block, 'body')" :key="'cv-body-' + b.id">
                                            <div class="cms-builder-canvas-editor"
                                                 :data-editor-seed="payloadStrFor(b, 'body')"
                                                 data-editor-key="body"
                                                 @focusin="focusField('body')"
                                                 @input="onCanvasEditorPayload(b, 'body', $event)"
                                                 @keydown.escape.stop="closeInline()"
                                                 @mousedown.stop
                                                 @click.stop>
                                                {% include 'ui/_editor_core.html.twig' with {
                                                    id: 'cms-canvas-body',
                                                    name: '',
                                                    value: '',
                                                    highlight_vars: true,
                                                    extra_class: 'g-editor--canvas',
                                                } only %}
                                            </div>
                                        </template>
                                    </div>
                                </template>
                                <template x-if="block.type === 'html'">
                                    <div class="cms-builder-block__text">
                                        <div class="cms-builder-block__rich"
                                             x-show="!isInline(block, 'html')"
                                             x-text="canvasPlain(block.payload.html)"
                                             @click.stop="onCanvasTextClick(block, 'html', $event)"
                                             @dblclick.stop="startInline(block, 'html')"></div>
                                        <template x-for="b in inlineRichBlocks(block, 'html')" :key="'cv-html-' + b.id">
                                            <div class="cms-builder-canvas-editor"
                                                 :data-editor-seed="payloadStrFor(b, 'html')"
                                                 data-editor-key="html"
                                                 @focusin="focusField('html')"
                                                 @input="onCanvasEditorPayload(b, 'html', $event)"
                                                 @keydown.escape.stop="closeInline()"
                                                 @mousedown.stop
                                                 @click.stop>
                                                {% include 'ui/_editor_core.html.twig' with {
                                                    id: 'cms-canvas-html',
                                                    name: '',
                                                    value: '',
                                                    highlight_vars: true,
                                                    extra_class: 'g-editor--canvas',
                                                } only %}
                                            </div>
                                        </template>
                                    </div>
                                </template>
                                <template x-if="block.type === 'table'">
                                    <div class="cms-builder-block__text">
                                        <p x-show="captionVisibleOn(block)" x-text="captionText(block)"></p>
                                        <div class="cms-builder-block__rich"
                                             x-show="!isInline(block, 'html')"
                                             x-text="canvasPlain(block.payload.html)"
                                             @click.stop="onCanvasTextClick(block, 'html', $event)"
                                             @dblclick.stop="startInline(block, 'html')"></div>
                                        <template x-for="b in inlineRichBlocks(block, 'html')" :key="'cv-table-' + b.id">
                                            <div class="cms-builder-canvas-editor"
                                                 :data-editor-seed="payloadStrFor(b, 'html')"
                                                 data-editor-key="html"
                                                 @focusin="focusField('html')"
                                                 @input="onCanvasEditorPayload(b, 'html', $event)"
                                                 @keydown.escape.stop="closeInline()"
                                                 @mousedown.stop
                                                 @click.stop>
                                                {% include 'ui/_editor_core.html.twig' with {
                                                    id: 'cms-canvas-table',
                                                    name: '',
                                                    value: '',
                                                    highlight_vars: true,
                                                    extra_class: 'g-editor--canvas',
                                                    tables: true,
                                                } only %}
                                            </div>
                                        </template>
                                    </div>
                                </template>
                                <template x-if="block.type === 'image'">
                                    <figure :class="imageFigureClass(block)">
                                        <img x-show="imageSrc(block)" :src="imageSrc(block)" :alt="block.payload.alt || ''">
                                        <p class="muted" x-show="!imageSrc(block)">{{ 'cms.builder.image.placeholder'|trans }}</p>
                                        <figcaption x-show="block.payload.caption" x-text="captionText(block)"></figcaption>
                                    </figure>
                                </template>
                                <template x-if="block.type === 'cta'">
                                    <p>
                                        <span class="btn"
                                              :class="ctaClass(block)"
                                              x-show="!isInline(block, 'label')"
                                              x-text="ctaLabel(block)"
                                              @click.stop="onCanvasTextClick(block, 'label', $event)"
                                              @dblclick.stop="startInline(block, 'label')"></span>
                                        <span class="btn is-editing"
                                              :class="ctaClass(block)"
                                              x-show="isInline(block, 'label')"
                                              contenteditable="true"
                                              :data-inline="inlineAttr(block, 'label')"
                                              @mousedown.stop
                                              @click.stop
                                              @input="onInlinePlainInput(block, 'label', $event)"
                                              @blur="endInline(block, 'label', $event)"
                                              @keydown.enter.prevent="blurTarget($event)"></span>
                                    </p>
                                </template>

                                <template x-if="block.type === 'divider'">
                                    <div class="cms-preview-divider-wrap">
                                        <hr class="cms-preview-divider">
                                        <span class="cms-preview-divider-label" x-text="dividerLabel(block)"></span>
                                    </div>
                                </template>
                                <template x-if="block.type === 'gallery'">
                                    <div>
                                        <p class="cms-builder-gallery__meta muted" x-show="galleryThumbs(block).length > 0"
                                           x-text="galleryVariantLabel(block)"></p>
                                        <div class="cms-builder-gallery"
                                             :class="'cms-builder-gallery--' + (block.payload.variant || 'grid')"
                                             x-show="galleryThumbs(block).length > 0">
                                            <template x-for="thumb in galleryThumbs(block)" :key="thumb.id">
                                                <img :src="thumb.url" :alt="thumb.alt || thumb.title" loading="lazy">
                                            </template>
                                        </div>
                                        <p class="muted" x-show="galleryThumbs(block).length === 0">{{ 'cms.block.type.gallery'|trans }}: <span x-text="block.payload.media_ids || '—'"></span></p>
                                    </div>
                                </template>
                                <template x-if="block.type === 'dynamic'">
                                    <div><strong>{{ 'cms.block.type.dynamic'|trans }}</strong><p x-text="block.payload.source"></p><template x-for="(html, index) in dynamicItems(block)" :key="index"><div x-text="canvasPlain(html)"></div></template><p x-show="dynamicItems(block).length === 0" x-text="block.payload.empty_text"></p></div>
                                </template>
                                <template x-if="block.type === 'products'">
                                    <p class="muted">{{ 'cms.block.type.products'|trans }}: <span x-text="block.payload.product_ids || '—'"></span></p>
                                </template>

                                <template x-if="block.type === 'widget'"><div class="muted" x-text="block.payload.title || block.payload.provider"></div></template>
                                <template x-if="block.type === 'avatar'"><span x-text="block.payload.initials || block.payload.name || '?'" style="display:inline-grid;place-items:center;width:38px;height:38px;border-radius:50%;background:#dbe3cc"></span></template>
                                <template x-if="block.type === 'badge'"><span class="badge" x-text="block.payload.label"></span></template>
                                <template x-if="block.type === 'rating'"><span class="cms-builder__rating" x-text="ratingStars(block)"></span></template>
                                <template x-if="block.type === 'quote'">
                                    <blockquote class="cms-builder-quote">
                                        <p x-show="!isInline(block, 'quote')"
                                           x-text="quoteText(block)"
                                           @click.stop="onCanvasTextClick(block, 'quote', $event)"
                                           @dblclick.stop="startInline(block, 'quote')"></p>
                                        <p class="is-editing"
                                           x-show="isInline(block, 'quote')"
                                           contenteditable="true"
