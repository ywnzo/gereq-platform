<details class="cms-builder__inspector-accordion" open><summary>{{ 'cms.builder.prop.shadows'|trans }}</summary>
<div class="cms-prop__row" x-show="!hasShadow(selected)"><span class="cms-prop__label">{{ 'cms.builder.prop.shadows'|trans }}</span>
                                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__add" @click="addShadow()"{% endblock %}{% block content %}{{ 'cms.builder.prop.add'|trans }}{% endblock %}{% endembed %}
                                </div>
                                <template x-if="hasShadow(selected)">
                                    <div>
                                        <div class="cms-prop__row"><span class="cms-prop__label">{{ 'cms.builder.prop.shadows'|trans }}</span>
                                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__add" @click="clearShadow()"{% endblock %}{% block content %}{{ 'cms.builder.prop.remove'|trans }}{% endblock %}{% endembed %}
                                        </div>
                                        <div class="cms-prop__row"><span class="cms-prop__label"></span>
                                            {% embed 'ui/select.html.twig' with { native: true } %}
                                                {% block root_attributes %}:data-native-value="selected.payload.shadow || 'soft'"{% endblock %}
                                                {% block native_attributes %} class="cms-prop__control" :value="selected.payload.shadow || 'soft'" @change="onTextInput('shadow', $event)"{% endblock %}
                                                {% block native_options %}
                                                {% include 'ui/option.html.twig' with { value: 'soft', label: 'cms.block.img_shadow.soft'|trans } only %}
                                                {% include 'ui/option.html.twig' with { value: 'strong', label: 'cms.block.img_shadow.strong'|trans } only %}
                                            {% endblock %}
                                            {% endembed %}
                                        </div>
                                    </div>
                                </template>

                                </details>
<details class="cms-builder__inspector-accordion cms-builder__spacing-accordion" open><summary>{{ 'cms.block.field.spacing'|trans }}</summary>
<div class="cms-prop__row"><span class="cms-prop__label">{{ 'cms.builder.prop.radius'|trans }}</span>
                                    <div class="cms-prop__inline">
                                        {% embed 'ui/range.html.twig' with { range_options: { control_only: true } } %}{% block input_attributes %} class="cms-prop__range" type="range" min="0" max="50" step="1"
                                            :value="selected.payload.radius || 0"
                                            @input="onNumberPayload('radius', $event, 0, 50)"{% endblock %}{% endembed %}
                                        <span class="cms-builder__number-reset-wrap">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="cms-prop__control cms-prop__control--num" type="number" min="0" max="50"
                                            :value="selected.payload.radius || 0"
                                            @input="onNumberPayload('radius', $event, 0, 50)"{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__spacing-reset" aria-label="{{ 'admin.roles.permissions.clear'|trans }}" title="{{ 'admin.roles.permissions.clear'|trans }}" :disabled="isNumberDefault('radius', 0, 'payload')" @click.stop.prevent="resetNumberInput('radius', 0, 'payload', $event)"{% endblock %}{% block content %}<span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>{% endblock %}{% endembed %}</span>
                                    </div>
                                </div>
                                {% for kind in ['margin', 'padding'] %}
                                    <details class="cms-builder__inspector-accordion">
                                        <summary>{{ ('cms.builder.prop.' ~ kind)|trans }}</summary>
                                        {% for side in ['top', 'right', 'bottom', 'left'] %}
                                            <div class="cms-prop__row"><label class="cms-prop__label" for="block-{{ kind }}-{{ side }}">{{ ('cms.builder.spacing.' ~ side)|trans }}</label>
                                                <div class="cms-prop__inline">
                                                    {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} id="block-{{ kind }}-{{ side }}" class="cms-prop__control cms-prop__control--num" type="number" min="0" max="{{ kind == 'margin' ? 256 : 512 }}" placeholder="{{ 'cms.builder.spacing.inherit'|trans }}" :value="payloadOptionalNum('{{ kind }}_{{ side }}')" @input="onOptionalSpacing('{{ kind }}_{{ side }}', $event, {{ kind == 'margin' ? 256 : 512 }})"{% endblock %}{% endembed %}
                                                    <span class="cms-prop__unit">px</span>
                                                    {% set resetLabel = ('admin.roles.permissions.clear'|trans) ~ ': ' ~ (('cms.builder.prop.' ~ kind)|trans) ~ ' – ' ~ (('cms.builder.spacing.' ~ side)|trans) %}
                                                    {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__spacing-reset" title="{{ resetLabel }}" aria-label="{{ resetLabel }}" :disabled="selected.payload.{{ kind }}_{{ side }} === undefined || selected.payload.{{ kind }}_{{ side }} === null || selected.payload.{{ kind }}_{{ side }} === ''" @click="resetSpacing('{{ kind }}_{{ side }}', $event)"{% endblock %}{% block content %}<span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>{% endblock %}{% endembed %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </details>
                                {% endfor %}
                                </details>

                            </div>
                        </section>

                        <section class="cms-prop" x-show="designSection === 'typography'" x-cloak>
                            <div class="cms-prop__body"><details class="cms-builder__inspector-accordion" open><summary>{{ 'cms.builder.prop.typography'|trans }}</summary>
                                <div class="cms-prop__row"><span class="cms-prop__label">{{ 'cms.builder.prop.font_family'|trans }}</span>
                                    {% embed 'ui/select.html.twig' with { native: true } %}
                                        {% block root_attributes %}:data-native-value="selected.payload.font_family || 'inherit'"{% endblock %}
                                        {% block native_attributes %} class="cms-prop__control" :value="selected.payload.font_family || 'inherit'" @change="onTextInput('font_family', $event)"{% endblock %}
                                        {% block native_options %}
                                        {% include 'ui/option.html.twig' with { value: 'inherit', label: 'cms.builder.color.inherit'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'sans', label: 'Sans' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'display', label: 'Display' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'serif', label: 'Serif' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'mono', label: 'Mono' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'system', label: 'cms.builder.font.system'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'arial', label: 'Arial' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'verdana', label: 'Verdana' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'tahoma', label: 'Tahoma' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'trebuchet', label: 'Trebuchet MS' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'georgia', label: 'Georgia' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'times', label: 'Times New Roman' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'palatino', label: 'Palatino' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'courier', label: 'Courier New' } only %}
                                        {% include 'ui/option.html.twig' with { value: 'impact', label: 'Impact' } only %}
                                    {% endblock %}
                                    {% endembed %}
                                </div>
                                <div class="cms-prop__row"><span class="cms-prop__label">{{ 'cms.builder.prop.font_size'|trans }}</span>
                                    {% embed 'ui/select.html.twig' with { native: true } %}
                                        {% block root_attributes %}:data-native-value="selected.payload.font_size || 'inherit'"{% endblock %}
                                        {% block native_attributes %} class="cms-prop__control" :value="selected.payload.font_size || 'inherit'" @change="onTextInput('font_size', $event)"{% endblock %}
                                        {% block native_options %}
                                        {% include 'ui/option.html.twig' with { value: 'inherit', label: 'cms.builder.color.inherit'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'sm', label: 'cms.builder.size.sm'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'md', label: 'cms.builder.size.md'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'lg', label: 'cms.builder.size.lg'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'xl', label: 'cms.builder.size.xl'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: '2xl', label: 'cms.builder.size.2xl'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: '3xl', label: 'cms.builder.size.3xl'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'eyebrow', label: 'cms.builder.size.eyebrow'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'display-sm', label: 'cms.builder.size.display_sm'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'display-md', label: 'cms.builder.size.display_md'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'display', label: 'cms.builder.size.display'|trans } only %}
                                    {% endblock %}
                                    {% endembed %}
                                </div>
                                <div class="cms-prop__row"><span class="cms-prop__label">{{ 'cms.builder.prop.font_weight'|trans }}</span>
                                    {% embed 'ui/select.html.twig' with { native: true } %}
                                        {% block root_attributes %}:data-native-value="selected.payload.font_weight || 'inherit'"{% endblock %}
                                        {% block native_attributes %} class="cms-prop__control" :value="selected.payload.font_weight || 'inherit'" @change="onTextInput('font_weight', $event)"{% endblock %}
                                        {% block native_options %}
                                        {% include 'ui/option.html.twig' with { value: 'inherit', label: 'cms.builder.color.inherit'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'normal', label: 'cms.builder.weight.normal'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'medium', label: 'cms.builder.weight.medium'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'semibold', label: 'cms.builder.weight.semibold'|trans } only %}
                                        {% include 'ui/option.html.twig' with { value: 'bold', label: 'cms.builder.weight.bold'|trans } only %}
                                    {% endblock %}
                                    {% endembed %}
                                </div>
                            </details></div>
                        </section>

                        <template x-if="selected && (selected.type === 'image' || selected.type === 'gallery')">
                            <section class="cms-prop" x-show="designSection === 'image'" x-cloak>
                                <div class="cms-prop__body"><details class="cms-builder__inspector-accordion" open><summary>{{ 'cms.builder.prop.image'|trans }}</summary>
                                    <label class="cms-prop__row">
                                        <span class="cms-prop__label">{{ 'cms.builder.prop.image_width'|trans }}</span>
                                        <span class="cms-builder__number-reset-wrap">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="cms-prop__control cms-prop__control--num" type="number" min="0" max="4096" :value="payloadNum('image_width', 0)" @change="onNumberPayload('image_width', $event, 0, 4096)"{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__spacing-reset" aria-label="{{ 'admin.roles.permissions.clear'|trans }}" title="{{ 'admin.roles.permissions.clear'|trans }}" :disabled="isNumberDefault('image_width', 0, 'payload')" @click.stop.prevent="resetNumberInput('image_width', 0, 'payload', $event)"{% endblock %}{% block content %}<span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>{% endblock %}{% endembed %}</span>
                                    </label>
                                    <label class="cms-prop__row">
                                        <span class="cms-prop__label">{{ 'cms.builder.prop.image_height'|trans }}</span>
                                        <span class="cms-builder__number-reset-wrap">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="cms-prop__control cms-prop__control--num" type="number" min="0" max="4096" :value="payloadNum('image_height', 0)" @change="onNumberPayload('image_height', $event, 0, 4096)"{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__spacing-reset" aria-label="{{ 'admin.roles.permissions.clear'|trans }}" title="{{ 'admin.roles.permissions.clear'|trans }}" :disabled="isNumberDefault('image_height', 0, 'payload')" @click.stop.prevent="resetNumberInput('image_height', 0, 'payload', $event)"{% endblock %}{% block content %}<span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>{% endblock %}{% endembed %}</span>
                                    </label>
                                    <label class="cms-prop__row" x-show="selected.type === 'gallery'">
                                        <span class="cms-prop__label">{{ 'cms.builder.prop.gallery_thumb_width'|trans }}</span>
                                        <span class="cms-builder__number-reset-wrap">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="cms-prop__control cms-prop__control--num" type="number" min="0" max="512" :value="payloadNum('gallery_thumb_width', 0)" @change="onNumberPayload('gallery_thumb_width', $event, 0, 512)"{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__spacing-reset" aria-label="{{ 'admin.roles.permissions.clear'|trans }}" title="{{ 'admin.roles.permissions.clear'|trans }}" :disabled="isNumberDefault('gallery_thumb_width', 0, 'payload')" @click.stop.prevent="resetNumberInput('gallery_thumb_width', 0, 'payload', $event)"{% endblock %}{% block content %}<span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>{% endblock %}{% endembed %}</span>
                                    </label>
                                    <label class="cms-prop__row" x-show="selected.type === 'gallery'">
                                        <span class="cms-prop__label">{{ 'cms.builder.prop.gallery_thumb_height'|trans }}</span>
                                        <span class="cms-builder__number-reset-wrap">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="cms-prop__control cms-prop__control--num" type="number" min="0" max="512" :value="payloadNum('gallery_thumb_height', 0)" @change="onNumberPayload('gallery_thumb_height', $event, 0, 512)"{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__spacing-reset" aria-label="{{ 'admin.roles.permissions.clear'|trans }}" title="{{ 'admin.roles.permissions.clear'|trans }}" :disabled="isNumberDefault('gallery_thumb_height', 0, 'payload')" @click.stop.prevent="resetNumberInput('gallery_thumb_height', 0, 'payload', $event)"{% endblock %}{% block content %}<span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>{% endblock %}{% endembed %}</span>
                                    </label>
                                    <label class="cms-prop__row">
                                        <span class="cms-prop__label">{{ 'cms.builder.prop.image_zoom_width'|trans }}</span>
                                        <span class="cms-builder__number-reset-wrap">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="cms-prop__control cms-prop__control--num" type="number" min="0" max="4096" :value="payloadNum('image_zoom_width', 0)" @change="onNumberPayload('image_zoom_width', $event, 0, 4096)"{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__spacing-reset" aria-label="{{ 'admin.roles.permissions.clear'|trans }}" title="{{ 'admin.roles.permissions.clear'|trans }}" :disabled="isNumberDefault('image_zoom_width', 0, 'payload')" @click.stop.prevent="resetNumberInput('image_zoom_width', 0, 'payload', $event)"{% endblock %}{% block content %}<span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>{% endblock %}{% endembed %}</span>
                                    </label>
                                    <label class="cms-prop__row">
                                        <span class="cms-prop__label">{{ 'cms.builder.prop.image_zoom_height'|trans }}</span>
                                        <span class="cms-builder__number-reset-wrap">{% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} class="cms-prop__control cms-prop__control--num" type="number" min="0" max="4096" :value="payloadNum('image_zoom_height', 0)" @change="onNumberPayload('image_zoom_height', $event, 0, 4096)"{% endblock %}{% endembed %}{% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__spacing-reset" aria-label="{{ 'admin.roles.permissions.clear'|trans }}" title="{{ 'admin.roles.permissions.clear'|trans }}" :disabled="isNumberDefault('image_zoom_height', 0, 'payload')" @click.stop.prevent="resetNumberInput('image_zoom_height', 0, 'payload', $event)"{% endblock %}{% block content %}<span class="material-symbols-outlined g-icon" aria-hidden="true">close</span>{% endblock %}{% endembed %}</span>
                                    </label>
                                    <p class="muted">{{ 'cms.builder.prop.image_size_hint'|trans }}</p>
                                    <div class="cms-prop__row"><span class="cms-prop__label">{{ 'cms.block.field.img_fit'|trans }}</span>
                                        {% embed 'ui/select.html.twig' with { native: true } %}
                                            {% block root_attributes %}:data-native-value="selected.payload.img_fit || 'contain'"{% endblock %}
                                            {% block native_attributes %} class="cms-prop__control" :value="selected.payload.img_fit || 'contain'" @change="onTextInput('img_fit', $event)"{% endblock %}
                                            {% block native_options %}
                                            {% include 'ui/option.html.twig' with { value: 'cover', label: 'cover' } only %}
                                            {% include 'ui/option.html.twig' with { value: 'contain', label: 'contain' } only %}
                                            {% include 'ui/option.html.twig' with { value: 'fill', label: 'fill' } only %}
                                        {% endblock %}
                                        {% endembed %}
                                    </div>
                                    <div class="cms-prop__row"><span class="cms-prop__label">{{ 'cms.builder.prop.priority'|trans }}</span>
                                        <div class="cms-prop__toggle">
                                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__toggle-btn" :class="Number(selected.payload.priority || 0) === 1 && 'is-active'" @click="setPayload('priority', 1)"{% endblock %}{% block content %}{{ 'cms.builder.prop.yes'|trans }}{% endblock %}{% endembed %}
                                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-prop__toggle-btn" :class="Number(selected.payload.priority || 0) !== 1 && 'is-active'" @click="setPayload('priority', 0)"{% endblock %}{% block content %}{{ 'cms.builder.prop.no'|trans }}{% endblock %}{% endembed %}
                                        </div>
                                    </div>
                                    <p class="muted">{{ 'cms.builder.prop.priority_hint'|trans }}</p>
                                </details></div>
                            </section>
                        </template>
                    </div>

                </div>

            </template>
            </div>
            </section>

            <details class="cms-builder__layers-dock" open>
                <summary class="cms-builder__layers-head cms-builder__layers-title">
                    <span class="material-symbols-outlined g-icon" aria-hidden="true">layers</span>
                    {{ 'cms.builder.tab.layers'|trans }}
                    <span class="material-symbols-outlined g-icon cms-builder__layers-chevron" aria-hidden="true">expand_more</span>
                </summary>
                    <div class="cms-builder__layer-tools" x-show="selectedId" x-cloak>
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__layer-tool" @click="moveSelected(-1)" title="Nahoru"{% endblock %}{% block content %}
                            <span class="material-symbols-outlined g-icon" aria-hidden="true">keyboard_arrow_up</span>
                        {% endblock %}{% endembed %}
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__layer-tool" @click="moveSelected(1)" title="Dolů"{% endblock %}{% block content %}
                            <span class="material-symbols-outlined g-icon" aria-hidden="true">keyboard_arrow_down</span>
                        {% endblock %}{% endembed %}
                        {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-builder__layer-tool cms-builder__layer-tool--danger" @click="removeSelected()" title="{{ 'common.delete'|trans }}"{% endblock %}{% block content %}
                            <span class="material-symbols-outlined g-icon" aria-hidden="true">delete</span>
                        {% endblock %}{% endembed %}
                    </div>
                <div id="cms-builder-layers-body" class="cms-builder__rail-body cms-builder__layers-body">
                    <template x-if="blocks.length === 0">
                        <p class="muted">{{ 'cms.builder.layers.empty'|trans }}</p>
                    </template>
                    <ul class="cms-builder__layers"
                        @dragover="onLayerDragOver(null, $event)"
                        @dragleave="onLayerDragLeave(null, $event)"
                        @drop.prevent="onLayerDrop(null, $event)">
                        <template x-for="row in layerRows()" :key="row.block.id">
                            <li :class="layerItemClass(row)" :style="layerItemStyle(row)">
                                <template x-if="hasLayerChildren(row.block)">
                                    <button type="button" class="cms-builder__layer-expand" @click="toggleLayer(row.block.id)"
                                            :aria-expanded="!collapsedLayerIds.includes(row.block.id)"
                                            :aria-label="collapsedLayerIds.includes(row.block.id) ? '{{ 'cms.builder.layers.expand'|trans|e('js') }}' : '{{ 'cms.builder.layers.collapse'|trans|e('js') }}'">
                                        <span class="material-symbols-outlined g-icon" aria-hidden="true" x-text="collapsedLayerIds.includes(row.block.id) ? 'chevron_right' : 'expand_more'"></span>
                                    </button>
                                </template>
                                {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button"
                                        class="cms-builder__layer"
                                        :class="selectedId === row.block.id && 'is-active'"
                                        :draggable="layerRenameId !== row.block.id"
                                        @dragstart="onLayerDragStart(row.block.id, $event)"
                                        @dragend="onLayerDragEnd()"
                                        @dragover="onLayerDragOver(row.block.id, $event)"
                                        @dragleave="onLayerDragLeave(row.block.id, $event)"
                                        @drop.prevent="onLayerDrop(row.block.id, $event)"
                                        @click="selectLayer(row.block.id)"
                                        @dblclick="startLayerRename(row.block.id, $event)"{% endblock %}{% block content %}
                                    <span class="material-symbols-outlined g-icon cms-builder__layer-handle" aria-hidden="true">drag_indicator</span>
                                    <span class="cms-builder__layer-index" x-text="row.index + 1"></span>
                                    <span class="cms-builder__layer-meta">
                                        <template x-if="layerRenameId !== row.block.id">
                                            <span class="cms-builder__layer-name" x-text="layerDisplayName(row.block, row.index)"></span>
                                        </template>
                                        <template x-if="layerRenameId === row.block.id">
                                            {% embed 'ui/input.html.twig' with { input_options: { control_only: true } } %}{% block input_attributes %} type="text"
                                                   class="cms-builder__layer-name-input"
                                                   :value="layerAdminLabel(row.block)"
                                                   :placeholder="layerDefaultName(row.index)"
                                                   @click.stop
                                                   @mousedown.stop
                                                   @dragstart.stop.prevent
                                                   @keydown.enter.prevent="commitLayerRename(row.block.id, $event)"
                                                   @keydown.escape.prevent="cancelLayerRename()"
                                                   @blur="commitLayerRename(row.block.id, $event)"{% endblock %}{% endembed %}
                                        </template>
                                        <span class="cms-builder__layer-type" x-text="layerTypeLabel(row.block)"></span>
                                    </span>
                                {% endblock %}{% endembed %}
                            </li>
                        </template>
                    </ul>
                </div>
            </details>
        </aside>
    </div>
</div>
{% endblock %}
