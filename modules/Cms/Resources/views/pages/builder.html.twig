{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.cms'|trans, url: url('admin.cms.pages.index') },
        { label: 'nav.cms.pages'|trans, url: url('admin.cms.pages.index') },
        { label: item.title(), url: url('admin.cms.pages.show', {id: item.id()}) },
        { label: 'cms.builder.title'|trans },
    ] } %}
{% endblock %}

{% block content %}
{% set bootJson = boot|merge({ csrf: csrf_token() }) %}
<div class="cms-builder"
     x-data="cmsBuilder"
     data-boot="{{ bootJson|json_encode|e('html_attr') }}">

    <header class="page-header cms-builder__header">
        <div>
            <p class="eyebrow">
                <a href="{{ url('admin.cms.pages.show', {id: item.id()}) }}">← {{ 'cms.builder.exit'|trans }}</a>
            </p>
            <h1>{{ 'cms.builder.title'|trans }}</h1>
            <p class="muted detail-layout__meta">
                <strong>{{ item.title() }}</strong>
                <code>/{{ item.slug() }}</code>
                <span class="badge badge--muted">{{ item.templateLabel()|trans }}</span>
                {% if staged %}
                    <span class="badge badge--warn">{{ 'cms.preview.staged'|trans }}</span>
                {% endif %}
                <span class="cms-builder__status" x-show="status" x-text="status" x-cloak></span>
                <span class="badge badge--warn" x-show="dirty" x-cloak>{{ 'cms.builder.unsaved'|trans }}</span>
            </p>
        </div>
        <div class="actions">
            <div class="cms-builder__devices" role="group" aria-label="{{ 'cms.preview.devices'|trans }}">
                <button type="button" class="cms-builder__device" :class="device === 'desktop' && 'is-active'" @click="device = 'desktop'" title="Desktop">
                    <span class="material-symbols-outlined g-icon" aria-hidden="true">desktop_windows</span>
                </button>
                <button type="button" class="cms-builder__device" :class="device === 'tablet' && 'is-active'" @click="device = 'tablet'" title="Tablet">
                    <span class="material-symbols-outlined g-icon" aria-hidden="true">tablet_mac</span>
                </button>
                <button type="button" class="cms-builder__device" :class="device === 'mobile' && 'is-active'" @click="device = 'mobile'" title="Mobile">
                    <span class="material-symbols-outlined g-icon" aria-hidden="true">smartphone</span>
                </button>
            </div>
            <a class="btn btn--ghost" href="{{ url('admin.cms.pages.preview', {id: item.id()}) }}" target="_blank" rel="noopener">{{ 'cms.pages.preview'|trans }}</a>
            <button type="button" class="btn btn--primary" @click="save()" :disabled="saving">
                <span x-text="saving ? (boot.labels.saving || '…') : '{{ 'cms.builder.save'|trans|e('js') }}'"></span>
            </button>
        </div>
    </header>

    <div class="cms-builder__workspace">
        <aside class="panel cms-builder__rail">
            <div class="design-tabs cms-builder__tabs" role="tablist">
                <button type="button" class="design-tab" :class="leftTab === 'layers' && 'is-active'" @click="leftTab = 'layers'">{{ 'cms.builder.tab.layers'|trans }}</button>
                <button type="button" class="design-tab" :class="leftTab === 'add' && 'is-active'" @click="leftTab = 'add'">{{ 'cms.builder.tab.add'|trans }}</button>
                <button type="button" class="design-tab" :class="leftTab === 'vars' && 'is-active'" @click="leftTab = 'vars'">{{ 'cms.builder.tab.vars'|trans }}</button>
                <button type="button" class="design-tab" :class="leftTab === 'media' && 'is-active'" @click="leftTab = 'media'">{{ 'cms.builder.tab.media'|trans }}</button>
                <button type="button" class="design-tab" :class="leftTab === 'docs' && 'is-active'" @click="leftTab = 'docs'">{{ 'cms.builder.tab.docs'|trans }}</button>
            </div>

            <div class="cms-builder__rail-body" x-show="leftTab === 'layers'">
                <template x-if="blocks.length === 0">
                    <p class="muted">{{ 'cms.builder.layers.empty'|trans }}</p>
                </template>
                <ul class="cms-builder__layers"
                    @dragover="onDragOver(null, $event)"
                    @drop="onDrop(null, $event)">
                    <template x-for="(block, index) in blocks" :key="block.id">
                        <li :class="dropTargetId === block.id && 'is-drop-target'">
                            <button type="button"
                                    class="cms-builder__layer"
                                    :class="selectedId === block.id && 'is-active'"
                                    draggable="true"
                                    @dragstart="onBlockDragStart(block.id, $event)"
                                    @dragend="onDragEnd()"
                                    @dragover="onDragOver(block.id, $event)"
                                    @drop="onDrop(block.id, $event)"
                                    @click="select(block.id)">
                                <span class="cms-builder__layer-handle" aria-hidden="true">⋮⋮</span>
                                <span class="cms-builder__layer-index" x-text="index + 1"></span>
                                <span class="cms-builder__layer-meta">
                                    <span class="cms-builder__layer-type" x-text="typeLabel(block.type)"></span>
                                    <span class="cms-builder__layer-label" x-text="layerLabel(block)"></span>
                                </span>
                            </button>
                        </li>
                    </template>
                </ul>
                <div class="cms-builder__layer-tools" x-show="selectedId">
                    <button type="button" class="btn btn--ghost btn-sm" @click="moveSelected(-1)">↑</button>
                    <button type="button" class="btn btn--ghost btn-sm" @click="moveSelected(1)">↓</button>
                    <button type="button" class="btn btn--danger btn-sm" @click="removeSelected()">{{ 'common.delete'|trans }}</button>
                </div>
            </div>

            <div class="cms-builder__rail-body" x-show="leftTab === 'add'" x-cloak>
                <p class="muted">{{ 'cms.builder.add.hint'|trans }}</p>
                <div class="cms-builder__add-grid">
                    <template x-for="bt in boot.blockTypes" :key="bt.value">
                        <button type="button"
                                class="cms-builder__add-card"
                                draggable="true"
                                @dragstart="onAddDragStart(bt.value, $event)"
                                @dragend="onDragEnd()"
                                @click="addBlock(bt.value)">
                            <span x-text="bt.label"></span>
                            <code x-text="bt.value"></code>
                        </button>
                    </template>
                </div>
            </div>

            <div class="cms-builder__rail-body" x-show="leftTab === 'vars'" x-cloak>
                <p class="muted">{{ 'cms.builder.vars.hint'|trans }}</p>
                <input class="input" type="search" x-model="varFilter" placeholder="{{ 'cms.builder.vars.search'|trans }}">
                <div class="cms-builder__var-kinds">
                    <button type="button" class="btn btn-sm" :class="varKind === 'all' ? 'btn--primary' : 'btn--ghost'" @click="varKind = 'all'">{{ 'cms.builder.vars.all'|trans }}</button>
                    <button type="button" class="btn btn-sm" :class="varKind === 'text' ? 'btn--primary' : 'btn--ghost'" @click="varKind = 'text'">{{ 'cms.builder.vars.kind.text'|trans }}</button>
                    <button type="button" class="btn btn-sm" :class="varKind === 'color' ? 'btn--primary' : 'btn--ghost'" @click="varKind = 'color'">{{ 'cms.builder.vars.kind.color'|trans }}</button>
                    <button type="button" class="btn btn-sm" :class="varKind === 'image' ? 'btn--primary' : 'btn--ghost'" @click="varKind = 'image'">{{ 'cms.builder.vars.kind.image'|trans }}</button>
                    <button type="button" class="btn btn-sm" :class="varKind === 'link' ? 'btn--primary' : 'btn--ghost'" @click="varKind = 'link'">{{ 'cms.builder.vars.kind.link'|trans }}</button>
                    <button type="button" class="btn btn-sm" :class="varKind === 'number' ? 'btn--primary' : 'btn--ghost'" @click="varKind = 'number'">{{ 'cms.builder.vars.kind.number'|trans }}</button>
                </div>
                <div class="cms-builder__vars-list">
                    <template x-for="group in variableGroups()" :key="group.group">
                        <section class="cms-builder__vars-group">
                            <h3 x-text="group.group"></h3>
                            <ul>
                                <template x-for="item in group.items" :key="item.path">
                                    <li>
                                        <button type="button" class="cms-builder__var" @click="insertVariable(item.path)" :title="item.description || item.label">
                                            <span class="cms-builder__var-swatch" x-show="item.kind === 'color'" :style="'background:' + (boot.varValues[item.path] || item.example)"></span>
                                            <code x-text="item.token"></code>
                                            <span class="cms-builder__var-label" x-text="item.label"></span>
                                            <span class="muted" x-text="item.description" x-show="item.description"></span>
                                        </button>
                                    </li>
                                </template>
                            </ul>
                        </section>
                    </template>
                    <p class="muted" x-show="filteredVariables.length === 0">{{ 'cms.builder.vars.empty'|trans }}</p>
                </div>
            </div>

            <div class="cms-builder__rail-body" x-show="leftTab === 'media'" x-cloak>
                <input class="input" type="search" placeholder="{{ 'cms.builder.media.search'|trans }}" x-model="mediaQuery">
                <template x-if="filteredMedia.length === 0">
                    <p class="muted">{{ 'cms.builder.media.empty'|trans }}</p>
                </template>
                <div class="cms-builder__media-grid">
                    <template x-for="m in filteredMedia" :key="m.id">
                        <button type="button" class="cms-builder__media-card" @click="applyMedia(m)" :title="m.title">
                            <img :src="m.url" :alt="m.alt || m.title" loading="lazy">
                            <span x-text="m.title"></span>
                        </button>
                    </template>
                </div>
            </div>

            <div class="cms-builder__rail-body" x-show="leftTab === 'docs'" x-cloak>
                <input class="input" type="search" placeholder="{{ 'cms.builder.docs.search'|trans }}" x-model="docsQuery">
                <template x-if="filteredDocs.length === 0">
                    <p class="muted">{{ 'cms.builder.docs.empty'|trans }}</p>
                </template>
                <ul class="cms-builder__docs">
                    <template x-for="d in filteredDocs" :key="d.id">
                        <li>
                            <button type="button" class="cms-builder__doc" @click="applyDocument(d)">
                                <strong x-text="d.title"></strong>
                                <span class="muted" x-text="d.mime"></span>
                            </button>
                        </li>
                    </template>
                </ul>
            </div>
        </aside>

        <main class="panel cms-builder__stage"
              @dragover="onDragOver(null, $event)"
              @drop="onDrop(null, $event)">
            <div class="cms-builder__frame" :class="'is-' + device">
                <article class="cms-builder-page" :class="'cms-builder-page--' + boot.template">
                    <header class="cms-builder-page__head">
                        <p class="cms-builder-page__eyebrow" x-text="'/' + boot.slug"></p>
                        <h1 x-text="expandPreview(boot.title)"></h1>
                    </header>
                    <div class="cms-builder-page__body">
                        <template x-if="blocks.length === 0">
                            <div class="empty">
                                <h2>{{ 'cms.blocks.empty'|trans }}</h2>
                                <p>{{ 'cms.builder.canvas.empty_hint'|trans }}</p>
                                <button type="button" class="btn btn--primary btn-sm" @click="leftTab = 'add'">{{ 'cms.builder.tab.add'|trans }}</button>
                            </div>
                        </template>
                        <template x-for="block in blocks" :key="block.id">
                            <section class="cms-builder-block"
                                     :class="'cms-builder-block--' + block.type + (selectedId === block.id ? ' is-selected' : '') + (dropTargetId === block.id ? ' is-drop-target' : '') + (dragId === block.id ? ' is-dragging' : '')"
                                     draggable="true"
                                     @dragstart="onBlockDragStart(block.id, $event)"
                                     @dragend="onDragEnd()"
                                     @dragover="onDragOver(block.id, $event)"
                                     @drop="onDrop(block.id, $event)"
                                     @click="select(block.id)">
                                <template x-if="block.type === 'heading'">
                                    <div>
                                        <h1 x-show="headingLevel(block) === 1" x-text="expandPreview(String(block.payload.text || '—'))"></h1>
                                        <h2 x-show="headingLevel(block) === 2" x-text="expandPreview(String(block.payload.text || '—'))"></h2>
                                        <h3 x-show="headingLevel(block) === 3" x-text="expandPreview(String(block.payload.text || '—'))"></h3>
                                    </div>
                                </template>
                                <template x-if="block.type === 'text'">
                                    <p class="cms-builder-block__plain" x-text="plainPreview(block.payload.body)"></p>
                                </template>
                                <template x-if="block.type === 'html'">
                                    <p class="cms-builder-block__plain" x-text="plainPreview(block.payload.html)"></p>
                                </template>
                                <template x-if="block.type === 'image'">
                                    <figure>
                                        <img x-show="imageSrc(block)" :src="imageSrc(block)" :alt="block.payload.alt || ''">
                                        <p class="muted" x-show="!imageSrc(block)">{{ 'cms.builder.image.placeholder'|trans }}</p>
                                        <figcaption x-show="block.payload.caption" x-text="expandPreview(String(block.payload.caption || ''))"></figcaption>
                                    </figure>
                                </template>
                                <template x-if="block.type === 'cta'">
                                    <p>
                                        <span class="btn" :class="block.payload.style === 'primary' ? 'btn--primary' : 'btn--ghost'" x-text="expandPreview(String(block.payload.label || 'CTA'))"></span>
                                    </p>
                                </template>
                                <template x-if="block.type === 'columns'">
                                    <div class="cms-builder-columns">
                                        <p class="cms-builder-block__plain" x-text="plainPreview(block.payload.left)"></p>
                                        <p class="cms-builder-block__plain" x-text="plainPreview(block.payload.right)"></p>
                                    </div>
                                </template>
                                <template x-if="block.type === 'divider'">
                                    <hr class="cms-preview-divider">
                                </template>
                                <template x-if="block.type === 'gallery'">
                                    <p class="muted">{{ 'cms.block.type.gallery'|trans }}: <span x-text="block.payload.media_ids || '—'"></span></p>
                                </template>
                                <template x-if="block.type === 'products'">
                                    <p class="muted">{{ 'cms.block.type.products'|trans }}: <span x-text="block.payload.product_ids || '—'"></span></p>
                                </template>
                            </section>
                        </template>
                    </div>
                </article>
            </div>
        </main>

        <aside class="panel cms-builder__inspector">
            <div class="design-tabs cms-builder__tabs" role="tablist">
                <button type="button" class="design-tab" :class="rightTab === 'content' && 'is-active'" @click="rightTab = 'content'">{{ 'cms.builder.tab.content'|trans }}</button>
                <button type="button" class="design-tab" :class="rightTab === 'design' && 'is-active'" @click="rightTab = 'design'">{{ 'cms.builder.tab.design'|trans }}</button>
            </div>

            <div class="cms-builder__rail-body" x-show="!selected">
                <p class="muted">{{ 'cms.builder.select_block'|trans }}</p>
            </div>

            <div class="cms-builder__rail-body" x-show="selected && rightTab === 'content'" x-cloak>
                <p class="muted"><span x-text="selected ? typeLabel(selected.type) : ''"></span></p>

                <template x-if="selected && selected.type === 'heading'">
                    <div class="cms-builder__fields">
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.text'|trans }}</span>
                            <input class="input" type="text" :value="selected.payload.text" @focus="focusField('text')" @input="onTextInput('text', $event)">
                        </label>
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.level'|trans }}</span>
                            <select class="input" :value="selected.payload.level" @change="onTextInput('level', $event)">
                                <option value="1">H1</option>
                                <option value="2">H2</option>
                                <option value="3">H3</option>
                            </select>
                        </label>
                    </div>
                </template>

                <template x-if="selected && selected.type === 'text'">
                    <label class="field">
                        <span class="field__label">{{ 'cms.block.field.body'|trans }}</span>
                        <textarea class="input" rows="8" :value="selected.payload.body" @focus="focusField('body')" @input="onTextInput('body', $event)"></textarea>
                    </label>
                </template>

                <template x-if="selected && selected.type === 'html'">
                    <label class="field">
                        <span class="field__label">{{ 'cms.block.field.html'|trans }}</span>
                        <textarea class="input" rows="8" :value="selected.payload.html" @focus="focusField('html')" @input="onTextInput('html', $event)"></textarea>
                    </label>
                </template>

                <template x-if="selected && selected.type === 'image'">
                    <div class="cms-builder__fields">
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.media_id'|trans }}</span>
                            <input class="input" type="text" :value="selected.payload.media_id" @focus="focusField('media_id')" @input="onTextInput('media_id', $event)">
                        </label>
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.url'|trans }}</span>
                            <input class="input" type="text" :value="selected.payload.url" @focus="focusField('url')" @input="onTextInput('url', $event)">
                        </label>
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.alt'|trans }}</span>
                            <input class="input" type="text" :value="selected.payload.alt" @focus="focusField('alt')" @input="onTextInput('alt', $event)">
                        </label>
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.caption'|trans }}</span>
                            <input class="input" type="text" :value="selected.payload.caption" @focus="focusField('caption')" @input="onTextInput('caption', $event)">
                        </label>
                        <p class="muted">{{ 'cms.builder.image.hint'|trans }}</p>
                    </div>
                </template>

                <template x-if="selected && selected.type === 'cta'">
                    <div class="cms-builder__fields">
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.label'|trans }}</span>
                            <input class="input" type="text" :value="selected.payload.label" @focus="focusField('label')" @input="onTextInput('label', $event)">
                        </label>
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.url'|trans }}</span>
                            <input class="input" type="text" :value="selected.payload.url" @focus="focusField('url')" @input="onTextInput('url', $event)">
                        </label>
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.style'|trans }}</span>
                            <select class="input" :value="selected.payload.style" @change="onTextInput('style', $event)">
                                <option value="primary">primary</option>
                                <option value="ghost">ghost</option>
                            </select>
                        </label>
                    </div>
                </template>

                <template x-if="selected && selected.type === 'columns'">
                    <div class="cms-builder__fields">
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.left'|trans }}</span>
                            <textarea class="input" rows="5" :value="selected.payload.left" @focus="focusField('left')" @input="onTextInput('left', $event)"></textarea>
                        </label>
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.right'|trans }}</span>
                            <textarea class="input" rows="5" :value="selected.payload.right" @focus="focusField('right')" @input="onTextInput('right', $event)"></textarea>
                        </label>
                    </div>
                </template>

                <template x-if="selected && selected.type === 'divider'">
                    <label class="field">
                        <span class="field__label">{{ 'cms.block.field.style'|trans }}</span>
                        <select class="input" :value="selected.payload.style" @change="onTextInput('style', $event)">
                            <option value="solid">solid</option>
                            <option value="dashed">dashed</option>
                        </select>
                    </label>
                </template>

                <template x-if="selected && selected.type === 'gallery'">
                    <div class="cms-builder__fields">
                        <label class="field">
                            <span class="field__label">{{ 'cms.block.field.media_ids'|trans }}</span>
                            <input class="input" type="text" :value="selected.payload.media_ids" @focus="focusField('media_ids')" @input="onTextInput('media_ids', $event)">
                        </label>
                        <p class="muted">{{ 'cms.builder.gallery.hint'|trans }}</p>
                    </div>
                </template>

                <template x-if="selected && selected.type === 'products'">
                    <label class="field">
                        <span class="field__label">{{ 'cms.block.field.product_ids'|trans }}</span>
                        <input class="input" type="text" :value="selected.payload.product_ids" @focus="focusField('product_ids')" @input="onTextInput('product_ids', $event)">
                    </label>
                </template>
            </div>

            <div class="cms-builder__rail-body" x-show="selected && rightTab === 'design'" x-cloak>
                <p class="muted">{{ 'cms.builder.design.hint'|trans }}</p>
                <dl class="meta-list meta-list--flush">
                    <div>
                        <dt>ID</dt>
                        <dd><code x-text="selected ? selected.id : ''"></code></dd>
                    </div>
                    <div>
                        <dt>{{ 'cms.field.template'|trans }}</dt>
                        <dd x-text="boot.template"></dd>
                    </div>
                    <div>
                        <dt>{{ 'cms.builder.order'|trans }}</dt>
                        <dd x-text="selected ? selected.sort_order : ''"></dd>
                    </div>
                </dl>
            </div>
        </aside>
    </div>
</div>
{% endblock %}
