{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="cms-pages" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'cms.pages.title'|trans }}</h1>
        <div class="actions">
            {% if user.can('cms.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.cms.pages.create') }}">{{ icon('plus') }} {{ 'cms.pages.new'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'cms.pages.search'|trans }}">
            <select class="input" name="status" onchange="this.form.submit()">
                <option value="">{{ 'cms.filter.status_all'|trans }}</option>
                {% for s in statuses %}
                    <option value="{{ s }}" {{ status == s ? 'selected' : '' }}>{{ ('cms.page.status.' ~ s)|trans }}</option>
                {% endfor %}
            </select>
        </form>
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'cms.field.title'|trans }}</th>
                    <th>{{ 'cms.field.slug'|trans }}</th>
                    <th>{{ 'cms.field.template'|trans }}</th>
                    <th>{{ 'cms.field.updated'|trans }}</th>
                    {% if user.can('cms.manage') %}
                        <th class="table__toggle-cell">{{ 'ui.table.col.publish'|trans }}</th>
                    {% else %}
                        <th>{{ 'cms.field.status'|trans }}</th>
                    {% endif %}
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td><a href="{{ url('admin.cms.pages.show', {id: item.id()}) }}">{{ item.title() }}</a></td>
                        <td><code>/api/public/pages/{{ item.slug() }}</code></td>
                        <td>{{ item.templateLabel()|trans }}</td>
                        <td>{{ item.updatedAt().format('d. m. Y H:i') }}</td>
                        {% if user.can('cms.manage') %}
                            <td class="table__toggle-cell">
                                {% include 'ui/table_toggle.html.twig' with {
                                    action: url('admin.cms.pages.publish', {id: item.id()}),
                                    on: item.isPublished(),
                                    title_on: 'ui.table.publish.on'|trans,
                                    title_off: 'ui.table.publish.off'|trans,
                                } %}
                            </td>
                        {% else %}
                            <td><span class="badge badge--{{ item.status() == 'published' ? 'info' : (item.status() == 'draft' ? 'muted' : 'ok') }}">{{ item.statusLabel()|trans }}</span></td>
                        {% endif %}
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% include 'ui/row_action.html.twig' with { href: url('admin.cms.pages.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                                <a href="{{ url('admin.cms.pages.preview', {id: item.id()}) }}" target="_blank">{{ 'cms.pages.preview_json'|trans }}</a>
                                {% if user.can('cms.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.cms.pages.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.cms.pages.destroy', {id: item.id()}), confirm: 'cms.confirm_delete_page'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'cms.pages.empty'|trans }}</h2>
                                <p>{{ 'cms.pages.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
