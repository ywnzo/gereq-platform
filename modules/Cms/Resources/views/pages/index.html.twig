{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'cms.pages.title'|trans }}</h1>
        {% if user.can('cms.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.cms.pages.create') }}">{{ icon('plus') }} {{ 'cms.pages.new'|trans }}</a>
        {% endif %}
    </header>

    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'cms.pages.search'|trans }}">
        <select class="input" name="status" onchange="this.form.submit()">
            <option value="">{{ 'cms.filter.status_all'|trans }}</option>
            {% for s in statuses %}
                <option value="{{ s }}" {{ status == s ? 'selected' : '' }}>{{ ('cms.page.status.' ~ s)|trans }}</option>
            {% endfor %}
        </select>
    </form>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'cms.field.title'|trans }}</th>
                    <th>{{ 'cms.field.slug'|trans }}</th>
                    <th>{{ 'cms.field.status'|trans }}</th>
                    <th>{{ 'cms.field.template'|trans }}</th>
                    <th>{{ 'cms.field.updated'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td><a href="{{ url('admin.cms.pages.show', {id: item.id()}) }}">{{ item.title() }}</a></td>
                        <td><code>/p/{{ item.slug() }}</code></td>
                        <td><span class="badge">{{ item.statusLabel()|trans }}</span></td>
                        <td>{{ item.templateLabel()|trans }}</td>
                        <td>{{ item.updatedAt().format('d. m. Y H:i') }}</td>
                        <td class="table__actions" x-data="rowMenu" @click.outside="close">
                            <button type="button" class="icon-btn" x-ref="button" @click="toggle" aria-haspopup="menu" :aria-expanded="open">{{ icon('dots') }}</button>
                            <div class="flyout flyout--right" x-ref="menu" :class="menuClass" :style="menuStyle" role="menu">
                                <a href="{{ url('admin.cms.pages.show', {id: item.id()}) }}">{{ 'common.detail'|trans }}</a>
                                <a href="{{ url('admin.cms.pages.preview', {id: item.id()}) }}" target="_blank">{{ 'cms.pages.preview'|trans }}</a>
                                {% if user.can('cms.manage') %}
                                    <a href="{{ url('admin.cms.pages.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                                    <form method="post" action="{{ url('admin.cms.pages.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'cms.confirm_delete_page'|trans|e('js') }}');">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'cms.pages.empty'|trans }}</h2>
                                <p>{{ 'cms.pages.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total > 0 %}
        <footer class="table-footer">
            <span class="muted">{{ ((page - 1) * perPage) + 1 }}–{{ min(page * perPage, total) }} {{ 'common.of'|trans }} {{ total }}</span>
            <nav class="pagination">
                {% if page > 1 %}
                    <a href="?q={{ search }}&status={{ status }}&page={{ page - 1 }}">{{ 'common.previous'|trans }}</a>
                {% endif %}
                <span>{{ page }} / {{ pages }}</span>
                {% if page < pages %}
                    <a href="?q={{ search }}&status={{ status }}&page={{ page + 1 }}">{{ 'common.next'|trans }}</a>
                {% endif %}
            </nav>
        </footer>
    {% endif %}
{% endblock %}
