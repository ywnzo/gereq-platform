{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.cms'|trans, url: url('admin.cms.pages.index') },
        { label: 'nav.cms.pages'|trans, url: url('admin.cms.pages.index') },
        { label: item.title() },
    ] } %}
{% endblock %}

{% block content %}
    <header class="page-header">
        <div>
            <p class="eyebrow"><a href="{{ url('admin.cms.pages.index') }}">{{ 'nav.cms.pages'|trans }}</a></p>
            <h1>{{ item.title() }}</h1>
            <p class="muted detail-layout__meta">
                <code>/api/public/pages/{{ item.slug() }}</code>
                <span class="status-chip"><span class="status-chip__dot"></span>{{ item.statusLabel()|trans }}</span>
                <span class="badge badge--muted">{{ item.templateLabel()|trans }}</span>
            </p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.cms.pages.preview', {id: item.id()}) }}" target="_blank">{{ 'cms.pages.preview_json'|trans }}</a>
            {% if user.can('cms.manage') %}
                <form method="post" action="{{ url('admin.cms.pages.publish', {id: item.id()}) }}">
                    {{ csrf_field()|raw }}
                    <button class="btn {{ item.isPublished() ? 'btn--ghost' : 'btn--primary' }}" type="submit">
                        {{ item.isPublished() ? 'cms.pages.unpublish'|trans : 'cms.pages.publish'|trans }}
                    </button>
                </form>
                <a class="btn btn--primary" href="{{ url('admin.cms.pages.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.cms.pages.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'cms.confirm_delete_page'|trans|e('js') }}');">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="detail-hub" x-data="gereqTabs" data-initial="{{ item.isRaw() ? 'body' : 'blocks' }}">
        <div class="design-tabs detail-tabs" role="tablist">
            <button type="button" class="design-tab" role="tab" data-tab="overview">{{ 'common.overview'|trans }}</button>
            {% if item.isRaw() %}
                <button type="button" class="design-tab" role="tab" data-tab="body">{{ 'cms.field.body'|trans }}</button>
            {% else %}
                <button type="button" class="design-tab" role="tab" data-tab="blocks">
                    {{ 'cms.blocks.title'|trans }}
                    {% if blocks %}<span class="module-tab-count">{{ blocks|length }}</span>{% endif %}
                </button>
            {% endif %}
        </div>

        <section class="design-panel" data-panel="overview" role="tabpanel">
            <div class="detail-layout">
                <div class="detail-layout__main">
                    <section class="detail-hero panel">
                        <div class="detail-hero__body">
                            <div class="detail-hero__highlight">
                                <span>{{ 'cms.field.status'|trans }}</span>
                                <strong>{{ item.statusLabel()|trans }}</strong>
                            </div>
                            <dl class="detail-hero__facts">
                                <div>
                                    <dt>{{ 'cms.field.slug'|trans }}</dt>
                                    <dd><code>{{ item.slug() }}</code></dd>
                                </div>
                                <div>
                                    <dt>{{ 'cms.field.template'|trans }}</dt>
                                    <dd>{{ item.templateLabel()|trans }}</dd>
                                </div>
                                <div>
                                    <dt>{{ 'cms.field.content_mode'|trans }}</dt>
                                    <dd>{{ item.contentModeLabel()|trans }}</dd>
                                </div>
                                <div>
                                    <dt>{{ 'cms.field.updated'|trans }}</dt>
                                    <dd>{{ item.updatedAt().format('d. m. Y H:i') }}</dd>
                                </div>
                            </dl>
                        </div>
                    </section>
                </div>

                <aside class="detail-layout__aside">
                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'common.overview'|trans }}</h2>
                        </header>
                        <dl class="meta-list meta-list--flush detail-layout__specs">
                            <div class="meta-list__full">
                                <dt>{{ 'cms.field.meta_description'|trans }}</dt>
                                <dd>{{ item.metaDescription()|default('—') }}</dd>
                            </div>
                            <div class="meta-list__full">
                                <dt>{{ 'cms.field.published_at'|trans }}</dt>
                                <dd>{{ item.publishedAt() ? item.publishedAt().format('d. m. Y H:i') : '—' }}</dd>
                            </div>
                            <div>
                                <dt>{{ 'cms.field.status'|trans }}</dt>
                                <dd>{{ item.statusLabel()|trans }}</dd>
                            </div>
                            <div>
                                <dt>{{ 'cms.field.updated'|trans }}</dt>
                                <dd>{{ item.updatedAt().format('d. m. Y H:i') }}</dd>
                            </div>
                        </dl>
                    </section>
                </aside>
            </div>
        </section>

        {% if item.isRaw() %}
        <section class="design-panel" data-panel="body" role="tabpanel">
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'cms.field.body'|trans }}</h2>
                    {% if user.can('cms.manage') %}
                        <a class="btn btn--primary btn--sm" href="{{ url('admin.cms.pages.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                    {% endif %}
                </header>
                {% if item.body() %}
                    <div class="prose-cms">{{ item.body()|raw }}</div>
                {% else %}
                    <div class="empty">
                        <h2>{{ 'cms.body.empty'|trans }}</h2>
                        <p>{{ 'cms.body.empty.hint'|trans }}</p>
                    </div>
                {% endif %}
            </section>
        </section>
        {% else %}
        <section class="design-panel" data-panel="blocks" role="tabpanel">
            <div class="detail-stack">
                <section class="panel">
                    <header class="panel__head">
                        <h2>{{ 'cms.blocks.title'|trans }}</h2>
                        {% if blocks %}
                            <span class="muted">{{ blocks|length }}</span>
                        {% endif %}
                    </header>

                    {% if blocks is empty %}
                        <div class="empty">
                            <h2>{{ 'cms.blocks.empty'|trans }}</h2>
                            <p>{{ 'cms.blocks.empty.hint'|trans }}</p>
                        </div>
                    {% else %}
                        <div class="cms-block-list">
                            {% for block in blocks %}
                                {% set p = block.payload() %}
                                <article class="cms-block-card">
                                    <div class="cms-block-card__index" aria-hidden="true">{{ loop.index }}</div>
                                    <div class="cms-block-card__body">
                                        <div class="cms-block-card__meta">
                                            <span class="badge badge--info">{{ block.typeLabel()|trans }}</span>
                                            <span class="muted">#{{ block.sortOrder() }}</span>
                                        </div>
                                        <div class="cms-block-card__preview">
                                            {% if block.type() == 'heading' %}
                                                <strong class="cms-block-card__heading">{{ p.text|default('—') }}</strong>
                                                <span class="muted">H{{ p.level|default(2) }}</span>
                                            {% elseif block.type() == 'text' %}
                                                <p>{{ p.body|default('')|striptags|slice(0, 160) }}{% if p.body|default('')|striptags|length > 160 %}…{% endif %}</p>
                                            {% elseif block.type() == 'html' %}
                                                <p class="muted">{{ p.html|default('')|striptags|slice(0, 120) }}{% if p.html|default('')|striptags|length > 120 %}…{% endif %}</p>
                                            {% elseif block.type() == 'cta' %}
                                                <strong>{{ p.label|default('—') }}</strong>
                                                <span class="muted">→ {{ p.url|default('#') }}</span>
                                            {% elseif block.type() == 'image' %}
                                                <span>{{ p.caption|default(p.alt|default(p.url|default(p.media_id|default('—')))) }}</span>
                                            {% elseif block.type() == 'columns' %}
                                                <span class="muted">{{ 'cms.block.type.columns'|trans }}</span>
                                            {% elseif block.type() == 'divider' %}
                                                <span class="muted">{{ p.style|default('solid') }}</span>
                                            {% elseif block.type() == 'gallery' %}
                                                <span class="muted">{{ p.media_ids|default('—') }}</span>
                                            {% elseif block.type() == 'products' %}
                                                <span class="muted">{{ p.product_ids|default('—') }}</span>
                                            {% else %}
                                                <span class="muted">{{ p|json_encode|slice(0, 100) }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    {% if user.can('cms.manage') %}
                                        <div class="cms-block-card__actions">
                                            <form method="post" action="{{ url('admin.cms.blocks.up', {id: item.id(), blockId: block.id()}) }}">
                                                {{ csrf_field()|raw }}
                                                <button class="btn btn--ghost btn-sm" type="submit" title="{{ 'cms.blocks.move_up'|trans }}">↑</button>
                                            </form>
                                            <form method="post" action="{{ url('admin.cms.blocks.down', {id: item.id(), blockId: block.id()}) }}">
                                                {{ csrf_field()|raw }}
                                                <button class="btn btn--ghost btn-sm" type="submit" title="{{ 'cms.blocks.move_down'|trans }}">↓</button>
                                            </form>
                                            <a class="btn btn--ghost btn-sm" href="{{ url('admin.cms.blocks.edit', {id: item.id(), blockId: block.id()}) }}">{{ 'common.edit'|trans }}</a>
                                            <form method="post" action="{{ url('admin.cms.blocks.destroy', {id: item.id(), blockId: block.id()}) }}" onsubmit="return confirm('{{ 'cms.confirm_delete_block'|trans|e('js') }}');">
                                                {{ csrf_field()|raw }}
                                                <button class="btn btn--ghost btn-sm" type="submit">{{ 'common.delete'|trans }}</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>

                {% if user.can('cms.manage') %}
                    <section class="panel">
                        <header class="panel__head">
                            <h2>{{ 'cms.blocks.add'|trans }}</h2>
                        </header>
                        {% include 'ui/error-summary.html.twig' with { form: 'cms.block.save' } %}
                        <form
                            method="post"
                            class="cms-block-form form-grid"
                            action="{{ url('admin.cms.blocks.store', {id: item.id()}) }}"
                            data-form="cms.block.save"
                            x-data="gereqForm"
                            {% if form_errors('cms.block.save') %} data-server-state="1"{% endif %}
                        >
                            {{ csrf_field()|raw }}
                            <div class="field--full" x-data="cmsBlockForm">
                            <label class="g-field field--full" data-field="type">
                                <span class="g-label"><span>{{ 'cms.field.block_type'|trans }} <span class="g-req" aria-hidden="true">*</span></span></span>
                                <select class="input" name="type" required x-model="type">
                                    {% for opt in blockTypeOptions %}
                                        <option value="{{ opt.value }}" {{ opt.value == 'text' ? 'selected' : '' }}>{{ opt.label }}</option>
                                    {% endfor %}
                                </select>
                            </label>

                            <template x-if="isHeading">
                                <div class="cms-block-form__fields form-grid">
                                    {% include 'ui/input.html.twig' with { name: 'text', label: 'cms.block.field.text'|trans, optional: true, form: 'cms.block.save', value: '', extra: 'field--full' } %}
                                    {% include 'ui/select.html.twig' with {
                                        name: 'level',
                                        label: 'cms.block.field.level'|trans,
                                        optional: true,
                                        form: 'cms.block.save',
                                        value: '2',
                                        options: [{value:'1',label:'H1'},{value:'2',label:'H2'},{value:'3',label:'H3'}]
                                    } %}
                                </div>
                            </template>

                            <template x-if="isText">
                                <div class="cms-block-form__fields">
                                    {% include 'ui/textarea.html.twig' with { name: 'body', label: 'cms.block.field.body'|trans, optional: true, form: 'cms.block.save', value: '', extra: 'field--full' } %}
                                </div>
                            </template>

                            <template x-if="isHtml">
                                <div class="cms-block-form__fields">
                                    {% include 'ui/textarea.html.twig' with { name: 'html', label: 'cms.block.field.html'|trans, optional: true, form: 'cms.block.save', value: '', extra: 'field--full' } %}
                                </div>
                            </template>

                            <template x-if="isImage">
                                <div class="cms-block-form__fields form-grid">
                                    {% if hasMedia %}
                                        {% include 'ui/select.html.twig' with {
                                            name: 'media_id',
                                            label: 'cms.block.field.media_id'|trans,
                                            optional: true,
                                            form: 'cms.block.save',
                                            value: '',
                                            options: mediaOptions,
                                            extra: 'field--full'
                                        } %}
                                    {% endif %}
                                    {% include 'ui/input.html.twig' with { name: 'url', label: 'cms.block.field.url'|trans, optional: true, form: 'cms.block.save', value: '', extra: 'field--full' } %}
                                    {% include 'ui/input.html.twig' with { name: 'alt', label: 'cms.block.field.alt'|trans, optional: true, form: 'cms.block.save', value: '' } %}
                                    {% include 'ui/input.html.twig' with { name: 'caption', label: 'cms.block.field.caption'|trans, optional: true, form: 'cms.block.save', value: '' } %}
                                </div>
                            </template>

                            <template x-if="isCta">
                                <div class="cms-block-form__fields form-grid">
                                    {% include 'ui/input.html.twig' with { name: 'label', label: 'cms.block.field.label'|trans, optional: true, form: 'cms.block.save', value: '' } %}
                                    {% include 'ui/input.html.twig' with { name: 'url', label: 'cms.block.field.url'|trans, optional: true, form: 'cms.block.save', value: '', extra: 'field--full' } %}
                                    {% include 'ui/input.html.twig' with { name: 'style', label: 'cms.block.field.style'|trans, optional: true, form: 'cms.block.save', value: 'primary' } %}
                                </div>
                            </template>

                            <template x-if="isColumns">
                                <div class="cms-block-form__fields form-grid">
                                    {% include 'ui/textarea.html.twig' with { name: 'left', label: 'cms.block.field.left'|trans, optional: true, form: 'cms.block.save', value: '', extra: 'field--full' } %}
                                    {% include 'ui/textarea.html.twig' with { name: 'right', label: 'cms.block.field.right'|trans, optional: true, form: 'cms.block.save', value: '', extra: 'field--full' } %}
                                </div>
                            </template>

                            <template x-if="isDivider">
                                <div class="cms-block-form__fields">
                                    {% include 'ui/input.html.twig' with { name: 'style', label: 'cms.block.field.style'|trans, optional: true, form: 'cms.block.save', value: 'solid' } %}
                                </div>
                            </template>

                            {% if hasProducts %}
                                <template x-if="isProducts">
                                    <div class="cms-block-form__fields">
                                        {% include 'ui/input.html.twig' with { name: 'product_ids', label: 'cms.block.field.product_ids'|trans, optional: true, form: 'cms.block.save', value: '', hint: 'cms.block.hint.product_ids'|trans, extra: 'field--full' } %}
                                    </div>
                                </template>
                            {% endif %}

                            <template x-if="isGallery">
                                <div class="cms-block-form__fields">
                                    {% include 'ui/input.html.twig' with { name: 'media_ids', label: 'cms.block.field.media_ids'|trans, optional: true, form: 'cms.block.save', value: '', hint: 'cms.block.hint.media_ids'|trans, extra: 'field--full' } %}
                                </div>
                            </template>
                            </div>

                            <div class="form-actions field--full">
                                <button class="btn btn--primary" type="submit">{{ 'cms.blocks.add'|trans }}</button>
                            </div>
                        </form>
                    </section>
                {% endif %}
            </div>
        </section>
        {% endif %}
    </div>
{% endblock %}
