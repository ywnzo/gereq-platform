<!DOCTYPE html>
<html lang="{{ app_locale() }}" data-theme="gereq" data-csp-nonce="{{ csp_nonce() }}" style="{{ brand_html_style() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'cms.preview.banner'|trans }} — {{ item.title() }}</title>
    {% include 'partials/brand-head.html.twig' %}
    {% if vite_hot() %}
        {{ vite_tags() }}
    {% else %}
        <link rel="stylesheet" href="{{ asset('resources/css/kernel.css') }}">
        <script type="module" src="{{ asset('resources/js/admin.ts') }}"{% if csp_nonce() %} nonce="{{ csp_nonce() }}"{% endif %}></script>
    {% endif %}
    {% include 'partials/brand-overrides.html.twig' %}
</head>
<body class="cms-preview-body" x-data="{ device: 'desktop' }">
    <div class="cms-preview-chrome">
        <div class="cms-preview-chrome__left">
            <a class="btn btn--ghost btn-sm" href="{{ url('admin.cms.pages.show', {id: item.id()}) }}">{{ 'cms.preview.exit'|trans }}</a>
            <span class="cms-preview-chrome__title">{{ item.title() }}</span>
            {% if staged %}
                <span class="badge badge--warn">{{ 'cms.preview.staged'|trans }}</span>
            {% endif %}
        </div>
        <div class="cms-preview-chrome__devices" role="group" aria-label="{{ 'cms.preview.devices'|trans }}">
            <button type="button" class="cms-preview-device" :class="device === 'desktop' && 'is-active'" @click="device = 'desktop'" title="Desktop">
                <span class="material-symbols-outlined g-icon" aria-hidden="true">desktop_windows</span>
            </button>
            <button type="button" class="cms-preview-device" :class="device === 'tablet' && 'is-active'" @click="device = 'tablet'" title="Tablet">
                <span class="material-symbols-outlined g-icon" aria-hidden="true">tablet_mac</span>
            </button>
            <button type="button" class="cms-preview-device" :class="device === 'mobile' && 'is-active'" @click="device = 'mobile'" title="Mobile">
                <span class="material-symbols-outlined g-icon" aria-hidden="true">smartphone</span>
            </button>
        </div>
        <div class="cms-preview-chrome__right">
            <a class="btn btn--ghost btn-sm" href="{{ url('admin.cms.pages.preview_json', {id: item.id()}) }}" target="_blank" rel="noopener">{{ 'cms.pages.preview_json'|trans }}</a>
            {% if user and user.can('cms.manage') and not item.isRaw() %}
                <a class="btn btn--primary btn-sm" href="{{ url('admin.cms.pages.builder', {id: item.id()}) }}">{{ 'cms.builder.open'|trans }}</a>
            {% elseif user and user.can('cms.manage') %}
                <a class="btn btn--primary btn-sm" href="{{ url('admin.cms.pages.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
            {% endif %}
        </div>
    </div>

    <div class="cms-preview-banner" role="status">
        <strong>{{ 'cms.preview.banner'|trans }}</strong>
        <span>{{ 'cms.preview.banner_hint'|trans }}</span>
        <a href="{{ url('admin.cms.pages.show', {id: item.id()}) }}">{{ 'cms.preview.back'|trans }}</a>
    </div>

    <div class="cms-preview-stage">
        <div class="cms-preview-frame" :class="'is-' + device">
            <article class="cms-preview-page cms-preview-page--{{ item.template() }}">
                <header class="cms-preview-page__head">
                    <p class="cms-preview-page__eyebrow">{{ item.templateLabel()|trans }} · /{{ item.slug() }}</p>
                    <h1>{{ item.title() }}</h1>
                    {% if item.metaDescription() %}
                        <p class="cms-preview-page__lead">{{ item.metaDescription() }}</p>
                    {% endif %}
                </header>

                <div class="cms-preview-page__body">
                    {% if item.isRaw() %}
                        {% if pageData.body %}
                            <div class="prose-cms">{{ pageData.body|raw }}</div>
                        {% else %}
                            <div class="empty">
                                <h2>{{ 'cms.body.empty'|trans }}</h2>
                                <p>{{ 'cms.body.empty.hint'|trans }}</p>
                            </div>
                        {% endif %}
                    {% else %}
                        {% set blocks = pageData.blocks|default([]) %}
                        {% if blocks is empty %}
                            <div class="empty">
                                <h2>{{ 'cms.blocks.empty'|trans }}</h2>
                                <p>{{ 'cms.blocks.empty.hint'|trans }}</p>
                            </div>
                        {% else %}
                            {% for block in blocks %}
                                {% set p = block.payload|default({}) %}
                                <section class="cms-preview-block cms-preview-block--{{ block.type }}">
                                    {% if block.type == 'heading' %}
                                        {% set level = p.level|default(2) %}
                                        {% if level == 1 %}<h1>{{ p.text|default('') }}</h1>
                                        {% elseif level == 3 %}<h3>{{ p.text|default('') }}</h3>
                                        {% else %}<h2>{{ p.text|default('') }}</h2>{% endif %}
                                    {% elseif block.type == 'text' %}
                                        <div class="prose-cms">{{ p.body|default('')|raw }}</div>
                                    {% elseif block.type == 'html' %}
                                        <div class="prose-cms">{{ p.html|default('')|raw }}</div>
                                    {% elseif block.type == 'image' %}
                                        {% set src = p.url|default(p.src|default('')) %}
                                        {% if src %}
                                            <figure>
                                                <img src="{{ src }}" alt="{{ p.alt|default('') }}">
                                                {% if p.caption %}<figcaption>{{ p.caption }}</figcaption>{% endif %}
                                            </figure>
                                        {% else %}
                                            <p class="muted">{{ 'cms.block.type.image'|trans }}</p>
                                        {% endif %}
                                    {% elseif block.type == 'cta' %}
                                        <p>
                                            <a class="btn {{ p.style|default('primary') == 'primary' ? 'btn--primary' : 'btn--ghost' }}" href="{{ p.url|default('#') }}">{{ p.label|default('CTA') }}</a>
                                        </p>
                                    {% elseif block.type == 'columns' %}
                                        <div class="cms-preview-columns">
                                            <div class="prose-cms">{{ p.left|default('')|raw }}</div>
                                            <div class="prose-cms">{{ p.right|default('')|raw }}</div>
                                        </div>
                                    {% elseif block.type == 'divider' %}
                                        <hr class="cms-preview-divider cms-preview-divider--{{ p.style|default('solid') }}">
                                    {% elseif block.type == 'gallery' %}
                                        <div class="cms-preview-gallery">
                                            {% for img in p.images|default([]) %}
                                                <img src="{{ img.url|default(img.src|default('')) }}" alt="{{ img.alt|default('') }}">
                                            {% else %}
                                                <p class="muted">{{ p.media_ids|default('cms.block.type.gallery'|trans) }}</p>
                                            {% endfor %}
                                        </div>
                                    {% elseif block.type == 'products' %}
                                        <p class="muted">{{ 'cms.block.type.products'|trans }}: {{ p.product_ids|default('—') }}</p>
                                    {% else %}
                                        <pre class="cms-preview-raw">{{ p|json_encode }}</pre>
                                    {% endif %}
                                </section>
                            {% endfor %}
                        {% endif %}
                    {% endif %}
                </div>
            </article>
        </div>
    </div>
</body>
</html>
