<!DOCTYPE html>
<html lang="{{ app_locale() }}" data-theme="gereq" data-csp-nonce="{{ csp_nonce() }}" style="{{ brand_html_style() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'cms.pages.preview'|trans }} — {{ item.title() }}</title>
    {% include 'partials/brand-head.html.twig' %}
    {{ render_css() }}
    {% include 'partials/brand-overrides.html.twig' %}
</head>
<body class="cms-preview-body"
      x-data="cmsPagePreview"
      data-boot="{{ previewBoot|default({})|json_encode|e('html_attr') }}">
    <header class="cms-preview-topbar" role="banner">
        <div class="cms-preview-topbar__brand">
            <span class="cms-preview-topbar__mark" aria-hidden="true">G</span>
            <div class="cms-preview-topbar__brand-text">
                <strong>GEREQ</strong>
                <span>{{ 'cms.preview.mode'|trans }}</span>
            </div>
        </div>

        <div class="cms-preview-topbar__meta">
            <span class="cms-preview-topbar__title">{{ item.title() }}</span>
            <code class="cms-preview-topbar__slug">/{{ item.slug() }}</code>
            <span class="badge badge--muted">{{ item.statusLabel()|trans }}</span>
            {% if staged %}
                <span class="badge badge--warn">{{ 'cms.preview.staged'|trans }}</span>
            {% else %}
                <span class="badge badge--muted">{{ 'cms.preview.working_copy'|trans }}</span>
            {% endif %}
            <span class="cms-preview-topbar__version" title="{{ 'cms.preview.content_version'|trans }}">
                v{{ contentVersion|default('—') }}
            </span>
            {% if item.updatedAt() %}
                <span class="cms-preview-topbar__updated muted">{{ item.updatedAt()|date('d.m.Y H:i') }}</span>
            {% endif %}
        </div>

        <div class="cms-preview-topbar__devices" role="group" aria-label="{{ 'cms.preview.devices'|trans }}">
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-preview-device" :class="device === 'desktop' && 'is-active'" @click="device = 'desktop'" title="Desktop"{% endblock %}{% block content %}
                <span class="material-symbols-outlined g-icon" aria-hidden="true">desktop_windows</span>
            {% endblock %}{% endembed %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-preview-device" :class="device === 'tablet' && 'is-active'" @click="device = 'tablet'" title="Tablet"{% endblock %}{% block content %}
                <span class="material-symbols-outlined g-icon" aria-hidden="true">tablet_mac</span>
            {% endblock %}{% endembed %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'button' } } %}{% block button_attributes %} type="button" class="cms-preview-device" :class="device === 'mobile' && 'is-active'" @click="device = 'mobile'" title="Mobile"{% endblock %}{% block content %}
                <span class="material-symbols-outlined g-icon" aria-hidden="true">smartphone</span>
            {% endblock %}{% endembed %}
        </div>

        <div class="cms-preview-topbar__actions">
            {% include 'ui/button.html.twig' with {
                label: 'cms.pages.preview_json'|trans,
                href: (url('admin.cms.pages.preview_json', {id: item.id()})),
                button_options: { tag: 'a' },
                variant: 'ghost',
                class: 'btn-sm',
                attrs: { 'target': '_blank', 'rel': 'noopener' }
            } only %}
            {% if user and user.can('cms.manage') and not item.isRaw() %}
                {% include 'ui/button.html.twig' with {
                    label: 'cms.builder.open'|trans,
                    href: (url('admin.cms.pages.builder', {id: item.id()})),
                    button_options: { tag: 'a' },
                    variant: 'ghost',
                    class: 'btn-sm'
                } only %}
            {% elseif user and user.can('cms.manage') %}
                {% include 'ui/button.html.twig' with {
                    label: 'common.edit'|trans,
                    href: (url('admin.cms.pages.edit', {id: item.id()})),
                    button_options: { tag: 'a' },
                    variant: 'ghost',
                    class: 'btn-sm'
                } only %}
            {% endif %}
            {% include 'ui/button.html.twig' with {
                label: 'cms.preview.exit'|trans,
                href: (url('admin.cms.pages.show', {id: item.id()})),
                button_options: { tag: 'a' },
                variant: 'primary',
                class: 'btn-sm'
            } only %}
        </div>
    </header>

    <div class="cms-preview-stage{% if storefrontUrl|default('') %} cms-preview-stage--storefront{% endif %}">
        <div class="cms-preview-frame" :class="'is-' + device">
            {% if storefrontUrl|default('') %}
                <iframe id="cmsPreviewFrame"
                    class="cms-preview-storefront"
                    src="{{ storefrontUrl }}?preview=1"
                    title="{{ 'cms.pages.preview'|trans }}"></iframe>
            {% else %}
            <article class="cms-preview-page cms-preview-page--{{ item.template() }}">
                <header class="cms-preview-page__head">
                    <p class="cms-preview-page__eyebrow">{{ item.templateLabel()|trans }} · /{{ item.slug() }}</p>
                    <h1>{{ item.title() }}</h1>
                    {% if item.metaDescription() %}
                        <p class="cms-preview-page__lead">{{ item.metaDescription() }}</p>
                    {% endif %}
                </header>

                <div class="cms-preview-page__body">
                    {% if item.isRaw() %}
                        {% if pageData.body %}
                            <div class="prose-cms">{{ pageData.body|raw }}</div>
                        {% else %}
                            <div class="empty">
                                <h2>{{ 'cms.body.empty'|trans }}</h2>
                                <p>{{ 'cms.body.empty.hint'|trans }}</p>
                            </div>
                        {% endif %}
                    {% else %}
                        {% set blocks = pageData.blocks|default([]) %}
                        {% if blocks is empty %}
                            <div class="empty">
                                <h2>{{ 'cms.blocks.empty'|trans }}</h2>
                                <p>{{ 'cms.blocks.empty.hint'|trans }}</p>
                            </div>
                        {% else %}
                            {% for block in blocks %}
                                {% set p = block.payload|default({}) %}
                                {% set dividerStyle = (block.type == 'divider' ? (p.style|default('solid')|lower) : '') %}
                                {% set isNamedDivider = dividerStyle in ['hero', 'locations', 'listings', 'how', 'cta', 'about', 'faq', 'banner', 'policy'] %}
                                <section class="cms-preview-block cms-preview-block--{{ block.type }}{% if isNamedDivider %} cms-preview-block--section{% endif %}">
                                    {% if block.type == 'heading' %}
                                        {% set level = p.level|default(2) %}
                                        {% if level == 1 %}<h1>{{ p.text|default('') }}</h1>
                                        {% elseif level == 3 %}<h3>{{ p.text|default('') }}</h3>
                                        {% else %}<h2>{{ p.text|default('') }}</h2>{% endif %}
                                    {% elseif block.type == 'text' %}
                                        <div class="prose-cms">{{ p.body|default('')|raw }}</div>
                                    {% elseif block.type == 'dynamic' %}
                                        <div class="cms-preview-dynamic" tabindex="0" style="display:{{ p.variant == 'carousel' ? 'flex' : 'grid' }};gap:1.5rem;overflow-x:auto;scroll-snap-type:x mandatory;{{ p.variant == 'grid' ? 'grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))' : '' }}">
                                            {% for html in p.rendered_items|default([]) %}<div style="flex:0 0 min(85%,360px);scroll-snap-align:start">{{ html|raw }}</div>{% else %}<p>{{ p.empty_text|default('') }}</p>{% endfor %}
                                        </div>
                                    {% elseif block.type == 'html' %}
                                        <div class="prose-cms">{{ p.html|default('')|raw }}</div>
                                    {% elseif block.type == 'image' %}
                                        {% set src = p.url|default(p.src|default('')) %}
                                        {% if src %}
                                            <figure class="cms-preview-figure">
                                                <img src="{{ src }}" alt="{{ p.alt|default('') }}" loading="lazy">
                                                {% if p.caption %}<figcaption>{{ p.caption }}</figcaption>{% endif %}
                                            </figure>
                                        {% else %}
                                            <p class="muted">{{ 'cms.block.type.image'|trans }}</p>
                                        {% endif %}
                                    {% elseif block.type == 'cta' %}
                                        <p class="cms-preview-cta">
                                            {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn {{ p.style|default('primary') == 'primary' ? 'btn--primary' : (p.style|default('') == 'secondary' ? 'btn--ghost' : 'btn--ghost') }}" href="{{ p.url|default('#') }}"{% endblock %}{% block content %}{{ p.label|default('CTA') }}{% endblock %}{% endembed %}
                                        </p>
                                    {% elseif block.type == 'columns' %}
                                        <div class="cms-preview-columns">
                                            <div class="prose-cms">{{ p.left|default('')|raw }}</div>
                                            <div class="prose-cms">{{ p.right|default('')|raw }}</div>
                                        </div>
                                    {% elseif block.type == 'divider' %}
                                        {% if isNamedDivider %}
                                            {% if dividerStyle != 'hero' %}
                                                <div class="cms-preview-section-break">
                                                    <span class="cms-preview-section-break__label">{{ dividerStyle }}</span>
                                                </div>
                                            {% endif %}
                                        {% else %}
                                            <hr class="cms-preview-divider">
                                        {% endif %}
                                    {% elseif block.type == 'gallery' %}
                                        {% set images = p.images|default([]) %}
                                        {% if images is not empty %}
                                            <div class="cms-preview-gallery">
                                                {% for img in images %}
                                                    {% set src = img.url|default(img.src|default('')) %}
                                                    {% if src %}
                                                        <figure class="cms-preview-gallery__item">
                                                            <img src="{{ src }}" alt="{{ img.alt|default('') }}" loading="lazy">
                                                        </figure>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <p class="muted">{{ 'cms.block.type.gallery'|trans }}{% if p.media_ids %}: {{ p.media_ids is iterable ? p.media_ids|join(', ') : p.media_ids }}{% endif %}</p>
                                        {% endif %}
                                    {% elseif block.type == 'products' %}
                                        <div class="cms-preview-products">
                                            <p class="cms-preview-products__title">{{ 'cms.block.type.products'|trans }}</p>
                                            <p class="muted">{{ p.product_ids|default('—') }}</p>
                                        </div>
                                    {% elseif block.type == 'quote' %}
                                        <blockquote class="cms-preview-quote">
                                            <p>{{ p.quote|default('') }}</p>
                                            {% if p.author or p.role %}
                                                <footer>
                                                    {% if p.author %}<strong>{{ p.author }}</strong>{% endif %}
                                                    {% if p.role %}{% if p.author %} · {% endif %}<span>{{ p.role }}</span>{% endif %}
                                                </footer>
                                            {% endif %}
                                        </blockquote>
                                    {% elseif block.type == 'video' %}
                                        {% if p.url %}
                                            <p class="muted">{{ 'cms.block.type.video'|trans }}: <a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.url }}</a></p>
                                            {% if p.caption %}<p class="muted">{{ p.caption }}</p>{% endif %}
                                        {% else %}
                                            <p class="muted">{{ 'cms.block.type.video'|trans }}</p>
                                        {% endif %}
                                    {% elseif block.type == 'spacer' %}
                                        <div class="cms-preview-spacer cms-preview-spacer--{{ p.size|default('md') }}" aria-hidden="true"></div>
                                    {% elseif block.type == 'icon' %}
                                        <div class="cms-preview-icon cms-preview-icon--{{ p.size|default('md') }}">
                                            <span class="material-symbols-outlined g-icon" aria-hidden="true">{{ p.name|default('circle') }}</span>
                                            <span class="muted">{{ p.name|default('icon') }}</span>
                                        </div>
                                    {% elseif block.type == 'table' %}
                                        {% if p.caption and p.caption_visible|default('1') != '0' %}<p>{{ p.caption|raw }}</p>{% endif %}
                                        <div class="prose-cms">{{ p.html|default('')|raw }}</div>
                                    {% else %}
                                        <pre class="cms-preview-raw">{{ p|json_encode }}</pre>
                                    {% endif %}
                                </section>
                            {% endfor %}
                        {% endif %}
                    {% endif %}
                </div>
            </article>
            {% endif %}
        </div>
    </div>
    {{ render_js() }}
</body>
</html>
