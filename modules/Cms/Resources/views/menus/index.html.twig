{% extends 'admin/layout.html.twig' %}

{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="cms-menus" data-actions-default="1">
    <header class="page-header">
        <h1>{{ 'cms.menus.title'|trans }}</h1>
        {% if user.can('cms.manage') %}
            {% embed 'ui/button.html.twig' with { button_options: { tag: 'a' } } %}{% block button_attributes %} class="btn btn--primary" href="{{ url('admin.cms.menus.create') }}"{% endblock %}{% block content %}{{ icon('plus') }} {{ 'cms.menus.new'|trans }}{% endblock %}{% endembed %}
        {% endif %}
    </header>

    <div class="toolbar--table">
        {% embed 'ui/toolbar.html.twig' with { table: false, toolbar_options: { tag: 'div' } } %}{% block component_attributes %} class="toolbar"{% endblock %}{% block content %}{% endblock %}{% endembed %}
    </div>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'cms.field.name'|trans }}</th>
                    <th>{{ 'cms.field.location'|trans }}</th>
                    <th>{{ 'cms.field.updated'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td><a href="{{ url('admin.cms.menus.edit', {id: item.id()}) }}">{{ item.name() }}</a></td>
                        <td><span class="badge">{{ item.locationLabel()|trans }}</span></td>
                        <td>{{ item.updatedAt().format('d. m. Y H:i') }}</td>
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('cms.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.cms.menus.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.cms.menus.destroy', {id: item.id()}), confirm: 'cms.confirm_delete_menu'|trans } %}
                                {% else %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.cms.menus.edit', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">
                            <div class="empty">
                                <h2>{{ 'cms.menus.empty'|trans }}</h2>
                                <p>{{ 'cms.menus.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
