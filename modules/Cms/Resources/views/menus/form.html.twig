{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'cms.menus.edit'|trans : 'cms.menus.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'cms.menu.save' } %}

    <form method="post" class="form-grid" action="{{ item ? url('admin.cms.menus.update', {id: item.id()}) : url('admin.cms.menus.store') }}" data-form="cms.menu.save" x-data="gereqForm"{% if form_errors('cms.menu.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {% include 'ui/input.html.twig' with {
            name: 'name',
            label: 'cms.field.name'|trans,
            required: true,
            form: 'cms.menu.save',
            value: item ? item.name() : ''
        } %}
        {% include 'ui/select.html.twig' with {
            name: 'location',
            label: 'cms.field.location'|trans,
            required: true,
            form: 'cms.menu.save',
            value: item ? item.location() : 'header',
            options: [
                {value: 'header', label: 'cms.menu.location.header'|trans},
                {value: 'footer', label: 'cms.menu.location.footer'|trans}
            ]
        } %}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ item ? url('admin.cms.menus.show', {id: item.id()}) : url('admin.cms.menus.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </form>
{% endblock %}
