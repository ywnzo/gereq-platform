{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'cms.menus.edit'|trans : 'cms.menus.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'cms.menu.save' } %}

    <form method="post" class="detail-stack" action="{{ item ? url('admin.cms.menus.update', {id: item.id()}) : url('admin.cms.menus.store') }}" data-form="cms.menu.save" x-data="gereqForm"{% if form_errors('cms.menu.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        <section class="panel">
            <header class="panel__head">
                <h2>{{ 'common.details'|trans }}</h2>
            </header>
            {{ forms().render(item ?? 'Modules\\Cms\\Domain\\SiteMenu', {
                form: 'cms.menu.save',
                cols: 1
            }) }}
        </section>
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ item ? url('admin.cms.menus.show', {id: item.id()}) : url('admin.cms.menus.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </form>
{% endblock %}
