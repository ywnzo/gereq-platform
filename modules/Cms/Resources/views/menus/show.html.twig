{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <div>
            <h1>{{ item.name() }}</h1>
            <p class="muted detail-layout__meta">
                <span class="badge badge--info">{{ item.locationLabel()|trans }}</span>
            </p>
        </div>
        <div class="actions">
            {% if user.can('cms.manage') %}
                <a class="btn btn--ghost" href="{{ url('admin.cms.menus.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.cms.menus.destroy', {id: item.id()}) }}" data-confirm="{{ 'cms.confirm_delete_menu'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="detail-layout">
        <div class="detail-layout__main">
            <section class="detail-hero panel">
                <div class="detail-hero__body">
                    <div class="detail-hero__highlight">
                        <span>{{ 'cms.field.location'|trans|default('Umístění') }}</span>
                        <strong>{{ item.locationLabel()|trans }}</strong>
                    </div>
                    <dl class="detail-hero__facts">
                        <div>
                            <dt>{{ 'cms.menu_items.title'|trans }}</dt>
                            <dd>{{ menuItems|length }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'common.name'|trans|default('Název') }}</dt>
                            <dd>{{ item.name() }}</dd>
                        </div>
                    </dl>
                </div>
            </section>

            <section class="panel">
                <header class="panel__head"><h2>{{ 'cms.menu_items.title'|trans }}</h2></header>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>{{ 'cms.field.order'|trans }}</th>
                                <th>{{ 'cms.field.label'|trans }}</th>
                                <th>{{ 'cms.field.url'|trans }}</th>
                                <th>{{ 'cms.field.page'|trans }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in menuItems %}
                                <tr>
                                    <td>{{ row.sortOrder() }}</td>
                                    <td>{{ row.label() }}</td>
                                    <td>{{ row.url()|default('—') }}</td>
                                    <td>{{ row.pageId()|default('—') }}</td>
                                    <td>
                                        {% if user.can('cms.manage') %}
                                            <form method="post" action="{{ url('admin.cms.menus.items.destroy', {id: item.id(), itemId: row.id()}) }}" data-confirm="{{ 'cms.confirm_delete_menu_item'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                                {{ csrf_field()|raw }}
                                                <button class="btn btn--ghost" type="submit">{{ 'common.delete'|trans }}</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="muted">{{ 'cms.menu_items.empty'|trans }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if user.can('cms.manage') %}
                    {% include 'ui/error-summary.html.twig' with { form: 'cms.menu_item.save' } %}
                    <form method="post" class="form-grid form-grid--compact" action="{{ url('admin.cms.menus.items.store', {id: item.id()}) }}" data-form="cms.menu_item.save" x-data="gereqForm"{% if form_errors('cms.menu_item.save') %} data-server-state="1"{% endif %}>
                        {{ csrf_field()|raw }}
                        {% include 'ui/input.html.twig' with { name: 'label', label: 'cms.field.label'|trans, form: 'cms.menu_item.save', value: '' } %}
                        {% include 'ui/input.html.twig' with { name: 'url', label: 'cms.field.url'|trans, optional: true, form: 'cms.menu_item.save', value: '', hint: 'cms.field.url.hint'|trans } %}
                        {% include 'ui/select.html.twig' with {
                            name: 'page_id',
                            label: 'cms.field.page'|trans,
                            optional: true,
                            form: 'cms.menu_item.save',
                            value: '',
                            options: pageOptions
                        } %}
                        {% include 'ui/input.html.twig' with { name: 'parent_id', label: 'cms.field.parent_id'|trans, optional: true, form: 'cms.menu_item.save', value: '' } %}
                        <div class="form-actions">
                            <button class="btn btn--primary" type="submit">{{ 'cms.menu_items.add'|trans }}</button>
                        </div>
                    </form>
                {% endif %}
            </section>
        </div>

        <aside class="detail-layout__aside">
            <section class="panel">
                <header class="panel__head"><h2>{{ 'common.overview'|trans }}</h2></header>
                <dl class="meta-list meta-list--flush detail-layout__specs">
                    <div class="meta-list__full">
                        <dt>{{ 'cms.field.location'|trans|default('Umístění') }}</dt>
                        <dd>{{ item.locationLabel()|trans }}</dd>
                    </div>
                    <div class="meta-list__full">
                        <dt>{{ 'cms.menu_items.title'|trans }}</dt>
                        <dd>{{ menuItems|length }}</dd>
                    </div>
                </dl>
            </section>
        </aside>
    </div>
{% endblock %}
