<!DOCTYPE html>
<html lang="{{ app_locale() }}" data-theme="gereq">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ item.title() }} · {{ siteTitle }}</title>
    {% if item.metaDescription() %}
        <meta name="description" content="{{ item.metaDescription() }}">
    {% endif %}
    {% include 'partials/brand-head.html.twig' %}
    <link rel="stylesheet" href="{{ asset('resources/css/admin.css') }}">
    <style>
        .cms-shell { max-width: 920px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
        .cms-shell--landing { max-width: 1100px; }
        .cms-top { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid rgba(0,0,0,.08); padding-bottom: 1rem; }
        .cms-brand { font-weight: 700; font-size: 1.1rem; text-decoration: none; color: inherit; }
        .cms-nav { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; list-style: none; margin: 0; padding: 0; }
        .cms-nav a { text-decoration: none; color: inherit; opacity: .85; }
        .cms-nav a:hover { opacity: 1; }
        .cms-preview-bar { background: #1f2937; color: #fff; padding: .6rem 1rem; font-size: .875rem; display: flex; justify-content: space-between; gap: 1rem; }
        .cms-preview-bar a { color: #fff; }
        .cms-block { margin: 1.75rem 0; }
        .cms-block--columns { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
        @media (min-width: 720px) { .cms-block--columns { grid-template-columns: 1fr 1fr; } }
        .cms-block img { max-width: 100%; height: auto; border-radius: 6px; }
        .cms-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: .75rem; }
        .cms-divider { border: 0; border-top: 1px solid rgba(0,0,0,.12); margin: 2rem 0; }
        .cms-products { display: grid; gap: .75rem; }
        .cms-footer { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid rgba(0,0,0,.08); font-size: .9rem; opacity: .8; }
    </style>
</head>
<body>
    {% if preview %}
        <div class="cms-preview-bar">
            <span>{{ 'cms.preview.banner'|trans }}</span>
            <a href="{{ url('admin.cms.pages.show', {id: item.id()}) }}">{{ 'cms.preview.back'|trans }}</a>
        </div>
    {% endif %}

    <div class="cms-shell{% if item.template() == 'landing' %} cms-shell--landing{% endif %}">
        <header class="cms-top">
            <a class="cms-brand" href="/">{{ siteTitle }}</a>
            {% for entry in menus %}
                {% if entry.menu.location() == 'header' %}
                    <ul class="cms-nav">
                        {% for row in entry.items %}
                            <li><a href="{{ row.href }}">{{ row.item.label() }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </header>

        <article>
            {% if item.template() != 'landing' %}
                <h1>{{ item.title() }}</h1>
            {% endif %}

            {% for block in blocks %}
                {% set p = block.payload() %}
                <div class="cms-block cms-block--{{ block.type() }}">
                    {% if block.type() == 'heading' %}
                        {% set level = p.level|default(2) %}
                        {% if level == 1 %}<h1>{{ p.text|default('') }}</h1>
                        {% elseif level == 3 %}<h3>{{ p.text|default('') }}</h3>
                        {% else %}<h2>{{ p.text|default('') }}</h2>{% endif %}
                    {% elseif block.type() == 'text' %}
                        <div class="cms-text">{{ p.body|default('')|nl2br }}</div>
                    {% elseif block.type() == 'image' %}
                        {% set src = p.url|default('') %}
                        {% if hasMedia|default(false) and p.media_id|default('') %}
                            {% set src = url('media.public.file', {id: p.media_id}) %}
                        {% endif %}
                        {% if src %}
                            <figure>
                                <img src="{{ src }}" alt="{{ p.alt|default('') }}">
                                {% if p.caption|default('') %}<figcaption>{{ p.caption }}</figcaption>{% endif %}
                            </figure>
                        {% endif %}
                    {% elseif block.type() == 'html' %}
                        <div class="cms-html">{{ p.html|default('')|raw }}</div>
                    {% elseif block.type() == 'cta' %}
                        <p><a class="btn btn--primary" href="{{ p.url|default('#') }}">{{ p.label|default('CTA') }}</a></p>
                    {% elseif block.type() == 'columns' %}
                        <div class="cms-block--columns">
                            <div>{{ p.left|default('')|nl2br }}</div>
                            <div>{{ p.right|default('')|nl2br }}</div>
                        </div>
                    {% elseif block.type() == 'divider' %}
                        <hr class="cms-divider">
                    {% elseif block.type() == 'products' %}
                        <div class="cms-products">
                            {% set rawIds = p.product_ids|default([]) %}
                            {% if rawIds is iterable and rawIds is not same as('') %}
                                {% set ids = rawIds %}
                            {% else %}
                                {% set ids = (rawIds ~ '')|split(',') %}
                            {% endif %}
                            {% for pid in ids %}
                                {% set pid = pid|trim %}
                                {% if pid and products[pid] is defined %}
                                    <div>
                                        <strong>{{ products[pid].name }}</strong>
                                        <span class="muted"> · {{ products[pid].sku }}</span>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% elseif block.type() == 'gallery' %}
                        <div class="cms-gallery">
                            {% if hasMedia|default(false) %}
                                {% set ids = p.media_ids|default('')|split(',') %}
                                {% for mid in ids %}
                                    {% set mid = mid|trim %}
                                    {% if mid %}
                                        <img src="{{ url('media.public.file', {id: mid}) }}" alt="">
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </article>

        <footer class="cms-footer">
            {% for entry in menus %}
                {% if entry.menu.location() == 'footer' %}
                    <ul class="cms-nav">
                        {% for row in entry.items %}
                            <li><a href="{{ row.href }}">{{ row.item.label() }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </footer>
    </div>
</body>
</html>
