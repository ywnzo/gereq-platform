{% extends 'admin/layout.html.twig' %}

{% block content %}
<header class="page-header">
    <h1>{{ item ? 'coupons.edit'|trans : 'coupons.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'coupons.save' } %}

{% set typeOptions = [] %}
{% for type in types %}
    {% set typeOptions = typeOptions|merge([{ value: type, label: ('coupons.type.' ~ type)|trans }]) %}
{% endfor %}

<form method="post" class="form-grid" action="{{ item ? url('admin.coupons.update', {id: item.id()}) : url('admin.coupons.store') }}" data-form="coupons.save" x-data="gereqForm"{% if form_errors('coupons.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}
    {% include 'ui/input.html.twig' with {
        name: 'code',
        label: 'coupons.field.code'|trans,
        required: true,
        form: 'coupons.save',
        value: item ? item.code() : ''
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'name',
        label: 'coupons.field.name'|trans,
        required: true,
        form: 'coupons.save',
        value: item ? item.name() : ''
    } %}
    {% include 'ui/select.html.twig' with {
        name: 'type',
        label: 'coupons.field.type'|trans,
        required: true,
        form: 'coupons.save',
        value: item ? item.type() : 'percent',
        options: typeOptions
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'value',
        label: 'coupons.field.value'|trans,
        required: true,
        form: 'coupons.save',
        value: item ? item.value() : '0'
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'currency',
        label: 'coupons.field.currency'|trans,
        optional: true,
        form: 'coupons.save',
        value: item and item.currency() ? item.currency() : '',
        hint: 'coupons.field.currency.hint'|trans
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'min_order',
        label: 'coupons.field.min_order'|trans,
        optional: true,
        form: 'coupons.save',
        value: item and item.minOrder() ? item.minOrder() : ''
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'max_uses',
        label: 'coupons.field.max_uses'|trans,
        optional: true,
        form: 'coupons.save',
        value: item and item.maxUses() is not null ? item.maxUses() : ''
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'starts_at',
        label: 'coupons.field.starts_at'|trans,
        optional: true,
        form: 'coupons.save',
        value: item and item.startsAt() ? item.startsAt().format('Y-m-d\\TH:i') : '',
        type: 'datetime-local'
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'ends_at',
        label: 'coupons.field.ends_at'|trans,
        optional: true,
        form: 'coupons.save',
        value: item and item.endsAt() ? item.endsAt().format('Y-m-d\\TH:i') : '',
        type: 'datetime-local'
    } %}
    <label class="field">
        <span class="field__label">{{ 'coupons.field.active'|trans }}</span>
        <input type="checkbox" name="active" value="1" {{ (item is null or item.isActive()) ? 'checked' : '' }}>
    </label>
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.coupons.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
