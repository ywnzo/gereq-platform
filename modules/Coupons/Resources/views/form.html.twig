{% extends 'admin/layout.html.twig' %}

{% block content %}
<header class="page-header">
    <h1>{{ item ? 'coupons.edit'|trans : 'coupons.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'coupons.save' } %}

{% set couponSource = item ?? 'Modules\\Coupons\\Domain\\Coupon' %}
{% set couponValues = item ? {
    starts_at: item.startsAt() ? item.startsAt().format('Y-m-d\\TH:i') : '',
    ends_at: item.endsAt() ? item.endsAt().format('Y-m-d\\TH:i') : '',
} : {} %}

<form method="post" action="{{ item ? url('admin.coupons.update', {id: item.id()}) : url('admin.coupons.store') }}" data-form="coupons.save" x-data="gereqForm"{% if form_errors('coupons.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}
    {{ forms().render(couponSource, {
        form: 'coupons.save',
        cols: 2,
        values: couponValues
    }) }}
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.coupons.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
