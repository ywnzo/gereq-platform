{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="coupons" data-actions-default="1">
<header class="page-header">
    <h1>{{ 'coupons.title'|trans }}</h1>
    <div class="actions">
        {% if user.can('coupons.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.coupons.create') }}">{{ icon('plus') }} {{ 'coupons.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'coupons.search'|trans }}">
    </form>
    <div class="toolbar__toggles">
        {% include 'ui/table_actions_toggle.html.twig' %}
    </div>
</div>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
<th>{{ 'coupons.field.code'|trans }}</th>
<th>{{ 'coupons.field.name'|trans }}</th>
<th>{{ 'coupons.field.type'|trans }}</th>
<th>{{ 'coupons.field.value'|trans }}</th>
<th>{{ 'coupons.field.uses'|trans }}</th>
<th>{{ 'coupons.field.active'|trans }}</th>
<th class="table__actions-head" x-show="showActions" x-cloak></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><strong>{{ item.code() }}</strong></td>
    <td>{{ item.name() }}</td>
    <td>{{ ('coupons.type.' ~ item.type())|trans }}</td>
    <td>
        {% if item.type() == 'percent' %}
            {{ item.value() }} %
        {% else %}
            {{ item.value() }}{{ item.currency() ? ' ' ~ item.currency() : '' }}
        {% endif %}
    </td>
    <td>
        {{ item.usedCount() }}{% if item.maxUses() is not null %} / {{ item.maxUses() }}{% endif %}
    </td>
    <td>
        <span class="badge badge--{{ item.isActive() ? 'ok' : 'muted' }}">
            {{ item.isActive() ? 'coupons.active'|trans : 'coupons.inactive'|trans }}
        </span>
    </td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% if user.can('coupons.manage') %}
                <a href="{{ url('admin.coupons.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                <form method="post" action="{{ url('admin.coupons.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'coupons.confirm_delete'|trans|e('js') }}');">
                    {{ csrf_field()|raw }}
                    <button type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr>
<td colspan="7">
<div class="empty">
<h2>{{ 'coupons.empty'|trans }}</h2>
<p>{{ 'coupons.empty.hint'|trans }}</p>
</div>
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
