{# Shared catalog discount panel (product or category).
   Expects: discounts (list), formAction, kindOptions/conditionOptions or discountConditions,
   optional: canManage (bool, default from user.can)
#}
{% set canManage = canManage is defined ? canManage : user.can('product_discounts.manage') %}
{% set kindOptions = [
    { value: 'percent', label: 'product_discounts.kind.percent'|trans },
    { value: 'amount', label: 'product_discounts.kind.amount'|trans }
] %}
{% set conditionOptions = [] %}
{% for cond in discountConditions|default(['none']) %}
    {% set conditionOptions = conditionOptions|merge([{ value: cond, label: ('product_discounts.condition.' ~ cond)|trans }]) %}
{% endfor %}
{% set discounts = discounts|default([]) %}

<section class="panel discount-panel">
    <header class="panel__head">
        <div>
            <h2>{{ panelTitle|default('product_discounts.panel.title'|trans) }}</h2>
            <p class="muted">{{ panelHint|default('product_discounts.panel.hint'|trans) }}</p>
        </div>
    </header>

    {% if discounts is not empty %}
        <div class="table-wrap" style="margin-bottom:1rem">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'product_discounts.field.kind'|trans }}</th>
                        <th>{{ 'product_discounts.field.value'|trans }}</th>
                        <th>{{ 'product_discounts.field.condition'|trans }}</th>
                        <th>{{ 'product_discounts.field.description'|trans }}</th>
                        <th>{{ 'product_discounts.field.status'|trans }}</th>
                        {% if canManage %}<th class="table__actions-head"></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for d in discounts %}
                        <tr>
                            <td>{{ ('product_discounts.kind.' ~ d.kind())|trans }}</td>
                            <td>{% if d.kind() == 'percent' %}{{ d.value() }} %{% else %}{{ d.value()|money }}{% endif %}</td>
                            <td>
                                {{ ('product_discounts.condition.' ~ d.conditionType())|trans }}
                                {% if d.conditionValue() is not null %}<span class="muted">({{ d.conditionValue() }})</span>{% endif %}
                            </td>
                            <td class="muted">{{ d.description() ?: '—' }}</td>
                            <td>
                                {% if d.isCurrentlyActive() %}
                                    <span class="badge badge--ok">{{ 'product_discounts.active'|trans }}</span>
                                {% else %}
                                    <span class="badge badge--muted">{{ 'product_discounts.inactive'|trans }}</span>
                                {% endif %}
                            </td>
                            {% if canManage %}
                                <td class="table__actions">
                                    <form method="post" action="{{ url('admin.product_discounts.remove', {id: d.id()}) }}" data-confirm="{{ 'product_discounts.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                                        {{ csrf_field()|raw }}
                                        <button type="submit" class="btn btn--ghost btn-sm">{{ 'common.delete'|trans }}</button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="muted discount-panel__empty">{{ 'product_discounts.empty'|trans }}</p>
    {% endif %}

    {% if canManage %}
        <form method="post" class="discount-form" action="{{ formAction }}" data-form="product_discounts.save">
            {{ csrf_field()|raw }}

            <div class="discount-form__grid">
                {% include 'ui/select.html.twig' with { name: 'kind', label: 'product_discounts.field.kind'|trans, form: 'product_discounts.save', value: 'percent', options: kindOptions } %}
                {% include 'ui/input.html.twig' with { name: 'value', label: 'product_discounts.field.value'|trans, form: 'product_discounts.save', value: '10' } %}
                {% include 'ui/select.html.twig' with { name: 'condition_type', label: 'product_discounts.field.condition'|trans, form: 'product_discounts.save', value: 'none', options: conditionOptions } %}
                {% include 'ui/input.html.twig' with { name: 'condition_value', type: 'number', label: 'product_discounts.field.condition_value'|trans, optional: true, form: 'product_discounts.save', value: '', placeholder: 'N' } %}

                {% include 'ui/input.html.twig' with { name: 'description', label: 'product_discounts.field.description'|trans, optional: true, form: 'product_discounts.save', value: '', extra: 'discount-form__span-2' } %}
                {% include 'ui/input.html.twig' with { name: 'starts_at', type: 'datetime-local', label: 'product_discounts.field.starts_at'|trans, optional: true, form: 'product_discounts.save', value: '' } %}
                {% include 'ui/input.html.twig' with { name: 'ends_at', type: 'datetime-local', label: 'product_discounts.field.ends_at'|trans, optional: true, form: 'product_discounts.save', value: '' } %}

                <div class="g-field discount-form__active">
                    <span class="g-label"><span>{{ 'product_discounts.field.active'|trans }}</span></span>
                    <label class="check discount-form__check">
                        <input type="hidden" name="active" value="0">
                        <input type="checkbox" name="active" value="1" checked>
                        <span>{{ 'product_discounts.active'|trans }}</span>
                    </label>
                </div>
            </div>

            <p class="g-hint discount-form__hint">{{ 'product_discounts.field.condition_value.hint'|trans }}</p>

            <div class="discount-form__actions">
                <button class="btn btn--primary" type="submit">{{ 'product_discounts.add'|trans }}</button>
            </div>
        </form>
    {% endif %}
</section>
