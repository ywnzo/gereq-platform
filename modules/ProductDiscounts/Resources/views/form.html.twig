{% extends 'admin/layout.html.twig' %}

{% block content %}
<header class="page-header">
    <h1>{{ item ? 'product_discounts.edit'|trans : 'product_discounts.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'product_discounts.save' } %}

{% set kindOptions = [] %}
{% for kind in kinds %}
    {% set kindOptions = kindOptions|merge([{ value: kind, label: ('product_discounts.kind.' ~ kind)|trans }]) %}
{% endfor %}
{% set conditionOptions = [] %}
{% for cond in conditions|default(['none']) %}
    {% set conditionOptions = conditionOptions|merge([{ value: cond, label: ('product_discounts.condition.' ~ cond)|trans }]) %}
{% endfor %}

<form method="post" class="form-grid" action="{{ item ? url('admin.product_discounts.update', {id: item.id()}) : url('admin.product_discounts.store') }}" data-form="product_discounts.save" x-data="{ scope: '{{ item ? item.scopeType() : 'product' }}' }"{% if form_errors('product_discounts.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}

    {% if item %}
        <div class="field">
            <span class="g-label">{{ 'product_discounts.field.scope'|trans }}</span>
            <p>
                {% if item.scopeType() == 'category' %}
                    {{ 'product_discounts.scope.category'|trans }}:
                    <strong>{{ category ? category.name() : item.scopeId() }}</strong>
                {% else %}
                    {{ 'product_discounts.scope.product'|trans }}:
                    <strong>{{ product ? product.name() : item.scopeId() }}</strong>
                {% endif %}
            </p>
        </div>
    {% else %}
        <label class="field">
            <span class="g-label">{{ 'product_discounts.field.scope'|trans }}</span>
            <select class="input" name="scope_type" x-model="scope" required>
                <option value="product">{{ 'product_discounts.scope.product'|trans }}</option>
                <option value="category">{{ 'product_discounts.scope.category'|trans }}</option>
            </select>
        </label>
        <div x-show="scope === 'product'">
            <label class="field">
                <span class="g-label">{{ 'product_discounts.field.product'|trans }}</span>
                <select class="input" name="scope_id" :required="scope === 'product'">
                    <option value="">—</option>
                    {% for opt in productOptions %}
                        <option value="{{ opt.value }}">{{ opt.label }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>
        <div x-show="scope === 'category'" x-cloak>
            <label class="field">
                <span class="g-label">{{ 'product_discounts.field.category'|trans }}</span>
                <select class="input" name="scope_id_category" :required="scope === 'category'">
                    <option value="">—</option>
                    {% for opt in categoryOptions %}
                        <option value="{{ opt.value }}">{{ opt.label }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>
        <script>
            document.currentScript.closest('form').addEventListener('submit', function () {
                const scope = this.querySelector('[name="scope_type"]').value;
                if (scope === 'category') {
                    const cat = this.querySelector('[name="scope_id_category"]');
                    const prod = this.querySelector('[name="scope_id"]');
                    if (cat && prod) {
                        prod.removeAttribute('name');
                        cat.name = 'scope_id';
                    }
                } else {
                    const cat = this.querySelector('[name="scope_id_category"]');
                    if (cat) cat.removeAttribute('name');
                }
            });
        </script>
    {% endif %}

    {% include 'ui/select.html.twig' with {
        name: 'kind',
        label: 'product_discounts.field.kind'|trans,
        required: true,
        form: 'product_discounts.save',
        value: item ? item.kind() : 'percent',
        options: kindOptions
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'value',
        label: 'product_discounts.field.value'|trans,
        required: true,
        form: 'product_discounts.save',
        value: item ? item.value() : '10'
    } %}
    {% include 'ui/select.html.twig' with {
        name: 'condition_type',
        label: 'product_discounts.field.condition'|trans,
        required: true,
        form: 'product_discounts.save',
        value: item ? item.conditionType() : 'none',
        options: conditionOptions
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'condition_value',
        type: 'number',
        label: 'product_discounts.field.condition_value'|trans,
        optional: true,
        form: 'product_discounts.save',
        value: item and item.conditionValue() is not null ? item.conditionValue() : '',
        hint: 'product_discounts.field.condition_value.hint'|trans
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'description',
        label: 'product_discounts.field.description'|trans,
        optional: true,
        form: 'product_discounts.save',
        value: item and item.description() ? item.description() : ''
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'starts_at',
        type: 'datetime-local',
        label: 'product_discounts.field.starts_at'|trans,
        optional: true,
        form: 'product_discounts.save',
        value: item and item.startsAt() ? item.startsAt().format('Y-m-d\\TH:i') : ''
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'ends_at',
        type: 'datetime-local',
        label: 'product_discounts.field.ends_at'|trans,
        optional: true,
        form: 'product_discounts.save',
        value: item and item.endsAt() ? item.endsAt().format('Y-m-d\\TH:i') : ''
    } %}
    <label class="check">
        <input type="hidden" name="active" value="0">
        <input type="checkbox" name="active" value="1" {{ (item is null or item.isActive()) ? 'checked' : '' }}>
        <span class="field__label">{{ 'product_discounts.field.active'|trans }}</span>
    </label>
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.product_discounts.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
