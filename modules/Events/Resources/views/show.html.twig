{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.events'|trans, url: url('admin.events.index') },
        { label: item.title() },
    ] } %}
{% endblock %}

{% block content %}
    {% set statusTone = item.status() == 'published' ? 'ok' : (item.status() == 'pending' ? 'warn' : (item.status() == 'rejected' ? 'danger' : 'muted')) %}
    {% set coverUrl = imageUrl|default('') %}
    {% set body = item.longDescription() %}

    <header class="page-header">
        <div>
            <h1>{{ item.title() }}</h1>
            <p class="muted listing-detail__meta">
                <code>{{ item.slug() }}</code>
                <span class="badge badge--{{ statusTone }}">{{ item.statusLabel()|trans }}</span>
                {% if item.spotlight() != 'none' %}
                    <span class="badge">{{ ('events.spotlight.' ~ item.spotlight())|trans }}</span>
                {% endif %}
                <span class="badge badge--info">{{ item.category() }}</span>
                <span class="badge badge--signal">{{ (interests|default([]))|length }}× {{ 'events.interest.count'|trans }}</span>
                <span class="badge">{{ (savers|default([]))|length }}× {{ 'events.saved.count'|trans }}</span>
            </p>
            <p class="module-lead">{{ item.place() }}{% if item.region() %} · {{ item.region() }}{% endif %}</p>
            <p class="muted">
                {{ 'events.field.submitted_by'|trans }}:
                {% if submitter %}
                    {% if user.can('customers.view') %}
                        <a href="{{ url('admin.customers.show', {id: submitter.id()}) }}">{{ submitter.name() }}</a>
                    {% else %}
                        {{ submitter.name() }}
                    {% endif %}
                    · {{ submitter.email() }}
                {% else %}
                    {{ 'events.submitted.admin'|trans }}
                {% endif %}
                · {{ item.createdAt().format('j. n. Y H:i') }}
            </p>
            {% if item.status() == 'rejected' and item.rejectionReason() %}
                <div class="listing-prose">
                    <p class="muted">{{ 'events.field.rejection_reason'|trans }}</p>
                    {{ item.rejectionReason()|raw }}
                </div>
            {% endif %}
        </div>
        <div class="actions">
            {% if user.can('events.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.events.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                {% if item.status() != 'published' %}
                    <form method="post" action="{{ url('admin.events.publish', {id: item.id()}) }}">
                        {{ csrf_field()|raw }}
                        <button class="btn btn--ghost" type="submit">{{ 'events.action.publish'|trans }}</button>
                    </form>
                {% endif %}
                {% if item.status() == 'pending' %}
                    {% include '@events/partials/reject_form.html.twig' with { as_button: true, form_class: '' } %}
                {% endif %}
                {% include '@events/partials/spotlight_form.html.twig' %}
                {% if submitter and user.can('events.manage') %}
                    {% if submitterTrusted %}
                        <form method="post" action="{{ url('admin.events.organizers.untrust', {customerId: submitter.id()}) }}">
                            {{ csrf_field()|raw }}
                            <button class="btn btn--ghost" type="submit">{{ 'events.trust.revoke'|trans }}</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ url('admin.events.organizers.trust', {customerId: submitter.id()}) }}">
                            {{ csrf_field()|raw }}
                            <button class="btn btn--ghost" type="submit">{{ 'events.trust.grant'|trans }}</button>
                        </form>
                    {% endif %}
                {% endif %}
                {% if item.status() != 'archived' %}
                    <form method="post" action="{{ url('admin.events.archive', {id: item.id()}) }}">
                        {{ csrf_field()|raw }}
                        <button class="btn btn--ghost" type="submit">{{ 'events.action.archive'|trans }}</button>
                    </form>
                {% endif %}
                <form method="post" action="{{ url('admin.events.destroy', {id: item.id()}) }}" data-confirm="{{ 'events.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="listing-detail">
        <div class="listing-detail__main">
            <section class="listing-hero panel">
                {% if coverUrl %}
                    <a class="listing-hero__media" href="{{ coverUrl }}" target="_blank" rel="noopener">
                        <img src="{{ coverUrl }}" alt="{{ item.title() }}" loading="eager" decoding="async">
                    </a>
                {% else %}
                    <div class="listing-hero__media listing-hero__media--empty muted">{{ 'events.photo.empty'|trans }}</div>
                {% endif %}
                <div class="listing-hero__body">
                    <div class="listing-hero__price">
                        <span>{{ 'events.field.price'|trans }}</span>
                        <strong>{{ item.price() ?: '—' }}</strong>
                    </div>
                    <dl class="listing-hero__facts">
                        <div>
                            <dt>{{ 'events.field.starts_at'|trans }}</dt>
                            <dd>
                                {% if hideDates|default(false) %}
                                    {{ 'events.field.no_dates'|trans }}
                                {% else %}
                                    {{ item.startsAt().format('j. n. Y H:i') }}
                                    {% if not item.showStartsAt() %}
                                        <span class="muted">({{ 'events.field.hidden_on_web'|trans }})</span>
                                    {% endif %}
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt>{{ 'events.field.ends_at'|trans }}</dt>
                            <dd>
                                {% if hideDates|default(false) %}
                                    {{ 'events.field.no_dates'|trans }}
                                {% elseif item.endsAt() %}
                                    {{ item.endsAt().format('j. n. Y H:i') }}
                                    {% if not item.showEndsAt() %}
                                        <span class="muted">({{ 'events.field.hidden_on_web'|trans }})</span>
                                    {% endif %}
                                {% else %}
                                    —
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt>{{ 'events.field.time_label'|trans }}</dt>
                            <dd>{{ item.timeLabel() ?: '—' }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'events.field.capacity'|trans }}</dt>
                            <dd>{{ item.capacity() ?: '—' }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'events.field.external_url'|trans }}</dt>
                            <dd>
                                {% if item.externalUrl() %}
                                    <a href="{{ item.externalUrl() }}" target="_blank" rel="noopener noreferrer">{{ item.externalUrl() }}</a>
                                {% else %}
                                    —
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </section>

            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'events.section.content'|trans }}</h2>
                </header>
                <div class="listing-desc listing-prose">
                    {% if item.description() %}
                        <p><strong>{{ item.description() }}</strong></p>
                    {% endif %}
                    {% if body %}
                        {% if '<' in body %}
                            {{ body|raw }}
                        {% else %}
                            <p>{{ body }}</p>
                        {% endif %}
                    {% elseif not item.description() %}
                        —
                    {% endif %}
                    {% for section in item.sections() %}
                        {% if section.heading|default('') %}
                            <h3>{{ section.heading }}</h3>
                        {% endif %}
                        {% for paragraph in section.paragraphs|default([]) %}
                            <p>{{ paragraph }}</p>
                        {% endfor %}
                        {% if section.list|default([]) %}
                            <ul>
                                {% for row in section.list %}
                                    <li>{{ row }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endfor %}
                </div>
            </section>

            {% if galleryItems|default([]) %}
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'events.section.gallery'|trans }}</h2>
                </header>
                <div class="event-admin-gallery">
                    {% for item in galleryItems %}
                        <figure class="event-admin-gallery__item">
                            {% if item.player == 'image' %}
                                <a href="{{ item.url }}" target="_blank" rel="noopener">
                                    <img src="{{ item.url }}" alt="{{ item.title }}" loading="lazy">
                                </a>
                            {% elseif item.player in ['youtube', 'vimeo'] %}
                                <iframe src="{{ item.embed_url }}" title="{{ item.title }}" loading="lazy" allowfullscreen></iframe>
                            {% else %}
                                <video controls preload="metadata" src="{{ item.url }}"></video>
                            {% endif %}
                            <figcaption>
                                <strong>{{ item.title ?: ('events.gallery.kind.' ~ item.kind)|trans }}</strong>
                                <span class="muted">{{ ('events.gallery.kind.' ~ item.kind)|trans }}</span>
                            </figcaption>
                        </figure>
                    {% endfor %}
                </div>
            </section>
            {% endif %}
        </div>

        <aside class="listing-detail__aside">
            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'events.section.basic'|trans }}</h2>
                </header>
                <dl class="listing-hero__facts">
                    <div>
                        <dt>{{ 'events.field.category'|trans }}</dt>
                        <dd>{{ item.category() }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'events.field.region'|trans }}</dt>
                        <dd>{{ item.region() }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'events.field.place'|trans }}</dt>
                        <dd>{{ item.place() }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'events.field.organizer'|trans }}</dt>
                        <dd>{{ item.organizer() ?: '—' }}</dd>
                    </div>
                    {% if item.source() %}
                    <div>
                        <dt>{{ 'events.field.source'|trans }}</dt>
                        <dd>{{ ('events.source.' ~ item.source())|trans }}{% if item.syncedAt() %} · {{ item.syncedAt().format('j. n. Y H:i') }}{% endif %}</dd>
                    </div>
                    {% endif %}
                    <div>
                        <dt>{{ 'events.field.color'|trans }}</dt>
                        <dd>{{ ('events.color.' ~ item.color())|trans }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'events.field.status'|trans }}</dt>
                        <dd>{{ item.statusLabel()|trans }}</dd>
                    </div>
                    <div>
                        <dt>{{ 'events.field.submitted_by'|trans }}</dt>
                        <dd>
                            {% if submitter %}
                                {% if user.can('customers.view') %}
                                    <a href="{{ url('admin.customers.show', {id: submitter.id()}) }}">{{ submitter.name() }}</a>
                                {% else %}
                                    {{ submitter.name() }}
                                {% endif %}
                            {% else %}
                                {{ 'events.submitted.admin'|trans }}
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt>{{ 'events.field.created_at'|trans }}</dt>
                        <dd>{{ item.createdAt().format('j. n. Y H:i') }}</dd>
                    </div>
                </dl>
            </section>

            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'events.interest.people'|trans }}</h2>
                </header>
                {% if interests is empty %}
                    <p class="muted">{{ 'events.interest.empty'|trans }}</p>
                {% else %}
                    <ul class="customer-list">
                        {% for row in interests %}
                            <li class="customer-list__item">
                                <div>
                                    {% if row.customer %}
                                        {% if user.can('customers.view') %}
                                            <a href="{{ url('admin.customers.show', {id: row.customer.id()}) }}"><strong>{{ row.customer.name() }}</strong></a>
                                        {% else %}
                                            <strong>{{ row.customer.name() }}</strong>
                                        {% endif %}
                                        <p class="muted">{{ row.customer.email() }}</p>
                                    {% else %}
                                        <strong>{{ 'events.saved.unknown'|trans }}</strong>
                                    {% endif %}
                                </div>
                                <span class="muted">{{ row.interest.createdAt().format('j. n. Y H:i') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <section class="panel">
                <header class="panel__head">
                    <h2>{{ 'events.saved.people'|trans }}</h2>
                </header>
                {% if savers is empty %}
                    <p class="muted">{{ 'events.saved.empty'|trans }}</p>
                {% else %}
                    <ul class="customer-list">
                        {% for row in savers %}
                            <li class="customer-list__item">
                                <div>
                                    {% if row.customer %}
                                        {% if user.can('customers.view') %}
                                            <a href="{{ url('admin.customers.show', {id: row.customer.id()}) }}"><strong>{{ row.customer.name() }}</strong></a>
                                        {% else %}
                                            <strong>{{ row.customer.name() }}</strong>
                                        {% endif %}
                                        <p class="muted">{{ row.customer.email() }}</p>
                                    {% else %}
                                        <strong>{{ 'events.saved.unknown'|trans }}</strong>
                                    {% endif %}
                                </div>
                                <span class="muted">{{ row.favorite.createdAt().format('j. n. Y H:i') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        </aside>
    </div>
{% endblock %}
