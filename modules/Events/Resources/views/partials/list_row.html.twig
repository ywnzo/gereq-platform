<tr
    :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''"
    {% if grouped|default(false) %}x-show="$store.eventsList.cityOpen($el.closest('[data-city]').dataset.city)"{% endif %}
>
    {% if canBulk %}
        <td class="table__check">
            <label class="table-check">
                <input
                    type="checkbox"
                    value="{{ item.id() }}"
                    @change="toggleId('{{ item.id() }}')"
                    :checked="isSelected('{{ item.id() }}')"
                >
                <span class="sr-only">{{ item.title() }}</span>
            </label>
        </td>
    {% endif %}
    <td>
        <div class="table__title">
            <div class="table__title-line">
                <a href="{{ url('admin.events.show', {id: item.id()}) }}">{{ item.title() }}</a>
                {% if item.source() %}
                    {% set sourceLabel = ('events.source.' ~ item.source())|trans %}
                    <span class="badge badge--muted">{{ sourceLabel starts with 'events.source.' ? item.source() : sourceLabel }}</span>
                {% endif %}
            </div>
            <span class="table__meta">{{ item.place() }}</span>
        </div>
    </td>
    <td>{{ item.category() }}</td>
    <td>{{ item.region() }}</td>
    <td class="is-mute">{% if item.category() in hideDatesSlugs|default([]) %}{{ 'events.field.no_dates'|trans }}{% else %}{{ item.startsAt().format('j. n. Y H:i') }}{% endif %}</td>
    <td>
        <span class="badge badge--{{ item.status() == 'published' ? 'ok' : (item.status() == 'pending' ? 'warn' : (item.status() == 'rejected' ? 'danger' : 'muted')) }}">
            {{ ('events.status.' ~ item.status())|trans }}
        </span>
    </td>
    <td class="is-mute">{{ item.createdAt().format('j. n. Y H:i') }}</td>
    <td>
        {% set sid = item.submittedByCustomerId() %}
        {% set submitter = sid ? submitters[sid]|default(null) : null %}
        {% if submitter %}
            {% if user.can('customers.view') %}
                <a href="{{ url('admin.customers.show', {id: submitter.id()}) }}">{{ submitter.name() }}</a>
            {% else %}
                {{ submitter.name() }}
            {% endif %}
        {% else %}
            <span class="is-mute">{{ 'events.submitted.admin'|trans }}</span>
        {% endif %}
    </td>
    <td>
        {% if item.spotlight() == 'none' %}
            <span class="is-mute">—</span>
        {% else %}
            <span class="badge">{{ ('events.spotlight.' ~ item.spotlight())|trans }}</span>
        {% endif %}
    </td>
    <td>
        {% set interest = interestCounts[item.id()]|default(0) %}
        {% if interest > 0 %}
            <a href="{{ url('admin.events.show', {id: item.id()}) }}"><strong>{{ interest }}</strong></a>
        {% else %}
            <span class="is-mute">0</span>
        {% endif %}
    </td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% include 'ui/row_action.html.twig' with { href: url('admin.events.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
            {% if user.can('events.manage') %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.events.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                {% if item.status() != 'published' %}
                    <form method="post" action="{{ url('admin.events.publish', {id: item.id()}) }}" class="table__action-form">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="table__action-btn table__action-btn--success" title="{{ 'events.action.publish'|trans }}" aria-label="{{ 'events.action.publish'|trans }}">
                            {{ icon('check') }}
                            <span class="table__action-btn__label">{{ 'events.action.publish'|trans }}</span>
                        </button>
                    </form>
                {% else %}
                    {% include 'ui/row_action.html.twig' with { placeholder: true } %}
                {% endif %}
                {% if item.status() == 'pending' %}
                    {% include '@events/partials/reject_form.html.twig' %}
                {% else %}
                    {% include 'ui/row_action.html.twig' with { placeholder: true } %}
                {% endif %}
                {% if item.status() != 'archived' %}
                    <form method="post" action="{{ url('admin.events.archive', {id: item.id()}) }}" class="table__action-form">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="table__action-btn table__action-btn--warn" title="{{ 'events.action.archive'|trans }}" aria-label="{{ 'events.action.archive'|trans }}">
                            {{ icon('archive') }}
                            <span class="table__action-btn__label">{{ 'events.action.archive'|trans }}</span>
                        </button>
                    </form>
                {% else %}
                    {% include 'ui/row_action.html.twig' with { placeholder: true } %}
                {% endif %}
                {% include 'ui/row_action_destroy.html.twig' with {
                    action: url('admin.events.destroy', {id: item.id()}),
                    confirm: 'events.confirm_delete'|trans
                } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
