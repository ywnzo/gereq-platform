{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.events'|trans, url: url('admin.events.index') },
        { label: item ? item.title() : ('events.new'|trans) },
    ] } %}
{% endblock %}

{% block content %}
    {% set isEdit = item is not null %}
    {% set source = item ?? 'Modules\\Events\\Domain\\CatalogEvent' %}
    {% set statusKey = isEdit ? item.status() : 'pending' %}
    {% set statusTone = statusKey == 'published' ? 'ok' : (statusKey == 'archived' ? 'muted' : (statusKey == 'rejected' ? 'danger' : 'info')) %}
    {% set startsValue = old('starts_at', isEdit ? item.startsAt().format('Y-m-d\\TH:i') : '', 'events.save') %}
    {% set endsValue = old('ends_at', isEdit and item.endsAt() ? item.endsAt().format('Y-m-d\\TH:i') : '', 'events.save') %}
    {% set categoryValue = old('category', isEdit ? item.category() : '', 'events.save') %}
    {% set showStartsRaw = old('show_starts_at', isEdit ? (item.showStartsAt() ? '1' : '0') : '1', 'events.save') %}
    {% set showEndsRaw = old('show_ends_at', isEdit ? (item.showEndsAt() ? '1' : '0') : '1', 'events.save') %}
    {% set showStartsChecked = showStartsRaw is same as(true) or showStartsRaw is same as(1) or showStartsRaw is same as('1') or showStartsRaw is same as('on') %}
    {% set showEndsChecked = showEndsRaw is same as(true) or showEndsRaw is same as(1) or showEndsRaw is same as('1') or showEndsRaw is same as('on') %}
    {% set scheduleHidden = categoryValue != '' and categoryValue in (hideDatesSlugs|default([])) %}

    <header class="page-header">
        <div>
            <h1>{{ isEdit ? 'events.edit'|trans : 'events.new'|trans }}</h1>
            {% if isEdit %}
                <p class="muted detail-layout__meta">
                    <code>{{ item.slug() }}</code>
                    <span class="status-chip status-chip--{{ statusTone }}">
                        <span class="status-chip__dot"></span>{{ item.statusLabel()|trans }}
                    </span>
                </p>
            {% else %}
                <p class="muted">{{ 'events.form.intro'|trans }}</p>
            {% endif %}
        </div>
        <div class="actions">
            {% if isEdit %}
                <a class="btn btn--ghost" href="{{ url('admin.events.show', {id: item.id()}) }}">{{ 'common.detail'|trans }}</a>
            {% endif %}
            <button class="btn btn--primary" type="submit" form="event-form">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ isEdit ? url('admin.events.show', {id: item.id()}) : url('admin.events.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'events.save' } %}

    <form
        id="event-form"
        method="post"
        class="detail-stack"
        enctype="multipart/form-data"
        action="{{ isEdit ? url('admin.events.update', {id: item.id()}) : url('admin.events.store') }}"
        data-form="events.save"
        x-data="gereqForm"
        {% if form_errors('events.save') %}data-server-state="1"{% endif %}
    >
        {{ csrf_field()|raw }}

        <div
            x-data="eventSchedule"
            data-slugs="{{ (hideDatesSlugs|default([]))|json_encode|e('html_attr') }}"
            data-category="{{ categoryValue|e('html_attr') }}"
        >

        {% embed 'ui/form_panel.html.twig' with { title: 'events.section.basic'|trans } %}
            {% block body %}
                {{ forms().render(source, {
                    form: 'events.save',
                    group: 'basic',
                    cols: 2,
                    values: isEdit ? {} : { region: 'Domažlice' },
                    choices: { category: categoryChoices }
                }) }}
            {% endblock %}
        {% endembed %}

        {% embed 'ui/form_panel.html.twig' with { title: 'events.section.schedule'|trans } %}
            {% block body %}
                <p class="muted" data-schedule-hint {% if not scheduleHidden %}hidden{% endif %}>{{ 'events.form.hide_dates_hint'|trans }}</p>
                <div class="form-grid" data-schedule-dates {% if scheduleHidden %}hidden{% endif %}>
                        {% include 'ui/input.html.twig' with {
                            name: 'starts_at',
                            type: 'datetime-local',
                            label: 'events.field.starts_at'|trans,
                            required: false,
                            form: 'events.save',
                            value: startsValue,
                            entity: source
                        } %}
                        {% include 'ui/input.html.twig' with {
                            name: 'ends_at',
                            type: 'datetime-local',
                            label: 'events.field.ends_at'|trans,
                            optional: true,
                            form: 'events.save',
                            value: endsValue,
                            entity: source
                        } %}
                        {% include 'ui/checkbox.html.twig' with {
                            name: 'show_starts_at',
                            variant: 'switch',
                            label: 'events.field.show_starts_at'|trans,
                            description: 'events.field.show_starts_at.hint'|trans,
                            form: 'events.save',
                            checked: showStartsChecked
                        } %}
                        {% include 'ui/checkbox.html.twig' with {
                            name: 'show_ends_at',
                            variant: 'switch',
                            label: 'events.field.show_ends_at'|trans,
                            description: 'events.field.show_ends_at.hint'|trans,
                            form: 'events.save',
                            checked: showEndsChecked
                        } %}
                        {{ forms().render(source, {
                            form: 'events.save',
                            group: 'schedule',
                            cols: 2,
                            wrap: false
                        }) }}
                </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ui/form_panel.html.twig' with { title: 'events.section.content'|trans } %}
            {% block body %}
                {{ forms().render(source, {
                    form: 'events.save',
                    group: 'content',
                    cols: 1
                }) }}
            {% endblock %}
        {% endembed %}

        {% embed 'ui/form_panel.html.twig' with { title: 'events.section.practical'|trans } %}
            {% block body %}
                {{ forms().render(source, {
                    form: 'events.save',
                    group: 'practical',
                    cols: 2
                }) }}
            {% endblock %}
        {% endembed %}

        {% embed 'ui/form_panel.html.twig' with { title: 'events.section.publish'|trans } %}
            {% block body %}
                {{ forms().render(source, {
                    form: 'events.save',
                    group: 'publish',
                    cols: 3
                }) }}
            {% endblock %}
        {% endembed %}

        {% embed 'ui/form_panel.html.twig' with { title: 'events.section.photo'|trans } %}
            {% block body %}
                {% include 'ui/media_box.html.twig' with {
                    name: 'image_url',
                    label: 'events.field.image'|trans,
                    optional: true,
                    form: 'events.save',
                    value: imageUrl|default(''),
                    hint: 'events.field.image.hint'|trans,
                    has_media: hasMedia|default(false),
                    library: libraryImages|default([])
                } %}
            {% endblock %}
        {% endembed %}

        {% embed 'ui/form_panel.html.twig' with { title: 'events.section.gallery'|trans } %}
            {% block body %}
                <p class="muted">{{ 'events.field.gallery.hint'|trans }}</p>
                <div
                    class="event-gallery-editor"
                    x-data="eventGalleryEditor"
                    data-items="{{ (galleryItems|default([]))|json_encode|e('html_attr') }}"
                    data-library="{{ (libraryMedia|default([]))|json_encode|e('html_attr') }}"
                >
                    <template x-for="(item, index) in items" :key="index">
                        <div class="event-gallery-editor__row form-grid">
                            <label class="g-field">
                                <span class="g-label">{{ 'events.gallery.kind'|trans }}</span>
                                <select :name="fieldName(index, 'kind')" x-model="item.kind">
                                    <option value="photo">{{ 'events.gallery.kind.photo'|trans }}</option>
                                    <option value="gif">{{ 'events.gallery.kind.gif'|trans }}</option>
                                    <option value="video">{{ 'events.gallery.kind.video'|trans }}</option>
                                </select>
                            </label>
                            <label class="g-field">
                                <span class="g-label">{{ 'events.gallery.title'|trans }}</span>
                                <input type="text" :name="fieldName(index, 'title')" x-model="item.title" maxlength="190">
                            </label>
                            <div class="g-field field--full">
                                <span class="g-label">{{ 'events.gallery.file'|trans }}</span>
                                <div class="event-gallery-editor__file">
                                    <span class="event-gallery-editor__preview" x-show="item.url" x-cloak>
                                        <img x-show="isImagePreview(item)" :src="item.url" alt="">
                                        <span class="event-gallery-editor__preview-badge" x-text="item.kind"></span>
                                    </span>
                                    <input type="url" :name="fieldName(index, 'url')" x-model="item.url" placeholder="https://… nebo /media/…">
                                    <input type="hidden" :name="fieldName(index, 'media_asset_id')" x-model="item.media_asset_id">
                                    <button type="button" class="btn btn--ghost" x-show="hasLibrary" x-cloak @click="openPicker(index)">
                                        {{ 'events.gallery.pick'|trans }}
                                    </button>
                                </div>
                            </div>
                            <label class="g-field" x-show="isTimed(item)" x-cloak>
                                <span class="g-label">{{ 'events.gallery.start'|trans }}</span>
                                <input type="number" min="0" :name="fieldName(index, 'start')" x-model="item.start" placeholder="0">
                            </label>
                            <label class="g-field" x-show="isTimed(item)" x-cloak>
                                <span class="g-label">{{ 'events.gallery.end'|trans }}</span>
                                <input type="number" min="0" :name="fieldName(index, 'end')" x-model="item.end" placeholder="">
                            </label>
                            <div class="event-gallery-editor__actions">
                                <button type="button" class="btn btn--ghost" @click="remove(index)">{{ 'events.gallery.remove'|trans }}</button>
                            </div>
                        </div>
                    </template>
                    <button type="button" class="btn btn--ghost" @click="add()">{{ 'events.gallery.add'|trans }}</button>

                    <div class="media-box-layer" x-show="pickerOpen" x-cloak @keydown.escape.window="onEscape()">
                        <div class="media-box-backdrop" @click="closePicker()" aria-hidden="true"></div>
                        <div class="media-box-dock media-box-dock--wide" role="dialog" aria-modal="true" @click.stop>
                            <header class="media-box-dock__bar">
                                <strong class="media-box-dock__title">{{ 'events.gallery.pick_title'|trans }}</strong>
                                <button type="button" class="btn btn--ghost btn-sm" @click="closePicker()">{{ 'common.close'|trans }}</button>
                            </header>
                            <div class="media-box-dock__body">
                                <div class="media-box-dock__toolbar">
                                    <label class="media-box-dock__search">
                                        <input
                                            type="search"
                                            class="g-control media-box-dock__search-input event-gallery-picker__search"
                                            placeholder="{{ 'ui.media_box.search'|trans|e('html_attr') }}"
                                            x-model="query"
                                            autocomplete="off"
                                        >
                                    </label>
                                </div>
                                <div class="media-box__grid event-gallery-picker__grid">
                                    <template x-for="asset in visibleLibrary" :key="asset.value">
                                        <button type="button" class="media-box__thumb" @click="pick(asset)">
                                            <span class="media-box__thumb-media">
                                                <img x-show="isVisual(asset)" :src="asset.thumb" alt="" loading="lazy">
                                                <span class="event-gallery-picker__kind" x-show="!isVisual(asset)" x-text="asset.kind"></span>
                                            </span>
                                            <span class="media-box__thumb-label" x-text="asset.label"></span>
                                            <span class="media-box__thumb-badge" x-text="asset.ext" x-show="asset.ext"></span>
                                        </button>
                                    </template>
                                </div>
                                <p class="muted" x-show="visibleLibrary.length === 0">{{ 'ui.media_box.no_results'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endblock %}
        {% endembed %}
        </div>
    </form>
{% endblock %}
