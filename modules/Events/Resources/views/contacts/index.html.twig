{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="kdeaco-contacts" data-actions-default="1">
<header class="page-header">
    <h1>{{ 'events.contacts.title'|trans }}</h1>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.events.index') }}">{{ 'nav.events'|trans }}</a>
    </div>
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'events.contacts.search'|trans }}">
    </form>
</div>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
    <th>{{ 'events.contacts.field.created'|trans }}</th>
    <th>{{ 'events.contacts.field.name'|trans }}</th>
    <th>{{ 'events.contacts.field.email'|trans }}</th>
    <th>{{ 'events.contacts.field.topic'|trans }}</th>
    <th>{{ 'events.contacts.field.message'|trans }}</th>
    <th class="table__actions-head"></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td class="is-mute">{{ item.createdAt().format('j. n. Y H:i') }}</td>
    <td><strong>{{ item.name() }}</strong></td>
    <td><a href="mailto:{{ item.email() }}">{{ item.email() }}</a></td>
    <td>{{ ('events.contacts.topic.' ~ item.topic())|trans }}</td>
    <td>{{ item.message()|length > 140 ? item.message()|slice(0, 140) ~ '…' : item.message() }}</td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% if user.can('events.manage') %}
                {% include 'ui/row_action_destroy.html.twig' with {
                    action: url('admin.events.messages.destroy', {id: item.id()}),
                    confirm: 'events.contacts.confirm_delete'|trans
                } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr><td colspan="6" class="is-mute">{{ 'events.contacts.empty'|trans }}</td></tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
