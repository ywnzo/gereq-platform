{# status: green|orange|red, size: sm|md|lg, title?: string #}
{% set status = status|default('green') %}
{% set size = size|default('sm') %}
{% set fill = status == 'red' ? '#ef4444' : (status == 'orange' ? '#f59e0b' : '#22c55e') %}
{% set px = size == 'lg' ? 16 : (size == 'md' ? 14 : 11) %}
<span
    class="vitality-heart vitality-heart--{{ status }} vitality-heart--{{ size }}"
    {% if title is defined and title %}title="{{ title|e('html_attr') }}"{% endif %}
    aria-hidden="true"
>
    <svg
        class="vitality-heart__svg"
        width="{{ px }}"
        height="{{ px }}"
        viewBox="0 0 24 24"
        focusable="false"
        xmlns="http://www.w3.org/2000/svg"
    >
        <path
            fill="{{ fill }}"
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        />
    </svg>
</span>
