{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <div>
            <h1>{{ 'vitality.log.title'|trans }}</h1>
            <p class="muted detail-layout__meta">
                <span class="method-pill method-pill--{{ log.method()|lower }}">{{ log.method() }}</span>
                {{ log.path() }}
            </p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.vitality.index') }}">{{ 'vitality.log.back'|trans }}</a>
        </div>
    </header>

    <div class="detail-layout">
        <div class="detail-layout__main">
            <section class="detail-hero panel">
                <div class="detail-hero__body">
                    <div class="detail-hero__highlight">
                        <span>{{ 'vitality.field.duration'|trans }}</span>
                        <strong>{{ log.durationMs() }} ms</strong>
                    </div>
                    <dl class="detail-hero__facts">
                        <div>
                            <dt>{{ 'vitality.field.avg_at_time'|trans }}</dt>
                            <dd>{{ log.avgAtTimeMs()|number_format(1) }} ms</dd>
                        </div>
                        <div>
                            <dt>{{ 'vitality.field.status'|trans }}</dt>
                            <dd>{{ log.statusCode() }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'vitality.field.queries'|trans }}</dt>
                            <dd>{{ log.queryCount() }} ({{ log.queryTotalMs()|number_format(1) }} ms)</dd>
                        </div>
                        <div>
                            <dt>{{ 'vitality.log.memory'|trans }}</dt>
                            <dd>{{ (log.memoryPeakBytes() / 1048576)|number_format(2) }} MB</dd>
                        </div>
                    </dl>
                </div>
            </section>

            {% if log.requestQuery() is not empty %}
                <section class="panel">
                    <header class="panel__head"><h2>{{ 'vitality.log.query_params'|trans }}</h2></header>
                    <pre class="g-prose" style="margin:0"><code>{{ log.requestQuery()|json_encode(384) }}</code></pre>
                </section>
            {% endif %}

            <section class="panel">
                <header class="panel__head"><h2>{{ 'vitality.log.queries'|trans }}</h2></header>
                {% if log.queries() is empty %}
                    <p class="muted" style="padding:1rem">—</p>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'vitality.log.ms'|trans }}</th>
                                    <th>{{ 'vitality.log.origin'|trans }}</th>
                                    <th>{{ 'vitality.log.sql'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for q in log.queries() %}
                                    <tr>
                                        <td>{{ q.duration|number_format(2) }}</td>
                                        <td class="muted">{{ q.origin ?: '—' }}</td>
                                        <td><code class="vitality-sql">{{ q.sql }}</code></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </div>

        <aside class="detail-layout__aside">
            <section class="panel">
                <header class="panel__head"><h2>{{ 'common.overview'|trans }}</h2></header>
                <dl class="meta-list meta-list--flush detail-layout__specs">
                    <div class="meta-list__full">
                        <dt>{{ 'vitality.log.correlation'|trans }}</dt>
                        <dd><code>{{ log.correlationId() ?: '—' }}</code></dd>
                    </div>
                    <div class="meta-list__full">
                        <dt>{{ 'vitality.log.route'|trans }}</dt>
                        <dd><code>{{ log.routeName() ?: '—' }}</code></dd>
                    </div>
                    <div class="meta-list__full">
                        <dt>{{ 'vitality.log.response_bytes'|trans }}</dt>
                        <dd>{{ log.responseBytes() }} B</dd>
                    </div>
                    <div class="meta-list__full">
                        <dt>{{ 'vitality.field.time'|trans }}</dt>
                        <dd>{{ log.createdAt().format('d. m. Y H:i:s') }}</dd>
                    </div>
                    <div class="meta-list__full">
                        <dt>{{ 'vitality.field.endpoint'|trans }}</dt>
                        <dd><code>{{ log.endpointKey() }}</code></dd>
                    </div>
                </dl>
            </section>
        </aside>
    </div>
{% endblock %}
