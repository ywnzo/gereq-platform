{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set returnSource = 'Modules\\Returns\\Domain\\ReturnRequest' %}

<header class="page-header"><h1>{{ 'returns.new'|trans }}</h1></header>
{% include 'ui/error-summary.html.twig' with { form: 'returns.save' } %}
<form method="post" class="detail-stack" action="{{ url('admin.returns.store') }}" data-form="returns.save" x-data="gereqForm">
{{ csrf_field()|raw }}
<section class="panel">
    <header class="panel__head">
        <h2>{{ 'common.details'|trans }}</h2>
    </header>
    {{ forms().render(returnSource, {
        form: 'returns.save',
        cols: 2,
        values: { currency: currency_code() }
    }) }}

    <div class="field field--full">
    <span class="field__label">{{ 'returns.items'|trans }}</span>
    <p class="muted">{{ 'returns.items.add_hint'|trans }}</p>
    {% for i in 0..2 %}
    <div class="form-grid form-grid--compact" style="margin-bottom:0.75rem">
    {% include 'ui/input.html.twig' with { name:'item_title['~i~']', label:'returns.field.title'|trans, optional:true, value:'' } %}
    {% include 'ui/input.html.twig' with { name:'item_qty['~i~']', label:'returns.field.qty'|trans, optional:true, value:'1' } %}
    {% include 'ui/input.html.twig' with { name:'item_product_id['~i~']', label:'returns.field.product'|trans, optional:true, value:'' } %}
    {% include 'ui/input.html.twig' with { name:'item_reason['~i~']', label:'returns.field.item_reason'|trans, optional:true, value:'' } %}
    </div>
    {% endfor %}
    </div>
</section>

<div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
<a class="btn btn--ghost" href="{{ url('admin.returns.index') }}">{{ 'common.cancel'|trans }}</a></div>
</form>
{% endblock %}
