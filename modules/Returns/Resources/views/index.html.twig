{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header"><h1>{{ 'returns.title'|trans }}</h1>
{% if user.can('returns.manage') %}<a class="btn btn--primary" href="{{ url('admin.returns.create') }}">{{ icon('plus') }} {{ 'returns.new'|trans }}</a>{% endif %}
</header>
<form class="toolbar" method="get">
<input type="hidden" name="sort" value="{{ sort }}">
<input type="hidden" name="dir" value="{{ dir }}">
<input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'returns.search'|trans }}">
<select name="status" class="input" onchange="this.form.submit()"><option value="">{{ 'returns.all_statuses'|trans }}</option>
{% for s in statuses %}<option value="{{ s }}" {{ status==s?'selected':'' }}>{{ ('returns.status.'~s)|trans }}</option>{% endfor %}
</select></form>
<div class="table-wrap" data-table><table class="table"><thead><tr>
{% include 'ui/sort_th.html.twig' with { label: 'returns.field.number'|trans, column: 'number', query: { status: status } } %}
<th>{{ 'returns.field.order'|trans }}</th>
{% include 'ui/sort_th.html.twig' with { label: 'returns.field.status'|trans, column: 'status', query: { status: status } } %}
{% include 'ui/sort_th.html.twig' with { label: 'returns.field.created'|trans, column: 'createdAt', query: { status: status } } %}
<th></th>
</tr></thead>
<tbody>{% for item in items %}
<tr><td><a href="{{ url('admin.returns.show',{id:item.id()}) }}">{{ item.number() }}</a></td>
<td><code>{{ item.orderId() }}</code></td>
<td><span class="badge">{{ item.statusLabel()|trans }}</span></td>
<td class="is-mute">{{ item.createdAt().format('d. m. Y H:i') }}</td>
<td class="table__actions"><a href="{{ url('admin.returns.show',{id:item.id()}) }}">{{ 'common.detail'|trans }}</a></td></tr>
{% else %}<tr><td colspan="5"><div class="empty"><h2>{{ 'returns.empty'|trans }}</h2></div></td></tr>{% endfor %}
</tbody></table></div>
{% include 'ui/table_footer.html.twig' %}
{% endblock %}
