{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'webhooks.title'|trans }}</h1>
        {% if user.can('webhooks.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.developer.webhooks.create') }}">{{ icon('plus') }} {{ 'webhooks.new'|trans }}</a>
        {% endif %}
    </header>

    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'webhooks.search'|trans }}">
        <select name="status" class="input" onchange="this.form.submit()">
            <option value="">{{ 'common.all_statuses'|trans }}</option>
            <option value="active" {{ status == 'active' ? 'selected' : '' }}>{{ 'webhooks.status.active'|trans }}</option>
            <option value="paused" {{ status == 'paused' ? 'selected' : '' }}>{{ 'webhooks.status.paused'|trans }}</option>
            <option value="failing" {{ status == 'failing' ? 'selected' : '' }}>{{ 'webhooks.status.failing'|trans }}</option>
        </select>
    </form>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'webhooks.field.name'|trans }}</th>
                    <th>{{ 'webhooks.field.url'|trans }}</th>
                    <th>{{ 'webhooks.field.events'|trans }}</th>
                    <th>{{ 'webhooks.field.status'|trans }}</th>
                    <th>{{ 'webhooks.field.last_delivery'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            <a href="{{ url('admin.developer.webhooks.show', {id: item.id()}) }}">{{ item.name() }}</a>
                        </td>
                        <td><code class="muted">{{ item.url()|length > 48 ? item.url()|slice(0, 48) ~ '…' : item.url() }}</code></td>
                        <td>
                            {% for event in item.events()|slice(0, 3) %}
                                <span class="badge badge--muted">{{ event }}</span>
                            {% endfor %}
                            {% if item.events()|length > 3 %}
                                <span class="muted">+{{ item.events()|length - 3 }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : (item.status() == 'failing' ? 'warn' : 'muted') }}">
                                {{ item.statusLabel()|trans }}
                            </span>
                        </td>
                        <td>{{ item.lastDeliveryAt() ? item.lastDeliveryAt().format('d. m. Y H:i') : '—' }}</td>
                        <td class="table__actions" x-data="rowMenu" @click.outside="close">
                            <button type="button" class="icon-btn" x-ref="button" @click="toggle" aria-haspopup="menu" :aria-expanded="open">{{ icon('dots') }}</button>
                            <div class="flyout flyout--right" x-ref="menu" :class="menuClass" :style="menuStyle" role="menu">
                                <a href="{{ url('admin.developer.webhooks.show', {id: item.id()}) }}">{{ 'common.detail'|trans }}</a>
                                {% if user.can('webhooks.manage') %}
                                    <a href="{{ url('admin.developer.webhooks.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                                    <form method="post" action="{{ url('admin.developer.webhooks.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'webhooks.confirm_delete'|trans|e('js') }}');">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'webhooks.empty'|trans }}</h2>
                                <p>{{ 'webhooks.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total > 0 %}
        <footer class="table-footer">
            <span class="muted">{{ ((page - 1) * perPage) + 1 }}–{{ min(page * perPage, total) }} {{ 'common.of'|trans }} {{ total }}</span>
            <nav class="pagination">
                {% if page > 1 %}
                    <a href="?q={{ search }}&status={{ status }}&page={{ page - 1 }}">{{ 'common.previous'|trans }}</a>
                {% endif %}
                <span>{{ page }} / {{ pages }}</span>
                {% if page < pages %}
                    <a href="?q={{ search }}&status={{ status }}&page={{ page + 1 }}">{{ 'common.next'|trans }}</a>
                {% endif %}
            </nav>
        </footer>
    {% endif %}
{% endblock %}
