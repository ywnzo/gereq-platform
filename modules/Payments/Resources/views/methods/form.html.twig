{% extends 'admin/layout.html.twig' %}

{% block content %}
<header class="page-header">
    <h1>{{ item ? 'payments.methods.edit'|trans : 'payments.methods.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'payments.method.save' } %}

{% set methodSource = item ?? 'Modules\\Payments\\Domain\\PaymentMethod' %}

<form method="post" action="{{ item ? url('admin.payments.methods.update', {id: item.id()}) : url('admin.payments.methods.store') }}" data-form="payments.method.save" x-data="gereqForm"{% if form_errors('payments.method.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}
    {{ forms().render(methodSource, {
        form: 'payments.method.save',
        cols: 2,
        values: item ? {} : { currency: currency_code() }
    }) }}
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.payments.methods.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
