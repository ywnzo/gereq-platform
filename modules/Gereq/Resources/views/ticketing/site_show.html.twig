{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.gereq'|trans, url: url('admin.gereq.ticketing.desk') },
        { label: 'gereq.ticketing.sites'|trans, url: url('admin.gereq.ticketing.sites') },
        { label: site.name() },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ site.name() }}</h1>
        <p class="muted"><code>{{ site.publicKey() }}</code></p>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.gereq.ticketing.sites.edit', {id: site.id()}) }}">{{ 'common.edit'|trans }}</a>
        <form method="post" action="{{ url('admin.gereq.ticketing.sites.test_key', {id: site.id()}) }}">
            {{ csrf_field()|raw }}
            <button class="btn" type="submit">{{ 'gereq.ticketing.issue_test'|trans }}</button>
        </form>
    </div>
</header>

<div class="detail-stack">
    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'gereq.ticketing.embed'|trans }}</h2>
            <p class="muted">{{ 'gereq.ticketing.embed_hint'|trans }}</p>
        </header>
        <div class="panel__body">
            <pre class="gereq-snippet">{{ embedSnippet }}</pre>
            {% if site.testPublicKey() %}
                <p class="muted" style="margin-top:12px">
                    {{ 'gereq.field.test_public_key'|trans }}: <code>{{ site.testPublicKey() }}</code>
                </p>
            {% endif %}
        </div>
    </section>

    <section class="panel">
        <header class="panel__head"><h2>{{ 'gereq.section.details'|trans }}</h2></header>
        <dl class="meta-list meta-list--flush">
            <div><dt>{{ 'gereq.field.active'|trans }}</dt><dd>{{ site.isActive() ? 'common.yes'|trans : 'common.no'|trans }}</dd></div>
            <div><dt>{{ 'gereq.field.agents_online'|trans }}</dt><dd>{{ site.agentsOnline() ? 'common.yes'|trans : 'common.no'|trans }}</dd></div>
            <div><dt>{{ 'gereq.field.assignment'|trans }}</dt><dd>{{ ('gereq.assignment.' ~ site.assignmentStrategy())|trans }}</dd></div>
            <div class="meta-list__full"><dt>{{ 'gereq.field.allowed_origins'|trans }}</dt><dd><code>{{ site.allowedOrigins()|join(', ') ?: '—' }}</code></dd></div>
        </dl>
    </section>
</div>
{% endblock %}
