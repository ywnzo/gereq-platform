{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.gereq'|trans, url: url('admin.gereq.ticketing.desk') },
        { label: 'gereq.ticketing.extras'|trans },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'gereq.ticketing.extras'|trans }}</h1>
        <p class="muted">{{ 'gereq.ticketing.extras_hint'|trans }}</p>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.gereq.ticketing.desk') }}">{{ 'gereq.ticketing.desk'|trans }}</a>
    </div>
</header>

<form method="post" action="{{ url('admin.gereq.ticketing.extras.store') }}" class="detail-stack">
    {{ csrf_field()|raw }}
    <section class="panel">
        <header class="panel__head">
            <div>
                <h2>{{ 'gereq.ticketing.extras_add'|trans }}</h2>
                <p class="muted">{{ 'gereq.ticketing.extras_add_hint'|trans }}</p>
            </div>
        </header>
        <div class="form-grid">
            <label class="field">
                <span>{{ 'gereq.field.type'|trans }}</span>
                <select class="input" name="type">
                    <option value="sla">SLA</option>
                    <option value="canned">Canned</option>
                    <option value="tag">Tag</option>
                    <option value="kb">KB</option>
                    <option value="automation">Automation</option>
                </select>
            </label>
            <label class="field">
                <span>{{ 'gereq.field.name'|trans }}</span>
                <input class="input" name="name" required placeholder="{{ 'gereq.field.name'|trans }}">
            </label>
            <label class="field" style="grid-column: 1 / -1">
                <span>{{ 'gereq.field.body'|trans }}</span>
                <textarea class="input" name="body" rows="3" placeholder="{{ 'gereq.field.body'|trans }}"></textarea>
            </label>
        </div>
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        </div>
    </section>
</form>

<div class="gereq-extras-grid">
    {% for label, rows in {
        'gereq.extras.sla': sla,
        'gereq.extras.canned': canned,
        'gereq.extras.tags': tags,
        'gereq.extras.kb': kb,
        'gereq.extras.automations': automations
    } %}
        <section class="panel">
            <header class="panel__head">
                <h2>{{ label|trans }}</h2>
            </header>
            <div class="panel__body">
                {% if rows is empty %}
                    <p class="muted">{{ 'gereq.empty'|trans }}</p>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>{{ 'gereq.field.name'|trans }}</th>
                                    <th>{{ 'gereq.field.body'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in rows %}
                                    <tr>
                                        <td><strong>{{ r.name() }}</strong></td>
                                        <td class="is-mute">{{ r.body() ? r.body()|slice(0, 120) : '—' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endfor %}
</div>
{% endblock %}
