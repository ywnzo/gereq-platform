<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ siteName }}</title>
<style>
:root{--c:{{ primaryColor|e('css') }};--bg:#f6f7f9;--ink:#0a1f38}
*{box-sizing:border-box}body{margin:0;font:14px/1.45 system-ui,sans-serif;background:var(--bg);color:var(--ink)}
.wrap{display:flex;flex-direction:column;height:100vh}
.head{background:var(--c);color:#fff;padding:12px 14px;font-weight:600}
.msgs{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:8px}
.msg{max-width:85%;padding:8px 10px;border-radius:12px;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.06)}
.msg.agent{align-self:flex-start}.msg.visitor{align-self:flex-end;background:#e8eef5}
.foot{display:flex;gap:8px;padding:10px;border-top:1px solid #dde2ea;background:#fff}
.foot input{flex:1;border:1px solid #ccd3dd;border-radius:10px;padding:10px}
.foot button{background:var(--c);color:#fff;border:0;border-radius:10px;padding:10px 14px;cursor:pointer}
.welcome{opacity:.75;font-size:13px;padding:0 12px}
</style>
</head>
<body>
<div class="wrap">
  <div class="head">{{ siteName }}{% if offline %} · offline{% endif %}</div>
  <p class="welcome" id="welcome">{{ welcome }}</p>
  <div class="msgs" id="msgs"></div>
  <form class="foot" id="form">
    <input id="body" autocomplete="off" placeholder="Napište zprávu…"{% if offline %} disabled{% endif %}>
    <button type="submit"{% if offline %} disabled{% endif %}>Odeslat</button>
  </form>
</div>
<script>
(function(){
  var key={{ key|json_encode|raw }};
  var origin={{ origin|json_encode|raw }};
  var pageUrl={{ pageUrl|json_encode|raw }};
  var token=localStorage.getItem('gereq_vt_'+key)||'';
  var msgsEl=document.getElementById('msgs');
  function render(list){
    msgsEl.innerHTML='';
    (list||[]).forEach(function(m){
      if(m.is_internal) return;
      var d=document.createElement('div');
      d.className='msg '+(m.direction||'visitor');
      d.textContent=m.body||'';
      msgsEl.appendChild(d);
    });
    msgsEl.scrollTop=msgsEl.scrollHeight;
  }
  async function api(path, method, body){
    var opts={method:method||'GET',headers:{'Content-Type':'application/json','Accept':'application/json'}};
    var payload=Object.assign({key:key,origin:origin,visitor_token:token||undefined,page_url:pageUrl||undefined}, body||{});
    if(method==='POST') opts.body=JSON.stringify(payload);
    var url=path+(method==='GET'?('?'+new URLSearchParams({key:key,origin:origin,visitor_token:token||'',page_url:pageUrl||''}).toString()):'');
    var r=await fetch(url, opts);
    return r.json();
  }
  async function hydrate(){
    var j=await api('/tickets/api/session','POST',{});
    if(j.visitor_token){ token=j.visitor_token; localStorage.setItem('gereq_vt_'+key, token); }
    if(j.welcome_message) document.getElementById('welcome').textContent=j.welcome_message;
    render(j.messages||[]);
  }
  document.getElementById('form').addEventListener('submit', async function(e){
    e.preventDefault();
    var input=document.getElementById('body');
    var body=input.value.trim(); if(!body) return;
    input.value='';
    var j=await api('/tickets/api/messages','POST',{body:body});
    if(j.visitor_token){ token=j.visitor_token; localStorage.setItem('gereq_vt_'+key, token); }
    await hydrate();
  });
  hydrate();
  setInterval(hydrate, 4000);
})();
</script>
</body>
</html>
