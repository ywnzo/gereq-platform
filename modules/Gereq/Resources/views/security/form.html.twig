{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.gereq'|trans, url: url('admin.gereq.security.index') },
        { label: 'nav.gereq.security'|trans, url: url('admin.gereq.security.index') },
        { label: pageTitle },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ pageTitle }}</h1>
        <p class="muted">{{ 'gereq.security.form_hint'|trans }}</p>
    </div>
</header>

<form method="post" class="detail-stack" action="{{ site ? url('admin.gereq.security.update', {id: site.id()}) : url('admin.gereq.security.store') }}">
    {{ csrf_field()|raw }}

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'gereq.section.site'|trans }}</h2>
        </header>
        <div class="form-grid">
            <label class="field">
                <span>{{ 'gereq.field.name'|trans }}</span>
                <input class="input" name="name" required value="{{ site ? site.name() : '' }}">
            </label>
            <label class="field">
                <span>{{ 'gereq.field.mode'|trans }}</span>
                <select class="input" name="protection_mode">
                    {% for m in modes %}
                        <option value="{{ m }}" {{ site and site.protectionMode() == m ? 'selected' : '' }}>{{ ('gereq.mode.' ~ m)|trans }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="field" style="grid-column: 1 / -1">
                <span>{{ 'gereq.field.allowed_origins'|trans }}</span>
                <textarea class="input" name="allowed_origins" rows="3" placeholder="https://example.com">{{ site ? site.allowedOrigins()|join('\n') : '' }}</textarea>
                <span class="field__hint">{{ 'gereq.field.allowed_origins.hint'|trans }}</span>
            </label>
            <label class="field">
                <span>{{ 'gereq.field.primary_color'|trans }}</span>
                <input class="input" name="primary_color" value="{{ site ? site.primaryColor() : '#0A1F38' }}">
            </label>
            <label class="field">
                <span>{{ 'gereq.field.badge_text'|trans }}</span>
                <input class="input" name="badge_text" value="{{ site ? site.badgeText() : '' }}">
            </label>
            <label class="field">
                <span>{{ 'gereq.field.captcha_difficulty'|trans }}</span>
                <input class="input" type="number" min="1" max="10" name="captcha_difficulty" value="{{ site ? site.captchaDifficulty() : 2 }}">
            </label>
            <label class="field">
                <span>{{ 'gereq.field.form_enabled'|trans }}</span>
                <select class="input" name="form_enabled">
                    <option value="1" {{ (not site) or site.formEnabled() ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                    <option value="0" {{ site and not site.formEnabled() ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
                </select>
            </label>
            <label class="field">
                <span>{{ 'gereq.field.form_captcha_always'|trans }}</span>
                <select class="input" name="form_captcha_always">
                    <option value="0" {{ not site or not site.formCaptchaAlways() ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
                    <option value="1" {{ site and site.formCaptchaAlways() ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                </select>
            </label>
            <label class="field">
                <span>{{ 'gereq.field.monitor_enabled'|trans }}</span>
                <select class="input" name="monitor_enabled">
                    <option value="1" {{ (not site) or site.monitorEnabled() ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                    <option value="0" {{ site and not site.monitorEnabled() ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
                </select>
            </label>
            <label class="field">
                <span>{{ 'gereq.field.active'|trans }}</span>
                <select class="input" name="is_active">
                    <option value="1" {{ (not site) or site.isActive() ? 'selected' : '' }}>{{ 'common.yes'|trans }}</option>
                    <option value="0" {{ site and not site.isActive() ? 'selected' : '' }}>{{ 'common.no'|trans }}</option>
                </select>
            </label>
        </div>
    </section>

    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.gereq.security.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
