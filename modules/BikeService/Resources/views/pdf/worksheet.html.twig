<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <title>{{ 'bikeservice.documents.type.worksheet'|trans }} {{ docNumber }}</title>
    <style>{% include '@bikeservice/pdf/_styles.html.twig' %}</style>
</head>
<body>
<div class="bar">{{ 'bikeservice.documents.type.worksheet'|trans }} · {{ docNumber }}</div>
<table class="w-100" style="margin:10px 0">
    <tr>
        <td style="width:50%;vertical-align:top;padding-right:10px">
            <div class="lbl">{{ 'bikeservice.field.customer'|trans }}</div>
            {% if customer %}
                <div class="company-name">{{ customer.name() }}</div>
                <div class="small">{% if customer.phone() %}{{ customer.phone() }}{% endif %}{% if customer.email() %} · {{ customer.email() }}{% endif %}</div>
            {% else %}<div class="muted">—</div>{% endif %}
        </td>
        <td style="width:50%;vertical-align:top;padding-left:10px;border-left:2px solid #000">
            <div class="lbl">{{ 'bikeservice.field.bike'|trans }}</div>
            {% if bike %}
                <div class="company-name">{{ bike.brand() }} {{ bike.model() }}</div>
                <div class="small">{{ ('bikeservice.kind.'~bike.kind())|trans }}{% if bike.serialNumber() %} · {{ bike.serialNumber() }}{% endif %}</div>
            {% else %}<div class="muted">—</div>{% endif %}
        </td>
    </tr>
</table>
<table class="kv" style="margin-bottom:10px">
    <tr><td class="k">{{ 'bikeservice.field.team'|trans }}</td><td class="v">{{ order.teamLabel()|trans }}</td></tr>
    <tr><td class="k">{{ 'bikeservice.field.intake_odometer'|trans }}</td><td class="v">{{ order.intakeOdometerKm() is not null ? order.intakeOdometerKm() ~ ' km' : '—' }}</td></tr>
    <tr><td class="k">{{ 'bikeservice.field.intake_battery'|trans }}</td><td class="v">{{ order.intakeBatteryPct() is not null ? order.intakeBatteryPct() ~ ' %' : '—' }}</td></tr>
    <tr><td class="k">{{ 'bikeservice.field.intake'|trans }}</td><td class="v">{{ issuedAt }}</td></tr>
</table>
<div class="bar">{{ 'bikeservice.field.service_info'|trans }}</div>
<p>{{ order.serviceInfo() ?: '—' }}</p>
{% if jobs is not empty %}
<div class="bar">{{ 'bikeservice.orders.jobs'|trans }}</div>
<table class="items">
    <thead><tr><th>{{ 'bikeservice.field.job_type'|trans }}</th><th>{{ 'bikeservice.field.started'|trans }}</th><th>{{ 'bikeservice.field.duration'|trans }}</th></tr></thead>
    <tbody>
    {% for j in jobs %}
        <tr>
            <td>{{ j.type() }}{% if j.note() %}<div class="small">{{ j.note() }}</div>{% endif %}</td>
            <td>{{ j.startedAt().format('d.m.Y H:i') }}</td>
            <td>{% if j.durationMinutes() is not null %}{{ j.durationMinutes() }} min{% else %}—{% endif %}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endif %}
<table class="totals-box mt-2" style="width:45%;margin-left:auto;border:2px solid #000">
    <tr><td>{{ 'bikeservice.field.labor_cost'|trans }}</td><td style="text-align:right">{{ totals.labor|number_format(2, ',', ' ') }}</td></tr>
    <tr><td>{{ 'bikeservice.field.parts_cost'|trans }}</td><td style="text-align:right">{{ totals.parts|number_format(2, ',', ' ') }}</td></tr>
    <tr><td>Bez DPH</td><td style="text-align:right">{{ totals.net|number_format(2, ',', ' ') }}</td></tr>
    <tr><td>DPH 21 %</td><td style="text-align:right">{{ totals.vat|number_format(2, ',', ' ') }}</td></tr>
    <tr class="grand"><td>Celkem</td><td style="text-align:right">{{ totals.gross|money }}</td></tr>
</table>
{% if signature %}<p style="margin-top:24px">{{ 'bikeservice.finish.signature'|trans }}: <strong>{{ signature }}</strong></p>{% endif %}
</body>
</html>
