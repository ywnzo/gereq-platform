<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <title>{{ 'bikeservice.documents.type.handover'|trans }} {{ docNumber }}</title>
    <style>{% include '@bikeservice/pdf/_styles.html.twig' %}</style>
</head>
<body>
<div class="bar">{{ 'bikeservice.documents.type.handover'|trans }} · {{ docNumber }}</div>
<p class="muted">{{ issuedAt }}</p>
<table class="kv">
    <tr><td class="k">{{ 'bikeservice.field.bike'|trans }}</td><td class="v">{% if bike %}{{ bike.label() }}{% else %}—{% endif %}</td></tr>
    <tr><td class="k">{{ 'bikeservice.field.customer'|trans }}</td><td class="v">{% if customer %}{{ customer.name() }}{% else %}—{% endif %}</td></tr>
    <tr><td class="k">{{ 'bikeservice.field.status'|trans }}</td><td class="v">{{ order.statusLabel()|trans }}</td></tr>
    <tr><td class="k">{{ 'bikeservice.field.team'|trans }}</td><td class="v">{{ order.teamLabel()|trans }}</td></tr>
    <tr><td class="k">{{ 'bikeservice.field.service_info'|trans }}</td><td class="v">{{ order.serviceInfo() ?: '—' }}</td></tr>
</table>
<table class="totals-box mt-2" style="width:45%;margin-left:auto;border:2px solid #000">
    <tr><td>{{ 'bikeservice.field.labor_cost'|trans }}</td><td style="text-align:right">{{ totals.labor|number_format(2, ',', ' ') }}</td></tr>
    <tr><td>{{ 'bikeservice.field.parts_cost'|trans }}</td><td style="text-align:right">{{ totals.parts|number_format(2, ',', ' ') }}</td></tr>
    <tr class="grand"><td>Celkem s DPH</td><td style="text-align:right">{{ totals.gross|money }}</td></tr>
</table>
{% if signMode|default('manual') == 'digital' %}
    <div style="margin-top:24px">
        <p class="muted">{{ 'esign.finish.sign_mode.digital'|trans }}</p>
        <table style="width:100%">
            <tr>
                <td style="width:50%;vertical-align:top">
                    <strong>Servis</strong>
                    {% if signatureServiceImage|default(null) %}
                        <img src="{{ signatureServiceImage }}" alt="" style="max-width:200px;max-height:70px;display:block;margin-top:6px">
                    {% endif %}
                </td>
                <td style="width:50%;vertical-align:top">
                    <strong>{{ 'bikeservice.finish.signature'|trans }}</strong>
                    {% if signatureImage|default(null) %}
                        <img src="{{ signatureImage }}" alt="" style="max-width:200px;max-height:70px;display:block;margin-top:6px">
                    {% elseif signature %}
                        <p><strong>{{ signature }}</strong></p>
                        <p class="muted" style="font-size:.85em">čeká na digitální podpis / vytištěný PDF</p>
                    {% else %}
                        <div style="border-bottom:1px solid #000;height:40px;margin-top:24px"></div>
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>
{% elseif signature %}
    <p style="margin-top:24px">{{ 'bikeservice.finish.signature'|trans }}: <strong>{{ signature }}</strong></p>
{% else %}
    <p style="margin-top:36px;border-bottom:1px solid #000;width:45%">&nbsp;</p>
    <p class="muted" style="font-size:.85em">{{ 'bikeservice.finish.signature'|trans }} (ruční na výtisku)</p>
{% endif %}
</body>
</html>
