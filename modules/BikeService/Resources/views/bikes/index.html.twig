{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set canManage = user.can('bikeservice.manage') %}
<div class="list-shell" x-data="dataTable" data-table-id="bikeservice-bikes" data-actions-default="{{ canManage ? 3 : 1 }}" data-page-ids="{{ pageIds|json_encode|e('html_attr') }}">
<header class="page-header">
    <div>
        <h1>{{ 'bikeservice.bikes.title'|trans }}</h1>
        <p class="muted">{{ 'bikeservice.bikes.intro'|trans }}</p>
    </div>
    {% if canManage %}
        <a class="btn btn--primary" href="{{ url('admin.bikeservice.bikes.create') }}">{{ icon('plus') }} {{ 'bikeservice.bikes.new'|trans }}</a>
    {% endif %}
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'bikeservice.field.brand'|trans }}…">
        <select name="kind" class="input" onchange="this.form.submit()">
            <option value="">{{ 'bikeservice.all_kinds'|trans }}</option>
            {% for k in kinds %}<option value="{{ k }}" {{ kind==k?'selected':'' }}>{{ ('bikeservice.kind.'~k)|trans }}</option>{% endfor %}
        </select>
        <select name="status" class="input" onchange="this.form.submit()">
            <option value="">{{ 'bikeservice.all_statuses'|trans }}</option>
            {% for s in statuses %}<option value="{{ s }}" {{ status==s?'selected':'' }}>{{ ('bikeservice.bike_status.'~s)|trans }}</option>{% endfor %}
        </select>
    </form>
</div>

<div class="table-wrap" data-table>
<table class="table table--bikeservice">
<thead>
<tr>
    <th>{{ 'bikeservice.field.brand'|trans }}</th>
    <th>{{ 'bikeservice.field.kind'|trans }}</th>
    <th>{{ 'bikeservice.field.serial'|trans }}</th>
    <th>{{ 'bikeservice.field.customer'|trans }}</th>
    <th>{{ 'bikeservice.field.status'|trans }}</th>
    <th class="table__actions-head"></th>
</tr>
</thead>
<tbody>
{% for item in items %}
{% set customer = item.customerId() ? customers[item.customerId()]|default(null) : null %}
<tr class="bs-row">
    <td>
        <a class="bs-row__primary" href="{{ url('admin.bikeservice.bikes.show', {id: item.id()}) }}">
            <span class="bs-row__plate">{{ item.brand() }}{% if item.model() %} {{ item.model() }}{% endif %}</span>
            {% if item.color() or item.frameSize() %}
                <span class="bs-row__name">{% if item.color() %}{{ item.color() }}{% endif %}{% if item.color() and item.frameSize() %} · {% endif %}{% if item.frameSize() %}{{ item.frameSize() }}{% endif %}</span>
            {% endif %}
        </a>
    </td>
    <td><span class="badge badge--muted">{{ ('bikeservice.kind.'~item.kind())|trans }}</span></td>
    <td class="muted">{{ item.serialNumber() ?: '—' }}</td>
    <td>
        {% if customer %}
            <a class="bs-row__customer" href="{{ url('admin.customers.show', {id: customer.id()}) }}">{{ customer.name() }}</a>
        {% else %}
            <span class="muted">—</span>
        {% endif %}
    </td>
    <td><span class="chip">{{ ('bikeservice.bike_status.'~item.status())|trans }}</span></td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% include 'ui/row_action.html.twig' with { href: url('admin.bikeservice.bikes.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
            {% if canManage %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.bikeservice.bikes.edit',{id:item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.bikeservice.orders.create') ~ '?bike=' ~ item.id(), label: 'bikeservice.orders.new'|trans, icon: 'plus' } %}
                {% include 'ui/row_action_destroy.html.twig' with {
                    action: url('admin.bikeservice.bikes.destroy', {id: item.id()}),
                    confirm: 'bikeservice.bikes.confirm_delete'|trans
                } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr><td colspan="6"><div class="empty"><h2>{{ 'bikeservice.bikes.empty'|trans }}</h2></div></td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
