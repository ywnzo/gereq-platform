{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set canManage = user.can('bikeservice.manage') %}
<header class="page-header">
    <div>
        <p class="eyebrow"><a href="{{ url('admin.bikeservice.bikes') }}">{{ 'nav.bikeservice.bikes'|trans }}</a></p>
        <h1>{{ item.label() }}</h1>
        <p class="muted detail-layout__meta">
            <span class="badge">{{ ('bikeservice.kind.'~item.kind())|trans }}</span>
            <span>{{ ('bikeservice.bike_status.'~item.status())|trans }}</span>
            {% if customer %}<a href="{{ url('admin.customers.show',{id:customer.id()}) }}">{{ customer.name() }}</a>{% endif %}
        </p>
    </div>
    <div class="actions">
        {% if canManage %}
            <a class="btn btn--primary" href="{{ url('admin.bikeservice.orders.create') }}?bike={{ item.id() }}">{{ 'bikeservice.orders.new'|trans }}</a>
            <a class="btn btn--ghost" href="{{ url('admin.bikeservice.bikes.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
        {% endif %}
    </div>
</header>

<div class="detail-layout">
    <div class="detail-layout__main">
        <section class="detail-hero panel">
            <div class="detail-hero__body">
                <div class="detail-hero__highlight">
                    <span>{{ 'bikeservice.field.kind'|trans }}</span>
                    <strong>{{ ('bikeservice.kind.'~item.kind())|trans }}</strong>
                </div>
                <dl class="detail-hero__facts">
                    <div><dt>{{ 'bikeservice.field.serial'|trans }}</dt><dd>{{ item.serialNumber() ?: '—' }}</dd></div>
                    <div><dt>{{ 'bikeservice.field.battery_wh'|trans }}</dt><dd>{{ item.batteryWh() ?: '—' }}</dd></div>
                    <div><dt>{{ 'bikeservice.field.odometer'|trans }}</dt><dd>{{ item.odometerKm() is not null ? item.odometerKm() ~ ' km' : '—' }}</dd></div>
                </dl>
            </div>
        </section>

        {% if serialHits %}
        <section class="panel">
            <header class="panel__head">
                <div>
                    <h2>{{ 'bikeservice.bikes.serial_check'|trans }}</h2>
                    <p class="muted">{{ 'bikeservice.explore.source_bikeindex'|trans }}</p>
                </div>
            </header>
            {% if serialHits.ok and serialHits.bikes is not empty %}
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th>{{ 'bikeservice.field.brand'|trans }}</th><th>{{ 'bikeservice.field.serial'|trans }}</th><th>{{ 'bikeservice.field.status'|trans }}</th><th></th></tr></thead>
                        <tbody>
                        {% for hit in serialHits.bikes %}
                            <tr>
                                <td>{{ hit.manufacturer_name|default(hit.title|default('—')) }} {{ hit.frame_model|default('') }}</td>
                                <td>{{ hit.serial|default('—') }}</td>
                                <td>{% if hit.stolen %}{{ 'bikeservice.explore.stolen'|trans }}{% else %}OK{% endif %}</td>
                                <td>{% if hit.id %}<a href="https://bikeindex.org/bikes/{{ hit.id }}" target="_blank" rel="noopener">Bike Index</a>{% endif %}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="muted">{{ serialHits.error ? serialHits.error|trans : 'bikeservice.explore.no_results'|trans }}</p>
            {% endif %}
        </section>
        {% endif %}

        <section class="panel">
            <header class="panel__head"><h2>{{ 'bikeservice.bikes.orders'|trans }}</h2></header>
            <div class="table-wrap">
                <table class="table table--bs-orders">
                    <thead><tr><th>ID</th><th>{{ 'bikeservice.field.status'|trans }}</th><th>{{ 'bikeservice.field.team'|trans }}</th><th>{{ 'bikeservice.field.updated'|trans }}</th></tr></thead>
                    <tbody>
                    {% for order in orders %}
                        <tr class="bs-row">
                            <td><a class="bs-row__primary" href="{{ url('admin.bikeservice.orders.show', {id: order.id()}) }}"><span class="bs-row__plate">#{{ order.id()|slice(0, 8) }}</span></a></td>
                            <td>
                                <span class="status-chip status-chip--bs-{{ order.status() }}">
                                    <span class="status-chip__dot" aria-hidden="true"></span>
                                    {{ order.statusLabel()|trans }}
                                </span>
                            </td>
                            <td><span class="badge badge--bs-{{ order.team() }}">{{ order.teamLabel()|trans }}</span></td>
                            <td><time class="bs-row__when">{{ order.updatedAt().format('d. m. Y H:i') }}</time></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4"><div class="bs-orders-empty"><p>{{ 'bikeservice.orders.empty'|trans }}</p></div></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <aside class="detail-layout__aside">
        <section class="panel">
            <header class="panel__head"><h2>{{ 'common.overview'|trans }}</h2></header>
            <dl class="meta-list meta-list--flush detail-layout__specs">
                <div><dt>{{ 'bikeservice.field.brand'|trans }}</dt><dd>{{ item.brand() }}</dd></div>
                <div><dt>{{ 'bikeservice.field.model'|trans }}</dt><dd>{{ item.model() ?: '—' }}</dd></div>
                <div><dt>{{ 'bikeservice.field.color'|trans }}</dt><dd>{{ item.color() ?: '—' }}</dd></div>
                <div><dt>{{ 'bikeservice.field.frame_size'|trans }}</dt><dd>{{ item.frameSize() ?: '—' }}</dd></div>
                <div><dt>{{ 'bikeservice.field.motor_w'|trans }}</dt><dd>{{ item.motorW() ?: '—' }}</dd></div>
                <div class="meta-list__full"><dt>{{ 'bikeservice.field.customer'|trans }}</dt><dd>{{ customer ? customer.name() : '—' }}</dd></div>
                {% if item.note() %}<div class="meta-list__full"><dt>{{ 'bikeservice.field.note'|trans }}</dt><dd>{{ item.note() }}</dd></div>{% endif %}
            </dl>
        </section>
        {% if canManage %}
        <section class="panel">
            <form method="post" action="{{ url('admin.bikeservice.bikes.destroy', {id: item.id()}) }}" onsubmit="return confirm({{ 'bikeservice.bikes.confirm_delete'|trans|json_encode|raw }})">
                {{ csrf_field()|raw }}
                <button class="btn btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
            </form>
        </section>
        {% endif %}
    </aside>
</div>
{% endblock %}
