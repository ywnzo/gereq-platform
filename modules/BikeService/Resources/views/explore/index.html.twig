{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'bikeservice.explore.title'|trans }}</h1>
        <p class="muted">{{ 'bikeservice.explore.intro'|trans }}</p>
    </div>
</header>

<nav class="tabs" style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.25rem">
    {% for t, label in {
        serial: 'bikeservice.explore.tab.serial',
        stolen: 'bikeservice.explore.tab.stolen',
        citybikes: 'bikeservice.explore.tab.citybikes',
        osm: 'bikeservice.explore.tab.osm'
    } %}
        <a class="btn {{ tab == t ? 'btn--primary' : 'btn--ghost' }} btn-sm" href="{{ url('admin.bikeservice.explore') }}?tab={{ t }}">{{ label|trans }}</a>
    {% endfor %}
    <a class="btn btn--ghost btn-sm" href="{{ url('admin.bikeservice.manufacturers') }}">{{ 'nav.bikeservice.manufacturers'|trans }}</a>
    <a class="btn btn--ghost btn-sm" href="{{ url('admin.bikeservice.catalog') }}">{{ 'nav.bikeservice.catalog'|trans }}</a>
</nav>

<div class="detail-stack">
{% if tab == 'serial' %}
<section class="panel">
    <header class="panel__head"><div><h2>{{ 'bikeservice.explore.tab.serial'|trans }}</h2><p class="muted">{{ 'bikeservice.explore.serial_hint'|trans }} · {{ 'bikeservice.explore.source_bikeindex'|trans }}</p></div></header>
    <form method="get" class="toolbar">
        <input type="hidden" name="tab" value="serial">
        <input class="input" name="serial" value="{{ serial }}" placeholder="{{ 'bikeservice.field.serial'|trans }}" required>
        <button class="btn btn--primary" type="submit">{{ 'bikeservice.explore.search'|trans }}</button>
    </form>
    {% if serialResult %}
        {% if serialResult.ok and serialResult.bikes is not empty %}
            <div class="table-wrap" style="margin-top:1rem">
                <table class="table">
                    <thead><tr><th>{{ 'bikeservice.field.brand'|trans }}</th><th>{{ 'bikeservice.field.serial'|trans }}</th><th>{{ 'bikeservice.field.status'|trans }}</th><th></th></tr></thead>
                    <tbody>
                    {% for hit in serialResult.bikes %}
                        <tr>
                            <td>{{ hit.manufacturer_name|default(hit.title|default('—')) }} {{ hit.frame_model|default('') }}</td>
                            <td>{{ hit.serial|default('—') }}</td>
                            <td>{% if hit.stolen %}<span class="chip">{{ 'bikeservice.explore.stolen'|trans }}</span>{% else %}OK{% endif %}</td>
                            <td>{% if hit.id %}<a href="https://bikeindex.org/bikes/{{ hit.id }}" target="_blank" rel="noopener">Bike Index #{{ hit.id }}</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="muted" style="margin-top:1rem">{{ serialResult.error ? serialResult.error|trans : 'bikeservice.explore.no_results'|trans }}</p>
        {% endif %}
    {% endif %}
</section>
{% endif %}

{% if tab == 'stolen' %}
<section class="panel">
    <header class="panel__head"><div><h2>{{ 'bikeservice.explore.tab.stolen'|trans }}</h2><p class="muted">{{ 'bikeservice.explore.stolen_hint'|trans }} · {{ 'bikeservice.explore.source_bikeindex'|trans }}</p></div></header>
    <form method="get" class="toolbar">
        <input type="hidden" name="tab" value="stolen">
        <input class="input" name="location" value="{{ location }}" placeholder="{{ 'bikeservice.field.location'|trans }}" required>
        <button class="btn btn--primary" type="submit">{{ 'bikeservice.explore.search'|trans }}</button>
    </form>
    {% if stolenResult %}
        {% if stolenResult.ok and stolenResult.bikes is not empty %}
            <div class="table-wrap" style="margin-top:1rem">
                <table class="table">
                    <thead><tr><th>{{ 'bikeservice.field.brand'|trans }}</th><th>{{ 'bikeservice.field.serial'|trans }}</th><th>{{ 'bikeservice.field.location'|trans }}</th><th></th></tr></thead>
                    <tbody>
                    {% for hit in stolenResult.bikes %}
                        <tr>
                            <td>{{ hit.manufacturer_name|default(hit.title|default('—')) }}</td>
                            <td>{{ hit.serial|default('—') }}</td>
                            <td class="muted">{{ hit.stolen_location|default(hit.location_found|default('—')) }}</td>
                            <td>{% if hit.id %}<a href="https://bikeindex.org/bikes/{{ hit.id }}" target="_blank" rel="noopener">#{{ hit.id }}</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="muted" style="margin-top:1rem">{{ stolenResult.error ? stolenResult.error|trans : 'bikeservice.explore.no_results'|trans }}</p>
        {% endif %}
    {% endif %}
</section>
{% endif %}

{% if tab == 'citybikes' %}
<section class="panel">
    <header class="panel__head"><div><h2>{{ 'bikeservice.explore.tab.citybikes'|trans }}</h2><p class="muted">{{ 'bikeservice.explore.citybikes_hint'|trans }} · {{ 'bikeservice.explore.source_citybikes'|trans }}</p></div></header>
    <form method="get" class="toolbar" style="flex-wrap:wrap">
        <input type="hidden" name="tab" value="citybikes">
        <input class="input" name="country" value="{{ country }}" placeholder="{{ 'bikeservice.field.country'|trans }}" style="max-width:6rem">
        <input class="input" name="city" value="{{ cityQ }}" placeholder="{{ 'bikeservice.field.city'|trans }}">
        <input class="input" name="network" value="{{ networkId }}" placeholder="{{ 'bikeservice.field.network'|trans }}">
        <button class="btn btn--primary" type="submit">{{ 'bikeservice.explore.search'|trans }}</button>
    </form>

    {% if networksResult and networksResult.ok %}
        <div class="table-wrap" style="margin-top:1rem">
            <table class="table">
                <thead><tr><th>ID</th><th>{{ 'bikeservice.field.network'|trans }}</th><th>{{ 'bikeservice.field.city'|trans }}</th><th></th></tr></thead>
                <tbody>
                {% for n in networksResult.networks|slice(0, 40) %}
                    <tr>
                        <td class="muted">{{ n.id }}</td>
                        <td>{{ n.name|default('—') }}</td>
                        <td>{{ n.location.city|default('—') }} ({{ n.location.country|default('') }})</td>
                        <td><a href="{{ url('admin.bikeservice.explore') }}?tab=citybikes&network={{ n.id|url_encode }}&country={{ country|url_encode }}">{{ 'common.view'|trans }}</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="muted">{{ 'bikeservice.explore.no_results'|trans }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if networkDetail and networkDetail.ok and networkDetail.network %}
        {% set net = networkDetail.network %}
        <h3 style="margin-top:1.5rem">{{ net.name|default(networkId) }}</h3>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'bikeservice.explore.stations'|trans }}</th>
                        <th>{{ 'bikeservice.explore.free_bikes'|trans }}</th>
                        <th>{{ 'bikeservice.explore.empty_slots'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for s in net.stations|default([])|slice(0, 30) %}
                    <tr>
                        <td>{{ s.name|default('—') }}</td>
                        <td>{{ s.free_bikes|default(0) }}{% if s.extra.ebikes is defined %} <span class="muted">(e: {{ s.extra.ebikes }})</span>{% endif %}</td>
                        <td>{{ s.empty_slots|default('—') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="muted">{{ 'bikeservice.explore.no_results'|trans }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% elseif networkDetail and not networkDetail.ok %}
        <p class="muted">{{ networkDetail.error|trans }}</p>
    {% endif %}
</section>
{% endif %}

{% if tab == 'osm' %}
<section class="panel">
    <header class="panel__head"><div><h2>{{ 'bikeservice.explore.tab.osm'|trans }}</h2><p class="muted">{{ 'bikeservice.explore.osm_hint'|trans }} · {{ 'bikeservice.explore.source_osm'|trans }}</p></div></header>
    <form method="get" class="toolbar" style="flex-wrap:wrap">
        <input type="hidden" name="tab" value="osm">
        <input class="input" name="lat" value="{{ lat }}" placeholder="{{ 'bikeservice.field.lat'|trans }}" style="max-width:8rem">
        <input class="input" name="lon" value="{{ lon }}" placeholder="{{ 'bikeservice.field.lon'|trans }}" style="max-width:8rem">
        <input class="input" name="radius" value="{{ radius }}" placeholder="{{ 'bikeservice.field.radius'|trans }}" style="max-width:8rem">
        <button class="btn btn--primary" type="submit">{{ 'bikeservice.explore.search'|trans }}</button>
    </form>
    {% if osmResult %}
        {% if osmResult.ok and osmResult.places is not empty %}
            <div class="table-wrap" style="margin-top:1rem">
                <table class="table">
                    <thead><tr><th>{{ 'bikeservice.field.brand'|trans }}</th><th>{{ 'bikeservice.field.kind'|trans }}</th><th>{{ 'bikeservice.explore.distance'|trans }}</th><th></th></tr></thead>
                    <tbody>
                    {% for p in osmResult.places %}
                        <tr>
                            <td>{{ p.name }}{% if p.ebike %} <span class="chip">e-bike</span>{% endif %}</td>
                            <td>{{ ('bikeservice.poi.'~p.kind)|trans }}</td>
                            <td class="muted">{{ p.distance_m }} m</td>
                            <td>
                                <a href="https://www.openstreetmap.org/?mlat={{ p.lat }}&mlon={{ p.lon }}#map=18/{{ p.lat }}/{{ p.lon }}" target="_blank" rel="noopener">OSM</a>
                                {% if p.website %} · <a href="{{ p.website }}" target="_blank" rel="noopener">web</a>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="muted" style="margin-top:1rem">{{ osmResult.error ? osmResult.error|trans : 'bikeservice.explore.no_results'|trans }}</p>
        {% endif %}
    {% endif %}
</section>
{% endif %}
</div>
{% endblock %}
