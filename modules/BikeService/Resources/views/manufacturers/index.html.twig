{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set canManage = user.can('bikeservice.manage') %}
<div class="list-shell bs-manufacturers" x-data="dataTable" data-table-id="bikeservice-manufacturers" data-actions-default="1" data-initial-query="{{ q|default('')|e('html_attr') }}">
<header class="page-header">
    <div>
        <h1>{{ 'bikeservice.manufacturers.title'|trans }}</h1>
        <p class="muted">{{ 'bikeservice.manufacturers.intro'|trans }}</p>
    </div>
    {% if canManage %}
        <a class="btn btn--primary" href="{{ url('admin.bikeservice.bikes.create') }}">{{ icon('plus') }} {{ 'bikeservice.bikes.new'|trans }}</a>
    {% endif %}
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input
            class="input"
            type="search"
            name="q"
            value="{{ q }}"
            placeholder="{{ 'bikeservice.catalog.search'|trans }}"
            autocomplete="off"
            {% if not framesOnly and not ebikeOnly %}x-model="query"{% endif %}
        >
        <label class="bs-catalog__filter">
            <input type="checkbox" name="frames" value="1" {{ framesOnly ? 'checked' : '' }} onchange="this.form.submit()">
            {{ 'bikeservice.catalog.filter.frames'|trans }}
        </label>
        <label class="bs-catalog__filter">
            <input type="checkbox" name="ebike" value="1" {{ ebikeOnly ? 'checked' : '' }} onchange="this.form.submit()">
            {{ 'bikeservice.catalog.filter.ebike'|trans }}
        </label>
        <button class="btn btn--primary btn-sm" type="submit">{{ 'bikeservice.explore.search'|trans }}</button>
    </form>
</div>

{% if brands and brands.ok %}
<p class="bs-catalog__meta muted">{{ 'bikeservice.catalog.count'|trans({'%count%': brands.items|length}) }} · {{ 'bikeservice.catalog.source'|trans }}</p>
<div class="table-wrap" data-table>
<table class="table table--bs-catalog">
    <thead>
    <tr>
        <th>{{ 'bikeservice.catalog.manufacturer'|trans }}</th>
        <th>{{ 'bikeservice.catalog.col.website'|trans }}</th>
        <th>{{ 'bikeservice.catalog.col.tags'|trans }}</th>
        <th class="table__num">{{ 'bikeservice.catalog.col.local'|trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% for item in brands.items %}
        <tr data-brand="{{ item.name|e('html_attr') }}{% if item.alternate_name %} {{ item.alternate_name|e('html_attr') }}{% endif %}" x-show="matchText($el.dataset.brand)">
            <td>
                <a class="fleet-brand-row" href="{{ url('admin.bikeservice.manufacturers.show', {id: item.name|url_encode}) }}">
                    {% if item.logo_url %}
                        <img class="fleet-brand-logo fleet-brand-logo--row" src="{{ item.logo_url }}" alt="" loading="lazy" width="36" height="36" onerror="this.style.display='none'">
                    {% else %}
                        <span class="fleet-brand-logo fleet-brand-logo--row fleet-brand-logo--empty" aria-hidden="true">{{ item.name|slice(0,1)|upper }}</span>
                    {% endif %}
                    <span class="fleet-brand-row__name">{{ item.name }}</span>
                </a>
            </td>
            <td class="bs-catalog__web muted">
                {% if item.website %}
                    <a href="{{ item.website }}" target="_blank" rel="noopener" onclick="event.stopPropagation()">{{ item.website|replace({'https://':'','http://':'','www.':''})|slice(0,40) }}{% if item.website|length > 40 %}…{% endif %}</a>
                {% else %}—{% endif %}
            </td>
            <td>
                <div class="bs-catalog__tags">
                    {% if item.makes_frames %}<span class="badge badge--muted">{{ 'bikeservice.catalog.tag.frames'|trans }}</span>{% endif %}
                    {% if item.ebike_only %}<span class="badge badge--bs-electric">{{ 'bikeservice.catalog.tag.ebike'|trans }}</span>{% endif %}
                </div>
            </td>
            <td class="table__num">{% if item.local_count > 0 %}<span class="chip">{{ item.local_count }}×</span>{% else %}<span class="muted">—</span>{% endif %}</td>
        </tr>
    {% else %}
        <tr><td colspan="4"><div class="empty"><h2>{{ 'bikeservice.catalog.empty_search'|trans }}</h2></div></td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% elseif brands %}
<p class="muted">{{ brands.error|trans }}</p>
{% endif %}
</div>
{% endblock %}
