{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <p class="eyebrow"><a href="{{ url('admin.bikeservice.orders') }}">{{ 'nav.bikeservice'|trans }}</a></p>
        <h1>{{ item ? 'bikeservice.orders.edit'|trans : 'bikeservice.orders.new'|trans }}</h1>
        <p class="muted">{{ 'bikeservice.orders.form.intro'|trans }}</p>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.bikeservice.orders') }}">{{ 'common.cancel'|trans }}</a>
        <button class="btn btn--primary" type="submit" form="bikeservice-order-form">{{ 'common.save'|trans }}</button>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'bikeservice.save' } %}

<form method="post" id="bikeservice-order-form" class="detail-stack" action="{{ item ? url('admin.bikeservice.orders.update',{id:item.id()}) : url('admin.bikeservice.orders.store') }}" data-form="bikeservice.save" x-data="gereqForm">
{{ csrf_field()|raw }}

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'bikeservice.orders.section.order'|trans }}</h2>
            <p class="muted">{{ 'bikeservice.orders.section.order_hint'|trans }}</p>
        </div>
    </header>
    <div class="form-grid">
        {% include 'ui/select.html.twig' with { name:'bike_id', label:'bikeservice.field.bike'|trans, required:true, form:'bikeservice.save', value: item?item.bikeId():bikeId, options:bikeOptions, extra:'field--full' } %}
        {% include 'ui/select.html.twig' with { name:'customer_id', label:'bikeservice.field.customer'|trans, optional:true, form:'bikeservice.save', value: item?item.customerId():customerId, options:customerOptions } %}
        {% include 'ui/select.html.twig' with { name:'status', label:'bikeservice.field.status'|trans, form:'bikeservice.save', value: item?item.status():'intake', options: statuses|map(s => {value:s, label:('bikeservice.status.'~s)|trans}) } %}
        {% include 'ui/select.html.twig' with { name:'team', label:'bikeservice.field.team'|trans, form:'bikeservice.save', value: item?item.team():'mechanics', options: teams|map(t => {value:t, label:('bikeservice.team.'~t)|trans}) } %}
    </div>
</section>

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'bikeservice.orders.section.intake'|trans }}</h2>
            <p class="muted">{{ 'bikeservice.orders.section.intake_hint'|trans }}</p>
        </div>
    </header>
    <div class="form-grid">
        {% include 'ui/input.html.twig' with { name:'intake_odometer_km', type:'number', label:'bikeservice.field.intake_odometer'|trans, optional:true, form:'bikeservice.save', value: item and item.intakeOdometerKm()?item.intakeOdometerKm():'' } %}
        {% include 'ui/input.html.twig' with { name:'intake_battery_pct', type:'number', label:'bikeservice.field.intake_battery'|trans, optional:true, form:'bikeservice.save', value: item and item.intakeBatteryPct() is not null?item.intakeBatteryPct():'' } %}
        {% include 'ui/input.html.twig' with { name:'intake_at', type:'date', label:'bikeservice.field.intake'|trans, optional:true, form:'bikeservice.save', value: item and item.intakeAt()?item.intakeAt().format('Y-m-d'):'' } %}
        {% include 'ui/input.html.twig' with { name:'handover_at', type:'date', label:'bikeservice.field.handover'|trans, optional:true, form:'bikeservice.save', value: item and item.handoverAt()?item.handoverAt().format('Y-m-d'):'' } %}
    </div>
</section>

<section class="panel">
    <header class="panel__head"><div><h2>{{ 'bikeservice.orders.section.costs'|trans }}</h2></div></header>
    <div class="form-grid">
        {% include 'ui/select.html.twig' with { name:'payment_type', label:'bikeservice.field.payment_type'|trans, optional:true, form:'bikeservice.save', value: item?item.paymentType():'', options:[
            {value:'',label:'—'},
            {value:'online',label:'bikeservice.payment.online'|trans},
            {value:'cash',label:'bikeservice.payment.cash'|trans}
        ] } %}
        {% include 'ui/input.html.twig' with { name:'labor_cost', type:'number', label:'bikeservice.field.labor_cost'|trans, optional:true, form:'bikeservice.save', value: item and item.laborCost()?item.laborCost():'', step:'0.01' } %}
        {% include 'ui/input.html.twig' with { name:'parts_cost', type:'number', label:'bikeservice.field.parts_cost'|trans, optional:true, form:'bikeservice.save', value: item and item.partsCost()?item.partsCost():'', step:'0.01' } %}
    </div>
</section>

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'bikeservice.orders.section.work'|trans }}</h2>
            <p class="muted">{{ 'bikeservice.orders.section.work_hint'|trans }}</p>
        </div>
    </header>
    <div class="form-grid">
        {% include 'ui/textarea.html.twig' with { name:'service_info', label:'bikeservice.field.service_info'|trans, optional:true, form:'bikeservice.save', value: item?item.serviceInfo():'', size:'mini', extra:'field--full' } %}
        {% include 'ui/textarea.html.twig' with { name:'note', label:'bikeservice.field.note'|trans, optional:true, form:'bikeservice.save', value: item?item.note():'', size:'mini', extra:'field--full' } %}
    </div>
</section>
</form>
{% endblock %}
