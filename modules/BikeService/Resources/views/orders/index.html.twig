{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set canManage = user.can('bikeservice.manage') %}
{% set emptyCols = canManage ? 7 : 6 %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="bikeservice"
    data-actions-default="{{ canManage ? 3 : 1 }}"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'bikeservice.bulk.confirm_delete'|trans|e('html_attr') }}"
>
<header class="page-header">
    <div>
        <h1>{{ 'bikeservice.orders.title'|trans }}</h1>
        <p class="muted">{{ 'bikeservice.orders.intro'|trans }}</p>
    </div>
    {% if canManage %}
        <a class="btn btn--primary" href="{{ url('admin.bikeservice.orders.create') }}">{{ icon('plus') }} {{ 'bikeservice.orders.new'|trans }}</a>
    {% endif %}
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <select name="status" class="input" onchange="this.form.submit()">
            <option value="">{{ 'bikeservice.all_statuses'|trans }}</option>
            {% for s in statuses %}<option value="{{ s }}" {{ status==s?'selected':'' }}>{{ ('bikeservice.status.'~s)|trans }}</option>{% endfor %}
        </select>
        <select name="team" class="input" onchange="this.form.submit()">
            <option value="">{{ 'bikeservice.all_teams'|trans }}</option>
            {% for t in teams %}<option value="{{ t }}" {{ team==t?'selected':'' }}>{{ ('bikeservice.team.'~t)|trans }}</option>{% endfor %}
        </select>
    </form>
</div>

{% if canManage and items is not empty %}
    <form class="bulk-bar" method="post" action="{{ url('admin.bikeservice.orders.bulk') }}" x-show="selectedCount > 0" x-cloak @submit="confirmBulk">
        {{ csrf_field()|raw }}
        <input type="hidden" name="confirmed" value="1">
        <template x-for="id in selected" :key="id"><input type="hidden" name="ids[]" :value="id"></template>
        <div class="bulk-bar__meta">
            <strong x-text="selectedCount"></strong>
            <span>{{ 'bikeservice.bulk.selected'|trans }}</span>
            <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'bikeservice.bulk.clear'|trans }}</button>
        </div>
        <div class="bulk-bar__actions">
            <select class="input" name="action" x-model="bulkAction" required>
                <option value="">{{ 'bikeservice.bulk.choose'|trans }}</option>
                <option value="delete">{{ 'bikeservice.bulk.action.delete'|trans }}</option>
            </select>
            <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'bikeservice.bulk.apply'|trans }}</button>
        </div>
    </form>
{% endif %}

<div class="table-wrap" data-table>
<table class="table table--bikeservice">
<thead>
<tr>
    {% if canManage %}
        <th class="table__check">
            <label class="table-check">
                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected">
                <span class="sr-only">{{ 'bikeservice.bulk.select_all'|trans }}</span>
            </label>
        </th>
    {% endif %}
    <th>{{ 'bikeservice.field.bike'|trans }}</th>
    <th>{{ 'bikeservice.field.customer'|trans }}</th>
    {% include 'ui/sort_th.html.twig' with { label: 'bikeservice.field.status'|trans, column: 'status', query: { status: status, team: team } } %}
    {% include 'ui/sort_th.html.twig' with { label: 'bikeservice.field.team'|trans, column: 'team', query: { status: status, team: team } } %}
    {% include 'ui/sort_th.html.twig' with { label: 'bikeservice.field.updated'|trans, column: 'updatedAt', query: { status: status, team: team } } %}
    <th class="table__actions-head"></th>
</tr>
</thead>
<tbody>
{% for item in items %}
{% set bike = bikes[item.bikeId()]|default(null) %}
{% set customer = item.customerId() ? customers[item.customerId()]|default(null) : null %}
<tr class="bs-row" :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
    {% if canManage %}
        <td class="table__check">
            <label class="table-check">
                <input type="checkbox" value="{{ item.id() }}" @change="toggleId('{{ item.id() }}')" :checked="isSelected('{{ item.id() }}')">
                <span class="sr-only">#{{ item.id()|slice(0, 8) }}</span>
            </label>
        </td>
    {% endif %}
    <td>
        <a class="bs-row__primary" href="{{ url('admin.bikeservice.orders.show', {id: item.id()}) }}">
            {% if bike %}
                <span class="bs-row__plate">{{ bike.brand() }}{% if bike.model() %} {{ bike.model() }}{% endif %}</span>
                <span class="bs-row__name">{{ ('bikeservice.kind.'~bike.kind())|trans }}{% if bike.serialNumber() %} · {{ bike.serialNumber() }}{% endif %}</span>
            {% else %}
                <span class="bs-row__plate">{{ item.bikeId()|slice(0, 8) }}…</span>
            {% endif %}
            <span class="bs-row__meta">#{{ item.id()|slice(0, 8) }}</span>
        </a>
    </td>
    <td>
        {% if customer %}
            <a class="bs-row__customer" href="{{ url('admin.customers.show', {id: customer.id()}) }}">{{ customer.name() }}</a>
        {% else %}
            <span class="muted">—</span>
        {% endif %}
    </td>
    <td>
        <span class="status-chip status-chip--bs-{{ item.status() }}">
            <span class="status-chip__dot" aria-hidden="true"></span>
            {{ item.statusLabel()|trans }}
        </span>
    </td>
    <td><span class="badge badge--bs-{{ item.team() }}">{{ item.teamLabel()|trans }}</span></td>
    <td><time class="bs-row__when" datetime="{{ item.updatedAt().format('c') }}">{{ item.updatedAt().format('d. m. Y H:i') }}</time></td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            {% include 'ui/row_action.html.twig' with { href: url('admin.bikeservice.orders.show',{id:item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
            {% if canManage %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.bikeservice.orders.edit',{id:item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                {% include 'ui/row_action_destroy.html.twig' with {
                    action: url('admin.bikeservice.orders.destroy', {id: item.id()}),
                    confirm: 'bikeservice.orders.confirm_delete'|trans
                } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr><td colspan="{{ emptyCols }}"><div class="empty"><h2>{{ 'bikeservice.orders.empty'|trans }}</h2></div></td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
