{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'customers.edit'|trans : 'customers.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'customers.save' } %}

    <form method="post" class="form-grid" action="{{ item ? url('admin.customers.update', {id: item.id()}) : url('admin.customers.store') }}" data-form="customers.save" x-data="gereqForm"{% if form_errors('customers.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {% include 'ui/input.html.twig' with {
            name: 'name',
            label: 'customers.field.name'|trans,
            required: true,
            form: 'customers.save',
            value: item ? item.name() : ''
        } %}
        {% include 'ui/input.html.twig' with {
            name: 'email',
            type: 'email',
            label: 'customers.field.email'|trans,
            required: true,
            form: 'customers.save',
            value: item ? item.email() : ''
        } %}
        {% include 'ui/input.html.twig' with {
            name: 'phone',
            type: 'tel',
            label: 'customers.field.phone'|trans,
            optional: true,
            form: 'customers.save',
            value: item ? item.phone() : ''
        } %}
        {% include 'ui/input.html.twig' with {
            name: 'company',
            label: 'customers.field.company'|trans,
            optional: true,
            form: 'customers.save',
            value: item ? item.company() : ''
        } %}
        {% include 'ui/select.html.twig' with {
            name: 'status',
            label: 'customers.field.status'|trans,
            form: 'customers.save',
            value: item ? item.status() : 'active',
            options: [
                { value: 'active', label: 'customers.status.active'|trans },
                { value: 'lead', label: 'customers.status.lead'|trans },
                { value: 'inactive', label: 'customers.status.inactive'|trans },
                { value: 'archived', label: 'customers.status.archived'|trans }
            ]
        } %}
        {% include 'ui/editor.html.twig' with {
            name: 'note',
            label: 'customers.field.note'|trans,
            optional: true,
            extra: 'field--full',
            form: 'customers.save',
            placeholder: 'customers.note.placeholder'|trans,
            value: item ? item.note() : ''
        } %}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.customers.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </form>
{% endblock %}
