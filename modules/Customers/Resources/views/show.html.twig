{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <div class="cell-user cell-user--lg">
            <span class="avatar">{{ item.initials() }}</span>
            <div>
                <h1>{{ item.name() }}</h1>
                <p class="muted">{{ item.company() ?: item.email() }}</p>
            </div>
        </div>
        <div class="actions">
            {% if user.can('customers.edit') %}
                <a class="btn btn--primary" href="{{ url('admin.customers.edit', {id: item.id()}) }}">Upravit</a>
            {% endif %}
            {% if user.can('customers.delete') %}
                <form method="post" action="{{ url('admin.customers.destroy', {id: item.id()}) }}" onsubmit="return confirm('Smazat zákazníka?');">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--danger" type="submit">Smazat</button>
                </form>
            {% endif %}
        </div>
    </header>

    <dl class="meta-list">
        <div><dt>E-mail</dt><dd>{{ item.email() }}</dd></div>
        <div><dt>Telefon</dt><dd>{{ item.phone() ?: '—' }}</dd></div>
        <div><dt>Firma</dt><dd>{{ item.company() ?: '—' }}</dd></div>
        <div><dt>Stav</dt><dd><span class="badge">{{ item.statusLabel() }}</span></dd></div>
        <div><dt>Vytvořeno</dt><dd>{{ item.createdAt().format('d. m. Y H:i') }}</dd></div>
        <div><dt>Upraveno</dt><dd>{{ item.updatedAt().format('d. m. Y H:i') }}</dd></div>
        <div class="meta-list__full"><dt>Poznámka</dt><dd class="g-prose">{{ item.note() ? item.note()|striptags('<p><br><strong><em><ul><ol><li><a><h2><h3>')|raw : '—' }}</dd></div>
    </dl>
{% endblock %}
