{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'customers.title'|trans }}</h1>
        {% if user.can('customers.create') %}
            <a class="btn btn--primary" href="{{ url('admin.customers.create') }}">{{ icon('plus') }} {{ 'customers.add'|trans }}</a>
        {% endif %}
    </header>

    <form class="toolbar" method="get">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'customers.search'|trans }}">
        <select name="status" class="input" onchange="this.form.submit()">
            <option value="">{{ 'common.all_statuses'|trans }}</option>
            <option value="active" {{ status == 'active' ? 'selected' : '' }}>{{ 'customers.status.active'|trans }}</option>
            <option value="lead" {{ status == 'lead' ? 'selected' : '' }}>{{ 'customers.status.lead'|trans }}</option>
            <option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>{{ 'customers.status.inactive'|trans }}</option>
        </select>
    </form>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.name'|trans, column: 'name', query: { status: status } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.email'|trans, column: 'email', query: { status: status } } %}
                    <th>{{ 'customers.field.phone'|trans }}</th>
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.company'|trans, column: 'company', query: { status: status } } %}
                    {% include 'ui/sort_th.html.twig' with { label: 'customers.field.status'|trans, column: 'status', query: { status: status } } %}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            <a class="cell-user" href="{{ url('admin.customers.show', {id: item.id()}) }}">
                                <span class="avatar avatar--sm">{{ item.initials() }}</span>
                                {{ item.name() }}
                            </a>
                        </td>
                        <td>{{ item.email() }}</td>
                        <td class="is-mute">{{ item.phone() ?: '—' }}</td>
                        <td>{{ item.company() ?: '—' }}</td>
                        <td>
                            <span class="badge badge--{{ item.status() == 'active' ? 'ok' : (item.status() == 'lead' ? 'warn' : 'muted') }}">
                                {{ item.statusLabel()|trans }}
                            </span>
                        </td>
                        <td class="table__actions" x-data="rowMenu" @click.outside="close">
                            <button type="button" class="icon-btn" x-ref="button" @click="toggle" aria-haspopup="menu" :aria-expanded="open">{{ icon('dots') }}</button>
                            <div class="flyout flyout--right" x-ref="menu" :class="menuClass" :style="menuStyle" role="menu">
                                <a href="{{ url('admin.customers.show', {id: item.id()}) }}">{{ 'common.detail'|trans }}</a>
                                {% if user.can('customers.edit') %}
                                    <a href="{{ url('admin.customers.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
                                {% endif %}
                                {% if user.can('customers.delete') %}
                                    <form method="post" action="{{ url('admin.customers.destroy', {id: item.id()}) }}">
                                        {{ csrf_field()|raw }}
                                        <button type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty">
                                <h2>{{ 'customers.empty'|trans }}</h2>
                                <p>{{ 'customers.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
{% endblock %}
