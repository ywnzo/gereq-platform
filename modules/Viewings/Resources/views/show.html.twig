{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.viewings'|trans, url: url('admin.viewings.index') },
        { label: item.number() },
    ] } %}
{% endblock %}

{% block content %}
{% set statusTone = item.status() == 'confirmed' ? 'ok'
    : (item.status() == 'scheduled' ? 'info'
    : (item.status() == 'requested' ? 'warn'
    : (item.status() in ['cancelled', 'no_show'] ? 'danger'
    : 'muted'))) %}
{% set nameParts = item.contactName()|trim|split(' ') %}
{% set initials = (nameParts|first|slice(0, 1) ~ (nameParts|length > 1 ? nameParts|last|slice(0, 1) : ''))|upper %}

<header class="page-header">
    <div>
        <h1>{{ item.number() }}</h1>
        <p class="muted detail-layout__meta">
            {% if listing %}
                <span>{{ listing.title() }}{% if listing.city() %} · {{ listing.city() }}{% endif %}</span>
            {% else %}
                <span>{{ 'viewings.listing.unknown'|trans }}</span>
            {% endif %}
            <span class="badge badge--{{ statusTone }}">{{ item.statusLabel()|trans }}</span>
        </p>
    </div>
    {% if user.can('viewings.manage') %}
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.viewings.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
            <form method="post" action="{{ url('admin.viewings.destroy', {id: item.id()}) }}" data-confirm="{{ 'viewings.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1">
                {{ csrf_field()|raw }}
                <button class="btn btn--ghost" type="submit">{{ 'common.delete'|trans }}</button>
            </form>
        </div>
    {% endif %}
</header>

<div class="detail-layout">
    <div class="detail-layout__main">
        <section class="detail-hero panel">
            <div class="detail-hero__body">
                <div class="detail-hero__highlight">
                    <span>{{ 'viewings.field.scheduled_at'|trans }}</span>
                    <strong>{% if item.scheduledAt() %}{{ item.scheduledAt().format('d. m. Y H:i') }}{% else %}—{% endif %}</strong>
                </div>
                <dl class="detail-hero__facts">
                    <div>
                        <dt>{{ 'viewings.field.contact_name'|trans }}</dt>
                        <dd>
                            <span class="cell-user">
                                <span class="avatar avatar--sm" aria-hidden="true">{{ initials }}</span>
                                <span class="cell-user__text"><strong>{{ item.contactName() }}</strong></span>
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt>{{ 'viewings.field.contact_email'|trans }}</dt>
                        <dd>
                            {% if item.contactEmail() %}
                                <a href="mailto:{{ item.contactEmail() }}">{{ item.contactEmail() }}</a>
                            {% else %}—{% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt>{{ 'viewings.field.contact_phone'|trans }}</dt>
                        <dd>
                            {% if item.contactPhone() %}
                                <a href="tel:{{ item.contactPhone()|replace({' ': ''}) }}">{{ item.contactPhone() }}</a>
                            {% else %}—{% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt>{{ 'viewings.field.broker'|trans }}</dt>
                        <dd>
                            {% if broker %}
                                {% if user.can('listings.view') %}
                                    <a href="{{ url('admin.listings.brokers.show', {id: broker.id()}) }}">{{ broker.fullName() }}</a>
                                {% else %}
                                    {{ broker.fullName() }}
                                {% endif %}
                                {% if broker.phone() %}<div class="muted">{{ broker.phone() }}</div>{% endif %}
                            {% elseif item.brokerId() %}
                                <span class="muted">{{ 'viewings.broker.unknown'|trans }}</span>
                            {% else %}
                                —
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            </div>
        </section>

        <section class="panel">
            <header class="panel__head"><h2>{{ 'viewings.field.listing'|trans }}</h2></header>
            {% if listing %}
                <div class="cell-user cell-user--lg">
                    {% include 'ui/table_thumb.html.twig' with {
                        src: listing.coverImageUrl(),
                        href: user.can('listings.view') ? url('admin.listings.show', {id: listing.id()}) : null,
                        alt: listing.title(),
                        width: 64,
                        height: 64
                    } %}
                    <span class="cell-user__text">
                        {% if user.can('listings.view') %}
                            <a href="{{ url('admin.listings.show', {id: listing.id()}) }}"><strong>{{ listing.title() }}</strong></a>
                        {% else %}
                            <strong>{{ listing.title() }}</strong>
                        {% endif %}
                        <small class="muted">
                            {% if listing.address() %}
                                {{ listing.address() }}
                            {% else %}
                                {{ listing.city() }}{% if listing.cityPart() %}, {{ listing.cityPart() }}{% endif %}{% if listing.street() %} · {{ listing.street() }}{% endif %}
                            {% endif %}
                        </small>
                        <small class="muted">{{ listing.price()|number_format(0, ',', ' ') }}&nbsp;{{ listing.currency() }}</small>
                    </span>
                </div>
            {% else %}
                <p class="muted">{{ 'viewings.listing.unknown'|trans }}</p>
            {% endif %}
        </section>

        {% if item.note() %}
        <section class="panel">
            <header class="panel__head"><h2>{{ 'viewings.field.note'|trans }}</h2></header>
            <div class="detail-prose">{{ item.note()|nl2br }}</div>
        </section>
        {% endif %}
    </div>

    <aside class="detail-layout__aside">
        <section class="panel">
            <header class="panel__head"><h2>{{ 'viewings.field.status'|trans }}</h2></header>
            {% if user.can('viewings.manage') %}
                <form method="post" class="form-grid" action="{{ url('admin.viewings.status', {id: item.id()}) }}">
                    {{ csrf_field()|raw }}
                    {% include 'ui/select.html.twig' with { name:'status', label:'viewings.field.status'|trans, value:item.status(), options:[
                    {value:'requested',label:'viewings.status.requested'|trans},{value:'scheduled',label:'viewings.status.scheduled'|trans},
                    {value:'confirmed',label:'viewings.status.confirmed'|trans},{value:'completed',label:'viewings.status.completed'|trans},
                    {value:'cancelled',label:'viewings.status.cancelled'|trans},{value:'no_show',label:'viewings.status.no_show'|trans}
                    ] } %}
                    {% include 'ui/textarea.html.twig' with { name:'note', label:'viewings.field.note'|trans, optional:true, value:item.note()|default(''), size: 'mini', rows: 4 } %}
                    <div class="form-actions"><button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button></div>
                </form>
            {% else %}
                <span class="badge badge--{{ statusTone }}">{{ item.statusLabel()|trans }}</span>
            {% endif %}
        </section>
    </aside>
</div>
{% endblock %}
