{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set filterQuery = { status: status } %}
<div class="list-shell" x-data="dataTable" data-table-id="viewings" data-actions-default="1">
<header class="page-header">
    <div>
        <h1>{{ 'viewings.title'|trans }}</h1>
        <p class="muted">{{ 'viewings.list.hint'|trans }}</p>
    </div>
    <div class="actions">
        {% if user.can('viewings.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.viewings.create') }}">{{ icon('plus') }} {{ 'viewings.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<div class="toolbar--table">
<form class="toolbar" method="get">
<input type="hidden" name="sort" value="{{ sort }}">
<input type="hidden" name="dir" value="{{ dir }}">
<input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'viewings.search'|trans }}">
<select name="status" class="input" onchange="this.form.submit()">
    <option value="">{{ 'viewings.all_statuses'|trans }}</option>
    {% for s in statuses %}<option value="{{ s }}" {{ status==s?'selected':'' }}>{{ ('viewings.status.'~s)|trans }}</option>{% endfor %}
</select>
</form>
</div>

<div class="table-wrap" data-table>
<table class="table">
<thead>
<tr>
<th class="table__thumb-cell"><span class="sr-only">{{ 'viewings.field.listing'|trans }}</span></th>
{% include 'ui/sort_th.html.twig' with { label: 'viewings.field.number'|trans, column: 'number', query: filterQuery } %}
<th>{{ 'viewings.field.listing'|trans }}</th>
<th>{{ 'viewings.field.contact_name'|trans }}</th>
{% include 'ui/sort_th.html.twig' with { label: 'viewings.field.status'|trans, column: 'status', query: filterQuery } %}
{% include 'ui/sort_th.html.twig' with { label: 'viewings.field.scheduled_at'|trans, column: 'scheduledAt', query: filterQuery } %}
<th class="table__actions-head"></th>
</tr>
</thead>
<tbody>
{% for item in items %}
{% set listing = listings[item.listingId()]|default(null) %}
{% set listingHref = listing and user.can('listings.view') ? url('admin.listings.show', {id: listing.id()}) : url('admin.viewings.show', {id: item.id()}) %}
{% set statusTone = item.status() == 'confirmed' ? 'ok'
    : (item.status() == 'scheduled' ? 'info'
    : (item.status() == 'requested' ? 'warn'
    : (item.status() in ['cancelled', 'no_show'] ? 'danger'
    : 'muted'))) %}
{% set nameParts = item.contactName()|trim|split(' ') %}
{% set initials = (nameParts|first|slice(0, 1) ~ (nameParts|length > 1 ? nameParts|last|slice(0, 1) : ''))|upper %}
<tr>
<td class="table__thumb-cell">
    {% include 'ui/table_thumb.html.twig' with {
        src: listing ? listing.coverImageUrl() : null,
        href: listingHref,
        alt: listing ? listing.title() : item.listingId(),
    } %}
</td>
<td>
    <div class="table__title">
        <a href="{{ url('admin.viewings.show', {id: item.id()}) }}"><strong>{{ item.number() }}</strong></a>
        {% if item.note() %}
            <span class="table__meta muted">{{ item.note()|length > 48 ? item.note()|slice(0, 48) ~ '…' : item.note() }}</span>
        {% endif %}
    </div>
</td>
<td>
    <div class="table__title">
        {% if listing %}
            {% if user.can('listings.view') %}
                <a href="{{ url('admin.listings.show', {id: listing.id()}) }}">{{ listing.title() }}</a>
            {% else %}
                {{ listing.title() }}
            {% endif %}
            <span class="table__meta muted">{{ listing.city() ?: '—' }}</span>
        {% else %}
            <span class="muted">{{ 'viewings.listing.unknown'|trans }}</span>
            <span class="table__meta muted"><code title="{{ item.listingId() }}">{{ item.listingId()|slice(0, 8) }}…</code></span>
        {% endif %}
    </div>
</td>
<td>
    <span class="cell-user cell-user--stack">
        <span class="avatar avatar--sm" aria-hidden="true">{{ initials }}</span>
        <span class="cell-user__text">
            <strong>{{ item.contactName() }}</strong>
            {% if item.contactEmail() %}
                <small class="muted">{{ item.contactEmail() }}</small>
            {% elseif item.contactPhone() %}
                <small class="muted">{{ item.contactPhone() }}</small>
            {% endif %}
        </span>
    </span>
</td>
<td><span class="badge badge--{{ statusTone }}">{{ item.statusLabel()|trans }}</span></td>
<td class="is-mute">
    {% if item.scheduledAt() %}
        <strong>{{ item.scheduledAt().format('d. m. Y') }}</strong>
        <div class="muted">{{ item.scheduledAt().format('H:i') }}</div>
    {% else %}
        —
    {% endif %}
</td>
{% embed 'ui/row_actions.html.twig' %}
    {% block items %}
        {% include 'ui/row_action.html.twig' with { href: url('admin.viewings.show', {id: item.id()}), label: 'common.detail'|trans, icon: 'eye' } %}
        {% if user.can('viewings.manage') %}
            {% include 'ui/row_action.html.twig' with { href: url('admin.viewings.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
        {% endif %}
    {% endblock %}
{% endembed %}
</tr>
{% else %}
<tr>
    <td colspan="7">
        <div class="empty">
            <h2>{{ 'viewings.empty'|trans }}</h2>
            <p>{{ 'viewings.empty.hint'|trans }}</p>
            {% if user.can('viewings.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.viewings.create') }}">{{ icon('plus') }} {{ 'viewings.new'|trans }}</a>
            {% endif %}
        </div>
    </td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% include 'ui/table_footer.html.twig' %}
</div>
{% endblock %}
