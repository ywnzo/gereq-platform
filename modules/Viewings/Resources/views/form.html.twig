{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.viewings'|trans, url: url('admin.viewings.index') },
        { label: item ? ('viewings.edit'|trans({'%number%': item.number()})) : ('viewings.new'|trans) },
    ] } %}
{% endblock %}

{% block content %}
{% set viewingSource = item ?? 'Modules\\Viewings\\Domain\\Viewing' %}
{% set formValues = item ? {
    scheduled_at: item.scheduledAt() ? item.scheduledAt().format('Y-m-d\\TH:i') : ''
} : { status: 'scheduled' } %}

<header class="page-header">
    <div>
        <h1>{{ item ? ('viewings.edit'|trans({'%number%': item.number()})) : ('viewings.new'|trans) }}</h1>
        <p class="muted">{{ 'viewings.form.hint'|trans }}</p>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'viewings.save' } %}

<form
    method="post"
    class="detail-stack"
    action="{{ item ? url('admin.viewings.update', {id: item.id()}) : url('admin.viewings.store') }}"
    data-form="viewings.save"
    x-data="gereqForm"
    {% if form_errors('viewings.save') %}data-server-state="1"{% endif %}
>
    {{ csrf_field()|raw }}

    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'common.details'|trans }}</h2>
        </header>
        {{ forms().render(viewingSource, {
            form: 'viewings.save',
            cols: 2,
            values: formValues,
            choices: {
                listing_id: listingOptions,
                customer_id: customerOptions,
                broker_id: brokerOptions
            }
        }) }}
    </section>

    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ item ? url('admin.viewings.show', {id: item.id()}) : url('admin.viewings.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
