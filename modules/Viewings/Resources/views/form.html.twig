{% extends 'admin/layout.html.twig' %}

{% block breadcrumb %}
    {% include 'ui/breadcrumbs.html.twig' with { items: [
        { label: 'nav.overview'|trans, url: url('admin.dashboard') },
        { label: 'nav.viewings'|trans, url: url('admin.viewings.index') },
        { label: item ? ('viewings.edit'|trans({'%number%': item.number()})) : ('viewings.new'|trans) },
    ] } %}
{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <h1>{{ item ? ('viewings.edit'|trans({'%number%': item.number()})) : ('viewings.new'|trans) }}</h1>
        <p class="muted">{{ 'viewings.form.hint'|trans }}</p>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'viewings.save' } %}

<form
    method="post"
    class="form-grid"
    action="{{ item ? url('admin.viewings.update', {id: item.id()}) : url('admin.viewings.store') }}"
    data-form="viewings.save"
    x-data="gereqForm"
    {% if form_errors('viewings.save') %}data-server-state="1"{% endif %}
>
    {{ csrf_field()|raw }}

    {% include 'ui/select.html.twig' with {
        name: 'listing_id',
        label: 'viewings.field.listing'|trans,
        required: true,
        form: 'viewings.save',
        value: item ? item.listingId() : '',
        options: listingOptions,
        searchable: true,
        placeholder: 'viewings.placeholder.listing'|trans,
        extra: 'field--full',
    } %}

    {% include 'ui/input.html.twig' with {
        name: 'contact_name',
        label: 'viewings.field.contact_name'|trans,
        required: true,
        form: 'viewings.save',
        value: item ? item.contactName() : '',
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'contact_email',
        type: 'email',
        label: 'viewings.field.contact_email'|trans,
        optional: true,
        form: 'viewings.save',
        value: item and item.contactEmail() ? item.contactEmail() : '',
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'contact_phone',
        label: 'viewings.field.contact_phone'|trans,
        optional: true,
        form: 'viewings.save',
        value: item and item.contactPhone() ? item.contactPhone() : '',
    } %}

    {% include 'ui/input.html.twig' with {
        name: 'scheduled_at',
        type: 'datetime-local',
        label: 'viewings.field.scheduled_at'|trans,
        optional: true,
        form: 'viewings.save',
        value: item and item.scheduledAt() ? item.scheduledAt().format('Y-m-d\\TH:i') : '',
    } %}
    {% include 'ui/select.html.twig' with {
        name: 'status',
        label: 'viewings.field.status'|trans,
        form: 'viewings.save',
        value: item ? item.status() : 'scheduled',
        options: [
            { value: 'requested', label: 'viewings.status.requested'|trans },
            { value: 'scheduled', label: 'viewings.status.scheduled'|trans },
            { value: 'confirmed', label: 'viewings.status.confirmed'|trans },
            { value: 'completed', label: 'viewings.status.completed'|trans },
            { value: 'cancelled', label: 'viewings.status.cancelled'|trans },
            { value: 'no_show', label: 'viewings.status.no_show'|trans },
        ],
    } %}

    {% include 'ui/select.html.twig' with {
        name: 'customer_id',
        label: 'viewings.field.customer'|trans,
        optional: true,
        form: 'viewings.save',
        value: item and item.customerId() ? item.customerId() : '',
        options: customerOptions,
        searchable: true,
        placeholder: 'viewings.placeholder.customer'|trans,
    } %}
    {% include 'ui/select.html.twig' with {
        name: 'broker_id',
        label: 'viewings.field.broker'|trans,
        optional: true,
        form: 'viewings.save',
        value: item and item.brokerId() ? item.brokerId() : '',
        options: brokerOptions,
        searchable: true,
        placeholder: 'viewings.placeholder.broker'|trans,
    } %}

    {% include 'ui/textarea.html.twig' with {
        name: 'note',
        label: 'viewings.field.note'|trans,
        optional: true,
        form: 'viewings.save',
        value: item and item.note() ? item.note() : '',
        size: 'mini',
        rows: 4,
        extra: 'field--full',
    } %}

    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ item ? url('admin.viewings.show', {id: item.id()}) : url('admin.viewings.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
