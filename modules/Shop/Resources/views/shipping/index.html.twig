{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set pageIds = items|map(i => i.id()) %}
{% set activeFilter = active|default('') %}
{% set typeFilter = type|default('') %}
{% set carrierFilter = carrier|default('') %}
{% set advancedFilters = (activeFilter is not empty) or (typeFilter is not empty) or (carrierFilter is not empty) %}
<div
    class="list-shell"
    x-data="dataTable"
    data-table-id="shop-shipping"
    data-actions-default="1"
    data-page-ids="{{ pageIds|json_encode|e('html_attr') }}"
    data-bulk-delete-confirm="{{ 'shop.shipping.bulk.confirm_delete'|trans|e('html_attr') }}"
>
    <header class="page-header">
        <div>
            <h1>{{ 'shop.shipping.title'|trans }}</h1>
            <p class="muted">{{ 'shop.shipping.list.hint'|trans }}</p>
        </div>
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.shop.carts.index') }}">{{ icon('cart') }} {{ 'shop.carts.title'|trans }}</a>
            {% if user.can('shop.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.shop.shipping.create') }}">{{ icon('plus') }} {{ 'shop.shipping.new'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <div class="toolbar--table">
        <form class="toolbar" method="get" id="shipping-filter-form">
            <input type="hidden" name="active" value="{{ activeFilter }}">
            <input type="hidden" name="type" value="{{ typeFilter }}">
            <input type="hidden" name="carrier" value="{{ carrierFilter }}">
            <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'shop.shipping.search'|trans }}">
        </form>
        <div class="toolbar__toggles">
            {{ ui_render('drawer_trigger', {
                drawer_id: 'shipping-filters',
                label: 'ui.drawer.filters'|trans,
                variant: advancedFilters ? 'primary' : 'ghost',
                icon: 'filters'
            }) }}
        </div>
    </div>

    {% if user.can('shop.manage') and items is not empty %}
        <form
            class="bulk-bar"
            method="post"
            action="{{ url('admin.shop.shipping.bulk') }}"
            x-show="selectedCount > 0"
            x-cloak
            @submit="confirmBulk"
        >
            {{ csrf_field()|raw }}
            <input type="hidden" name="confirmed" value="1">
            <template x-for="id in selected" :key="id">
                <input type="hidden" name="ids[]" :value="id">
            </template>
            <div class="bulk-bar__meta">
                <strong x-text="selectedCount"></strong>
                <span>{{ 'shop.bulk.selected'|trans }}</span>
                <button type="button" class="btn btn--link btn-sm" @click="clearSelection">{{ 'shop.bulk.clear'|trans }}</button>
            </div>
            <div class="bulk-bar__actions">
                <select class="input" name="action" x-model="bulkAction" required>
                    <option value="">{{ 'shop.bulk.choose'|trans }}</option>
                    <option value="activate">{{ 'shop.shipping.bulk.action.activate'|trans }}</option>
                    <option value="deactivate">{{ 'shop.shipping.bulk.action.deactivate'|trans }}</option>
                    <option value="delete">{{ 'shop.shipping.bulk.action.delete'|trans }}</option>
                </select>
                <button class="btn btn--primary" type="submit" :disabled="!bulkAction">{{ 'shop.bulk.apply'|trans }}</button>
            </div>
        </form>
    {% endif %}

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    {% if user.can('shop.manage') %}
                        <th class="table__check">
                            <label class="table-check">
                                <input type="checkbox" x-ref="selectAll" @change="toggleAll" :checked="allSelected">
                                <span class="sr-only">{{ 'shop.bulk.select_all'|trans }}</span>
                            </label>
                        </th>
                    {% endif %}
                    <th>{{ 'shop.field.name'|trans }}</th>
                    <th>{{ 'shop.field.carrier'|trans }}</th>
                    <th>{{ 'shop.field.shipping_type'|trans }}</th>
                    <th class="is-num">{{ 'shop.field.price'|trans }}</th>
                    <th class="is-num">{{ 'shop.field.estimated_days'|trans }}</th>
                    {% if user.can('shop.manage') %}
                        <th class="table__toggle-cell">{{ 'shop.field.active'|trans }}</th>
                    {% else %}
                        <th>{{ 'shop.field.active'|trans }}</th>
                    {% endif %}
                    <th class="table__actions-head"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr :class="isSelected('{{ item.id() }}') ? 'is-selected' : ''">
                        {% if user.can('shop.manage') %}
                            <td class="table__check">
                                <label class="table-check">
                                    <input
                                        type="checkbox"
                                        value="{{ item.id() }}"
                                        @change="toggleId('{{ item.id() }}')"
                                        :checked="isSelected('{{ item.id() }}')"
                                    >
                                    <span class="sr-only">{{ item.name() }}</span>
                                </label>
                            </td>
                        {% endif %}
                        <td>
                            <div class="table__title">
                                <a href="{{ url('admin.shop.shipping.edit', {id: item.id()}) }}"><strong>{{ item.name() }}</strong></a>
                                <span class="table__meta"><code>{{ item.code() }}</code></span>
                            </div>
                        </td>
                        <td>{{ item.carrier() ?: '—' }}</td>
                        <td><span class="badge badge--info">{{ item.typeLabel()|trans }}</span></td>
                        <td class="is-num"><strong>{{ item.price() }}</strong> <span class="muted">{{ item.currency() }}</span></td>
                        <td class="is-num">{{ item.estimatedDays() is not null ? item.estimatedDays() : '—' }}</td>
                        {% if user.can('shop.manage') %}
                            <td class="table__toggle-cell">
                                {% include 'ui/table_toggle.html.twig' with {
                                    action: url('admin.shop.shipping.toggle', {id: item.id()}),
                                    on: item.isActive(),
                                    title_on: 'shop.active'|trans,
                                    title_off: 'shop.inactive'|trans,
                                    toast_on: 'shop.flash.shipping_activated'|trans,
                                    toast_off: 'shop.flash.shipping_deactivated'|trans
                                } %}
                            </td>
                        {% else %}
                            <td>
                                <span class="badge badge--{{ item.isActive() ? 'ok' : 'muted' }}">
                                    {{ item.isActive() ? 'shop.active'|trans : 'shop.inactive'|trans }}
                                </span>
                            </td>
                        {% endif %}
                        {% embed 'ui/row_actions.html.twig' %}
                            {% block items %}
                                {% if user.can('shop.manage') %}
                                    {% include 'ui/row_action.html.twig' with { href: url('admin.shop.shipping.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                                    {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.shop.shipping.destroy', {id: item.id()}), confirm: 'shop.shipping.confirm_delete'|trans } %}
                                {% endif %}
                            {% endblock %}
                        {% endembed %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ user.can('shop.manage') ? 8 : 7 }}">
                            <div class="empty">
                                <h2>{{ 'shop.shipping.empty'|trans }}</h2>
                                <p>{{ 'shop.shipping.empty.hint'|trans }}</p>
                                {% if user.can('shop.manage') %}
                                    <a class="btn btn--primary" href="{{ url('admin.shop.shipping.create') }}">{{ icon('plus') }} {{ 'shop.shipping.new'|trans }}</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'ui/table_footer.html.twig' %}
</div>

{% embed 'ui/drawer.html.twig' with { id: 'shipping-filters', title: 'ui.drawer.filters'|trans } %}
    {% block body %}
        <form method="get" class="g-drawer__form stack" id="shipping-drawer-filters">
            <input type="hidden" name="q" value="{{ search }}">
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'shop.field.active'|trans }}</span>
                <select class="input" name="active">
                    <option value="">{{ 'shop.shipping.filter.active_any'|trans }}</option>
                    <option value="1" {{ activeFilter == '1' ? 'selected' : '' }}>{{ 'shop.active'|trans }}</option>
                    <option value="0" {{ activeFilter == '0' ? 'selected' : '' }}>{{ 'shop.inactive'|trans }}</option>
                </select>
            </label>
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'shop.field.shipping_type'|trans }}</span>
                <select class="input" name="type">
                    <option value="">{{ 'shop.shipping.filter.type_any'|trans }}</option>
                    {% for t in types|default([]) %}
                        <option value="{{ t }}" {{ typeFilter == t ? 'selected' : '' }}>{{ ('shop.shipping.type.' ~ t)|trans }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="g-drawer__field">
                <span class="g-drawer__label">{{ 'shop.field.carrier'|trans }}</span>
                <select class="input" name="carrier">
                    <option value="">{{ 'shop.shipping.filter.carrier_any'|trans }}</option>
                    {% for car in carriers|default([]) %}
                        <option value="{{ car }}" {{ carrierFilter == car ? 'selected' : '' }}>{{ car }}</option>
                    {% endfor %}
                </select>
            </label>
        </form>
    {% endblock %}
    {% block footer %}
        <a class="btn btn--ghost" href="?q={{ search|url_encode }}">{{ 'ui.drawer.reset'|trans }}</a>
        <button class="btn btn--primary" type="submit" form="shipping-drawer-filters">{{ 'ui.drawer.apply'|trans }}</button>
    {% endblock %}
{% endembed %}
{% endblock %}
