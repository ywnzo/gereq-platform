{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <h1>{{ 'shop.shipping.title'|trans }}</h1>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.shop.carts.index') }}">{{ 'shop.carts.title'|trans }}</a>
        {% if user.can('shop.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.shop.shipping.create') }}">{{ icon('plus') }} {{ 'shop.shipping.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<form class="toolbar" method="get">
    <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'shop.shipping.search'|trans }}">
</form>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
    <th>{{ 'shop.field.code'|trans }}</th>
    <th>{{ 'shop.field.name'|trans }}</th>
    <th>{{ 'shop.field.carrier'|trans }}</th>
    <th>{{ 'shop.field.shipping_type'|trans }}</th>
    <th>{{ 'shop.field.price'|trans }}</th>
    <th>{{ 'shop.field.estimated_days'|trans }}</th>
    <th>{{ 'shop.field.active'|trans }}</th>
    <th></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><strong>{{ item.code() }}</strong></td>
    <td>{{ item.name() }}</td>
    <td>{{ item.carrier() ?: '—' }}</td>
    <td>{{ item.typeLabel()|trans }}</td>
    <td>{{ item.price() }} {{ item.currency() }}</td>
    <td>{{ item.estimatedDays() is not null ? item.estimatedDays() : '—' }}</td>
    <td>
<span class="badge badge--{{ item.isActive() ? 'ok' : 'muted' }}">
{{ item.isActive() ? 'shop.active'|trans : 'shop.inactive'|trans }}
</span>
    </td>
    <td class="table__actions" x-data="rowMenu" @click.outside="close">
<button type="button" class="icon-btn" x-ref="button" @click="toggle" aria-haspopup="menu" :aria-expanded="open">{{ icon('dots') }}</button>
<div class="flyout flyout--right" x-ref="menu" :class="menuClass" :style="menuStyle" role="menu">
{% if user.can('shop.manage') %}
<a href="{{ url('admin.shop.shipping.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
<form method="post" action="{{ url('admin.shop.shipping.destroy', {id: item.id()}) }}" onsubmit="return confirm('{{ 'shop.shipping.confirm_delete'|trans|e('js') }}');">
{{ csrf_field()|raw }}
<button type="submit">{{ 'common.delete'|trans }}</button>
</form>
{% endif %}
</div>
    </td>
</tr>
{% else %}
<tr>
<td colspan="8">
<div class="empty">
<h2>{{ 'shop.shipping.empty'|trans }}</h2>
<p>{{ 'shop.shipping.empty.hint'|trans }}</p>
</div>
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
