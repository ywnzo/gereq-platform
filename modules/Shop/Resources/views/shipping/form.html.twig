{% extends 'admin/layout.html.twig' %}

{% block content %}
<header class="page-header">
    <h1>{{ item ? 'shop.shipping.edit'|trans : 'shop.shipping.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'shop.shipping.save' } %}

{% set shippingSource = item ?? 'Modules\\Shop\\Domain\\ShippingMethod' %}

<form method="post" class="detail-stack" action="{{ item ? url('admin.shop.shipping.update', {id: item.id()}) : url('admin.shop.shipping.store') }}" data-form="shop.shipping.save" x-data="gereqForm"{% if form_errors('shop.shipping.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}
    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'common.details'|trans }}</h2>
        </header>
        {{ forms().render(shippingSource, {
            form: 'shop.shipping.save',
            cols: 2,
            values: item ? {} : { currency: currency_code() }
        }) }}
    </section>
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.shop.shipping.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
