{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ item ? 'warehouse.edit'|trans : 'warehouse.new'|trans }}</h1>
    </header>

    {% include 'ui/error-summary.html.twig' with { form: 'warehouse.save' } %}

    <form method="post" action="{{ item ? url('admin.warehouse.update', {id: item.id()}) : url('admin.warehouse.store') }}" data-form="warehouse.save" x-data="gereqForm"{% if form_errors('warehouse.save') %} data-server-state="1"{% endif %}>
        {{ csrf_field()|raw }}
        {{ forms().render(item ?? 'Modules\\Warehouse\\Domain\\Warehouse', {
            form: 'warehouse.save',
            cols: 1
        }) }}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="btn btn--ghost" href="{{ url('admin.warehouse.index') }}">{{ 'common.cancel'|trans }}</a>
        </div>
    </form>
{% endblock %}
