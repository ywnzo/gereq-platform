{% if items is empty %}
    <div class="empty">
        <p>{{ 'warehouse.stock.partial.empty'|trans }}</p>
    </div>
{% else %}
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'warehouse.field.warehouse'|trans }}</th>
                    <th>{{ 'warehouse.field.qty'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {% set w = warehouses[item.warehouseId()]|default(null) %}
                            {{ w ? w.code() ~ ' — ' ~ w.name() : item.warehouseId() }}
                        </td>
                        <td>
                            {{ item.qty() }}
                            {% if item.isLow() %}<span class="badge badge--warn">{{ 'warehouse.stock.low'|trans }}</span>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
