{% extends 'admin/layout.html.twig' %}

{% block content %}
    <header class="page-header">
        <h1>{{ 'warehouse.stock.title'|trans }}</h1>
        <div class="actions">
            <a class="btn btn--ghost" href="{{ url('admin.warehouse.index') }}">{{ 'warehouse.title'|trans }}</a>
            {% if user.can('warehouse.stock.manage') %}
                <a class="btn btn--primary" href="{{ url('admin.warehouse.stock.movement.create') }}">{{ icon('plus') }} {{ 'warehouse.movement.new'|trans }}</a>
            {% endif %}
        </div>
    </header>

    <form class="toolbar" method="get">
        <select name="warehouse" class="input" onchange="this.form.submit()">
            <option value="">{{ 'warehouse.stock.all_warehouses'|trans }}</option>
            {% for opt in warehouseOptions %}
                <option value="{{ opt.value }}" {{ warehouseId == opt.value ? 'selected' : '' }}>{{ opt.label }}</option>
            {% endfor %}
        </select>
    </form>

    <div class="table-wrap" data-table>
        <table class="table">
            <thead>
                <tr>
                    <th>{{ 'warehouse.field.warehouse'|trans }}</th>
                    <th>{{ 'warehouse.field.product'|trans }}</th>
                    <th>{{ 'warehouse.field.qty'|trans }}</th>
                    <th>{{ 'warehouse.field.updated'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {% set w = warehouses[item.warehouseId()]|default(null) %}
                            {{ w ? w.code() ~ ' — ' ~ w.name() : item.warehouseId() }}
                        </td>
                        <td>
                            {% set p = products[item.productId()]|default(null) %}
                            {{ p ? p.sku() ~ ' — ' ~ p.name() : item.productId() }}
                        </td>
                        <td>
                            <strong>{{ item.qty() }}</strong>
                            {% if item.isLow() %}
                                <span class="badge badge--warn">{{ 'warehouse.stock.low'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="muted">{{ item.updatedAt().format('d. m. Y H:i') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">
                            <div class="empty">
                                <h2>{{ 'warehouse.stock.empty'|trans }}</h2>
                                <p>{{ 'warehouse.stock.empty.hint'|trans }}</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
