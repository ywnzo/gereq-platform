<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'partscatalog.partial.title'|trans }}</h2>
            <p class="muted">{{ 'partscatalog.partial.intro'|trans }}</p>
        </div>
        {% if user.can('partscatalog.view') %}
            <a class="btn btn--ghost" href="{{ browseUrl }}">{{ 'partscatalog.action.open_catalog'|trans }}</a>
        {% endif %}
    </header>
    <div class="panel__body">
        {% if parts is not empty %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th>{{ 'partscatalog.col.name'|trans }}</th>
                    <th>{{ 'partscatalog.col.oem'|trans }}</th>
                    <th>{{ 'partscatalog.col.brand'|trans }}</th>
                    <th>{{ 'partscatalog.col.qty'|trans }}</th>
                    <th>{{ 'partscatalog.col.price'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for part in parts %}
                <tr>
                    <td>
                        <strong>{{ part.nameCs() }}</strong>
                    </td>
                    <td class="is-mute">{{ part.oem() ?: '—' }}</td>
                    <td class="is-mute">{{ part.brand() ?: '—' }}</td>
                    <td class="is-num">{{ part.qty() + 0 }}</td>
                    <td class="is-num">
                        {% if part.lineTotal() is not null %}
                            <strong>{{ part.lineTotal()|money }}</strong>
                            {% if part.qty() + 0 != 1 %}
                                <div class="muted" style="font-size:.85em">{{ part.unitPrice()|money }} × {{ part.qty() + 0 }}</div>
                            {% endif %}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {% if user.can('partscatalog.manage') %}
                        <form method="post" action="{{ url('admin.partscatalog.detach',{id:part.id()}) }}" data-confirm="{{ 'partscatalog.confirm.detach'|trans }}">
                            {{ csrf_field()|raw }}
                            <button class="btn btn--ghost" type="submit">{{ 'common.delete'|trans }}</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <p class="muted">{{ 'partscatalog.partial.empty'|trans }}</p>
        {% endif %}
    </div>
</section>
