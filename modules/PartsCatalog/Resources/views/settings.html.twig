{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'partscatalog.settings.title'|trans }}</h1>
        <p class="muted">{{ 'partscatalog.settings.intro'|trans|raw }}</p>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.partscatalog.browse') }}">{{ 'partscatalog.browse.title'|trans }}</a>
    </div>
</header>

<form method="post" class="detail-stack" action="{{ url('admin.partscatalog.settings.update') }}">
{{ csrf_field()|raw }}

<section class="panel">
    <header class="panel__head">
        <div>
            <h2>{{ 'partscatalog.settings.section.jama'|trans }}</h2>
            <p class="muted">{{ 'partscatalog.settings.jama_hint'|trans|raw }}</p>
        </div>
    </header>
    <div class="form-grid">
        <label class="field field--full">
            <span>{{ 'partscatalog.settings.jama_base_url'|trans }}</span>
            <input class="input" type="url" name="partscatalog__jama__base_url" value="{{ jamaBaseUrl }}" placeholder="https://www.autodily-jama.cz">
        </label>
    </div>
</section>

<div class="form-actions">
    <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
</div>
</form>
{% endblock %}
