{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="pc-browse">
<header class="page-header">
    <div>
        <h1>{{ 'partscatalog.browse.title'|trans }}</h1>
        <p class="muted">{{ 'partscatalog.browse.intro'|trans }}</p>
    </div>
</header>

{% if error %}
<div class="empty"><h2>{{ error }}</h2></div>
{% endif %}

<div class="pc-topbar pc-topbar--split">
{% if selectedFleet %}
    <section class="pc-selected">
        <div class="pc-selected__media">
            {% if selectedFleet.photo_url %}
                <img src="{{ selectedFleet.photo_url }}" alt="{{ selectedFleet.plate }}" loading="lazy">
            {% else %}
                <span class="pc-selected__placeholder" aria-hidden="true">{{ icon('car') }}</span>
            {% endif %}
        </div>
        <div class="pc-selected__body">
        <header class="pc-selected__head">
            <h2>{{ selectedFleet.plate }}</h2>
            <a class="btn btn--ghost btn--sm" href="{{ url('admin.partscatalog.browse') }}{% if orderId %}?order_id={{ orderId|url_encode }}{% endif %}">{{ 'common.back'|trans }}</a>
        </header>
        <p class="pc-selected__meta">
            <strong>{{ selectedFleet.label }}</strong>
            {% if selectedFleet.year %} · {{ selectedFleet.year }}{% endif %}
            {% if selectedFleet.vin %}<br><span class="muted">{{ selectedFleet.vin }}</span>{% endif %}
        </p>
        <div class="field">
            <span class="g-label">{{ 'partscatalog.browse.pick_vehicle'|trans }}</span>
            <form method="get" class="pc-selected__vehicle-form" id="pc-vehicle-form">
                {% if orderId %}<input type="hidden" name="order_id" value="{{ orderId }}">{% endif %}
                <input type="hidden" name="fleet" value="{{ fleetId }}">
                {% set vehicleOptions = [{ value: '', label: 'partscatalog.browse.pick_vehicle'|trans }] %}
                {% for v in catalogVehicles %}
                    {% set vehicleOptions = vehicleOptions|merge([{
                        value: v.id,
                        label: v.label,
                        description: v.hint,
                        search: v.label ~ ' ' ~ (v.hint ?? '')
                    }]) %}
                {% endfor %}
                {% include 'ui/select.html.twig' with {
                    name: 'vehicle',
                    id: 'pc-catalog-vehicle',
                    label: '',
                    value: vehicleId,
                    placeholder: 'partscatalog.browse.pick_vehicle'|trans,
                    options: vehicleOptions,
                    searchable: true,
                    autosubmit: true,
                    empty_label: 'partscatalog.browse.vehicle_empty'|trans,
                    extra: 'pc-selected__vehicle-select'
                } %}
            </form>
        </div>
        </div>
    </section>
{% else %}
    <section class="pc-picker">
        <form method="get" class="pc-picker__form" id="pc-car-form">
            {% if orderId %}<input type="hidden" name="order_id" value="{{ orderId }}">{% endif %}
            {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}
            <div class="pc-picker__fields">
                <div class="pc-picker__cascade" aria-label="{{ 'partscatalog.browse.cascade'|trans }}">
                    <div class="pc-picker__step pc-picker__step--brand">
                        {% set brandOptions = [{ value: '', label: 'partscatalog.browse.pick_brand'|trans }] %}
                        {% for b in catalogBrands %}
                            {% set brandOptions = brandOptions|merge([{
                                value: b.id,
                                label: b.name,
                                search: b.name
                            }]) %}
                        {% endfor %}
                        {% include 'ui/select.html.twig' with {
                            name: 'brand',
                            id: 'pc-brand',
                            label: 'partscatalog.browse.pick_brand'|trans,
                            value: brandId,
                            placeholder: 'partscatalog.browse.pick_brand'|trans,
                            options: brandOptions,
                            searchable: true,
                            autosubmit: true,
                            empty_label: 'partscatalog.browse.brand_empty'|trans,
                            extra: 'pc-picker__brand'
                        } %}
                    </div>

                    {% if brandId %}
                    <div class="pc-picker__step pc-picker__step--model">
                        {% set modelOptions = [{ value: '', label: 'partscatalog.browse.pick_model'|trans }] %}
                        {% for c in catalogCars %}
                            {% set modelOptions = modelOptions|merge([{
                                value: c.id,
                                label: c.model,
                                description: c.brand,
                                search: c.model ~ ' ' ~ c.brand ~ ' ' ~ c.label
                            }]) %}
                        {% endfor %}
                        {% include 'ui/select.html.twig' with {
                            name: 'car',
                            id: 'pc-car',
                            label: 'partscatalog.browse.pick_model'|trans,
                            value: carId,
                            placeholder: 'partscatalog.browse.pick_model'|trans,
                            options: modelOptions,
                            searchable: true,
                            autosubmit: true,
                            empty_label: 'partscatalog.browse.model_empty'|trans,
                            extra: 'pc-picker__model'
                        } %}
                    </div>
                    {% endif %}

                    {% if brandId and carId %}
                    <div class="pc-picker__step pc-picker__step--year">
                        {% set yearSelectOptions = [{ value: '', label: 'partscatalog.browse.pick_year'|trans }] %}
                        {% for y in yearOptions %}
                            {% set yearSelectOptions = yearSelectOptions|merge([{
                                value: y ~ '',
                                label: y ~ '',
                                search: y ~ ''
                            }]) %}
                        {% endfor %}
                        {% include 'ui/select.html.twig' with {
                            name: 'year',
                            id: 'pc-year',
                            label: 'partscatalog.browse.pick_year'|trans,
                            value: year,
                            placeholder: 'partscatalog.browse.pick_year'|trans,
                            options: yearSelectOptions,
                            searchable: true,
                            autosubmit: true,
                            empty_label: 'partscatalog.browse.year_empty'|trans,
                            extra: 'pc-picker__year'
                        } %}
                    </div>
                    {% endif %}
                </div>

                {% if canSearch and catalogVehicles is not empty %}
                    <div class="pc-picker__step pc-picker__step--vehicle">
                    {% set vehicleOptions = [{ value: '', label: 'partscatalog.browse.pick_vehicle'|trans }] %}
                    {% for v in catalogVehicles %}
                        {% set vehicleOptions = vehicleOptions|merge([{
                            value: v.id,
                            label: v.label,
                            description: v.hint,
                            search: v.label ~ ' ' ~ (v.hint ?? '')
                        }]) %}
                    {% endfor %}
                    {% include 'ui/select.html.twig' with {
                        name: 'vehicle',
                        id: 'pc-catalog-vehicle',
                        label: 'partscatalog.browse.pick_vehicle'|trans,
                        value: vehicleId,
                        placeholder: 'partscatalog.browse.pick_vehicle'|trans,
                        options: vehicleOptions,
                        searchable: true,
                        autosubmit: true,
                        empty_label: 'partscatalog.browse.vehicle_empty'|trans,
                        extra: 'pc-picker__vehicle'
                    } %}
                    </div>
                {% endif %}
            </div>
            {% if catalogBrands is empty %}
                <p class="muted pc-picker__hint">{{ 'partscatalog.browse.car_hint'|trans({ '%url%': url('admin.fleet.settings') })|raw }}</p>
            {% elseif brandId is empty %}
                <p class="muted pc-picker__hint">{{ 'partscatalog.browse.brand_hint'|trans }}</p>
            {% elseif carId is empty %}
                <p class="muted pc-picker__hint">{{ 'partscatalog.browse.model_hint'|trans }}</p>
            {% elseif year is empty %}
                <p class="muted pc-picker__hint">{{ 'partscatalog.browse.year_optional'|trans }}</p>
            {% endif %}
        </form>
    </section>
{% endif %}

<section class="pc-search">
    <form class="pc-search__form" method="get">
        {% if orderId %}<input type="hidden" name="order_id" value="{{ orderId }}">{% endif %}
        {% if fleetId %}<input type="hidden" name="fleet" value="{{ fleetId }}">{% endif %}
        {% if brandId %}<input type="hidden" name="brand" value="{{ brandId }}">{% endif %}
        {% if carId %}<input type="hidden" name="car" value="{{ carId }}">{% endif %}
        {% if year %}<input type="hidden" name="year" value="{{ year }}">{% endif %}
        {% if vehicleId %}<input type="hidden" name="vehicle" value="{{ vehicleId }}">{% endif %}
        {% if parentId %}<input type="hidden" name="parent" value="{{ parentId }}">{% endif %}
        <div class="pc-search__row">
            <label class="pc-search__main">
                <span class="pc-search__label">{{ 'partscatalog.browse.search'|trans }}</span>
                <input class="input" type="search" name="q" value="{{ q }}" placeholder="{{ (vehicleId ? 'partscatalog.browse.search_ph_vehicle' : 'partscatalog.browse.search_ph')|trans }}" {% if canSearch %}autofocus{% else %}disabled{% endif %}>
            </label>
            <button class="btn btn--primary" type="submit" {% if not canSearch %}disabled{% endif %}>{{ 'common.search'|trans }}</button>
        </div>
        {% if not canSearch and not fleetMode %}
            <p class="muted pc-search__hint">{{ 'partscatalog.browse.search_locked'|trans }}</p>
        {% endif %}
    </form>
</section>
</div>

{% if not fleetMode and searchResults is empty and fleetVehicles is not empty %}
<section class="pc-fleet">
    <header class="pc-section-head">
        <h2>{{ 'partscatalog.browse.fleet_title'|trans }}</h2>
        <p class="muted">{{ 'partscatalog.browse.fleet_intro'|trans }}</p>
    </header>
    <div class="pc-fleet__grid">
        {% for car in fleetVehicles %}
            <a class="pc-fleet-card" href="{{ url('admin.partscatalog.browse') }}?fleet={{ car.id|url_encode }}{% if orderId %}&order_id={{ orderId|url_encode }}{% endif %}">
                <span class="pc-fleet-card__media">
                    {% if car.photo_url %}
                        <img src="{{ car.photo_url }}" alt="{{ car.plate }}" loading="lazy">
                    {% else %}
                        <span class="pc-fleet-card__placeholder" aria-hidden="true">{{ icon('car') }}</span>
                    {% endif %}
                </span>
                <span class="pc-fleet-card__body">
                    <span class="pc-fleet-card__plate">{{ car.plate }}</span>
                    <span class="pc-fleet-card__name">{{ car.label }}{% if car.year %} · {{ car.year }}{% endif %}</span>
                    <span class="status-chip status-chip--{{ car.status }}">
                        <span class="status-chip__dot" aria-hidden="true"></span>
                        {{ ('fleet.status.' ~ car.status)|trans }}
                    </span>
                </span>
            </a>
        {% endfor %}
    </div>
</section>
{% endif %}

{% if searchResults is not empty %}
<section class="panel pc-hits">
    <header class="panel__head">
        <h2>
            {{ (vehicleScopedSearch|default(false) ? 'partscatalog.browse.search_hits_vehicle' : 'partscatalog.browse.search_hits')|trans }}
            <span class="badge">{{ searchResults|length }}</span>
        </h2>
    </header>
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th style="width:4.5rem"></th>
                <th>{{ 'partscatalog.col.name'|trans }}</th>
                <th>{{ 'partscatalog.col.oem'|trans }}</th>
                <th>{{ 'partscatalog.col.brand'|trans }}</th>
                <th class="table__actions-head"></th>
            </tr>
            </thead>
            <tbody>
            {% for p in searchResults %}
            {% set detailUrl = url('admin.partscatalog.detail') ~ '?p=' ~ p.id|url_encode ~ (orderId ? '&order_id=' ~ orderId|url_encode : '') %}
            <tr>
                <td>
                    <a href="{{ detailUrl }}">
                    {% if p.imageUrl %}
                        <img class="pc-thumb" src="{{ p.imageUrl }}" alt="{{ p.name }}" loading="lazy" width="56" height="56">
                    {% endif %}
                    </a>
                </td>
                <td>
                    <a href="{{ detailUrl }}"><strong>{{ p.name }}</strong></a>
                </td>
                <td class="is-mute"><code>{{ p.oem ?: '—' }}</code></td>
                <td class="is-mute">{{ p.brand ?: '—' }}</td>
                <td>
                    <a class="btn btn--ghost" href="{{ detailUrl }}">{{ 'partscatalog.action.detail'|trans }}</a>
                    {% if orderId and user.can('partscatalog.manage') %}
                    <form method="post" action="{{ url('admin.partscatalog.attach') }}" style="display:inline">
                        {{ csrf_field()|raw }}
                        <input type="hidden" name="order_id" value="{{ orderId }}">
                        <input type="hidden" name="name" value="{{ p.name }}">
                        <input type="hidden" name="name_original" value="{{ p.nameOriginal }}">
                        <input type="hidden" name="oem" value="{{ p.oem }}">
                        <input type="hidden" name="brand" value="{{ p.brand }}">
                        <input type="hidden" name="source" value="{{ providerId }}">
                        <input type="hidden" name="external_id" value="{{ p.id }}">
                        <button class="btn btn--ghost" type="submit">{{ 'partscatalog.action.attach'|trans }}</button>
                    </form>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% elseif (q or oem) and searchResults is empty and cachedHits is empty and not error and canSearch %}
<section class="panel">
    <div class="empty"><h2>{{ (vehicleId ? 'partscatalog.browse.search_empty_vehicle' : 'partscatalog.browse.search_empty')|trans }}</h2></div>
</section>
{% endif %}

{% if cachedHits is not empty and searchResults is empty %}
<section class="panel pc-hits">
    <header class="panel__head"><h2>{{ 'partscatalog.browse.cached_hits'|trans }}</h2></header>
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th style="width:4.5rem"></th>
                <th>{{ 'partscatalog.col.name'|trans }}</th>
                <th>{{ 'partscatalog.col.oem'|trans }}</th>
                <th>{{ 'partscatalog.col.brand'|trans }}</th>
                <th>{{ 'partscatalog.col.source'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for hit in cachedHits %}
            <tr>
                <td>
                    {% if hit.image_url %}
                        <img class="pc-thumb" src="{{ hit.image_url }}" alt="{{ hit.name }}" loading="lazy" width="56" height="56">
                    {% endif %}
                </td>
                <td>
                    {% if hit.id %}
                        <a href="{{ url('admin.partscatalog.detail') ~ '?p=' ~ hit.id|url_encode }}"><strong>{{ hit.name }}</strong></a>
                    {% else %}
                        <strong>{{ hit.name }}</strong>
                    {% endif %}
                </td>
                <td class="is-mute">{{ hit.oem ?: '—' }}</td>
                <td class="is-mute">{{ hit.brand ?: '—' }}</td>
                <td><span class="badge badge--muted">{{ hit.provider }}</span></td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endif %}

{% if not fleetMode and searchResults is empty and not vehicleScopedSearch|default(false) %}
<section class="pc-history">
    <header class="pc-section-head">
        <h2>{{ 'partscatalog.browse.history_title'|trans }}</h2>
        <p class="muted">{{ 'partscatalog.browse.history_intro'|trans }}</p>
    </header>
    {% if searchHistory is empty %}
        <div class="empty"><h2>{{ 'partscatalog.browse.history_empty'|trans }}</h2></div>
    {% else %}
        <div class="pc-fleet__grid">
            {% for hit in searchHistory %}
                {% set qs = [] %}
                {% if hit.brand_id %}{% set qs = qs|merge(['brand=' ~ hit.brand_id|url_encode]) %}{% endif %}
                {% if hit.car %}{% set qs = qs|merge(['car=' ~ hit.car|url_encode]) %}{% endif %}
                {% if hit.year %}{% set qs = qs|merge(['year=' ~ hit.year|url_encode]) %}{% endif %}
                {% if hit.vehicle %}{% set qs = qs|merge(['vehicle=' ~ hit.vehicle|url_encode]) %}{% endif %}
                {% if hit.q %}{% set qs = qs|merge(['q=' ~ hit.q|url_encode]) %}{% endif %}
                {% if orderId %}{% set qs = qs|merge(['order_id=' ~ orderId|url_encode]) %}{% endif %}
                {% set forgetQs = ['history_forget=' ~ hit.id|url_encode] %}
                {% if brandId %}{% set forgetQs = forgetQs|merge(['brand=' ~ brandId|url_encode]) %}{% endif %}
                {% if carId %}{% set forgetQs = forgetQs|merge(['car=' ~ carId|url_encode]) %}{% endif %}
                {% if year %}{% set forgetQs = forgetQs|merge(['year=' ~ year|url_encode]) %}{% endif %}
                {% if vehicleId %}{% set forgetQs = forgetQs|merge(['vehicle=' ~ vehicleId|url_encode]) %}{% endif %}
                {% if orderId %}{% set forgetQs = forgetQs|merge(['order_id=' ~ orderId|url_encode]) %}{% endif %}
                <div class="pc-car pc-car--history">
                    <span class="pc-car__brand">
                        {% if hit.logo_url %}
                            <img src="{{ hit.logo_url }}" alt="" loading="lazy" onerror="const p=this.parentElement;this.remove();p.classList.add('pc-car__brand--fallback')">
                        {% endif %}
                        {% if hit.brand or hit.logo_url %}
                            <span class="pc-car__brand-fallback" aria-hidden="true">{{ icon('car') }}</span>
                        {% endif %}
                    </span>
                    <a
                        class="pc-car__forget"
                        href="{{ url('admin.partscatalog.browse') }}?{{ forgetQs|join('&') }}"
                        title="{{ 'partscatalog.browse.history_remove'|trans }}"
                        aria-label="{{ 'partscatalog.browse.history_remove'|trans }}"
                    >{{ icon('close') }}</a>
                    <a class="pc-car__link" href="{{ url('admin.partscatalog.browse') }}{% if qs %}?{{ qs|join('&') }}{% endif %}">
                        <span class="pc-car__plate">{{ hit.type ?: (hit.q ?: hit.label) }}</span>
                        <span class="pc-car__name">
                            {% if hit.brand or hit.model %}
                                {{ hit.label }}{% if hit.year %} · {{ hit.year }}{% endif %}
                            {% elseif hit.year %}
                                {{ hit.year }}
                            {% elseif hit.q %}
                                {{ 'partscatalog.browse.history_oem'|trans }}
                            {% else %}
                                {{ hit.vehicle_label ?: '—' }}
                            {% endif %}
                        </span>
                        {% if hit.q and (hit.brand or hit.model) %}
                            <span class="pc-car__vin">{{ hit.q }}</span>
                        {% endif %}
                    </a>
                    {% if hit.fuel %}
                        {% set fuelIcon = hit.fuel == 'electric' ? 'fuel-electric' : (hit.fuel == 'hybrid' ? 'fuel-hybrid' : 'fuel') %}
                        <span class="pc-car__fuel" title="{{ ('fleet.fuel.' ~ hit.fuel)|trans }}">{{ icon(fuelIcon) }}</span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endif %}

{% if (fleetId or (canSearch and vehicleId)) and (searchResults is empty or vehicleScopedSearch|default(false)) %}
<div class="pc-workspace">
    <div class="pc-workspace__main">
        {% if vehicleId and nodeId %}
        <div class="table-wrap" data-table>
            <table class="table table--pc">
                <thead>
                <tr>
                    <th style="width:4.5rem"></th>
                    <th>{{ 'partscatalog.col.name'|trans }}</th>
                    <th>{{ 'partscatalog.col.oem'|trans }}</th>
                    <th>{{ 'partscatalog.col.brand'|trans }}</th>
                    <th class="table__actions-head"></th>
                </tr>
                </thead>
                <tbody>
                {% for p in products %}
                {% set detailUrl = url('admin.partscatalog.detail') ~ '?p=' ~ p.id|url_encode ~ (vehicleId ? '&vehicle=' ~ vehicleId|url_encode : '') ~ (nodeId ? '&node=' ~ nodeId|url_encode : '') ~ (parentId ? '&parent=' ~ parentId|url_encode : '') ~ (fleetId ? '&fleet=' ~ fleetId|url_encode : '') ~ (brandId ? '&brand=' ~ brandId|url_encode : '') ~ (carId ? '&car=' ~ carId|url_encode : '') ~ (year ? '&year=' ~ year|url_encode : '') ~ (orderId ? '&order_id=' ~ orderId|url_encode : '') %}
                <tr class="pc-row-link">
                    <td>
                        <a href="{{ detailUrl }}" class="pc-row-link__media">
                        {% if p.imageUrl %}
                            <img class="pc-thumb" src="{{ p.imageUrl }}" alt="{{ p.name }}" loading="lazy" width="56" height="56">
                        {% endif %}
                        </a>
                    </td>
                    <td>
                        <a href="{{ detailUrl }}"><strong>{{ p.name }}</strong></a>
                    </td>
                    <td class="is-mute"><code>{{ p.oem ?: '—' }}</code></td>
                    <td class="is-mute">{{ p.brand ?: '—' }}</td>
                    <td>
                        <a class="btn btn--ghost" href="{{ detailUrl }}">{{ 'partscatalog.action.detail'|trans }}</a>
                        {% if orderId and user.can('partscatalog.manage') %}
                        <form method="post" action="{{ url('admin.partscatalog.attach') }}" style="display:inline">
                            {{ csrf_field()|raw }}
                            <input type="hidden" name="order_id" value="{{ orderId }}">
                            <input type="hidden" name="name" value="{{ p.name }}">
                            <input type="hidden" name="name_original" value="{{ p.nameOriginal }}">
                            <input type="hidden" name="oem" value="{{ p.oem }}">
                            <input type="hidden" name="brand" value="{{ p.brand }}">
                            <input type="hidden" name="source" value="{{ providerId }}">
                            <input type="hidden" name="external_id" value="{{ p.id }}">
                            <button class="btn btn--ghost" type="submit">{{ 'partscatalog.action.attach'|trans }}</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5"><div class="empty"><h2>{{ 'partscatalog.browse.no_products'|trans }}</h2></div></td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% elseif vehicleId %}
        <div class="panel">
            <header class="panel__head">
                <h2>{{ 'partscatalog.browse.groups'|trans }}</h2>
                {% if parentId %}
                    <a class="btn btn--ghost btn--sm" href="{{ url('admin.partscatalog.browse') }}?vehicle={{ vehicleId|url_encode }}{% if fleetId %}&fleet={{ fleetId|url_encode }}{% endif %}{% if brandId %}&brand={{ brandId|url_encode }}{% endif %}{% if carId %}&car={{ carId|url_encode }}{% endif %}{% if year %}&year={{ year|url_encode }}{% endif %}{% if orderId %}&order_id={{ orderId|url_encode }}{% endif %}{% if q %}&q={{ q|url_encode }}{% endif %}">← {{ 'common.back'|trans }}</a>
                {% endif %}
            </header>
            <form class="pc-groups-filter" method="get">
                {% if vehicleId %}<input type="hidden" name="vehicle" value="{{ vehicleId }}">{% endif %}
                {% if fleetId %}<input type="hidden" name="fleet" value="{{ fleetId }}">{% endif %}
                {% if brandId %}<input type="hidden" name="brand" value="{{ brandId }}">{% endif %}
                {% if carId %}<input type="hidden" name="car" value="{{ carId }}">{% endif %}
                {% if year %}<input type="hidden" name="year" value="{{ year }}">{% endif %}
                {% if parentId %}<input type="hidden" name="parent" value="{{ parentId }}">{% endif %}
                {% if orderId %}<input type="hidden" name="order_id" value="{{ orderId }}">{% endif %}
                {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}
                <label class="pc-groups-filter__field">
                    <span class="pc-search__label">{{ 'partscatalog.browse.groups_search'|trans }}</span>
                    <div class="pc-groups-filter__row">
                        <input class="input" type="search" name="gq" value="{{ groupQuery|default('') }}" placeholder="{{ 'partscatalog.browse.groups_search_ph'|trans }}" autocomplete="off">
                        <button class="btn btn--ghost" type="submit">{{ 'common.search'|trans }}</button>
                    </div>
                </label>
            </form>
            <div class="table-wrap" data-table>
                <table class="table table--pc">
                    <thead>
                    <tr>
                        <th>{{ 'partscatalog.col.name'|trans }}</th>
                        <th class="table__actions-head"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for n in nodes %}
                    <tr>
                        <td>
                            {% set groupUrl = n.hasChildren
                                ? (url('admin.partscatalog.browse') ~ '?vehicle=' ~ vehicleId|url_encode ~ '&parent=' ~ n.id|url_encode)
                                : (url('admin.partscatalog.browse') ~ '?vehicle=' ~ vehicleId|url_encode ~ '&node=' ~ n.id|url_encode ~ (parentId ? '&parent=' ~ parentId|url_encode : ''))
                            %}
                            {% if fleetId %}{% set groupUrl = groupUrl ~ '&fleet=' ~ fleetId|url_encode %}{% endif %}
                            {% if brandId %}{% set groupUrl = groupUrl ~ '&brand=' ~ brandId|url_encode %}{% endif %}
                            {% if carId %}{% set groupUrl = groupUrl ~ '&car=' ~ carId|url_encode %}{% endif %}
                            {% if year %}{% set groupUrl = groupUrl ~ '&year=' ~ year|url_encode %}{% endif %}
                            {% if orderId %}{% set groupUrl = groupUrl ~ '&order_id=' ~ orderId|url_encode %}{% endif %}
                            {% if q %}{% set groupUrl = groupUrl ~ '&q=' ~ q|url_encode %}{% endif %}
                            <a href="{{ groupUrl }}">
                                <strong>{{ n.name }}</strong>
                            </a>
                        </td>
                        <td class="is-mute">
                            <a href="{{ groupUrl }}">{{ n.hasChildren ? '→' : ('partscatalog.browse.open_parts'|trans) }}</a>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="2">
                        <div class="empty">
                            {% if groupQuery|default('') %}
                                <h2>{{ 'partscatalog.browse.groups_empty'|trans }}</h2>
                            {% else %}
                                <h2>{{ 'partscatalog.browse.no_groups'|trans }}</h2>
                                <p class="muted">{{ 'partscatalog.browse.no_groups_hint'|trans }}</p>
                            {% endif %}
                        </div>
                    </td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% elseif fleetId or canSearch %}
            <div class="empty"><h2>{{ 'partscatalog.browse.pick_catalog_vehicle'|trans }}</h2></div>
        {% endif %}
    </div>
</div>
{% endif %}

<p class="muted pc-attr">{{ 'partscatalog.attribution'|trans|raw }}</p>
</div>
{% endblock %}
