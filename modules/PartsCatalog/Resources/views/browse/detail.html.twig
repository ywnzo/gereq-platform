{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <h1>{{ detail ? detail.name : ('partscatalog.detail.title'|trans) }}</h1>
        {% if detail %}
            <p class="muted">
                {% if detail.brand %}<strong>{{ detail.brand }}</strong>{% endif %}
                {% if detail.oem %} · <code>{{ detail.oem }}</code>{% endif %}
                {% if detail.price %} · {{ detail.price }}{% endif %}
            </p>
        {% endif %}
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ backUrl }}">← {{ 'common.back'|trans }}</a>
    </div>
</header>

{% if error %}
<section class="panel">
    <div class="empty"><h2>{{ error }}</h2></div>
</section>
{% endif %}

{% if detail %}
<div class="pc-detail">
    <section class="pc-detail__gallery panel">
        {% if detail.imageUrls is not empty %}
            <button type="button" class="pc-detail__hero" data-pc-lightbox-open data-pc-src="{{ detail.imageUrls[0] }}" aria-label="{{ 'partscatalog.detail.zoom'|trans }}">
                <img id="pc-detail-main" src="{{ detail.imageUrls[0] }}" alt="{{ detail.name }}" width="640" height="640">
            </button>
            {% if detail.imageUrls|length > 1 %}
            <div class="pc-detail__thumbs" role="list">
                {% for img in detail.imageUrls %}
                    <button type="button" class="pc-detail__thumb{% if loop.first %} is-active{% endif %}" data-pc-thumb="{{ img }}" aria-label="{{ 'partscatalog.detail.photo'|trans }} {{ loop.index }}">
                        <img src="{{ img }}" alt="" loading="lazy" width="72" height="72">
                    </button>
                {% endfor %}
            </div>
            {% endif %}
            <p class="muted pc-detail__zoom-hint">{{ 'partscatalog.detail.zoom_hint'|trans }}</p>
        {% else %}
            <div class="empty"><h2>{{ 'partscatalog.detail.no_image'|trans }}</h2></div>
        {% endif %}
    </section>

    <section class="pc-detail__info">
        {% if orderId and user.can('partscatalog.manage') %}
        <form method="post" action="{{ url('admin.partscatalog.attach') }}" class="pc-detail__attach pc-attach-form">
            {{ csrf_field()|raw }}
            <input type="hidden" name="order_id" value="{{ orderId }}">
            <input type="hidden" name="name" value="{{ detail.name }}">
            <input type="hidden" name="oem" value="{{ detail.oem }}">
            <input type="hidden" name="brand" value="{{ detail.brand }}">
            <input type="hidden" name="source" value="">
            <input type="hidden" name="external_id" value="{{ detail.id }}">
            <label class="pc-attach-form__qty">
                <span class="visually-hidden">{{ 'partscatalog.col.qty'|trans }}</span>
                <input class="input" type="number" name="qty" value="1" min="1" max="9999" step="1" title="{{ 'partscatalog.col.qty'|trans }}">
            </label>
            <button class="btn btn--primary" type="submit">{{ 'partscatalog.action.attach'|trans }}</button>
        </form>
        {% endif %}

        {% if detail.properties is not empty %}
        <div class="panel">
            <header class="panel__head"><h2>{{ 'partscatalog.detail.properties'|trans }}</h2></header>
            <dl class="pc-detail__props">
                {% for row in detail.properties %}
                    <div class="pc-detail__prop">
                        <dt>{{ row.label }}</dt>
                        <dd>{{ row.value }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </div>
        {% endif %}

        {% if detail.references is not empty %}
        <div class="panel">
            <header class="panel__head"><h2>{{ 'partscatalog.detail.references'|trans }}</h2></header>
            <ul class="pc-detail__refs">
                {% for ref in detail.references %}
                    <li><span class="badge badge--muted">{{ ref.brand }}</span> <code>{{ ref.number }}</code></li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if detail.description %}
        <div class="panel">
            <header class="panel__head"><h2>{{ 'partscatalog.detail.description'|trans }}</h2></header>
            <p>{{ detail.description }}</p>
        </div>
        {% endif %}
    </section>
</div>

<dialog class="pc-lightbox" id="pc-lightbox">
    <form method="dialog" class="pc-lightbox__bar">
        <button class="btn btn--ghost" value="close" type="submit">{{ 'partscatalog.detail.close'|trans }}</button>
    </form>
    <img class="pc-lightbox__img" id="pc-lightbox-img" alt="">
</dialog>

<script>
(() => {
  const main = document.getElementById('pc-detail-main');
  const dialog = document.getElementById('pc-lightbox');
  const dialogImg = document.getElementById('pc-lightbox-img');
  if (!main || !dialog || !dialogImg) return;

  const setMain = (src) => {
    main.src = src;
    const hero = main.closest('[data-pc-lightbox-open]');
    if (hero) hero.setAttribute('data-pc-src', src);
  };

  document.querySelectorAll('[data-pc-thumb]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-pc-thumb');
      if (!src) return;
      setMain(src);
      document.querySelectorAll('[data-pc-thumb]').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });

  document.querySelectorAll('[data-pc-lightbox-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-pc-src') || main.src;
      dialogImg.src = src;
      dialogImg.alt = main.alt || '';
      if (typeof dialog.showModal === 'function') dialog.showModal();
    });
  });
})();
</script>
{% endif %}
{% endblock %}
