{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="list-shell" x-data="dataTable" data-table-id="feeds" data-actions-default="1">
<header class="page-header">
    <h1>{{ 'feeds.title'|trans }}</h1>
    <div class="actions">
        {% if user.can('feeds.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.feeds.create') }}">{{ icon('plus') }} {{ 'feeds.new'|trans }}</a>
        {% endif %}
    </div>
</header>

<div class="toolbar--table">
    <form class="toolbar" method="get">
        <input class="input" type="search" name="q" value="{{ search }}" placeholder="{{ 'feeds.search'|trans }}">
    </form>
</div>

<div class="table-wrap" data-table>
<table class="table">
<thead><tr>
<th>{{ 'feeds.field.code'|trans }}</th>
<th>{{ 'feeds.field.name'|trans }}</th>
<th>{{ 'feeds.field.driver'|trans }}</th>
<th>{{ 'feeds.field.format'|trans }}</th>
<th>{{ 'feeds.field.active'|trans }}</th>
<th class="table__actions-head"></th>
</tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><strong>{{ item.code() }}</strong></td>
    <td>{{ item.name() }}</td>
    <td>{{ ('feeds.driver.' ~ item.driver())|trans }}</td>
    <td>{{ item.format()|upper }}</td>
    <td>
        <span class="badge badge--{{ item.isActive() ? 'ok' : 'muted' }}">
            {{ item.isActive() ? 'feeds.active'|trans : 'feeds.inactive'|trans }}
        </span>
    </td>
    {% embed 'ui/row_actions.html.twig' %}
        {% block items %}
            <a href="{{ url('admin.feeds.preview', {id: item.id()}) }}">{{ 'feeds.action.preview'|trans }}</a>
            {% if user.can('feeds.manage') %}
                {% include 'ui/row_action.html.twig' with { href: url('admin.feeds.edit', {id: item.id()}), label: 'common.edit'|trans, icon: 'edit' } %}
                {% include 'ui/row_action_destroy.html.twig' with { action: url('admin.feeds.destroy', {id: item.id()}), confirm: 'feeds.confirm_delete'|trans } %}
            {% endif %}
        {% endblock %}
    {% endembed %}
</tr>
{% else %}
<tr>
<td colspan="6">
<div class="empty">
<h2>{{ 'feeds.empty'|trans }}</h2>
<p>{{ 'feeds.empty.hint'|trans }}</p>
</div>
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
{% endblock %}
