{% extends 'admin/layout.html.twig' %}

{% block content %}
<header class="page-header">
    <h1>{{ item ? 'feeds.edit'|trans : 'feeds.new'|trans }}</h1>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'feeds.save' } %}

{% set feedSource = item ?? 'Modules\\Feeds\\Domain\\FeedDefinition' %}

<form method="post" class="detail-stack" action="{{ item ? url('admin.feeds.update', {id: item.id()}) : url('admin.feeds.store') }}" data-form="feeds.save" x-data="gereqForm"{% if form_errors('feeds.save') %} data-server-state="1"{% endif %}>
    {{ csrf_field()|raw }}
    <section class="panel">
        <header class="panel__head">
            <h2>{{ 'common.details'|trans }}</h2>
        </header>
        <div class="form-grid">
            {{ forms().render(feedSource, {
                form: 'feeds.save',
                cols: 1,
                wrap: false,
                exclude: ['active']
            }) }}
            {% include 'ui/textarea.html.twig' with {
                name: 'config_json',
                label: 'feeds.field.config_json'|trans,
                optional: true,
                form: 'feeds.save',
                value: configJson,
                hint: 'feeds.field.config_json.hint'|trans,
                size: 'mini',
                rows: 8
            } %}
            {{ forms().render(feedSource, {
                form: 'feeds.save',
                cols: 1,
                wrap: false,
                only: ['active']
            }) }}
        </div>
    </section>
    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.feeds.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
