{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <h1>{{ 'feeds.preview'|trans }} — {{ item.name() }}</h1>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.feeds.index') }}">{{ 'common.back'|trans }}</a>
        {% if user.can('feeds.manage') %}
            <a class="btn btn--primary" href="{{ url('admin.feeds.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
        {% endif %}
    </div>
</header>

<p><code>{{ contentType }}</code> · <code>/api/v1/feeds/{{ item.code() }}</code></p>

<pre class="code-block" style="white-space:pre-wrap;overflow:auto;max-height:70vh;padding:1rem;background:var(--surface-2, #f5f5f5);border-radius:.5rem">{{ body }}</pre>
{% endblock %}
