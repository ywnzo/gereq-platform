{% extends 'admin/layout.html.twig' %}
{% block content %}
{% set documentSource = item ?? 'Modules\\ESign\\Domain\\SignableDocument' %}

<header class="page-header">
    <div>
        <h1>{{ item ? 'esign.documents.edit'|trans : 'esign.documents.new'|trans }}</h1>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ item ? url('admin.esign.documents.show', {id: item.id()}) : url('admin.esign.documents.index') }}">{{ 'common.back'|trans }}</a>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'esign.document.save' } %}

<form
    method="post"
    class="form-grid form-grid--cols-2"
    action="{{ item ? url('admin.esign.documents.update', {id: item.id()}) : url('admin.esign.documents.store') }}"
    data-form="esign.document.save"
    x-data="gereqForm"
    {% if form_errors('esign.document.save') %}data-server-state="1"{% endif %}
>
    {{ csrf_field()|raw }}

    {{ forms().render(documentSource, {
        form: 'esign.document.save',
        cols: 2,
        wrap: false,
        values: item ? {} : { body_html: defaultBody }
    }) }}

    <div class="form-actions">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ item ? url('admin.esign.documents.show', {id: item.id()}) : url('admin.esign.documents.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
