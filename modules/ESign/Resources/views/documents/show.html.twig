{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <h1>{{ item.number() }}</h1>
    <div class="actions">
        {% if user.can('esign.manage') and not item.isLocked() and not item.isFullySigned() %}
            <a class="btn btn--ghost" href="{{ url('admin.esign.documents.edit', {id: item.id()}) }}">{{ 'common.edit'|trans }}</a>
        {% endif %}
        <a class="btn btn--ghost" href="{{ url('admin.esign.documents.index') }}">{{ 'common.back'|trans }}</a>
    </div>
</header>

<p class="esign-notice">{{ 'esign.notice.ses'|trans }}</p>

<div class="meta-list esign-meta">
    <div><span>{{ 'esign.field.title'|trans }}</span><strong>{{ item.title() }}</strong></div>
    <div><span>{{ 'esign.field.status'|trans }}</span><strong>{{ item.statusLabel()|trans }}</strong></div>
    <div><span>{{ 'esign.field.counterparty_name'|trans }}</span><strong>{{ item.counterpartyName() }}</strong></div>
    <div><span>{{ 'esign.field.counterparty_email'|trans }}</span><strong>{{ item.counterpartyEmail() ?: '—' }}</strong></div>
    {% if item.lockedHash() %}
    <div><span>{{ 'esign.field.locked_hash'|trans }}</span><strong class="esign-hash">{{ item.lockedHash() }}</strong></div>
    {% endif %}
    {% if item.signedAt() %}
    <div><span>{{ 'esign.field.signed_at'|trans }}</span><strong>{{ item.signedAt().format('d. m. Y H:i') }}</strong></div>
    {% endif %}
</div>

{% if user.can('esign.manage') and not item.isFullySigned() %}
<section class="esign-panel">
    <h2>{{ 'esign.action.sign_provider'|trans }}</h2>
    {% if not hasProvider %}
        <div x-data="esignSignaturePad">
            <p class="is-mute">{{ 'esign.hint.pad'|trans }}</p>
            <div class="esign-pad-wrap">
                <canvas class="esign-pad" width="800" height="220" data-esign-canvas></canvas>
            </div>
            <p class="esign-pad-error" data-esign-error hidden>{{ 'esign.public.pad_error'|trans }}</p>
            <div class="form-actions" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <button type="button" class="btn btn--ghost" data-esign-clear>{{ 'esign.action.clear_pad'|trans }}</button>
                <form method="post" action="{{ url('admin.esign.documents.sign_provider', {id: item.id()}) }}" data-esign-form style="display:inline">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="signature" value="" data-esign-form-input>
                    <button class="btn btn--primary" type="submit">{{ 'esign.action.sign_provider'|trans }}</button>
                </form>
                <form method="post" action="{{ url('admin.esign.documents.sign_provider', {id: item.id()}) }}" style="display:inline">
                    {{ csrf_field()|raw }}
                    <button class="btn btn--ghost" type="submit">Použít výchozí / pečeť</button>
                </form>
            </div>
        </div>
    {% else %}
        <p>Podpis poskytovatele je uložen ({{ providerName }}).</p>
        {% if not item.isLocked() %}
        <form method="post" class="form-inline esign-send" action="{{ url('admin.esign.documents.send', {id: item.id()}) }}">
            {{ csrf_field()|raw }}
            <label>
                <span>{{ 'esign.field.counterparty_email'|trans }}</span>
                <input class="input" type="email" name="email" required value="{{ item.counterpartyEmail() ?: '' }}">
            </label>
            <button class="btn btn--primary" type="submit">{{ 'esign.action.send'|trans }}</button>
        </form>
        <p class="is-mute">{{ 'esign.hint.send'|trans }}</p>
        {% endif %}
    {% endif %}

    {% if item.isLocked() and not item.isFullySigned() %}
        <form method="post" action="{{ url('admin.esign.documents.cancel', {id: item.id()}) }}" data-confirm="{{ 'esign.confirm_cancel'|trans }}" data-confirm-danger="1" style="margin-top:12px">
            {{ csrf_field()|raw }}
            <button class="btn btn--ghost" type="submit">{{ 'esign.action.cancel'|trans }}</button>
        </form>
    {% endif %}
</section>
{% endif %}

{% if lastSigningUrl %}
<section class="esign-panel">
    <h2>{{ 'esign.section.signing_url'|trans }}</h2>
    <p><a href="{{ lastSigningUrl }}" target="_blank" rel="noopener">{{ lastSigningUrl }}</a></p>
</section>
{% endif %}

<section class="esign-panel">
    <h2>{{ 'esign.section.preview'|trans }}</h2>
    <iframe class="esign-preview" title="Náhled" sandbox srcdoc="{{ previewHtml|e('html_attr') }}"></iframe>
</section>

{% if signatures %}
<section class="esign-panel">
    <h2>{{ 'esign.section.signatures'|trans }}</h2>
    <table class="table">
        <thead><tr><th>Strana</th><th>Jméno</th><th>Metoda</th><th>Čas</th></tr></thead>
        <tbody>
        {% for sig in signatures %}
            <tr>
                <td>{{ sig.party() }}</td>
                <td>{{ sig.signerName() }}{% if sig.signerEmail() %} &lt;{{ sig.signerEmail() }}&gt;{% endif %}</td>
                <td>{{ sig.method() }}</td>
                <td>{{ sig.signedAt().format('d. m. Y H:i') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</section>
{% endif %}

{% if links %}
<section class="esign-panel">
    <h2>{{ 'esign.section.links'|trans }}</h2>
    <table class="table">
        <thead><tr><th>E-mail</th><th>Odesláno</th><th>Expirace</th><th>Stav</th></tr></thead>
        <tbody>
        {% for link in links %}
            <tr>
                <td>{{ link.email() }}</td>
                <td>{{ link.sentAt() ? link.sentAt().format('d. m. Y H:i') : '—' }}</td>
                <td>{{ link.expiresAt().format('d. m. Y H:i') }}</td>
                <td>
                    {% if link.usedAt() %}použit
                    {% elseif link.revokedAt() %}zrušen
                    {% elseif link.isUsable() %}aktivní
                    {% else %}vypršel{% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</section>
{% endif %}

{% if user.can('esign.manage') and not item.isFullySigned() %}
<form method="post" action="{{ url('admin.esign.documents.destroy', {id: item.id()}) }}" data-confirm="{{ 'esign.confirm_delete'|trans }}" data-confirm-title="{{ 'ui.confirm.delete_title'|trans }}" data-confirm-danger="1" style="margin-top:24px">
    {{ csrf_field()|raw }}
    <button class="btn btn--ghost" type="submit">{{ 'common.delete'|trans }}</button>
</form>
{% endif %}
{% endblock %}
