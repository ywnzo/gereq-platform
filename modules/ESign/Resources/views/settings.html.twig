{% extends 'admin/layout.html.twig' %}
{% block content %}
<header class="page-header">
    <div>
        <h1>{{ 'esign.settings.title'|trans }}</h1>
    </div>
    <div class="actions">
        <a class="btn btn--ghost" href="{{ url('admin.esign.documents.index') }}">{{ 'nav.esign.documents'|trans }}</a>
    </div>
</header>

{% include 'ui/error-summary.html.twig' with { form: 'esign.settings' } %}

<form
    method="post"
    class="form-grid"
    action="{{ url('admin.esign.settings.save') }}"
    data-form="esign.settings"
    x-data="esignSignaturePad"
    {% if form_errors('esign.settings') %}data-server-state="1"{% endif %}
>
    {{ csrf_field()|raw }}

    {% include 'ui/input.html.twig' with {
        name: 'provider_name',
        label: 'esign.field.provider_name'|trans,
        required: true,
        form: 'esign.settings',
        value: providerName
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'provider_email',
        label: 'esign.field.provider_email'|trans,
        form: 'esign.settings',
        value: providerEmail,
        type: 'email'
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'link_ttl_days',
        label: 'esign.field.link_ttl_days'|trans,
        required: true,
        form: 'esign.settings',
        value: linkTtlDays,
        type: 'number'
    } %}
    {% include 'ui/input.html.twig' with {
        name: 'consent_version',
        label: 'esign.field.consent_version'|trans,
        required: true,
        form: 'esign.settings',
        value: consentVersion
    } %}

    <div class="g-field field--full esign-signature-field" data-field="signature">
        <span class="g-label">
            <span>{{ 'esign.field.provider_signature'|trans }}</span>
        </span>
        {% if providerSignaturePreview %}
            <div class="esign-signature-preview">
                <p class="g-hint">{{ 'esign.settings.signature_saved'|trans }}</p>
                <img
                    class="esign-signature-preview__img"
                    src="{{ providerSignaturePreview }}"
                    alt="{{ 'esign.field.provider_signature'|trans }}"
                >
            </div>
            <p class="g-hint">{{ 'esign.hint.pad_replace'|trans }}</p>
        {% else %}
            <p class="g-hint">{{ 'esign.hint.pad'|trans }}</p>
        {% endif %}
        <div class="esign-pad-wrap">
            <canvas class="esign-pad" width="800" height="220" data-esign-canvas></canvas>
        </div>
        <input type="hidden" name="signature" value="" data-esign-input>
        <p class="g-error esign-pad-error" data-esign-error hidden>{{ 'esign.public.pad_error'|trans }}</p>
        <div class="esign-pad-actions">
            <button type="button" class="btn btn--ghost" data-esign-clear>{{ 'esign.action.clear_pad'|trans }}</button>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn btn--primary" type="submit" data-esign-optional-submit>{{ 'common.save'|trans }}</button>
        <a class="btn btn--ghost" href="{{ url('admin.esign.documents.index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
