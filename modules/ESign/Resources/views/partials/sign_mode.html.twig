{# Volba: digitální eSign vs. ruční podpis na PDF.
   Očekává: esignAvailable (bool), customerEmail (string|null)
#}
{% set esignOn = esignAvailable|default(false) %}
<div class="cs-sign-mode" x-data="{ mode: '{{ defaultSignMode|default('manual') }}' }">
    <fieldset class="field field--full" style="border:0;padding:0;margin:0 0 12px">
        <legend class="field__label" style="margin-bottom:8px">{{ 'esign.finish.sign_mode'|trans }}</legend>
        <label class="cs-sign-mode__opt" style="display:flex;gap:8px;align-items:flex-start;margin-bottom:6px">
            <input type="radio" name="sign_mode" value="manual" x-model="mode" {% if not esignOn %}checked{% endif %}>
            <span>
                <strong>{{ 'esign.finish.sign_mode.manual'|trans }}</strong>
                <span class="muted" style="display:block;font-size:.9em">{{ 'esign.finish.sign_mode.manual.hint'|trans }}</span>
            </span>
        </label>
        {% if esignOn %}
        <label class="cs-sign-mode__opt" style="display:flex;gap:8px;align-items:flex-start">
            <input type="radio" name="sign_mode" value="digital" x-model="mode">
            <span>
                <strong>{{ 'esign.finish.sign_mode.digital'|trans }}</strong>
                <span class="muted" style="display:block;font-size:.9em">{{ 'esign.finish.sign_mode.digital.hint'|trans }}</span>
            </span>
        </label>
        {% endif %}
    </fieldset>

    <div x-show="mode === 'manual'" x-cloak>
        {% block sign_manual %}
        {% include 'ui/textarea.html.twig' with {
            name: 'signature_service',
            label: 'esign.finish.signature_service'|trans,
            optional: true,
            value: '',
            size: 'mini',
            rows: 2,
            hint: 'esign.finish.signature_service.hint'|trans
        } %}
        {% include 'ui/textarea.html.twig' with {
            name: 'signature_customer',
            label: 'esign.finish.signature_customer'|trans,
            optional: true,
            value: '',
            size: 'mini',
            rows: 2,
            hint: 'esign.finish.signature_customer.hint'|trans
        } %}
        {% endblock %}
    </div>

    {% if esignOn %}
    <div x-show="mode === 'digital'" x-cloak>
        <p class="muted" style="margin-bottom:10px">{{ 'esign.finish.pad_hint'|trans }}</p>
        <div class="field field--full" style="margin-bottom:12px;padding:.75rem .9rem;border:1px solid var(--border,#e5e7eb);border-radius:6px;background:var(--surface-2,#f8fafc)">
            <strong>{{ 'esign.finish.provider_auto'|trans }}</strong>
            <p class="muted" style="font-size:.85em;margin:.35rem 0 0">{{ 'esign.finish.provider_auto.hint'|trans }}</p>
        </div>
        <input type="hidden" name="signature_provider_png" value="">
        <div class="field field--full" x-data="esignSignaturePad">
            <span class="field__label">{{ 'esign.finish.customer_pad'|trans }}</span>
            <canvas data-esign-canvas style="width:100%;height:160px;border:1px solid #ccc;border-radius:6px;touch-action:none;background:#fff"></canvas>
            <input type="hidden" name="signature_customer_png" data-esign-input value="">
            <button type="button" class="btn btn--ghost" data-esign-clear style="margin-top:6px">{{ 'esign.action.clear_pad'|trans }}</button>
            <p class="muted" style="font-size:.85em;margin-top:4px">{{ 'esign.finish.customer_pad.hint'|trans }}</p>
        </div>
        {% include 'ui/input.html.twig' with {
            name: 'esign_email',
            type: 'email',
            label: 'esign.finish.email'|trans,
            optional: true,
            value: customerEmail|default(''),
            hint: 'esign.finish.email.hint'|trans
        } %}
    </div>
    {% endif %}
</div>
