{% set score = score|default(0) %}
{% set color = color|default('#ef4444') %}
{% set pace = score >= 75 ? 'ok' : (score >= 40 ? 'warn' : 'bad') %}
<a
    href="{{ health_url }}"
    class="webplus-health-badge webplus-health-badge--{{ pace }}"
    style="--health-color: {{ color }}"
    title="{{ 'webplus.health.badge_title'|trans({'%score%': score ~ '%'}) }}"
    aria-label="{{ 'webplus.health.badge_title'|trans({'%score%': score ~ '%'}) }}"
>
    <span class="webplus-health-badge__heart" aria-hidden="true">
        <svg class="webplus-health-badge__svg" width="14" height="14" viewBox="0 0 24 24" focusable="false" xmlns="http://www.w3.org/2000/svg">
            <path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
    </span>
    <span class="webplus-health-badge__score">{{ score }}%</span>
</a>
