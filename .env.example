# GEREQ Platform

APP_NAME="GEREQ Platform"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=

# Comma-separated proxy IPs/CIDRs (or * for private ranges) when behind nginx/Docker
TRUSTED_PROXIES=*

# sqlite | mysql | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE_NAME=gereq
DB_USERNAME=gereq
DB_PASSWORD=

CACHE_DRIVER=file
# file | redis | database | array  — database = tabulka cache_items v DB
# CACHE_DRIVER=database
CACHE_TTL=3600
CACHE_TWIG=true
CACHE_DOCTRINE_RESULT=true
CACHE_MEDIA_TTL=604800

# self_repair = vestavěné typo/diakritika LIKE (default, bez Elasticsearch)
SEARCH_DRIVER=self_repair
SEARCH_TYPO_MAX_VARIANTS=14
SEARCH_MIN_TOKEN_LENGTH=3

QUEUE_DRIVER=sync
FILE_DRIVER=local

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_DSN=null://null

ADMIN_NAME="Jiří Novák"
ADMIN_EMAIL=jiri.novak@gereq.cz
ADMIN_PASSWORD=change-me

# file | redis  (Docker serve-docker vynutí redis)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax

# Never enable in production unless you fully trust webhook targets (SSRF risk)
WEBHOOKS_ALLOW_PRIVATE_URLS=false

# Comma-separated FE origins for public API CORS (required in production)
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Po instalaci: ./bin/install  nebo  php gereq migrate --fresh --no-demo --no-sample
