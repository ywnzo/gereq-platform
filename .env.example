# GEREQ Platform

APP_NAME="GEREQ Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

# sqlite | mysql | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE_NAME=gereq
DB_USERNAME=gereq
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_DRIVER=sync
FILE_DRIVER=local

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_DSN=null://null

ADMIN_NAME="Jiří Novák"
ADMIN_EMAIL=jiri.novak@gereq.cz
ADMIN_PASSWORD=change-me

# file | redis  (Docker serve-docker vynutí redis)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax

# Optional payment / shipping providers (also configurable in admin settings)
# COMGATE_MERCHANT=
# COMGATE_SECRET=
# PACKETA_API_PASSWORD=
# PACKETA_API_KEY=
