{
    "name": "gereq/platform",
    "description": "GEREQ Platform — modularní interní backendová platforma",
    "type": "project",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.1",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.3",
        "dompdf/dompdf": "^3.1",
        "lbuchs/webauthn": "^2.2",
        "league/flysystem": "^3.29",
        "monolog/monolog": "^3.8",
        "php-di/php-di": "^7.0",
        "ramsey/uuid": "^4.7",
        "spomky-labs/otphp": "^11.5",
        "symfony/cache": "^7.2",
        "symfony/console": "^7.2",
        "symfony/event-dispatcher": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/mime": "^7.2",
        "symfony/rate-limiter": "^7.2",
        "symfony/routing": "^7.2",
        "symfony/security-csrf": "^7.2",
        "symfony/translation": "^7.2",
        "symfony/validator": "^7.2",
        "twig/twig": "^3.20",
        "vlucas/phpdotenv": "^5.6",
        "webklex/php-imap": "^6.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "Gereq\\": "src/",
            "Modules\\": "modules/",
            "Integrations\\": "integrations/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gereq\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
