includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - modules
        - tests
        - bin/gereq-test
    tmpDir: .phpstan-tmp
    # Fail when baseline entries no longer match — keeps phpstan-baseline.neon small.
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        -
            identifier: property.onlyWritten
        -
            identifier: while.alwaysTrue
        -
            identifier: nullCoalesce.offset
        -
            identifier: property.unusedType
        # Return type includes null/union arm that the body never produces (same idea as property.unusedType).
        -
            identifier: return.unusedType
        # Redundant is_* / instanceof after the type is already narrowed (Doctrine find + guards, etc.).
        -
            identifier: function.alreadyNarrowedType
        -
            identifier: instanceof.alwaysTrue
        -
            identifier: notIdentical.alwaysTrue
        -
            identifier: identical.alwaysFalse
        -
            identifier: nullsafe.neverNull
        # array_values() on a list<> is a no-op for the type system but kept for runtime shape.
        -
            identifier: arrayValues.list
        # Idiomatic $this->assert* / markTestSkipped in PHPUnit tests
        -
            identifier: staticMethod.alreadyNarrowedType
            path: tests/*
        -
            identifier: staticMethod.alreadyNarrowedType
            path: modules/*/Tests/*
        -
            identifier: staticMethod.impossibleType
            path: tests/*
