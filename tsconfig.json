{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.d.ts", "scripts/**/*.ts"]
}
